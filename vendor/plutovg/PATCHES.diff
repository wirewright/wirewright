+
+    if(advance_width) *advance_width = advance_width_dst * scale;
+    if(left_side_bearing) *left_side_bearing = left_side_bearing_dst * scale;
+    if(extents) {
+        extents->x = x1_dst * scale;
+        extents->y = y2_dst * -scale;
+        extents->w = (x2_dst - x1_dst) * scale;
+        extents->h = (y1_dst - y2_dst) * -scale;
