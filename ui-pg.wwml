((self window) style: "bg-neutral-950 max origin" max-w: 1000 max-h: 800
  (group style: "max m-7 center-x"
    (group style: "h-max max-w-bound-5xl gap-7 fr"
    ;; panel
    (group style: "min-w-3xs max-w-3xs h-max bg-neutral-900 rounded-lg p-5 flow-col gap-2 z-10"
      ;; TODO: soma texted logo, requires us to be able to render (image)
      (p "DOCUMENTS" style: "text-neutral-400 font-condensed font-medium text-sm")
      ;; tab
      (group style: "w-max px-4 py-3 rounded-md border-2 border-neutral-800 text-neutral-300 current:bg-neutral-800 current:text-neutral-200 gap-2" current: true
        (group style: "max center-y gap-2 fr"
          (icon "article" style: "text-base")
          (p "Untitled 1" style: "leading-none text-sm")
          (group (icon "close") style: "w-fr right")))
      ;; tab
      (group style: "w-max px-4 py-3 rounded-md border-2 border-neutral-800 text-neutral-300 current:bg-neutral-800 current:text-neutral-200 gap-2" current: false
        (group style: "max center-y gap-2 fr"
          (icon "article" style: "text-base")
          (p "Untitled 2" style: "leading-none text-sm")
          (group (icon "close") style: "w-fr right")))
      ;; tab
      (group style: "w-max px-4 py-3 rounded-md border-2 border-neutral-800 text-neutral-300 current:bg-neutral-800 current:text-neutral-200 gap-2" current: false
        (group style: "max center-y gap-2 fr"
          (icon "article" style: "text-base")
          (p "Untitled 3" style: "leading-none text-sm")
          (group (icon "close") style: "w-fr right"))))
    ;; dashboard
    (group style: "w-fr h-max"
      (group style: "h-max max-w-bound-3xl"
      (group style: "max flow-col gap-7"
        (group style: "w-max flow-col gap-3"
          (h1 "Control Panel" style: "font-text text-3xl")
          (p "While the document is paused, you can modify, replace, save, or navigate through its history using this control panel." style: "w-max text-sm font-normal"))
        (group style: "w-max flow-col"
          ((self rect) style: "w-max h-px bg-neutral-800")
          (group style: "w-max gap-4 fr my-3 px-3"
            (group style: "h-max center-y"
              (p "k" style: "center-y rounded-xs leading-none font-mono p-1 pt-0 text-sm border text-neutral-400 border-neutral-400 font-medium"))
            (p "This is how key bindings look like. Once you're accustomed to them you can hit them right away, e.g. esc-w to save — without waiting for this control panel to appear." style: "w-fr h-max center-y text-xs"))
          ((self rect) style: "w-max h-px bg-neutral-800"))
        ;; dashboard-section
        (group style: "w-max px-3 pt-3 pb-7 rounded-md border border-neutral-900 flow-col gap-5"
          ;; dashboard-section-title
          (group style: "w-max gap-3 fr"
            (icon "timeline" style: "text-neutral-300 text-xl")
            (group style: "w-fr flow-col"
              (p "TIME TRAVEL" style: "font-condensed text-neutral-300 text-sm font-medium")
              (p "Revisit past or future states of the document." style: "w-max text-xs")))
          ;; document-preview-list
          ((self viewport) style: "w-max h-content bg-neutral-950" pan-x: 0 pan-y: 0
            ((self x-translate) style: "w-max h-content" offset: (* -0.2)
              (group style: "gap-5"
                ;; TODO: document-preview, requires us to be able to render (image)
                ;; document-preview-loading
                (group style: "bg-neutral-900 text-neutral-700 max max-w-3xs max-h-xs center flow-col gap-3"
                  (icon "hourglass_top" style: "text-5xl"))
                ;; document-preview-loading
                (group style: "bg-neutral-900 text-neutral-700 max max-w-3xs max-h-xs center flow-col gap-3"
                  (icon "hourglass_top" style: "text-5xl"))
                ;; document-preview-loading
                (group style: "bg-neutral-900 text-neutral-700 max max-w-3xs max-h-xs center flow-col gap-3"
                  (icon "hourglass_top" style: "text-5xl"))))))
        ;; dashboard-section
        (group style: "w-max px-4 pt-3 pb-7 rounded-md border border-neutral-900 flow-col gap-5"
          ;; dashboard-section-title
          (group style: "w-max gap-3 fr"
            (icon "dashboard" style: "text-neutral-300 text-xl")
            (group style: "w-fr flow-col"
              (p "DOCUMENT" style: "font-condensed text-neutral-300 text-sm font-medium")
              (p "Modify, replace, or save the document." style: "w-max text-xs")))
          ;; major-minor-misc-menu
          (group style: "w-max fr gap-5"
            ;; major
            (group style: "w-fr h-max border-2 border-{accent} text-{accent} rounded-sm" accent: (oklch 0.7 0.0343 181.071)
              (group style: "max center gap-5 h-fr"
                (group style: "gap-1"
                  (icon "save" style: "text-xl")
                  (p "Save" style: "leading-none"))
                ;; key
                (p "w" style: "rounded-xs leading-none font-mono p-1 pt-0 text-sm border border-{accent} font-medium" accent: (oklch 0.7 0.0343 181.071))))
            ;; minor-list
            (group style: "w-fr h-max flow-col gap-2 fr"
              ;; minor
              (group style: "w-max h-fr border border-neutral-700 center-y px-5 text-sm rounded-sm fr"
                (group style: "w-fr gap-1"
                  (icon "save_as" style: "h-max text-xl center-y")
                  (p "Save as" style: "h-max leading-none center-y"))
                ;; key
                (p "W" style: "h-max center-y rounded-xs leading-none font-mono p-1 pt-0 text-sm border text-neutral-400 border-neutral-400 font-medium"))
              ;; minor
              (group style: "w-max h-fr border border-neutral-700 center-y px-5 text-sm rounded-sm fr"
                (group style: "w-fr gap-1"
                  (icon "swap_horiz" style: "h-max text-xl center-y")
                  (p "Replace" style: "h-max leading-none center-y"))
                ;; key
                (p "e" style: "h-max center-y rounded-xs leading-none font-mono p-1 pt-0 text-sm border text-neutral-400 border-neutral-400 font-medium")))
            ;; misc-list
            (group style: "w-fr flow-col gap-2"
              ;; misc-item
              (group style: "w-max border border-neutral-700 p-2 text-sm rounded-sm gap-1"
                (icon "auto_fix_high" style: "h-max center-y")
                (p "Spawn cursor" style: "h-max center-y leading-tight"))
              ;; misc-item
              (group style: "w-max border border-neutral-700 p-2 text-sm rounded-sm gap-1"
                (icon "cleaning_services" style: "h-max center-y")
                (p "Destroy cursor" style: "h-max center-y leading-tight"))
              ;; misc-item
              (group style: "w-max border border-neutral-700 p-2 text-sm rounded-sm gap-1"
                (icon "clear_all" style: "h-max center-y")
                (p "Clear" style: "h-max center-y leading-tight"))
              ))
          )
            ))))))
