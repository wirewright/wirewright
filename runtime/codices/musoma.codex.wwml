--- config ;; General config

;; No. of history frames to keep in memory.
history-limit: 128


--- theme ;; Microfold config

(include (theme fonts))
(include (theme "Rose Pine Main"))


--- (theme fonts) ;; Configure fonts for Microfold

(table fonts):
  {"mono":
     (list
       (font "IBM Plex Mono")
       (font "Julia Mono"))}


--- (theme "Rose Pine Main") ;; [Rose Pine](https://rosepinetheme.com)

(var base): "#191724"
(var surface): "#1f1d2e"
(var overlay): "#26233a"
(var muted): "#6e6a86"
(var subtle): "#908caa"
(var text): "#e0def4"
(var love): "#eb6f92"
(var gold): "#f6c177"
(var rose): "#ebbcba"
(var pine): "#31748f"
(var foam): "#9ccfd8"
(var iris): "#c4a7e7"
(var highlight-low): "#21202e"
(var highlight-med): "#403d52"
(var highlight-high): "#524f67"

(table colors):
  {"theme-base": ^base,
   "theme-surface": ^surface,
   "theme-overlay": ^overlay,
   "theme-muted": ^muted,
   "theme-subtle": ^subtle,
   "theme-text": ^text,
   "theme-highlight-low": ^highlight-low,
   "theme-highlight-med": ^highlight-med,
   "theme-highlight-high": ^highlight-high,
   "theme-punct": ^subtle,
   "theme-number": ^gold,
   "theme-boolean": ^rose,
   "theme-key": ^foam,
   "theme-blob": ^pine,
   "theme-string": ^gold,
   "theme-edge": ^love,
   "theme-comment": ^muted,
   "theme-section": ^iris,
   "theme-editor-selection-bg": ^gold,
   "theme-editor-selection-fg": ^base,
   "theme-selection-bg": ^foam,
   "theme-selection-fg": ^base,
   "theme-grab-bg": ^pine,
   "theme-grab-fg": ^text,
   "theme-normal-bg": ^iris,
   "theme-normal-fg": ^base,
   "theme-insert-bg": ^gold,
   "theme-insert-fg": ^base,
   "theme-attention-fg": ^gold
   "theme-info-fg": ^foam}


