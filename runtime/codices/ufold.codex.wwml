;; This is the standard *codex* for Microfold, Wirewright's box model/
;; styling... thing.
;;
;; This particular codex and Microfold as a whole are inspired *immensely*
;; by Tailwind. All credit for the design system, the particular values used,
;; the naming conventions, and so on, goes to the Tailwind folks
;; (see https://tailwindcss.com).
;;
;; NOTE: Tailwind seems to have changed somewhat since I've last looked at it
;; (and that was a long time ago!) So some things may be inconsistent. Consistency
;; is not the goal, however. Microfold is not an implementation of Tailwind
;; in any sensible way. The situation is close to Crystal vs. Ruby -- Crystal
;; is not an implementation of Ruby, nor is there a goal to keep Crystal consistent
;; with Ruby; it just so happens that Crystal was inspired by Ruby, just like
;; Microfold was inspired by Tailwind, and that there's a huge lot of overlap
;; in terms of syntax & naming, sometimes deliberately maintained, so much so
;; that simple Ruby programs may run using Crystal; but that is never
;; really guaranteed.

--- globals

;; The spacing factor.
;;
;; Reference: https://v3.tailwindcss.com/docs/customizing-spacing#default-spacing-scale
spacing: (* 0.25 rem)

;; Negative unit shorthands.
-rem: (* -1 rem)
-spacing: (* -1 spacing)


--- presets

p: "font-sans font-text text-base text-neutral"
a: "font-sans font-text text-base text-blue-500 underline underline-all underline-offset-0.6"
h1: "font-sans font-bold text-4xl text-neutral"
h2: "font-sans font-semibold text-3xl text-neutral"
h3: "font-sans font-medium text-2xl text-neutral"
h4: "font-sans font-medium text-xl text-neutral"
h5: "font-sans font-medium text-lg text-neutral"
h6: "font-sans font-semibold text-xs text-neutral upcase"
icon: "font-icons font-base text-neutral"
group: "flow-col"
code: "font-mono font-normal text-xs/4 bg-neutral-900 text-neutral-300 px-3 py-2 rounded border-l-md border-blue-400"
button: "font-sans font-normal font-sm py-2 bg-neutral-700 text-neutral-200 rounded content-center content-clip hover:bg-blue-700 hover:text-white hover:cursor-pointer active:bg-blue-600"


--- definitions

;;
;; Padding utilities.
;;

;; p-5, px-5, py-3, pl-0.5 pt-0.5, ...
(group
  (defn p
    (shorthand (prefix "p-" (number p))
      (px py ^:p)))

  (defn px
    (shorthand (prefix "px-" (number p))
      (pl pr ^:p)))

  (defn py
    (shorthand (prefix "py-" (number p))
      (pt pb ^:p)))

  (defn (padding-box pl)
    (utility (prefix "pl-" (number p))
      {pl: ^(* p spacing)}))

  (defn (padding-box pr)
    (utility (prefix "pr-" (number p))
      {pr: ^(* p spacing)}))

  (defn (padding-box pt)
    (utility (prefix "pt-" (number p))
      {pt: ^(* p spacing)}))

  (defn (padding-box pb)
    (utility (prefix "pb-" (number p))
      {pb: ^(* p spacing)})))

;; p-5px, px-5px, py-3px, pl-0.5px pt-0.5px, ...
(group
  (defn p-px
    (shorthand (circumfix "p-" (number p) "px")
      (px-px py-px ^:p)))

  (defn px-px
    (shorthand (circumfix "px-" (number p) "px")
      (pl-px pr-px ^:p)))

  (defn py-px
    (shorthand (circumfix "py-" (number p) "px")
      (pt-px pb-px ^:p)))

  (defn (padding-box pl-px)
    (utility (circumfix "pl-" (number p) "px")
      {pl: ^p}))

  (defn (padding-box pr-px)
    (utility (circumfix "pr-" (number p) "px")
      {pr: ^p}))

  (defn (padding-box pt-px)
    (utility (circumfix "pt-" (number p) "px")
      {pt: ^p}))

  (defn (padding-box pb-px)
    (utility (circumfix "pb-" (number p) "px")
      {pb: ^p})))

;;
;; Margin utilities.
;;

;; m-5, mx-5, my-3, ml-0.5 mt-0.5, ...
(group
  (defn m
    (shorthand (prefix "m-" (number m))
      (mx my ^:m)))

  (defn mx
    (shorthand (prefix "mx-" (number m))
      (ml mr ^:m)))

  (defn my
    (shorthand (prefix "my-" (number m))
      (mt mb ^:m)))

  (defn (margin-box ml)
    (utility (prefix "ml-" (number m))
      {ml: ^(* m spacing)}))

  (defn (margin-box mr)
    (utility (prefix "mr-" (number m))
      {mr: ^(* m spacing)}))

  (defn (margin-box mt)
    (utility (prefix "mt-" (number m))
      {mt: ^(* m spacing)}))

  (defn (margin-box mb)
    (utility (prefix "mb-" (number m))
      {mb: ^(* m spacing)})))

;; m-5px, mx-5px, my-3px, ml-0.5px mt-0.5px, ...
(group
  (defn m-px
    (shorthand (circumfix "m-" (number m) "px")
      (mx-px my-px ^:m)))

  (defn mx-px
    (shorthand (circumfix "mx-" (number m) "px")
      (ml-px mr-px ^:m)))

  (defn my-px
    (shorthand (circumfix "my-" (number m) "px")
      (mt-px mb-px ^:m)))

  (defn (margin-box ml-px)
    (utility (circumfix "ml-" (number m) "px")
      {ml: ^m}))

  (defn (margin-box mr-px)
    (utility (circumfix "mr-" (number m) "px")
      {mr: ^m}))

  (defn (margin-box mt-px)
    (utility (circumfix "mt-" (number m) "px")
      {mt: ^m}))

  (defn (margin-box mb-px)
    (utility (circumfix "mb-" (number m) "px")
      {mb: ^m})))

;;
;; Background utilities.
;;

(for bg-box
  (utility "bg-min-none"
    {min-w: 0, min-h: 0}))

;; Solid paint.
(for bg-box
  (utility (prefix "bg-" (one-of colors fill))
    {^:fill}))

;; Linear gradient paint.
(for bg-box
  (utility "bg-linear"
    {fill: linear-gradient}))

(for bg-box
  (utility (prefix "linear-from-" (one-of gradient-points point))
    {gradient-begin-l: ^(value point l)
     gradient-begin-t: ^(value point t)}))

(for bg-box
  (utility (prefix "linear-to-" (one-of gradient-points point))
    {gradient-end-l: ^(value point l)
     gradient-end-t: ^(value point t)}))

;; Gradient stops
(group
  (for bg-box
    (utility (prefix "from-" (one-of colors color))
      {gradient-from: ^color}))

  (for bg-box
    (utility (prefix "via-" (one-of colors color))
      {gradient-via: ^color}))

  (for bg-box
    (utility (prefix "to-" (one-of colors color))
      {gradient-to: ^color})))

;;
;; Border radius utilities.
;;

(defn (bg-box rounded-tl)
  (utility (prefix "rounded-tl-" (one-of radii radius))
    {radius-tl: ^radius}))

(defn (bg-box rounded-tr)
  (utility (prefix "rounded-tr-" (one-of radii radius))
    {radius-tr: ^radius}))

(defn (bg-box rounded-bl)
  (utility (prefix "rounded-bl-" (one-of radii radius))
    {radius-bl: ^radius}))

(defn (bg-box rounded-br)
  (utility (prefix "rounded-br-" (one-of radii radius))
    {radius-br: ^radius}))

(defn rounded-l
  (shorthand (prefix "rounded-l-" (one-of radii radius))
    (rounded-tl rounded-bl ^:radius)))

(defn rounded-r
  (shorthand (prefix "rounded-r-" (one-of radii radius))
    (rounded-tr rounded-br ^:radius)))

(defn rounded-t
  (shorthand (prefix "rounded-t-" (one-of radii radius))
    (rounded-tl rounded-tr ^:radius)))

(defn rounded-b
  (shorthand (prefix "rounded-b-" (one-of radii radius))
    (rounded-bl rounded-br ^:radius)))

(defn rounded
  (shorthand (prefix "rounded-" (one-of radii radius))
    (rounded-l rounded-r ^:radius)))

(alias "rounded" "rounded-md")
(alias "rounded-t" "rounded-t-md")
(alias "rounded-b" "rounded-b-md")
(alias "rounded-l" "rounded-l-md")
(alias "rounded-r" "rounded-r-md")
(alias "rounded-tl" "rounded-tl-md")
(alias "rounded-tr" "rounded-tr-md")
(alias "rounded-bl" "rounded-bl-md")
(alias "rounded-br" "rounded-br-md")

;;
;; Border utilities.
;;

(for bg-box
  (utility (prefix "border-" (one-of colors stroke))
    {^:stroke}))

;; border-l-xs, border-x-md, border-lg, ...
(group
  (defn (bg-box border-l)
    (utility (prefix "border-l-" (one-of border-sizes size))
      {thickness-l: ^size}))

  (defn (bg-box border-r)
    (utility (prefix "border-r-" (one-of border-sizes size))
      {thickness-r: ^size}))

  (defn (bg-box border-t)
    (utility (prefix "border-t-" (one-of border-sizes size))
      {thickness-t: ^size}))

  (defn (bg-box border-b)
    (utility (prefix "border-b-" (one-of border-sizes size))
      {thickness-b: ^size}))

  (defn border-x
    (shorthand (prefix "border-x-" (one-of border-sizes size))
      (border-l border-r ^:size)))

  (defn border-y
    (shorthand (prefix "border-y-" (one-of border-sizes size))
      (border-t border-b ^:size)))

  (defn border
    (shorthand (prefix "border-" (one-of border-sizes size))
      (border-l border-r border-t border-b ^:size))))

;; border-l-3px, border-x-5px, border-3px, ...
(group
  (defn (bg-box border-l-px)
    (utility (circumfix "border-l-" (number size) "px")
      {thickness-l: ^size}))

  (defn (bg-box border-r-px)
    (utility (circumfix "border-r-" (number size) "px")
      {thickness-r: ^size}))

  (defn (bg-box border-t-px)
    (utility (circumfix "border-t-" (number size) "px")
      {thickness-t: ^size}))

  (defn (bg-box border-b-px)
    (utility (circumfix "border-b-" (number size) "px")
      {thickness-b: ^size}))

  (defn border-x-px
    (shorthand (circumfix "border-x-" (number size) "px")
      (border-l-px border-r-px ^:size)))

  (defn border-y-px
    (shorthand (circumfix "border-y-" (number size) "px")
      (border-t-px border-b-px ^:size)))

  (defn border-px
    (shorthand (circumfix "border-" (number size) "px")
      (border-l-px border-r-px border-t-px border-b-px ^:size))))

(alias "border" "border-1px")
(alias "border-x" "border-x-1px")
(alias "border-y" "border-y-1px")
(alias "border-l" "border-l-1px")
(alias "border-r" "border-r-1px")
(alias "border-t" "border-t-1px")
(alias "border-b" "border-b-1px")

;;
;; Text color utilities.
;;

(for text-box
  (utility (prefix "text-" (one-of colors color))
    {^:color}))

;;
;; Letter spacing utilities.
;;
;; NOTE: our approach differs slightly in that we measure tracking in terms
;; of whitespace character width (whereas Tailwind measures it in `em`s).
;;

;; E.g. tracking-tight
(for text-box
  (utility (prefix "tracking-" (one-of tracking-values tracking))
    {^:tracking}))

;; E.g. tracking-3px
(for text-box
  (utility (circumfix "tracking-" (number value) "px")
    {tracking: (^value px)}))

;;
;; Line height utilities.
;;

;; E.g. leading-snug
(for text-box
  (utility (prefix "leading-" (one-of leading-values-rel leading))
    {^:leading}))

;; E.g. leading-lg, i.e., for a particular font size.
(for text-box
  (utility (prefix "leading-" (one-of leading-values-abs leading))
    {^:leading}))

;; E.g. leading-3, uses the spacing scale.
(for text-box
  (utility (prefix "leading-" (number value))
    {leading: (^(* value spacing) px)}))

;; E.g. leading-3px
(for text-box
  (utility (circumfix "leading-" (number value) "px")
    {leading: (^value px)}))

;;
;; Font family.
;;

(for text-box
  (utility (prefix "font-" (one-of fonts font))
    {^:font}))

;;
;; Font size utilities.
;;

;; E.g. font-lg
(for text-box
  (utility (prefix "font-" (one-of font-sizes size))
    {^:size}))

;; E.g. font-14px
(for text-box
  (utility (circumfix "font-" (number size) "px")
    {^:size}))

;; E.g. text-lg -> font-lg leading-lg
(for text-box
  (utility (prefix "text-" (and (one-of font-sizes size)
                                (one-of leading-values-abs leading)))
    {^:size ^:leading}))

;; E.g. text-sm/6 -> text-sm leading-6, i.e., sets the size and line height at
;; the same time.
(for text-box
  (utility (prefix "text-" (infix (one-of font-sizes size) "/" (number value)))
    {^:size leading: (^(* value spacing) px)}))

;; E.g. text-14px. We behave similar to font vs text in that text sets leading
;; whereas font doesn't.
(for text-box
  (utility (circumfix "text-" (number size) "px")
    {^:size leading: 1}))

;;
;; Font weight utilities.
;;

;; E.g. font-bold
(for text-box
  (utility (prefix "font-" (one-of font-weights weight))
    {^:weight}))

;;
;; Italicizing text.
;;

(for text-box
  (utility "italic" {italic: true}))

(for text-box
  (utility "-italic" {italic: false}))

;;
;; Underline
;;

;; As in ⏏underline⏏ underline-blue-500
(for text-box
  (utility "underline" {underline: true}))

(for text-box
  (utility "underline-all"
    {underline-anchor: 0,
     underline-span: -1}))

(for text-box
  (utility "-underline" {underline: false}))

;; E.g. underline-blue-500
(for text-box
  (utility (prefix "underline-" (one-of colors color))
    {underline-color: ^color}))

;; E.g. underline-3
(for text-box
  (utility (circumfix "underline-" (number thickness) "px")
    {underline-thickness: ^thickness}))

;; E.g. underline-offset-0.5
(for text-box
  (utility (prefix "underline-offset-" (number offset))
    {underline-offset: ^offset}))

;;
;; Selection
;;

;; As in ⏏sel⏏ sel-blue-500
(for text-box
  (utility "sel" {selection: true}))

(for text-box
  (utility "-sel" {selection: false}))

(for text-box
  (utility (prefix "sel-clearance-" (number value))
    {selection-clearance: ^(* value spacing)}))

;; E.g. sel-blue-500
(for text-box
  (utility (prefix "sel-" (one-of colors fill))
    {selection-fill: ^fill}))

;; E.g. sel-text-blue-500
(for text-box
  (utility (prefix "sel-text-" (one-of colors color))
    {selection-color: ^color}))

;; E.g. sel-rounded-lg
(for text-box
  (utility (prefix "sel-rounded-" (one-of radii radius))
    {selection-radius: ^radius}))

(alias "sel-rounded" "sel-rounded-md")

;; E.g. cursor-thin
(for text-box
  (utility (prefix "cursor-" (one-of cursor-thicknesses thickness))
    {selection-thickness: ^thickness}))

(for text-box
  (utility "sel-aim" {selection-aim: true}))

(for text-box
  (utility "-sel-aim" {selection-aim: false}))

;;
;; Text transform
;;

(for text-box
  (utility "upcase" {case: upcase}))

(for text-box
  (utility "dncase" {case: dncase}))

(for text-box
  (utility "title" {case: title}))

(for text-box
  (utility "capitalize" {transform: upcase-first}))

(for text-box
  (utility "strip" {transform: strip}))

(for text-box
  (utility "pretty" {transform: pretty}))

;;
;; Placeholder
;;

(for placeholder-rect
  (utility (prefix "placeholder-" (one-of colors fill))
    {^:fill}))

(for placeholder-rect
  (utility (prefix "placeholder-rounded-" (one-of radii radius))
    {radius-tl: ^radius
     radius-tr: ^radius
     radius-bl: ^radius
     radius-br: ^radius}))

(alias "placeholder-rounded" "placeholder-rounded-md")

(for placeholder-rect
  (utility (prefix "placeholder-border-" (one-of colors stroke))
    {^:stroke}))

(for placeholder-rect
  (utility (circumfix "placeholder-border-" (number thickness) "px")
    {thickness-l: ^thickness
     thickness-r: ^thickness
     thickness-t: ^thickness
     thickness-b: ^thickness}))

;;
;; Flow, floating, content (layout-related utilities)
;;

(for flow-box
  (utility "flow-none" {node: z-stack}))

(for flow-box
  (utility "flow-col" {node: y-stack}))

(for flow-box
  (utility "flow-row" {node: x-stack}))

(for flow-box
  (utility "flow-wrap" {node: x-wrap}))

(for flow-box
  (utility "flow-y-wrap" {node: y-wrap}))

;; E.g. flow-row gap-5, flow-wrap gap-x-10, flow-wrap gap-y-10
(group
  (for flow-box
    (utility (prefix "gap-" (number value))
      {gap: ^(* value spacing)}))

  (for flow-box
    (utility (prefix "gap-x-" (number value))
      {gap-x: ^(* value spacing)}))

  (for flow-box
    (utility (prefix "gap-y-" (number value))
      {gap-y: ^(* value spacing)})))

;; E.g. flow-row gap-sm, flow-wrap gap-x-lg, flow-wrap gap-y-lg
(group
  (for flow-box
    (utility (prefix "gap-" (one-of gap-sizes size))
      {gap: ^size}))

  (for flow-box
    (utility (prefix "gap-x-" (one-of gap-sizes size))
      {gap-x: ^size}))

  (for flow-box
    (utility (prefix "gap-y-" (one-of gap-sizes size))
      {gap-y: ^size})))

;; E.g. fr-1
(for outermost-box
  (utility (prefix "fr-" (number value))
    {fr: ^value}))

;; E.g. content hover:-content-x
(group
  (for content-box
    (utility "-content-x" {x: false}))

  (for content-box
    (utility "content-x" {x: true}))

  (for content-box
    (utility "-content-y" {y: false}))

  (for content-box
    (utility "content-y" {y: true}))

  (for content-box
    (utility "content"
      {x: true y: true}))

  (for content-box
    (utility "-content"
      {x: false y: false})))

;; E.g. floating hover:-floating-x
(group
  (for floating-box
    (utility "-floating-x" {x: false}))

  (for floating-box
    (utility "floating-x" {x: true}))

  (for floating-box
    (utility "-floating-y" {y: false}))

  (for floating-box
    (utility "floating-y" {y: true}))

  (for floating-box
    (utility "floating"
      {x: true
       y: true}))

  (for floating-box
    (utility "-floating"
      {x: false
       y: false})))

;;
;; Viewport
;;

(group
  (for content-viewport-box
    (utility "content-clip" {present: true}))

  (for content-viewport-box
    (utility "-content-clip" {present: false}))

  (for content-viewport-box
    (utility "content-aim" {aim: on}))

  (for content-viewport-box
    (utility "content-aim-off" {aim: off}))

  (for content-viewport-box
    (utility "content-aim-through"
      {aim: on-through}))

  (for content-viewport-box
    (utility "content-aim-off-through"
      {aim: off-through}))

  (for content-viewport-box
    (utility (prefix "content-clip-rounded-" (one-of radii radius))
      {radius-tl: ^radius,
       radius-tr: ^radius,
       radius-bl: ^radius,
       radius-br: ^radius})))

(group
  (for viewport-box
    (utility "clip" {present: true}))

  (for viewport-box
    (utility "-clip" {present: false}))

  (for viewport-box
    (utility "clip-aim" {aim: on}))

  (for viewport-box
    (utility "clip-aim-off" {aim: off}))

  (for viewport-box
    (utility "clip-aim-through" {aim: on-through}))

  (for viewport-box
    (utility "clip-aim-off-through" {aim: off-through})))

;;
;; Transform
;;

;; E.g. dl-10px, dt-10px, d-10px -> dl-10px dt-10px
(group
  (for transform-box
    (utility (circumfix "dl-" (number value) "px")
      {dl: ^value}))

  (for transform-box
    (utility (circumfix "dt-" (number value) "px")
      {dt: ^value}))

  (for transform-box
    (utility (circumfix "-dl-" (number value) "px")
      {dl: ^(* value -1)}))

  (for transform-box
    (utility (circumfix "-dt-" (number value) "px")
      {dt: ^(* value -1)}))

  (for transform-box
    (utility (circumfix "d-" (number value) "px")
      {dl: ^value
       dt: ^value})))

;; E.g. dl-3, dt-3
(group
  (for transform-box
    (utility (prefix "dl-" (number value))
      {dl: ^(* value spacing)}))

  (for transform-box
    (utility (prefix "dt-" (number value))
      {dt: ^(* value spacing)}))

  (for transform-box
    (utility (prefix "d-" (number value))
      {dl: ^(* value spacing)
       dt: ^(* value spacing)})))

;; E.g. dl-10%, dt-50%
(group
  (for transform-box
    (utility (circumfix "dl-" (number value) "%")
      {dl: (^value %)}))

  (for transform-box
    (utility (circumfix "dt-" (number value) "%")
      {dt: (^value %)}))

  (for transform-box
    (utility (circumfix "d-" (number value) "%")
      {dl: (^value %)
       dt: (^value %)})))

;;; E.g. origin-center
(for transform-box
  (utility (prefix "origin-" (one-of transform-points point))
    {origin-l: ^(value point l)
     origin-t: ^(value point t)}))

;; E.g. pivot-center
(for transform-box
  (utility (prefix "pivot-" (one-of transform-points point))
    {pivot-l: ^(value point l)
     pivot-t: ^(value point t)}))

;; E.g. scale-0.5, scale-3
(for transform-box
  (utility (prefix "scale-" (number scale))
    {^:scale}))

;; E.g. scale-xs, scale-lg
(for transform-box
  (utility (prefix "scale-" (one-of transform-scales scale))
    {^:scale}))

;; E.g. rotate-30
(for transform-box
  (utility (prefix "rotate-" (number angle))
    {^:angle}))

;; E.g. -rotate-30
(for transform-box
  (utility (prefix "-rotate-" (number angle))
    {angle: ^(- angle)}))

;; E.g. rotate-xs
(for transform-box
  (utility (prefix "rotate-" (one-of transform-angles angle))
    {^:angle,
     pivot-l: 0.5,
     pivot-r: 0.5}))

;; E.g. -rotate-xs
(for transform-box
  (utility (prefix "-rotate-" (one-of transform-angles angle))
    {angle: ^(- angle),
     pivot-l: 0.5,
     pivot-r: 0.5}))

;; E.g. 9-oclock, 5.5-oclock
(for transform-box
  (utility (suffix (number value) "-oclock")
    {angle: ^(* value 30)}))

;;
;; Align
;;

;; Itself

;; E.g. left, x-0.3
(group
  (for align-box
    (utility "left" {x: 0}))

  (for align-box
    (utility "center-x" {x: 0.5}))

  (for align-box
    (utility "right" {x: 1}))

  (for align-box
    (utility (prefix "x-" (number value))
      {x: ^value})))

;; E.g. bottom, y-0.7
(group
  (for align-box
    (utility "top" {y: 0}))

  (for align-box
    (utility "center-y" {y: 0.5}))

  (for align-box
    (utility "bottom" {y: 1}))

  (for align-box
    (utility (prefix "y-" (number value))
      {y: ^value})))

(for align-box
  (utility "center" {x: 0.5 y: 0.5}))

;; Content

;; E.g. left, x-0.3
(group
  (for content-align-box
    (utility "content-left" {x: 0}))

  (for content-align-box
    (utility "content-center-x" {x: 0.5}))

  (for content-align-box
    (utility "content-right" {x: 1}))

  (for content-align-box
    (utility (prefix "content-x-" (number value))
      {x: ^value})))

;; E.g. bottom, y-0.7
(group
  (for content-align-box
    (utility "content-top" {y: 0}))

  (for content-align-box
    (utility "content-center-y" {y: 0.5}))

  (for content-align-box
    (utility "content-bottom" {y: 1}))

  (for content-align-box
    (utility (prefix "content-y-" (number value))
      {y: ^value})))

(for content-align-box
  (utility "content-center" {x: 0.5 y: 0.5}))

;;
;; Limit
;;

(for limit-box
  (utility "clamp"
    {node: clamp}))

(for limit-box
  (utility "limit"
    {node: limit}))

;; E.g. min-w-100px, min-w-30, min-w-lg
(group
  (for limit-box
    (utility (circumfix "min-w-" (number value) "px")
      {min-w: ^value}))

  (for limit-box
    (utility (circumfix "min-w-" (number value) "%")
      {min-w: (^value %)}))

  (for limit-box
    (utility (prefix "min-w-" (number value))
      {min-w: ^(* value spacing)}))

  (for limit-box
    (utility (prefix "min-w-" (one-of limit-widths size))
      {min-w: ^size}))

  (for limit-box
    (utility "min-w-none" {min-w: 0})))

;; E.g. min-h-100px, min-h-lg
(group
  (for limit-box
    (utility (circumfix "min-h-" (number value) "px")
      {min-h: ^value}))

  (for limit-box
    (utility (circumfix "min-h-" (number value) "%")
      {min-h: (^value %)}))

  (for limit-box
    (utility (prefix "min-h-" (number value))
      {min-h: ^(* value spacing)}))

  (for limit-box
    (utility (prefix "min-h-" (one-of limit-heights size))
      {min-h: ^size}))

  (for limit-box
    (utility "min-h-none" {min-h: 0})))

;; E.g. max-w-100px, max-w-lg
(group
  (for limit-box
    (utility (circumfix "max-w-" (number value) "px")
      {max-w: ^value}))

  (for limit-box
    (utility (circumfix "max-w-" (number value) "%")
      {max-w: (^value %)}))

  (for limit-box
    (utility (prefix "max-w-" (number value))
      {max-w: ^(* value spacing)}))

  (for limit-box
    (utility (prefix "max-w-" (one-of limit-widths size))
      {max-w: ^size}))

  (for limit-box
    (utility "max-w-none" {max-w: ∞})))

;; E.g. max-h-100px, max-h-lg
(group
  (for limit-box
    (utility (circumfix "max-h-" (number value) "px")
      {max-h: ^value}))

  (for limit-box
    (utility (circumfix "max-h-" (number value) "%")
      {max-h: (^value %)}))

  (for limit-box
    (utility (prefix "max-h-" (number value))
      {max-h: ^(* value spacing)}))

  (for limit-box
    (utility (prefix "max-h-" (one-of limit-heights size))
      {max-h: ^size}))

  (for limit-box
    (utility "max-h-none" {max-h: ∞})))

;; E.g. min-100px, min-lg
(group
  (for limit-box
    (utility (circumfix "min-" (number value) "px")
      {min-w: ^value
       min-h: ^value}))

  (for limit-box
    (utility (circumfix "min-" (number value) "%")
      {min-w: (^value %)
       min-h: (^value %)}))

  (for limit-box
    (utility (prefix "max-" (number value))
      {min-w: ^(* value spacing),
       max-h: ^(* value spacing)}))

  (for limit-box
    (utility (prefix "min-" (and (one-of limit-widths w) (one-of limit-heights h)))
      {min-w: ^w
       min-h: ^h}))

  (for limit-box
    (utility "min-none"
      {min-w: ∞
       min-h: ∞})))

;; E.g. max-100px, max-lg
(group
  (for limit-box
    (utility (circumfix "max-" (number value) "px")
      {max-w: ^value
       max-h: ^value}))

  (for limit-box
    (utility (circumfix "max-" (number value) "%")
      {max-w: (^value %)
       max-h: (^value %)}))

  (for limit-box
    (utility (prefix "max-" (number value))
      {max-w: ^(* value spacing)
       max-h: ^(* value spacing)}))

  (for limit-box
    (utility (prefix "max-" (and (one-of limit-widths w) (one-of limit-heights h)))
      {max-w: ^w
       max-h: ^h}))

  (for limit-box
    (utility "max-none"
      {max-w: ∞
       max-h: ∞})))

(for limit-box
  (utility "flip" {flip: true}))

(for limit-box
  (utility "-flip" {flip: false}))

;;
;; Opacity
;;

(for composite-box
  (utility (circumfix "opacity-" (number value) "%")
    {opacity: ^(/ value 100)}))

(for composite-box
  (utility (prefix "opacity-" (number value))
    {opacity: ^value}))

(for composite-box
  (utility "opaque" {opacity: 1}))

(for composite-box
  (utility "transparent" {opacity: 0}))

;;
;; Aim (aim, -aim)
;;

(for aim-box
  (utility "aim" {aim: true}))

(for aim-box
  (utility "-aim" {aim: false}))

;;
;; Overlay
;;

(for overlay-box
  (utility "overlay" {overlay: true}))

(for overlay-box
  (utility "-overlay" {overlay: false}))

;;
;; Cursor
;;

(for root-box
  (utility (prefix "cursor-" (one-of cursors cursor))
    {^:cursor}))

;;
;; Misc
;;

(for self-box
  (utility (prefix "color-" (one-of colors color)) cascade: true
    {^:color}))

(for self-box
  (utility (prefix "fill-" (one-of colors fill)) cascade: true
    {^:fill}))

(for tag-box
  (utility (prefix "tag-" (symbol name))
    ^(entry name true)))

(for tag-box
  (utility (prefix "-tag-" (symbol name))
    ^(entry name false)))

(for root-box
  (utility "input" {input: true}))

(for root-box
  (utility "-input" {input: false}))

(for root-box
  (utility (prefix "backdrop-" (one-of colors color))
    {backdrop: ^color}))

;;
;; Properties
;;

(for text-box
  (property selections selection-anchor selection-span))

(for text-box
  (property underlines underline-anchor underline-span))

(for content-viewport-box
  (property content-page-x content-page-y content-offset-x content-offset-y))

(for viewport-box
  (property page-x page-y offset-x offset-y))

(for bg-box
  (property µ-bg as: fill))

;;
;; Boxes
;;

(box-order
  ;; text-box (native code)
  placeholder-rect
  self-box
  flow-box
  content-align-box
  content-viewport-box
  padding-box
  bg-box
  aim-box
  composite-box
  margin-box
  transform-box
  limit-box
  align-box
  content-box
  viewport-box
  floating-box
  overlay-box
  tag-box        ;; < virtual
  outermost-box) ;; < virtual
  ;; ...
  ;; root-box (native code)

;; Designations that target boxes listed here participate in the cascade,
;; i.e., are inherited by child boxes of the same type.
(box-cascade
  text-box)

;;
;; Box definitions
;;

(defn text-box
  (box ((parent_ caption_string) settings_dict)
    (^match parent
      (when [icon _*]
        (icon name: ^caption ^… settings))
      (when _
        (text ^:caption ^… settings)))))

(defn self-box
  (box (children_dict settings_dict)
    ^(union children settings)))

(defn placeholder-rect
  ;; TODO: Use a backmap.
  (box (children_dict settings_dict)
    (^each (children as child_)
      (^match child
        (when (child-head←(%any text img svg) ¦ child-args_ -placeholder)
          (^child-head placeholder: (rect ^… settings) ^… child-args))
        (when _
          ^child)))))

(defn flow-box
  (box (children_dict (%layer settings_ {| node_}))
    (^match (node children)
      (when (z-stack (_)) ^(union children settings))
      (when _ ((^node ^*children ^… settings))))))

(defn ⸨viewport,content-viewport⸩-box
  (box (children_dict (%layer settings_ {present: true}))
    ((viewport ^*children ^… settings))))

(defn padding-box
  (box (children_dict {¦ pl⋮ 0 pr⋮ 0 pt⋮ 0 pb⋮ 0})
    ((padding ^*children ^:pl ^:pr ^:pt ^:pb))))

(defn bg-box
  (box (children_dict settings_dict)
    ((z-stack
       (rect
         fill:
          (^match settings
            (when {¦ fill: linear-gradient
                     gradient-begin-l⋮ 0
                     gradient-begin-t⋮ 0
                     gradient-end-l⋮ 1
                     gradient-end-t⋮ 1}
              (linear-gradient
                (^match' (settings {¦ gradient-from_})
                  (stop 0 ^gradient-from))
                (^match' (settings {¦ gradient-via_})
                  (stop 0.5 ^gradient-via))
                (^match' (settings {¦ gradient-to_})
                  (stop 1 ^gradient-to))
                begin-l: ^gradient-begin-l
                begin-t: ^gradient-begin-t
                end-l: ^gradient-end-l
                end-t: ^gradient-end-t))
           (when {¦ fill_}
             ^fill))
        ^… (intersection settings
             {+ radius-tl radius-tr radius-bl radius-br
                stroke thickness-l thickness-r thickness-t thickness-b
                min-w min-h}))
       (^match settings
         ;; If we have some thickness, create a padding node around the child
         ;; for insets.
         (when (%keytest thickness-l thickness-r thickness-t thickness-b)
           (^match' (settings {¦ thickness-l⋮ 0 thickness-r⋮ 0 thickness-t⋮ 0 thickness-b⋮ 0})
             (padding pl: ^thickness-l pr: ^thickness-r pt: ^thickness-t pb: ^thickness-b
               ^*children)))
         (when _ ^*children))))))

(defn ⸨aim,overlay⸩-box
  (box (children_dict {¦ ⸨aim,overlay⸩: true})
    ((⸨aim,overlay⸩ ^*children))))

(defn composite-box
  (box (children_dict {¦ opacity_: (%number _ < 1)})
    ((composite ^*children ^:opacity))))

(defn margin-box
  (box (children_dict {¦ ml⋮ 0 mr⋮ 0 mt⋮ 0 mb⋮ 0})
    ((padding ^*children pl: ^ml pr: ^mr pt: ^mt pb: ^mb))))

(defn ⸨transform,align,content-align⸩-box
  (box (children_dict settings_dict)
    ((⸨transform,align,align⸩ ^*children ^… settings))))

(defn limit-box
  (box (children_dict {¦ min-w_⋮ 0 max-w_⋮ ∞ min-h_⋮ 0 max-h_⋮ ∞ flip⋮ false node⋮ limit})
    ((^match flip
       (when true
         (^node ^*children min-w: ^min-h min-h: ^min-w max-w: ^max-h max-h: ^max-w))
       (when false
         (^node ^*children ^:min-w ^:max-w ^:min-h ^:max-h))))))

(defn ⸨floating,content⸩-box
  (box (children_dict settings←(%any° {¦ x: true} {¦ y: true}))
    ((⸨floating,content⸩ ^*children x: false y: false ^… settings))))

(defn tag-box
  (box (children_dict settings_dict)
    ^(union children (select-f settings true))))

(defn outermost-box
  (box (children_dict settings_dict)
    ^(union children settings)))


