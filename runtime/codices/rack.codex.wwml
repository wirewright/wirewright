;; *combo* gives a text representation of the key press that this button
;; should trigger on. Example: `"+"`.
;;
;; *key* gives a system key, for example: `backspace`, `right`.
(Button action_ view_ ¦ () combo⋮ "" key⋮ none)
  => (component
       (surface (@surface (button action_ actions←(_*)))
         (button ^action ()))
       (cell @picture)
       ;; Notice how the button is able to see itself through `picture`, very much like
       ;; you can see it. So what's "inside" a live button is, in effect, its visual
       ;; reflection (@picture), the @view that will produce the next such reflection;
       ;; and the machinery tha bridges between the two. That is, the button basically
       ;; looks at its current reflection and thus decides what to do next, i.e., what
       ;; next reflection to produce.
       (picture @picture
         (node @view (template ^view)))
       (template
         (^unless (= combo "")
           (cell @combo ^combo))
         (^unless (= key none)
           (cell @key ^key))
         (^unless (= (combo key) (none ""))
           (node @kb (keyboard (buffer "") focus: true))))
       (backsys {@:combo @:key @:kb @:picture @:view @:action @:actions}
         {¦ kb: [keyboard (buffer buffer←(%not "")) _*]}
           <> {buffer: ""}
         {¦ kb: [keyboard (buffer combo←buffer_) _*] combo_ view: {¦ ⋮clicked}}
           <> {clicked: true, buffer: ""}
         {¦ kb: [keyboard _ K←(key key_)] key_ view: {¦ ⋮clicked}}
           <> {(K): (), clicked: true}
         {¦ picture: {¦ mouse: ⟨(button left up)⟩} view: {¦ -hover_}}
           <> {hover: true}
         {¦ picture: {¦ -mouse} view: {¦ hover_}}
           <> {(hover): ()}
         {¦ picture: {¦ mouse: ⟨(button left dn)⟩} view: {¦ hover -active_}}
           <> {active: true}
         {¦ picture: {¦ -mouse} view: {¦ active_}}
           <> {(active): ()}
         {¦ picture: {¦ mouse: ⟨(button left up) ⍊ over⟩} view: {¦ active_ ⋮clicked}}
            <> {(active): (), clicked: true}
         {¦ view: {¦ clicked_} action_ actions: (_* `back)}
           <> {(clicked): (), back: ^action}))

;; TODO: mouse click to move cursor
;; TODO: wrapping-aware up down left right
;; TODO: scrolling
;; TODO: selection
;; TODO: decouple from title, maybe even from `p`. an input doesn't really care about
;;   its style, it only cares about its reflection (`picture`), which should be standardized
;;   in some way. How that is obtained isn't really of Input's concern.
;; TODO: placeholder
(Input title_string)
  => (component
       (surface (@surface (input _ value_string))
         (input ^title ""))
       ;; HACK: we have to use cues because Microfold currently can't propagate
       ;; cursor-* to the parent window.
       (group style: "content-y flow-col gap-1 membrane has-input:is-input has-focused:cue-focused"
         (template
           (p style: "text-xs upcase font-semibold font-condensed in-focused:text-neutral-200"
             ^title))
         (picture @picture
           (node @view
             (p style: "px-2 py-1 text-neutral-300 bg-neutral-800 border-1.5 border-neutral-700 \
                        rounded hover:border-neutral-600 hover:is-input \
                        focus:selection selection-blue-400 focus:is-focused focus:bg-neutral-800 \
                        focus:border-blue-400 focus:text-neutral-100"
                selection-anchor: 0
                selection-span: 0
               ""))))
       (cell @picture)
       (node @kb (keyboard (buffer "" I "")))
       (backsys {@:kb @:view @:surface @:picture}
         ;; Mouse handling
         {¦ picture: {¦ mouse: {¦ over}}, view: {¦ -hover_}}
           <> {hover: true}
         {¦ picture: {¦ mouse: {¦ -over}} view: {¦ hover_}}
           <> {(hover): ()}
         {¦ picture: {¦ -mouse} view: {¦ hover_}}
           <> {(hover): ()}
         {¦ picture: {¦ mouse: ⟨(button left dn)⟩}, kb: {¦ -focus_}, view: {¦ hover_}}
           <> {focus: wanted}
         ;; Keyboard handling
         {¦ kb: ⟨& (buffer l_string I r_string) K←(key left)⟩}
           <> {(K): (), l: ^(runes l 0 ..= -2), r: ^(~ (rune l -1) r)}
         {¦ kb: ⟨& (buffer l_string I r_string) K←(key right)⟩}
           <> {(K): (), l: ^(~ l (rune r 0)), r: ^(runes r 1 ..= -1)}
         {¦ kb: ⟨& (buffer l_string I r_string) K←(key home)⟩}
           <> {(K): (), l: "", r: ^(~ l r)}
         {¦ kb: ⟨& (buffer l_string I r_string) K←(key end)⟩}
           <> {(K): (), l: ^(~ l r), r: ""}
         {¦ kb: ⟨& (buffer l_string I _string) K←(key backspace)⟩}
           <> {(K): (), l: ^(runes l 0 ..= -2)}
         {¦ kb: ⟨& (buffer _string I r_string) K←(key delete)⟩}
           <> {(K): (), r: ^(runes r 1 ..= -1)}
         ;; Keep surface in sync
         {¦ kb: ⟨& (buffer l_string I r_string)⟩, surface: [input _ text_string]}
           <> {text: ^(~ (up l) (up r))}
         ;; Keep text in sync.
         {¦ kb: ⟨& (buffer l_string I r_string)⟩ view: [p text_string]}
           <> {text: ^(~ (up l) (up r))}
         ;; Keep selection-anchor in sync.
         {¦ kb: ⟨& (buffer l_string I _string)⟩ view: (p _ ⍊ selection-anchor: ±anchor)}
           <> {anchor: ^(charcount (up l))}
         ;; Keep focus: _ in sync.
         {¦ kb: {¦ focus}, view: (p _ ⍊ -focus_)} <> {focus: true}
         {¦ kb: {¦ -focus}, view: (p _ ⍊ focus_)} <> {(focus): ()}))


