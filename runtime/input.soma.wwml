;; This rule system implements a basic multiline input field, its behavior copied
;; primarily from browser textareas (mostly Firefox). It supports:
;;
;; - Multiline editing
;; - Selections
;; - History (as in command-line shells)
;; - Submission
;;
;; There is no intrinsic support for copy-paste. We expect an observer to
;; implement it by pattern matching against an input field.
;;
;; They are mainly served through *utilities*, which are bound to *keys*.
;;
;; Although the `utilities` rule system is monolithic, the input field itself is
;; naturally modular. In order to have history, you will have to have structure
;; around the input field that can maintain history; structure that the rule
;; system will recognize. You will also have to bind keys to trigger history
;; utilities. Similar things can be said about inline input, multiline input,
;; and selections.
;;
;; For example, to have an input field that can only edit inline, only enable
;; keys for inline editing (`keys.inline`); do not wrap it in submission or
;; history structure; and sanitize your data to exclude newlines when constructing
;; the input field (or handle newlines during presentation).
;;
;; General info:
;;
;; - `event` rules match and transform events. They are consulted last, after
;;   all `instant` rules show no interest in the term and event at hand.
;; - `instant` rules match structure-event queue pairs, and are thus an example of
;;   *event-driven rewriting*. These rules can transform the structure, the event,
;;   or both; they can also emit events by appending or prepending to the queue
;;   (the latter is much more common here since we are in effect emulating a "call stack";
;;   most often, we want to completely handle the current event first before handling
;;   the next ones, and if handling means emission of events, then those events must
;;   be prepended).
;;
;; Since you will most likely need to pattern match against input fields and construct/
;; synthesize them, here are the relevant structures:
;;
;;  # Cursor
;;
;;   [L_string | R_string]
;;
;;     The most bare-bones you can get with this rule system. A basic cursor that
;;     responds to most primitive edits.
;;       L - text before the cursor
;;       R - text after the cursor
;;
;;  # Selection
;;
;;          left leaning                              right leaning
;;   [ · [L_string | M_string] R_string]   [ · L_string [M_string | R_string]]
;;    <|> cursor                            <|> cursor
;;    <\> passive                           <\> passive
;;    <-> active                            <-> active
;;
;;      Cursor selection is no selection (collapsed selection). Passive selection is
;;      the kind of selection that you get after you release the Shift key. Active
;;      selection is the kind of selection that you get when you are holding
;;      the Shift key.
;;        L -- text to the left of the selection
;;        M -- selected text
;;        R -- text to the right of the selection
;;
;;  # History
;;
;;   [(_*) <active cursor/selection> -|- () ()]
;;
;; # Submission
;;
;;   (submission <input field> · )
;;                             (proposal S_string)
;;                             ready
;;
;;    With submissions, you should pattern match for `proposal`s and handle
;;    whatever S is proposed; when you're done, emit `(submission accepted)`
;;    or `(submission rejected)`.

--- keys.editing

(event M←[keyboard input rune_string] _*)
  <> {M: (type →rune)}

(event M←[keyboard key ⸨backspace,delete⸩ dn] _*)
  <> {M: (remove rune ⸨left,right⸩)}

(event M←(keyboard key ⸨backspace,delete⸩ dn ⍊ ctrl) _*)
  <> {M: (remove word ⸨left,right⸩)}

(event M←[keyboard key enter dn] _*)
  <> {M: (break line left)}

(event M←(keyboard key enter dn ⍊ shift) _*)
  <> {M: (break line right)}


--- keys.inline

(event M←[keyboard key ⸨left,right⸩ dn] _*)
  <> {M: (goto rune ⸨left,right⸩)}

(event M←(keyboard key ⸨left,right⸩ dn ⍊ ctrl) _*)
  <> {M: (goto word ⸨left,right⸩)}

(event M←[keyboard key ⸨home,end⸩ dn] _*)
  <> {M: (goto line ⸨left,right⸩)}

(event M←(keyboard key ⸨home,end⸩ dn ⍊ ctrl) _*)
  <> {M: (goto text ⸨left,right⸩)}


--- keys.multiline

(event M←[keyboard key ⸨up,dn⸩ dn] _*)
  <> {M: (goto (line ⸨above,below⸩) anchor)}


--- keys.selection

(event M←[keyboard key (shift _) ⸨dn,up⸩] _*)
  <> {M: (make selection ⸨active,passive⸩)}

(event M←(keyboard key a dn ⍊ ctrl) _*)
  <> {M: (select text)}


--- keys.history

(event M←(keyboard key up dn ⍊ first-line: (%- false)) _*)
  <> {M: (goto history previous)}

(event M←(keyboard key dn dn ⍊ last-line: (%- false)) _*)
  <> {M: (goto history next)}


--- keys.submission

(event M←(keyboard key enter dn ⍊ at-end: (%- false)) _*)
  <> {M: (submit)}


--- utilities

;; Tag keys with some text position info for smarter dispatch.

(instant [_string | r_string] ((keyboard key _ dn ⍊ -at-end_) _*))
  <> {at-end: $'(= →r "")}

(instant [l_string | _string] (M←(keyboard key _ dn ⍊ -first-line_) _*))
  <> {first-line: $(= (rline/rest →l) "")}

(instant [_string | r_string] (M←(keyboard key _ dn ⍊ -last-line_) _*))
  <> {last-line: $(= (line/rest →r) "")}


;; |@ soma.input.type
;;
;; |@pattern
;; (type text_string)
;;
;; |@block
;; Inserts *text* before the cursor, or if in selection mode, replaces
;; selection with *text*.
;; |@endblock

(instant [l_string | _string] (U←(type text_string) _*))
  <> {(U): (), l: $'(~ →l →text)}

(instant [<⸨-,\⸩> [_string | m_string] _string] (U←(type text_string) _*))
  <> {U: (collapse selection right), m: →text}
(instant [<⸨-,\⸩> _string [m_string | _string]] (U←(type text_string) _*))
  <> {U: (collapse selection right), m: →text}


;; |@ soma.input.break
;;
;; |@pattern
;; (break line ⸨left,right⸩)
;;
;; |@block
;; Inserts a line break before (left) or after (right) the cursor.
;; |@endblock

(instant [l_string | _string] (U←(break line left) _*))
  <> {(U): (), l: $'(~ →l "\n")}

(instant [_string | r_string] (U←(break line right) _*))
  <> {(U): (), r: $'(~ "\n" →r)}


;; |@ soma.input.goto
;;
;; |@pattern
;; (goto ⟦rune,word,line,text⟧ ⸨left,right⸩)
;;
;; |@block
;; Moves the cursor or active selection focus by one designated
;; text object left or right.
;; |@endblock

(instant [l_string | r_string] (U←(goto ⸨rune,word⸩ left) _*))
  <> {(U): (), l: $'(⸨rune,word⸩s →l 0 ..= -2), r: $(~ (⸨rune,word⸩ →l -1) →r)}

(instant [l_string | r_string] (U←(goto ⸨rune,word⸩ right) _*))
  <> {(U): (), l: $(~ →l (⸨rune,word⸩ →r 0)), r: $'(⸨rune,word⸩s →r 1 ..= -1)}

(instant [l_string | r_string] (U←(goto text left) _*))
  <> {(U): (), l: "", r: $(~ →l →r)}

(instant [l_string | r_string] (U←(goto text right) _*))
  <> {(U): (), l: $(~ →l →r), r: ""}

(instant [l_string | r_string] (U←(goto line left) _*))
  <> {(U): (), l: $'(rline/rest →l), r: $(~ (rline/stem →l) →r)}

(instant [l_string | r_string] (U←(goto line right) _*))
  <> {(U): (), l: $(~ →l (line/stem →r)), r: $'(line/rest →r)}


;; |@ soma.input.goto
;;
;; |@pattern
;; (goto (line ⟦above,below⟧) ⸨left,right⸩)
;;
;; |@block
;; Moves the cursor to the beginning (left) or the end (right) of the line
;; above or below.
;; |@endblock

(event U←(goto (line ⸨above,below⸩) ⸨right,left⸩) _*)
  <> {(U): ((goto line ⸨left,right⸩) (goto rune ⸨left,right⸩))}

(event U←(goto (line ⸨above,below⸩) ⸨left,right⸩) _*)
  <> {(U): ((goto (line ⸨above,below⸩) ⸨right,left⸩) (goto line ⸨left,right⸩))}

;; |@ soma.input.goto
;;
;; |@pattern
;; (goto (line ⟦above,below⟧) (column ±N))
;;
;; |@block
;; Moves the cursor to the Nth column in the line above or below. Halts
;; on end-of-line if N overshoots.
;; |@endblock

(event U←(goto (line ⸨above,below⸩) (column ±N)) _*)
  <> {(U): ((goto (line ⸨above,below⸩) left) (goto rune (→N right)))}


;; |@ soma.input.goto
;;
;; |@pattern
;; (goto (line ⟦above,below⟧) anchor)
;;
;; |@block
;; Finds out what the cursor is anchored to (e.g. column, line start,
;; line end), and jumps to that in the line above or below.
;;
;; NOTE: at the moment, only column anchors are implemented.
;; |@endblock

(instant [l_string | _] ((goto (line ⸨above,below⸩) A←anchor) _*))
  <> {A: (column $(charcount (rline/stem →l)))}


;; |@ soma.input.goto
;;
;; |@pattern
;; (goto rune (±N right))
;;
;; |@block
;; Moves the cursor right by N runes, *halting on end-of-line*.
;; |@endblock

(instant [_string | _string] (`>U (goto rune (±N right)) _*))
  <> {>U: (reveal inline)}

(instant [(_ l_string) | (r_string _)] (U←(goto rune (±N right)) _*))
  <> {U: (conceal inline) l: $(~ →l (runes →r 0 ..< →N)), r: $'(runes →r →N ..= -1)}


;; |@ soma.input.goto
;;
;; |@pattern
;; (goto history ⸨previous,next⸩)
;;
;; |@block
;; Moves backward or forward in history.
;; |@endblock

(instant [(_* P_) _ -|- (`>P _*) (_*)] (U←(goto history previous) _*))
  <> {U: (history moved back), (P): (), >P: →P}

(instant [(_* `>S) _ -|- (S_ _*) (_*)] (U←(goto history next) _*))
  <> {U: (history moved forward), >S: →S, (S): ()}


;; NOTE: `suspended` is a special construct provided to us by the rewriter,
;; which acts as a dead-end for search. Thus, the copy of the cursor we'll
;; store in >C will not receive and handle events.
(instant [(_*) C_ -|- (_*) (`>C)] ((history moved back) _*))
  <> {>C: (suspended →C)}

;; Un-suspend when we've moved all the way down after
;; exploring history.
(instant [(_*) C_ -|- () (S←(suspended C'_))] (U←(history moved forward) _*))
  <> {(U): (), C: →C', (S): ()}

;; Sync the cursor with the active history entry.
(instant [(_*) _ -|- (S_string _*) (_)] (U←(history moved _) _*))
  <> {U: (edit →S)}


;; Just like the browsers do this: on any kind of text object, if
;; selection is passive, collapse it in that direction. E.g. pressing
;; Left arrow on a passive selection would collapse it to the left.
(instant [<\> _*] (U←(goto _ ⸨left,right⸩) _*))
  <> {U: (collapse selection ⸨left,right⸩)}

;; On the other hand, in an active selection, a goto utility must
;; conceal the selection and actually navigate somewhere (where exactly
;; depends on the kind of goto we get).
(instant [<-> _*] (`>U (goto _ _) `>V _*))
  <> {>U: (conceal selection), >V: (reveal selection)}


;; |@ soma.input.remove
;;
;; |@pattern
;; (remove ⟦rune,word⟧ ⸨left,right⸩)
;;
;; |@block
;; Removes one designated text object to the left or to the right.
;; |@endblock

(instant [l_string | _string] (U←(remove ⸨rune,word⸩ left) _*))
  <> {(U): (), l: $'(⸨rune,word⸩s →l 0 ..= -2)}

(instant [_string | r_string] (U←(remove ⸨rune,word⸩ right) _*))
  <> {(U): (), r: $'(⸨rune,word⸩s →r 1 ..= -1)}

;; Any kind of removal should collapse a selection destructively. The direction
;; of collapse doesn't matter here since the middle will end up empty.
(instant [<⸨-,\⸩> [_string | m_string] _string] (U←(remove _ _) _*))
  <> {U: (collapse selection right), m: ""}
(instant [<⸨-,\⸩> _string [m_string | _string]] (U←(remove _ _) _*))
  <> {U: (collapse selection right), m: ""}


;; |@ soma.input.edit
;;
;; |@pattern
;; (edit text_string)
;;
;; |@block
;; Replaces the content of the input field with text, removing its previous
;; content and canceling selection, if any.
;; |@endblock

(instant [l_string | r_string] (U←(edit text_string) _*))
  <> {(U): (), l: →text, r: ""}

(instant [<⸨\,-⸩> _*] (`>U (edit _) _*))
  <> {>U: (collapse selection right)}


;; |@ soma.input.make
;;
;; |@pattern
;; (make selection active)
;;
;; |@block
;; Transforms the cursor into an active empty selection.
;; |@endblock

(instant [H←<|> C←[_string | r_string] `>r] (U←(make selection active) _*))
  <> {(U): (), H: <->, r: "", >r: →r}


;; |@ soma.input.make
;;
;; |@pattern
;; (make selection passive)
;;
;; |@block
;; Transforms an active selection into a passive one. Transforms an empty
;; active selection into a cursor.
;; |@endblock

(instant [H←<-> [_string | m←""] r_string] (U←(make selection passive) _*))
  <> {(U): (), H: <|>, m: →r, (r): ()}

(instant [H←<⸨\,-⸩> l_string [m←"" | r_string]] (U←(make selection passive) _*))
  <> {(U): (), H: <|>, (l): (), m: →l}


;; This rule lets us switch between the two in the general case.
(instant [H←<⸨\,-⸩> _*] (U←(make selection ⸨active,passive⸩) _*))
  <> {(U): (), H: <⸨-,\⸩>}


;; |@ soma.input.select
;;
;; |@pattern
;; (select text)
;;
;; |@block
;; Transforms the cursor into a passive selection of the entire edited text.
;; |@endblock

(instant [H←<|> C←[l_string | r_string] `>r] (U←(select text) _*))
  <> {(U): (), H: <\>, l: "", r: $'(~ →l →r), >r: ""}

(instant [<⸨\,-⸩> _*] (`>U (select text) _*))
  <> {>U: (collapse selection right)}


;; |@ soma.input.collapse
;;
;; |@pattern
;; (collapse selection ⸨left,right⸩)
;;
;; |@block
;; Transforms an active or passive selection into a cursor on its left
;; or right.
;; |@endblock

(instant [H←<⸨-,\⸩> l_string [m_string | r_string]] (U←(collapse selection left) _*))
  <> {(U): (), H: <|>, (l): (), m: →l, r: $'(~ →m →r)}
(instant [H←<⸨-,\⸩> [l_string | m_string] r_string] (U←(collapse selection left) _*))
  <> {(U): (), H: <|>, m: $'(~ →m →r), (r): ()}

(instant [H←<⸨-,\⸩> l_string [m_string | _string]] (U←(collapse selection right) _*))
  <> {(U): (), H: <|>, (l): (), m: $'(~ →l →m)}
(instant [H←<⸨-,\⸩> [l_string | m_string] r_string] (U←(collapse selection right) _*))
  <> {(U): (), H: <|>, l: $'(~ →l →m), m: →r, (r): ()}


;; |@ soma.input.conceal
;;
;; |@pattern
;; (conceal inline)
;;
;; |@block
;; Converts an inline cursor form back into a multiline cursor.
;; |@endblock

(instant [L'←(L_string l_string) | R'←(r_string R_string)] (U←(conceal inline) _*))
  <> {(U): (), L': $'(~ →L →l), R': $'(~ →r →R)}


;; |@ soma.input.reveal
;;
;; |@pattern
;; (reveal inline)
;;
;; |@block
;; Transforms a cursor into an inline cursor form. This can simplify some
;; rules and editing operations, freeing them of line boundary tracking;
;; they only have to wrap themselves in `(reveal inline)` and `(conceal inline)`.
;; |@endblock

(instant [l_string | r_string] (U←(reveal inline) _*))
  <> {(U): (), l: ($'(rline/rest →l) $'(rline/stem →l)), r: ($'(line/stem →r) $'(line/rest →r))}


;; |@ soma.input.conceal
;;
;; |@pattern
;; (conceal selection)
;;
;; |@block
;; Transforms an active selection into a "concealed" one, storing positional
;; information as an integer rather than structurally.
;; |@endblock

(instant [H←<-> [l_string | m_string] r_string] (U←(conceal selection) _*))
  <> {(U): (), m: $'(~ →m →r), H: (<?> $'(charcount →l →m)), (r): ()}

(instant [H←<-> l_string [m_string | r_string]] (U←(conceal selection) _*))
  <> {(U): (), (l): (), H: (<?> $'(charcount →l)), m: $'(~ →l →m)}


;; |@ soma.input.reveal
;;
;; |@pattern
;; (reveal selection)
;;
;; |@block
;; Transforms concealed selection back into structural form, possibly
;; incorporating cursor movement that happened in the interim.
;; |@endblock

(instant [H←(<?> A←(%number +i32)) [(%group C l_string | r_string)]] ((reveal selection `>A `>A') _*))
  <> {>A: →A, (C): (| $'(~ →l →r)) >A': $'(charcount →l), H: <->}

(instant [<-> [| _string]] ((reveal selection `>dir A←(%number +i32) A'←(%number +i32)) _*))
  <> {>dir: $(join (< →A' →A) left right), A: $'(min →A →A'), A': $'(max →A →A')}

(instant [<-> [| T_string]] ((reveal selection _ L←(%number +i32) `>M R←(%number +i32)) _*))
  <> {L: $'(runes →T 0 ..< →L), >M: $'(runes →T →L ..< →R), R: $'(runes →T →R ..= -1)}

(instant [<-> [(%group C | _string)] `>R] (U←(reveal selection left L_string M_string R_string) _*))
  <> {(U): (), (C): (→L | →M), >R: →R}

(instant [<-> `>L [(%group C | _string)]] (U←(reveal selection right L_string M_string R_string) _*))
  <> {(U): (), >L: →L, (C): (→M | →R)}


;; |@ soma.input.submit
;;
;; |@pattern
;; (submit)
;;
;; |@block
;; Initiates submission. This requires the observer of the input field to
;; be aware of submissions, and to be able to respond to them with either
;; `(submission accepted)` or `(submission rejected)`.
;; |@endblock

(instant [l_string | r_string] (U←(submit) _*))
  <> {U: (request submission $'(~ →l →r))}

(instant [<⸨-,\⸩> _*] (`>U (submit) _*))
  <> {>U: (collapse selection right)}

(instant [submission _ slot←ready] (U←(request submission S_string) _*))
  <> {(U): (), slot: (proposal →S)}

(instant [submission _ slot←(proposal S_string)] (U←(submission accepted) _*))
  <> {U: (ack submission →S), slot: ready}

(instant [submission _ slot←(proposal S_string)] (U←(submission rejected) _*))
  <> {(U): (), slot: ready}

(instant [l_string | r_string] (U←(ack submission S_string) _*))
  <> {U: (append history →S), l: "", r: ""}


;; |@ soma.input.append
;;
;; |@pattern
;; (append history S_string)
;;
;; |@block
;; Navigates to the end of history and appends a string *S*.
;; |@endblock

(instant [(_* `>F) _ -|- (F_+) (_*)] ([append history _] _*))
  <> {(>F): →F, (F): ()}

(instant [(_* `>F) _ -|- () (T_)] ([append history _] _*))
  <> {(T): ()}

;; Do not append duplicate entries.
(instant [(_* S_) _ -|- () ()] (U←[append history S_] _*))
  <> {(U): ()}

;; Do not append empty entries.
(instant [(_*) _ -|- () ()] (U←[append history ""] _*))
  <> {(U): ()}

(instant [(_* `>S) _ -|- () ()] (U←[append history S_string] _*))
  <> {(U): (), >S: →S}

