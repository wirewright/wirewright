--- rules

[| M_ _*] <> {(M): ()}

(| M←[keyboard input rune_string] _* ⍊ modify⁺)
  <> {M: (insert (rune →rune) left)}

(| M←[keyboard key enter dn] _* ⍊ multiline⁺ modify⁺)
  <> {M: (insert (rune "\n") left)}

(| M←[keyboard key ⸨backspace,delete⸩ dn] _* ⍊ modify⁺)
  <> {M: (remove rune ⸨left,right⸩)}

(| M←(keyboard key ⸨backspace,delete⸩ dn ⍊ ctrl) _* ⍊ modify⁺)
  <> {M: (remove word ⸨left,right⸩)}

[| M←[keyboard key ⸨left,right⸩ dn] _*]
  <> {M: (goto rune ⸨left,right⸩)}

[| M←(keyboard key ⸨left,right⸩ dn ⍊ ctrl) _*]
  <> {M: (goto word ⸨left,right⸩)}

[| M←[keyboard key ⸨left,right⸩ dn] _*]
  <> {M: (goto rune ⸨left,right⸩)}

[| M←(keyboard key ⸨left,right⸩ dn ⍊ ctrl) _*]
  <> {M: (goto word ⸨left,right⸩)}

[| M←[keyboard key ⸨home,end⸩ dn] _*]
  <> {M: (goto text ⸨left,right⸩)}

(| M←[keyboard key ⸨home,end⸩ dn] _* ⍊ multiline⁺)
  <> {M: (goto line ⸨left,right⸩)}

(| M←(keyboard key ⸨home,end⸩ dn ⍊ ctrl) _* ⍊ multiline⁺)
  <> {M: (goto text ⸨left,right⸩)}

[l_string (%plural type: _string min: 0 max: 1) [| (keyboard key ⸨up,dn⸩ dn ⍊ -top_ -bot_) _*] (%plural type: _string min: 0 max: 1) r_string]
  <> {top: $(= (rline/rest →l) ""), bot: $(= (line/rest →r) "")}

[| M←(keyboard key ⸨up,dn⸩ dn ⍊ ⸨top,bot⸩: true) _*]
  <> {M: (goto text ⸨left,right⸩)}

(| M←(keyboard key ⸨up,dn⸩ dn ⍊ ⸨top,bot⸩: false) _* ⍊ multiline⁺)
  <> {M: (goto (line ⸨above,below⸩) anchor)}

[| M←[keyboard key escape dn] _*]
  <> {M: (dismiss)}

;; NOTE: unfortunately, it seems that the best option is to hard-code keys
;; here that will promote cursor to selection. Anything smarter would
;; misfire occasionally.
[_string [| `>M (keyboard key ⸨left,right,up,dn,home,end⸩ dn ⍊ shift -◇_) _*] _string]
  <> {>M: (promote selection), ◇: true}
(| M←[keyboard key (shift _) dn] _* ⍊ selection: passive)
  <> {M: (promote selection)}

[_string [| M←(keyboard key a dn ⍊ ctrl) _*] _string]
  <> {(M): ((promote selection) (select text) (demote selection))}

(| M←[keyboard key (shift _) up] _* ⍊ selection: active)
  <> {M: (demote selection)}


;; ---
;; Compose
;; ---

;;
;; Keys
;;
;; NOTE: we reuse some keys from the main input field.

(| M←[keyboard key insert dn] _* ⍊ compose⁺)
  <> {M: (summon compose)}

[compose _string [| M←[keyboard key insert dn] _*]]
  <> {M: (dismiss)}

[compose in_string [| M←[insert (rune rune_string) left] _*]]
  <> {M: (search), in: $'(~ →in →rune)}

[compose in←(%string nonempty) [| M←[remove rune left] _*]]
  <> {(M): (), in: $'(runes →in 0 ..= -2)}

[compose "" [| M←[remove rune left] _*]]
  <> {M: (dismiss compose)}

[compose _string [| M←[dismiss] _*]]
  <> {M: (dismiss compose)}

C←[compose _string C'←[| M←[dismiss compose] _*]]
  <> {(M): (), C: ↑C'}

;; Found.
C←[compose in_string C'←[| M←[found composite_string] _*]]
  <> {M: (insert (text →composite) left), C: ↑C'}

;; Not found.
[compose in_string [| M←[search] _*]]
  <> {(M): ()}

;;
;; Compose lookup table. Feel free to add your own keys here.
;;

[compose "oo" [| M←[search] _*]] <> {M: (found "°")}

[compose "^0" [| M←[search] _*]] <> {M: (found "⁰")}
[compose "^1" [| M←[search] _*]] <> {M: (found "¹")}
[compose "^2" [| M←[search] _*]] <> {M: (found "²")}
[compose "^3" [| M←[search] _*]] <> {M: (found "³")}
[compose "^4" [| M←[search] _*]] <> {M: (found "⁴")}
[compose "^5" [| M←[search] _*]] <> {M: (found "⁵")}
[compose "^6" [| M←[search] _*]] <> {M: (found "⁶")}
[compose "^7" [| M←[search] _*]] <> {M: (found "⁷")}
[compose "^8" [| M←[search] _*]] <> {M: (found "⁸")}
[compose "^9" [| M←[search] _*]] <> {M: (found "⁹")}

[compose "_0" [| M←[search] _*]] <> {M: (found "₀")}
[compose "_1" [| M←[search] _*]] <> {M: (found "₁")}
[compose "_2" [| M←[search] _*]] <> {M: (found "₂")}
[compose "_3" [| M←[search] _*]] <> {M: (found "₃")}
[compose "_4" [| M←[search] _*]] <> {M: (found "₄")}
[compose "_5" [| M←[search] _*]] <> {M: (found "₅")}
[compose "_6" [| M←[search] _*]] <> {M: (found "₆")}
[compose "_7" [| M←[search] _*]] <> {M: (found "₇")}
[compose "_8" [| M←[search] _*]] <> {M: (found "₈")}
[compose "_9" [| M←[search] _*]] <> {M: (found "₉")}

[compose "^+" [| M←[search] _*]] <> {M: (found "⁺")}
[compose "^-" [| M←[search] _*]] <> {M: (found "⁻")}

[compose "_+" [| M←[search] _*]] <> {M: (found "₊")}
[compose "_-" [| M←[search] _*]] <> {M: (found "₋")}

[compose "sm"  [| M←[search] _*]] <> {M: (found "∈")}
[compose "/sm" [| M←[search] _*]] <> {M: (found "∉")}
[compose "s="  [| M←[search] _*]] <> {M: (found "⊆")}
[compose "s<"  [| M←[search] _*]] <> {M: (found "⊂")}

[compose "^[" [| M←[search] _*]] <> {M: (found "\⸢")}
[compose "^]" [| M←[search] _*]] <> {M: (found "⸣")}

[compose "_[" [| M←[search] _*]] <> {M: (found "⸤")}
[compose "_]" [| M←[search] _*]] <> {M: (found "⸥")}

[compose "{{" [| M←[search] _*]] <> {M: (found "⟨")}
[compose "}}" [| M←[search] _*]] <> {M: (found "⟩")}

[compose "||" [| M←[search] _*]] <> {M: (found "¦")}
[compose "::" [| M←[search] _*]] <> {M: (found "⋮")}
[compose "==" [| M←[search] _*]] <> {M: (found "≡")}
[compose ".." [| M←[search] _*]] <> {M: (found "…")}
[compose "xx" [| M←[search] _*]] <> {M: (found "×")}

[compose "<-" [| M←[search] _*]] <> {M: (found "←")}
[compose "->" [| M←[search] _*]] <> {M: (found "→")}
[compose "^|" [| M←[search] _*]] <> {M: (found "↑")}
[compose "|v" [| M←[search] _*]] <> {M: (found "↓")}

[compose "|[" [| M←[search] _*]] <> {M: (found "⎡")}
[compose "|]" [| M←[search] _*]] <> {M: (found "⎤")}

[compose "((" [| M←[search] _*]] <> {M: (found "⸨")}
[compose "))" [| M←[search] _*]] <> {M: (found "⸩")}

[compose "[[" [| M←[search] _*]] <> {M: (found "⟦")}
[compose "]]" [| M←[search] _*]] <> {M: (found "⟧")}

[compose "//" [| M←[search] _*]] <> {M: (found "⫽")}
[compose "**" [| M←[search] _*]] <> {M: (found "⁑")}
[compose "|_" [| M←[search] _*]] <> {M: (found "⍊")}

[compose "<>" [| M←[search] _*]] <> {M: (found "◇")}
[compose "[]" [| M←[search] _*]] <> {M: (found "▢")}

[compose "*(" [| M←[search] _*]] <> {M: (found "⟅")}
[compose "*)" [| M←[search] _*]] <> {M: (found "⟆")}

[compose "<|" [| M←[search] _*]] <> {M: (found "↢")}
[compose "|>" [| M←[search] _*]] <> {M: (found "↣")}

[compose "^^" [| M←[search] _*]] <> {M: (found "⏏")}

[l_string [| M←[insert (text text_string) left] _*] _string]
  <> {(M): (), l: $'(~ →l →text)}

[_string [| M←[insert (text text_string) right] _*] r_string]
  <> {(M): (), r: $'(~ →text →r)}

[l_string [| M←[insert (rune rune_string) left] _*] _string]
  <> {(M): (), l: $'(~ →l →rune)}

[_string [| M←[insert (rune rune_string) right] _*] r_string]
  <> {(M): (), l: $'(~ →rune →r)}

[_string [| M←[select (term term_)] _*] _string]
  <> {(M): ((edit (term →term) right) (promote selection) (select text) (demote selection))}

[_string [| M←[edit (term term_) hdg_] _*] _string]
  <> {M: (edit (text $'(term->ml →term)) →hdg)}

[l_string [| M←[edit (text text_string) left] _*] r_string]
  <> {(M): (), l: "", r: →text}

[l_string [| M←[edit (text text_string) right] _*] r_string]
  <> {(M): (), l: →text, r: ""}

;; Do it the lazy way: via selection. This does mean removal of even a single
;; character is quite "verbose" and expensive. Whatever, genericity for the win!
[_string [| M←[remove ⸨rune,word,line⸩ hdg_] _*] _string]
  <> {(M): ((promote selection)
            (goto ⸨rune,word,line⸩ →hdg)
            (clear selection)
            (demote selection))}

[l_string [| M←[goto ⸨rune,word⸩ left] _*] r_string]
  <> {(M): (), l: $'(⸨rune,word⸩s →l 0 ..= -2), r: $(~ (⸨rune,word⸩ →l -1) →r)}

[l_string [| M←[goto ⸨rune,word⸩ right] _*] r_string]
  <> {(M): (), l: $(~ →l (⸨rune,word⸩ →r 0)), r: $'(⸨rune,word⸩s →r 1 ..= -1)}

[l_string [| M←[goto line left] _*] r_string]
  <> {(M): (), l: $'(rline/rest →l), r: $(~ (rline/stem →l) →r)}

[l_string [| M←[goto line right] _*] r_string]
  <> {(M): (), l: $(~ →l (line/stem →r)), r: $'(line/rest →r)}

[l_string [| M←[goto text left] _*] r_string]
  <> {(M): (), l: "", r: $(~ →l →r)}

[l_string [| M←[goto text right] _*] r_string]
  <> {(M): (), l: $(~ →l →r), r: ""}

[l_string [| M←[goto (line ⸨above,below⸩) A←anchor] _*] r_string]
  <> {A: (column $(charcount (rline/stem →l)))}

[_string [| M←[goto (line ⸨above,below⸩) (column ±col)] _*] _string]
  <> {(M): ((goto (line ⸨above,below⸩) left) (goto rune (→col right)))}

[_string [| M←[goto (line ⸨above,below⸩) ⸨right,left⸩] _*] _string]
  <> {(M): ((goto line ⸨left,right⸩) (goto rune ⸨left,right⸩))}

[_string [| M←[goto (line ⸨above,below⸩) ⸨left,right⸩] _*] _string]
  <> {(M): ((goto (line ⸨above,below⸩) ⸨right,left⸩) (goto line ⸨left,right⸩))}

[_string [| `>M (goto rune (±n right) ⍊ -▢_) `>N _*] _string]
  <> {>M: (summon line), >N: (dismiss line), ▢: true}
[l_string [| M←(goto rune (±n right) ⍊ ▢) _*] r_string]
  <> {(M): (), l: $(~ →l (runes →r 0 ..< →n)), r: $'(runes →r →n ..= -1)}

[l_string C←[| M←[summon line] _*] r_string]
  <> {(M): (), l: $'(rline/rest →l), C: ($'(rline/stem →l) ↑C $'(line/stem →r)), r: $'(line/rest →r)}

[L_string C←[l_string C'←[| M←[dismiss line] _*] r_string] R_string]
  <> {(M): (), L: $'(~ →L →l), C: ↑C', R: $'(~ →r →R)}

C←[| M←[summon compose] _*]
  <> {(M): (), C: (compose "" ↑C)}

;; To activate a selection, replace the cursor with the selection
;; structure and mark as active in workspace.
["" C←[| M←[promote selection] _*] ""]
  <> {(M): ()}
[_string C←(| M←[promote selection] _* ⍊ selection_: (%optional true true)) _string]
  <> {(M): (), (C): ("" ↑C), selection: active}

(| M←[promote selection] _* ⍊ selection_: passive)
  <> {(M): (), selection: active}

;; Demoting an empty selection in any state will turn it into a cursor.
[_string m←"" C←(| M←[demote selection] _* ⍊ selection_) _string]
  <> {(M): (), (m): (), selection: true}
[_string C←(| M←[demote selection] _* ⍊ selection_) m←"" _string]
  <> {(M): (), (m): (), selection: true}

;; Demoting a passive selection will turn it into a cursor.
[_string _string C←(| M←[demote selection] _* ⍊ selection: passive) _string]
  <> {M: (collapse selection right)}
[_string C←(| M←[demote selection] _* ⍊ selection: passive) _string _string]
  <> {M: (collapse selection left)}

[_string m_string C←(| M←[collapse selection left] _* ⍊ selection_) r_string]
  <> {(M): (), (m): (), r: $'(~ →m →r), selection: true}
[_string C←(| M←[collapse selection left] _* ⍊ selection_) m_string r_string]
  <> {(M): (), (m): (), r: $'(~ →m →r), selection: true}

[l_string m_string C←(| M←[collapse selection right] _* ⍊ selection_) _string]
  <> {(M): (), l: $'(~ →l →m), (m): (), selection: true}
[l_string C←(| M←[collapse selection right] _* ⍊ selection_) m_string _string]
  <> {(M): (), l: $'(~ →l →m), (m): (), selection: true}

[_string m_string [| M←[clear selection] _*] _string]
  <> {(M): (), m: ""}
[_string [| M←[clear selection] _*] m_string _string]
  <> {(M): (), m: ""}

;; Demoting an active, nonempty selection means switching from active
;; to passive selection state.
[_string (%string nonempty) C←(| M←[demote selection] _* ⍊ selection_: active) _string]
  <> {(M): (), selection: passive}
[_string C←(| M←[demote selection] _* ⍊ selection_: active) (%string nonempty) _string]
  <> {(M): (), selection: passive}

[l_string m_string C←[| M←[select text] _*] r_string]
  <> {(M): (), l: "", m: $'(~ →l →m →r), r: ""}
[l_string C←[| M←[select text] _*] m_string r_string]
  <> {(M): (), l: "", m: $'(~ →l →m →r), r: ""}

[l_string C←[| M←[select text (delta anchor←(%number +i32) delta←(%number -i32))] _*] r_string]
  <> {M: (select (text range $'(+ →anchor →delta) →anchor) left)}

[l_string C←[| M←[select text (delta anchor←(%number +i32) delta←(%number +i32))] _*] r_string]
  <> {M: (select (text range →anchor $'(+ →anchor →delta)) right)}

[l_string C←[| M←[select (text range i←(%number +i32) j←(%number +i32)) ⸨left,right⸩] _*] r_string]
  <> {M: (select (triple $(runes (~ →l →r) 0 ..< →i)
                         $(runes (~ →l →r) →i ..< →j)
                         $(runes (~ →l →r) →j ..= -1)) ⸨left,right⸩)}

[l_string C←[| M←[select (triple l'_string m'_string r'_string) left] _*] r_string]
  <> {(M): (), l: →l', (C): (↑C →m'), r: →r'}

[l_string C←[| M←[select (triple l'_string m'_string r'_string) right] _*] r_string]
  <> {(M): (), l: →l', (C): (→m' ↑C), r: →r'}

[l_string [| M←[render selection anchor←(%number +i32)] _*] _string]
  <> {M: (select text (delta →anchor $(- (charcount →l) →anchor)))}

;; We have four main things to handle in each selection state: insertion,
;; removal, goto, and summon.

;; Active selection

;; Goto in active selection will briefly dismiss the selection and let
;; the cursor do the goto in any way it wants. We'll then render the selection
;; back. This is stupid, sort of; but on the other hand, we and most importantly
;; our clients get to avoid all the range math; they can simply pattern match on
;; the input field to e.g. see what is selected without needing any sort of
;; computation in between.
[l_string m_string (| [goto _ _] `>M _* ⍊ selection: active) _string]
  <> {l: $'(~ →l →m), (m): (), >M: (render selection $'(charcount →l))}
[l_string (| [goto _ _] `>M _* ⍊ selection: active) m_string r_string]
  <> {(m): (), r: $'(~ →m →r), >M: (render selection $'(charcount →l →m))}

;; Insert and remove in active selection is bizarre (e.g. typing or pressing
;; backspace while shift is pressed and selection is active), so we'll demote
;; and let the passive state handle that. That's what browsers appear to do.
(| `>M [⸨insert,remove,summon⸩ _*] _* ⍊ selection: active)
  <> {>M: (demote selection)}

;; Passive selection

;; Goto in passive selection collapses it to the heading of that goto.
;; We do not care about the subject of the goto.
(| M←[goto ⟦rune,word⟧ ⸨left,right⸩] _* ⍊ selection: passive)
  <> {M: (collapse selection ⸨left,right⸩)}

;; Goto will otherwise collapse the selection in that direction, and will
;; be retried.
(| `>M [goto _ ⸨left,right⸩] _* ⍊ selection: passive)
  <> {>M: (collapse selection ⸨left,right⸩)}

;; Insert should clear the selection and be retried.
(| `>M [insert _*] _* ⍊ selection: passive)
  <> {(>M): ((clear selection) (demote selection))}

;; Remove in passive selection clears that selection and demotes it
;; to a cursor. Remove itself should not be retried.
(| M←[remove _ _] _* ⍊ selection: passive)
  <> {(M): ((clear selection) (demote selection))}


;; ------------------
;; Structural editing
;; ------------------

;;
;; Keys
;;

;; Pressing left, right, backspace, delete means inspect in that direction.
["" (| M←[keyboard key ⸨left,right,backspace,delete⸩ dn] _* ⍊ structural⁺) ""]
  <> {M: (inspect item ⸨left,right,left,right⸩)}

;; Pressing C-left or C-right means force edit in that direction.
["" (| M←(keyboard key ⸨left,right⸩ dn ⍊ ctrl) _* ⍊ structural⁺) ""]
  <> {M: (edit item ⸨left,right⸩)}

;; Presiing C-backspace or C-delete means remove item in that direction.
["" (| M←(keyboard key ⸨backspace,delete⸩ dn ⍊ ctrl) _* ⍊ structural⁺) ""]
  <> {M: (remove item ⸨left,right⸩)}

;; Pressing right at end-of-text means try to submit and if successful,
;; move cursor after submission.
[(%string nonempty) (| M←[keyboard key right dn] _* ⍊ structural⁺) ""]
  <> {M: (submit item left)}

;; Pressing left at begin-of-text means try to submit and if successful,
;; move cursor before submission.
["" (| M←[keyboard key left dn] _* ⍊ structural⁺) (%string nonempty)]
  <> {M: (submit item right)}

;; Pressing whitespace at end-of-text means try to submit, else
;; try another interpretation of whitespace.
[(%string nonempty) (| M←(keyboard input " " ⍊ -◇_) _* ⍊ structural⁺) ""]
  <> {M: ((submit item left) else ↑M), ◇: true}

;; Pressing whitespace with empty cursor means go to next spot.
["" (| M←[keyboard input " "] _* ⍊ structural⁺) ""]
  <> {M: (goto spot right enter: false)}

;; Pressing '(' should nest the cursor in a dict.
["" (| M←[keyboard input "("] _* ⍊ structural⁺) ""]
  <> {M: (nest cursor)}

;; Pressing ')' should append then try to submit.
[(%string nonempty) (| M←(keyboard input ")" ⍊ -◇_) `>M _* ⍊ structural⁺) ""]
  <> {M: ((submit item left) else ↑M), ◇: true}

;; Pressing ')' should otherwise escape dict right.
["" (| M←[keyboard input ")"] `>M _* ⍊ structural⁺) ""]
  <> {M: (escape dict right)}

;; Pressing up/down means go to previous/next item.
["" (| M←[keyboard key ⸨up,dn⸩ dn] _* ⍊ structural⁺) ""]
  <> {M: (goto item ⸨left,right⸩)}

;; Pressing up at begin-of-text means try to submit; if succeeded, inspect
;; the previous item.
["" (| M←[keyboard key up dn] _* ⍊ structural⁺) (%string nonempty)]
  <> {M: ((submit item right) then (inspect item left))}

⟨_dict [["" (| M←[keyboard key up dn] _* ⍊ structural⁺) ""] _*]⟩
  <> {(M): ((escape dict left) (enter dict left))}

[["" (| M←[keyboard key up dn] _* ⍊ structural⁺) ""] _*]
  <> {M: (escape dict left)}

⟨["" (| M←(keyboard key a dn ⍊ ctrl) _* ⍊ structural⁺) ""]⟩
  <> {M: (edit dict)}

;; C-enter at cursor should trigger submission.
[_string (| M←(keyboard key enter dn ⍊ ctrl) _* ⍊ structural⁺) _string]
  <> {M: (submit item left)}

;; C-enter in selection should collapse that selection and submit.
[_string _string (| `>M (keyboard key enter dn ⍊ ctrl) _* ⍊ structural⁺) _string]
  <> {>M: (collapse selection right)}
[_string (| `>M (keyboard key enter dn ⍊ ctrl) _* ⍊ structural⁺) _string _string]
  <> {>M: (collapse selection left)}

;; Pressing down at end-of-text means try to submit; if succeeded, inspect
;; the next item.
[(%string nonempty) (| M←[keyboard key dn dn] _* ⍊ structural⁺) ""]
  <> {M: ((submit item left) then (inspect item right))}

⟨[_* ["" (| M←[keyboard key dn dn] _* ⍊ structural⁺) ""]] _dict⟩
  <> {(M): ((escape dict right) (enter dict right))}

[_* ["" (| M←[keyboard key dn dn] _* ⍊ structural⁺) ""]]
  <> {M: (escape dict right)}

;; Pressing home or end means go to dict left/right.
⟨["" (| M←[keyboard key ⸨home,end⸩ dn] _* ⍊ structural⁺) ""]⟩
  <> {M: (goto dict ⸨left,right⸩)}

;; Pressing home or end at begin/end-of-dict means go to begin/end
;; of enclosing dict.
[["" (| M←[keyboard key home dn] _* ⍊ structural⁺) ""] _*]
  <> {(M): ((escape dict left) (goto dict left))}
[_* ["" (| M←[keyboard key end dn] _* ⍊ structural⁺) ""]]
  <> {(M): ((escape dict right) (goto dict right))}

;; Pressing home at begin-of-text means try to submit and go to dict left.
⟨["" (| M←[keyboard key home dn] _* ⍊ structural⁺) (%string nonempty)]⟩
  <> {M: ((submit item right) then (goto dict left))}

;; Pressing end at end-of-text means try to submit and go to dict right.
⟨[(%string nonempty) (| M←[keyboard key end dn] _* ⍊ structural⁺) ""]⟩
  <> {M: ((submit item left) then (goto dict right))}

;; Pressing Enter means escape right.
["" (| M←[keyboard key enter dn] _* ⍊ structural⁺) ""]
  <> {M: (escape dict right)}

;; Pressing S-enter means escape left.
["" (| M←(keyboard key enter dn ⍊ shift) _* ⍊ structural⁺) ""]
  <> {M: (escape dict left)}

;; Pressing Alt means carry parent in cursor.
⟨⟨["" (| M←(keyboard key _symbol dn ⍊ alt_) _* ⍊ structural⁺) ""]⟩⟩
  <> {M: (carry dict ↑M), (alt): ()}

;; Pressing backspace or delete in an empty dict should remove that dict.
(["" (| M←[keyboard key ⸨backspace,delete⸩ dn] _* ⍊ structural⁺) ""])
  <> {M: (unnest cursor)}

;; Pressing C-backspace or C-delete at the begin or end of itemsonly
;; dict will "spill" the itemspart.
D←(["" (| M←(keyboard key backspace dn ⍊ ctrl) _* ⍊ structural⁺) ""] _*)
  <> {(M): (), (D): ↑D}
D←(_* ["" (| M←(keyboard key delete dn ⍊ ctrl) _* ⍊ structural⁺) ""])
  <> {(M): (), (D): ↑D}

;; Pressing C-S-backspace at begin-of-dict, or C-S-delete anywhere in a dict,
;; means delete that dict.
["" (| M←(keyboard key ⸨backspace,delete⸩ dn ⍊ ctrl shift) _* ⍊ structural⁺) ""]
  <> {M: (unnest cursor)}

⟨_ ["" (| M←(keyboard key left dn ⍊ shift) _* ⍊ structural⁺) ""]⟩
  <> {(M): ((nest cursor) (capture item left))}

⟨["" (| M←(keyboard key right dn ⍊ shift) _* ⍊ structural⁺) ""] _⟩
  <> {(M): ((nest cursor) (capture item right))}

⟨_ [["" (| M←(keyboard key ⸨left,up⸩ dn ⍊ shift) _* ⍊ structural⁺) ""] _*]⟩
  <> {M: (capture item left)}
⟨[_* ["" (| M←(keyboard key ⸨right,dn⸩ dn ⍊ shift) _* ⍊ structural⁺) ""]] _⟩
  <> {M: (capture item right)}

[_* _ ["" (| M←(keyboard key up dn ⍊ shift) _* ⍊ structural⁺) ""]]
  <> {M: (release item right)}

[["" (| M←(keyboard key dn dn ⍊ shift) _* ⍊ structural⁺) ""] _ _*]
  <> {M: (release item left)}

⟨["" (| M←(keyboard key ⸨home,end⸩ dn ⍊ shift) _* ⍊ structural⁺) ""]⟩
  <> {M: (nest parent ⸨left,right⸩)}

⟨[(%string nonempty) (| M←(keyboard input ":" ⍊ -◇_) _* ⍊ structural⁺) ""]⟩
  <> {M: (if (submit item left) (edit pair left) ↑M), ◇: true}

;; Pressing any of these keys will delete a no-value pair with the cursor,
;; and move the cursor to the end of the dict's itemspart.
(_* ¦ (%entry _ C←["" [| M←[keyboard key ⸨left,backspace,delete,end⸩ dn] _*] ""]))
  <> {M: (erase pair right)}

;; Pressing Home in the same position should move the cursor to the beginning
;; of the dict's itemspart.
(_* ¦ (%entry _ C←["" [| M←[keyboard key home dn] _*] ""]))
  <> {M: (erase pair left)}

;; Pressing Right should move the cursor out of the dict since "right" is
;; visually there, so the user likely wants to go there.
(_* ¦ (%entry _ C←["" [| M←[keyboard key right dn] _*] ""]))
  <> {(M): ((erase pair right) (escape dict right))}

;;
;; Commands
;;

⟨_ [l←"," (| M←[keyboard input "d"] _* ⍊ structural⁺) ""]⟩
  <> {M: (dup item left), l: ""}

⟨[l←"," (| M←[keyboard input "D"] _* ⍊ structural⁺) ""] _⟩
  <> {M: (dup item right), l: ""}

⟨_ _ [l←"," (| M←[keyboard input "s"] _* ⍊ structural⁺) ""]⟩
  <> {M: (swap item left), l: ""}

⟨[l←"," (| M←[keyboard input "S"] _* ⍊ structural⁺) ""] _ _⟩
  <> {M: (swap item right), l: ""}

⟨[l←"," (| M←[keyboard input "/"] _* ⍊ structural⁺) ""]⟩
  <> {M: (split dict here), l: ""}

⟨[l←"," (| M←[keyboard input "\\"] _* ⍊ structural⁺) ""]⟩
  <> {M: (partition dict here), l: ""}

⟨_dict [l←"," (| M←[keyboard input "j"] _* ⍊ structural⁺) ""] _dict⟩
  <> {M: (join item here), l: ""}

⟨_ [l←"," (| M←[keyboard input "x"] _* ⍊ structural⁺) ""]⟩
  <> {M: (cut item left), l: ""}

⟨[l←"," (| M←[keyboard input "X"] _* ⍊ structural⁺) ""] _⟩
  <> {M: (cut item right), l: ""}

⟨_ [l←"," (| M←[keyboard input "y"] _* ⍊ structural⁺) ""]⟩
  <> {M: (yank item left), l: ""}

⟨[l←"," (| M←[keyboard input "Y"] _* ⍊ structural⁺) ""] _⟩
  <> {M: (yank item right), l: ""}

[l←"," (| M←[keyboard input "p"] _* ⍊ structural⁺) ""]
  <> {M: (paste item left), l: ""}

[l←"," (| M←[keyboard input "P"] _* ⍊ structural⁺) ""]
  <> {M: (paste item right), l: ""}

[l←"." (| M←[keyboard input "."] _* ⍊ structural⁺) ""]
  <> {M: (escape dict left), l: ""}

;;
;; Utilities
;;

;; NOTE: the only place where the rewriter cannot go is keys.
D←⟨C←[_string (| M←[carry dict V_] _* ⍊ -pocket_) _string]⟩
  <> {(M): (→V (uncarry dict)), (V): (), D: ↑C, pocket: $'(entry ↑D true)}

C←[_string (| M←[uncarry dict] _* ⍊ pocket_dict) _string]
  <> {C: $'(key →pocket)}

⟨(%any° _symbol _string _number _boolean (edge _)) [_string [| M←[inspect item left] _*] _string]⟩
  <> {M: (edit item left)}

⟨[_string [| M←[inspect item right] _*] _string] (%any° _symbol _string _number _boolean (edge _))⟩
  <> {M: (edit item right)}

[_string [| M←[inspect item left] _*] _string]
  <> {M: (goto spot left)}

[_string [| M←[inspect item right] _*] _string]
  <> {M: (goto spot right)}

⟨_dict [_string [| M←(goto spot left ⍊ enter: (%- false)) _*] _string]⟩
  <> {M: (enter dict left)}

[[_string [| M←[goto spot left] _*] _string] _*]
  <> {M: (escape dict left)}

[_string [| M←[goto spot left] _*] _string]
  <> {M: (goto item left)}

⟨[_string [| M←(goto spot right ⍊ enter: (%- false)) _*] _string] _dict⟩
  <> {M: (enter dict right)}

[_* [_string [| M←[goto spot right] _*] _string]]
  <> {M: (escape dict right)}

[_string [| M←[goto spot right] _*] _string]
  <> {M: (goto item right)}

D←⟨C←[_string (| [edit dict] _* ⍊ -pocket) _string]⟩
  <> {(C): (), D: $'(merge →C {1: {1: (select (term ↑D))}})}

⟨I_ C←[_string (| M←[edit item left] _* ⍊ -pocket) _string]⟩
  <> {M: (edit (term →I) right), (I): ()}

⟨C←[_string (| M←[edit item right] _* ⍊ -pocket) _string] I_⟩
  <> {M: (edit (term →I) left), (I): ()}

⟨I_ C←[_string [| M←[remove item left] _*] _string]⟩
  <> {(M): (), (I): ()}

⟨C←[_string [| M←[remove item right] _*] _string] I_⟩
  <> {(M): (), (I): ()}

[l_string [| M←[submit item ⸨left,right⸩] _*] r_string]
  <> {M: (submit (ml $'(~ →l →r)) ⸨left,right⸩)}

[_string [| [submit result←(ml ml_string) _] _*] _string]
  <> {result: $'(ml->term →ml)}

[l_string [| M←[submit (ml/ok term_) ⸨left,right⸩] _*] r_string]
  <> {(M): ((submit (term →term) ⸨left,right⸩) ok), l: "", r: ""}

;; TODO: jump to error
;; TODO: store error on cursor until modify
C←[l_string [| M←[submit (ml/err) _] _*] r_string]
  <> {M: err}

⟨C←[_string [| M←[submit (term T_) left] _*] _string]⟩
  <> {(M): (), (C): (→T ↑C)}

⟨C←[_string [| M←[submit (term T_) right] _*] _string]⟩
  <> {(M): (), (C): (↑C ↑T)}

(_* `>C ¦ (%entry _ C←[_string [| M←[submit (term T_) ⸨left,right⸩] _*] _string]))
  <> {(M): (), C: →T, >C: ↑C}

⟨I_ C←[_string [| M←[goto item left] _*] _string]⟩
  <> {(M): (), C: →I, I: ↑C}

⟨C←[_string [| M←[goto item right] _*] _string] I_⟩
  <> {(M): (), C: →I, I: ↑C}

[`>C _* C←[_string [| M←[goto dict left] _*] _string] _*]
  <> {(M): (), >C: ↑C, (C): ()}

[_* C←[_string [| M←[goto dict right] _*] _string] _* `>C]
  <> {(M): (), >C: ↑C, (C): ()}

⟨[_* `>C] C←[_string [| M←[enter dict left] _*] _string]⟩
  <> {(M): (), >C: ↑C, (C): ()}

⟨C←[_string [| M←[enter dict right] _*] _string] [`>C _*]⟩
  <> {(M): (), >C: ↑C, (C): ()}

⟨D←⟨C←[_string [| M←[escape dict left] _*] _string]⟩⟩
  <> {(M): (), (D): (↑C' ↑D), (C): ($tr C' ())}

⟨D←⟨C←[_string [| M←[escape dict right] _*] _string]⟩⟩
  <> {(M): (), (D): (↑D ↑C'), (C): ($tr C' ())}

C←[_string [| M←[nest cursor] _*] _string]
  <> {(M): (), C: (↑C)}

P←⟨C←[_string [| M←[nest parent left] _*] _string]⟩
  <> {(M): (), (C): ($tr C' ()), P: (↑C' ↑P)}

P←⟨C←[_string [| M←[nest parent right] _*] _string]⟩
  <> {(M): (), (C): ($tr C' ()), P: (↑P ↑C')}

D←⟨C←[_string [| M←[unnest cursor] _*] _string]⟩
  <> {(M): (), D: ↑C}

⟨I_ [[_string [| M←[capture item left] _*] _string] `>I _*]⟩
  <> {(M): (), (I): (), >I: →I}

⟨[_* `>I [_string [| M←[capture item right] _*] _string]] I_⟩
  <> {(M): (), (I): (), >I: →I}

⟨D←[[_string [| M←[release item left] _*] _string] I_ _*]⟩
  <> {(M): (), (D): (↑I' ↑D), (I): ($tr I' ())}

⟨D←[_* I_ [_string [| M←[release item right] _*] _string]]⟩
  <> {(M): (), (D): (↑D ↑I'), (I): ($tr I' ())}

⟨I_ [_string [| M←[dup item left] _*] _string]⟩
  <> {(M): (), (I): (→I →I)}

⟨[_string [| M←[dup item right] _*] _string] I_⟩
  <> {(M): (), (I): (→I →I)}

⟨I0_ I1_ [_string [| M←[swap item left] _*] _string]⟩
  <> {(M): (), I0: →I1, I1: →I0}

⟨[_string [| M←[swap item right] _*] _string] I0_ I1_⟩
  <> {(M): (), I0: →I1, I1: →I0}

D←(l_* C←[_string [| M←[split dict here] _*] _string] r_* ¦ pairs_)
  <> {(M): (), (D): (↑l ↑C $(∪ ↑r →pairs))}

D←⟨C←[_string [| M←[partition dict here] _*] _string]⟩
  <> {(M): (), (C): ($tr C' ()), (D): ($'(part ↑D items) ↑C' $'(part ↑D pairs))}

⟨X_dict C←[_string [| M←[join item here] _*] _string] Y_dict⟩
  <> {(M): (), (X): (), (Y): (), C: $'(cat →X (↑C) →Y)}

⟨I_ [_string (| M←[cut item left] _* ⍊ ⋮clipboard) _string]⟩
  <> {(M): (), (I): (), clipboard: $'(entry →I true)}

⟨[_string (| M←[cut item right] _* ⍊ ⋮clipboard) _string] I_⟩
  <> {(M): (), (I): (), clipboard: $'(entry →I true)}

⟨I_ [_string (| M←[yank item left] _* ⍊ ⋮clipboard) _string]⟩
  <> {(M): (), clipboard: $'(entry →I true)}

⟨[_string (| M←[yank item right] _* ⍊ ⋮clipboard) _string] I_⟩
  <> {(M): (), clipboard: $'(entry →I true)}

C←[_string (| M←[paste item left] _* ⍊ clipboard_: (%pipe tally 1)) _string]
  <> {(M): (), (C): ($'(key →clipboard) ↑C)}

C←[_string (| M←[paste item right] _* ⍊ clipboard_: (%pipe tally 1)) _string]
  <> {(M): (), (C): (↑C $'(key →clipboard))}

;; When we enter a pair that exists, we edit it, and rely on rules
;; that deal with editing to let the user enter the pair if it is
;; a dictionary.
⟨K←Kq_ C←[_string [| M←[edit pair left] _*] _string] ¦ (%value K V_)⟩
  <> {M: (select (term →V)), (Kq): (), (C): (), V: ↑C}
⟨K_ C←[_string [| M←[edit pair left] _*] _string] ¦ (%-value K V)⟩
  <> {(M): (), (K): (), (C): (), V: ↑C}

(`>C _* ¦ (%entry _ C←[_string [| M←[erase pair left] _*] _string]))
  <> {(M): (), >C: ↑C, (C): ()}
(_* `>C ¦ (%entry _ C←[_string [| M←[erase pair right] _*] _string]))
  <> {(M): (), >C: ↑C, (C): ()}

;;;

[| M←[if cond_ ok_ err_] _*]
  <> {(M): (→cond (br →ok →err))}

[| M←⸨ok,err⸩ V←[br ok_ err_] _*]
  <> {M: →⸨ok,err⸩, (V): ()}

[| M←[br _ _] _*]
  <> {(M): ()}

;; TODO: use if _ _ and unless _ _ instead !
[| M←[a_ ⸨then,else⸩ b_] _*]
  <> {(M): (→a (⸨then,else⸩ →b))}

[| M←ok V←[then a_] _*]
  <> {M: →a, (V): ()}

[| M←⸨ok,err⸩ V←[⸨then,else⸩ a_] _*]
  <> {M: →a, (V): ()}

[| M←⸨err,ok⸩ V←[⸨then,else⸩ a_] _*]
  <> {(M): (), (V): ()}

;; -----
;; Prompt
;; -----

;;
;; Keys
;;

;; Hit Enter to submit an entry to history.
[prompt (_*) [l←(%string nonempty) (| M←[keyboard key enter dn] _* ⍊ prompt⁺) ""] (_*)]
  <> {(M): ((goto history right)
            ((submit (reply →l) left) then (edit (text "") right)))}

;; Hit Up and Down keys on top/bottom line to navigate between history entries.
[prompt (_*) [_string (| M←(keyboard key ⸨up,dn⸩ dn ⍊ -mod ⸨top,bot⸩: true) _* ⍊ prompt⁺) _string] (_*)]
  <> {M: (goto reply ⸨left,right⸩)}

;;
;; Utilities
;;

[prompt (_* `>ahead) [_string [| M←[goto history right] _*] _string] (ahead_* tip_)]
  <> {(M): (), (>ahead): →ahead, (ahead): (), (tip): ()}

;; Mark as pending.
[prompt (_*) [_string [C←| [submit (reply _string) _] _*] _string] (_*)]
  <> {C: (pending |)}

;; React to status: accepted by adding to history.
[prompt (_*) [_string [C←(accepted |) M←[submit (reply entry_string) left] _*] _string] (_*)]
  <> {(M): ((append (history →entry) left) ok), C: |}
;; React to status: rejected by doing nothing through emission of `err`.
[prompt (_*) [_string [C←(rejected |) M←[submit (reply _string) _] _*] _string] (_*)]
  <> {M: err, C: |}

;; Do not append identical history entries.
[prompt (_* entry_) [_string [| M←[append (history entry_string) left] _*] _string] (_*)]
  <> {(M): ()}
[prompt (_* `>entry) [_string [| M←[append (history entry_string) left] _*] _string] (_*)]
  <> {(M): (), >entry: →entry}

[prompt (_* entry_string) [l_string [| M←[goto reply left] _*] r_string] (`>entry _+)]
  <> {M: (edit (text →entry) right), (entry): (), >entry: →entry}
[prompt (_* entry_string) [l_string [| M←[goto reply left] _*] r_string] (`>entry)]
  <> {M: (edit (text →entry) right), (entry): (), (>entry): (→entry $'(~ →l →r))}

[prompt (_* `>entry) [_string [| M←[goto reply right] _*] _string] (entry_string ahead_string _+)]
  <> {M: (edit (text →ahead) right), >entry: →entry, (entry): ()}
[prompt (_* `>entry) [_string [| M←[goto reply right] _*] _string] (entry_string home_string)]
  <> {M: (edit (text →home) right), >entry: →entry, (entry): (), (home): ()}

--- seed

;; (a b ("" (| (keyboard key backspace dn ctrl: true) (keyboard key delete dn ctrl: true)  modify: true goto: true structural: true) "") c d)
;; ("hello\nwo" (| (keyboard key up dn) multiline: true compose: true modify: true structural: true) "rld")

(prompt
  ()
  ("hello" (| multiline: true compose: true modify: true prompt: true) "")
  ())

;; TODO: org & tests. rule specificity is very nasty & relied upon here so we must have 100% coverage as in
;;       all rules hit in some way, so that we know they're all reachable.
