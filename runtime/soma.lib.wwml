;; FIXME: A lot of these components must be rewritten as they are written
;; in a horribly convoluted way. Especially `Scroll` which is very bad and
;; buggy and basically unusable. Do note that I'm discovering the "righter"
;; ways of writing these things as I go. It's not that I know anything, either.

;; |@ musoma.input
;;
;; |@pattern
;; (Input @state_ view_ ⍊ ⋮name)
;;
;; |@key state
;; Edge for storing the input's state. If empty, the input will initialize it.
;; The input state can be `(l_string r_string)` where `l` is the string to
;; the left of the cursor and `r` to the right; sometimes an `anchor` pair
;; is added which denotes the position of the anchor (the static end of a selection).
;; The input state can be modified in other ways; they should generally be ignored.
;;
;; |@key view
;; Nodes comprising the input's view. Importantly, a node with `value: _`
;; must exist in *view*, of the form `(_ _string ⍊ value)`. This is the node
;; that the input is going to manipulate. It is found using breadth-first search.
;;
;; |@block
;; View-agnostic "brain" for an input field. See the view-less overload for
;; stock view/styling.
(Input @state_ view_ ¦ props_)
  => (component {@:state}
       (comment "The following cells comprise this input's internal state.")
       (cell @unit rune)
       (cell @motions ())

       (comment
         "The input also contains reflections of the keyboard and the mouse, \
          since it is interested in both of them. The input wants to \
          watch the keyboard for, well... keys that you press, but only when \
          the input is focused; as for the mouse, the input wants to know \
          about it to detect things like hover, to let you click to focus & move \
          cursor, and so on.")
       (node @input (input))
       (node @mouse (mouse))

       (comment
         "Inputs are also interested in their own visual reflection, just like buttons are")
       (reflection {@:desc, @:node}
         (template ^view))

       (comment
         "The following massive rewriter is where the \"symbolic physics\" of the input \
          field is described. A bit less pretentiously, these are the rewrite rules that \
          are responsible for the input's behavior.")
       (rewriter ((rulesetR exh: true) - {@:state @:unit @:desc @:node @:input @:mouse @:motions})
         ;; Input focused.
         {¦ input: {¦ focus: true} node: {¦ -focus_}}
           <> {focus: true}
         ;; Input blurred.
         {¦ input: {¦ -focus} node: {¦ focus_: true}}
           <> {(focus): ()}
         ;; Input hovered while inactive, make sure no buttons are down,
         ;; otherwise they're dragging from somewhere else and happen to
         ;; land on top of us.
         {¦ desc: [reflection {¦ hit-hover}] mouse: [mouse] node: {¦ -hover_ -active}}
           <> {hover: true}
         ;; Input hovered while active, means they've returned from dragging
         ;; back to us.
         {¦ desc: [reflection {¦ hit-hover}] node: {¦ -hover_ active}}
           <> {hover: true}
         ;; Input unhovered.
         {¦ desc: [reflection {¦ -hit-hover}] node: {¦ hover_}}
           <> {(hover): ()}
         ;; Mouse down while hovered and not focused makes the input ask for focus.
         {¦ mouse: [mouse left] node: {¦ hover} input: {¦ -focus_}}
           <> {focus: wanted}
         ;; State can also ask for focus.
         {¦ state: {¦ focus_: true} input: {¦ -focus: >focus}}
           <> {(focus): (), >focus: wanted}
         ;; It can release focus as well.
         {¦ state: {¦ focus_: false} input: {¦ focus: >focus_}}
           <> {(focus): (), (>focus): ()}
         ;; Pressing left button while hovered makes the input active.
         {¦ mouse: [mouse left] node: {¦ hover -active_}}
           <> {active: true}
         ;; Releasing the button while active makes the input inactive.
         {¦ mouse: [mouse] node: {¦ active_}}
           <> {(active): ()}
         ;; Support Shift-Click: while the left button is pressed.
         {¦ mouse: [mouse B←left]
            input: ⟨(key (shift _))⟩
            node: {¦ active}
            desc: ⟪{¦ selection hit-anchor: ±pos hit-focus: ±pos}⟫
            state: [l_string r_string]}
           <> {(B): (), l: ^(runes (~ l r) 0 ..< pos), r: ^(runes (~ l r) pos ..= -1)}
         ;; Sync mouse hit-anchor and hit-focus if Shift is not held (implements
         ;; "drag to select").
         {¦ mouse: [mouse left]
            input: (%items () (key (shift _)) min: 0)
            node: {¦ active}
            desc: ⟪{¦ selection ±hit-anchor ±hit-focus}⟫
            state: (l_string r_string ⍊ ⋮anchor)}
           <> {(l): ^(let text: (~ l r)
                       ((runes text 0 ..< hit-focus)
                        (runes text hit-focus ..= -1))),
               (r): (),
               anchor: ^hit-anchor}
         ;; Sync state with anchor.
         {¦ state: (l_string r_string ⍊ ±anchor),
            node: ⟪(_ caption_string ⍊ value ⋮selection-anchor ⋮selection-span) ⍊ ⋮empty⟫}
           <> {caption: ^(~ l r),
               selection-anchor: ^(charcount l),
               selection-span: ^(- anchor (charcount l)),
               empty: ^(= (charcount l r) 0)}
         ;; Sync state without anchor.
         {¦ state: (l_string r_string ⍊ -anchor),
            node: ⟪(_ caption_string ⍊ value ⋮selection-anchor ⋮selection-span) ⍊ ⋮empty⟫}
           <> {caption: ^(~ l r),
               selection-anchor: ^(charcount l),
               selection-span: 0,
               empty: ^(= (charcount l r) 0)}
        ;; Zip selection without an active selection.
        {¦ state: (l_string r_string ⍊ -anchor) motions: (M←(zip selection) _*)}
          <> {(M): (), (l): (^l "")}
        ;; Zip selection with an active selection.
        {¦ state: (l_string r_string ⍊ ±anchor) motions: (M←(zip selection) _*)}
          <> {(M): (),
              (l): (),
              (r):
                ^(let* ((lcount (charcount l))
                        (lo (min lcount anchor))
                        (hi (max lcount anchor))
                        (text (~ l r)))
                   ((runes l 0 ..< lo)
                    (runes text lo ..< hi)
                    (runes text hi ..= -1)))}
        ;; Zip rune left.
        {¦ state: [l_string _] motions: (M←(zip rune left) _*)}
          <> {(M): (), (l): ^((runes l 0 ..= -2) (rune l -1))}
        ;; Zip rune right.
        {¦ state: [_ r_string] motions: (M←(zip rune right) _*)}
          <> {(M): (), (r): ^((rune r 0) (runes r 1 ..= -1))}
        ;; Zip word left.
        {¦ state: [l_string _] motions: (M←(zip word left) _*)}
          <> {(M): (), (l): ^((words l 0 ..= -2) (word l -1))}
        ;; Zip word right.
        {¦ state: [_ r_string] motions: (M←(zip word right) _*)}
          <> {(M): (), (r): ^((word r 0) (words r 1 ..= -1))}
        ;; Zip line left.
        {¦ state: [l_string _] motions: (M←(zip line left) _*)}
          <> {(M): (), (l): ^((rline/rest l) (rline/stem l))}
        ;; Zip line right.
        {¦ state: [_ r_string] motions: (M←(zip line right) _*)}
          <> {(M): (), (r): ^((line/stem r) (line/rest r))}
        ;; Partition by newlines, on both sides, on line up/dn.
        {¦ state: [l_string r_string] motions: ((zip line (%any up dn)) _*)}
          <> {l: ^(rpartition l "\n"), r: ^(partition r "\n")}
        ;; Partition behind into rest of lines above and line above.
        {¦ state: [(behind_string _ _) _] motions: ((zip line up) _*)}
          <> {behind: ^((rline/rest behind) (rline/stem behind))}
        ;; Partition ahead into line below and rest of lines below.
        {¦ state: [_ (_ _ ahead_string)] motions: ((zip line dn) _*)}
          <> {ahead: ^((line/stem ahead) (line/rest ahead))}
        ;; Split line above into before and after current column.
        {¦ state: [((_ above_string) _ stem_string) _] motions: ((zip line up) _*)}
          <> {above:
                ^(let col: (charcount stem)
                   ((runes above 0 ..< col)
                    (runes above col ..= -1)))}
        ;; Split line below into before and after current column.
        {¦ state: [(_ _ stem_string) (_ _ (below_string _))] motions: ((zip line dn) _*)}
          <> {below:
                ^(let col: (charcount stem)
                   ((runes below 0 ..< col)
                    (runes below col ..= -1)))}
        ;; Produce l-m-r for line up.
        {¦ state: [l←((behind_string (above-l_string above-r_string)) sep_string stem_string) _]
           motions: (M←(zip line up) _*)}
          <> {(M): (), (l): ^((~ behind above-l) (~ above-r sep stem))}
        ;; Produce l-m-r for line dn.
        {¦ state: [_ r←(suffix_string sep_string ((below-l_string below-r_string) ahead_string))]
           motions: (M←(zip line dn) _*)}
          <> {(M): (), (r): ^((~ suffix sep below-l) (~ below-r ahead))}
        ;; Join line partition on left side if right side is joined after zip.
        {¦ state: [l←(behind_string sep_string stem_string) _string _string]}
          <> {l: ^(~ behind sep stem)}
        ;; Join line partition on right side if left side is joined after zip.
        {¦ state: [_string _string r←(suffix_string sep_string ahead_string)]}
          <> {r: ^(~ suffix sep ahead)}
        ;; Remove anchor during unzip if Shift is not held.
        {¦ state: (l_string m_string _ ⍊ ±anchor)
           input: (%items () (key (shift _)) min: 0)
           motions: (M←unzip _*)}
          <> {(M): (), l: ^(~ l m), (m): (), (anchor): ()}
        ;; Keep anchor during unzip if Shift held.
        {¦ state: [l_string m_string _] motions: (M←unzip _*)}
          <> {(M): (), l: ^(~ l m), (m): ()}
        ;; Motion: Replace middle.
        {¦ state: [_ m_string _] motions: (M←(replace rune_string) _*)}
          <> {(M): (), m: ^rune}
        ;; Motion: delete middle.
        {¦ state: [_ m_string _] motions: (M←delete _*)}
          <> {(M): (), m: ""}
        ;; Motion: expel [to the] left.
        {¦ state: [_ m_string r_string] motions: (M←(expel left) _*)}
          <> {(M): (), m: "", r: ^(~ m r)}
        ;; Motion: expel [to the] right.
        {¦ state: [l_string m_string _] motions: (M←(expel right) _*)}
          <> {(M): (), l: ^(~ l m), m: ""}
        ;; Motion: select text.
        {¦ state: (l_string r_string ⍊ ⋮anchor) motions: (M←(select text) _*)}
          <> {(M): (), anchor: 0, l: ^(~ l r), r: ""}
        ;; Handle typing.
        {¦ input: ⟨K←(rune rune_string)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip selection) (replace ^rune) unzip)}
        ;; Handle Enter.
        {¦ input: ⟨K←(key enter)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip selection) (replace "\n") unzip)}
        ;; Handle backspace.
        {¦ state: {¦ -anchor} unit_ input: ⟨K←(key backspace)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip ^unit left) delete unzip)}
        ;; Handle delete.
        {¦ state: {¦ -anchor} unit_ input: ⟨K←(key delete)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip ^unit right) delete unzip)}
        ;; Handle backspace/delete.
        {¦ input: ⟨K←(key (%any backspace delete))⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip selection) delete unzip)}
        ;; Handle left.
        {¦ unit_ input: ⟨K←(key left)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip ^unit left) (expel left) unzip)}
        ;; Handle right.
        {¦ unit_ input: ⟨K←(key right)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip ^unit right) (expel right) unzip)}
        ;; Handle up.
        {¦ input: ⟨K←(key up)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip line up) (expel left) unzip)}
        ;; Handle down.
        {¦ input: ⟨K←(key dn)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip line dn) (expel right) unzip)}
        ;; Handle Ctrl-A.
        {¦ input: ⟨& (key (ctrl _)) K←(key "a")⟩ motions: (_* `M)}
          <> {(K): (), M: (select text)}
        ;; Handle Home.
        {¦ input: ⟨K←(key home)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip line left) (expel left) unzip)}
        ;; Handle End.
        {¦ input: ⟨K←(key end)⟩ motions: (_* `M)}
          <> {(K): (), (M): ((zip line right) (expel right) unzip)}
        ;; While Ctrl is held, the navigation unit is word.
        {¦ unit_: rune input: ⟨(key (ctrl _))⟩}
          <> {unit: word}
        ;; Otherwise, the navigation unit is rune.
        {¦ unit_: word input: (%items () (key (ctrl _)) min: 0)}
          <> {unit: rune}
        ;; While Shift is held, and no runes exist, define anchor if not defined already.
        {¦ state: (l_string _ ⍊ -anchor_) input: ⟨(key (shift _))⟩}
          <> {anchor: ^(charcount l)}
        ;; Clear the anchor if it is at the same position as the cursor, and
        ;; Shift is not pressed.
        {¦ state: (l←(%pipe charcount anchor_) _ ⍊ anchor_)
           input: (%items () (key (shift _)) min: 0)}
          <> {(anchor): ()}))

;; |@ musoma.input
;;
;; |@pattern
;; (Input ¦ props_ label⋮ "" placeholder⋮ "")
;;
;; |@key props
;; Properties to pass to the underlying `Input` component.
;;
;; |@key label
;; Text to display above the input field.
;;
;; |@key placeholder
;; Text to display in the input field while it is empty.
;;
;; |@block
;; Stock view/styling for an Input field based on the current MuSoma theme.
(Input @state_ ¦ props_ label⋮ "" label-style⋮ "" placeholder⋮ "" placeholder-style⋮ "" content-style⋮ "" box-style⋮ "")
  => ($Input ^state
       (box style: "flow-col gap-2/3 membrane hover:cue-hover active:cue-active \
                    focus:cue-focus focus:input empty:cue-empty"
         ;; Render the label, if any.
         (^when (label (%string nonempty))
           (p style: ^"content upcase font-condensed text-sm leading-none text-theme-muted \
                       in-hover:text-theme-subtle in-focus:text-theme-selection-bg ⸢label-style⸣"
             ^label))
         (box style: ^"fr-1 content-clip border-xs border-theme-highlight-low rounded-sm \
                       px-2 py-1 in-hover:cursor-text in-hover:border-theme-highlight-med \
                       in-focus:border-theme-selection-bg ⸢box-style⸣"
           ;; Display placeholder, but only in an empty field.
           (p style: ^"absent in-empty:present text-theme-muted leading-none ⸢placeholder-style⸣"
             ^placeholder)
           (p style: ^"content-y sel sel-endl sel-aim sel-clearance-x-3 sel-clearance-line \
                       sel-text-theme-muted in-focus:sel-text-theme-selection-fg sel-theme-highlight-low \
                       in-hover:sel-theme-highlight-med text-theme-text leading-tight \
                       beam-transparent in-hover:beam-thick in-focus:beam-thick \
                       in-focus:sel-theme-selection-bg ⸢content-style⸣"
              value: true
             "")))
       ^… props)

;; |@ musoma.y-scrollbar
;;
;; |@pattern
;; (YScrollbar @thumb-dt_ @thumb-h_ @track-h_ ⍊ track-style⋮ "" thumb-style⋮ "")
;;
;; |@key thumb-dt
;; Edge for reading and writing _d_elta _t_op of the thumb within the track (pixels).
;;
;; |@key thumb-h
;; Edge for reading and writing the height of the thumb (pixels).
;;
;; |@key track-h
;; Edge for reading the height of the track (pixels).
;;
;; |@key track-style
;; Microfold styles to append to the track. Use this to customize the appearance
;; of the track.
;;
;; |@key thumb-style
;; Microfold styles to append to the thumb. Use this to customize the appearance
;; of the thumb.
;;
;; |@block
;; Implements a basic vertical scrollbar. Uses stock styling, which is customizable
;; via *track-style* and *thumb-style*.
(YScrollbar @thumb-dt_ @thumb-h_ @track-h_ @show_ ⍊ track-style⋮ "" thumb-style⋮ "")
  => (component {@:thumb-dt @:thumb-h @:track-h @:show}
       (comment "Give outside world (and ourselves!) direct access to parts of the reflection below.")
       (part (@node @thumb-dt) [track [thumb-container (thumb _ ⍊ µ-dt: ±thumb-dt)]])
       (part (@node @thumb-h) [track [thumb-container (thumb _ ⍊ µ-h: ±thumb-h)]])
       (part (@desc @track-h) ⟪(thumb-container _ ⍊ h: ±track-h)⟫)
       (part (@desc @thumb-hover) ⟪(thumb _ ⍊ hit-hover: thumb-hover_)⟫)
       (part (@desc @track-goal) [reflection (track _ ⍊ hit-hover hit-focus-t: ±track-goal)])
       (part (@node @show) {¦ show_})
       (part (@desc @scroll-hover) [reflection (track _ ⍊ hit-hover: scroll-hover_)])

       (comment
         "Define the visual appearance for the scrollbar. Notice how we have \
          a dedicated thumb-container instead of just using track's height. This \
          is because track-style can include things like padding that do not affect \
          track's own height but do restrict thumb's max height. Therefore, we use \
          thumb-container's height instead of track's for track-h.")
       (reflection {@:desc, @:node}
         (template
           (track style: ^"transparent show:opaque flow-none bg-transparent bg-min-none \
                           content-x membrane hover:cue-hover active:cue-active ⸢track-style⸣"
                  show: false
             (thumb-container style: ""
               (thumb style: "" µ-dt: 0 µ-h: 0
                 (box style: ^"bg-theme-highlight-med bg-min-none max-w-1 rounded-full in-hover:bg-theme-subtle \
                               in-active:bg-theme-text ⸢thumb-style⸣"))))))

       (comment
         "The scrollbar is interested in the mouse because (at the moment) only \
          the mouse can control it.")
       (node @mouse (mouse))

       (comment
         "The rewriter below controls the behavior of the scrollbar. Notice how it \
          is a severely capped exhR. But even with limit: 3 there's a lot of opportunities \
          for the rules to apply. exhR is needed here to make sure we do the clamps during \
          just one tick; we can't spread it over multiple ticks due to UX concerns.")
       (rewriter ((exhR (rulesetR exh: true) limit: 3) - {@:mouse @:thumb-dt @:thumb-h @:thumb-hover @:track-goal @:track-h @:scroll-hover @:node})
         ;; Sync visual hover with logical hover: hover.
         {¦ thumb-hover mouse: [mouse] node: {¦ -hover_}}
           <> {hover: true}
         ;; Sync visual hover with logical hover: unhover.
         {¦ -thumb-hover node: {¦ hover_}}
           <> {(hover): ()}
         ;; When you do mouse left over the thumb, ask mouse for focus coords
         ;; and mark node as active.
         {¦ node: {¦ hover -active_} mouse: (mouse left ⍊ -focus_)}
           <> {active: true, focus: ?}
         ;; When you release mouse left we reset the mouse the easy way and
         ;; unmark active.
         {¦ mouse_: [mouse] node: {¦ active_}}
           <> {mouse: (mouse), (active): ()}
         ;; When mouse gets focus coords define ref-y (reference Y).
         {¦ mouse: (mouse left ⍊ -ref-y_ -ref-dt_ focus: {¦ ±y}) node: {¦ active} ±thumb-dt}
           <> {ref-y: ^y, ref-dt: ^thumb-dt}
         ;; Maintain thumb-dt in bounds.
         {¦ ±thumb-dt ±thumb-h ±track-h}
           <> {thumb-dt: ^(max 0 (min thumb-dt (- track-h thumb-h)))}
         ;; Maintain ref-dt in bounds.
         {¦ mouse: {¦ ±ref-dt} ±thumb-h ±track-h}
           <> {ref-dt: ^(max 0 (min ref-dt (- track-h thumb-h)))}
         ;; Update thumb-dt according to ref-y.
         {¦ mouse: (mouse left ⍊ ±ref-y ±ref-dt focus: {¦ ±y}) ±thumb-dt}
           <> {thumb-dt: ^(+ ref-dt (- y ref-y))}
         ;; Sync visual track hover with logical track hover.
         {¦ scroll-hover mouse: [mouse] node: {¦ -hover -active -track-hover_}}
           <> {track-hover: true}
         {¦ -scroll-hover node: {¦ track-hover_}}
           <> {(track-hover): ()}
         {¦ node: {¦ hover track-hover_}}
           <> {(track-hover): ()}
         ;; Scroll up. Make sure to consume the button so it is guaranteed to apply
         ;; once (since we're exhR it will apply many times otherwise).
         ;;
         ;; TODO: Un-hardcode constant.
         {¦ scroll-hover mouse: [mouse B←scroll-up] ±thumb-dt}
           <> {(B): (), thumb-dt: ^(- thumb-dt 10)}
         ;; Scroll down. Ditto about the button.
         ;;
         ;; TODO: Un-hardcode constant.
         {¦ scroll-hover mouse: [mouse B←scroll-dn] ±thumb-dt}
           <> {(B): (), thumb-dt: ^(+ thumb-dt 10)}
         ;; On click, move thumb center to goal coord. Ditto about the button.
         ;; The clamp rules take care of the nasty stuff.
         {¦ node: {¦ track-hover} ±track-goal mouse: [mouse B←left] ±thumb-dt ±thumb-h}
           <> {(B): (), thumb-dt: ^(- track-goal (/ thumb-h 2))}))

(Scroll (bar @thumb-offset_ @thumb-size_ @track-size_ @show_)
        (view @view-scroll_ @view-size_ @view-hover_ @content-size_ @view-aim_)
        (axis axis←(%any x y)))
  => (component {@:content-size @:thumb-offset @:thumb-size @:track-size @:show @:view-hover @:view-scroll @:view-size @:view-aim}
       (template
         (cell @axis ^axis))

       (comment
         "Scroll is interested in the mouse (for mouse wheel) and the keyboard. If the axis \
          is X, then we need the keyboard to detect Shift + scroll. If the axis, \
          is Y, then we need it to detect PageUp and PageDn.")
       (node @mouse (mouse))
       (node @input (input))

       (cell @ref-offset)

       (comment
         "The rewriter below works just like the one in YScrollbar. We do a capped exhR \
          for the same reason; instead of having more complex rules but less rewrite ticks, \
          have simpler rules but more rewrite ticks. It's a trade-off seen all throughout \
          Wirewright's rewrite part, including the very D7/Rack design itself.")
       (rewriter ((exhR (rulesetR exh: true) limit: 3)
                   - {@:show @:axis @:content-size @:input @:mouse @:thumb-offset
                        @:thumb-size @:track-size @:view-hover @:view-scroll
                        @:view-size @:view-aim @:ref-offset})
           ;; Detect changes to view offset: empty -> nonempty.
           {¦ ±view-aim -ref-offset_}
             <> {ref-offset: (changed 0 ^view-aim)}
           ;; Detect changes to view offset: nonempty -> nonempty.
           {¦ ±view-aim ±ref-offset}
             <> {ref-offset: (^br (= view-aim ref-offset) ^ref-offset (changed ^ref-offset ^view-aim))}
           ;; When view offset changes, recalculate thumb-offset accordingly.
           ;; This handles aims within the viewport, which now also affect
           ;; the scrollbar.
           {¦ ref-offset_: (changed ±offset ±offset') ±content-size ±view-size ±track-size ±thumb-size ±thumb-offset}
             <> {ref-offset: ^offset', thumb-offset: ^(* (/ offset' (- content-size view-size)) (- track-size thumb-size))}
           ;; Keep thumb height in sync.
           {¦ ±thumb-size ±track-size ±view-size ±content-size}
             <> {thumb-size: ^(min track-size (* track-size (finite (/ view-size content-size) or: 0)))}
           ;; Keep thumb-offset in bounds.
           {¦ ±thumb-offset ±thumb-size ±track-size show_}
             <> {thumb-offset: ^(max 0 (min thumb-offset (- track-size thumb-size))),
                 show: ^(-> (- thumb-size track-size) (abs _) (>= _ 1))}
           ;; Synchronize thumb-offset with viewport offset.
           {¦ ±view-scroll ±view-size ±content-size ±thumb-offset ±track-size ±thumb-size}
             <> {view-scroll: ^(finite or: 0 (round (* (/ thumb-offset (- track-size thumb-size)) (- content-size view-size))))}
           ;; Scroll up over viewport.
           {¦ axis: y view-hover mouse: [mouse B←scroll-up] ±thumb-offset}
             <> {(B): (), thumb-offset: ^(- thumb-offset 10)}
           ;; Scroll down over viewport.
           {¦ axis: y view-hover mouse: [mouse B←scroll-dn] ±thumb-offset}
             <> {(B): (), thumb-offset: ^(+ thumb-offset 10)}
           ;; Page up over viewport.
           {¦ axis: y input: ⟨K←(key pgup)⟩ ±thumb-offset ±thumb-size}
             <> {(K): (), thumb-offset: ^(- thumb-offset thumb-size)}
           ;; Page down over viewport.
           {¦ axis: y input: ⟨K←(key pgdn)⟩ ±thumb-offset ±thumb-size}
             <> {(K): (), thumb-offset: ^(+ thumb-offset thumb-size)}
           ;; Activate input when hovered.
           {¦ view-hover input: (input ⍊ -focus_)}
             <> {focus: always}
           ;; Deactivate input on unhover.
           {¦ -view-hover input: (input _* ⍊ focus_)}
             <> {(focus): ()}))

;; FIXME: We should use (inline _) instead of (slot _) here probably ... There's absolutely
;; no need for a slot here, nor in button and input above for that matter!
(Scroll (bar @thumb-offset_ @thumb-size_ @track-size_ @show_) (view @desc_ @node_) (axis y))
  => (component {@:desc @:node @:show @:thumb-offset @:thumb-size @:track-size}
       (part (@node @view-scroll) {¦ page-y: (±view-scroll px)})
       (part (@desc @view-size) [reflection {¦ h: ±view-size}])
       (part (@desc @view-aim) [reflection {¦ aim-y: ±view-aim}])
       (part (@desc @view-hover) [reflection {¦ hit-hover: view-hover_}])
       (part (@desc @content-size) [reflection {¦ content-h: ±content-size}])
       ($Scroll
         (bar @thumb-offset @thumb-size @track-size @show)
         (view @view-scroll @view-size @view-hover @content-size @view-aim)
         (axis y)))

(Scroll)
  => (component {}
       (group style: "flow-none"
         (reflection {@:desc, @:node}
           (viewport aim-through: true
                     aim-pan: false
                     page-x: (0 px)
                     page-y: (0 px)
             (content y: true
               (comment
                 "Scroll is meant to head an *ensemble* that consists of two nodes: \
                  the one for the scroll itself and the one for the body. This site \
                  here is basically a \"reference\" to the body.")
               (site))))
         (align x: 1
           ($YScrollbar @thumb-offset @thumb-size @track-size @show)))
       ($Scroll (bar @thumb-offset @thumb-size @track-size @show) (view @desc @node) (axis y)))

;; ---- DIRTY STUFF ENDS (sort of) ----

;; NOTE: Most of these designs are simplified versions of the corresponding
;; component in Material Design 3. Due to implementation limitations we cannot
;; (yet?) do "fancy" visual things like press animations, etc. -- nor should we,
;; perhaps. We largely ignore keyboard focus/control on mouse-driven components
;; as well (and the corresponding focus states). This isn't particularly nice
;; of course and has to be implemented at some point.

(Trigger (@msgs_ msg_ ⍊ disable⋮ false) view_)
  => (component {@:msgs, @:enabled}
       (comment
         "This cell stores this button's configuration so that we can refer to them \
          in the rewriter.")
       (template
         (cell @config {^:msg, ^:disable}))

       ;; TODO: Split into paragraphs. Current string literals sadly do not allow that :(
       ;; We should probably have semantic comments, ;;| ...
       (comment
         "The button contains a \"mirror\", which it can use to look at the *reflection* \
          of its visuals. Most importantly for us, the reflection contains information \
          about whether the button is currently hovered. Inside the reflection is a group. \
          The rewriter below sets various pairs on the group throughout the lifetime of \
          the button. For example, while you hover over the button, the `hover` pair is \
          set. The style then turns these pairs into Microfold cues. Importantly, the style \
          blocks the upward (from inside the view, out) and the downward flow of cues \
          (from the outside of the view, in) using the special `membrane` utility — completely \
          enclosing the *view* in a \"membrane\" that cues cannot permeate.")
       (reflection {desc: @mirror, node: @visuals}
         (box style: "membrane disabled:cue-disabled -disabled:cue-enabled \
                      -disabled:hover:cue-hover -disabled:active:cue-active \
                      pressed:cue-active"
           (template ^view)))

       (comment
         "The button also contains a live symbolic representation of the mouse. \
          The button maintains a continuous watch on the evolution of the mouse, \
          so when the left mouse button is pressed, the button can see and react \
          to that with respect to its current state.")
       (frag @mouse (mouse))

       (comment
         "Finally, there's this rewriter. If you expand it, you will see that it is \
          comprised of three stages. You will meet the same three stages in many other \
          UI components. The stages are: observe, reconcile (decide), and act. See also \
          the `Trigger` component.")
       (rewriter ((stageR (rulesetR exh: true)) - {@:config, @:mirror, @:mouse, @:msgs, @:visuals})
         (stage
           ;; The mouse is over our visuals. We're being hovered over!
           {¦ -hover_ mouse: [mouse] mirror: [reflection {¦ hit-hover}]}
             <> {hover: true}
           ;; The mouse had previously entered and remains within our visuals. We're
           ;; being hovered over!
           {¦ -hover_ visuals: {¦ hover} mirror: [reflection {¦ hit-hover}]}
             <> {hover: true}
           ;; The left mouse button is down over our visuals. We're active!
           {¦ -active_ hover mouse: [mouse left]}
             <> {active: true}
           ;; The left mouse button was just released while the button was active,
           ;; still over our visuals. That's a click!
           {¦ -clicked_ hover mouse: [mouse] visuals: {¦ active}}
             <> {clicked: true}
           ;; If the messages edge already contains this button's message, then
           ;; this button is currently pressed.
           {¦ config: {¦ msg_} msgs: msg_ -pressed_}
             <> {pressed: true})
         (stage
           ;; The only decision a button makes is this: place our message at
           ;; the messages edge if it's empty.
           {¦ clicked config: {¦ msg_} -msgs_ -pressed_}
             <> {msgs: ^msg, pressed: true})
         (stage
           ;; Maintain `hover` on *visuals* in sync.
           {¦ hover visuals: {¦ ⋮hover}} <> {hover: true}
           {¦ -hover visuals: {¦ hover_}} <> {(hover): ()}
           ;; Maintain `active` on *visuals* in sync. Us doing so serves a double duty,
           ;; since we also use `active` from *visuals* as a memory of our previous state.
           {¦ active visuals: {¦ ⋮active}} <> {active: true}
           {¦ -active visuals: {¦ active_}} <> {(active): ()}
           ;; Maintain `pressed` on *visuals* in sync.
           {¦ pressed visuals: {¦ ⋮pressed}} <> {pressed: true}
           {¦ -pressed visuals: {¦ pressed_}} <> {(pressed): ()}
           ;; Maintain `disabled` on *visuals* in sync.
           {¦ config: {¦ disable: true} -pressed msgs visuals: {¦ -disabled_}}
             <> {disabled: true}
           {¦ config: {¦ disable: true} -msgs visuals: {¦ disabled_}}
             <> {(disabled): ()})))

;; Reference: https://m3.material.io/components/buttons/specs, "Filled button"
(FilledButtonBox child_)
  => (box style: ^"px-4 py-2 rounded-full content-center bg-ui-accent text-ui-accent \
                   in-enabled:bg-okl-70% text-sm/5 font-medium in-enabled:text-okl-15% \
                   in-hover:cursor-pointer in-hover:bg-okl-75% in-active:bg-okl-80% \
                   in-disabled:bg-ui-decoration-low in-disabled:text-ui-supplementary"
       ^child)

(FilledButton caption_)
  => ($FilledButtonBox (p ^caption))

(FilledButton icon_ caption_)
  => ($FilledButtonBox
       (group style: "flow-row gap-2"
         (icon ^icon style: "text-lg")
         (p ^caption)))

(FilledButton header←[@_ _] rest_*)
  => ($Trigger ^header ($FilledButton ^*rest))

(IconButton icon_)
  => (box style: "rounded-full p-2 content text-ui-content in-hover:cursor-pointer \
                  in-hover:bg-ui-surface in-active:bg-ui-overlay in-disabled:text-ui-supplementary"
       (icon ^icon style: "text-lg"))

(IconButton header←[@_ _] rest_*)
  => ($Trigger ^header ($IconButton ^*rest))

;; Reference: https://m3.material.io/components/buttons/specs, "Tonal button"
(TonalButtonBox child_)
  => (box style: ^"px-4 py-2 rounded-full content-center bg-ui-overlay text-ui-content \
                   text-sm/5 font-medium in-hover:cursor-pointer in-hover:bg-okl-30% \
                   in-active:bg-okl-40% in-disabled:bg-ui-decoration-low \
                   in-disabled:text-ui-supplementary"
       ^child)

(Button caption_)
  => ($TonalButtonBox (p ^caption))

(Button icon_ caption_)
  => ($TonalButtonBox
       (group style: "flow-row gap-1"
         (icon ^icon style: "text-lg")
         (p ^caption)))

(Button header←[@_ _] rest_*)
  => ($Trigger ^header ($Button ^*rest))

;; Reference: https://m3.material.io/components/buttons/specs, "Outlined button"
(OutlinedButtonBox child_)
  => (box style: ^"px-4 py-2 rounded-full content-center border-xs border-ui-decoration-high \
                   text-ui-content text-sm/5 font-medium in-hover:cursor-pointer \
                   in-hover:bg-ui-surface in-active:bg-ui-overlay in-disabled:bg-ui-decoration-low \
                   in-disabled:text-ui-supplementary"
       ^child)

(OutlinedButton caption_)
  => ($OutlinedButtonBox (p ^caption))

(OutlinedButton icon_ caption_)
  => ($OutlinedButtonBox
       (group style: "flow-row gap-1"
         (icon ^icon style: "text-lg")
         (p ^caption)))

(OutlinedButton header←[@_ _] rest_*)
  => ($Trigger ^header ($OutlinedButton ^*rest))

;; Reference: https://m3.material.io/components/buttons/specs, "Text button"
(TextButtonBox child_)
  => (box style: ^"px-4 py-2 rounded-full content-center text-ui-accent text-sm/5 \
                   font-medium in-hover:cursor-pointer in-hover:bg-ui-surface \
                   in-active:bg-ui-overlay in-disabled:bg-ui-decoration-low \
                   in-disabled:text-ui-supplementary"
       ^child)

(TextButton caption_)
  => ($TextButtonBox (p ^caption))

(TextButton icon_ caption_)
  => ($TextButtonBox
       (group style: "flow-row gap-1"
         (icon ^icon style: "text-lg")
         (p ^caption)))

(TextButton header←[@_ _] rest_*)
  => ($Trigger ^header ($TextButton ^*rest))

;; This is an internal component used by `SegmentedButton`.
(SegmentedOption (@current_ @next_ option_) view_dict)
  => (component {@:current, @:next}
       (template (cell @option ^option))

       (comment
         "Since the view would otherwise have no access to @first and @last, because \
          the `box` would block that, we have to pass them down as cues.")
       (reflection {desc: @mirror, node: @visuals}
         (box style: "membrane -disabled:checked:cue-checked disabled:cue-disabled \
                      -disabled:cue-enabled -disabled:hover:cue-hover \
                      -disabled:active:cue-active @first:cue-first @last:cue-last"
           (template ^view)))

       (frag @mouse (mouse))

       (rewriter ((stageR (rulesetR exh: true)) - {@:current, @:mirror, @:mouse, @:next, @:option, @:visuals})
         (stage
           {¦ -hover_ mouse: [mouse] mirror: [reflection {¦ hit-hover}]}
             <> {hover: true}
           {¦ -hover_ visuals: {¦ hover} mirror: [reflection {¦ hit-hover}]}
             <> {hover: true}
           {¦ -active_ hover mouse: [mouse left]}
             <> {active: true}
           {¦ -clicked_ hover mouse: [mouse] visuals: {¦ active}}
             <> {clicked: true})
         (stage
           ;; If we're the "reigning" option and someone asks for a turnover, we submit
           ;; and do the turnover.
           {¦ option_ current_: option_ next_}
             <> {current: ^next, (next): ()}
           ;; If the user clicks on us and we're already active, just consume their
           ;; click and move on.
           {¦ clicked_ option_ current: option_}
             <> {(clicked): ()}
           ;; If the user clicks on us and we're NOT already active, we have to
           ;; ask the "reigning" option for a turnover.
           {¦ clicked_ option_ -next_}
             <> {(clicked): (), next: ^option})
         (stage
           {¦ option_ current_ visuals: {¦ ⋮checked ⋮disabled}}
             <> {checked: ^(= option current), disabled: false}
           {¦ -current visuals: {¦ ⋮checked ⋮disabled}}
             <> {checked: false, disabled: true}
           {¦ current hover visuals: {¦ ⋮hover}}
             <> {hover: true}
           {¦ current -hover visuals: {¦ hover_}}
             <> {(hover): ()}
           {¦ current active visuals: {¦ ⋮active}}
             <> {active: true}
           {¦ current -active visuals: {¦ active_}}
             <> {(active): ()})))

(SegmentedOptionView title_)
  => (box style: "clip content-center item-center-y border-l in-last:border-r border-y \
                  in-first:rounded-l-full in-last:rounded-r-full border-ui-subtle \
                  text-ui-content in-hover:bg-ui-surface in-hover:cursor-pointer \
                  in-checked:bg-ui-overlay text-sm/5 font-medium px-8 py-2 \
                  in-disabled:opacity-25% active:bg-okl-30%"
       (icon "check" style: "-dl-2 absent in-checked:present")
       (p ^title style: "in-checked:dl-2"))

;; Presents one or more *options*, of the form `(label_string id_)`, as a segmented
;; button, allowing only one choice.
;;
;; Reference: https://m3.material.io/components/segmented-buttons/specs
(SegmentedButton @state_ options_+)
  => (component {@:state}
       (cell @next)
       (group style: "flow-row item-fr-1"
         (template
           (^each (options as (label_string id_))
             ($SegmentedOption (@state @next ^id)
               ($SegmentedOptionView ^label))))))

(Toggle (%any° @state_ (@state_ @states_)) view_)
  => (component {@:state, @:states}
       (comment
         "The toggle must be able to look at its own visual rendition to see \
          whether it's hovered and so on. It must also be able to set pairs \
          on the box to communicate with the visuals, through cues.")
       (reflection {desc: @mirror, node: @visuals}
         (box style: "membrane -disabled:checked:cue-checked disabled:cue-disabled \
                      -disabled:hover:cue-hover -disabled:active:cue-active"
           (template ^view)))

       (comment
         "The toggle also wants to track the mouse, to check which mouse buttons \
          are pressed when it needs to.")
       (frag @mouse (mouse))

       (comment
         "This rewriter is the tiny \"brain\" of the toggle. Just like some of the other \
          components, it consists of three stages: observe, reconcile (decide), and act.")
       (rewriter ((stageR (rulesetR exh: true)) - {@:mirror, @:mouse, @:visuals, @:state, @:states})
         (stage
           ;; The mouse is over our visuals. We're being hovered over!
           {¦ -hover_ mouse: [mouse] mirror: [reflection {¦ hit-hover}]}
             <> {hover: true}
           ;; The mouse had previously entered and remains within our visuals. We're
           ;; being hovered over!
           {¦ -hover_ visuals: {¦ hover} mirror: [reflection {¦ hit-hover}]}
             <> {hover: true}
           ;; The left mouse button is down over our visuals. We're active!
           {¦ -active_ hover mouse: [mouse left]}
             <> {active: true}
           ;; The left mouse button was just released while the button was active,
           ;; still over our visuals. That's a click!
           {¦ -clicked_ hover mouse: [mouse] visuals: {¦ active}}
             <> {clicked: true})
         (stage
           ;; "Decide" to toggle state when clicked.
           {¦ clicked state_boolean -states_}
             <> {state: ^(not state), states: ^(not state)})
         (stage
           ;; Maintain `checked` on *visuals* in sync.
           {¦ state_boolean visuals: {¦ ⋮checked}}
             <> {checked: ^state}
           ;; Maintain `hover` on *visuals* in sync.
           {¦ hover visuals: {¦ ⋮hover}}
             <> {hover: true}
           {¦ -hover visuals: {¦ hover_}}
             <> {(hover): ()}
           ;; Maintain `active` on *visuals* in sync. Us doing so serves a double duty,
           ;; since we also use `active` from *visuals* as a memory of our previous state.
           {¦ active visuals: {¦ ⋮active}}
             <> {active: true}
           {¦ -active visuals: {¦ active_}}
             <> {(active): ()}
           ;; Maintain `disabled` on *visuals* in sync.
           {¦ -state visuals: {¦ -disabled_}}
             <> {disabled: true}
           {¦ state visuals: {¦ disabled_}}
             <> {(disabled): ()})))

(Checkbox)
  => (box style: "content in-hover:cursor-pointer in-disabled:opacity-25% in-disabled:in-hover:cursor-arrow"
       ;; The circle thing around the checkbox on hover.
       (box style: "bg-ui-subtle in-hover:bg-ui-checked scale-5/3 pivot-center \
                    rounded-full transparent in-hover:opacity-25% in-active:bg-okl-95%")
       ;; The check and the box.
       (box style: "rounded-xs border-sm border-ui-subtle text-sm text-ui-content \
                    in-checked:bg-ui-decoration-high in-checked:border-ui-checked \
                    in-checked:bg-ui-checked text-ui-checked text-okl-10%"
         (icon "check" style: "transparent in-checked:opaque")))

(Checkbox @state_)
  => ($Toggle ^state ($Checkbox))

(Switch)
  => (group style: "content flow-row border-sm border-ui-subtle bg-ui-surface rounded-full \
                    in-checked:border-ui-accent in-checked:bg-ui-accent in-hover:cursor-pointer \
                    in-disabled:opacity-25%"
       ;; The unchecked half.
       (box style: "opaque in-checked:transparent in-disabled:transparent content p-1"
         (box style: "rounded-full bg-min-4 bg-ui-subtle")
         ;; The circle thing for hovering when disabled.
         (box style: "bg-ui-subtle scale-5/2 pivot-center rounded-full transparent \
                      in-hover:opacity-20% in-checked:transparent"))
       ;; The middle part to indicate the disabled state.
       (box style: "floating absent -dl-3 in-disabled:present content p-1"
         (box style: "rounded-full bg-min-4 bg-ui-subtle"))
       ;; The checked half.
       (box style: "transparent in-checked:opaque content p-1 bg-ui-accent bg-okl-20% \
                    text-ui-accent rounded-full"
         (icon "check")
         ;; The circle thing for hovering when checked.
         (box style: "bg-ui-accent bg-okl-30% scale-5/2 pivot-center rounded-full \
                      transparent in-checked:in-hover:opacity-20%")))

(Switch @state_)
  => ($Toggle ^state ($Switch))

(Setting title_)
  => (group style: "flow-row item-center-y content-y px-3 py-3"
       (p ^title style: "fr-1 text-ui-content text-base/6")
       (box style: "center-y"
         ($Switch)))

(Setting title_ subtitle_)
  => (group style: "flow-row content-y px-3 py-1"
       (group style: "flow-col fr-1"
         (p ^title style: "text-ui-content text-base/6")
         (p ^subtitle style: "text-ui-supplementary text-sm/5"))
       (box style: "center-y"
         ($Switch)))

(Setting title_ subtitle0_ subtitle1_)
  => (group style: "flow-row content-y px-3 py-1"
       (group style: "flow-col fr-1"
         (p ^title style: "text-ui-content text-base/6")
         (p ^subtitle0 style: "present in-checked:absent text-ui-supplementary text-sm/5")
         (p ^subtitle1 style: "absent in-checked:present text-ui-supplementary text-sm/5"))
       (box style: "center-y"
         ($Switch)))
