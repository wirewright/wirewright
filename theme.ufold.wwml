--- flow

prune:
  {+ µ-membrane
     µ-cues
     µ-cues-up
     µ-cues-dn}

;; Cache membrane presence under key `µ-membrane`.
{¦ -µ-membrane: M µ-⟦style,preset⟧: ⟨membrane⟩} <> {M: true}

;; Move upward/downward cues from style to cues which acts like
;; an upward/downward slope.
{¦ µ-cues: (%optional () (_* `T)) µ-⟦style,preset⟧: ⟨C←(cue-⸨up,dn⸩ id_)⟩}
  <> {T: (⸨up,dn⸩-out ^id), (C): ()}

;; Send up-out to parent.
⟨{¦ µ-cues: (C←[up-out id_] _*)} ⍊ µ-cues: (%optional () (_* `T))⟩
  <> {T: (up-in ^id), (C): ()}

;; Broadcast dn-out to all children.
⟨{¦ µ-cues: (%optional () (_* `T))} ⍊ µ-cues: ((dn-out c_ ⍊ -◇_) _*)⟩°
  <> {T: (dn-in ^c), ◇: true}

;; If child doesn't know what else to do with the cue, remove it.
⟨{¦ µ-cues: (C_ _*)}⟩° <> {(C): ()}

;; Keep track of cues received from above and below.
{¦ µ-cues: ([⸨up,dn⸩-in id_] _*) µ-cues-⸨up,dn⸩: (%optional () (%-value id received))}
  <> {received: true}

;; If we've received a cue that a condition depends on, resolve that condition.
;; This may in turn free other cues and so on.
{¦ µ-cues-⸨up,dn⸩: (%value cue _), µ-⟦style,preset⟧: ⟨U←(on-cue-⸨up,dn⸩ cue_ u_)⟩}
  <> {U: ^u}

;; Convert up/dn-in (cue received) to up/dn-out (cue outbound) unless we're
;; a membrane. Membranes block downward flow from above, and upward
;; flow from below.
⟨{¦ -µ-membrane µ-cues: [C←[⸨up,dn⸩-in id_] _*]}⟩
  <> {C: (⸨up,dn⸩-out ^id)}

--- boxes

;; Only utilities targeting text-box participate in the cascade. Text-box is the only
;; box that appears to have this as expected behavior. In:
;;
;;    (group style: "text-red-500"
;;      (p "Line 1")
;;      (p "Line 2")
;;      (p "Line 3"))
;;
;; One would expect each of the lines to assume `text-red-500` (even if obstructed
;; by non-µfold-administered nodes -- arguably).
cascade: {+ text-box}

;; This is the box hierarchy of µfold. Here we list boxes from lowest-rank
;; (innermost/bottommost in the tree) to highest-rank (outermost/uppermost
;; in the tree).
hierarchy:
  (text-box
   flow-box
   content-viewport-box
   content-align-box
   padding-box
   back-box
   margin-box
   sized-box
   percents-box
   limit-box
   align-box
   viewport-box
   content-box
   floating-box
   composite-box
   outermost-box)

;; These rules define how
;;
;;    (box_ node_ ¦ styles-that-target-box_)
;;
;; ... should be transformed into the corresponding (Dw)UIR.
;;
;; Note how we "bubble up" the client's *head* and *attrs* in all of these rules.
;; This "bubbling up" avoids (or rather, divides evenly) the conceptual complexity
;; of having to merge them with the outermost box later on. Instead, we simply keep
;; the client node intact. This continues the general line of keeping the client's
;; nodes and annotations intact; allowing the client to e.g. tag their nodes and observe
;; how they evolve through µfold -> UIR -> DwUIR, perhaps for feedback.
;;
;; These rules are *always* run only on nodes that explicitly opt into µfold;
;; that is, nodes with a style property, or ones with a default style defined in
;; `presets`. All other nodes µfold passes through unchanged.

(text-box caption_string ¦ styles_)
  => (text caption: ^caption ^… styles)

[flow-box node_]
  => ^node

(flow-box (head_ (%plural children min: 2) ¦ attrs_) ¦ styles_ node_: (%any x-wrap y-wrap))
  => (^head (^node nodes: ^children ^… styles) ^… attrs)

(flow-box (head_ (%plural children min: 2) ¦ attrs_) ¦ styles_ node⋮ x-stack)
  => (^head (^node ^*children ^… styles) ^… attrs)

;; If we're being asked to create a back-box for a leaf node, just do
;; the rect; we don't need the wrapping z-stack.
;;
;; I'm not sure this is the right thing to do, but everything else I've
;; tried doesn't feel right either.
;;
;; Here, we're changing `head`'s arity which might make it harder to
;; pattern match if one expects the arity to remain unchanged. Same for
;; flow-box, however.
;;
;; The opposite behavior (putting head inside z-stack) feels wrong, too -- it
;; doesn't play well with all other boxes' bubbling the head up.
;;
;; Inverting here would mean the head is going to be at the bottom edge of the tree.
;; This would make manipulation of µfold-generated nodes difficult -- since
;; the boundary between outer (Dw)UIR and µfold-generated one for a node is then
;; rather fuzzy.
(back-box (head_ ¦ attrs_) ¦ styles_)
  => (^head (rect ^… styles) ^… attrs)

(back-box (head_ child_ ¦ attrs_) ¦ styles_)
  => (^head
        (z-stack z-index: local
          (rect z-index: -1 ^… styles)
          (^match styles
            (when (%keytest thickness-l thickness-r thickness-t thickness-b)
              ;; If we have some thickness set up, create a padding node around
              ;; the child for insets.
              (^match' (styles {¦ thickness-l⋮ 0 thickness-r⋮ 0 thickness-t⋮ 0 thickness-b⋮ 0})
                (padding pl: (^if (> thickness-l 0) ^thickness-l)
                         pr: (^if (> thickness-r 0) ^thickness-r)
                         pt: (^if (> thickness-t 0) ^thickness-t)
                         pb: (^if (> thickness-b 0) ^thickness-b)
                         inset: true
                  ^child)))
            (when _ ^child)))
      ^… attrs)

(margin-box (head_ child_ ¦ attrs_) ¦ styles_ ml⋮ 0 mr⋮ 0 mt⋮ 0 mb⋮ 0)
  => (^head (padding ^child pl: ^ml pr: ^mr pt: ^mt pb: ^mb ^… styles) ^… attrs)

(⸨content-viewport,content-align,padding,sized,percents,limit,align,viewport,content,floating,composite⸩-box (head_ child_ ¦ attrs_) ¦ styles_ presence: (%optional true true))
  => (^head (⸨viewport,align,padding,sized,percents,limit,align,viewport,content,floating,composite⸩ ^child ^… styles) ^… attrs)

;; `outermost-box` is a virtual box that styles like `z` or `fr` target.
(outermost-box node←(head_ children_* ¦ attrs_) ¦ styles_)
  => (^match (intersects? attrs styles)
       ;; If the *real* outermost box doesn't conflict with styles targeting
       ;; outermost-box, just add them to the real outermost box.
       (when false ^(union node styles))
       ;; Otherwise, craft a box specifically for outermost-box styles.
       (when true (^head (box ^*children ^… styles) ^… attrs)))

