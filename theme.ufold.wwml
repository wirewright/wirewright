--- globals

;; This section contains style variables that you can tweak.

;; The spacing factor.
;;
;; Reference: https://v3.tailwindcss.com/docs/customizing-spacing#default-spacing-scale
spacing: (* 0.25 (global rem))

;; Negative unit shorthands.
-rem: (* -1 (global rem))
-spacing: (* -1 (global spacing))

;; Default corner radius values
radius-xs: (* 0.125 (global rem))
radius-sm: (* 0.25 (global rem))
radius-md: (* 0.375 (global rem))
radius-lg: (* 0.5 (global rem))
radius-xl: (* 0.75 (global rem))
radius-2xl: (* 1 (global rem))
radius-3xl: (* 1.5 (global rem))
radius-4xl: (* 2 (global rem))

;; Stock fonts
font-mono: "Julia Mono"
font-sans: "IBM Plex Sans"
font-serif: "IBM Plex Serif"
font-icons: "Material Icons Outlined"
font-condensed: "IBM Plex Sans Condensed"

;; Default font size values
font-xs: (* 0.75 (global rem))
font-sm: (* 0.875 (global rem))
font-base: (* 1 (global rem))
font-lg: (* 1.125 (global rem))
font-xl: (* 1.25 (global rem))
font-2xl: (* 1.5 (global rem))
font-3xl: (* 1.875 (global rem))
font-4xl: (* 2.25 (global rem))
font-5xl: (* 3 (global rem))
font-6xl: (* 3.75 (global rem))
font-7xl: (* 4.5 (global rem))
font-8xl: (* 6 (global rem))
font-9xl: (* 8 (global rem))

;; Used in utilities like `min-w` or `max-w`.
limit-3xs: (* 16 (global rem))
limit-2xs: (* 18 (global rem))
limit-xs: (* 20 (global rem))
limit-sm: (* 24 (global rem))
limit-md: (* 28 (global rem))
limit-lg: (* 32 (global rem))
limit-xl: (* 36 (global rem))
limit-2xl: (* 42 (global rem))
limit-3xl: (* 48 (global rem))
limit-4xl: (* 56 (global rem))
limit-5xl: (* 64 (global rem))
limit-6xl: (* 72 (global rem))
limit-7xl: (* 80 (global rem))


--- presets

;; This section contains nodes for which some default styles exist, i.e.,
;; you don't have to write style: "..." for them to be seen by µfold -- µfold
;; will see them anyway.

h1: "font-sans font-bold text-4xl text-neutral-500 wrap"
h2: "font-sans font-semibold text-3xl text-neutral-500 wrap"
h3: "font-sans font-medium text-2xl text-neutral-500 wrap"
h4: "font-sans font-medium text-xl text-neutral-500 wrap"
h5: "font-sans font-medium text-lg text-neutral-500 wrap"
h6: "font-sans font-semibold text-xs text-neutral-500 upcase wrap"
p: "font-sans font-text font-base text-neutral-500 wrap"
icon: "font-icons font-normal icon-fallback-sans icon-fallback-square font-base leading-none text-neutral-500"
group: "flow-row"
code: "font-mono font-normal text-xs bg-neutral-900 text-neutral-300 p-1 rounded-sm"
button: "font-sans font-normal text-sm bg-neutral-700 text-neutral-200 hover:bg-blue-700 hover:text-white p-3 rounded-sm content-center content-clip"

--- utilities

;; Padding utilities.
;;
;; Reference: https://tailwindcss.com/docs/padding

"p": (short-for "px" "py")
"px": (short-for "pl" "pr")
"py": (short-for "pt" "pb")
"pl": (padding-box real {pl: $(* (local arg) (global spacing))})
"pr": (padding-box real {pr: $(* (local arg) (global spacing))})
"pt": (padding-box real {pt: $(* (local arg) (global spacing))})
"pb": (padding-box real {pb: $(* (local arg) (global spacing))})

"p-px": (short-for "px-px" "py-px")
"px-px": (short-for "pl-px" "pr-px")
"py-px": (short-for "pt-px" "pb-px")
"pl-px": (padding-box {pl: 1})
"pr-px": (padding-box {pr: 1})
"pt-px": (padding-box {pt: 1})
"pb-px": (padding-box {pb: 1})

;; Margin utilities.
;;
;; Reference: https://tailwindcss.com/docs/margin

"m": (short-for "mx" "my")
"mx": (short-for "ml" "mr")
"my": (short-for "mt" "mb")
"ml": (margin-box real {ml: $(* (local arg) (global spacing))})
"mr": (margin-box real {mr: $(* (local arg) (global spacing))})
"mt": (margin-box real {mt: $(* (local arg) (global spacing))})
"mb": (margin-box real {mb: $(* (local arg) (global spacing))})

"m-px": (short-for "mx-px" "my-px")
"mx-px": (short-for "ml-px" "mr-px")
"my-px": (short-for "mt-px" "mb-px")
"ml-px": (margin-box {ml: 1})
"mr-px": (margin-box {mr: 1})
"mt-px": (margin-box {mt: 1})
"mb-px": (margin-box {mb: 1})

"-m": (short-for "-mx" "-my")
"-mx": (short-for "-ml" "-mr")
"-my": (short-for "-mt" "-mb")
"-ml": (margin-box real {ml: $(* (local arg) (global -spacing))})
"-mr": (margin-box real {mr: $(* (local arg) (global -spacing))})
"-mt": (margin-box real {mt: $(* (local arg) (global -spacing))})
"-mb": (margin-box real {mb: $(* (local arg) (global -spacing))})

"-m-px": (short-for "-mx-px" "-my-px")
"-mx-px": (short-for "-ml-px" "-mr-px")
"-my-px": (short-for "-mt-px" "-mb-px")
"-ml-px": (margin-box {ml: -1})
"-mr-px": (margin-box {mr: -1})
"-mt-px": (margin-box {mt: -1})
"-mb-px": (margin-box {mb: -1})

;; Border radius utilities.
;;
;; Reference: https://tailwindcss.com/docs/border-radius

"rounded": (short-for "rounded-md")
"rounded-none": (short-for "rounded-t-none" "rounded-b-none")
"rounded-full": (short-for "rounded-t-full" "rounded-b-full")
"rounded-xs": (short-for "rounded-t-xs" "rounded-b-xs")
"rounded-sm": (short-for "rounded-t-sm" "rounded-b-sm")
"rounded-md": (short-for "rounded-t-md" "rounded-b-md")
"rounded-lg": (short-for "rounded-t-lg" "rounded-b-lg")
"rounded-xl": (short-for "rounded-t-xl" "rounded-b-xl")
"rounded-2xl": (short-for "rounded-t-2xl" "rounded-b-2xl")
"rounded-3xl": (short-for "rounded-t-3xl" "rounded-b-3xl")
"rounded-4xl": (short-for "rounded-t-4xl" "rounded-b-4xl")

"rounded-t": (short-for "rounded-t-md")
"rounded-t-none": (short-for "rounded-tl-none" "rounded-tr-none")
"rounded-t-full": (short-for "rounded-tl-full" "rounded-tr-full")
"rounded-t-xs": (short-for "rounded-tl-xs" "rounded-tr-xs")
"rounded-t-sm": (short-for "rounded-tl-sm" "rounded-tr-sm")
"rounded-t-md": (short-for "rounded-tl-md" "rounded-tr-md")
"rounded-t-lg": (short-for "rounded-tl-lg" "rounded-tr-lg")
"rounded-t-xl": (short-for "rounded-tl-xl" "rounded-tr-xl")
"rounded-t-2xl": (short-for "rounded-tl-2xl" "rounded-tr-2xl")
"rounded-t-3xl": (short-for "rounded-tl-3xl" "rounded-tr-3xl")
"rounded-t-4xl": (short-for "rounded-tl-4xl" "rounded-tr-4xl")

"rounded-b": (short-for "rounded-b-md")
"rounded-b-none": (short-for "rounded-bl-none" "rounded-br-none")
"rounded-b-full": (short-for "rounded-bl-full" "rounded-br-full")
"rounded-b-xs": (short-for "rounded-bl-xs" "rounded-br-xs")
"rounded-b-sm": (short-for "rounded-bl-sm" "rounded-br-sm")
"rounded-b-md": (short-for "rounded-bl-md" "rounded-br-md")
"rounded-b-lg": (short-for "rounded-bl-lg" "rounded-br-lg")
"rounded-b-xl": (short-for "rounded-bl-xl" "rounded-br-xl")
"rounded-b-2xl": (short-for "rounded-bl-2xl" "rounded-br-2xl")
"rounded-b-3xl": (short-for "rounded-bl-3xl" "rounded-br-3xl")
"rounded-b-4xl": (short-for "rounded-bl-4xl" "rounded-br-4xl")

"rounded-l": (short-for "rounded-l-md")
"rounded-l-none": (short-for "rounded-tl-none" "rounded-bl-none")
"rounded-l-full": (short-for "rounded-tl-full" "rounded-bl-full")
"rounded-l-xs": (short-for "rounded-tl-xs" "rounded-bl-xs")
"rounded-l-sm": (short-for "rounded-tl-sm" "rounded-bl-sm")
"rounded-l-md": (short-for "rounded-tl-md" "rounded-bl-md")
"rounded-l-lg": (short-for "rounded-tl-lg" "rounded-bl-lg")
"rounded-l-xl": (short-for "rounded-tl-xl" "rounded-bl-xl")
"rounded-l-2xl": (short-for "rounded-tl-2xl" "rounded-bl-2xl")
"rounded-l-3xl": (short-for "rounded-tl-3xl" "rounded-bl-3xl")
"rounded-l-4xl": (short-for "rounded-tl-4xl" "rounded-bl-4xl")

"rounded-r": (short-for "rounded-r-md")
"rounded-r-none": (short-for "rounded-tr-none" "rounded-br-none")
"rounded-r-full": (short-for "rounded-tr-full" "rounded-br-full")
"rounded-r-xs": (short-for "rounded-tr-xs" "rounded-br-xs")
"rounded-r-sm": (short-for "rounded-tr-sm" "rounded-br-sm")
"rounded-r-md": (short-for "rounded-tr-md" "rounded-br-md")
"rounded-r-lg": (short-for "rounded-tr-lg" "rounded-br-lg")
"rounded-r-xl": (short-for "rounded-tr-xl" "rounded-br-xl")
"rounded-r-2xl": (short-for "rounded-tr-2xl" "rounded-br-2xl")
"rounded-r-3xl": (short-for "rounded-tr-3xl" "rounded-br-3xl")
"rounded-r-4xl": (short-for "rounded-tr-4xl" "rounded-br-4xl")

"rounded-tl": (short-for "rounded-tl-md")
"rounded-tl-none": (back-box {radius-tl: 0})
"rounded-tl-full": (back-box {radius-tl: (* 1)})
"rounded-tl-xs": (back-box {radius-tl: $(global radius-xs)})
"rounded-tl-sm": (back-box {radius-tl: $(global radius-sm)})
"rounded-tl-md": (back-box {radius-tl: $(global radius-md)})
"rounded-tl-lg": (back-box {radius-tl: $(global radius-lg)})
"rounded-tl-xl": (back-box {radius-tl: $(global radius-xl)})
"rounded-tl-2xl": (back-box {radius-tl: $(global radius-2xl)})
"rounded-tl-3xl": (back-box {radius-tl: $(global radius-3xl)})
"rounded-tl-4xl": (back-box {radius-tl: $(global radius-4xl)})

"rounded-tr": (short-for "rounded-tr-md")
"rounded-tr-none": (back-box {radius-tr: 0})
"rounded-tr-full": (back-box {radius-tr: (* 1)})
"rounded-tr-xs": (back-box {radius-tr: $(global radius-xs)})
"rounded-tr-sm": (back-box {radius-tr: $(global radius-sm)})
"rounded-tr-md": (back-box {radius-tr: $(global radius-md)})
"rounded-tr-lg": (back-box {radius-tr: $(global radius-lg)})
"rounded-tr-xl": (back-box {radius-tr: $(global radius-xl)})
"rounded-tr-2xl": (back-box {radius-tr: $(global radius-2xl)})
"rounded-tr-3xl": (back-box {radius-tr: $(global radius-3xl)})
"rounded-tr-4xl": (back-box {radius-tr: $(global radius-4xl)})

"rounded-bl": (short-for "rounded-bl-md")
"rounded-bl-none": (back-box {radius-bl: 0})
"rounded-bl-full": (back-box {radius-bl: (* 1)})
"rounded-bl-xs": (back-box {radius-bl: $(global radius-xs)})
"rounded-bl-sm": (back-box {radius-bl: $(global radius-sm)})
"rounded-bl-md": (back-box {radius-bl: $(global radius-md)})
"rounded-bl-lg": (back-box {radius-bl: $(global radius-lg)})
"rounded-bl-xl": (back-box {radius-bl: $(global radius-xl)})
"rounded-bl-2xl": (back-box {radius-bl: $(global radius-2xl)})
"rounded-bl-3xl": (back-box {radius-bl: $(global radius-3xl)})
"rounded-bl-4xl": (back-box {radius-bl: $(global radius-4xl)})

"rounded-br": (short-for "rounded-br-md")
"rounded-br-none": (back-box {radius-br: 0})
"rounded-br-full": (back-box {radius-br: (* 1)})
"rounded-br-xs": (back-box {radius-br: $(global radius-xs)})
"rounded-br-sm": (back-box {radius-br: $(global radius-sm)})
"rounded-br-md": (back-box {radius-br: $(global radius-md)})
"rounded-br-lg": (back-box {radius-br: $(global radius-lg)})
"rounded-br-xl": (back-box {radius-br: $(global radius-xl)})
"rounded-br-2xl": (back-box {radius-br: $(global radius-2xl)})
"rounded-br-3xl": (back-box {radius-br: $(global radius-3xl)})
"rounded-br-4xl": (back-box {radius-br: $(global radius-4xl)})

;; Letter spacing utilities.
;;
;; NOTE: our semantics differs slightly in that we measure tracking in terms
;; of whitespace character width (whereas Tailwind measures it in `em`s).
;;
;; Reference: https://tailwindcss.com/docs/letter-spacing

"tracking-tighter": (text-box {tracking: -0.05})
"tracking-tight": (text-box {tracking: -0.025})
"tracking-normal": (text-box {tracking: 0})
"tracking-wide": (text-box {tracking: 0.025})
"tracking-wider": (text-box {tracking: 0.05})
"tracking-widest": (text-box {tracking: 0.1})

;; Line height utilities.
;;
;; Tailwind appears to have changed the way their leading utility works (I haven't
;; used Tailwind for a while). We support both relative named (v3) and absolute
;; spacing-scale leading, but not compound `text-_/_`
;;
;; Reference: https://tailwindcss.com/docs/line-height

;; DwUIR says leading is relative by default so we force absolute (pixels)
;; treatment through `=`.
"leading": (text-box real {leading: (= $(* (local arg) (global spacing)))})

"leading-none": (text-box {leading: 1})
"leading-tight": (text-box {leading: 1.25})
"leading-snug": (text-box {leading: 1.375})
"leading-normal": (text-box {leading: 1.5})
"leading-relaxed": (text-box {leading: 1.625})
"leading-loose": (text-box {leading: 2})

"leading-xs": (text-box {leading: 4/3})
"leading-sm": (text-box {leading: 10/7})
"leading-base": (text-box {leading: 3/2})
"leading-lg": (text-box {leading: 14/9})
"leading-xl": (text-box {leading: 7/5})
"leading-2xl": (text-box {leading: 7/6})
"leading-3xl": (text-box {leading: 225/187})
"leading-4xl": (text-box {leading: 25/22})
"leading-5xl": (text-box {leading: 1})
"leading-6xl": (text-box {leading: 1})
"leading-7xl": (text-box {leading: 1})
"leading-8xl": (text-box {leading: 1})
"leading-9xl": (text-box {leading: 1})

;;
;; Font family utilities.
;;

"font-icons": (text-box {font: $(global font-icons)})
"font-condensed": (text-box {font: $(global font-condensed)})
"font-sans": (text-box {font: $(global font-sans)})
"font-serif": (text-box {font: $(global font-serif)})
"font-mono": (text-box {font: $(global font-mono)})

;;
;; Icon utilities (for internal use only).
;;

"icon-fallback-sans": (text-box {icon-font-fallback: $(global font-sans)})
"icon-fallback-square": (text-box {icon-fallback: "▨"})

;; Font size utilities.
;;
;; Reference: https://tailwindcss.com/docs/font-size
;;
;; NOTE: Tailwind forces line height on text sizes such as `text-lg`. We do
;; not. Instead, we provide two utilities: `text-*` and `font-*`. Something
;; like `font-lg` **won't** set the leading. Something like `text-lg`
;; will; it is a shorthand for `font-lg leading-lg`.

;; So that one can do e.g. `font-1`, `font-0.5` etc.
"font": (text-box real {size: $(* (local arg) (global rem))})

;; So that one can do e.g. `font-px-12`
"font-px": (text-box real {size: $(local arg)})

"font-xs": (text-box {size: $(global font-xs)})
"font-sm": (text-box {size: $(global font-sm)})
"font-base": (text-box {size: $(global font-base)})
"font-lg": (text-box {size: $(global font-lg)})
"font-xl": (text-box {size: $(global font-xl)})
"font-2xl": (text-box {size: $(global font-2xl)})
"font-3xl": (text-box {size: $(global font-3xl)})
"font-4xl": (text-box {size: $(global font-4xl)})
"font-5xl": (text-box {size: $(global font-5xl)})
"font-6xl": (text-box {size: $(global font-6xl)})
"font-7xl": (text-box {size: $(global font-7xl)})
"font-8xl": (text-box {size: $(global font-8xl)})
"font-9xl": (text-box {size: $(global font-9xl)})

"text-xs": (short-for "font-xs" "leading-xs")
"text-sm": (short-for "font-sm" "leading-sm")
"text-base": (short-for "font-base" "leading-base")
"text-lg": (short-for "font-lg" "leading-lg")
"text-xl": (short-for "font-xl" "leading-xl")
"text-2xl": (short-for "font-2xl" "leading-2xl")
"text-3xl": (short-for "font-3xl" "leading-3xl")
"text-4xl": (short-for "font-4xl" "leading-4xl")
"text-5xl": (short-for "font-5xl" "leading-5xl")
"text-6xl": (short-for "font-6xl" "leading-6xl")
"text-7xl": (short-for "font-7xl" "leading-7xl")
"text-8xl": (short-for "font-8xl" "leading-8xl")
"text-9xl": (short-for "font-9xl" "leading-9xl")

;; Font weight utilities.
;;
;; Reference: https://tailwindcss.com/docs/font-weight

"font-thin": (text-box {weight: 100})
"font-extralight": (text-box {weight: 200})
"font-light": (text-box {weight: 300})
"font-normal": (text-box {weight: 400})
"font-text": (text-box {weight: 450})
"font-medium": (text-box {weight: 500})
"font-semibold": (text-box {weight: 600})
"font-bold": (text-box {weight: 700})
"font-extrabold": (text-box {weight: 800})
"font-black": (text-box {weight: 900})

;; Italicizing text.
;;
;; Reference: https://tailwindcss.com/docs/font-style

"italic": (text-box {italic: true})
"non-italic": (text-box {italic: false})

;; Underline.
;;
;; This has no direct analog in Tailwind because we're much cruder than
;; web browsers. Browsers have the much more sophisticated
;; text-decoration -- we don't.

;; As in `underline-1 underline-blue-500`. You can then do e.g. `hover:underline-none`.
"underline":
  (try
    (short-for "underline-thickness")
    (short-for "underline-color")
    (text-box {underline: true}))

"underline-none": (text-box {underline: false})

"underline-offset": (text-box real {underline-offset: $(local arg)})
"underline-thickness": (text-box real {underline-thickness: $(local arg)})
"underline-color": (text-box (one-of colors) {underline-color: $(local arg)})

;;
;; Selection.
;;

;; As in `selection` or `selection-blue-500`.
"selection":
  (try
    (short-for "selection-color")
    (text-box {selection: true}))

"selection-none": (text-box {selection: false})

"selection-color": (text-box (one-of colors) {selection-fill: $(local arg)})

"selection-text": (text-box (one-of colors) {selection-color: $(local arg)})
"selection-extent": (text-box real {selection-extent: $(* (local arg) percents)})

"selection-radius-xs": (text-box {selection-radius: $(* 0.1 (global spacing))})
"selection-radius-sm": (text-box {selection-radius: $(* 0.2 (global spacing))})
"selection-radius-md": (text-box {selection-radius: $(* 0.3 (global spacing))})
"selection-radius-lg": (text-box {selection-radius: $(* 0.5 (global spacing))})
"selection-radius-xl": (text-box {selection-radius: $(* 0.7 (global spacing))})
"selection-radius-2xl": (text-box {selection-radius: $(* 0.8 (global spacing))})
"selection-radius-3xl": (text-box {selection-radius: $(* 1 (global spacing))})

;;
;; Text wrap utilities.
;;

"wrap": (text-box {wrap: true})
"no-wrap": (text-box {wrap: false})

"word-wrap": (text-box {wrap-on-words: true})
"no-word-wrap": (text-box {wrap-on-words: false})

"letter-wrap": (text-box {wrap-on-letters: true})
"no-letter-wrap": (text-box {wrap-on-letters: false})

;;
;; Text transform utilities.
;;

"upcase": (text-box {transform: {+ upcase}})
"dncase": (text-box {transform: {+ dncase}})
"capitalize": (text-box {transform: {+ capitalize}})
"strip": (text-box {transform: {+ strip}})
"pretty": (text-box {transform: {+ pretty}})

;; Text color utilities.
;;
;; Reference: https://tailwindcss.com/docs/color

"text": (short-for "text-color")
"text-none": (short-for "text-color-none")

"text-color": (text-box (one-of colors) {color: $(local arg)})
"text-color-none": (text-box {} unset: {+ color})

"color": (outermost-box (one-of colors) {color: $(local arg)})

;; Background utilities.
;;
;; Reference: https://tailwindcss.com/docs/background-color

"bg": (back-box (one-of colors) {fill: $(local arg)})
"bg-none": (back-box {} unset: {+ fill})

;;
;; Border thickness utilities.
;;

"border":
  (try
    (short-for "border-color")
    (short-for "border-l" "border-r" "border-t" "border-b"))

"border-color": (back-box (one-of colors) {stroke: $(local arg)})

"border-x": (short-for "border-l" "border-r")
"border-y": (short-for "border-t" "border-b")

"border-l":
  (try
    (back-box real {thickness-l: $(local arg)})
    (back-box {thickness-l: 1}))

"border-r":
  (try
    (back-box real {thickness-r: $(local arg)})
    (back-box {thickness-r: 1}))

"border-t":
  (try
    (back-box real {thickness-t: $(local arg)})
    (back-box {thickness-t: 1}))

"border-b":
  (try
    (back-box real {thickness-b: $(local arg)})
    (back-box {thickness-b: 1}))

;; These border utilities are compatible with both TUI and GUI. TUI supports 8 border
;; modes (0-7). On the GUI side, we're using pixels. Notably, all these values make
;; sense as well.

"border-none": (short-for "border-x-none" "border-y-none")
"border-xs": (short-for "border-x-xs" "border-y-xs")
"border-sm": (short-for "border-x-sm" "border-y-sm")
"border-md": (short-for "border-x-md" "border-y-md")
"border-lg": (short-for "border-x-lg" "border-y-lg")
"border-xl": (short-for "border-x-xl" "border-y-xl")
"border-2xl": (short-for "border-x-2xl" "border-y-2xl")
"border-3xl": (short-for "border-x-3xl" "border-y-3xl")

"border-x-none": (short-for "border-l-none" "border-r-none")
"border-x-xs": (short-for "border-l-xs" "border-r-xs")
"border-x-sm": (short-for "border-l-sm" "border-r-sm")
"border-x-md": (short-for "border-l-md" "border-r-md")
"border-x-lg": (short-for "border-l-lg" "border-r-lg")
"border-x-xl": (short-for "border-l-xl" "border-r-xl")
"border-x-2xl": (short-for "border-l-2xl" "border-r-2xl")
"border-x-3xl": (short-for "border-l-3xl" "border-r-3xl")

"border-y-none": (short-for "border-t-none" "border-b-none")
"border-y-xs": (short-for "border-t-xs" "border-b-xs")
"border-y-sm": (short-for "border-t-sm" "border-b-sm")
"border-y-md": (short-for "border-t-md" "border-b-md")
"border-y-lg": (short-for "border-t-lg" "border-b-lg")
"border-y-xl": (short-for "border-t-xl" "border-b-xl")
"border-y-2xl": (short-for "border-t-2xl" "border-b-2xl")
"border-y-3xl": (short-for "border-t-3xl" "border-b-3xl")

"border-l-none": (back-box {thickness-l: 0})
"border-l-xs": (back-box {thickness-l: 1})
"border-l-sm": (back-box {thickness-l: 2})
"border-l-md": (back-box {thickness-l: 3})
"border-l-lg": (back-box {thickness-l: 4})
"border-l-xl": (back-box {thickness-l: 5})
"border-l-2xl": (back-box {thickness-l: 6})
"border-l-3xl": (back-box {thickness-l: 7})

"border-t-none": (back-box {thickness-t: 0})
"border-t-xs": (back-box {thickness-t: 1})
"border-t-sm": (back-box {thickness-t: 2})
"border-t-md": (back-box {thickness-t: 3})
"border-t-lg": (back-box {thickness-t: 4})
"border-t-xl": (back-box {thickness-t: 5})
"border-t-2xl": (back-box {thickness-t: 6})
"border-t-3xl": (back-box {thickness-t: 7})

"border-r-none": (back-box {thickness-r: 0})
"border-r-xs": (back-box {thickness-r: 1})
"border-r-sm": (back-box {thickness-r: 2})
"border-r-md": (back-box {thickness-r: 3})
"border-r-lg": (back-box {thickness-r: 4})
"border-r-xl": (back-box {thickness-r: 5})
"border-r-2xl": (back-box {thickness-r: 6})
"border-r-3xl": (back-box {thickness-r: 7})

"border-b-none": (back-box {thickness-b: 0})
"border-b-xs": (back-box {thickness-b: 1})
"border-b-sm": (back-box {thickness-b: 2})
"border-b-md": (back-box {thickness-b: 3})
"border-b-lg": (back-box {thickness-b: 4})
"border-b-xl": (back-box {thickness-b: 5})
"border-b-2xl": (back-box {thickness-b: 6})
"border-b-3xl": (back-box {thickness-b: 7})

;;
;; Flow utilities.
;;

;; Fractional size.
"fr":
  (try
    (outermost-box real {fr: $(local arg)})
    (outermost-box {fr: 1}))

;; Selection of flow type.
"flow-row": (flow-box {node: x-stack})
"flow-col": (flow-box {node: y-stack})
"flow-none": (flow-box {node: z-stack})
"flow-wrap": (short-for "flow-wrap-x")
"flow-wrap-x": (flow-box {node: x-wrap})
"flow-wrap-y": (flow-box {node: y-wrap})

;; Gap size.
"gap": (flow-box real {gap: $(* (local arg) (global spacing))})
"gap-x": (flow-box real {gap-x: $(* (local arg) (global spacing))})
"gap-y": (flow-box real {gap-y: $(* (local arg) (global spacing))})

;;
;; Translation utilities.
;;

"px-d": (short-for "px-dl" "px-dt")
"d": (short-for "dl" "dt")
"sd": (short-for "sdl" "sdt")

"px-dl": (outermost-box real {dl: $(local arg)})
"px-dt": (outermost-box real {dt: $(local arg)})

"dl": (outermost-box real {dl: $(* (local arg) (global rem))})
"dt": (outermost-box real {dt: $(* (local arg) (global rem))})

"sdl": (outermost-box real {dl: $(* (local arg) (global spacing))})
"sdt": (outermost-box real {dt: $(* (local arg) (global spacing))})

"-px-dl": (outermost-box real {dl: $(* (local arg) -1)})
"-px-dt": (outermost-box real {dt: $(* (local arg) -1)})

"-dl": (outermost-box real {dl: $(* (local arg) (global -rem))})
"-dt": (outermost-box real {dt: $(* (local arg) (global -rem))})

"-sdl": (outermost-box real {dl: $(* (local arg) (global -spacing))})
"-sdt": (outermost-box real {dt: $(* (local arg) (global -spacing))})

;;
;; Center node utilities.
;;

"top": (align-box {y: 0})
"bottom": (align-box {y: 1})

"left": (align-box {x: 0})
"right": (align-box {x: 1})

"center": (short-for "center-x" "center-y")
"center-x": (align-box {x: 0.5})
"center-y": (align-box {y: 0.5})

"x": (align-box real {x: $(* (local arg) percents)})
"y": (align-box real {y: $(* (local arg) percents)})

"content-t": (content-align-box {y: 0})
"content-b": (content-align-box {y: 1})

"content-l": (content-align-box {x: 0})
"content-r": (content-align-box {x: 1})

"content-center": (short-for "content-center-x" "content-center-y")
"content-center-x": (content-align-box {x: 0.5})
"content-center-y": (content-align-box {y: 0.5})

"content-align-x": (content-align-box real {x: $(* (local arg) percents)})
"content-align-y": (content-align-box real {y: $(* (local arg) percents)})

;; Min width.
;;
;; Reference: https://tailwindcss.com/docs/min-width

"min-w": (limit-box real {min-w: $(local arg)})

"min-w-3xs": (limit-box {min-w: $(global limit-3xs)})
"min-w-2xs": (limit-box {min-w: $(global limit-2xs)})
"min-w-xs": (limit-box {min-w: $(global limit-xs)})
"min-w-sm": (limit-box {min-w: $(global limit-sm)})
"min-w-md": (limit-box {min-w: $(global limit-md)})
"min-w-lg": (limit-box {min-w: $(global limit-lg)})
"min-w-xl": (limit-box {min-w: $(global limit-xl)})
"min-w-2xl": (limit-box {min-w: $(global limit-2xl)})
"min-w-3xl": (limit-box {min-w: $(global limit-3xl)})
"min-w-4xl": (limit-box {min-w: $(global limit-4xl)})
"min-w-5xl": (limit-box {min-w: $(global limit-5xl)})
"min-w-6xl": (limit-box {min-w: $(global limit-6xl)})
"min-w-7xl": (limit-box {min-w: $(global limit-7xl)})

;;
;; Min height.
;;

"min-h": (limit-box real {min-h: $(local arg)})

"min-h-3xs": (limit-box {min-h: $(global limit-3xs)})
"min-h-2xs": (limit-box {min-h: $(global limit-2xs)})
"min-h-xs": (limit-box {min-h: $(global limit-xs)})
"min-h-sm": (limit-box {min-h: $(global limit-sm)})
"min-h-md": (limit-box {min-h: $(global limit-md)})
"min-h-lg": (limit-box {min-h: $(global limit-lg)})
"min-h-xl": (limit-box {min-h: $(global limit-xl)})
"min-h-2xl": (limit-box {min-h: $(global limit-2xl)})
"min-h-3xl": (limit-box {min-h: $(global limit-3xl)})
"min-h-4xl": (limit-box {min-h: $(global limit-4xl)})
"min-h-5xl": (limit-box {min-h: $(global limit-5xl)})
"min-h-6xl": (limit-box {min-h: $(global limit-6xl)})
"min-h-7xl": (limit-box {min-h: $(global limit-7xl)})

;; Max width.
;;
;; Reference: https://tailwindcss.com/docs/max-width

"max-w": (limit-box real {max-w: $(local arg)})

"max-w-3xs": (limit-box {max-w: $(global limit-3xs)})
"max-w-2xs": (limit-box {max-w: $(global limit-2xs)})
"max-w-xs": (limit-box {max-w: $(global limit-xs)})
"max-w-sm": (limit-box {max-w: $(global limit-sm)})
"max-w-md": (limit-box {max-w: $(global limit-md)})
"max-w-lg": (limit-box {max-w: $(global limit-lg)})
"max-w-xl": (limit-box {max-w: $(global limit-xl)})
"max-w-2xl": (limit-box {max-w: $(global limit-2xl)})
"max-w-3xl": (limit-box {max-w: $(global limit-3xl)})
"max-w-4xl": (limit-box {max-w: $(global limit-4xl)})
"max-w-5xl": (limit-box {max-w: $(global limit-5xl)})
"max-w-6xl": (limit-box {max-w: $(global limit-6xl)})
"max-w-7xl": (limit-box {max-w: $(global limit-7xl)})

;;
;; Max height.
;;

"max-h": (limit-box real {max-h: $(local arg)})

"max-h-3xs": (limit-box {max-h: $(global limit-3xs)})
"max-h-2xs": (limit-box {max-h: $(global limit-2xs)})
"max-h-xs": (limit-box {max-h: $(global limit-xs)})
"max-h-sm": (limit-box {max-h: $(global limit-sm)})
"max-h-md": (limit-box {max-h: $(global limit-md)})
"max-h-lg": (limit-box {max-h: $(global limit-lg)})
"max-h-xl": (limit-box {max-h: $(global limit-xl)})
"max-h-2xl": (limit-box {max-h: $(global limit-2xl)})
"max-h-3xl": (limit-box {max-h: $(global limit-3xl)})
"max-h-4xl": (limit-box {max-h: $(global limit-4xl)})
"max-h-5xl": (limit-box {max-h: $(global limit-5xl)})
"max-h-6xl": (limit-box {max-h: $(global limit-6xl)})
"max-h-7xl": (limit-box {max-h: $(global limit-7xl)})

;;
;; Cover (width and/or height in percents).
;;

"cover": (short-for "cover-x" "cover-y")
"cover-x": (percents-box real {w: $(* (local arg) percents)})
"cover-y": (percents-box real {h: $(* (local arg) percents)})

;; Z-index.
;;
;; Reference: https://tailwindcss.com/docs/z-index

"z-scope": (outermost-box {z-index: local})

"z-local": (outermost-box real {z-index: (local $(local arg))})
"-z-local": (outermost-box real {z-index: (local $(* (local arg) -1))})

"z": (outermost-box real {z-index: $(local arg)})
"-z": (outermost-box real {z-index: $(* (local arg) -1)})

;;
;; Opacity.
;;

"opacity": (composite-box real {opacity: $(* (local arg) percents)})

;; NOTE: We also have the "present" and "absent" pseudo-utilities to remove
;; the node from the tree; they are *pseudo*-utilities for a reason, and
;; thus they are defined not here but rather in the Crystal source.
"opaque": (composite-box {} unset: {+ opacity})
"transparent": (composite-box {opacity: 0})

;; Cursor utilities.
;;
;; Reference: https://tailwindcss.com/docs/cursor

"cursor-none": (outermost-box {cursor: none})
"cursor-text": (outermost-box {cursor: text})
"cursor-wait": (outermost-box {cursor: wait})
"cursor-grab": (outermost-box {cursor: grab})
"cursor-arrow": (outermost-box {cursor: arrow})
"cursor-pointer": (outermost-box {cursor: pointer})
"cursor-progress": (outermost-box {cursor: progress})
"cursor-crosshair": (outermost-box {cursor: crosshair})
"cursor-resize-tl-br": (outermost-box {cursor: resize-tl-br})
"cursor-resize-bl-tr": (outermost-box {cursor: resize-bl-tr})
"cursor-resize-x": (outermost-box {cursor: resize-x})
"cursor-resize-y": (outermost-box {cursor: resize-y})
"cursor-resize": (outermost-box {cursor: resize})
"cursor-not-allowed": (outermost-box {cursor: not-allowed})

;;
;; Rotation.
;;

"angle": (sized-box real {angle: $(* (local arg) degrees)})
"pivot": (sized-box {pivot: true})
"pivot-l": (sized-box real {pivot-l: $(* (local arg) percents)})
"pivot-t": (sized-box real {pivot-t: $(* (local arg) percents)})

;;
;; Origin.
;;

"origin": (sized-box {origin: true})
"origin-l": (sized-box real {origin-l: $(* (local arg) percents)})
"origin-t": (sized-box real {origin-t: $(* (local arg) percents)})

;;
;; Pan.
;;

"pan-l": (viewport-box {pan-x-side: left})
"pan-r": (viewport-box {pan-x-side: right})
"pan-t": (viewport-box {pan-y-side: top})
"pan-b": (viewport-box {pan-y-side: bottom})

"content-pan-l": (content-viewport-box {pan-x-side: left})
"content-pan-r": (content-viewport-box {pan-x-side: right})
"content-pan-t": (content-viewport-box {pan-y-side: top})
"content-pan-b": (content-viewport-box {pan-y-side: bottom})

;;
;; Foreground utilities. Tailwind doesn't appear to have these, they're a combo
;; for text-* and border-* color.
;;

"fg": (short-for "text-color" "border-color")

;;
;; Misc.
;;

"shrink": (outermost-box {shrink: true})
"shrink-w": (outermost-box {shrink: w})
"shrink-h": (outermost-box {shrink: h})
"no-shrink": (outermost-box {shrink: false})

"root": (outermost-box {root: true})

"content": (content-box {presence: true, x: true, y: true})
"content-x": (content-box {presence: true, x: true})
"content-y": (content-box {presence: true, y: true})
"max": (content-box {presence: false})

"sized": (sized-box {presence: true})
"unsized": (sized-box {presence: false})

"clip": (viewport-box {presence: true})
"overflow": (viewport-box {presence: false})

"content-clip": (content-viewport-box {presence: true})
"content-overflow": (content-viewport-box {presence: false})

"floating": (short-for "floating-x" "floating-y")
"floating-x": (floating-box {x: true})
"floating-y": (floating-box {y: true})
"static": (floating-box {x: false, y: false})

"isolate": (composite-box {presence: true})
"no-isolate": (composite-box {presence: false})

;; Backdrop is used to specify background/clear color for windows and images
;; in DwUIR, make sure to have it available as well.
"backdrop": (outermost-box (one-of colors) {backdrop: $(local arg)})


--- properties

;; Properties reside on the µfold-styled node itself, as in:
;;
;;   (group style: "text-neutral-500"
;;          ⏏selection-anchor⏏: 0
;;     "Line 1"
;;     "Line 2"
;;     "Line 3")
;;
;; Use $(local arg) to refer to the value (`0` in the example above).
;;
;; By default, µfold will keep these properties on the box, making it outermost.
;; However, this makes no sense for some properties. We opt out of the default
;; copying behavior by specifying explicitly which box should be targeted.

selection-anchor: (text-box integer {selection-anchor: $(local arg)})
selection-span: (text-box integer {selection-span: $(local arg)})

wrap-ellipsis: (text-box string {wrap-ellipsis: $(local arg)})
wrap-history: (text-box integer {wrap-history: $(local arg)})

pan-x: (viewport-box any {pan-x: $(local arg)})
pan-y: (viewport-box any {pan-y: $(local arg)})

content-pan-x: (content-viewport-box any {pan-x: $(local arg)})
content-pan-y: (content-viewport-box any {pan-y: $(local arg)})

zoom: (viewport-box real {zoom: $(local arg)})
content-zoom: (content-viewport-box real {zoom: $(local arg)})

sized-id: (sized-box any {id: $(local arg)})


