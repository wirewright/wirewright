presets:
{"dev":
  {flags: {"execution_context": true, "preview_mt": true},
   source: "src/dev.cr"},
 "docdump": {source: "src/doctool/dump.cr"},
 "doctool":
  {flags: {"execution_context": true, "preview_mt": true},
   source: "src/doctool.cr"},
 "irack":
  {flags: {"execution_context": true, "preview_mt": true},
   source: "src/irack.cr"},
 "mt":
  {flags: {"execution_context": true, "preview_mt": true}},
 "musoma":
  {flags:
    {"execution_context": true,
     "musoma": true,
     "preview_mt": true,
     "sdl3": true},
   source: "src/musoma.cr"},
 "tests":
  {flags:
    {"execution_context": true,
     "no_number_autocast": true,
     "preview_mt": true},
   source: "src/testtool.cr"}}

protocol:
"dev 0"

