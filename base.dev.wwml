;; NOTE: this file is part of the state for the `dev` tool. Prefer to use
;; the `dev` tool to modify this file.

presets:
{"dev": {source: "src/dev.cr"},
 "docdump": {source: "src/doctool/dump.cr"},
 "doctool": {source: "src/doctool.cr"},
 "irack": {source: "src/irack.cr"},
 "mt":
  {flags: {"execution_context": true, "preview_mt": true}},
 "musoma":
  {flags:
    {"musoma": true,
     "no_number_autocast": true,
     "sdl3": true},
   source: "src/musoma.cr"},
 "tests":
  {flags: {"dwuir": true, "no_number_autocast": true},
   runvars: {"LOG_LEVEL": "warn"},
   source: "src/testtool.cr"}}

protocol:
"dev 0"

