(schema (@schema json)
  expr => _number
  expr => (seq + (ref expr) (ref expr))
  expr => (seq - (ref expr) (ref expr))
  expr => (seq * (ref expr) (ref expr))
  expr => (seq / (ref expr) (ref expr)))

(server (@pool (((json @schema expr) @in policy: wrap) -> (ws local 5000) -> ((json @schema expr) @out)))
  (cell @expr)
  (cell @value)
  (backsys
    {¦ in: (M←(ok expr_) _*) -expr: >expr}
      <> {(M): (), >expr: ^expr}
    {¦ in: (M←(err _string) _*) out: (_* `>reply)}
      <> {(M): (), >reply: ^M}
    {¦ value_ out: (_* `>reply)}
      <> {(value): (), >reply: (ok ^value)})
  (rewriter (@expr -> (ascR (rulesetR)) -> @value)
    (+ ±a ±b) => ^(+ a b)
    (- ±a ±b) => ^(- a b)
    (* ±a ±b) => ^(* a b)
    (/ ±a ±b) => ^(/ a b)))

(pool @pool)

;; Example inputs:
;; 100
;; ["+", 100, 200]
;; ["+", 1, ["*", 2, 3]]
