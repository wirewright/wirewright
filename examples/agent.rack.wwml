(rewriter (chainR - @host)
  (step (adjR rulesetR)
    {¦ m_: . r_: ⟨(cell @action action←left)⟩}
      <> {m: ^(up r), (action): ()}

    {¦ l_: ⟨(cell @action action←right)⟩ m_: .}
      <> {m: ^(up l), (action): ()}

    {¦ l: . m_: ⟨(cell @action left)⟩}
      <> {m: .}

    {¦ m_: ⟨(cell @action right)⟩ r: .}
      <> {m: .})

  (step (adjR (rulesetR exh: true))
    {¦ l_ m: ⟨(cell @left view_)⟩}
      <> {view: ^l}

    {¦ m: ⟨(cell @right view_)⟩ r_}
      <> {view: ^r}))

(circuit @host
  .
  .
  .
  .
  .
  .
  .
  .
  .
  .
  (module {}
    (cell @action)
    (cell @left #)
    (cell @right #)
    (cell (space @history)
      ((* . . . . . . . O . . . * . . .)))
    (part (@history @guest) (_ guest_))

    (rewriter (chainR - {@:left, @:right, @:guest})
      (step rulesetR
        {¦ left_ guest: (`dst O _*)} <> {dst: ^left}
        {¦ right_ guest: (_* O `dst)} <> {dst: ^right}
        {¦ left: . guest: ⟨l←(%not . < >) O⟩} <> {l: .}
        {¦ right: . guest: ⟨O r←(%not . < >)⟩} <> {r: .}
        {¦ left_: (%not .) guest: ⟨l_ O⟩} <> {l: ^left}
        {¦ right_: (%not .) guest: ⟨O r_⟩} <> {r: ^right})

      (step (valueR guest (adjR rulesetR))
        {¦ l: * m_: .} <> {m: <}
        {¦ l: < m_: .} <> {m: <}
        {¦ m_: . r: *} <> {m: >}
        {¦ m_: . r: >} <> {m: >}
        {¦ l: < m_: O r: .} <> {m: .}
        {¦ m_: < r: O} <> {m: O}
        {¦ l: . m_: <} <> {m: .}
        {¦ m_: > r: .} <> {m: .}
        {¦ l: . m_: O r: >} <> {m: .}
        {¦ l: O m_: >} <> {m: O}
        {¦ l: O m_: *} <> {m: .}
        {¦ m_: * r: O} <> {m: .}))

    (backsys
      {¦ history: (pred_ `succ)}
        <> {succ: ^pred}

      {¦ history: (pred_ succ_)}
        <> {pred: ^succ}

      {¦ history: (((%gap n_) (%flex _) (%flex O) _*)
                   ((%gap n_) (%flex O) _*))
         -action_}
        <> {action: left}

      {¦ history: (((%gap n_) (%flex O) _*)
                   ((%gap n_) (%flex _) (%flex O) _*))
         -action_}
        <> {action: right}))
  .
  .
  .
  .
  .
  .
  .
  .
  .
  .)
