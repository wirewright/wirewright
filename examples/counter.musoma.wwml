(window title: "Counter" style: "backdrop-theme-base center"
  (group style: "flow-col bg-theme-surface p-5 rounded-3xl gap-5"
    (node @count
      (p 0 style: "center text-6xl text-theme-text font-medium"))

    (group style: "flow-wrap gap-3"
      (slot (Button (@msg (sub 1)) "Decrement"))
      (slot (Button (@msg (set 0)) "Reset"))
      (slot (Button (@msg (add 1)) "Increment")))

    (cell @msg)

    (backsys {@:msg @:count}
      {¦ msg_: (add ±n) count: [p ±count]}
        <> {(msg): (), count: ^(+ count n)}
      {¦ msg_: (sub ±n) count: [p ±count]}
        <> {(msg): (), count: ^(- count n)}
      {¦ msg_: (set ±n) count: [p ±count]}
        <> {(msg): (), count: ^n})))

((I modify: true structural: true multiline: true compose: true) ("" * "") 0)
