(comment
  "Merge sort. The goal here isn't efficiency, just use `sort` in Nitrene to do \
   actual sorting. The goal is to demo how a sorting algorithm can be a symbolic machine.")

(rewriter ((rulesetR) <-> {@:unsorted, @:sorted, @:workspace, @:busy})
  ;; Move singletons into the workspace.
  {¦ unsorted: (±n _*) workspace: (_* `dst)}
    <> {dst: (^n), (n): ()}
  ;; Move pairs into the workspace (ordered).
  {¦ unsorted: (±n ±m _*) workspace: (_* `dst)}
    <> {dst: (^n ^m), (n): (), (m): ()}
  ;; Move pairs into the workspace (unordered).
  {¦ unsorted: (±n m←(%number _ < (var n)) _*) workspace: (_* `dst)}
    <> {dst: (^m ^n), (n): (), (m): ()}
  ;; Detect termination & report to `@sorted`.
  {¦ busy: 0 unsorted_: () -sorted_ workspace: (a_dict)}
    <> {(a): (), (unsorted): (), sorted: ^a})

(cell @workspace ())
(cell @busy 0)

(comment
  "This is the merging-machine. It can be duplicated as many times as you \
   want, increasing the \"parallelism\" of sorting (currently only simulated \
   parallelism; Rack is still synchronous under the hood). That is, the more \
   of these modules you have, the more merging you can do per tick. Therefore, \
   you end up spending less ticks to sort. However, the cost of each tick increases, \
   as does the communication & conflict overhead, which is invisible in practice, \
   but ends up taking a chunk of time under the hood. For example, on my machine, \
   at the time of writing, the numbers are as follows:\n\
   sort(n=1000):\n \
   - 1: 9893 frames  ~293µs  ~3s\n \
   - 2: 5779 frames  ~330µs  ~2s\n \
   - 3: 4747 frames  ~367µs  ~1.7s\n \
   - 4: 4157 frames  ~357µs  ~1.4s\n \
   - 8: 3535 frames  ~513µs  ~1.8s")
(module {:@workspace, :@busy}
  (cell @l)
  (cell @r)
  (cell @out ())
  (rewriter ((rulesetR) <-> {@:workspace, @:busy, @:l, @:r, @:out})
    ;; Take work.
    {¦ workspace: (a_dict b_dict _*) -l_ -r_ ±busy}
      <> {(a): (), (b): (), l: ^a, r: ^b, busy: ^(+ busy 1)}
    ;; Post results.
    {¦ workspace: (_* `dst) l_: () r_: () out_: (_*) ±busy}
      <> {dst: ^out, (l): (), (r): (), out: (), busy: ^(- busy 1)}
    ;; Left is min.
    {¦ l: (±a _*) r: (_number _*) out: (_* `dst)}
      <> {(a): (), dst: ^a}
    ;; Right is min.
    {¦ l: (±a _*) r: (b←(%number _ < (var a)) _*) out: (_* `dst)}
      <> {(b): (), dst: ^b}
    ;; Only left left, concat.
    {¦ l_: (_+) r: () out: (_* `dst)}
      <> {l: (), (dst): ^l}
    ;; Only right left, concat.
    {¦ l: () r_: (_+) out: (_* `dst)}
      <> {r: (), (dst): ^r}))

(cell @sorted)

;(cell @unsorted (1 0 2 93 27 3248 294 2 49 7 3 0))

;; 100 numbers (for a visual demo in MuSoma)
(cell @unsorted
  (54 51 40 87 41 82 82 26 34 76 72 31 56 65 81 97 30 21 35 0 82 56 52 51 66 11 60 85 76 24 70 22 11 21 63 76 58 32 93 53 81 81 3 67 81 48 17 75 45 56 74 83 91 9 26 77 51 10 84 15 89 22 77 10 12 32 70 73 65 6 76 53 45 73 61 67 6 25 74 33 76 84 38 32 69 16 56 22 41 83 18 53 98 19 74 86 80 39 17 83))

