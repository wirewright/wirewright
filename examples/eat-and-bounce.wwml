 o
 #jobs/pending: ()
 #cells: {@dir: down}
 #population:
  {(cell @dir): true,
   (transform
    @rod-commands
    {env: { _: (move-parent-ahead)}, program: true}): true}
 #events:
  ((feedback busy @rod-commands)
   (job/completed
    {env: { _: (move-parent-ahead)}, program: true}
    true)))
