((self window) style: "bg-neutral-900 max origin" max-w: 1000 max-h: 800
  (group style: "max flow-wrap gap-5 p-5"
    (input "" "" "" #el: a label: "First name" placeholder: "John Doe")
    (input "" "" "" #el: a icon: none placeholder: none)
    (input "" "" "" #el: a icon: "search" placeholder: none)
    (input "" "" "" #el: a icon: none placeholder: "John Doe")
    (input "" "" "" #el: a icon: "search" placeholder: "John Doe")
    (input "Saman" "" "tha Doe" #el: a icon: "search" placeholder: "John Doe")
    (input "Saman" "tha" " Doe" #el: a icon: "search" placeholder: "John Doe")
    (input "" "tha " "" #el: a icon: "search" placeholder: "John Doe")
    (input "" "" "" #el: a icon: "search" placeholder: "Hover" hover: true)
    (input "" "" "" #el: a icon: "search" placeholder: "Hover,active" hover: true active: true)
    (input "" "" "" #el: a icon: "search" placeholder: "Focus" focus: true)
    (input "John" "" " Doe" #el: a icon: "search" placeholder: "John Doe" focus: true)
    (input "John" "athan" " Doe" #el: a icon: "search" placeholder: "John Doe" focus: true)
    (input "John" "athan" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true)
    (input "John" "athan" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe")
    (input "John" "athan" " Doe"
      #el: a
      label: (group style: "mb-1 gap-1 h-max"
                (icon "star" style: "h-max center-y")
                (p "Full name" style: "h-max center-y leading-tight text-sm")
                (p "NEW!" style: "h-max center-y font-bold text-xs leading-none bg-green-300 rounded-sm text-green-950 px-0.5 py-0.5 pb-1"))
      icon: "search"
      placeholder: "John Doe")
    (input "John" "" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true hint: "Lorem ipsum dolor sit amet")
    (input "John" "" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true limit: 20)
    (input "John" "" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true hint: "Lorem ipsum dolor sit amet" limit: 20)
    (group style: "max-w-lg"
      (input "John" "" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true hint: "Lorem ipsum dolor sit amet, officia excepteur ex fugiat reprehenderit enim labore culpa sint ad nisi Lorem pariatur mollit ex esse exercitation amet." limit: 20))))

