;; Transform + queue
(d7
  ((delay 0 (button "Send 1" as 1 to @inputs ((press))))
   (delay 1 (button "Send 2" as 2 to @inputs ((press))))
   (delay 2 (button "Send 3" as 3 to @inputs ((press))))
   (delay 3 (button "Send 4" as 4 to @inputs ((press))))
   (queue @inputs to @inputs/latest in () waiting @outputs)
   (transform @inputs/latest to @outputs (* _ _))
   (log @outputs in ()))
  ((button "Send 1" as 1 to @inputs ())
   (button "Send 2" as 2 to @inputs ())
   (button "Send 3" as 3 to @inputs ())
   (button "Send 4" as 4 to @inputs ())
   (queue @inputs to @inputs/latest in () waiting @outputs)
   (transform @inputs/latest to @outputs (* _ _))
   (log @outputs in (1 4 9 16))))

;; Counter multi step
(d7
  ((cell 5 @count)
   (button "Increment" as +1 to @deltas waiting @counts ((press) (press) (press)))
   (button "Decrement" as -1 to @deltas waiting @counts ())
   (transform @deltas to @counts with @count (+ count _))
   (latest @counts @count))
  ((cell 8 @count)
   (button "Increment" as +1 to @deltas waiting @counts ())
   (button "Decrement" as -1 to @deltas waiting @counts ())
   (transform @deltas to @counts with @count (+ count _))
   (latest @counts @count)))

;; Chain of transforms, multiple transforms on the same button
(d7
  ((cell 0 @count)
   (cell 2 @square)
   (cell @sum)
   (button "Increment" as +1 to @deltas waiting @sums ((press) (press) (press)))
   (transform @deltas to @counts with @count (+ count _))
   (transform @deltas to @squares with @square (* square square))
   (latest @counts @count)
   (latest @squares @square)
   (combine (@squares @counts) in () for @states)
   (transform (@states (square_number count_number)) to @sums (+ square count))
   (latest @sums @sum))
  ((cell 3 @count)
   (cell 256 @square)
   (cell 259 @sum)
   (button "Increment" as +1 to @deltas waiting @sums ())
   (transform @deltas to @counts with @count (+ count _))
   (transform @deltas to @squares with @square (* square square))
   (latest @counts @count)
   (latest @squares @square)
   (combine (@squares @counts) in () for @states)
   (transform (@states (square_number count_number)) to @sums (+ square count))
   (latest @sums @sum)))

;; Basic self-edit
(d7
  (("" | "" () @cursor)
   (delay 0 (event (edit @cursor (input "("))))
   (delay 1 (event (edit @cursor (input "cell"))))
   (delay 2 (event (edit @cursor (input " "))))
   (delay 3 (event (edit @cursor (input "0"))))
   (delay 4 (event (edit @cursor (input " "))))
   (delay 5 (event (edit @cursor (input "@x"))))
   (delay 6 (event (edit @cursor (key enter))))
   (delay 7 (event (edit @cursor (key right))))
   (changes @x to @xs)
   (log @xs in ()))
  ((cell 0 @x)
   ("" | "" () @cursor)
   (changes @x to @xs)
   (log @xs in (0))))

;; Motion self-edit
(d7
  ((group
     ("" | "" () @cursor)
     (transform (@commands up) to @edits (move-parent-behind))
     (transform (@commands down) to @edits (move-parent-ahead))
     (edit-cast @edits to @cursor))
   (button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ((press) (press))))
  ((button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ())
   (group
     ("" | "" () @cursor)
     (transform (@commands up) to @edits (move-parent-behind))
     (transform (@commands down) to @edits (move-parent-ahead))
     (edit-cast @edits to @cursor))))

(d7
  ((button "Move up" as up to @commands ((press)))
   (button "Move down" as down to @commands ())
   (group
     ("" | "" () @cursor)
     (transform (@commands up) to @edits (move-parent-behind))
     (transform (@commands down) to @edits (move-parent-ahead))
     (edit-cast @edits to @cursor)))
  ((button "Move up" as up to @commands ())
   (group
     ("" | "" () @cursor)
     (transform (@commands up) to @edits (move-parent-behind))
     (transform (@commands down) to @edits (move-parent-ahead))
     (edit-cast @edits to @cursor))
   (button "Move down" as down to @commands ())))

;; Edit-cage external signaling
(d7
  ((edit-cage for @cursor
     ("" | "" () @cursor))
   (delay 0 (event (pulse @cursor (input "hello"))))
   (delay 1 (event (pulse @cursor (key enter))))
   (delay 2 (event (pulse @cursor (key home))))
   ;; If cage didn't work, this would cause the cursor to jump out of the cage.
   (delay 3 (event (pulse @cursor (key home)))))
  ((edit-cage for @cursor
     ("" | "" () @cursor)
     hello)))

;; Edit-cage internal signaling
(d7
  ((button "Move up" as up to @commands ((press) (press) (press)))
   (button "Move down" as down to @commands ())
   (edit-cage for @edits
     A
     (group
       ("" | "" () @edits)
       (transform (@commands up) to @edits (move-parent-behind))
       (transform (@commands down) to @edits (move-parent-ahead)))
     B))
  ((button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ())
   (edit-cage for @edits
     (group
       ("" | "" () @edits)
       (transform (@commands up) to @edits (move-parent-behind))
       (transform (@commands down) to @edits (move-parent-ahead)))
     A
     B)))

(d7
  ((button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ((press) (press) (press) (press)))
   (edit-cage for @edits
     (group
       ("" | "" () @edits)
       (transform (@commands up) to @edits (move-parent-behind))
       (transform (@commands down) to @edits (move-parent-ahead)))
     A
     B))
  ((button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ())
   (edit-cage for @edits
     A
     B
     (group
       ("" | "" () @edits)
       (transform (@commands up) to @edits (move-parent-behind))
       (transform (@commands down) to @edits (move-parent-ahead))))))

;; blast
(d7
  ((button (1 2 3 4 5) to @lists ((press)))
   (blast @lists to @items)
   (queue @items to @items/in in () waiting @items/out)
   (transform @items/in to @items/out (* _ _))
   (log @items/out in ()))
  ((button (1 2 3 4 5) to @lists ())
   (blast @lists to @items)
   (queue @items to @items/in in () waiting @items/out)
   (transform @items/in to @items/out (* _ _))
   (log @items/out in (1 4 9 16 25))))

;; latest filter
(d7
  ((cell 0 @count)
   (changes @count to @counts)
   (transform @counts to @counts/future (+ _ 1))
   (latest (@counts/future n←(%number (whole _) < 10)) (@count n_)))
  ((cell 9 @count)
   (changes @count to @counts)
   (transform @counts to @counts/future (+ _ 1))
   (latest (@counts/future n←(%number (whole _) < 10)) (@count n_))))

;; lookaround node

(d7
  (foo
   bar
   (group
     a
     b
     (lookaround @views @refresh
       (transform (@views (view_ _)) to @behind view)
       (transform (@views (_ view_)) to @ahead view)
       (cell @behind)
       (cell @ahead)
       (latest @behind @behind)
       (latest @ahead @ahead)
       (button "Refresh lookaround" to @refresh ((press))))
     c
     (+ 1 2)
     d)
    baz
    qux)
  (foo
   bar
   (group
     a
     b
     (lookaround @views @refresh
       (transform (@views (view_ _)) to @behind view)
       (transform (@views (_ view_)) to @ahead view)
       (cell (a b) @behind)
       (cell (c (+ 1 2) d) @ahead)
       (latest @behind @behind)
       (latest @ahead @ahead)
       (button "Refresh lookaround" to @refresh ()))
     c
     (+ 1 2)
     d)
   baz
   qux))

;; lookaround movement

;; target above
(d7 limit: 256
  (a
   b
   c
   target
   d
   e
   f
   (lookaround @views @relook
     ("" | "" () @cursor)
     (periodic (pulse @relook true))
     (match (@views to @decisions)
       (((_* target) _) eat-behind)
       ((⟨target⟩ _) go-behind)
       ((_ (target _*)) eat-ahead)
       ((_ ⟨target⟩) go-ahead))
     (transform
       (@decisions eat-behind)
       to
       @sequences ((key home) (key left) (key C-backspace) (key right) (key down) (key down) (key down) (key down)))
     (transform
       (@decisions eat-ahead)
       to
       @sequences ((key end) (key right) (key C-delete) (key left) (key home) (key down) (key down) (key down) (key down)))
     (transform (@decisions go-behind) to @cursor-commands (move-parent-behind))
     (transform (@decisions go-ahead) to @cursor-commands (move-parent-ahead))
     (blast @sequences to @cursor-commands)
     (edit-cast @cursor-commands to @cursor))
   foo
   bar
   baz)
  (a
   b
   c
   (lookaround @views @relook
     ("" | "" () @cursor)
     (periodic (pulse @relook true))
     (match (@views to @decisions)
       (((_* target) _) eat-behind)
       ((⟨target⟩ _) go-behind)
       ((_ (target _*)) eat-ahead)
       ((_ ⟨target⟩) go-ahead))
     (transform
       (@decisions eat-behind)
       to
       @sequences ((key home) (key left) (key C-backspace) (key right) (key down) (key down) (key down) (key down)))
     (transform
       (@decisions eat-ahead)
       to
       @sequences ((key end) (key right) (key C-delete) (key left) (key home) (key down) (key down) (key down) (key down)))
     (transform (@decisions go-behind) to @cursor-commands (move-parent-behind))
     (transform (@decisions go-ahead) to @cursor-commands (move-parent-ahead))
     (blast @sequences to @cursor-commands)
     (edit-cast @cursor-commands to @cursor))
   d
   e
   f
   foo
   bar
   baz))

