;; Cell invited, expelled, basic behavior of `changes` node, `absence` node.
(d7
  ((decay 10 (cell 0 @count))
   (delay 15 (cell "Hello World" @count))
   (changes @count to @counts)
   (absence @count as "Missing" to @counts)
   (log @counts in ()))
  ((cell "Hello World" @count)
   (changes @count to @counts)
   (absence @count as "Missing" to @counts)
   (log @counts in (0 "Missing" "Hello World"))))

(group
  ;; Button long form, raw value
  (d7
    ((button "Increment" as 1 to @deltas ((press) (press) (press)))
     (log @deltas in ()))
    ((button "Increment" as 1 to @deltas ())
     (log @deltas in (1 1 1))))

  ;; Button short form, raw value
  (d7
    ((button "Increment" to @deltas ((press) (press) (press)))
     (log @deltas in ()))
    ((button "Increment" to @deltas ())
     (log @deltas in ("Increment" "Increment" "Increment"))))

  ;; Button long form, edge value
  (d7
    ((cell "Hello World" @msg)
     (button "Do it" as @msg to @deltas ((press) (press) (press)))
     (log @deltas in ()))
    ((cell "Hello World" @msg)
     (button "Do it" as @msg to @deltas ())
     (log @deltas in ("Hello World" "Hello World" "Hello World"))))

  ;; Button short form, edge value
  (d7
    ((cell "Hello World" @msg)
     (button @msg to @deltas ((press) (press) (press)))
     (log @deltas in ()))
    ((cell "Hello World" @msg)
     (button @msg to @deltas ())
     (log @deltas in ("Hello World" "Hello World" "Hello World"))))

  ;; Button feedback behavior
  (d7
    ((button (feedback busy @xs) to @xs ((press) (press) (press)))
     (echo @xs))
    ((button (feedback busy @xs) to @xs ((press) (press)) waiting: 1)
     (echo @xs)))

  (d7
    ((button (feedback busy @xs) to @xs ((press)))
     (echo @xs)
     (delay 3 (event (feedback done @xs))))
    ((button (feedback busy @xs) to @xs ())
     (echo @xs)))

  (d7
    ((button (feedback busy @xs) to @xs ((press) (press) (press)))
     (echo @xs)
     (delay 3 (event (feedback done @xs))))
    ((button (feedback busy @xs) to @xs ((press)) waiting: 1)
     (echo @xs)))

  (d7
    ((button (feedback busy @xs) to @xs ((press)))
     (echo @xs)
     (echo @xs)
     (echo @xs))
    ((button (feedback busy @xs) to @xs () waiting: 3)
     (echo @xs)
     (echo @xs)
     (echo @xs)))

  (d7
    ((button (feedback busy @xs) to @xs ((press)))
     (echo @xs)
     (echo @xs)
     (echo @xs)
     (delay 3 (event (feedback done @xs)))
     (delay 4 (event (feedback done @xs)))
     (delay 5 (event (feedback done @xs))))
    ((button (feedback busy @xs) to @xs ())
     (echo @xs)
     (echo @xs)
     (echo @xs)))

  (d7
    ((button (feedback busy @xs) to @xs ((press) (press) (press)))
     (echo @xs)
     (echo @xs)
     (echo @xs)
     (delay 3 (event (feedback done @xs)))
     (delay 4 (event (feedback done @xs)))
     (delay 5 (event (feedback done @xs))))
    ((button (feedback busy @xs) to @xs ((press)) waiting: 3)
     (echo @xs)
     (echo @xs)
     (echo @xs))))

;; Basic behavior of `latest`
(d7
  ((cell "Hello World" @msg)
   (button "Change msg" as "Changed!" to @msgs ((press)))
   (latest @msgs @msg)
   (changes @msg to @msg-changes)
   (log @msg-changes in ()))
  ((cell "Changed!" @msg)
   (button "Change msg" as "Changed!" to @msgs ())
   (latest @msgs @msg)
   (changes @msg to @msg-changes)
   (log @msg-changes in ("Hello World" "Changed!"))))

;; Log to cell
(d7
  ((cell () @log)
   (button "Hello World" to @msgs ((press) (press) (press)))
   (log @msgs in @log))
  ((cell ("Hello World" "Hello World" "Hello World") @log)
   (button "Hello World" to @msgs ())
   (log @msgs in @log)))

;; Log limit (and a whole bunch of other things)
(d7
  ((cell 10 @count for (%number (whole _) > 0))
   (changes @count to @deltas as -1)
   (transform @deltas to @counts with @count (+ state _))
   (latest @counts @count)
   (changes @count to @counts~)
   (log @counts~ in () limit: 5))
  ((cell 1 @count for (%number (whole _) > 0))
   (changes @count to @deltas as -1)
   (transform @deltas to @counts with @count (+ state _))
   (latest @counts @count)
   (changes @count to @counts~)
   (log @counts~ in (5 4 3 2 1) limit: 5)))

;; Log to cell limit
(d7
  ((cell () @log)
   (delay 0 (button 1 to @msgs ((press))))
   (delay 1 (button 2 to @msgs ((press))))
   (delay 2 (button 3 to @msgs ((press))))
   (delay 3 (button 4 to @msgs ((press))))
   (delay 4 (button 5 to @msgs ((press))))
   (delay 5 (button 6 to @msgs ((press))))
   (delay 6 (button 7 to @msgs ((press))))
   (log @msgs in @log limit: 4))
  ((cell (4 5 6 7) @log)
   (button 1 to @msgs ())
   (button 2 to @msgs ())
   (button 3 to @msgs ())
   (button 4 to @msgs ())
   (button 5 to @msgs ())
   (button 6 to @msgs ())
   (button 7 to @msgs ())
   (log @msgs in @log limit: 4)))

;; Stateless transform
(d7
  ((button "Send 4" as 4 to @inputs ((press)))
   (transform @inputs to @outputs (* _ _))
   (log @outputs in ()))
  ((button "Send 4" as 4 to @inputs ())
   (transform @inputs to @outputs (* _ _))
   (log @outputs in (16))))

;; Stateless filter transform
(d7
  ((cell 0 @value for (%number (whole _) < 10))
   (changes @value to @values)
   (transform (@values n←(%pipe (mod 2) 0)) to @parities (even n))
   (transform (@values n←(%pipe (mod 2) 1)) to @parities (odd n))
   (transform @values to @successors (+ _ 1))
   (latest @successors @value)
   (log @parities in () limit: 7))
  ((cell 9 @value for (%number (whole _) < 10))
   (changes @value to @values)
   (transform (@values n←(%pipe (mod 2) 0)) to @parities (even n))
   (transform (@values n←(%pipe (mod 2) 1)) to @parities (odd n))
   (transform @values to @successors (+ _ 1))
   (latest @successors @value)
   (log @parities in ((odd 3) (even 4) (odd 5) (even 6) (odd 7) (even 8) (odd 9)) limit: 7)))

;; Stateful filter transform
(d7
  ((cell 5 @count)
   (button "Increment" to @actions ((press) (press) (press)))
   (button "Decrement" to @actions ())
   (transform (@actions "Increment") to @counts with @count (+ state 1))
   (transform (@actions "Decrement") to @counts with @count (- state 1))
   (latest @counts @count))
  ((cell 8 @count)
   (button "Increment" to @actions ())
   (button "Decrement" to @actions ())
   (transform (@actions "Increment") to @counts with @count (+ state 1))
   (transform (@actions "Decrement") to @counts with @count (- state 1))
   (latest @counts @count)))

(d7
  ((cell 8 @count)
   (button "Increment" to @actions ())
   (button "Decrement" to @actions ((press) (press) (press)))
   (transform (@actions "Increment") to @counts with @count (+ state 1))
   (transform (@actions "Decrement") to @counts with @count (- state 1))
   (latest @counts @count))
  ((cell 5 @count)
   (button "Increment" to @actions ())
   (button "Decrement" to @actions ())
   (transform (@actions "Increment") to @counts with @count (+ state 1))
   (transform (@actions "Decrement") to @counts with @count (- state 1))
   (latest @counts @count)))

(d7
  ((cell 123 @x)
   (button "Hello World" to @xs ((press)))
   (transform (@xs msg_) to @msgs with @x (state msg))
   (log @msgs in ()))
  ((cell 123 @x)
   (button "Hello World" to @xs ())
   (transform (@xs msg_) to @msgs with @x (state msg))
   (log @msgs in ((123 "Hello World")))))

;; Basic stateful transform: counter
(d7
  ((cell 5 @count)
   (button "Increment" as +1 to @deltas ((press)))
   (button "Decrement" as -1 to @deltas ())
   (transform @deltas to @counts with @count (+ state _))
   (latest @counts @count))
  ((cell 6 @count)
   (button "Increment" as +1 to @deltas ())
   (button "Decrement" as -1 to @deltas ())
   (transform @deltas to @counts with @count (+ state _))
   (latest @counts @count)))

(d7
  ((cell 5 @count)
   (button "Increment" as +1 to @deltas ())
   (button "Decrement" as -1 to @deltas ((press)))
   (transform @deltas to @counts with @count (+ state _))
   (latest @counts @count))
  ((cell 4 @count)
   (button "Increment" as +1 to @deltas ())
   (button "Decrement" as -1 to @deltas ())
   (transform @deltas to @counts with @count (+ state _))
   (latest @counts @count)))

;; Transform + queue
(d7
  ((delay 0 (button "Send 1" as 1 to @inputs ((press))))
   (delay 1 (button "Send 2" as 2 to @inputs ((press))))
   (delay 2 (button "Send 3" as 3 to @inputs ((press))))
   (delay 3 (button "Send 4" as 4 to @inputs ((press))))
   (queue @inputs to @bases in ())
   (pull @bases/latest from @bases)
   (transform @bases/latest to @outputs (* _ _))
   (log @outputs in ()))
  ((button "Send 1" as 1 to @inputs ())
   (button "Send 2" as 2 to @inputs ())
   (button "Send 3" as 3 to @inputs ())
   (button "Send 4" as 4 to @inputs ())
   (queue @inputs to @bases in ())
   (pull @bases/latest from @bases)
   (transform @bases/latest to @outputs (* _ _))
   (log @outputs in (1 4 9 16))))

;; Counter multi step
(d7
  ((cell 5 @count)
   (button "Increment" as +1 to @deltas ((press) (press) (press)))
   (button "Decrement" as -1 to @deltas ())
   (transform @deltas to @counts with @count (+ state _))
   (latest @counts @count))
  ((cell 8 @count)
   (button "Increment" as +1 to @deltas ())
   (button "Decrement" as -1 to @deltas ())
   (transform @deltas to @counts with @count (+ state _))
   (latest @counts @count)))

;; Multiple transforms on the same button
(d7
  ((cell 0 @count)
   (button "Increment" as +1 to @deltas ((press) (press) (press) (press) (press)))
   ;; This one should cancel
   (decay 1 (transform @deltas to @counts with @count (+ state _)))
   ;; This one should go on, a "Backup" of sorts
   (decay 5 (transform @deltas to @counts with @count (+ state _)))
   (latest @counts @count))
  ((cell 5 @count)
   (button "Increment" as +1 to @deltas ())
   (latest @counts @count)))

;; Basic self-edit
(d7
  (("" | "" () @cursor)
   (delay 0 (event (edit @cursor (input "("))))
   (delay 1 (event (edit @cursor (input "cell"))))
   (delay 2 (event (edit @cursor (input " "))))
   (delay 3 (event (edit @cursor (input "0"))))
   (delay 4 (event (edit @cursor (input " "))))
   (delay 5 (event (edit @cursor (input "@x"))))
   (delay 6 (event (edit @cursor (key enter))))
   (delay 7 (event (edit @cursor (key right))))
   (changes @x to @xs)
   (log @xs in ()))
  ((cell 0 @x)
   ("" | "" () @cursor)
   (changes @x to @xs)
   (log @xs in (0))))

;; Motion self-edit
(d7
  ((group
     ("" | "" () @cursor)
     (transform (@commands up) to @edits (move-parent-behind))
     (transform (@commands down) to @edits (move-parent-ahead))
     (edit-cast @edits to @cursor))
   (button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ((press) (press))))
  ((button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ())
   (group
     ("" | "" () @cursor)
     (transform (@commands up) to @edits (move-parent-behind))
     (transform (@commands down) to @edits (move-parent-ahead))
     (edit-cast @edits to @cursor))))

(d7
  ((button "Move up" as up to @commands ((press)))
   (button "Move down" as down to @commands ())
   (group
     ("" | "" () @cursor)
     (transform (@commands up) to @edits (move-parent-behind))
     (transform (@commands down) to @edits (move-parent-ahead))
     (edit-cast @edits to @cursor)))
  ((button "Move up" as up to @commands ())
   (group
     ("" | "" () @cursor)
     (transform (@commands up) to @edits (move-parent-behind))
     (transform (@commands down) to @edits (move-parent-ahead))
     (edit-cast @edits to @cursor))
   (button "Move down" as down to @commands ())))

;; Edit-cage external signaling
(d7
  ((edit-cage for @cursor
     ("" | "" () @cursor))
   (delay 0 (event (pulse @cursor (input "hello"))))
   (delay 1 (event (pulse @cursor (key enter))))
   (delay 2 (event (pulse @cursor (key home))))
   ;; If cage didn't work, this would cause the cursor to jump out of the cage.
   (delay 3 (event (pulse @cursor (key home)))))
  ((edit-cage for @cursor
     ("" | "" () @cursor)
     hello)))

;; Edit-cage internal signaling
(d7
  ((button "Move up" as up to @commands ((press) (press) (press)))
   (button "Move down" as down to @commands ())
   (edit-cage for @edits
     A
     (group
       ("" | "" () @edits)
       (transform (@commands up) to @edits (move-parent-behind))
       (transform (@commands down) to @edits (move-parent-ahead)))
     B))
  ((button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ())
   (edit-cage for @edits
     (group
       ("" | "" () @edits)
       (transform (@commands up) to @edits (move-parent-behind))
       (transform (@commands down) to @edits (move-parent-ahead)))
     A
     B)))

(d7
  ((button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ((press) (press) (press) (press)))
   (edit-cage for @edits
     (group
       ("" | "" () @edits)
       (transform (@commands up) to @edits (move-parent-behind))
       (transform (@commands down) to @edits (move-parent-ahead)))
     A
     B))
  ((button "Move up" as up to @commands ())
   (button "Move down" as down to @commands ())
   (edit-cage for @edits
     A
     B
     (group
       ("" | "" () @edits)
       (transform (@commands up) to @edits (move-parent-behind))
       (transform (@commands down) to @edits (move-parent-ahead))))))

;; blast
(d7
  ((button (1 2 3 4 5) to @lists ((press)))
   (blast @lists to @items)
   (queue @items to @items/queued in ())
   (pull @items/latest from @items/queued)
   (transform @items/latest to @items/squared (* _ _))
   (log @items/squared in ()))
  ((button (1 2 3 4 5) to @lists ())
   (blast @lists to @items)
   (queue @items to @items/queued in ())
   (pull @items/latest from @items/queued)
   (transform @items/latest to @items/squared (* _ _))
   (log @items/squared in (1 4 9 16 25))))

;; latest filter
(d7
  ((cell 0 @count)
   (changes @count to @counts)
   (transform @counts to @counts/future (+ _ 1))
   (latest (@counts/future n←(%number (whole _) < 10)) (@count n_)))
  ((cell 9 @count)
   (changes @count to @counts)
   (transform @counts to @counts/future (+ _ 1))
   (latest (@counts/future n←(%number (whole _) < 10)) (@count n_))))
