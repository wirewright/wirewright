;; See how transform behaves with symbolic/non-symblic state edge
(group
  ;; transform with symbol edge
  (d7
    ((cell 100 @x)
     (transform @deltas to @xs with @x (+ x _))
     (event (pulse @deltas 1))
     (latest @xs @x))
    ((cell 101 @x)
     (transform @deltas to @xs with @x (+ x _))
     (latest @xs @x)))

  ;; transform with numeric state edge
  (d7
    ((cell 100 @0)
     (transform @deltas to @xs with @0 (+ state _))
     (event (pulse @deltas 1))
     (latest @xs @0))
    ((cell 101 @0)
     (transform @deltas to @xs with @0 (+ state _))
     (latest @xs @0)))

  ;; transform with string state edge
  (d7
    ((cell 100 @"John Doe")
     (transform @deltas to @xs with @"John Doe" (+ state _))
     (event (pulse @deltas 1))
     (latest @xs @"John Doe"))
    ((cell 101 @"John Doe")
     (transform @deltas to @xs with @"John Doe" (+ state _))
     (latest @xs @"John Doe"))))

;; Stateless transform
(d7
  ((button "Send 4" as 4 to @inputs ((press)))
   (transform @inputs to @outputs (* _ _))
   (log @outputs in ()))
  ((button "Send 4" as 4 to @inputs ())
   (transform @inputs to @outputs (* _ _))
   (log @outputs in (16))))

;; Stateless filter transform
(d7 limit: 256
  ((cell 0 @value for (%number (whole _) < 10))
   (changes @value to @values)
   (transform (@values n←(%pipe (mod 2) 0)) to @parities (even n))
   (transform (@values n←(%pipe (mod 2) 1)) to @parities (odd n))
   (transform @values to @successors (+ _ 1))
   (latest @successors @value)
   (log @parities in () limit: 7))
  ((cell 9 @value for (%number (whole _) < 10))
   (changes @value to @values)
   (transform (@values n←(%pipe (mod 2) 0)) to @parities (even n))
   (transform (@values n←(%pipe (mod 2) 1)) to @parities (odd n))
   (transform @values to @successors (+ _ 1))
   (latest @successors @value)
   (log @parities in ((odd 3) (even 4) (odd 5) (even 6) (odd 7) (even 8) (odd 9)) limit: 7)))

;; Stateful filter transform
(d7
  ((cell 5 @count)
   (button "Increment" to @actions waiting @counts ((press) (press) (press)))
   (button "Decrement" to @actions waiting @counts ())
   (transform (@actions "Increment") to @counts with @count (+ count 1))
   (transform (@actions "Decrement") to @counts with @count (- count 1))
   (latest @counts @count))
  ((cell 8 @count)
   (button "Increment" to @actions waiting @counts ())
   (button "Decrement" to @actions waiting @counts ())
   (transform (@actions "Increment") to @counts with @count (+ count 1))
   (transform (@actions "Decrement") to @counts with @count (- count 1))
   (latest @counts @count)))

(d7
  ((cell 8 @count)
   (button "Increment" to @actions waiting @counts ())
   (button "Decrement" to @actions waiting @counts ((press) (press) (press)))
   (transform (@actions "Increment") to @counts with @count (+ count 1))
   (transform (@actions "Decrement") to @counts with @count (- count 1))
   (latest @counts @count))
  ((cell 5 @count)
   (button "Increment" to @actions waiting @counts ())
   (button "Decrement" to @actions waiting @counts ())
   (transform (@actions "Increment") to @counts with @count (+ count 1))
   (transform (@actions "Decrement") to @counts with @count (- count 1))
   (latest @counts @count)))

(d7
  ((cell 123 @x)
   (button "Hello World" to @xs ((press)))
   (transform (@xs msg_) to @msgs with @x (x msg))
   (log @msgs in ()))
  ((cell 123 @x)
   (button "Hello World" to @xs ())
   (transform (@xs msg_) to @msgs with @x (x msg))
   (log @msgs in ((123 "Hello World")))))

;; Basic stateful transform: counter
(d7
  ((cell 5 @count)
   (button "Increment" as +1 to @deltas ((press)))
   (button "Decrement" as -1 to @deltas ())
   (transform @deltas to @counts with @count (+ count _))
   (latest @counts @count))
  ((cell 6 @count)
   (button "Increment" as +1 to @deltas ())
   (button "Decrement" as -1 to @deltas ())
   (transform @deltas to @counts with @count (+ count _))
   (latest @counts @count)))

(d7
