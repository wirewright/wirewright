;; Cell invited, expelled, basic behavior of `changes` node, `absence` node.
(d7
  ((decay 10 (cell 0 @count))
   (delay 15 (cell "Hello World" @count))
   (changes @count to @counts)
   (absence @count as "Missing" to @counts)
   (log @counts in ()))
  ((cell "Hello World" @count)
   (changes @count to @counts)
   (absence @count as "Missing" to @counts)
   (log @counts in (0 "Missing" "Hello World"))))

;; Uninitialized cell
(d7
  ((cell @x)
   (button "Initialize cell" as 0 to @xs ((press)))
   (latest @xs @x))
  ((cell 0 @x)
   (button "Initialize cell" as 0 to @xs ())
   (latest @xs @x)))

;; Initialized cell pattern mismatch degenerates into an uninitialized cell
;; without effects.
(d7
  ((cell @x)
   (changes @x to @xs)
   (absence @x as "Missing" to @xs)
   (log @xs in ()))
  ((cell @x)
   (changes @x to @xs)
   (absence @x as "Missing" to @xs)
   (log @xs in ("Missing"))))
(d7
  ((cell "Hello World" @x for _number)
   (changes @x to @xs)
   (absence @x as "Missing" to @xs)
   (log @xs in ()))
  ((cell @x for _number)
   (changes @x to @xs)
   (absence @x as "Missing" to @xs)
   (log @xs in ("Missing"))))

;; (cell @_ for _) init with OK value
(d7
  ((cell @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ())
   (delay 1 (event (assign @count 100))))
  ((cell 100 @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ("Missing" 100))))

;; (cell @_ for _) init with OK value no cycle
(d7
  ((cell @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ())
   (event (assign @count 100)))
  ((cell 100 @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ("Missing" 100))))

;; (cell @_ for _) init with BAD value
(d7
  ((cell @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ())
   (event (assign @count "Hello World")))
  ((cell @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ("Missing"))))

;; (cell @_ for _) init with BAD value then OK value after a delay
(d7
  ((cell @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ())
   (event (assign @count "Hello World"))
   (delay 5 (event (assign @count 100))))
  ((cell 100 @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ("Missing" 100))))

;; (cell <bad value> @_ for _) init with OK value
(d7
  ((cell "Hello World" @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ())
   (delay 5 (event (assign @count 100))))
  ((cell 100 @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ("Missing" 100))))

;; (cell <bad value> @x for _) init with BAD value
(d7
  ((cell "Hello World" @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ())
   (delay 5 (event (assign @count "Hell World"))))
  ((cell @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ("Missing"))))

;; (cell <ok value> @x for _) init with OK value
(d7
  ((cell 100 @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ())
   (delay 5 (event (assign @count 200))))
  ((cell 200 @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in (100 200))))

;; (cell <ok value> @x for _) init with BAD value
(d7
  ((cell 100 @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in ())
   (delay 5 (event (assign @count "Hello World"))))
  ((cell 100 @count for _number)
   (changes @count to @log)
   (absence @count as "Missing" to @log)
   (log @log in (100))))

(group
  ;; Button long form, raw value
  (d7
    ((button "Increment" as 1 to @deltas ((press) (press) (press)))
     (log @deltas in ()))
    ((button "Increment" as 1 to @deltas ())
     (log @deltas in (1 1 1))))

  ;; Button short form, raw value
  (d7
    ((button "Increment" to @deltas ((press) (press) (press)))
     (log @deltas in ()))
    ((button "Increment" to @deltas ())
     (log @deltas in ("Increment" "Increment" "Increment"))))

  ;; Button long form, edge value
  (d7
    ((cell "Hello World" @msg)
     (button "Do it" as @msg to @deltas ((press) (press) (press)))
     (log @deltas in ()))
    ((cell "Hello World" @msg)
     (button "Do it" as @msg to @deltas ())
     (log @deltas in ("Hello World" "Hello World" "Hello World"))))

  ;; Button short form, edge value
  (d7
    ((cell "Hello World" @msg)
     (button @msg to @deltas ((press) (press) (press)))
     (log @deltas in ()))
    ((cell "Hello World" @msg)
     (button @msg to @deltas ())
     (log @deltas in ("Hello World" "Hello World" "Hello World"))))

  ;; Button clock
  (d7
    ((button "Qux" as 100 to @ys waiting @xs ((press) (press) (press)))
     (delay 1 (button "Press" to @xs ((press))))
     (log @ys in ()))
    ((button "Qux" as 100 to @ys waiting @xs ((pressed) (press)))
     (button "Press" to @xs ())
     (log @ys in (100 100))))

  ;; Button clock feedback simulate
  (d7
    ((cell 5 @n)
     (button "Square it" as @n to @inputs waiting @outputs ((press) (press) (press)))
     (transform (@inputs n_number) to @outputs (* n n))
     (latest @outputs @n))
    ((cell 390625 @n)
     (button "Square it" as @n to @inputs waiting @outputs ())
     (transform (@inputs n_number) to @outputs (* n n))
     (latest @outputs @n))))

;; Basic behavior of `latest`
(d7
  ((cell "Hello World" @msg)
   (button "Change msg" as "Changed!" to @msgs ((press)))
   (latest @msgs @msg)
   (changes @msg to @msg-changes)
   (log @msg-changes in ()))
  ((cell "Changed!" @msg)
   (button "Change msg" as "Changed!" to @msgs ())
   (latest @msgs @msg)
   (changes @msg to @msg-changes)
   (log @msg-changes in ("Hello World" "Changed!"))))

;; Log to cell
(d7
  ((cell () @log)
   (button "Hello World" to @msgs ((press) (press) (press)))
   (log @msgs in @log))
  ((cell ("Hello World" "Hello World" "Hello World") @log)
   (button "Hello World" to @msgs ())
   (log @msgs in @log)))

;; Log limit (and a whole bunch of other things)
(d7
  ((cell 10 @count for (%number (whole _) > 0))
   (changes @count to @deltas as -1)
   (transform @deltas to @counts with @count (+ count _))
   (latest @counts @count)
   (changes @count to @counts~)
   (log @counts~ in () limit: 5))
  ((cell 1 @count for (%number (whole _) > 0))
   (changes @count to @deltas as -1)
   (transform @deltas to @counts with @count (+ count _))
   (latest @counts @count)
   (changes @count to @counts~)
   (log @counts~ in (5 4 3 2 1) limit: 5)))

(d7
  ((log @xs in () limit: 1)
   (event (pulse @xs 100))
   (delay 1 (event (pulse @xs 200)))
   (delay 2 (event (pulse @xs 300))))
  ((log @xs in (300) limit: 1)))

;; Log to cell limit
(d7
  ((cell () @log)
   (delay 0 (button 1 to @msgs ((press))))
   (delay 1 (button 2 to @msgs ((press))))
   (delay 2 (button 3 to @msgs ((press))))
   (delay 3 (button 4 to @msgs ((press))))
   (delay 4 (button 5 to @msgs ((press))))
   (delay 5 (button 6 to @msgs ((press))))
   (delay 6 (button 7 to @msgs ((press))))
   (log @msgs in @log limit: 4))
  ((cell (4 5 6 7) @log)
   (button 1 to @msgs ())
   (button 2 to @msgs ())
   (button 3 to @msgs ())
   (button 4 to @msgs ())
   (button 5 to @msgs ())
   (button 6 to @msgs ())
   (button 7 to @msgs ())
   (log @msgs in @log limit: 4)))

