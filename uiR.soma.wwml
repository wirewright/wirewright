;; TODO: support x-wrapping using x-wrap: if item does not fit inside
;; w: max (max-w) then it should wrap. x-wrap is always w: max h: content!!!
;; TODO: support y-wrapping using y-wrap: if item does not fit inside
;; h: max (max-h) then it should wrap. y-wrap is always w: content h: max!!!

;; GENERAL

;; Learn the content width/height from a single child.
((%not x-expand) {¦ content-w: w_number} ¦ _ content-w: (%- _ W)) <> {W: →w}
((%not y-expand) {¦ content-h: h_number} ¦ _ content-h: (%- _ H)) <> {H: →h}

;; Propagate max-w/h if I know my max-w/h and I am w/h: max.
(_ {¦ max-w: (%- _ w)} ¦ _ w: max max-w: W_number) <> {w: →W}
(_ {¦ max-h: (%- _ h)} ¦ _ h: max max-h: H_number) <> {h: →H}

;; Propagate my content-w/h as max-w/h of children if I am w/h: content.
(_ {¦ max-w: (%- _ w)} ¦ _ w: content content-w: W_number) <> {w: →W}
(_ {¦ max-h: (%- _ h)} ¦ _ h: content content-h: H_number) <> {h: →H}

;; Set final-w/h according to w/h.
{¦ w: content content-w_number -final-w_} <> {final-w: →content-w}
{¦ h: content content-h_number -final-h_} <> {final-h: →content-h}

{¦ w: max max-w_number -final-w_} <> {final-w: →max-w}
{¦ h: max max-h_number -final-h_} <> {final-h: →max-h}

;; Propagate l/t if not translate, which controls them differently.
;;
;; NOTE: We have to use %not here because `translate` relies on final-w/h,
;; which is computed a lot later than this rule becomes applicable. Therefore
;; this rule is "forced by content" -- even though in case of transform, we
;; actually want to wait until final-w/h are available.
((%not translate) {¦ -l_} ¦ _ l: L_number) <> {l: →L}
((%not translate) {¦ -t_} ¦ _ t: T_number) <> {t: →T}

;; NODE: text

(backmap
  (text caption_string ¦ _
    w: content
    h: content
    -content-w_
    -content-h_
    font_string
    leading_number
    weight_: (%any 100 200 300 400 450 500 600 700 800 900)
    size_: (%number u8))
  {content-w: ($ (value (measure →caption →font →weight →size →leading) width)),
   content-h: ($ (value (measure →caption →font →weight →size →leading) height))})

;; NODE: padding

(padding _ ¦ _ -px_ pl⋮ 0 pr⋮ 0) <> {px: ($once (+ →pl →pr))}
(padding _ ¦ _ -py_ pt⋮ 0 pb⋮ 0) <> {py: ($once (+ →pt →pb))}

(padding {¦ content-w: w_number} ¦ _ content-w: (%- _ W) px_number) <> {W: ($once (+ →w →px))}
(padding {¦ content-h: h_number} ¦ _ content-h: (%- _ H) py_number) <> {H: ($once (+ →h →py))}
(padding {¦ max-w: (%- _ w)} ¦ _ w: max max-w: W_number px_number) <> {w: ($once (- →W →px))}
(padding {¦ max-h: (%- _ h)} ¦ _ h: max max-h: H_number py_number) <> {h: ($once (- →H →py))}
(padding {¦ -l_} ¦ _ l: L_number pl_number) <> {l: ($once (+ →L →pl))}
(padding {¦ -t_} ¦ _ t: T_number pt_number) <> {t: ($once (+ →T →pt))}

;; NODE: rect

;; `rect` does not have content. Hard-code its content-w/h to 0.
(rect ¦ _ -content-w_) <> {content-w: 0}
(rect ¦ _ -content-h_) <> {content-h: 0}

;; NODE: x-expand

(x-expand {¦ max-w: w_number} ¦ _ content-w: (%- _ W)) <> {W: →w}
(x-expand {¦ -max-w_ content-w: w_number} ¦ _ min-w_number)
  <> {max-w: ($once (max →min-w →w))}

;; NODE: y-expand

(y-expand {¦ max-h: h_number} ¦ _ content-h: (%- _ H)) <> {H: →h}
(y-expand {¦ -max-h_ content-h: h_number} ¦ _ min-h_number)
  <> {max-h: ($once (max →min-h →h))}

;; NODE: translate

(translate {¦ -l_} ¦ _ l: L_number x_number) <> {l: ($once (+ →L →x))}
(translate {¦ -t_} ¦ _ t: T_number y_number) <> {t: ($once (+ →T →y))}

(translate {¦ -l_ final-w: w_number} ¦ _ x: center l: L_number final-w: W_number)
  <> {l: ($ (+ →L (// (- →W →w) 2)))}
(translate {¦ -t_ final-h: h_number} ¦ _ y: center t: T_number final-h: H_number)
  <> {t: ($ (+ →T (// (- →H →h) 2)))}
(translate {¦ -l_ final-w: w_number} ¦ _ x: right l: L_number final-w: W_number)
  <> {l: ($ (- (+ →L →W) →w))}
(translate {¦ -t_ final-h: h_number} ¦ _ y: bottom t: T_number final-h: H_number)
  <> {t: ($ (- (+ →T →H) →h))}

;; NODE: floating
;;
;; Floating node is exempt from sizing. It reports its content-w/h as 0. In effect,
;; it's protecting ("coating") its child from inward sizing whereas outward sizing
;; is preserved.

(floating _ ¦ _ -content-w_ -content-h_) <> {content-w: 0, content-h: 0}

;; NODE: x-stack

;; Compute the content-w of x-stack.
(x-stack (%many Cws {¦ content-w: (%let 0 _number)}) ¦ _ content-w: (%- _ W) gap⋮ 0)
  <> {W: ($ (+ (sum (flatten →Cws)) (* →gap (- (tally →Cws) 1))))}

;; Compute the content-h of x-stack.
(x-stack (%many Chs {¦ content-h: (%let 0 _number)}) ¦ _ content-h: (%- _ H))
  <> {H: ($ (max (flatten →Chs)))}

;; If x-stack is set to h: content then setting h: max in a child
;; would mean that the child's max-h is content-h of the x-stack
;; (i.e., maximum sibling height).
(%all (x-stack _+ ¦ _ h: content content-h: H_number) ⟨{¦ h: max max-h: (%- _ h)}⟩°)
  <> {h: →H}

;; If x-stack is set to h: max then setting h: max in a child would
;; mean that the child's max-h is max-h of the x-stack.
(%all (x-stack _+ ¦ _ h: max max-h: H_number) ⟨{¦ h: max max-h: (%- _ h)}⟩°)
  <> {h: →H}

;; In case of a x-stack, all children tops are shared and are exactly
;; x-stack's top.
(%all (x-stack _+ ¦ _ t: T_number) ⟨{¦ -t_}⟩°)
  <> {t: →T}

;; The first child of x-stack has the same left position as the x-stack itself.
(x-stack {¦ -l_} _* ¦ _ l: L_number)
  <> {l: →L}

;; Any consecutive child learns its left position from the previous child
;; plus the previous child's final-w.
;;
;; NOTE: we use the last child's left as a "flag" to signal that all children
;; had their lefts computed already and the rule engine should skip this rule.
;; This simplifies the job of the rule engine, making sure that it doesn't
;; have to go through all children every time before seeing that there is
;; no change, with regards to this particular rule.
(%all (x-stack _* {¦ l: (%- _)} ¦ _ gap⋮ 0) ⟨{¦ l: l0_number final-w: w0_number} {¦ l: (%- _ l1)}⟩)
  <> {l1: ($once (+ →l0 →w0 →gap))}

;; Sum content-w's of x-stack. Subtract from final-w of x-stack to get leftover-w.
(%all (x-stack _* ¦ _ fractions: true -leftover-w_ final-w: W_number) (%items Ws {¦ final-w: 0←_number} min: 0))
  <> {leftover-w: ($ (- →W (sum (flatten →Ws))))}

;; Distribute leftover-w across w: max children.
(%all (x-stack _* ¦ _ fractions: true leftover-w: W_number fr/sum_number)
      ⟨{¦ w: max fr_: (%number (whole _) > 0) max-w: (%- _ w)}⟩°)
  <> {w: ($ (// (* →W →fr) →fr/sum))}

;; NODE: y-stack
;;
;; The same as x-stack minus the occasional W<->H or L<->T swap. This can
;; be generalized, but will lead to unreadable, overly generic mess -- I tried.

(y-stack (%many Cws {¦ content-w: (%let 0 _number)}) ¦ _ content-w: (%- _ W)) <> {W: ($ (max (flatten →Cws)))}
(y-stack (%many Chs {¦ content-h: (%let 0 _number)}) ¦ _ content-h: (%- _ H) gap⋮ 0)
  <> {H: ($ (+ (sum (flatten →Chs)) (* →gap (- (tally →Chs) 1))))}
(%all (y-stack _+ ¦ _ w: content content-w: W_number) ⟨{¦ w: max max-w: (%- _ w)}⟩°) <> {w: →W}
(%all (y-stack _+ ¦ _ w: max max-w: W_number) ⟨{¦ w: max max-w: (%- _ w)}⟩°) <> {w: →W}
(%all (y-stack _+ ¦ _ l: L_number) ⟨{¦ -l_ }⟩°) <> {l: →L}
(y-stack {¦ -t_} _* ¦ _ t: T_number) <> {t: →T}
(%all (y-stack _* {¦ t: (%- _)} ¦ _ gap⋮ 0) ⟨{¦ t: t0_number final-h: h0_number} {¦ t: (%- _ t1)}⟩)
  <> {t1: ($once (+ →t0 →h0 →gap))}
(%all (y-stack _* ¦ _ fractions: true -leftover-h_ final-h: H_number) (%items Hs {¦ final-h: 0←_number} min: 0))
  <> {leftover-h: ($ (- →H (sum (flatten →Hs))))}
(%all (y-stack _* ¦ _ fractions: true leftover-h: H_number fr/sum_number)
      ⟨{¦ h: max fr_: (%number (whole _) > 0) max-h: (%- _ h)}⟩°)
  <> {h: ($ (// (* →H →fr) →fr/sum))}

;; Helper for both x-stack and y-stack.
(%all {¦ -fr/sum_ fractions: true} (%items Frs {¦ fr: 0←(%number (whole _) > 0)}))
  <> {fr/sum: ($ (sum (flatten →Frs)))}

;; NODE: z-stack

(z-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ content-w: (%- _ W))
  <> {W: ($ (max (flatten →Cws)))}
(z-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ content-h: (%- _ H))
  <> {H: ($ (max (flatten →Chs)))}

;; If z-stack is set to w/h: content, this means the children receive z-stack's
;; content-w/h as max-w/h.
(%all (z-stack _+ ¦ _ w: content content-w: W_number) ⟨{¦ max-w: (%- _ w)}⟩°) <> {w: →W}
(%all (z-stack _+ ¦ _ h: content content-h: H_number) ⟨{¦ max-h: (%- _ h)}⟩°) <> {h: →H}

;; If z-stack is set to w/h: max, this means the children receive z-stack's
;; max-w/h as max-w/h.
(%all (z-stack _+ ¦ _ w: max max-w: W_number) ⟨{¦ max-w: (%- _ w)}⟩°) <> {w: →W}
(%all (z-stack _+ ¦ _ h: max max-h: H_number) ⟨{¦ max-h: (%- _ h)}⟩°) <> {h: →H}

;; The children of z-stack all receive left/top of the z-stack.
(%all (z-stack _+ ¦ _ l: L_number) ⟨{¦ -l_}⟩°) <> {l: →L}
(%all (z-stack _+ ¦ _ t: T_number) ⟨{¦ -t_}⟩°) <> {t: →T}
