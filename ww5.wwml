--- model

;; This will be populated at runtime, but let's keep them for a reminder
;; that they exist.
terminal: {
  width: 80,
  height: 24,
}

focus: {
  targets: (input control-pane events-pane),
  index: 0,
}

help:
  (section "General"
    (table
      ("help" "Shows this message")
      ("rack" "Addresses the rack. Use `rack help` for help")))

states: {
  header: {},
  control-pane: {
    log: ((banner)),
    scroll: 0,
  },
  events-pane: {
    log: (),
    scroll: 0,
  },
  command-input: {
    model: (prompt () ("" (| multiline: true select: true modify: true prompt: true compose: true) "") ()),
    state: unlocked,
  },
}

;; A list of rack | {id: <console id>, window: _}
screens: (rack)
screen-index: 0

--- view

;;
;; Icons
;;

(icon ok) => "\ueab2"
(icon warning) =>  "\u{f06bd}"
(icon comment) => "\uf0e5"
(icon error) => "\uea87"
(icon note) => "\uf24a"
(icon rack) => "\u{eabe}"
(icon help) => "\u{f078b}"
(icon image) => "\uf03e"
(icon window) => "\ueb7f"
(icon ticker) => "\u{f051b}"
(icon file) => "\uf0c5"
(icon scroll-up) => "\uf102"
(icon scroll-dn) => "\uf103"
(icon checkmark) => "\uf05d"
(icon hourglass) => "\uf252"
(icon keyboard) => "\uf11c"
(icon circle-outline) => "\uf10c"
(icon circle) => "\uf111"
(icon screen) => "\uef8a"


;;
;; input-area
;;

;; Cursor.
(input-area [l_string [| _*] r_string])
  => (p ^(~ l r) selection-anchor: ^(charcount l) selection-span: 0)

;; Compose.
(input-area [compose m_string [| _*]])
  => (^match m
       (when "" (p " " style: "underline font-bold text-neutral-50"))
       (when _ (p ^m style: "underline font-bold text-neutral-50")))

;; Compose in cursor.
(input-area [l_string C←[compose _ [| _*]] r_string])
  => (group (p ^l) (input-area ^C) (p ^r) style: "flow-wrap")

;; Left and right-leaning selection.
(input-area [l_string [| _*] m_string r_string])
  => (p ^(~ l m r) selection-anchor: ^(charcount l) selection-span: ^(charcount m))
(input-area [l_string m_string [| _*] r_string])
  => (p ^(~ l m r) selection-anchor: ^(charcount l) selection-span: ^(charcount m))

;; TODO: use strikethrough.

;; Compose in left-leaning selection.
(input-area [l_string C←[compose _ [| _*]] m_string r_string])
  => (group (p ^l) (input-area ^C) (p ^m style: "italic text-red-500") (p ^r) style: "flow-wrap")
;; Compose in right-leaning selection.
(input-area [l_string m_string C←[compose _ [| _*]] r_string])
  => (group (p ^l) (p ^m style: "italic text-red-500") (input-area ^C) (p ^r) style: "flow-wrap")

;; Prompt.
(input-area [prompt (_*) current_ (_*)])
  => (input-area ^current)

;; Fallback.
(input-area model_)
  => (p ^\model)


;;
;; control-log-entry
;;

(control-log-entry (banner))
  => (group style: "flow-col border-l-sm border-neutral-600 text-neutral-400 px-1"
       (p (icon help) "Wirewright Rack" style: "text-neutral-400 font-bold gap-1")
       (p style: "pretty"
         "Rack is a general-purpose tool to make Wirewright subsystems talk to each other.
          • Hit Ctrl-C to quit.
          • Type `help` and `rack help` to learn more.
          • Use Tab and Shift-Tab to cycle through focus targets."))

(control-log-entry (thread command_string replies_*))
  => (group style: "flow-col gap-1"
       (group style: "gap-1 font-bold text-neutral-100"
         (p ">")
         (p ^command))
       (group style: "flow-col text-neutral-200"
         (^each (replies as reply_)
           (control-log-reply ^reply))))

;; Fallback.
(control-log-entry term_)
  => (p ^\term)


;;
;; control-log-reply
;;

(control-log-reply (error ⍊ title_ traceback⋮ () detail_))
  => (group style: "flow-col px-1 border-l-lg border-red-500"
       (p "\uea87" ^title style: "font-bold gap-1 text-red-300 upcase")
       (group style: "flow-col text-neutral-200"
         (^match traceback
           (when ()
             (p ^detail))
           (when _
             "Traceback:"
             (^each (traceback as entry_)
                (p "in" (p ^entry style: "font-bold text-neutral-100") style: "gap-1"))
             ^detail))))

(control-log-reply (help desc_*))
  => (control-log-help ^desc)

(control-log-reply (list items_*))
  => (group style: "flow-col"
       (^each (items as item_)
         (group style: "gap-1"
           (p "-" style: "text-neutral-600")
           (control-log-reply ^item))))

(control-log-reply (%'edge name_))
  => (p ^"@⸢name⸣" style: "text-blue-300")

(control-log-reply (device-at addr←(%number +i32) device_))
  => (group
       (p ^\addr style: "text-blue-300")
       (p "|" style: "text-neutral-500")
       (p ^\device style: "ml-1 text-neutral-300"))

(control-log-reply (device type_symbol ⍊ ±addr status_))
  => (group style: "gap-1"
       (p style: "gap-1"
         (icon ^type) ^\type (p ^\addr style: "font-bold"))
       (^match status
         (when none
           (p style: "text-neutral-600"
             (icon circle-outline)))
         (when _
           (p style: "text-neutral-600 status-active:text-green-500"
              status: ^status
             (icon circle)))))

;; Fallback.
(control-log-reply term_)
  => (p ^\term)


;;
;; control-log-help
;;

(control-log-help items_dict)
  => (group style: "flow-col gap-1"
       (^each (items as item_)
         (control-log-help ^item)))

(control-log-help (section title_string child_))
  => (group style: "flow-col"
       (p ^title style: "border-l border-blue-300 px-1 upcase text-blue-300")
       (group style: "px-2"
         (control-log-help ^child)))

;; I tried printing it as an actual table but that looks very bad, esp.
;; with longer commands or description.
(control-log-help (table commands_*))
  => (group style: "flow-col"
       (^each (commands as (command_string description_string))
         (p ^command style: "text-neutral-100 font-bold")
         (p ^description style: "text-neutral-300 ml-1")))

;; Fallback.
(control-log-help term_)
  => (p ^\term)


;;
;; control-log
;;

(control-log {¦ log_dict ±scroll})
  => (group style: "clip pan-b" pan-y: ^scroll
       (group style: "flow-col content-y items-content-y gap-1"
         (^each ((chunks log (group [thread _string] _)) as chunk_)
           (control-log-entry
             (^match chunk
               (when (chunk leader←[thread _string] followers_*)
                 ^(cat leader followers))
               (when (item entry_) ^entry))))))


;;
;; event-log-narration
;;

(narration-entry children_*)
  => (p style: "text-neutral-300 flow-wrap"
       (^each (children as child_)
         (^match child
           (when _string (^* (wordwise child)))
           (when _ ^child))))

(event-log-narration (rack activated path_string))
  => (narration-entry (icon rack) " Rack " (p ^path style: "underline") " is currently active.")

(event-log-narration (rack deactivated path_string))
  => (narration-entry (icon rack) " Deactivated rack " (p ^path style: "underline") ".")

(event-log-narration (window open addr_))
  => (narration-entry (icon window) ^" Window owned by device#⸢addr⸣ is now open.")

(event-log-narration (window closed addr_))
  => (narration-entry (icon window) ^" Window owned by device#⸢addr⸣ is now closed.")

(event-log-narration (console open addr_))
  => (narration-entry (icon screen) ^" Console owned by device#⸢addr⸣ is now open on screen ⸢addr⸣. Use Ctrl-P to cycle backward and Ctrl-N to cycle forward through screens.")

(event-log-narration (console closed addr_))
  => (narration-entry (icon screen) ^" Console owned by device#⸢addr⸣ is now closed.")

(event-log-narration (file pending addr_ path_string))
  => (narration-entry (icon file) " File " (p ^path style: "underline") " is pending, as requested by device#" ^\addr ".")

(event-log-narration (file loaded addr_ path_string))
  => (narration-entry (icon file) " File " (p ^path style: "underline") " was loaded successfully, as requested by device#" ^\addr ".")

(event-log-narration (file reloaded addr_ path_string))
  => (narration-entry (icon file) " File " (p ^path style: "underline") ", owned by device#" ^\addr ", was reloaded due to changes on disk.")

(event-log-narration (file unloaded _ path_string))
  => (narration-entry (icon file) " File " (p ^path style: "underline") " was unloaded.")

(event-log-narration (ticker running addr_))
  => (narration-entry (icon ticker) ^" Ticker device#⸢addr⸣ is running.")

(event-log-narration (ticker not-running addr_))
  => (narration-entry (icon ticker) ^" Ticker device#⸢addr⸣ is not running anymore.")

(event-log-narration (image drawing addr_ path_string))
  => (narration-entry (icon image) " Image " (p ^path style: "underline") " is being drawn, as requested by device#" ^\addr ".")

(event-log-narration (image drawn addr_ path_string))
  => (narration-entry (icon image) " Image " (p ^path style: "underline") " was successfully drawn, as requested by device#" ^\addr ".")


;;
;; event-log-entry
;;

(log-print-card ⍊ icon_ title_string body_string accent_)
  => (group style: "border-l-sm border-{accent}-500 px-1 flow-col" accent: ^accent
       (p ^icon ^title style: "font-bold text-{accent}-400 flow-row gap-1" accent: ^accent)
       (p ^body style: "text-neutral-300"))

(event-log-entry (comment body_string))
  => (p (icon comment) ^body style: "text-neutral-300 flow-row gap-1")

(event-log-entry (note body_string))
  => (log-print-card icon: (icon note) title: "NOTE" body: ^body accent: blue)

(event-log-entry (warning body_string))
  => (log-print-card icon: (icon warning) title: "WARNING" body: ^body accent: orange)

(event-log-entry (error body_string))
  => (log-print-card icon: (icon error) title: "ERROR" body: ^body accent: red)

(log-error-card title_string ¦ rest_ severity⋮ major ±addr detail_string)
  => (group style: "border-l-sm border-red-500 severity-minor:border-orange-500 severity-note:border-blue-500 px-1 flow-col gap-1 text-neutral-400" severity: ^severity
       (p (icon error) ^"⸢title⸣ in device#⸢addr⸣" style: "font-bold text-red-400 severity-minor:text-orange-400 severity-note:text-blue-400 flow-row gap-1" severity: ^severity)
       (group style: "flow-col"
         (^match severity
           (when minor (p "* This issue's severity is `minor`, meaning it may be a false positive."))
           (when note (p "* This issue's severity is `note`, meaning it is a comment about the algorithm's decision of some kind.")))
         ;; File module.
         (^match rest
           ;; Print path, line, and column, if they are all available.
           (when {¦ path_string ±line ±column}
             (p style: "flow-wrap gap-x-1"
               "In file"
               (p ^path ":" ^\line ":" ^\column style: "flow-row underline font-bold text-neutral-200")))
            ;; Print path if only path is available.
           (when {¦ path_string}
             (p style: "flow-wrap gap-x-1"
               "In file"
               (p ^path style: "flow-row underline font-bold text-neutral-200"))))
         ;; Code module: print code if available.
         (^match' (rest {¦ code_string})
           (p ^code style: "pretty px-2 py-1 mt-1 (first):mt-0 bg-neutral-950")))
       (p ^detail style: "text-neutral-300 capitalize"))

(event-log-entry (error ml ¦ rest_)) => (log-error-card "Syntax error" ^… rest)
(event-log-entry (error microfold ¦ rest_)) => (log-error-card "Microfold issue" ^… rest)
(event-log-entry (error alloy ¦ rest_)) => (log-error-card "Alloy issue" ^… rest)
(event-log-entry (error source ¦ rest_)) => (log-error-card "Source error" ^… rest)
(event-log-entry (error ticker ¦ rest_)) => (log-error-card "Ticker error" ^… rest)
(event-log-entry (error image ¦ rest_)) => (log-error-card "Image error" ^… rest)

;; Fallback
(event-log-entry term_)
  => (p ^\term)


;;
;; event-log
;;

(event-log-narration-chunk narrations_*)
  => (group style: "border-l-sm border-neutral-600 flow-col px-1"
       (^each (narrations as (narration N_))
         (event-log-narration ^N)))

(event-log {¦ log_dict ±scroll})
  => (group style: "clip pan-b" pan-y: ^scroll
       (group style: "flow-col content-y items-content-y"
         (^each ((chunks log (pattern [narration _])) as chunk_)
           (^match chunk
             (when (chunk children_*)
               (event-log-narration-chunk ^*children))
             (when (item entry_)
               (event-log-entry ^entry))))))

;;
;; main
;;

(pane title_string content_)
  => (group style: "flow-col border-xs rounded border-neutral-800 in-focused:border-green-900"
       (p ^title style: "z-10 floating-y -dt-1 center text-neutral-400 font-bold bg-neutral-800 in-focused:bg-green-900 in-focused:text-green-100 upcase px-1")
       (group style: "fr px-2"
         ^content))

(prompt model_)
  => (group style: "membrane in-focused:cue-active"
       (group style: "border-xs border-neutral-700 in-active:border-green-700 gap-2 px-2 rounded"
         (p ">" style: "text-neutral-700 in-active:text-green-600 font-bold")
         (group style: "fr text-neutral-400 in-active:text-neutral-100 in-active:selection selection-text-neutral-300 selection-neutral-800 in-active:selection-green-900 in-active:selection-text-white"
           (input-area ^model))))

(command-input {¦ state: unlocked model_ })
  => (prompt ^model)

(command-input {¦ state: locked})
  => (p style: "px-2 py-1 bg-neutral-800 text-neutral-300 font-bold content-center gap-1"
       (icon hourglass) "Input is locked while the rack responds...")

(header-status info_dict)
  => (group style: "gap-1 membrane has-loaded:cue-loaded"
       (p (icon checkmark) style: "px-1 text-green-950 bg-green-300 absent in-loaded:present cue-loaded:in-busy:absent")
       (p (icon hourglass) style: "px-1 text-orange-950 bg-orange-300 absent in-loaded:in-busy:present")
       (p (icon warning) style: "px-1 font-bold text-red-950 bg-red-500 present in-loaded:absent")
       (^match info
         (when {¦ rackpath_string}
           (p ^rackpath style: "is-loaded text-neutral-300"))
         (when _
           (p "Rack not loaded" style: "upcase font-bold text-red-300"))))

(header info_dict)
  => (group style: "bg-neutral-800"
       (header-status ^info)
       (group style: "fr content-r clip items-content-x"
         (header-device-brief ^info)))

(header-device-brief info_dict)
  => (group
       (header-windows-brief ^info)
       (header-files-brief ^info))

(header-badge icon_ caption_ ¦ props_)
  => (group style: "flow-row gap-1 text-neutral-400 highlight:font-bold highlight:text-neutral-100 px-1"
       (p ^icon)
       (p ^caption)
       ^… props)

(files-badge ±n ¦ props_)
  => (header-badge (icon file) ^"⸢n⸣ file(s)" ^… props)

(header-item item_)
  => (^splice (p "|" style: "present (first):absent") ^item)

(header-windows-brief {¦ agents: {¦ windows: (%entry° ±addr status←(%any open closed))}})
  => (header-item (header-badge (icon window) ^\addr highlight: ^(= status open)))

(header-files-brief {¦ agents: {¦ files_}})
  => (header-item (files-badge ^(tally files) highlight: true))

(sep-list separator_ data_*)
  => (group
       (^each (data item as (datum_ index_))
          (group
            (^if (> index 0)
              ^separator)
            ^datum)))

(main target_ states_ ⍊ layout⋮ vertical)
  => (group style: "gap-1 flow-col layout-horizontal:flow-row fr" layout: ^layout
       (group style: "fr-6 focused:cue-focused" focused: ^(= target (literal events-pane))
         (pane "Events"
           (event-log (^. states events-pane))))
       (group style: "fr-7 focused:cue-focused" focused: ^(= target (literal control-pane))
         (pane "Control"
           (group style: "flow-col gap-1"
             (group style: "fr"
               (control-log (^. states control-pane)))
             (group style: "membrane focused:cue-focused" focused: ^(= target (literal input))
               (command-input (^. states command-input)))))))

(hint-card ⍊ title_string description_string keys_dict)
  => (group style: "flow-col text-neutral-200"
       (p (icon help) ^title style: "font-bold text-neutral-100 gap-1")
       (p ^description)
       (p (icon keyboard) "Keys" style: "mt-1 gap-1")
       (^each (keys as (key_string action_string))
         (p "- Use " (p ^key style: "underline") " to " ^(downcase action) style: "flow-wrap")))

(hint-for events-pane)
  => (hint-card
       title: "Events pane"
       description: "This pane shows events and narrations coming from the Rack Server process."
       keys:
        (("Up Arrow" "Scroll up")
         ("Down Arrow" "Scroll down")
         ("Page Dn" "Scroll to bottom")
         ("Backspace" "Clear")))

(hint-for control-pane)
  => (hint-card
       title: "Control pane"
       description: "This pane shows the commands you've entered and Rack's replies to them."
       keys:
        (("Up Arrow" "Scroll up")
         ("Down Arrow" "Scroll down")
         ("Page Dn" "Scroll to bottom")
         ("Backspace" "Clear")))

(tab caption_string ⍊ icon_⋮ (icon screen) active⋮ false)
  => (p ^icon ^caption style: "gap-1 px-1 text-neutral-500 active:text-neutral-300 active:bg-neutral-900" active: ^active)

(screen-tab rack ⍊ active⋮ false)
  => (tab "Rack" icon: (icon rack) active: ^active)

(screen-tab {¦ id_ window: {¦ title_string}} ⍊ active⋮ false)
  => (tab ^"⸢title⸣ [⸢id⸣]" active: ^active)

(screen-tab {¦ id_} ⍊ active⋮ false)
  => (tab ^\id active: ^active)

(window style: "root backdrop-neutral-950 clip flow-col z-scope"
        width: (^. terminal width)
        height: (^. terminal height)
  (group style: "flow-row items-content-x clip-x"
    (^each (screens item as (screen_ index_))
      (^let active: (= index screen-index)
        (screen-tab ^screen active: ^active))))
  (group style: "flow-col fr bg-neutral-900 sized" sized-id: viewport
    (^let screen: (value? screens screen-index)
      (^match screen
        (when (some rack)
          (^match' (focus {¦ ±index targets_dict})
            (^let target: (part targets (key index default: (literal none)))
              (group style: "flow-col gap-1 px-2 pt-1 fr"
                (header (^. states header))
                (group style: "fr flow-col"
                  (^match terminal
                    (when {¦ width: (%number _ < 120)}
                      (main ^target ^states layout: vertical))
                    (when _
                      ;; Show hint for all but input, show hint only if enough space
                      ;; is available.
                      (^unless (= target input)
                        (group style: "floating-y content-r -dt-3 dl-2 z-1"
                          (group style: "max-w-2xl bg-neutral-700 border-r-3xl border-neutral-600 px-2 py-1"
                            (hint-for ^target))))
                      (group style: "fr"
                        (main ^target ^states layout: horizontal)))))))))
        (when (some {¦ window: (window body_* ⍊ backdrop_⋮ black)})
          (group style: "bg-[backdrop]" backdrop: ^backdrop
            (guard allow: {+ dwuir}
              ^*body)))
        (when none
          (group style: "flow-col center max-w-2xl"
            (p "Closed" style: "text-neutral-200")
              (p style: "flow-wrap text-neutral-400"
                (^* (wordwise "This screen is closed. Press "))
                (p "Escape" style: "font-bold text-green-300")
                (^* (wordwise " to go to the Rack screen.")))))))))


