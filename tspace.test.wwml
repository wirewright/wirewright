;; Type-sensors
(group
  (tspace
    (conn A
      (after added sensor Sany x_)
      (after added sensor Snum x_number)
      (after added sensor Sstr x_string)
      (after added sensor Ssym x_symbol)
      (after added sensor Sbool x_boolean)
      (after added sensor Sdict x_dict))
    (conn B
      (after added appearance Anum 100)
      (after added appearance Astr "hello world")
      (after added appearance Asym qux)
      (after added appearance Atrue true)
      (after added appearance Afalse false)
      (after added appearance Aempty {})
      (after added appearance Aitemsonly (+ a b))
      (after added appearance Apairsonly {x: 100, y: 200})
      (after added appearance Adict (+ 1 2 x: 100 y: 200)))
    (conn A
      (view
        {Sany: {# {x: 100} {x: "hello world"} {x: qux} {x: true} {x: false} {x: {}} {x: (+ a b)} {x: {x: 100, y: 200}} {x: (+ 1 2 x: 100 y: 200)}}
         Snum: {# {x: 100}}
         Sstr: {# {x: "hello world"}}
         Ssym: {# {x: qux}}
         Sbool: {# {x: true} {x: false}}
         Sdict: {# {x: {}} {x: (+ a b)} {x: {x: 100, y: 200}} {x: (+ 1 2 x: 100 y: 200)}}})))
  (tspace
    (conn B
      (after added appearance Anum 100)
      (after added appearance Astr "hello world")
      (after added appearance Asym qux)
      (after added appearance Atrue true)
      (after added appearance Afalse false)
      (after added appearance Aempty {})
      (after added appearance Aitemsonly (+ a b))
      (after added appearance Apairsonly {x: 100, y: 200})
      (after added appearance Adict (+ 1 2 x: 100 y: 200)))
    (conn A
      (after added sensor Sany x_)
      (after added sensor Snum x_number)
      (after added sensor Sstr x_string)
      (after added sensor Ssym x_symbol)
      (after added sensor Sbool x_boolean)
      (after added sensor Sdict x_dict))
    (conn A
      (view
        {Sany: {# {x: 100} {x: "hello world"} {x: qux} {x: true} {x: false} {x: {}} {x: (+ a b)} {x: {x: 100, y: 200}} {x: (+ 1 2 x: 100 y: 200)}}
         Snum: {# {x: 100}}
         Sstr: {# {x: "hello world"}}
         Ssym: {# {x: qux}}
         Sbool: {# {x: true} {x: false}}
         Sdict: {# {x: {}} {x: (+ a b)} {x: {x: 100, y: 200}} {x: (+ 1 2 x: 100 y: 200)}}}))))

;; TODO: %any of dicts, %literal dict!!!!

;; Basics: binary order does not matter
(group
  (tspace
    (conn A
      (after added sensor Sa foo_)
      (after added appearance Aa 100)
      (view {Sa: {# {foo: 100}}})))

  (tspace
    (conn A
      (after added appearance Aa 100)
      (after added sensor Sa foo_)
      (view {Sa: {# {foo: 100}}})))

  (tspace
    (conn A
      (after added sensor Sa foo_))
    (conn B
      (after added appearance Aa 100))
    (conn A
      (view {Sa: {# {foo: 100}}})))

  (tspace
    (conn B
      (after added appearance Aa 100))
    (conn A
      (after added sensor Sa foo_))
    (conn A
      (view {Sa: {# {foo: 100}}}))))

;; Basic literal disjunction
(group
  (tspace
    (conn A
      (after added appearance Aa 100)
      (after added appearance Ab 200)
      (after added appearance Ac 300)
      (after added sensor Sa n←(%any 100 300))
      (view {Sa: {# {n: 100} {n: 300}}})
      (after added appearance Ac 400)
      (view {Sa: {# {n: 100}}})))
  (tspace
    (conn A
      (after added sensor Sa n←(%any 100 300))
      (view {})
      (after added appearance Aa 100)
      (after added appearance Ab 200)
      (after added appearance Ac 300)
      (view {Sa: {# {n: 100} {n: 300}}})
      (after added appearance Ac 400)
      (view {Sa: {# {n: 100}}}))))

;; Basic conjunctions
(tspace
  (conn A
    (after added sensor Sa (pixel x_ 0))
    (after added sensor Sb (pixel 0 y_))
    (view {})
    (after added appearance Aa (qux 0 0))
    (view {})
    (after added appearance Ab (pixel 0 0))
    (view {Sa: {# {x: 0}}, Sb: {# {y: 0}}})
    (after added appearance Aa (pixel 100 0))
    (view {Sa: {# {x: 0} {x: 100}}, Sb: {# {y: 0}}})
    (after added appearance Aa (pixel 0 200))
    (view {Sa: {# {x: 0}}, Sb: {# {y: 0} {y: 200}}})
    (after added appearance Ab (pixel 100 0))
    (view {Sa: {# {x: 100}}, Sb: {# {y: 200}}})
    (after removed Aa)
    (view {Sa: {# {x: 100}}})
    (after removed Ab)
    (view {})))

;; Basic sensor & appearance removal, order independence thereof
(group
  ;; Appearances first
  (tspace
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn B
      (view {})
      (after added sensor Sa {¦ x: x_})
      (view {Sa: {# {x: 1} {x: a} {x: "qux"}}})
      (after added sensor Sb {¦ x: x_, y: y_})
      (view {Sa: {# {x: 1} {x: a} {x: "qux"}}
             Sb: {# {x: a, y: b} {x: "qux", y: 100}}})
      (after added sensor Sc {¦ x: x_, y: y_, z: z_})
      (view {Sa: {# {x: 1} {x: a} {x: "qux"}}
             Sb: {# {x: a, y: b} {x: "qux", y: 100}}
             Sc: {# {x: "qux", y: 100, z: true}}})))

  ;; Sensors first
  (tspace
    (conn B
      (after added sensor Sa {¦ x: x_})
      (after added sensor Sb {¦ x: x_, y: y_})
      (after added sensor Sc {¦ x: x_, y: y_, z: z_}))
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn B
      (view {Sa: {# {x: 1} {x: a} {x: "qux"}}
             Sb: {# {x: a, y: b} {x: "qux", y: 100}}
             Sc: {# {x: "qux", y: 100, z: true}}})))

  ;; Remove sensors, loosest to tightest
  (tspace
    (conn B
      (after added sensor Sa {¦ x: x_})
      (after added sensor Sb {¦ x: x_, y: y_})
      (after added sensor Sc {¦ x: x_, y: y_, z: z_}))
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn B
      (after removed Sa)
      (view {Sb: {# {x: a, y: b} {x: "qux", y: 100}}
             Sc: {# {x: "qux", y: 100, z: true}}})
      (after removed Sb)
      (view {Sc: {# {x: "qux", y: 100, z: true}}})
      (after removed Sc)
      (view {})))

  ;; Remove sensors, tightest to loosest
  (tspace
    (conn B
      (after added sensor Sa {¦ x: x_})
      (after added sensor Sb {¦ x: x_, y: y_})
      (after added sensor Sc {¦ x: x_, y: y_, z: z_}))
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn B
      (after removed Sc)
      (view {Sa: {# {x: 1} {x: a} {x: "qux"}}
             Sb: {# {x: a, y: b} {x: "qux", y: 100}}})
      (after removed Sb)
      (view {Sa: {# {x: 1} {x: a} {x: "qux"}}})
      (after removed Sa)
      (view {})))

  ;; Remove sensors, mixed
  (tspace
    (conn B
      (after added sensor Sa {¦ x: x_})
      (after added sensor Sb {¦ x: x_, y: y_})
      (after added sensor Sc {¦ x: x_, y: y_, z: z_}))
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn B
      (after removed Sc)
      (view {Sa: {# {x: 1} {x: a} {x: "qux"}}
             Sb: {# {x: a, y: b} {x: "qux", y: 100}}})
      (after removed Sa)
      (view {Sb: {# {x: a, y: b} {x: "qux", y: 100}}})
      (after removed Sb)
      (view {})))

  ;; Remove appearances, loosest to tightest
  (tspace
    (conn B
      (after added sensor Sa {¦ x: x_})
      (after added sensor Sb {¦ x: x_, y: y_})
      (after added sensor Sc {¦ x: x_, y: y_, z: z_}))
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn A
      (after removed Ad)
      (after removed Ae))
    (conn B
      (view {Sa: {# {x: 1} {x: a} {x: "qux"}}
             Sb: {# {x: a, y: b} {x: "qux", y: 100}}
             Sc: {# {x: "qux", y: 100, z: true}}}))
    (conn A (after removed Aa))
    (conn B
      (view {Sa: {# {x: a} {x: "qux"}}
             Sb: {# {x: a, y: b} {x: "qux", y: 100}}
             Sc: {# {x: "qux", y: 100, z: true}}}))
    (conn A (after removed Ab))
    (conn B
      (view {Sa: {# {x: "qux"}}
             Sb: {# {x: "qux", y: 100}}
             Sc: {# {x: "qux", y: 100, z: true}}}))
    (conn A (after removed Ac))
    (conn B
      (view {})))

  ;; Remove appearances, tightest to loosest
  (tspace
    (conn B
      (after added sensor Sa {¦ x: x_})
      (after added sensor Sb {¦ x: x_, y: y_})
      (after added sensor Sc {¦ x: x_, y: y_, z: z_}))
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn A (after removed Ac))
    (conn B
      (view {Sa: {# {x: 1} {x: a}}
             Sb: {# {x: a, y: b}}}))
    (conn A (after removed Ab))
    (conn B
      (view {Sa: {# {x: 1}}}))
    (conn A
      (after removed Ae)
      (after removed Ad))
    (conn B
      (view {Sa: {# {x: 1}}}))
    (conn A
      (after removed Aa))
    (conn B
      (view {})))

  ;; Remove appearances, mixed
  (tspace
    (conn B
      (after added sensor Sa {¦ x: x_})
      (after added sensor Sb {¦ x: x_, y: y_})
      (after added sensor Sc {¦ x: x_, y: y_, z: z_}))
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn A (after removed Ad))
    (conn B
      (view {Sa: {# {x: 1} {x: a} {x: "qux"}}
             Sb: {# {x: a, y: b} {x: "qux", y: 100}}
             Sc: {# {x: "qux", y: 100, z: true}}}))
    (conn A (after removed Ac))
    (conn B
      (view {Sa: {# {x: 1} {x: a}}
             Sb: {# {x: a, y: b}}}))
    (conn A (after removed Ae))
    (conn B
      (view {Sa: {# {x: 1} {x: a}}
             Sb: {# {x: a, y: b}}}))
    (conn A (after removed Aa))
    (conn B
      (view {Sa: {# {x: a}}
             Sb: {# {x: a, y: b}}}))
    (conn A (after removed Ab))
    (conn B
      (view {}))))

;; Similarly, but pattern is closed
(group
  ;; Appearances first
  (tspace
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn B
      (view {})
      (after added sensor Sa {x: x_})
      (view {Sa: {# {x: 1}}})
      (after added sensor Sb {x: x_, y: y_})
      (view {Sa: {# {x: 1}}
             Sb: {# {x: a, y: b}}})
      (after added sensor Sc {x: x_, y: y_, z: z_})
      (view {Sa: {# {x: 1}}
             Sb: {# {x: a, y: b}}
             Sc: {# {x: "qux", y: 100, z: true}}})))

  ;; Sensors first
  (tspace
    (conn B
      (after added sensor Sa {x: x_})
      (after added sensor Sb {x: x_, y: y_})
      (after added sensor Sc {x: x_, y: y_, z: z_}))
    (conn A
      (after added appearance Aa {x: 1})
      (after added appearance Ab {x: a, y: b})
      (after added appearance Ac {x: "qux", y: 100, z: true})
      (after added appearance Ad {})
      (after added appearance Ae {qux: 100}))
    (conn B
      (view {Sa: {# {x: 1}}
             Sb: {# {x: a, y: b}}
             Sc: {# {x: "qux", y: 100, z: true}}}))))

;; Empty dict handling
(group
  ;; Empty dict sensor, closed
  (tspace
    (conn A
      (after added sensor Sa D←{}))
    (conn B
      (after added appearance Aa {})
      (after added appearance Ab {x: 100})
      (after added appearance Ac {x: 100, y: 200})
      (after added appearance Ad (+ 1 2 x: 100, y: 200))
      (after added appearance Ae 100))
    (conn A
      (view {Sa: {# {D: {}}}}))
    (conn B
      (after removed Ae)
      (after removed Ad)
      (after removed Ac)
      (after removed Ab))
    (conn A
      (view {Sa: {# {D: {}}}}))
    (conn B
      (after removed Aa))
    (conn A
      (view {})))

  ;; Empty dict sensor, open
  (tspace
    (conn A
      (after added sensor Sa D_dict))
    (conn B
      (after added appearance Aa {})
      (after added appearance Ab {x: 100})
      (after added appearance Ac {x: 100, y: 200})
      (after added appearance Ad (+ 1 2 x: 100, y: 200))
      (after added appearance Ae 100))
    (conn A
      (view {Sa: {# {D: {}}
                    {D: {x: 100}}
                    {D: {x: 100, y: 200}}
                    {D: (+ 1 2 x: 100 y: 200)}}}))
    (conn B (after removed Ae))
    (conn A
      (view {Sa: {# {D: {}}
                    {D: {x: 100}}
                    {D: {x: 100, y: 200}}
                    {D: (+ 1 2 x: 100 y: 200)}}}))
    (conn B (after removed Ad))
    (conn A
      (view {Sa: {# {D: {}}
                    {D: {x: 100}}
                    {D: {x: 100, y: 200}}}}))
    (conn B (after removed Ac))
    (conn A
      (view {Sa: {# {D: {}}
                    {D: {x: 100}}}}))
    (conn B (after removed Ab))
    (conn A
      (view {Sa: {# {D: {}}}}))
    (conn B (after removed Aa))
    (conn A
      (view {})))

  ;; Nested empty dict sensor, open and closed
  (tspace
    (conn A
      (after added sensor Sa ({} {}))
      (after added sensor Sb (a_dict {}))
      (after added sensor Sc ({} b_dict))
      (after added sensor Sd (a_dict b_dict)))
    (conn B
      (after added appearance Aa ({} {}))
      (after added appearance Ab ({x: 100} {}))
      (after added appearance Ac ({} {y: 200}))
      (after added appearance Ad ({x: a} {y: b})))
    (conn A
      (view {Sa: {# {}}
             Sb: {# {a: {}} {a: {x: 100}}}
             Sc: {# {b: {}} {b: {y: 200}}}
             Sd: {# {a: {}, b: {}}
                    {a: {x: 100}, b: {}}
                    {a: {}, b: {y: 200}}
                    {a: {x: a}, b: {y: b}}}}))
    (conn B
      (after removed Aa))
    (conn A
      (view {Sb: {# {a: {x: 100}}}
             Sc: {# {b: {y: 200}}}
             Sd: {# {a: {x: 100}, b: {}}
                    {a: {}, b: {y: 200}}
                    {a: {x: a}, b: {y: b}}}}))
    (conn B
      (after removed Ad))
    (conn A
      (view {Sb: {# {a: {x: 100}}}
             Sc: {# {b: {y: 200}}}
             Sd: {# {a: {x: 100}, b: {}}
                    {a: {}, b: {y: 200}}}}))
    (conn B
      (after removed Ac))
    (conn A
      (view {Sb: {# {a: {x: 100}}}
             Sd: {# {a: {x: 100}, b: {}}}}))
    (conn B
      (after removed Ab))
    (conn A
      (view {}))))

;; Test empty dict nested
;; Gosh it's a lot of parentheses ...
(tspace
  (conn A
    (after added sensor Sa m←())
    (after added sensor Sb m←())
    (after added sensor Sc m←(()))
    (after added sensor Sd m←((())))
    (view ()))
  (conn B
    (after added appearance Aa ())
    (after added appearance Ab (()))
    (after added appearance Ac ((())))
    (after added appearance Ad ())
    (after added appearance Ae (((())))))
  (conn A
    (view {Sa: {# {m: ()} {m: ()}},
           Sb: {# {m: ()} {m: ()}},
           Sc: {# {m: (())}},
           Sd: {# {m: ((()))}}})
    (after added sensor Se m←(((()))))
    (view {Sa: {# {m: ()} {m: ()}},
           Sb: {# {m: ()} {m: ()}},
           Sc: {# {m: (())}},
           Sd: {# {m: ((()))}},
           Se: {# {m: (((())))}}}))
  (conn B
    (after removed Aa))
  (conn A
    (view {Sa: {# {m: ()}},
           Sb: {# {m: ()}},
           Sc: {# {m: (())}},
           Sd: {# {m: ((()))}},
           Se: {# {m: (((())))}}}))
  (conn B
    (after removed Ab))
  (conn A
    (view {Sa: {# {m: ()}},
           Sb: {# {m: ()}},
           Sd: {# {m: ((()))}},
           Se: {# {m: (((())))}}})
    (after removed Se)
    (view {Sa: {# {m: ()}},
           Sb: {# {m: ()}},
           Sd: {# {m: ((()))}}}))
  (conn B
    (after removed Ae))
  (conn A
    (view {Sa: {# {m: ()}},
           Sb: {# {m: ()}},
           Sd: {# {m: ((()))}}}))
  (conn B
    (after removed Ac))
  (conn A
    (view {Sa: {# {m: ()}},
           Sb: {# {m: ()}}})
    (after removed Sa)
    (view {Sb: {# {m: ()}}}))
  (conn B
    (after removed Ad))
  (conn A
    (view ())))

(tspace
  (conn A
    (after added sensor a n_number)
    (view {})
    (after added appearance x 100)
    (view {a: {# {n: 100}}})
    (after added appearance y 200)
    (view {a: {# {n: 100} {n: 200}}})
    (after removed x)
    (view {a: {# {n: 200}}})
    (after removed y)
    (view {})))

;; Multiple distinct appearances with the same value
(tspace
  (conn A
    (after added sensor a n_number)
    (view {})
    (after added appearance x 100)
    (view {a: {# {n: 100}}})
    (after added appearance y 100)
    (view {a: {# {n: 100} {n: 100}}}))
  (conn B
    (after added appearance foo 200)
    (after added appearance bar 200))
  (conn A (view {a: {# {n: 100} {n: 100} {n: 200} {n: 200}}}))
  (conn B (after removed foo))
  (conn A (view {a: {# {n: 100} {n: 100} {n: 200}}}))
  (conn A
    (after removed y)
    (view {a: {# {n: 100} {n: 200}}}))
  (conn B (after removed bar))
  (conn A
    (view {a: {# {n: 100}}})
    (after removed a)
    (view {}))
  (conn B
    (after added sensor foo x_number)
    (view {foo: {# {x: 100}}}))
  (conn A (after removed x))
  (conn B (view {})))

;; Sensor & appearance interaction with secret

(tspace
  ;; Alice adds two sensors: one with a secret (a) and one without (b).
  (conn A
    (after added sensor a x_number secret: "passw0rd")
    (after added sensor b y_number)
    (view ()))
  ;; Bob adds an appearance, foo, with secret that matches Alice's `a`.
  (conn B
    (after added appearance foo 100 secret: "passw0rd"))
  ;; Alice is now aware of Bob's appearance foo.
  (conn A
    (view {a: {# {x: 100}}}))
  ;; Bob adds another appearance, bar, with a different secret.
  (conn B
    (after added appearance bar 200 secret: "strong and secure"))
  ;; Alice doesn't see anything. She continues to see just Bob's
  ;; `foo` appearance.
  (conn A
    (view {a: {# {x: 100}}}))
  ;; Bob can change his `foo` appearance. While the secret is intact,
  ;; Alice will try to be in sync.
  (conn B
    (after added appearance foo 1.234 secret: "passw0rd"))
  (conn A
    (view {a: {# {x: 1.234}}}))
  ;; Bob adds a third appearance, `baz`, without a secret.
  (conn B
    (after added appearance baz 300))
  ;; Alice has one sensor, `b`, capable of receiving secret-less number.
  ;; Alice is now aware of Bob's appearance `baz`.
  (conn A
    (view {a: {# {x: 1.234}}, b: {# {y: 300}}}))
  ;; Alice changes her `b` sensor's secret from nothing to "strong and secure".
  ;; This is the secret that Bob used on his appearance `bar` above. Alice is
  ;; now aware of that appearance instead of the public one through her `b` sensor.
  (conn A
    (after added sensor b y_number secret: "strong and secure")
    (view {a: {# {x: 1.234}}, b: {# {y: 200}}}))
  ;; Bob changes his `bar` appearance to a different secret.
  (conn B
    (after added appearance bar 1/2 secret: "something else"))
  ;; Alice loses track of it because now her `b` sensor does not know
  ;; the correct secret.
  (conn A
    (view {a: {# {x: 1.234}}}))
  ;; Bob changes the secret of his `bar` appearance yet again. It is now
  ;; passw0rd, which matches Alice's `a` but not `b` sensor.
  (conn B
    (after added appearance bar 1/2 secret: "passw0rd"))
  (conn A
    (view {a: {# {x: 1.234} {x: 1/2}}}))
  ;; Alice removes the secret from her `b` sensor. Now she again sees Bob's
  ;; secret-less baz appearance with it.
  (conn A
    (after added sensor b y_number)
    (view {a: {# {x: 1.234} {x: 1/2}}, b: {# {y: 300}}}))
  ;; Bob removes the secret from his appearance `bar`. Now Alice's
  ;; secret-less `b` sensor can see it.
  (conn B
    (after added appearance bar 12345))
  (conn A
    (view {a: {# {x: 1.234}}, b: {# {y: 300} {y: 12345}}}))
  ;; Bob removes his baz appearance. Alice is aware.
  (conn B
    (after removed baz))
  (conn A
    (view {a: {# {x: 1.234}}, b: {# {y: 12345}}}))
  ;; Alice removes her `a` sensor.
  (conn A
    (after removed a)
    (view {b: {# {y: 12345}}}))
  ;; Bob changes his foo appearance to see if Alice responds. She shouldn't.
  (conn B
    (after added appearance foo 112233 secret: "passw0rd"))
  (conn A
    (view {b: {# {y: 12345}}}))
  ;; Bob removes his appearance `foo`. Alice doesn't react.
  (conn B
    (after removed foo))
  (conn A
    (view {b: {# {y: 12345}}}))
  ;; Bob removes his appearance `bar`. Alice's view becomes empty. There are
  ;; now no appearances, and Alice only has her sensor `b`.
  (conn B
    (after removed bar))
  (conn A
    (view ())))
