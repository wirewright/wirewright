;; +
(group
  ;; Basic
  (ni= (+) 0)
  (ni= (+ 2) 2)
  (ni= (+ 2 2) 4)
  (ni= (+ 1 2 3) 6)
  (ni= (+ a) 0)
  (ni= (+ a b c) 0)
  (ni= (+ a 1 b c) 1)
  (ni= (+ a 1 b 2 3 c) 6)

  ;; Frac
  (ni= (+ 1/3 2/3) 1)
  (ni= (+ -1/3 2/3) 1/3)
  (ni= (+ 0.1 0.2) 0.3)

  ;; Approx
  (ni= (+ ≈0.1 ≈0.2) ≈0.3)

  ;; Infinity
  (ni= (+ ∞ 100) ∞)
  (ni= (+ 100 ∞) ∞)
  (ni= (+ ∞ ∞) ∞)

  ;; Negative infinity
  (ni= (+ -∞ 100) -∞)
  (ni= (+ 100 -∞) -∞)
  (ni= (+ -∞ -∞) -∞)

  ;; Indet
  (ni= (+ ∞ -∞) indet)
  (ni= (+ -∞ ∞) indet)
  (ni= (+ indet 100) indet)
  (ni= (+ -∞ indet) indet)
  (ni= (+ indet indet) indet)

  ;; Symbolic, more arguments
  (ni= (+ 1 2 3 ∞) ∞)
  (ni= (+ 1 2 -∞ 3) -∞)
  (ni= (+ indet 1 2 -∞ 3) indet)
  (ni= (+ ∞ 1 2 -∞ 3) indet))

;; -
(group
  ;; Basic
  (ni= (-) 0)
  (ni= (- 1) -1) ;; negate
  (ni= (- 1 2 3) -4) ;; subtract
  (ni= (- a) 0)
  (ni= (- a 1) -1) ;; negate
  (ni= (- a 1 b c) -1) ;; negate
  (ni= (- a 1 b 2) -1) ;; subtract
  (ni= (- a 1 b 2 3) -4)
  (ni= (- a 1 b 2 3 c) -4)

  ;; Frac
  (ni= (- -1/3 1/5) -8/15)

  ;; Approx
  (ni= (- ≈-10 ≈5.3) ≈-15.3)

  ;; Infinity
  (ni= (- ∞) -∞)
  (ni= (- ∞ 100) ∞)
  (ni= (- 100 -∞) ∞)
  (ni= (- ∞ -∞) ∞)

  ;; Negative infinity
  (ni= (- -∞) ∞)
  (ni= (- 100 ∞) -∞)
  (ni= (- -∞ 100) -∞)
  (ni= (- -∞ ∞) -∞)

  ;; Indet
  (ni= (- indet) indet)
  (ni= (- ∞ ∞) indet)
  (ni= (- -∞ -∞) indet)
  (ni= (- indet 3) indet)
  (ni= (- -∞ indet) indet)

  ;; Symbolic, more arguments
  (ni= (- 1 2 ∞) -∞)
  (ni= (- 1 -∞ 2 3) ∞)
  (ni= (- 0 5 indet) indet))

;; *
(group
  ;; Basic
  (ni= (*) 1)
  (ni= (* 2) 2)
  (ni= (* 1 2 3 4 5) 120)

  ;; Frac
  (ni= (* 1/3 2/5) 2/15)
  (ni= (* -3/12 5/3) -5/12)

  ;; Approx
  (ni= (* ≈3 ≈5) ≈15)
  ;; NOTE: I can't come up with a better way to test this...
  (ni= (ml/compact (* ≈0.3 ≈0.1)) "≈0.030000001")
  (ni= (ml/compact (* ≈0.3 0.5 ≈0.2)) "≈0.030000001")

  ;; Infinity
  (ni= (* 2 ∞) ∞)
  (ni= (* ∞ 2) ∞)
  (ni= (* ∞ ∞) ∞)
  (ni= (* -∞ -∞) ∞)

  ;; Negative infinity
  (ni= (* 2 -∞) -∞)
  (ni= (* -∞ 2) -∞)
  (ni= (* ∞ -∞) -∞)
  (ni= (* -∞ ∞) -∞)

  ;; Indet
  (ni= (* indet 3) indet)
  (ni= (* -∞ indet) indet)
  (ni= (* 0 ∞) indet)
  (ni= (* ∞ 0) indet)
  (ni= (* 0 -∞) indet)
  (ni= (* -∞ 0) indet)
  (ni= (* 0 indet) indet)

  ;; Symbolic, more arguments
  (ni= (* 3 ∞ 5) ∞)
  (ni= (* 3 ∞ 5 -∞) -∞)
  (ni= (* 3 ∞ 5 -∞ 0) indet)
  (ni= (* 0 ∞ 5 -∞) indet))

;; /
(group
  (ni= (nan? (/ ≈0 ≈0)) true))

;; //

;; mod

;; **

;; sqrt
(group
  (ni= (sqrt 100) ≈10)
  (ni= (sqrt 2) ≈1.4142135)
  (ni= (sqrt 1/2) (/ (sqrt 2) 2))
  (ni= (sqrt ≈100) ≈10)
  (ni= (sqrt ≈2) ≈1.4142135)
  (ni= (sqrt ≈1) ≈1)
  (ni= (sqrt ≈1/2) (/ (sqrt 2) 2))
  (ni= (sqrt ≈0) ≈0)
  (ni= (nan? (sqrt ≈-1)) true))

;; isqrt
(group
  (ni= (isqrt 100) 10)
  (ni= (isqrt 2) 1)
  (ni= (isqrt 1/2) ≈0)
  (ni= (nan? (isqrt -1)) true)
  (ni= (isqrt ≈100) ≈10)
  (ni= (isqrt ≈2) ≈1)
  (ni= (isqrt ≈1) ≈1)
  (ni= (isqrt ≈1/2) ≈0)
  (ni= (isqrt ≈0) ≈0)
  (ni= (nan? (isqrt ≈-1)) true))

;; sci
(group
  (ni= ≈3.40282347e+38 (* ≈3.40282347 (** 10 38)))
  (ni= ≈3.40282347e+39 ≈Infinity)
  (ni= ≈-3.40282347e+39 ≈-Infinity))

;; nan?
(group
  (ni= (nan? 0) false)
  (ni= (nan? 100) false)
  (ni= (nan? -100) false)
  (ni= (nan? 1/3) false)
  (ni= (nan? ≈0) false)
  (ni= (nan? ≈100) false)
  (ni= (nan? ≈Infinity) false)
  (ni= (nan? ≈-Infinity) false)
  (ni= (nan? ≈NaN) true)
  (ni= (nan? ∞) false)
  (ni= (nan? -∞) false)
  (ni= (nan? indet) false))

;; infinite?
(group
  (ni= (infinite? 0) false)
  (ni= (infinite? 100) false)
  (ni= (infinite? -100) false)
  (ni= (infinite? 1/3) false)
  (ni= (infinite? ≈0) false)
  (ni= (infinite? ≈100) false)
  (ni= (infinite? ≈Infinity) true)
  (ni= (infinite? ≈-Infinity) true)
  (ni= (infinite? ≈NaN) false)
  (ni= (infinite? ∞) true)
  (ni= (infinite? -∞) true)
  (ni= (infinite? indet) false))

;; sum
(group
  (ni= (sum ()) 0)
  (ni= (sum (5)) 5)
  (ni= (sum (x y z)) 0)
  (ni= (sum (1 2 3)) 6)
  (ni= (sum (1 x 2 3)) 6)
  (ni= (sum (1 x 2 3)) 6)
  (ni= (sum (1 2 3 4 5)) 15)
  (ni= (sum (1 2 ∞ 4 5)) ∞))

;; (sum attn)
(group
  (ni= (sum (attn ())) 0)
  (ni= (sum (attn (5))) 5)
  (ni= (sum (attn (x y z))) 0)
  (ni= (sum (attn (1 2 3 4 5))) 15)
  (ni= (sum (attn (1 2 ∞ 4 5))) ∞)
  (ni= (sum (attn (1 2 3 4 5 x) {+ 1 4 5})) 7)
  (ni= (sum (attn (1 2 3 4 5 x: 100 y: 200))) 315)
  (ni= (sum (attn (1 2 3 4 5 x: 100 y: 200) {+ 1 x})) 102))

;; <

;; <=
;; NOTE: This is necessary because when doing comparison, ≈0 is considered
;; to be equal to 0 (and so on for approx-exact comparisons). `==` is
;; too strict as it requires both parties to be approx or exact.

;; >

;; >=

;; =
(ni= (= 0 ≈0) false)

;; floor (toward negative infinity)
(group
  (ni= (floor qux) 0)
  (ni= (floor "abc") 0)

  (ni= (floor 1) 1)
  (ni= (floor 1.3) 1)
  (ni= (floor 1.6) 1)
  (ni= (floor 1.99) 1)
  (ni= (floor -1) -1)
  (ni= (floor -1.3) -2)
  (ni= (floor ≈1) ≈1)
  (ni= (floor ≈1.3) ≈1)
  (ni= (floor ≈1.6) ≈1)
  (ni= (floor ≈1.99) ≈1)
  (ni= (floor ≈-1) ≈-1)
  (ni= (floor ≈-1.3) ≈-2)
  (ni= (floor 1/3) 0)
  (ni= (floor -1/3) -1)

  (ni= (floor 0.5) 0)
  (ni= (floor 1.5) 1)
  (ni= (floor 2.5) 2)
  (ni= (floor 3.5) 3))

;; ceil (toward positive infinity)
(group
  (ni= (ceil qux) 0)
  (ni= (ceil "abc") 0)

  (ni= (ceil 1) 1)
  (ni= (ceil 1.3) 2)
  (ni= (ceil 1.6) 2)
  (ni= (ceil 1.99) 2)
  (ni= (ceil -1) -1)
  (ni= (ceil -1.3) -1)
  (ni= (ceil ≈1) ≈1)
  (ni= (ceil ≈1.3) ≈2)
  (ni= (ceil ≈1.6) ≈2)
  (ni= (ceil ≈1.99) ≈2)
  (ni= (ceil ≈-1) ≈-1)
  (ni= (ceil ≈-1.3) ≈-1)
  (ni= (ceil 1/3) 1)
  (ni= (ceil -1/3) 0)

  (ni= (ceil 0.5) 1)
  (ni= (ceil 1.5) 2)
  (ni= (ceil 2.5) 3)
  (ni= (ceil 3.5) 4))

;; round (Banker's rounding)
(group
  (ni= (round qux) 0)
  (ni= (round "abc") 0)

  (ni= (round 1) 1)
  (ni= (round 1.3) 1)
  (ni= (round 1.6) 2)
  (ni= (round 1.99) 2)
  (ni= (round -1) -1)
  (ni= (round -1.3) -1)
  (ni= (round ≈1) ≈1)
  (ni= (round ≈1.3) ≈1)
  (ni= (round ≈1.6) ≈2)
  (ni= (round ≈1.99) ≈2)
  (ni= (round ≈-1) ≈-1)
  (ni= (round ≈-1.3) ≈-1)
  (ni= (round 1/3) 0)
  (ni= (round -1/3) 0)

  ;; Banker's rounding
  (ni= (round 0.5) 0)
  (ni= (round 1.5) 2)
  (ni= (round 2.5) 2)
  (ni= (round 3.5) 4))

;; finite or: _
(group
  (ni= (finite 0 or: infinite) 0)
  (ni= (finite 100 or: infinite) 100)
  (ni= (finite ≈1.23 or: infinite) ≈1.23)
  (ni= (finite ∞ or: infinite) infinite)
  (ni= (finite -∞ or: infinite) infinite)
  (ni= (finite indet or: infinite) infinite)
  (ni= (finite qux or: infinite) infinite)
  (ni= (finite "hello world" or: infinite) infinite)
  (ni= (finite ≈NaN or: infinite) infinite)
  (ni= (finite ≈Infinity or: infinite) infinite)
  (ni= (finite ≈-Infinity or: infinite) infinite))

