  (ni= (clamp 5 "xyz" ..= 10) 0)
  (ni= (clamp 5 0 ..= "xyz") 0)
  (ni= (clamp 5 10 ..= 0) 5)
  (ni= (clamp 100 10 ..= 0) 10))

