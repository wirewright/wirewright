  (ni= (approx "foo") ≈NaN))

;; min
(group
  (ni= (min ()) ∞)
  (ni= (min (1)) 1)
  (ni= (min (1 2 3)) 1)
  (ni= (min (1 -∞ 15)) -∞)
  (ni= (min (1 "qux" -123)) -123)
  (ni= (min ("a" "b" "c")) ∞)
  (ni= (min "qux") ∞)

  (ni= (min 1 2 3) 1)
  (ni= (min 1 -∞ 3) -∞)
  (ni= (min 1 "qux" -123) -123)
  (ni= (min "a" "b" "c") ∞))

