  (ni= (round "abc") 0)

  (ni= (round 1) 1)
  (ni= (round 1.3) 1)
  (ni= (round 1.6) 2)
  (ni= (round 1.99) 2)
  (ni= (round -1) -1)
  (ni= (round -1.3) -1)
  (ni= (round ≈1) ≈1)
  (ni= (round ≈1.3) ≈1)
  (ni= (round ≈1.6) ≈2)
  (ni= (round ≈1.99) ≈2)
  (ni= (round ≈-1) ≈-1)
  (ni= (round ≈-1.3) ≈-1)
  (ni= (round 1/3) 0)
  (ni= (round -1/3) 0)

  ;; Banker's rounding
  (ni= (round 0.5) 0)
  (ni= (round 1.5) 2)
  (ni= (round 2.5) 2)
  (ni= (round 3.5) 4))

;; finite or: _
(group
  (ni= (finite 0 or: infinite) 0)
  (ni= (finite 100 or: infinite) 100)
  (ni= (finite ≈1.23 or: infinite) ≈1.23)
  (ni= (finite ∞ or: infinite) infinite)
  (ni= (finite -∞ or: infinite) infinite)
  (ni= (finite indet or: infinite) infinite)
