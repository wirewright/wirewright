;; sci
(group
  (ni= ≈3.40282347e+38 (* ≈3.40282347 (** 10 38)))
  ;; ;; FIXME: crash: Infinity
  ;; (ni= ≈3.40282347e+39 ≈inf)
  ;; ;; FIXME: crash: -Infinity
