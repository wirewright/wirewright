;; +
(group
  ;; Basic
  (ni= (+) 0)
  (ni= (+ 2) 2)
  (ni= (+ 2 2) 4)
  (ni= (+ 1 2 3) 6)
  (ni= (+ a) 0)
  (ni= (+ a b c) 0)
  (ni= (+ a 1 b c) 1)
  (ni= (+ a 1 b 2 3 c) 6)

  ;; Frac
  (ni= (+ 1/3 2/3) 1)
  (ni= (+ -1/3 2/3) 1/3)
  (ni= (+ 0.1 0.2) 0.3)

  ;; Approx
  (ni= (+ ≈0.1 ≈0.2) ≈0.3)

  ;; Infinity
  (ni= (+ ∞ 100) ∞)
  (ni= (+ 100 ∞) ∞)
  (ni= (+ ∞ ∞) ∞)

  ;; Negative infinity
  (ni= (+ -∞ 100) -∞)
  (ni= (+ 100 -∞) -∞)
  (ni= (+ -∞ -∞) -∞)

  ;; Indet
  (ni= (+ ∞ -∞) indet)
  (ni= (+ -∞ ∞) indet)
  (ni= (+ indet 100) indet)
  (ni= (+ -∞ indet) indet)
  (ni= (+ indet indet) indet)

  ;; Symbolic, more arguments
  (ni= (+ 1 2 3 ∞) ∞)
  (ni= (+ 1 2 -∞ 3) -∞)
  (ni= (+ indet 1 2 -∞ 3) indet)
  (ni= (+ ∞ 1 2 -∞ 3) indet))

;; -
(group
  ;; Basic
  (ni= (-) 0)
  (ni= (- 1) -1) ;; negate
  (ni= (- 1 2 3) -4) ;; subtract
  (ni= (- a) 0)
  (ni= (- a 1) -1) ;; negate
  (ni= (- a 1 b c) -1) ;; negate
  (ni= (- a 1 b 2) -1) ;; subtract
  (ni= (- a 1 b 2 3) -4)
  (ni= (- a 1 b 2 3 c) -4)

  ;; Frac
  (ni= (- -1/3 1/5) -8/15)

  ;; Approx
  (ni= (- ≈-10 ≈5.3) ≈-15.3)

  ;; Infinity
  (ni= (- ∞) -∞)
  (ni= (- ∞ 100) ∞)
  (ni= (- 100 -∞) ∞)
  (ni= (- ∞ -∞) ∞)

  ;; Negative infinity
  (ni= (- -∞) ∞)
  (ni= (- 100 ∞) -∞)
  (ni= (- -∞ 100) -∞)
  (ni= (- -∞ ∞) -∞)

  ;; Indet
  (ni= (- indet) indet)
  (ni= (- ∞ ∞) indet)
  (ni= (- -∞ -∞) indet)
  (ni= (- indet 3) indet)
  (ni= (- -∞ indet) indet)

  ;; Symbolic, more arguments
  (ni= (- 1 2 ∞) -∞)
  (ni= (- 1 -∞ 2 3) ∞)
  (ni= (- 0 5 indet) indet))

;; *
(group
  ;; Basic
  (ni= (*) 1)
  (ni= (* 2) 2)
  (ni= (* 1 2 3 4 5) 120)

  ;; Frac
  (ni= (* 1/3 2/5) 2/15)
  (ni= (* -3/12 5/3) -5/12)

  ;; Approx
  (ni= (* ≈3 ≈5) ≈15)
  ;; NOTE: I can't come up with a better way to test this...
  (ni= (ml/compact (* ≈0.3 ≈0.1)) "≈0.030000001")
  (ni= (ml/compact (* ≈0.3 0.5 ≈0.2)) "≈0.030000001")

  ;; Infinity
  (ni= (* 2 ∞) ∞)
  (ni= (* ∞ 2) ∞)
  (ni= (* ∞ ∞) ∞)
  (ni= (* -∞ -∞) ∞)

  ;; Negative infinity
  (ni= (* 2 -∞) -∞)
  (ni= (* -∞ 2) -∞)
  (ni= (* ∞ -∞) -∞)
  (ni= (* -∞ ∞) -∞)

  ;; Indet
  (ni= (* indet 3) indet)
  (ni= (* -∞ indet) indet)
  (ni= (* 0 ∞) indet)
  (ni= (* ∞ 0) indet)
  (ni= (* 0 -∞) indet)
  (ni= (* -∞ 0) indet)
  (ni= (* 0 indet) indet)

  ;; Symbolic, more arguments
  (ni= (* 3 ∞ 5) ∞)
  (ni= (* 3 ∞ 5 -∞) -∞)
  (ni= (* 3 ∞ 5 -∞ 0) indet)
  (ni= (* 0 ∞ 5 -∞) indet))

;; /
(group
  (ni= (/ 2) 1/2)
  (ni= (/ 1 2) 1/2)
  (ni= (/ 1 2 3) (/ (/ 1 2) 3))
  (ni= (nan? (/ ≈0 ≈0)) true))

;; //
(group
  (ni= (// 1 2) 0)
  (ni= (// 20 5) 4)

  (ni= (// 10 0) 0)
  (ni= (// 0 0) 0)
  (ni= (// "qux" 0) 0))

;; mod
(group
  (ni= (mod 1 2) 1)
  (ni= (mod 20 3) 2)

  (ni= (mod 10 0) 0)
  (ni= (mod 0 0) 0)
  (ni= (mod "qux" 0) 0))

;; **
(group
  (ni= (** 2 4) 16)
  (ni= (** 2 -4) 0.0625)
  (ni= (** 2 1/2) ≈1.4142135))

;; sqrt
(group
  (ni= (sqrt 100) ≈10)
  (ni= (sqrt 2) ≈1.4142135)
  (ni= (sqrt 1/2) (/ (sqrt 2) 2))
  (ni= (sqrt ≈100) ≈10)
  (ni= (sqrt ≈2) ≈1.4142135)
  (ni= (sqrt ≈1) ≈1)
  (ni= (sqrt ≈1/2) (/ (sqrt 2) 2))
  (ni= (sqrt ≈0) ≈0)
  (ni= (nan? (sqrt ≈-1)) true)
  (ni= (sqrt "qux") ≈NaN))

;; isqrt
(group
  (ni= (isqrt 100) 10)
  (ni= (isqrt 2) 1)
  (ni= (isqrt 1/2) ≈0)
  (ni= (nan? (isqrt -1)) true)
  (ni= (isqrt ≈100) ≈10)
  (ni= (isqrt ≈2) ≈1)
  (ni= (isqrt ≈1) ≈1)
  (ni= (isqrt ≈1/2) ≈0)
  (ni= (isqrt ≈0) ≈0)
  (ni= (nan? (isqrt ≈-1)) true)
  (ni= (isqrt "qux") ≈NaN))

;; sci
(group
  (ni= 12e3 12000)
  (ni= 12e-3 0.012)
  (ni= ≈3.40282347e+38 (* ≈3.40282347 (** 10 38)))
  (ni= ≈3.40282347e+39 ≈Infinity)
  (ni= ≈-3.40282347e+39 ≈-Infinity)
  (ni= (sci "abc" "def") 0))

;; nan?
(group
  (ni= (nan? 0) false)
  (ni= (nan? 100) false)
  (ni= (nan? -100) false)
  (ni= (nan? 1/3) false)
  (ni= (nan? ≈0) false)
  (ni= (nan? ≈100) false)
  (ni= (nan? ≈Infinity) false)
  (ni= (nan? ≈-Infinity) false)
  (ni= (nan? ≈NaN) true)
  (ni= (nan? ∞) false)
  (ni= (nan? -∞) false)
  (ni= (nan? indet) false))

;; infinite?
(group
  (ni= (infinite? 0) false)
  (ni= (infinite? 100) false)
  (ni= (infinite? -100) false)
  (ni= (infinite? 1/3) false)
  (ni= (infinite? ≈0) false)
  (ni= (infinite? ≈100) false)
  (ni= (infinite? ≈Infinity) true)
  (ni= (infinite? ≈-Infinity) true)
  (ni= (infinite? ≈NaN) false)
  (ni= (infinite? ∞) true)
  (ni= (infinite? -∞) true)
  (ni= (infinite? indet) false))

;; sum
(group
  (ni= (sum ()) 0)
  (ni= (sum (5)) 5)
  (ni= (sum (x y z)) 0)
  (ni= (sum (1 2 3)) 6)
  (ni= (sum (1 x 2 3)) 6)
  (ni= (sum (1 x 2 3)) 6)
  (ni= (sum (1 2 3 4 5)) 15)
  (ni= (sum (1 2 ∞ 4 5)) ∞))

;; product
(group
  (ni= (product ()) 1)
  (ni= (product (100)) 100)
  (ni= (product (1 2 3 4 5)) 120)
  (ni= (product (1 2 ∞ 4 5)) ∞)
  (ni= (product (1 2 "qux" 3 4 false 5)) 120)
  (ni= (product "qux") 0))


;; (sum attn)
(group
  (ni= (sum (attn ())) 0)
  (ni= (sum (attn (5))) 5)
  (ni= (sum (attn (x y z))) 0)
  (ni= (sum (attn (1 2 3 4 5))) 15)
  (ni= (sum (attn (1 2 ∞ 4 5))) ∞)
  (ni= (sum (attn (1 2 3 4 5 x) {+ 1 4 5})) 7)
  (ni= (sum (attn (1 2 3 4 5 x: 100 y: 200))) 315)
  (ni= (sum (attn (1 2 3 4 5 x: 100 y: 200) {+ 1 x})) 102))

;; cmp
(group
  (ni= (< 1) true)
  (ni= (< 1 2) true)
  (ni= (< 1 2 3) true)
  (ni= (< 1 5 3) false)
  (ni= (>= 10 10) true)
  (ni= (>= 10 10.1) false)
  (ni= (> 1 5) false)
  (ni= (> 5 1) true)
  (ni= (>= 10 ≈10) true)
  (ni= (<= 10 ≈10) true)
  (ni= (= 10 ≈10) false))

;; =
(group
  (ni= (= 100) true)
  (ni= (= 100 200) false)
  (ni= (= 100 100) true)
  (ni= (= "a" "b" "c") false)
  (ni= (= "a" "a" "a") true)
  (ni= (= 0 ≈0) false))

;; floor (toward negative infinity)
(group
  (ni= (floor qux) 0)
  (ni= (floor "abc") 0)

  (ni= (floor 1) 1)
  (ni= (floor 1.3) 1)
  (ni= (floor 1.6) 1)
  (ni= (floor 1.99) 1)
  (ni= (floor -1) -1)
  (ni= (floor -1.3) -2)
  (ni= (floor ≈1) ≈1)
  (ni= (floor ≈1.3) ≈1)
  (ni= (floor ≈1.6) ≈1)
  (ni= (floor ≈1.99) ≈1)
  (ni= (floor ≈-1) ≈-1)
  (ni= (floor ≈-1.3) ≈-2)
  (ni= (floor 1/3) 0)
  (ni= (floor -1/3) -1)

  (ni= (floor 0.5) 0)
  (ni= (floor 1.5) 1)
  (ni= (floor 2.5) 2)
  (ni= (floor 3.5) 3))

;; ceil (toward positive infinity)
(group
  (ni= (ceil qux) 0)
  (ni= (ceil "abc") 0)

  (ni= (ceil 1) 1)
  (ni= (ceil 1.3) 2)
  (ni= (ceil 1.6) 2)
  (ni= (ceil 1.99) 2)
  (ni= (ceil -1) -1)
  (ni= (ceil -1.3) -1)
  (ni= (ceil ≈1) ≈1)
  (ni= (ceil ≈1.3) ≈2)
  (ni= (ceil ≈1.6) ≈2)
  (ni= (ceil ≈1.99) ≈2)
  (ni= (ceil ≈-1) ≈-1)
  (ni= (ceil ≈-1.3) ≈-1)
  (ni= (ceil 1/3) 1)
  (ni= (ceil -1/3) 0)

  (ni= (ceil 0.5) 1)
  (ni= (ceil 1.5) 2)
  (ni= (ceil 2.5) 3)
  (ni= (ceil 3.5) 4))

;; round (Banker's rounding)
(group
