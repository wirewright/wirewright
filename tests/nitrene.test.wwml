;; reduce
(nitrene
  (reduce (0 xs)
    (fn (±n m←(%pipe (mod 2) 0))
      (+ n m)))

  (= {xs: ()} 0)
  (= {xs: (1)} 0)
  (= {xs: (1 2 3)} 2)
  (= {xs: (1 2 3 4 5 6)} 12)
  (= {xs: (0 1 2 3 4 5 6)} 12))


