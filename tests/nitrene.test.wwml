)

;; <

;; <=
;; NOTE: This is necessary because when doing comparison, ≈0 is considered
;; to be equal to 0 (and so on for approx-exact comparisons). `==` is
;; too strict as it requires both parties to be approx or exact.

;; >

;; >=

;; =

;; floor (toward negative infinity)
(group
  (ni= (floor 1) 1)
  (ni= (floor 1.3) 1)
  (ni= (floor 1.6) 1)
  (ni= (floor 1.99) 1)
  (ni= (floor -1) -1)
  (ni= (floor -1.3) -2)
  (ni= (floor ≈1) ≈1)
  (ni= (floor ≈1.3) ≈1)
  (ni= (floor ≈1.6) ≈1)
  (ni= (floor ≈1.99) ≈1)
  (ni= (floor ≈-1) ≈-1)
  (ni= (floor ≈-1.3) ≈-2)
  (ni= (floor 1/3) 0)
  (ni= (floor -1/3) -1)
  (ni= (floor 0.5) 0)
  (ni= (floor 1.5) 1)
  (ni= (floor 2.5) 2)
  (ni= (floor 3.5) 3))

;; ceil (toward positive infinity)
(group
  (ni= (ceil 1) 1)
  (ni= (ceil 1.3) 2)
  (ni= (ceil 1.6) 2)
  (ni= (ceil 1.99) 2)
  (ni= (ceil -1) -1)
  (ni= (ceil -1.3) -1)
  (ni= (ceil ≈1) ≈1)
  (ni= (ceil ≈1.3) ≈2)
  (ni= (ceil ≈1.6) ≈2)
  (ni= (ceil ≈1.99) ≈2)
  (ni= (ceil ≈-1) ≈-1)
  (ni= (ceil ≈-1.3) ≈-1)
  (ni= (ceil 1/3) 1)
  (ni= (ceil -1/3) 0)
  (ni= (ceil 0.5) 1)
  (ni= (ceil 1.5) 2)
  (ni= (ceil 2.5) 3)
  (ni= (ceil 3.5) 4))

;; round (Banker's rounding)
(group
  (ni= (round 1) 1)
  (ni= (round 1.3) 1)
  (ni= (round 1.6) 2)
  (ni= (round 1.99) 2)
  (ni= (round -1) -1)
  (ni= (round -1.3) -1)
  (ni= (round ≈1) ≈1)
  (ni= (round ≈1.3) ≈1)
  (ni= (round ≈1.6) ≈2)
  (ni= (round ≈1.99) ≈2)
  (ni= (round ≈-1) ≈-1)
  (ni= (round ≈-1.3) ≈-1)
  (ni= (round 1/3) 0)
  (ni= (round -1/3) 0)
  ;; Banker's rounding
  (ni= (round 0.5) 0)
  (ni= (round 1.5) 2)
  (ni= (round 2.5) 2)
  (ni= (round 3.5) 4))

;; finite or: _
(group
  (ni= (finite 0 or: infinite) 0)
  (ni= (finite 100 or: infinite) 100)
  (ni= (finite ≈1.23 or: infinite) ≈1.23)
  (ni= (finite ∞ or: infinite) infinite)
  (ni= (finite -∞ or: infinite) infinite)
  (ni= (finite indet or: infinite) infinite)
  (ni= (finite qux or: infinite) infinite)
  (ni= (finite "hello world" or: infinite) infinite))
  ;; TODO: approx NaN, -Infinity, Infinity.

