  (ni= (max 1 2 3) 3)
  (ni= (max 1 -∞ 3) 3)
  (ni= (max 1 ∞ 3) ∞)
  (ni= (max 1 "qux" -123) 1)
  (ni= (max "a" "b" "c") -∞))

