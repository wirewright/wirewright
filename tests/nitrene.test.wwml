;; Digits
(nitrene
  (-> digits
    (iota (size _))
    (attn _)
    (map _ (fn ±p (** 10 p)))
    (reverse _)
    (zip _ digits)
    (map _ (fn (±a ±b) (* a b)))
    (sum _))
  (= {digits: qux} 0)
  (= {digits: ()} 0)
  (= {digits: (0)} 0)
  (= {digits: (0 0 0 0)} 0)
  (= {digits: (1)} 1)
  (= {digits: (1 0)} 10)
  (= {digits: (1 2)} 12)
  (= {digits: (1 2 3)} 123)
  (= {digits: (1 2 3 4 5 6 7 8 9)} 123456789)
  (= {digits: (1 2 3 4 5 6 7 8 9 0 0 0)} 123456789000))

