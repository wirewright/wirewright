;; `testtool` uses this file to figure out the tests it needs to run and
;; their assets.

;; Codex and rem to use for Microfold tests.
microfold: {codex: (codex "ufold"), rem: 16}

;; Path to editR codex.
editR: {codex: "../runtime/codices/editR.codex.wwml"}

;; Path to uiR codex>
uiR: {codex: "../runtime/codices/uiR.codex.wwml"}

;; Tests are listed in loose dependency order: ML tests are the most "primitive" ones
;; and depend on the least amount of machinery, then go patterns and so on. This
;; doesn't work as cleanly in practice because the whole idea of Wirewright on
;; the implementation end is to have everything depend on (or at least accessible to)
;; everything else, so most of these tests require some form of "bootstrapping", as in,
;; "everything else must *mostly* work for this particular test to work". Apply this
;; last phrase to all tests, and you'll get the idea. The project is well past "bootstrapping"
;; though so don't lose sleep over any of this!

(test "ml.test.wwml"
  color: (oklch 0.7 0.1 orange)
  tags: (ml))

(comparison "WwML Corpus"
  (ml "corpus.in.wwml") (lr.gz "corpus.expected.wwlr.gz")
  tags: (ml ml-corpus))

(test "patterns.test.wwml"
  color: (oklch 0.7 0.1 green)
  tags: (patterns m1))

(test "backmaps.test.wwml"
  color: (oklch 0.7 0.1 sky)
  tags: (backmaps m1))

(test "alloy.test.wwml"
  color: (oklch 0.7 0.1 yellow)
  tags: (alloy))

(test "nitrene.test.wwml"
  color: (oklch 0.7 0.1 magenta)
  tags: (nitrene))

(test "rack.test.wwml"
  color: (oklch 0.7 0.1 violet)
  tags: (d7 delta7 rack))

(test "rack/tspace.test.wwml"
  color: (oklch 0.7 0.1 violet)
  tags: (d7 delta7 rack rack-misc rack-tspace))

(test "rack/ws.test.wwml"
  color: (oklch 0.7 0.1 violet)
  tags: (d7 delta7 rack rack-misc rack-ws))

(test "editR.test.wwml"
  color: (oklch 0.7 0.1 indigo)
  tags: (edit))

(scenery "scenery/"
  color: (oklch 0.7 0.1 pink)
  tags: (graphics scenery))

(test "ufold.test.wwml"
  color: (oklch 0.7 0.1 teal)
  tags: (ufold))

(comparison "DwUIR regressions"
  (dwuir "dwuir.in.wwml" wheel: 0 mouse-x: 0 mouse-y: 0)
  (ppm.gz "dwuir.expected.ppm.gz")
  tags: (graphics dwuir))

(comparison "UIR regressions (this may take a while)"
  (uir "uir.in.wwml" uir2ppm: true)
  (ppm.gz "uir.expected.ppm.gz")
  tags: (graphics uir long))
