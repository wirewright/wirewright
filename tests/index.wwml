;;
;; The `tests` tool uses this file to figure out the tests it needs
;; to run.
;;

((test "ml.test.wwml"
   color: (oklch 0.7 0.13 30)
   tags: (ml))
 (comparison "WwML Corpus"
   (ml "corpus.in.wwml") (lr.gz "corpus.expected.wwlr.gz")
   tags: (ml ml-corpus))
 (test "patterns.test.wwml"
   color: (oklch 0.7 0.13 140)
   tags: (patterns m1))
 (test "alloy.test.wwml"
   color: (oklch 0.7 0.13 190)
   tags: (alloy))
 (test "tspace.test.wwml"
   color: (oklch 0.7 0.13 180)
   tags: (tspace))
 (test "ufold.test.wwml"
   color: (oklch 0.7 0.13 290)
   tags: (ufold)))
