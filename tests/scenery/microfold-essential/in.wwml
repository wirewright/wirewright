           </g>
           <defs>
           <clipPath id="clip0_730_27136">
           <rect width="98" height="96" fill="currentColor"/>
           </clipPath>
           </defs>
           </svg>⎤)

(SidebarBtn icon_string caption_string ⍊ active⋮ false)
  => (group style: "flow-row gap-1.5 text-neutral-300 active:bg-neutral-700
                    active:text-neutral-50 rounded leading-none px-1.5 py-1"
            ^:active
       (icon ^icon style: "font-xl")
       (p ^caption style: "fr-1 center-y"))

(MuBox)
  => (group style: "flow-row p-5 gap-3 text-xs"
       (box style: "max-w-32px max-h-48px color-neutral-300"
         (MuLogo))
       (group style: "flow-row fr-1"
         (rect style: "fill-neutral-700 max-w-1px")
         (group style: "leading-none text-neutral-400 color-neutral-400 ml-2 fr-1"
           (p "Wirewright µsoma" style: "font-medium")
           (p "iota+faa8bd7b")
           (group style: "flow-row gap-1 mt-1"
             (box style: "max-w-14px max-h-14px center-y"
               (GhLogo))
             (a "wirewright/wirewright" style: "fr-1")))))

(Key caption_string)
  => (p style: "font-mono content rounded-sm px-0.8 bg-neutral-800 border-1px
                border-b-2px border-neutral-700 leading-none text-neutral-100"
       ^caption)

(KeyInfo ⍊ caption_string keys_: (_*))
  => (group style: "flow-row gap-1 font-xs"
       (^each (keys as key_string)
         (Key ^key))
       (p ^caption style: "text-neutral-400"))

(MuPopupAction caption_string ⍊ active⋮ false keys⋮ ())
  => (group style: "flow-row text-neutral-500 active:text-neutral-300
                    active:bg-neutral-800 rounded leading-none p-2"
            ^:active
       (p ^caption style: "fr-1")
       (group style: "flow-row gap-1 text-xs center-y"
         (^each (keys as key_)
           (Key ^key))))

;; Loosely based on Obsidian
(MuPopup)
  => (group style: "flow-none"
       (rect style: "fill-neutral-950 opacity-50%")
       (group style: "flow-none center-x content-y mt-20"
         (box style: "rounded-4xl bg-neutral-950 opacity-20% dt-3/2")
         (group style: "bg-neutral-900 mx-5 my-3 border border-neutral-600 rounded-lg min-w-3xs max-h-sm gap-1"
           (group style: "flow-row px-5 py-3 text-lg/6 text-neutral-500"
             (p "Select a command..." style: "fr-1 sel sel-white sel-thick" selection-anchor: 0 selection-span: 0)
             (icon "close" style: "text-neutral-400 center-y"))
           (hr style: "bg-neutral-800 max-h-1px")
           (group style: "flow-row fr-1 px-3"
             (group style: "flow-col fr-1 clip content-y" page-y: (50 %)
               (MuPopupAction "Open project" active: false keys: ("C-n"))
               (MuPopupAction "Add database" active: false)
               (MuPopupAction "Update database" active: true)
               (MuPopupAction "Delete database" active: false)
               (MuPopupAction "Manage cache" active: false keys: ("C-m" "C-c"))
               (MuPopupAction "Manage prod" active: false)
               (MuPopupAction "Delete prod" active: false))
             (transform dt: (50 %)
               (limit max-h: (80 %)
                 (box style: "ml-2 rounded-full max-w-16px bg-neutral-700"))))
           (hr style: "bg-neutral-800 max-h-1px")
           (group style: "flow-row gap-4 center py-1"
             (KeyInfo keys: ("↑" "↓") caption: "to navigate")
             (KeyInfo keys: ("↵") caption: "to select")
             (KeyInfo keys: ("esc") caption: "to dismiss")))))

(MuProjectCard ⍊ title_string author_string date_string hue_)
  => (group style: "border-sm border-neutral-800 rounded-lg gap-1 min-w-4xs min-h-2xs max-w-4xs max-h-2xs"
       (cover style: "fr-1 rounded-t-lg" µ-bg: (oklch 0.5 0.08 ^hue))
       (group style: "px-3 py-2"
         (p ^title style: "text-neutral-300 font-medium")
         (p ^"⸢author⸣ · ⸢date⸣" style: "text-neutral-500")))

(group style: "flow-none"
  (group style: "flow-none"
    (group style: "p-10 gap-10"
      (h1 "Projects" style: "font-light text-neutral-300")
      (group style: "flow-wrap gap-5"
        (MuProjectCard title: "Kaixo mundua 1" author: "John Doe" date: "01 May 2026" hue: red)
        (MuProjectCard title: "Kaixo mundua 2" author: "Samantha Doe" date: "02 May 2026" hue: green)
        (MuProjectCard title: "Kaixo mundua 3" author: "David Doe" date: "03 May 2026" hue: blue)
        (MuProjectCard title: "Kaixo mundua 4" author: "Margaret Doe" date: "04 May 2026" hue: violet)))
    (group style: "flow-none right"
      (group style: "m-3 gap-2 pt-2 bg-neutral-800 border border-neutral-700 rounded-lg text-sm"
        (MuBox)
        (rect style: "fill-neutral-700 max-h-1px")
        (group style: "px-3 gap-2"
          (SidebarBtn "account_tree" "Projects" active: true)
          (SidebarBtn "cloud" "Network")
          (SidebarBtn "settings" "Settings")
          (SidebarBtn "help" "Help")))))
  (MuPopup))
