width: 500
height: 900
backdrop: (oklch 0.2 0 0)

(limit max-w: 200
  (content y: false
    (z-stack
      (rect fill: (oklch 0.35 0 0))
      (transform dl: 300 dt: 10
        (limit max-w: 40 max-h: 40
          (rect fill: gray radius-tl: (* 1) radius-tr: (* 1) radius-bl: (* 1) radius-br: (* 1))
          (viewport offset-x: (20 px) offset-y: (20 px) radius-tl: (* 1) radius-tr: (* 1) radius-bl: (* 1) radius-br: (* 1)
            (content x: true y: true
              (observer id: viewport-text
                (observable
                  (text color: white caption: "inside\nviewport")))))))
      (content x: true y: true
        (transform dl: 230 dt: 350
          (observer id: scaled-transformed-text
            (observable
              (text size: 48 color: white caption: "Hello World")))))
      (content x: true y: true
        (transform dl: 300 dt: 150 scale: 1.5 pivot-l: 0.5 pivot-t: 0.5 angle: 45
          (rect fill: red)
          (observer id: unitext
            (observable
              (text font: "Unifont" color: white caption: "Hello World\x00\nBye world")))))
      (y-stack
        (observer id: img
          (padding pt: 15 pb: 15
            (align x: 0.5 y: 0.5
              (content x: true y: true
                (limit min-w: 48 min-h: 48
                  (observable
                    (img radius-tl: (* 1) radius-tr: (* 1) radius-bl: (* 1) radius-br: (* 1) src: (uri "http://127.0.0.1:9812/avatar-female1-32.jpg"))))))))
        (padding pl: 5 pr: 5 pt: 5 pb: 5
          (text
            caption: "Hello World"
            font: "does-not-exist"
            placeholder: (rect fill: (oklch 0.4 0 0) radius-tl: 5 radius-tr: 5 radius-bl: 5 radius-br: 5)))
        (padding pl: 5 pr: 5 pt: 5 pb: 5
          (observer id: space-text
            (observable
              (text caption: "Bye      World" color: white font: "IBM Plex Mono" placeholder: (rect fill: (oklch 0.4 0 0) radius-tl: 5 radius-tr: 5 radius-bl: 5 radius-br: 5)))))
        (observer id: l-sel-text
          (padding pl: 5 pr: 5 pt: 5 pb: 5
            (observable
              (text caption: "Text selected\nleft-leaning" color: white font: "Noto Sans" selection: true selection-color: black selection-anchor: 3 selection-span: 10))))
        (observer id: r-sel-text
          (padding pl: 5 pr: 5 pt: 5 pb: 5
            (observable
              (text caption: "Text selected\nright-leaning" color: white font: "Noto Sans" selection: true selection-color: black selection-anchor: 13 selection-span: -10))))))))

