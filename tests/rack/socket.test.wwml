    (cell @in 10)))

;; Unix socket counter with link: handoff
(rack
  (frame
    (cell @fs-in (delete file if exists "/tmp/wirewright-unix.sock"))
    (cell @fs-out)
    (fs @fs-in @fs-out)

    (guard (@fs-out [ok _])
      (server (@pool ((ml @in) -> (unix "/tmp/wirewright-unix.sock" link: handoff) -> (ml @out)))
        (backsys
          {¦ in: (±M _*) out: (_* `>M)}
            <> {(M): (), >M: ^(+ M 1)})))

    (pool @pool)

    (client ((ml @in) -> (unix "/tmp/wirewright-unix.sock" link: handoff) -> (ml @out)))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

;; Connection in closed when both queues are removed
(rack
  (frame
    (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
      (backsys
        {¦ in: (msg_ _*) out_: (_* `>msg)}
          <> {(msg): (), >msg: ^msg}
        {¦ in_: ("bye" _*) out_}
          <> {(in): (), (out): ()}))

    ;; We must wait for the answer, orelse it's possible for us to quit
    ;; with "Hello World" still travelling over the wire!
    (cell @sent-bye)
    (backsys
      {¦ -msg_ reply -sent-bye_}
        <> {msg: "bye", sent-bye: true})

    (pool @pool)

    (cell @msg "Hello World")
    (queue (@reply @replies) ())
    (client ((text @msg) -> (ws local 9813) -> (text @replies))))

  (frame/tail fast-forward: true
    (cell @msg "bye")
    (queue (@reply @replies) ("Hello World"))
    (client ((text @msg) -> (ws local 9813) -> (text @replies)) up))

  (frame/tail fast-forward: true
    (pool @pool)
    (cell @msg)
    (queue (@reply @replies) ("Hello World"))
    (client ((text @msg) -> (ws local 9813) -> (text @replies))
      (dn "connection closed by the other side"))))

;; Connection is closed when the corresponding client device is removed
(rack
  (frame
    (backsys @pool
      ⟨D←⟨(cell @remove-me true)⟩⟩°
        <> {(D): ()})

    (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
      (cell @remove-me)
      (backsys
        {¦ in: (msg←(%not "bye") _*) out_: (_* `>msg)}
          <> {(msg): (), >msg: ^msg}
        {¦ in: (msg←"bye" _*) -remove-me_}
          <> {(msg): (), remove-me: true}))

    ;; We must wait for the answer, orelse it's possible for us to quit
    ;; with "Hello World" still travelling over the wire!
    (cell @sent-bye)
    (backsys
      {¦ -msg_ reply -sent-bye_}
        <> {msg: "bye", sent-bye: true})

    (pool @pool)

    (cell @msg "Hello World")
    (queue (@reply @replies) ())
    (client ((text @msg) -> (ws local 9813) -> (text @replies))))

  (frame/tail fast-forward: true
    (pool @pool)

    (cell @msg)
    (queue (@reply @replies) ("Hello World"))
    (client ((text @msg) -> (ws local 9813) -> (text @replies))
      (dn "connection closed by the other side"))))

;; Connection is closed when the client is removed.
(rack
  (frame
    (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
      (feed (@in front) (@out back)))

    (pool @pool)

    (cell @in "Hi!")
    (cell @out)
    (guard (@out)
      (client ((text @in) -> (ws local 9813) -> (text @out)))))

  (frame/tail fast-forward: true
    (pool @pool)

    (cell @in)
    (cell @out "Hi!")
    (guard (@out)
      (client ((text @in) -> (ws local 9813) -> (text @out))
        ;; The client was caught and frozen in the up state.
        up))))

;; Client connection is closed by replacing `up` with `dn`.
(rack
  (frame
    (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
      (feed (@in front) (@out back)))

    (backsys
      {¦ out client: (client _ state←up)}
        <> {state: dn})

    (pool @pool)

    (cell @in "Hi!")
    (cell @out)
    (frag @client
      (client ((text @in) -> (ws local 9813) -> (text @out)))))

  (frame/tail fast-forward: true
    (pool @pool)

    (cell @in)
    (cell @out "Hi!")
    (frag @client
      (client ((text @in) -> (ws local 9813) -> (text @out)) dn))))

;; Multiple servers and clients in the same world
(rack
  (frame
    (module {}
      (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @in) -> (ws local 9814) -> (text @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @in) -> (ws local 9815) -> (text @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (cell @in "0")
      (cell @out)
      (guard (@out)
        (client ((text @in) -> (ws local 9813) -> (text @out)))))

    (module {}
      (cell @in "1")
      (cell @out)
      (guard (@out)
        (client ((text @in) -> (ws local 9814) -> (text @out)))))

    (module {}
      (cell @in "2")
      (cell @out)
      (guard (@out)
        (client ((text @in) -> (ws local 9815) -> (text @out))))))

  (frame/tail fast-forward: true
    (module {}
      (server (@pool ((text @in) -> (ws local 9813) -> (text @out)) up)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @in) -> (ws local 9814) -> (text @out)) up)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @in) -> (ws local 9815) -> (text @out)) up)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (cell @in)
      (cell @out "0")
      (guard (@out)
        ;; Frozen in the up state
        (client ((text @in) -> (ws local 9813) -> (text @out)) up)))

    (module {}
      (cell @in)
      (cell @out "1")
      (guard (@out)
        (client ((text @in) -> (ws local 9814) -> (text @out)) up)))

    (module {}
      (cell @in)
      (cell @out "2")
      (guard (@out)
        (client ((text @in) -> (ws local 9815) -> (text @out)) up)))))

;; Multiple servers and clients in the same world, of different kinds.
;; Test input, output queue rename.
(rack
  (frame
    (module {}
      (server (@pool ((text @queries) -> (ws local 9813) -> (text @replies)))
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @queries) -> (tcp local 9814 link: handoff) -> (text @replies)))
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (server (@pool ((ml @queries) -> (unix "/tmp/wirewright-unix.sock") -> (ml @replies)))
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (cell @in "0")
      (cell @out)
      (guard (@out)
        (client ((text @in) -> (ws local 9813) -> (text @out)))))

    (module {}
      (cell @in "Hello World")
      (cell @out)
      (guard (@out)
        (client ((text @in) -> (tcp local 9814 link: handoff) -> (text @out)))))

    (module {}
      (cell @in (+ 1 2 x: 100 y: 200))
      (cell @out)
      (guard (@out)
        (client ((ml @in) -> (unix "/tmp/wirewright-unix.sock") -> (ml @out))))))

  (frame/tail fast-forward: true
    (module {}
      (server (@pool ((text @queries) -> (ws local 9813) -> (text @replies)) up)
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @queries) -> (tcp local 9814 link: handoff) -> (text @replies)) up)
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (server (@pool ((ml @queries) -> (unix "/tmp/wirewright-unix.sock") -> (ml @replies)) up)
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (cell @in)
      (cell @out "0")
      (guard (@out)
        ;; Frozen in the up state
        (client ((text @in) -> (ws local 9813) -> (text @out)) up)))

    (module {}
      (cell @in)
      (cell @out "Hello World")
      (guard (@out)
        (client ((text @in) -> (tcp local 9814 link: handoff) -> (text @out))
          up)))

    (module {}
      (cell @in)
      (cell @out (+ 1 2 x: 100 y: 200))
      (guard (@out)
        (client ((ml @in) -> (unix "/tmp/wirewright-unix.sock") -> (ml @out))
          up)))))

;; Flow a value through several servers
(rack
  (frame
    (module {}
      (server (@pool ((ml @in) -> (tcp local 9813) -> (ml @out)))
        (backsys
          {¦ in: (msg←{¦ signatures_dict⋮ (_* `>sign)} _*) out: (_* `>msg)}
            <> {>sign: alice, (msg): (), >msg: ^(up msg)}))
      (pool @pool))

    (module {}
      (server (@pool ((ml @in) -> (tcp local 9814) -> (ml @out)))
        (backsys
          {¦ in: (msg←{¦ signatures_dict⋮ (_* `>sign)} _*) out: (_* `>msg)}
            <> {>sign: bob, (msg): (), >msg: ^(up msg)}))
      (pool @pool))

    (module {}
      (server (@pool ((ml @in) -> (tcp local 9815) -> (ml @out)))
        (backsys
          {¦ in: (msg←{¦ signatures_dict⋮ (_* `>sign)} _*) out: (_* `>msg)}
            <> {>sign: charlie, (msg): (), >msg: ^(up msg)}))
      (pool @pool))

    (cell @a (+ 1 2))
    (cell @b)
    (cell @c)
    (cell @d)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)))
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)))
    (client ((ml @c) -> (tcp local 9815) -> (ml @d))))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b (+ 1 2 signatures: (alice)))
    (cell @c)
    (cell @d)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up)
    (client ((ml @c) -> (tcp local 9815) -> (ml @d)) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c (+ 1 2 signatures: (alice bob)))
    (cell @d)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up)
    (client ((ml @c) -> (tcp local 9815) -> (ml @d)) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c)
    (cell @d (+ 1 2 signatures: (alice bob charlie)))
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up)
    (client ((ml @c) -> (tcp local 9815) -> (ml @d)) up)))

;; Create a loop through two servers, increment a number
(rack
  (frame
    (module {}
      (server (@pool ((ml @in) -> (tcp local 9813) -> (ml @out)))
        (backsys
          {¦ in: (±n _*) out: (_* `>n)}
            <> {(n): (), >n: ^(+ n 1)}))
      (pool @pool))

    (module {}
      (server (@pool ((ml @in) -> (tcp local 9814) -> (ml @out)))
        (backsys
          {¦ in: (n_ _*) out: (_* `>n)}
            <> {(n): (), >n: (done ^n)}
          {¦ in: (n←(%number _ < 10) _*) out: (_* `>n)}
            <> {(n): (), >n: ^n}))
      (pool @pool))

    (backsys {¦ ±c -a_} <> {(c): (), a: ^c})

    (cell @a 0)
    (cell @b)
    (cell @c)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)))
    (client ((ml @b) -> (tcp local 9814) -> (ml @c))))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b 1)
    (cell @c)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c 1)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up))

  (frame/tail fast-forward: true
    (cell @a 1)
    (cell @b)
    (cell @c)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b 2)
    (cell @c)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c 2)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up))

  ;; ...

  (frame/tail fast-forward: true
    (cell @a 9)
    (cell @b)
    (cell @c)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b 10)
    (cell @c)
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c (done 10))
    (client ((ml @a) -> (tcp local 9813) -> (ml @b)) up)
    (client ((ml @b) -> (tcp local 9814) -> (ml @c)) up)))

;; Changing port on the same client to "dial" to a different server
(rack
  (frame
    (module {}
      (server (@pool ((ml @in) -> (tcp local 9813) -> (ml @out)))
        (backsys
          {¦ in: (±n _*) out: (_* `>n)}
            <> {(n): (), >n: ^(+ n 1)}))
      (pool @pool))

    (module {}
      (server (@pool ((ml @in) -> (tcp local 9814) -> (ml @out)))
        (backsys
          {¦ in: (±n _*) out: (_* `>n)}
            <> {(n): (), >n: ^(+ n 1)}))
      (pool @pool))

    (module {}
      (server (@pool ((ml @in) -> (tcp local 9815) -> (ml @out)))
        (backsys
          {¦ in: (±n _*) out: (_* `>n)}
            <> {(n): (), >n: ^(+ n 1)}))
      (pool @pool))

    (backsys
      {¦ ±in client: (client (_ -> (tcp local `>port) -> _))}
        <> {>port: ^in}
      {¦ -in_ ±out client: (client (_ -> (tcp local port_) -> _) up)}
        <> {in: ^out, (out): (), port: ^out})

    (cell @in 9813)
    (cell @out)
    (frag @client
      (client ((ml @in) -> (tcp local) -> (ml @out)))))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out 9814)
    (frag @client
      (client ((ml @in) -> (tcp local 9813) -> (ml @out))
        up)))

  (frame/tail fast-forward: true
    (cell @in 9814)
    (cell @out)
    (frag @client
      (client ((ml @in) -> (tcp local 9814) -> (ml @out))
        up)))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out 9815)
    (frag @client
      (client ((ml @in) -> (tcp local 9814) -> (ml @out))
        up)))

  (frame/tail fast-forward: true
    (cell @in 9815)
    (cell @out)
    (frag @client
      (client ((ml @in) -> (tcp local 9815) -> (ml @out))
        up)))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out 9816)
    (frag @client
      (client ((ml @in) -> (tcp local 9815) -> (ml @out))
        up)))

  (frame/tail fast-forward: true
    (cell @in 9816)
    (cell @out)
    (frag @client
      (client ((ml @in) -> (tcp local 9816) -> (ml @out))
        up)))

  ;; Make sure all servers lost the connection. We have to use pattern: true
  ;; here because the error message in `pending` can be basically anything --
  ;; i.e. it's platform-dependent.
  (frame pattern: true fast-forward: true
    (%'(module {}
         (server (@pool ((ml @in) -> (tcp local 9813) -> (ml @out)) up)
           (backsys
             {¦ in: (±n _*) out: (_* `>n)}
               <> {(n): (), >n: ^(+ n 1)}))
         (pool @pool))

     %'(module {}
         (server (@pool ((ml @in) -> (tcp local 9814) -> (ml @out)) up)
           (backsys
             {¦ in: (±n _*) out: (_* `>n)}
               <> {(n): (), >n: ^(+ n 1)}))
         (pool @pool))

     %'(module {}
         (server (@pool ((ml @in) -> (tcp local 9815) -> (ml @out)) up)
           (backsys
             {¦ in: (±n _*) out: (_* `>n)}
               <> {(n): (), >n: ^(+ n 1)}))
         (pool @pool))

     _*

     (cell @in 9816)
     (cell @out)
     (frag @client
       (client ((ml @in) -> (tcp local 9816) -> (ml @out))
         (pending _string))))))

;; Server-side store example using surfaces
(rack
  (frame
    (module {:@store}
      (frag @sensor
        (sensor (queue commands command_)))
      (frag @report)
      (part (@sensor @command) (sensor _ command_ _*))
      (backsys
        {¦ command_} <> {(command): ()}
        {¦ command_: (tspace_ _) ⋮report}
          <> {(command): (), report: (appearance ^tspace (err "invalid command"))}
        {¦ command_: (tspace_ (get k_)) store: (%value k v_) ⋮report}
          <> {(command): (), report: (appearance ^tspace (ok ^v))}
        {¦ command_: (tspace_ (post k_ v'_)) store: (%-value k v) ⋮report}
          <> {(command): (), v: ^v', report: (appearance ^tspace ok)}
        {¦ command_: (tspace_ (put k_ v'_)) store: (%value k v_) ⋮report}
          <> {(command): (), v: ^v', report: (appearance ^tspace ok)}
        {¦ command_: (tspace_ (del k_)) store: (%value k v_) ⋮report}
          <> {(command): (), (v): (), report: (appearance ^tspace ok)}))

  (cell @store {})

  (server (@pool ((ml @in) -> (ws local 9813) -> (ml @out)))
    ;; Remember that @id, @in, and @out are "shadow-inserted" by `server` for
    ;; each device!
    (frag @sensor)
    (frag @appearance)
    (backsys
      ;; Initialize the sensor which we'll use to receive reports.
      {¦ id_ -sensor_}
        <> {sensor: (sensor (queue ^id _))}
      ;; Relay commands through an appearance. Require the sensor to be initialized!
      {¦ id_ in: (command_ _*) sensor ⋮appearance}
        <> {(command): (), appearance: (appearance commands (^id ^command))}
      ;; Relay reports.
      {¦ out: (_* `>report) sensor: (sensor _ report_ _*)}
        <> {>report: ^report, (report): ()}))

  (pool @pool)

  (circuit @clients
    ;; Alice
    (device role: alice
      (cell @in)
      (cell @out)
      (client ((ml @in) -> (ws local 9813 key: alice) -> (ml @out))))

    ;; Bob
    (device role: bob
      (cell @in)
      (cell @out)
      (client ((ml @in) -> (ws local 9813 key: bob) -> (ml @out)))))

  (backsys
    {¦ line_: (role_ command_)
       clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
      <> {(line): (), >command: ^command}
    {¦ line_: (?expect role_ expectation_)
       clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
      <> {(line): (), (expectation): ()}
    {¦ line_: (?expect store store_) store_}
      <> {(line): ()})

  (part (@script @line) (line_ _*))

  (cell @script
    ((alice (post x 100))
     (?expect alice ok)
     (?expect store {x: 100})

     (alice (get x))
     (?expect alice (ok 100))

     (bob (get x))
     (?expect bob (ok 100))

     (bob (post x "Hello"))
     (?expect bob (err "invalid command"))

     (bob (put x "Hello"))
     (?expect bob ok)

     (?expect store {x: "Hello"})

     (bob (post y 200))
     (?expect bob ok)

     (alice (get y))
     (?expect alice (ok 200))

     (alice (get z))
     (?expect alice (err "invalid command"))

     (?expect store {x: "Hello", y: 200})

     (alice (del y))
     (?expect alice ok)

     (bob (get y))
     (?expect bob (err "invalid command"))

     (?expect store {x: "Hello"}))))

  (frame/tail fast-forward: true
    (cell @script ())))

;; Distributed store
(rack
  (frame
    (server (@pool ((ml @in) -> (ws local 9813) -> (ml @out)))
      (frag @sensor
        (sensor (view store (_ _))))
      (circuit @appearances)
      (backsys
        ;; Fallback.
        {¦ in: (M_ _*) out: (_* `reply)}
          <> {(M): (), reply: (err "invalid command")}
        ;; GET retrieves a value.
        {¦ in: (M←(get k_) _*) out: (_* `reply) sensor: (sensor _ …⟨(k_ v_)⟩…)}
          <> {(M): (), reply: (ok ^v)}
        ;; POST publishes a value...
        {¦ in: (M←(post k_ v_) _*) out: (_* `reply) appearances_dict⋮ (_* `>appearance)}
          <> {(M): (), reply: ok, >appearance: (appearance store (^k ^v))}
        ;; ... but only if it is globally absent.
        {¦ in: (M←(post k_ _) _*) out: (_* `reply) sensor: (sensor _ …⟨(k_ _)⟩…)}
          <> {(M): (), reply: (err "invalid command")}
        ;; PUT changes the value of an entry *this client* ows.
        {¦ in: (M←(put k_ v'_) _*) out: (_* `reply) appearances: ⟨(appearance store (k_ v_))⟩}
          <> {(M): (), reply: ok, v: ^v'}
        ;; DEL removes an entry *this client* owns.
        {¦ in: (M←(del k_) _*) out: (_* `reply) appearances: ⟨A←(appearance store (k_ _))⟩}
          <> {(M): (), reply: ok, (A): ()}))

    (pool @pool)

    (circuit @clients
      ;; Alice
      (device role: alice
        (cell @in)
        (cell @out)
        (client ((ml @in) -> (ws local 9813 key: alice) -> (ml @out))))

      ;; Bob
      (device role: bob
        (cell @in)
        (cell @out)
        (client ((ml @in) -> (ws local 9813 key: bob) -> (ml @out)))))

    (backsys
      {¦ line_: (role_ command_)
         clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
        <> {(line): (), >command: ^command}
      {¦ line_: (?expect role_ expectation_)
         clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
        <> {(line): (), (expectation): ()}
      {¦ line_: (!expel role_)
         pool_dict
         clients: ⟨(device (cell @in) (cell @out) (client _ state←up) ⍊ role_)⟩}
        <> {line: (!wait ^(size pool)), state: dn}
      {¦ line_: (!wait (%number _ > (var n))) pool: (%pipe size n_)}
        <> {(line): ()})

    (part (@script @line) (line_ _*))

    (cell @script
      ((alice (post x 100))
       (?expect alice ok)

       (alice (post x "Hello"))
       (?expect alice (err "invalid command"))

       (bob (get x))
       (?expect bob (ok 100))

       (bob (get y))
       (?expect bob (err "invalid command"))

       (bob (post y 200))
       (?expect bob ok)

       (alice (get y))
       (?expect alice (ok 200))

       (alice (post y "hello"))
       (?expect alice (err "invalid command"))

       (alice (put y "hello"))
       (?expect alice (err "invalid command"))

       (alice (put x "hello"))
       (?expect alice ok)

       (bob (get x))
       (?expect bob (ok "hello"))

       (alice (put z 300))
       (?expect alice (err "invalid command"))

       (alice (post z (+ 1 2 precision: 3)))
       (?expect alice ok)

       (bob (get z))
       (?expect bob (ok (+ 1 2 precision: 3)))

       (bob (del z))
       (?expect bob (err "invalid command"))

       (alice (del x))
       (?expect alice ok)

       (alice (del y))
       (?expect alice (err "invalid command"))

       (alice (get x))
       (?expect alice (err "invalid command"))

       (bob (get x))
       (?expect bob (err "invalid command"))

       (alice (get y))
       (?expect alice (ok 200))

       (bob (get z))
       (?expect bob (ok (+ 1 2 precision: 3)))

       (alice (post x "Hello World"))
       (?expect alice ok)

       (bob (get x))
       (?expect bob (ok "Hello World"))

       (!expel alice)

       ;; Alice's x is lost!
       (bob (get x))
       (?expect bob (err "invalid command"))

       ;; Alice's z is lost!
       (bob (get z))
       (?expect bob (err "invalid command"))

       ;; Bob can now define x (and y)
       (bob (post x "Bob's x"))
       (?expect bob ok)

       (bob (get x))
       (?expect bob (ok "Bob's x"))

       (bob (del x))
       (?expect bob ok)

       (bob (del y))
       (?expect bob ok)

       ;; We've removed everything

       (bob (get x))
       (?expect bob (err "invalid command"))

       (bob (get y))
       (?expect bob (err "invalid command"))

       (bob (get z))
       (?expect bob (err "invalid command")))))

  (frame/tail fast-forward: true
    (cell @script ())))

;; Communication between peers through a "god-like" observer
(rack
  (frame
    (server (@pool ((ml @in) -> (ws local 9813) -> (ml @out)))
      (cell @name)
      (backsys
        {¦ in: (msg_ _*) out: (_* `>msg) -name_}
          <> {(msg): (), >msg: ok, name: ^msg}))

    (pool @pool)

    (backsys @pool
      ⟨& (device …⟨& (cell @in (M←(receiver_ msg_) _*)) (cell @out (_* `>report))⟩…)
         (device …⟨& (cell @name receiver_) (cell @out (_* `>msg))⟩…)⟩°
        <> {(M): (), >report: ok, >msg: ^msg})

    (circuit @clients
      ;; Alice
      (device role: alice
        (cell @in)
        (cell @out)
        (client ((ml @in) -> (ws local 9813 key: alice) -> (ml @out))))

      ;; Bob
      (device role: bob
        (cell @in)
        (cell @out)
        (client ((ml @in) -> (ws local 9813 key: bob) -> (ml @out)))))

    (backsys
      {¦ line_: (role_ command_)
         clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
        <> {(line): (), >command: ^command}
      {¦ line_: (?expect role_ expectation_)
         clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
        <> {(line): (), (expectation): ()})

    (part (@script @line) (line_ _*))

    (cell @script
      ((alice "Alice")
       (?expect alice ok)

       (bob "Bob")
       (?expect bob ok)

       (alice ("Bob" "Hello Bob!"))
       (?expect alice ok)
       (?expect bob "Hello Bob!")

       (alice ("Bob" "Second message"))
       (?expect alice ok)

       (alice ("Bob" "Third message, checking how it all queues, Bob!"))
       (?expect alice ok)

       (?expect bob "Second message")
       (?expect bob "Third message, checking how it all queues, Bob!")

       (bob ("Alice" "Hello Alice!"))
       (?expect bob ok)
       (?expect alice "Hello Alice!"))))

  (frame/tail fast-forward: true
    (cell @script ())))

;; Same servers with different links must conflict (tcp)
(rack
  (frame
    (server (@pool ((binary @in) -> (tcp local 9813 link: stream) -> (binary @out))))
    (server (@pool ((binary @in) -> (tcp local 9813 link: handoff) -> (binary @out))))
    (pool @pool))

  (frame pattern: true fast-forward: true
    (%any°
      ((server (@pool ((binary @in) -> (tcp local 9813 link: stream) -> (binary @out)) up))
       (server (@pool ((binary @in) -> (tcp local 9813 link: handoff) -> (binary @out)) (pending _string)))
       (pool @pool))

      ((server (@pool ((binary @in) -> (tcp local 9813 link: stream) -> (binary @out)) (pending _string)))
       (server (@pool ((binary @in) -> (tcp local 9813 link: handoff) -> (binary @out)) up))
       (pool @pool)))))

;; Same servers with different links must conflict (ws)
(rack
  (frame
    (server (@pool ((binary @in) -> (ws local 9813 link: stream) -> (binary @out))))
    (server (@pool ((binary @in) -> (ws local 9813 link: handoff) -> (binary @out))))
    (pool @pool))

  (frame pattern: true fast-forward: true
    (%any°
      ((server (@pool ((binary @in) -> (ws local 9813 link: stream) -> (binary @out)) up))
       (server (@pool ((binary @in) -> (ws local 9813 link: handoff) -> (binary @out)) (dn "conflicting `link:`s for the same host and port")))
       (pool @pool))

      ((server (@pool ((binary @in) -> (ws local 9813 link: stream) -> (binary @out)) (dn "conflicting `link:`s for the same host and port")))
       (server (@pool ((binary @in) -> (ws local 9813 link: handoff) -> (binary @out)) up))
       (pool @pool)))))

;; Nesting: client inside client device
(rack
  (frame
    (server (@pool ((binary @in) -> (ws local 9814) -> (binary @out)))
      (client ((binary @request) -> (ws local 9813 key: @id) -> (binary @response)))
      (part (@in @request) (request_ _*))
      ;; TODO: (part (@out @response) (_* `response))
      (cell @response)
      (feed @response (@out back)))

    (circuit @clients
      ;; Alice
      (device role: alice
        (cell @in)
        (cell @out)
        (client ((ml @in) -> (ws local 9814 key: alice) -> (ml @out))))

      ;; Bob
      (device role: bob
        (cell @in)
        (cell @out)
        (client ((ml @in) -> (ws local 9814 key: bob) -> (ml @out)))))

    (backsys
      {¦ line_: (role_ command_)
         clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
        <> {(line): (), >command: ^command}
      {¦ line_: (?expect role_ expectation_)
         clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
        <> {(line): (), (expectation): ()}
      {¦ line_: (!expel role_)
         pool_dict
         clients: ⟨(device (cell @in) (cell @out) (client _ state←up) ⍊ role_)⟩}
        <> {line: (!wait ^(size pool)), state: dn}
      {¦ line_: (!wait (%number _ > (var n))) pool: (%pipe size n_)}
        <> {(line): ()})

    (part (@script @line) (line_ _*))

    (module {}
      (server (@pool ((binary @in) -> (ws local 9813) -> (binary @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    (pool @pool)

    (cell @script
      ((alice "Hello in Alice")
       (?expect alice "Hello in Alice")

       (bob "Hello in Bob")
       (?expect bob "Hello in Bob")

       (!expel alice)

       (bob "Hello in Bob")
       (?expect bob "Hello in Bob")

       (!expel bob))))

  (frame/tail fast-forward: true
    ;; The auxiliary server should not have any connections as well.
    (module {}
      (server (@pool ((binary @in) -> (ws local 9813) -> (binary @out)) up)
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; The main server should not have any connections.
    (pool @pool)

    (cell @script ())))

;; Nesting: server inside client device
(rack
  (frame
    (server (@pool ((ml @in) -> (ws local 9813) -> (ml @out)))
      (cell @role)

      (guard (@role server)
        (module {}
          (server (@pool ((text @in) -> (ws local 9814) -> (text @out)))
            (feed (@in front) (@out back)))
          (pool @pool)))

      (guard (@role client)
        (cell @client-in)
        (cell @client-out)
        (client ((text @client-in) -> (ws local 9814 key: @id renew: true) -> (text @client-out))))

      (backsys
        {¦ in: (M←(role r_) _*) out: (_* `reply) ⋮role}
          <> {(M): (), reply: ok, role: ^r}
        {¦ in: (M←(send msg_) _*) out: (_* `reply) -client-in_}
          <> {(M): (), reply: ok, client-in: ^msg}
        {¦ in: (M←receive _*) out: (_* `reply) client-out_}
          <> {(M): (), reply: (ok ^client-out), (client-out): ()}))

    (pool @pool)

    (circuit @clients
      ;; Alice
      (device role: alice
        (cell @in)
        (cell @out)
        (client ((ml @in) -> (ws local 9813 key: alice renew: true) -> (ml @out))))

      ;; Bob
      (device role: bob
        (cell @in)
        (cell @out)
        (client ((ml @in) -> (ws local 9813 key: bob renew: true) -> (ml @out))))

      ;; Charlie
      (device role: charlie
        (cell @in)
        (cell @out)
        (client ((ml @in) -> (ws local 9813 key: charlie renew: true) -> (ml @out)))))

    (backsys
      {¦ line_: (role_ command_)
         clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
        <> {(line): (), >command: ^command}
      {¦ line_: (?expect role_ expectation_)
         clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
        <> {(line): (), (expectation): ()}
      {¦ line_: (!expel role_)
         pool_dict
         clients: ⟨(device (cell @in) (cell @out) (client _ state←up) ⍊ role_)⟩}
        <> {line: (!wait ^(size pool)), state: dn}
      {¦ line_: (!wait (%number _ > (var n))) pool: (%pipe size n_)}
        <> {(line): ()})

    (part (@script @line) (line_ _*))

    (cell @script
      ((alice (role server))
       (?expect alice ok)

       (bob (role client))
       (?expect bob ok)

       (bob (send "Kaixo"))
       (?expect bob ok)

       (bob receive)
       (?expect bob (ok "Kaixo"))

       (charlie (role client))
       (?expect charlie ok)

       (charlie (send "Hello"))
       (?expect charlie ok)

       (charlie (send "World"))
       (?expect charlie ok)

       (charlie receive)
       (?expect charlie (ok "Hello"))

       (charlie receive)
       (?expect charlie (ok "World"))

       ;; Lose our server!
       (!expel alice)

       ;; Change the role of Bob. He is now the server!
       (bob (role server))
       (?expect bob ok)

       ;; Only Charlie remains. He should still be able to send messages -- thanks
       ;; to retries after he lost connection with Alice.
       (charlie (send "Hi again"))
       (?expect charlie ok)

       (charlie receive)
       (?expect charlie (ok "Hi again")))))

  (frame/tail fast-forward: true
    (cell @script ())))

;; Duplicated server is noop with the same pool
(rack
  (frame
    (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
      (feed (@in front) (@out back)))
    (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
      (feed (@in front) (@out back)))

    (pool @pool)

    (cell @in "Kaixo mundua")
    (cell @out)
    (guard (@out)
      (client ((text @in) -> (ws local 9813) -> (text @out)))))

  (frame/tail fast-forward: true
    (pool @pool)

    (cell @in)
    (cell @out "Kaixo mundua")
    (guard (@out)
      (client ((text @in) -> (ws local 9813) -> (text @out)) up))))

;; Duplicated server with a different pool is an exact replica
(rack
  (frame
    (server (@pool0 ((text @in) -> (ws local 9813) -> (text @out)))
      (feed (@in front) (@out back)))
    (server (@pool1 ((text @in) -> (ws local 9813) -> (text @out)))
      (feed (@in front) (@out back)))

    (pool @pool0)
    (pool @pool1)

    (cell @in "Kaixo mundua")
    (cell @out)
    (discard @out)
    (client ((text @in) -> (ws local 9813) -> (text @out))))

  (frame pattern: true fast-forward: true
    (_*

     (pool @pool0
       (device
         …⟨& (cell @id id_) (cell @out ("Kaixo mundua"))⟩…))

     (pool @pool1
       (device
         …⟨& (cell @id id_) (cell @out ("Kaixo mundua"))⟩…))

     (cell @in)
     (cell @out)
     (discard @out)
     (client ((text @in) -> (ws local 9813) -> (text @out)) up)))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out "Kaixo mundua")
    (discard @out)
    (client ((text @in) -> (ws local 9813) -> (text @out)) up))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out)
    (discard @out)
    (client ((text @in) -> (ws local 9813) -> (text @out)) up)))

;; port: auto
(rack
  (frame
    (frag @server
      (server (@pool ((text @in) -> (tcp local auto) -> (text @out)))
        (feed (@in front) (@out back))))
    (pool @pool)

    (manipulator (@server (server [@_ _ (up ⍊ port_)] _*) -> (client [_ -> (_ _ port←?) -> _] _*))
      (client ((text @query) -> (tcp local ?) -> (text @replies))))

    (queue (@query @queries) ("a" "b" "c"))
    (queue (@reply @replies) ()))

  (frame/tail fast-forward: true
    (queue (@query @queries) ())
    (queue (@reply @replies) ("a" "b" "c"))))

;; port: shared, server key: _
(rack
  (frame
    (module {}
      (server (@pool ((text @in) -> (tcp local (shared 9813) key: alice link: handoff) -> (text @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @in) -> (tcp local (shared 9813) key: bob link: handoff) -> (text @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @in) -> (tcp local (shared 9813) key: charlie link: handoff) -> (text @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    (frag @client)

    (cell @queries ("a" "b" "c" "d" "e" "f" "g" "h" "i" "j" "k" "l" "m" "n" "o" "p"))
    (cell @replies ())
    (cell @query)
    (cell @reply)

    (backsys
      {¦ queries: (Q_ _*) -query_ -reply -client_}
        <> {(Q): (), query: ^Q, client: (client (@query -> (tcp local 9813 key: ^Q link: handoff) -> @reply))}
      {¦ -query reply_ replies: (_* `>reply) client_}
        <> {(reply): (), >reply: ^reply, (client): ()}))

  (frame/tail fast-forward: true
    (module {}
      (server (@pool ((text @in) -> (tcp local (shared 9813) key: alice link: handoff) -> (text @out)) up)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @in) -> (tcp local (shared 9813) key: bob link: handoff) -> (text @out)) up)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool ((text @in) -> (tcp local (shared 9813) key: charlie link: handoff) -> (text @out)) up)
        (feed (@in front) (@out back)))
      (pool @pool))

    (frag @client)

    (cell @queries ())
    (cell @replies ("a" "b" "c" "d" "e" "f" "g" "h" "i" "j" "k" "l" "m" "n" "o" "p"))
    (cell @query)
    (cell @reply)

    (backsys
      {¦ queries: (Q_ _*) -query_ -reply -client_}
        <> {(Q): (), query: ^Q, client: (client (@query -> (tcp local 9813 key: ^Q link: handoff) -> @reply))}
      {¦ -query reply_ replies: (_* `>reply) client_}
        <> {(reply): (), >reply: ^reply, (client): ()})))

;; Transport-only server defaults to @in, @out, text. Client can omit
;; format to default to text.
(rack
  (frame
    (server (@pool (tcp local 9813))
      (feed (@in front) (@out back)))
    (pool @pool)

    (cell @in "Kaixo")
    (cell @out)
    (client (@in -> (tcp local 9813) -> @out)))

  (frame pattern: true fast-forward: true
    ((server (@pool (tcp local 9813) up)
       (feed (@in front) (@out back)))
     (pool @pool
       (device
         (cell @id _string)
         (cell @in ())
         (cell @out ())
         (feed (@in front) (@out back))))

     (cell @in)
     (cell @out "Kaixo")
     (client (@in -> (tcp local 9813) -> @out) up))))

;; Different encoder and decoder
(rack
  (frame
    (server (@pool ((text @in) -> (tcp local 9813) -> (binary @out)))
      (feed (@in front) (@out back)))
    (pool @pool)

    (cell @in "Kaixo")
    (cell @out)
    ;; Binary @in should convert "Kaixo" to a text/plain blob.
    (client ((binary @in) -> (tcp local 9813) -> (binary @out))))

  (frame/tail fast-forward: true
    (cell @in)
    ;; TCP strips content-type (there's no way to transmit it without a wrapping
    ;; protocol of any kind)
    (cell @out ⟬‸Kaixo‸⟭)
    (client ((binary @in) -> (tcp local 9813) -> (binary @out))
      up)))

;; Multiple clients on the same socket
;;
;; NOTE: Even though in practice I see the same order here, it's more of
;; an implementation point. The order in which `@query`s are sent is indet
;; in the same frame is indet. The order in which replies arrive for them
;; is also indet.
(rack
  (frame
    (server (@pool ((text @in) -> (tcp local 9813) -> (text @out)))
      (feed (@in front) (@out back)))

    (pool @pool)

    (module {}
      (cell @query "Alice")
      (queue (@reply @replies) ())
      (client ((text @query) -> (tcp local 9813) -> (text @replies))))

    (module {}
      (cell @query "Bob")
      (queue (@reply @replies) ())
      (client ((text @query) -> (tcp local 9813) -> (text @replies)))))

  (frame pattern: true fast-forward: true
    (_*
     (module {}
       (cell @query)
       (queue (@reply @replies) (%any ("Alice" "Bob") ("Bob" "Alice")))
       (client ((text @query) -> (tcp local 9813) -> (text @replies)) up))

     (module {}
       (cell @query)
       (queue (@reply @replies) (%any ("Alice" "Bob") ("Bob" "Alice")))
       (client ((text @query) -> (tcp local 9813) -> (text @replies)) up)))))

