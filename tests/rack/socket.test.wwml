;; Basic echo example
(rack
  (frame
    ;; A basic echo server
    (module {}
      (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
        (feed (@in front) (@out back)))
      (pool @pool))
    ;; A client
    (module {}
      (queue (@msg @msgs) ("Kaixo" "mundua"))
      (client ((text @msg) -> (ws local 9813) -> (text @replies)))
      (queue (@reply @replies) ())))

  (frame/tail fast-forward: true
    (module {}
      (queue (@msg @msgs) ())
      (client ((text @msg) -> (ws local 9813) -> (text @replies))
        up)
      (queue (@reply @replies) ("Kaixo" "mundua")))))

;; Chat example
(rack
  (frame
    ;; A basic chat server
    (module {}
      (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
        (frag @rx (sensor (queue chat _string)))
        (frag @tx (appearance chat))
        (frag @user)
        (frag @peers (sensor (journal users _string)))
        (backsys
          {¦ -user_ out: (_* `>msg)}
            <> {user: pending, >msg: "Please enter your nickname."}
          {¦ in: (nick_string _*) user_: pending}
            <> {(nick): (), user: (appearance users ^(chomp nick))}
          {¦ peers: (sensor _ event←(appeared nick_string) _*) out: (_* `>msg)}
            <> {(event): (), >msg: ^"[⸢nick⸣ joined the chat]"}
          {¦ peers: (sensor _ event←(disappeared nick_string) _*) out: (_* `>msg)}
            <> {(event): (), >msg: ^"[⸢nick⸣ left the chat]"}
          {¦ in: (msg_string _*) user: (_ _ nick_string) tx: (appearance _ `>msg)}
            <> {(msg): (), >msg: ^"⸢nick⸣: ⸢msg⸣"}
          {¦ out: (_* `>msgs) user: (_ _ _string) rx: (sensor _ msgs_string+)}
            <> {(>msgs): ^msgs, (msgs): ()}))
      (pool @pool))

    ;; Alice client
    (module {}
      (cell @state)
      (queue (@msg @msgs) ())
      (frag @socket
        (client ((text @msg) -> (ws local 9813 key: alice) -> (text @replies))))
      (queue (@reply @replies) ())
      (backsys
        {¦ reply_} <> {(reply): ()}
        {¦ reply: "Please enter your nickname." -msgs_}
          <> {msgs: "alice"}
        {¦ reply: "[bob joined the chat]" -msgs_ -state_}
          <> {msgs: "hi bob", state: greeted}
        {¦ reply: "bob: ack alice" -msgs_ -state_}
          <> {msgs: "hi bob", state: greeted}
        {¦ reply: "bob: hi alice" -msgs_}
          <> {msgs: "how are you doing?"}
        {¦ reply: "bob: I'm doing fine" -msgs_}
          <> {msgs: "bye then"}
        {¦ reply: "bob: yeah, bye" socket: (client _ status←up)}
          <> {status: dn}))

    ;; Bob client
    (module {}
      (queue (@msg @msgs) ())
      (client ((text @msg) -> (ws local 9813 key: bob) -> (text @replies)))
      (queue (@reply @replies) ())
      (backsys
        {¦ reply_} <> {(reply): ()}
        {¦ reply: "Please enter your nickname." -msgs_}
          <> {msgs: "bob"}
        {¦ reply: "[alice joined the chat]" -msgs_}
          <> {msgs: "ack alice"}
        {¦ reply: "alice: hi bob" -msgs_}
          <> {msgs: "hi alice"}
        {¦ reply: "alice: how are you doing?" -msgs_}
          <> {msgs: "I'm doing fine"}
        {¦ reply: "alice: bye then" -msgs_}
          <> {msgs: "yeah, bye"}))

    ;; An observer we use for testing purposes.
    (module {:@history}
      (frag @chat
        (sensor (many chat _string)))
      (frag @users
        (sensor (journal users _string)))
      (backsys
        {¦ history: (_* `entry) chat: (sensor _ msgs_+) users: (sensor _)}
          <> {entry: (concurrent ^*msgs), (msgs): ()}
        {¦ history: (_* `entry) chat: (sensor _) users: (sensor _ events_+)}
          <> {entry: (concurrent ^*events), (events): ()}
        {¦ history: (_* `entry) chat: (sensor _ msgs_+) users: (sensor _ events_+)}
          <> {entry: (concurrent ^*msgs ^*events), (msgs): (), (events): ()}))

    (cell @history ()))

  ;; NOTE: It is rather hard to design a simple protocol which would have
  ;; one single order with the setup we have here. So the order of the first
  ;; few messages (greetings) is arbitrary (and some things / greetings may
  ;; even coincide or be duplicated, i.e., Alice and Bob saying hi to each
  ;; other simultaneously, or doing so multiple times before everything settles).
  ;; After the greetings, though, the order is stable (at least I hope so...)
  ;; It's a very interesting problem but I'm not sure I have the time to ponder
  ;; on it for long, so we'll just live with the arbitrary order in the first
  ;; few entries...
  (frame pattern: true fast-forward: true
    (_*
     (cell @history
       ((%group
          (%all
            ⟪(appeared "alice")⟫
            ⟪(appeared "bob")⟫
            (%any° ⟪"bob: hi alice"⟫ ⟪"alice: hi bob"⟫))
          _*)
        (concurrent "alice: how are you doing?")
        (concurrent "bob: I'm doing fine")
        (concurrent "alice: bye then")
        (concurrent "bob: yeah, bye")
        (concurrent (disappeared "alice")))))))

;; JSON server echo
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool ((json @in) -> (ws local 9813) -> (json @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; Client
    (module {}
      (queue (@msg @msgs)
        (⎡100⎤
         ⎡"hello"⎤
         ⎡{"x": 100, "y": 200}⎤
         ⎡invalid message⎤
         ⎡[1, {"type": "cat", "name": "Smokey"}, 2]⎤))
      (queue (@reply @replies) ())
      (client ((text @msg) -> (ws local 9813) -> (text @replies)))))

  (frame/tail fast-forward: true
    (module {}
      (queue (@msg @msgs) ())
      (queue (@reply @replies)
        (⎡100⎤
         ⎡"hello"⎤
         ⎡{"x":100,"y":200}⎤
         ;; invalid message was discarded
         ⎡[1,{"name":"Smokey","type":"cat"},2]⎤))
      (client ((text @msg) -> (ws local 9813) -> (text @replies)) up))))

;; ML server echo
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool ((ml @in) -> (ws local 9813) -> (ml @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; Client
    (module {}
      (queue (@msg @msgs)
        (⎡100⎤
         ⎡hello⎤
         ⎡(+ 1 2)⎤
         ⎡{x: 100, y: 200}⎤
         ⎡invalid message⎤
         ⎡(1 {type: cat, name: "Smokey"} 2 x: 100 y: 200)⎤))
      (queue (@reply @replies) ())
      (client ((text @msg) -> (ws local 9813) -> (text @replies)))))

  (frame/tail fast-forward: true
    (module {}
      (queue (@msg @msgs) ())
      (queue (@reply @replies)
        (⎡100⎤
         ⎡hello⎤
         ⎡(+ 1 2)⎤
         ⎡{x: 100 y: 200}⎤
         ;; invalid message was discarded
         ⎡(1 {name: "Smokey" type: cat} 2 x: 100 y: 200)⎤))
      (client ((text @msg) -> (ws local 9813) -> (text @replies)) up))))

;; PrettyML server echo
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool ((prettyml @in) -> (ws local 9813) -> (prettyml @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; Client
    (module {}
      (queue (@msg @msgs)
        (⎡100⎤
         ⎡hello⎤
         ⎡(+ 1 2)⎤
         ⎡{x: 100, y: 200}⎤
         ⎡invalid message⎤
         ⎡(1 {type: cat, name: "Smokey"} 2 x: 100 y: 200)⎤))
      (queue (@reply @replies) ())
      (client ((text @msg) -> (ws local 9813) -> (text @replies)))))

  (frame/tail fast-forward: true
    (module {}
      (queue (@msg @msgs) ())
      (queue (@reply @replies)
        ("100\n"
         "hello\n"
         "(+ 1 2)\n"
         "{x: 100, y: 200}\n"
         ;; invalid message was discarded
         "(1 {name: \"Smokey\", type: cat} 2 x: 100 y: 200)\n"))
      (client ((text @msg) -> (ws local 9813) -> (text @replies)) up))))

;; Arithmetic demo, format-policy: wrap
(rack
  (frame
    (module {}
      (schema (@schema json)
        expr => _number
        expr => (seq + (ref expr) (ref expr))
        expr => (seq - (ref expr) (ref expr))
        expr => (seq * (ref expr) (ref expr))
        expr => (seq / (ref expr) (ref expr)))

      (server (@pool (((json @schema expr) @in policy: wrap) -> (ws local 9813) -> (json @out)))
        (cell @expr)
        (cell @value)
        (backsys
          {¦ in: (M←(ok expr_) _*) -expr: >expr}
            <> {(M): (), >expr: ^expr}
          ;; NOTE: we use -expr to make sure there's no reordering; there's actually
          ;; a few ticks of delay between expr and value feeding to out so errors can
          ;; be handled in the meantime; we don't want that in tests though...
          {¦ in: (M←(err _string) _*) -expr out: (_* `>reply)}
            <> {(M): (), >reply: ^M}
          {¦ value_ out: (_* `>reply)}
            <> {(value): (), >reply: (ok ^value)})
        (rewriter (@expr -> (ascR (rulesetR)) -> @value)
          (+ ±a ±b) => ^(+ a b)
          (- ±a ±b) => ^(- a b)
          (* ±a ±b) => ^(* a b)
          (/ ±a ±b) => ^(/ a b)))

      (pool @pool))

    (module {}
      (queue (@expr @exprs)
        (⎡100⎤
         ⎡["+", 100, 200]⎤
         ⎡["+", 1, ["*", 2, 3]]⎤
         ⎡["-", ["/", 1.23, 3], 5]⎤
         ⎡["+", ["*", 2, 3], 1]⎤
         ⎡invalid message⎤))
      (queue (@value @values) ())
      (client ((text @expr) -> (ws local 9813) -> (text @values)))))

  (frame/tail fast-forward: true
    (module {}
      (queue (@expr @exprs) ())
      (queue (@value @values)
        (⎡["ok",100]⎤
         ⎡["ok",300]⎤
         ⎡["ok",7]⎤
         ⎡["ok",-4.59]⎤
         ⎡["ok",7]⎤
         ⎡["err","message decode error"]⎤))
      (client ((text @expr) -> (ws local 9813) -> (text @values)) up))))

;; Server-side abort
(rack
  (frame
    (server (@pool ((ml @in policy: wrap) -> (ws local 9813) -> (ml @out)))
      (backsys
        {¦ in_: ([err _] _*) out_}
          <> {(in): (), (out): ()}))
    (pool @pool)

    (cell @in "") ;; send empty message (invalid)
    (cell @out)
    (client ((binary @in) -> (ws local 9813) -> (binary @out))))

  (frame/tail fast-forward: true
    (server (@pool ((ml @in policy: wrap) -> (ws local 9813) -> (ml @out)) up)
      (backsys
        {¦ in_: ([err _] _*) out_}
          <> {(in): (), (out): ()}))
    (pool @pool)

    (cell @in)
    (cell @out)
    (client ((binary @in) -> (ws local 9813) -> (binary @out))
      (dn "connection closed by the other side"))))

;; Client format: ml
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool ((binary @in) -> (ws local 9813) -> (binary @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; Client
    (module {}
      (queue (@message @messages)
        (100
         (+ 1 2)
         (+ 1 2 x: 100 y: 200)
         "hello world\n"))
      (client ((ml @message) -> (ws local 9813) -> (ml @replies)))
      (queue (@reply @replies) ())))

  (frame/tail fast-forward: true
    (module {}
      (queue (@message @messages) ())
      (client ((ml @message) -> (ws local 9813) -> (ml @replies)) up)
      (queue (@reply @replies)
        (100
         (+ 1 2)
         (+ 1 2 x: 100 y: 200)
         "hello world\n")))))

