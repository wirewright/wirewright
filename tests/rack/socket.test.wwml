  (frame
    (server (@pool (@in -> (tcp local 9813) -> @out))
      (feed (@in front) (@out back)))
    (pool @pool)

    (cell @in "Kaixo")
    (cell @out)
    (client (@in -> (tcp local 9813) -> @out)))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out "Kaixo")
    (client (@in -> (tcp local 9813) -> @out) up)))

;; Client with link: stream, replies cell is absent, all messages are lost
(rack
  (frame
    (server (@pool (@in -> (tcp local 9813) -> @out))
      (feed (@in front) (@out back)))
    (pool @pool)

    (queue (@query @queries) ("Alice" "Bob" "Charlie"))
    (client (@query -> (tcp local 9813) -> @replies)))

  (frame pattern: true fast-forward: true
    ((server (@pool (@in -> (tcp local 9813) -> @out) up)
       (feed (@in front) (@out back)))
     (pool @pool
       (device
         (cell @id _string)
         (cell @in ())
         (cell @out ())
         (feed (@in front) (@out back))))

     (queue (@query @queries) ())
     (client (@query -> (tcp local 9813) -> @replies)
       up))))

;; Client with link: handoff, replies are backpressured to stay in the @out cell
;; of the client device.
(rack
  (frame
    (server (@pool (@in -> (tcp local 9813 link: handoff) -> @out))
      (feed (@in front) (@out back)))
    (pool @pool)

    (queue (@query @queries) ("Alice" "Bob" "Charlie"))
    (client (@query -> (tcp local 9813 link: handoff) -> @replies)))

  (frame pattern: true fast-forward: true
    ((server (@pool (@in -> (tcp local 9813 link: handoff) -> @out) up)
       (feed (@in front) (@out back)))
     (pool @pool
       (device
         (cell @id _string)
         (cell @in ())
         (cell @out ("Alice" "Bob" "Charlie"))
         (feed (@in front) (@out back))))

     (queue (@query @queries) ())
     (client (@query -> (tcp local 9813 link: handoff) -> @replies)
       up))))

;; Client with link: handoff, replies are backpressured to stay in the @out cell
;; of the client device. When an observer detects the @out cell is full, it adds
;; the replies queue and replies start flowing into it.
(rack
  (frame
    (server (@pool (@in -> (tcp local 9813 link: handoff) -> @out))
      (feed (@in front) (@out back)))

    (pool @pool)

    (cell @receive false)
    (backsys
      {¦ receive_: false, pool: ((device …⟨(cell @out (_ _ _))⟩…))}
        <> {receive: true})

    (client (@query -> (tcp local 9813 link: handoff) -> @replies))

    (queue (@query @queries) ("Alice" "Bob" "Charlie"))
    (guard (@receive true)
      (queue (@reply @replies) ())))

  (frame/tail fast-forward: true
    (queue (@query @queries) ())
    (guard (@receive true)
      (queue (@reply @replies) ("Alice" "Bob" "Charlie")))))

;; With link: handoff, a queue on client @replies exerts backpressure on
;; the corresponding client device.
(rack
  (frame
    (server (@pool (@in -> (tcp local 9813 link: handoff) -> @out))
      (feed (@in front) (@out back)))

    (pool @pool)

    (queue (@query @queries) ("Alice" "Bob" "Charlie"))
    (queue (@reply @replies max: 2) ())

    (client (@query -> (tcp local 9813 link: handoff) -> @replies)))

  (frame pattern: true fast-forward: true
    ((server (@pool (@in -> (tcp local 9813 link: handoff) -> @out) up)
       (feed (@in front) (@out back)))

     (pool @pool
       (device
         (cell @id _string)
         (cell @in ())
         (cell @out ("Charlie"))
         (feed (@in front) (@out back))))

     (queue (@query @queries) ())
     (queue (@reply @replies max: 2) ("Alice" "Bob"))
     (client (@query -> (tcp local 9813 link: handoff) -> @replies)
       up))))

;; max: 1 on both ends on the server for backpressure, replies absent
(rack
  (frame
    (server (@pool ((text @in capacity: 1) -> (tcp local 9813 link: handoff) -> (text @out capacity: 1)))
      (feed (@in front) (@out back)))
    (pool @pool)

    (queue (@query @queries) ("Alice" "Bob" "Charlie"))
    (client (@query -> (tcp local 9813 link: handoff) -> @replies)))

  (frame pattern: true fast-forward: true
    (%'(server (@pool ((text @in capacity: 1) -> (tcp local 9813 link: handoff) -> (text @out capacity: 1)) up)
         (feed (@in front) (@out back)))

      (pool @pool
        (device
          (cell @id _string)
          (cell @in ())
          (cell @out ("Alice"))
          (feed (@in front) (@out back))))

      (queue (@query @queries) ("Bob" "Charlie"))
      (client (@query -> (tcp local 9813 link: handoff) -> @replies)
        up)))

  wait)

;; max: 1 on both ends on the server for backpressure, replies present
(rack
  (frame
    (server (@pool ((text @in capacity: 1) -> (tcp local 9813 link: handoff) -> (text @out capacity: 1)))
      (feed (@in front) (@out back)))
    (pool @pool)

    (queue (@query @queries) ("Alice" "Bob" "Charlie"))
    (queue (@reply @replies) ())
    (client (@query -> (tcp local 9813 link: handoff) -> @replies)))

  (frame pattern: true fast-forward: true
    (_*
     (pool @pool
       (device
         (cell @id _string)
         (cell @in ())
