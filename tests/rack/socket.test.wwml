;; Client format: json
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool (ws local 9813) format: binary)
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; Client
    (module {}
      (queue (@message @messages)
        (100
         (+ 1 2)
         (+ 1 2 x: 100 y: 200)
         "hello world\n"))
      (client (@message -> (ws local 9813) -> @replies format: json))
      (queue (@reply @replies) ())))

  (frame/tail fast-forward: true
    (module {}
      (queue (@message @messages) ())
      (client (@message -> (ws local 9813) -> @replies format: json) up)
      (queue (@reply @replies)
        (100
         ("+" 1 2)
         ;; Since there's no schema, this is the best format: json can do!
         {"0": "+", "1": 1, "2": 2, "x": 100, "y": 200}
         "hello world\n")))))

;; Client format: json schema
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool (ws local 9813) format: binary)
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; Client
    (schema (@schema json)
      expr => _number
      expr => (seq + (ref expr) (ref expr)))

    (client (@message -> (ws local 9813) -> @replies format: (json @schema expr)))
    (queue (@message @messages)
      (100
       (+ 1 2)
       (+ (+ 1 2) 3)
       (+ 1 (+ 2 3))
       (+ (+ 1 2) (+ 2 3))
       (+ 1)
       "invalid"
       (+ 1.23 4.56)))
    (queue (@reply @replies) ()))

  (frame/tail fast-forward: true
    (queue (@message @messages) ())
    (queue (@reply @replies)
      (100
       (+ 1 2)
       (+ (+ 1 2) 3)
       (+ 1 (+ 2 3))
       (+ (+ 1 2) (+ 2 3))
       ;; (+ 1) discarded
       ;; "invalid" discarded
       (+ ≈1.23 ≈4.56)))))

;; Client format-policy: abort (simple)
(rack
  (frame
    (server (@pool (ws local 9813) format: text)
      (backsys
        {¦ in: (msg←"break" _*) out: (_* `reply)}
          <> {(msg): (), reply: ""})) ;; send empty message (invalid)
    (pool @pool)

    (cell @in break)
    (cell @out)
    (client (@in -> (ws local 9813) -> @out format: ml format-policy: abort)))

  (frame/tail fast-forward: true
    (server (@pool (ws local 9813) up format: text)
      (backsys
        {¦ in: (msg←"break" _*) out: (_* `reply)}
          <> {(msg): (), reply: ""})) ;; send empty message (invalid)
    (pool @pool)

    (cell @in)
    (cell @out)
    (client (@in -> (ws local 9813) -> @out format: ml format-policy: abort)
      (dn "format decode error"))))

;; Client format-policy: abort
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool (ws local 9813) format: binary)
        (cell @script ("(+ 1 2)" "(+ 1 error"))
        (feed (@script front) (@out back)))
      (pool @pool))

    (cell @message)
    (client (@message -> (ws local 9813) -> @replies format: ml format-policy: abort))
    (queue (@reply @replies) ()))

  (frame/tail fast-forward: true
    (cell @message)
    (client (@message -> (ws local 9813) -> @replies format: ml format-policy: abort)
      (dn "format decode error")) ;; connection was dropped on the client-side
    (queue (@reply @replies) ((+ 1 2)))))

