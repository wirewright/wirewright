;; Unix socket counter with link: portal
(rack
  (frame
    (cell @fs-in (delete file if exists "/tmp/wirewright-unix.sock"))
    (cell @fs-out)
    (fs @fs-in @fs-out)

    (guard (@fs-out [ok _])
      (server (@pool (unix "/tmp/wirewright-unix.sock" link: portal) format: ml)
        (backsys
          {¦ in: (±M _*) out: (_* `>M)}
            <> {(M): (), >M: ^(+ M 1)})))

    (pool @pool)

    (client (@in -> (unix "/tmp/wirewright-unix.sock" link: portal) -> @out format: ml))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

;; Connection in closed when both queues are removed
(rack
  (frame
    (server (@pool (ws local 9813) format: text)
      (backsys
        {¦ in: (msg_ _*) out_: (_* `>msg)}
          <> {(msg): (), >msg: ^msg}
        {¦ in_: ("bye" _*) out_}
          <> {(in): (), (out): ()}))

    ;; We must wait for the answer, orelse it's possible for us to quit
    ;; with "Hello World" still travelling over the wire!
    (cell @sent-bye)
    (backsys
      {¦ -msg_ reply -sent-bye_}
        <> {msg: "bye", sent-bye: true})

    (pool @pool)

    (cell @msg "Hello World")
    (queue (@reply @replies) ())
    (client (@msg -> (ws local 9813) -> @replies format: text)))

  (frame/tail fast-forward: true
    (cell @msg "bye")
    (queue (@reply @replies) ("Hello World"))
    (client (@msg -> (ws local 9813) -> @replies format: text) up))

  (frame/tail fast-forward: true
    (pool @pool)
    (cell @msg)
    (queue (@reply @replies) ("Hello World"))
    (client (@msg -> (ws local 9813) -> @replies format: text)
      (dn "connection closed by the other side"))))

;; Connection is closed when the corresponding client device is removed
(rack
  (frame
    (backsys @pool
      ⟨D←⟨(cell @remove-me true)⟩⟩°
        <> {(D): ()})

    (server (@pool (ws local 9813) format: text)
      (cell @remove-me)
      (backsys
        {¦ in: (msg←(%not "bye") _*) out_: (_* `>msg)}
          <> {(msg): (), >msg: ^msg}
        {¦ in: (msg←"bye" _*) -remove-me_}
          <> {(msg): (), remove-me: true}))

    ;; We must wait for the answer, orelse it's possible for us to quit
    ;; with "Hello World" still travelling over the wire!
    (cell @sent-bye)
    (backsys
      {¦ -msg_ reply -sent-bye_}
        <> {msg: "bye", sent-bye: true})

    (pool @pool)

    (cell @msg "Hello World")
    (queue (@reply @replies) ())
    (client (@msg -> (ws local 9813) -> @replies format: text)))

  (frame/tail fast-forward: true
    (pool @pool)

    (cell @msg)
    (queue (@reply @replies) ("Hello World"))
    (client (@msg -> (ws local 9813) -> @replies format: text)
      (dn "connection closed by the other side"))))

;; Connection is closed when the client is removed.
(rack
  (frame
    (server (@pool (ws local 9813) format: text)
      (feed (@in front) (@out back)))

    (pool @pool)

    (cell @in "Hi!")
    (cell @out)
    (guard (@out)
      (client (@in -> (ws local 9813) -> @out format: text))))

  (frame/tail fast-forward: true
    (pool @pool)

    (cell @in)
    (cell @out "Hi!")
    (guard (@out)
      (client (@in -> (ws local 9813) -> @out format: text)
        ;; The client was caught and frozen in the up state.
        up))))

;; Client connection is closed by replacing `up` with `dn`.
(rack
  (frame
    (server (@pool (ws local 9813) format: text)
      (feed (@in front) (@out back)))

    (backsys
      {¦ out client: (client _ state←up)}
        <> {state: dn})

    (pool @pool)

    (cell @in "Hi!")
    (cell @out)
    (frag @client
      (client (@in -> (ws local 9813) -> @out format: text))))

  (frame/tail fast-forward: true
    (pool @pool)

    (cell @in)
    (cell @out "Hi!")
    (frag @client
      (client (@in -> (ws local 9813) -> @out format: text) dn))))

;; Multiple servers and clients in the same world
(rack
  (frame
    (module {}
      (server (@pool (ws local 9813) format: text)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool (ws local 9814) format: text)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool (ws local 9815) format: text)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (cell @in "0")
      (cell @out)
      (guard (@out)
        (client (@in -> (ws local 9813) -> @out format: text))))

    (module {}
      (cell @in "1")
      (cell @out)
      (guard (@out)
        (client (@in -> (ws local 9814) -> @out format: text))))

    (module {}
      (cell @in "2")
      (cell @out)
      (guard (@out)
        (client (@in -> (ws local 9815) -> @out format: text)))))

  (frame/tail fast-forward: true
    (module {}
      (server (@pool (ws local 9813) up format: text)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool (ws local 9814) up format: text)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (server (@pool (ws local 9815) up format: text)
        (feed (@in front) (@out back)))
      (pool @pool))

    (module {}
      (cell @in)
      (cell @out "0")
      (guard (@out)
        ;; Frozen in the up state
        (client (@in -> (ws local 9813) -> @out format: text) up)))

    (module {}
      (cell @in)
      (cell @out "1")
      (guard (@out)
        (client (@in -> (ws local 9814) -> @out format: text) up)))

    (module {}
      (cell @in)
      (cell @out "2")
      (guard (@out)
        (client (@in -> (ws local 9815) -> @out format: text) up)))))

;; Multiple servers and clients in the same world, of different kinds.
;; Test input, output queue rename.
(rack
  (frame
    (module {}
      (server (@pool (ws local 9813) in: @queries out: @replies format: text)
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (server (@pool (tcp local 9814 link: portal) in: @queries out: @replies format: text)
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (server (@pool (unix "/tmp/wirewright-unix.sock") in: @queries out: @replies format: ml)
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (cell @in "0")
      (cell @out)
      (guard (@out)
        (client (@in -> (ws local 9813) -> @out format: text))))

    (module {}
      (cell @in "Hello World")
      (cell @out)
      (guard (@out)
        (client (@in -> (tcp local 9814 link: portal) -> @out format: text))))

    (module {}
      (cell @in (+ 1 2 x: 100 y: 200))
      (cell @out)
      (guard (@out)
        (client (@in -> (unix "/tmp/wirewright-unix.sock") -> @out format: ml)))))

  (frame/tail fast-forward: true
    (module {}
      (server (@pool (ws local 9813) up in: @queries out: @replies format: text)
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (server (@pool (tcp local 9814 link: portal) up in: @queries out: @replies format: text)
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (server (@pool (unix "/tmp/wirewright-unix.sock") up in: @queries out: @replies format: ml)
        (feed (@queries front) (@replies back)))
      (pool @pool))

    (module {}
      (cell @in)
      (cell @out "0")
      (guard (@out)
        ;; Frozen in the up state
        (client (@in -> (ws local 9813) -> @out format: text) up)))

    (module {}
      (cell @in)
      (cell @out "Hello World")
      (guard (@out)
        (client (@in -> (tcp local 9814 link: portal) -> @out format: text)
          up)))

    (module {}
      (cell @in)
      (cell @out (+ 1 2 x: 100 y: 200))
      (guard (@out)
        (client (@in -> (unix "/tmp/wirewright-unix.sock") -> @out format: ml)
          up)))))

;; Flow a value through several servers
(rack
  (frame
    (module {}
      (server (@pool (tcp local 9813) format: ml)
        (backsys
          {¦ in: (msg←{¦ signatures_dict⋮ (_* `>sign)} _*) out: (_* `>msg)}
            <> {>sign: alice, (msg): (), >msg: ^(up msg)}))
      (pool @pool))

    (module {}
      (server (@pool (tcp local 9814) format: ml)
        (backsys
          {¦ in: (msg←{¦ signatures_dict⋮ (_* `>sign)} _*) out: (_* `>msg)}
            <> {>sign: bob, (msg): (), >msg: ^(up msg)}))
      (pool @pool))

    (module {}
      (server (@pool (tcp local 9815) format: ml)
        (backsys
          {¦ in: (msg←{¦ signatures_dict⋮ (_* `>sign)} _*) out: (_* `>msg)}
            <> {>sign: charlie, (msg): (), >msg: ^(up msg)}))
      (pool @pool))

    (cell @a (+ 1 2))
    (cell @b)
    (cell @c)
    (cell @d)
    (client (@a -> (tcp local 9813) -> @b format: ml))
    (client (@b -> (tcp local 9814) -> @c format: ml))
    (client (@c -> (tcp local 9815) -> @d format: ml)))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b (+ 1 2 signatures: (alice)))
    (cell @c)
    (cell @d)
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up)
    (client (@c -> (tcp local 9815) -> @d format: ml) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c (+ 1 2 signatures: (alice bob)))
    (cell @d)
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up)
    (client (@c -> (tcp local 9815) -> @d format: ml) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c)
    (cell @d (+ 1 2 signatures: (alice bob charlie)))
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up)
    (client (@c -> (tcp local 9815) -> @d format: ml) up)))

;; Create a loop through two servers, increment a number
(rack
  (frame
    (module {}
      (server (@pool (tcp local 9813) format: ml)
        (backsys
          {¦ in: (±n _*) out: (_* `>n)}
            <> {(n): (), >n: ^(+ n 1)}))
      (pool @pool))

    (module {}
      (server (@pool (tcp local 9814) format: ml)
        (backsys
          {¦ in: (n_ _*) out: (_* `>n)}
            <> {(n): (), >n: (done ^n)}
          {¦ in: (n←(%number _ < 10) _*) out: (_* `>n)}
            <> {(n): (), >n: ^n}))
      (pool @pool))

    (backsys {¦ ±c -a_} <> {(c): (), a: ^c})

    (cell @a 0)
    (cell @b)
    (cell @c)
    (client (@a -> (tcp local 9813) -> @b format: ml))
    (client (@b -> (tcp local 9814) -> @c format: ml)))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b 1)
    (cell @c)
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c 1)
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up))

  (frame/tail fast-forward: true
    (cell @a 1)
    (cell @b)
    (cell @c)
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b 2)
    (cell @c)
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c 2)
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up))

  ;; ...

  (frame/tail fast-forward: true
    (cell @a 9)
    (cell @b)
    (cell @c)
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b 10)
    (cell @c)
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up))

  (frame/tail fast-forward: true
    (cell @a)
    (cell @b)
    (cell @c (done 10))
    (client (@a -> (tcp local 9813) -> @b format: ml) up)
    (client (@b -> (tcp local 9814) -> @c format: ml) up)))

;; Changing port on the same client to "dial" to a different server
(rack
  (frame
    (module {}
      (server (@pool (tcp local 9813) format: ml)
        (backsys
          {¦ in: (±n _*) out: (_* `>n)}
            <> {(n): (), >n: ^(+ n 1)}))
      (pool @pool))

    (module {}
      (server (@pool (tcp local 9814) format: ml)
        (backsys
          {¦ in: (±n _*) out: (_* `>n)}
            <> {(n): (), >n: ^(+ n 1)}))
      (pool @pool))

    (module {}
      (server (@pool (tcp local 9815) format: ml)
        (backsys
          {¦ in: (±n _*) out: (_* `>n)}
            <> {(n): (), >n: ^(+ n 1)}))
      (pool @pool))

    (backsys
      {¦ ±in client: (client [_ -> (tcp local `>port) -> _])}
        <> {>port: ^in}
      {¦ -in_ ±out client: (client [_ -> (tcp local port_) -> _] up)}
        <> {in: ^out, (out): (), port: ^out})

    (cell @in 9813)
    (cell @out)
    (frag @client
      (client (@in -> (tcp local) -> @out format: ml))))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out 9814)
    (frag @client
      (client (@in -> (tcp local 9813) -> @out format: ml)
        up)))

  (frame/tail fast-forward: true
    (cell @in 9814)
    (cell @out)
    (frag @client
      (client (@in -> (tcp local 9814) -> @out format: ml)
        up)))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out 9815)
    (frag @client
      (client (@in -> (tcp local 9814) -> @out format: ml)
        up)))

  (frame/tail fast-forward: true
    (cell @in 9815)
    (cell @out)
    (frag @client
      (client (@in -> (tcp local 9815) -> @out format: ml)
        up)))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out 9816)
    (frag @client
      (client (@in -> (tcp local 9815) -> @out format: ml)
        up)))

  (frame/tail fast-forward: true
    (cell @in 9816)
    (cell @out)
    (frag @client
      (client (@in -> (tcp local 9816) -> @out format: ml)
        up)))

  ;; Make sure all servers lost the connection. We have to use pattern: true
  ;; here because the error message in `pending` can be basically anything --
  ;; i.e. it's platform-dependent.
  (frame pattern: true fast-forward: true
    ((%literal
       (module {}
         (server (@pool (tcp local 9813) up format: ml)
           (backsys
             {¦ in: (±n _*) out: (_* `>n)}
               <> {(n): (), >n: ^(+ n 1)}))
         (pool @pool)))

     (%literal
       (module {}
         (server (@pool (tcp local 9814) up format: ml)
           (backsys
             {¦ in: (±n _*) out: (_* `>n)}
               <> {(n): (), >n: ^(+ n 1)}))
         (pool @pool)))

     (%literal
       (module {}
         (server (@pool (tcp local 9815) up format: ml)
           (backsys
             {¦ in: (±n _*) out: (_* `>n)}
               <> {(n): (), >n: ^(+ n 1)}))
         (pool @pool)))

     _*

     (cell @in 9816)
     (cell @out)
     (frag @client
       (client (@in -> (tcp local 9816) -> @out format: ml)
         (pending _string))))))

;; Server-side store example using surfaces
(rack
  (frame
    (module {:@store}
      (frag @sensor
        (sensor (queue commands command_)))
      (frag @report)
      (part (@sensor @command) (sensor _ command_ _*))
      (backsys
        {¦ command_} <> {(command): ()}
        {¦ command_: (tspace_ _) ⋮report}
          <> {(command): (), report: (appearance ^tspace (err "invalid command"))}
        {¦ command_: (tspace_ (get k_)) store: (%value k v_) ⋮report}
          <> {(command): (), report: (appearance ^tspace (ok ^v))}
        {¦ command_: (tspace_ (post k_ v'_)) store: (%-value k v) ⋮report}
          <> {(command): (), v: ^v', report: (appearance ^tspace ok)}
        {¦ command_: (tspace_ (put k_ v'_)) store: (%value k v_) ⋮report}
          <> {(command): (), v: ^v', report: (appearance ^tspace ok)}
        {¦ command_: (tspace_ (del k_)) store: (%value k v_) ⋮report}
          <> {(command): (), (v): (), report: (appearance ^tspace ok)}))

  (cell @store {})

  (server (@pool (ws local 9813) format: ml)
    ;; Remember that @id, @in, and @out are "shadow-inserted" by `server` for
    ;; each device!
    (frag @sensor)
    (frag @appearance)
    (backsys
      ;; Initialize the sensor which we'll use to receive reports.
      {¦ id_ -sensor_}
        <> {sensor: (sensor (queue ^id _))}
      ;; Relay commands through an appearance. Require the sensor to be initialized!
      {¦ id_ in: (command_ _*) sensor ⋮appearance}
        <> {(command): (), appearance: (appearance commands (^id ^command))}
      ;; Relay reports.
      {¦ out: (_* `>report) sensor: (sensor _ report_ _*)}
        <> {>report: ^report, (report): ()}))

  (pool @pool)

  (circuit @clients
    ;; Alice
    (device role: alice
      (cell @in)
      (cell @out)
      (client (@in -> (ws local 9813 key: alice) -> @out format: ml)))

    ;; Bob
    (device role: bob
      (cell @in)
      (cell @out)
      (client (@in -> (ws local 9813 key: bob) -> @out format: ml))))

  (backsys
    {¦ line_: (role_ command_)
       clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
      <> {(line): (), >command: ^command}
    {¦ line_: (?expect role_ expectation_)
       clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
      <> {(line): (), (expectation): ()}
    {¦ line_: (?expect store store_) store_}
      <> {(line): ()})

  (part (@script @line) (line_ _*))

  (cell @script
    ((alice (post x 100))
     (?expect alice ok)
     (?expect store {x: 100})

     (alice (get x))
     (?expect alice (ok 100))

     (bob (get x))
     (?expect bob (ok 100))

     (bob (post x "Hello"))
     (?expect bob (err "invalid command"))

     (bob (put x "Hello"))
     (?expect bob ok)

     (?expect store {x: "Hello"})

     (bob (post y 200))
     (?expect bob ok)

     (alice (get y))
     (?expect alice (ok 200))

     (alice (get z))
     (?expect alice (err "invalid command"))

     (?expect store {x: "Hello", y: 200})

     (alice (del y))
     (?expect alice ok)

     (bob (get y))
     (?expect bob (err "invalid command"))

     (?expect store {x: "Hello"}))))

  (frame/tail fast-forward: true
    (cell @script ())))

;; Distributed store
(rack
  (frame
    (server (@pool (ws local 9813) format: ml)
      (frag @sensor
        (sensor (view store (_ _))))
      (circuit @appearances)
      (backsys
        ;; Fallback.
        {¦ in: (M_ _*) out: (_* `reply)}
          <> {(M): (), reply: (err "invalid command")}
        ;; GET retrieves a value.
        {¦ in: (M←(get k_) _*) out: (_* `reply) sensor: (sensor _ …⟨(k_ v_)⟩…)}
          <> {(M): (), reply: (ok ^v)}
        ;; POST publishes a value...
        {¦ in: (M←(post k_ v_) _*) out: (_* `reply) appearances_dict⋮ (_* `>appearance)}
          <> {(M): (), reply: ok, >appearance: (appearance store (^k ^v))}
        ;; ... but only if it is globally absent.
        {¦ in: (M←(post k_ _) _*) out: (_* `reply) sensor: (sensor _ …⟨(k_ _)⟩…)}
          <> {(M): (), reply: (err "invalid command")}
        ;; PUT changes the value of an entry *this client* ows.
        {¦ in: (M←(put k_ v'_) _*) out: (_* `reply) appearances: ⟨(appearance store (k_ v_))⟩}
          <> {(M): (), reply: ok, v: ^v'}
        ;; DEL removes an entry *this client* owns.
        {¦ in: (M←(del k_) _*) out: (_* `reply) appearances: ⟨A←(appearance store (k_ _))⟩}
          <> {(M): (), reply: ok, (A): ()}))

    (pool @pool)

    (circuit @clients
      ;; Alice
      (device role: alice
        (cell @in)
        (cell @out)
        (client (@in -> (ws local 9813 key: alice) -> @out format: ml)))

      ;; Bob
      (device role: bob
        (cell @in)
        (cell @out)
        (client (@in -> (ws local 9813 key: bob) -> @out format: ml))))

    (backsys
      {¦ line_: (role_ command_)
         clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
        <> {(line): (), >command: ^command}
      {¦ line_: (?expect role_ expectation_)
         clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
        <> {(line): (), (expectation): ()}
      {¦ line_: (!expel role_)
         pool_dict
         clients: ⟨(device (cell @in) (cell @out) (client _ state←up) ⍊ role_)⟩}
        <> {line: (!wait ^(size pool)), state: dn}
      {¦ line_: (!wait (%number _ > (var n))) pool: (%pipe size n_)}
        <> {(line): ()})

    (part (@script @line) (line_ _*))

    (cell @script
      ((alice (post x 100))
       (?expect alice ok)

       (alice (post x "Hello"))
       (?expect alice (err "invalid command"))

       (bob (get x))
       (?expect bob (ok 100))

       (bob (get y))
       (?expect bob (err "invalid command"))

       (bob (post y 200))
       (?expect bob ok)

       (alice (get y))
       (?expect alice (ok 200))

       (alice (post y "hello"))
       (?expect alice (err "invalid command"))

       (alice (put y "hello"))
       (?expect alice (err "invalid command"))

       (alice (put x "hello"))
       (?expect alice ok)

       (bob (get x))
       (?expect bob (ok "hello"))

       (alice (put z 300))
       (?expect alice (err "invalid command"))

       (alice (post z (+ 1 2 precision: 3)))
       (?expect alice ok)

       (bob (get z))
       (?expect bob (ok (+ 1 2 precision: 3)))

       (bob (del z))
       (?expect bob (err "invalid command"))

       (alice (del x))
       (?expect alice ok)

       (alice (del y))
       (?expect alice (err "invalid command"))

       (alice (get x))
       (?expect alice (err "invalid command"))

       (bob (get x))
       (?expect bob (err "invalid command"))

       (alice (get y))
       (?expect alice (ok 200))

       (bob (get z))
       (?expect bob (ok (+ 1 2 precision: 3)))

       (alice (post x "Hello World"))
       (?expect alice ok)

       (bob (get x))
       (?expect bob (ok "Hello World"))

       (!expel alice)

       ;; Alice's x is lost!
       (bob (get x))
       (?expect bob (err "invalid command"))

       ;; Alice's z is lost!
       (bob (get z))
       (?expect bob (err "invalid command"))

       ;; Bob can now define x (and y)
       (bob (post x "Bob's x"))
       (?expect bob ok)

       (bob (get x))
       (?expect bob (ok "Bob's x"))

       (bob (del x))
       (?expect bob ok)

       (bob (del y))
       (?expect bob ok)

       ;; We've removed everything

       (bob (get x))
       (?expect bob (err "invalid command"))

       (bob (get y))
       (?expect bob (err "invalid command"))

       (bob (get z))
       (?expect bob (err "invalid command")))))

  (frame/tail fast-forward: true
    (cell @script ())))

;; Communication between peers through a "god-like" observer
(rack
  (frame
    (server (@pool (ws local 9813) format: ml)
      (cell @name)
      (backsys
        {¦ in: (msg_ _*) out: (_* `>msg) -name_}
          <> {(msg): (), >msg: ok, name: ^msg}))

    (pool @pool)

    (backsys @pool
      ⟨& (device …⟨& (cell @in (M←(receiver_ msg_) _*)) (cell @out (_* `>report))⟩…)
         (device …⟨& (cell @name receiver_) (cell @out (_* `>msg))⟩…)⟩°
        <> {(M): (), >report: ok, >msg: ^msg})

    (circuit @clients
      ;; Alice
      (device role: alice
        (cell @in)
        (cell @out)
        (client (@in -> (ws local 9813 key: alice) -> @out format: ml)))

      ;; Bob
      (device role: bob
        (cell @in)
        (cell @out)
        (client (@in -> (ws local 9813 key: bob) -> @out format: ml))))

    (backsys
      {¦ line_: (role_ command_)
         clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
        <> {(line): (), >command: ^command}
      {¦ line_: (?expect role_ expectation_)
         clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
        <> {(line): (), (expectation): ()})

    (part (@script @line) (line_ _*))

    (cell @script
      ((alice "Alice")
       (?expect alice ok)

       (bob "Bob")
       (?expect bob ok)

       (alice ("Bob" "Hello Bob!"))
       (?expect alice ok)
       (?expect bob "Hello Bob!")

       (alice ("Bob" "Second message"))
       (?expect alice ok)

       (alice ("Bob" "Third message, checking how it all queues, Bob!"))
       (?expect alice ok)

       (?expect bob "Second message")
       (?expect bob "Third message, checking how it all queues, Bob!")

       (bob ("Alice" "Hello Alice!"))
       (?expect bob ok)
       (?expect alice "Hello Alice!"))))

  (frame/tail fast-forward: true
    (cell @script ())))

;; Same servers with different links must conflict (tcp)
(rack
  (frame
    (server (@pool (tcp local 9813 link: direct) format: binary))
    (server (@pool (tcp local 9813 link: portal) format: binary))
    (pool @pool))

  (frame pattern: true fast-forward: true
    (%any°
      ((server (@pool (tcp local 9813 link: direct) up format: binary))
       (server (@pool (tcp local 9813 link: portal) (pending _string) format: binary))
       (pool @pool))

      ((server (@pool (tcp local 9813 link: direct) (pending _string) format: binary))
       (server (@pool (tcp local 9813 link: portal) up format: binary))
       (pool @pool)))))

;; Same servers with different links must conflict (ws)
(rack
  (frame
    (server (@pool (ws local 9813 link: direct) format: binary))
    (server (@pool (ws local 9813 link: portal) format: binary))
    (pool @pool))

  (frame pattern: true fast-forward: true
    (%any°
      ((server (@pool (ws local 9813 link: direct) up format: binary))
       (server (@pool (ws local 9813 link: portal) (dn "conflicting `link:`s for the same host and port") format: binary))
       (pool @pool))

      ((server (@pool (ws local 9813 link: direct) (dn "conflicting `link:`s for the same host and port") format: binary))
       (server (@pool (ws local 9813 link: portal) up format: binary))
       (pool @pool)))))

;; Nesting: client inside client device
(rack
  (frame
    (server (@pool (ws local 9814) format: binary)
      (client (@request -> (ws local 9813 key: @id) -> @response format: binary))
      (part (@in @request) (request_ _*))
      ;; TODO: (part (@out @response) (_* `response))
      (cell @response)
      (feed @response (@out back)))

    (circuit @clients
      ;; Alice
      (device role: alice
        (cell @in)
        (cell @out)
        (client (@in -> (ws local 9814 key: alice) -> @out format: ml)))

      ;; Bob
      (device role: bob
        (cell @in)
        (cell @out)
        (client (@in -> (ws local 9814 key: bob) -> @out format: ml))))

    (backsys
      {¦ line_: (role_ command_)
         clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
        <> {(line): (), >command: ^command}
      {¦ line_: (?expect role_ expectation_)
         clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
        <> {(line): (), (expectation): ()}
      {¦ line_: (!expel role_)
         pool_dict
         clients: ⟨(device (cell @in) (cell @out) (client _ state←up) ⍊ role_)⟩}
        <> {line: (!wait ^(size pool)), state: dn}
      {¦ line_: (!wait (%number _ > (var n))) pool: (%pipe size n_)}
        <> {(line): ()})

    (part (@script @line) (line_ _*))

    (module {}
      (server (@pool (ws local 9813) format: binary)
        (feed (@in front) (@out back)))
      (pool @pool))

    (pool @pool)

    (cell @script
      ((alice "Hello in Alice")
       (?expect alice "Hello in Alice")

       (bob "Hello in Bob")
       (?expect bob "Hello in Bob")

       (!expel alice)

       (bob "Hello in Bob")
       (?expect bob "Hello in Bob")

       (!expel bob))))

  (frame/tail fast-forward: true
    ;; The auxiliary server should not have any connections as well.
    (module {}
      (server (@pool (ws local 9813) up format: binary)
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; The main server should not have any connections.
    (pool @pool)

    (cell @script ())))

;; Nesting: server inside client device
(rack
  (frame
    (server (@pool (ws local 9813) format: ml)
      (cell @role)

      (guard (@role server)
        (module {}
          (server (@pool (ws local 9814) format: text)
            (feed (@in front) (@out back)))
          (pool @pool)))

      (guard (@role client)
        (cell @client-in)
        (cell @client-out)
        (client (@client-in -> (ws local 9814 key: @id renew: true) -> @client-out format: text)))

      (backsys
        {¦ in: (M←(role r_) _*) out: (_* `reply) ⋮role}
          <> {(M): (), reply: ok, role: ^r}
        {¦ in: (M←(send msg_) _*) out: (_* `reply) -client-in_}
          <> {(M): (), reply: ok, client-in: ^msg}
        {¦ in: (M←receive _*) out: (_* `reply) client-out_}
          <> {(M): (), reply: (ok ^client-out), (client-out): ()}))

    (pool @pool)

    (circuit @clients
      ;; Alice
      (device role: alice
        (cell @in)
        (cell @out)
        (client (@in -> (ws local 9813 key: alice renew: true) -> @out format: ml)))

      ;; Bob
      (device role: bob
        (cell @in)
        (cell @out)
        (client (@in -> (ws local 9813 key: bob renew: true) -> @out format: ml)))

      ;; Charlie
      (device role: charlie
        (cell @in)
        (cell @out)
        (client (@in -> (ws local 9813 key: charlie renew: true) -> @out format: ml))))

    (backsys
      {¦ line_: (role_ command_)
         clients: ⟨(device (cell @in `>command) (cell @out) (client _ up) ⍊ role_)⟩}
        <> {(line): (), >command: ^command}
      {¦ line_: (?expect role_ expectation_)
         clients: ⟨(device (cell @in) (cell @out expectation_) (client _ up) ⍊ role_)⟩}
        <> {(line): (), (expectation): ()}
      {¦ line_: (!expel role_)
         pool_dict
         clients: ⟨(device (cell @in) (cell @out) (client _ state←up) ⍊ role_)⟩}
        <> {line: (!wait ^(size pool)), state: dn}
      {¦ line_: (!wait (%number _ > (var n))) pool: (%pipe size n_)}
        <> {(line): ()})

    (part (@script @line) (line_ _*))

    (cell @script
      ((alice (role server))
       (?expect alice ok)

       (bob (role client))
       (?expect bob ok)

       (bob (send "Kaixo"))
       (?expect bob ok)

       (bob receive)
       (?expect bob (ok "Kaixo"))

       (charlie (role client))
       (?expect charlie ok)

       (charlie (send "Hello"))
       (?expect charlie ok)

       (charlie (send "World"))
       (?expect charlie ok)

       (charlie receive)
       (?expect charlie (ok "Hello"))

       (charlie receive)
       (?expect charlie (ok "World"))

       ;; Lose our server!
       (!expel alice)

       ;; Change the role of Bob. He is now the server!
       (bob (role server))
       (?expect bob ok)

       ;; Only Charlie remains. He should still be able to send messages -- thanks
       ;; to retries after he lost connection with Alice.
       (charlie (send "Hi again"))
       (?expect charlie ok)

       (charlie receive)
       (?expect charlie (ok "Hi again")))))

  (frame/tail fast-forward: true
    (cell @script ())))

;; Duplicated server is noop with the same pool
(rack
  (frame
    (server (@pool (ws local 9813) format: text)
      (feed (@in front) (@out back)))
    (server (@pool (ws local 9813) format: text)
      (feed (@in front) (@out back)))

    (pool @pool)

    (cell @in "Kaixo mundua")
    (cell @out)
    (guard (@out)
      (client (@in -> (ws local 9813) -> @out format: text))))

  (frame/tail fast-forward: true
    (pool @pool)

    (cell @in)
    (cell @out "Kaixo mundua")
    (guard (@out)
      (client (@in -> (ws local 9813) -> @out format: text) up))))

;; Duplicated server with a different pool is an exact replica
(rack
  (frame
    (server (@pool0 (ws local 9813) format: text)
      (feed (@in front) (@out back)))
    (server (@pool1 (ws local 9813) format: text)
      (feed (@in front) (@out back)))

    (pool @pool0)
    (pool @pool1)

    (cell @in "Kaixo mundua")
    (cell @out)
    (discard @out)
    (client (@in -> (ws local 9813) -> @out format: text)))

  (frame pattern: true fast-forward: true
    (_*

     (pool @pool0
       (device
         …⟨& (cell @id id_) (cell @out ("Kaixo mundua"))⟩…))

     (pool @pool1
       (device
         …⟨& (cell @id id_) (cell @out ("Kaixo mundua"))⟩…))

     (cell @in)
     (cell @out)
     (discard @out)
     (client (@in -> (ws local 9813) -> @out format: text) up)))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out "Kaixo mundua")
    (discard @out)
    (client (@in -> (ws local 9813) -> @out format: text) up))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out)
    (discard @out)
    (client (@in -> (ws local 9813) -> @out format: text) up)))
