;; Client format: json
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool ((binary @in) -> (ws local 9813) -> (binary @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; Client
    (module {}
      (queue (@message @messages)
        (100
         (+ 1 2)
         (+ 1 2 x: 100 y: 200)
         "hello world\n"))
      (client ((json @message) -> (ws local 9813) -> (json @replies)))
      (queue (@reply @replies) ())))

  (frame/tail fast-forward: true
    (module {}
      (queue (@message @messages) ())
      (client ((json @message) -> (ws local 9813) -> (json @replies))
        up)
      (queue (@reply @replies)
        (100
         ("+" 1 2)
         ;; Since there's no schema, this is the best format: json can do!
         {"0": "+", "1": 1, "2": 2, "x": 100, "y": 200}
         "hello world\n")))))

;; Client format: json schema
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool ((binary @in) -> (ws local 9813) -> (binary @out)))
        (feed (@in front) (@out back)))
      (pool @pool))

    ;; Client
    (schema (@schema json)
      expr => _number
      expr => (seq + (ref expr) (ref expr)))

    (client (((json @schema expr) @message) -> (ws local 9813) -> ((json @schema expr) @replies)))
    (queue (@message @messages)
      (100
       (+ 1 2)
       (+ (+ 1 2) 3)
       (+ 1 (+ 2 3))
       (+ (+ 1 2) (+ 2 3))
       (+ 1)
       "invalid"
       (+ 1.23 4.56)))
    (queue (@reply @replies) ()))

  (frame/tail fast-forward: true
    (queue (@message @messages) ())
    (queue (@reply @replies)
      (100
       (+ 1 2)
       (+ (+ 1 2) 3)
       (+ 1 (+ 2 3))
       (+ (+ 1 2) (+ 2 3))
       ;; (+ 1) discarded
       ;; "invalid" discarded
       (+ ≈1.23 ≈4.56)))))

;; Client-side decode error
(rack
  (frame
    (server (@pool ((text @in) -> (ws local 9813) -> (text @out)))
      (backsys
        {¦ in: (msg←"break" _*) out: (_* `reply)}
          <> {(msg): (), reply: ""})) ;; send empty message (invalid)
    (pool @pool)

    (cell @in break)
    (cell @out)
    (client ((ml @in) -> (ws local 9813) -> (ml @out policy: wrap))))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out (err "message decode error"))
    (client ((ml @in) -> (ws local 9813) -> (ml @out policy: wrap)) up)))

;; Client-side encode error (clog)
(rack
  (frame
    (server (@pool ((binary @in) -> (ws local 9813) -> (binary @out)))
      (feed (@in front) (@out back)))
    (pool @pool)

    (cell @in (+ 1 2))
    (cell @out)
    (client ((binary @in) -> (ws local 9813) -> (binary @out))))

  (frame/tail fast-forward: true
    (cell @in (+ 1 2))
    (cell @out)
    (client ((binary @in) -> (ws local 9813) -> (binary @out))
      up)))

;; Client-side encode error (discard)
(rack
  (frame
    (server (@pool ((binary @in) -> (ws local 9813) -> (binary @out)))
      (feed (@in front) (@out back)))
    (pool @pool)

    (cell @in (+ 1 2))
    (cell @out)
    (client ((binary @in policy: discard) -> (ws local 9813) -> (binary @out))))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out)
    (client ((binary @in policy: discard) -> (ws local 9813) -> (binary @out))
      up)))

;; Server-side encode error
(rack
  (frame
    (server (@pool ((text @in) -> (ws local 9813) -> (text @out policy: discard)))
      (cell @wrong (+ 1 2))
      (feed @wrong (@out back)))
    (pool @pool)

    (cell @in)
    (cell @out)
    (client ((text @in) -> (ws local 9813) -> (text @out))))

  (frame pattern: true fast-forward: true
    (_*
     (pool @pool
       (device
         (cell @id _)
         (cell @in ())
         (cell @out ())
         (cell @wrong)
         (feed @wrong (@out back))))

     (cell @in)
     (cell @out)
     (client ((text @in) -> (ws local 9813) -> (text @out)) up))))

;; Client format-policy: wrap
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool ((binary @in) -> (ws local 9813) -> (binary @out)))
        (cell @script ("(+ 1 2)" "(+ 1 error"))
        (feed (@script front) (@out back)))
      (pool @pool))

    (cell @message)
    (client ((ml @message) -> (ws local 9813) -> (ml @replies policy: wrap)))
    (queue (@reply @replies) ()))

  (frame/tail fast-forward: true
    (cell @message)
    (client ((ml @message) -> (ws local 9813) -> (ml @replies policy: wrap))
      up)
    (queue (@reply @replies)
      ((ok (+ 1 2))
       (err "message decode error")))))

;; Client-Server exchange using terms
(rack
  (frame
    (module {}
      (server (@pool ((ml @in) -> (ws local 9813) -> (ml @out)))
        (backsys
          {¦ in: (msg_ _*)}
            <> {(msg): ()}
          {¦ in: (n←(%number 0 <= _ < 5) _*) out: (_* `>n)}
            <> {>n: ^(+ n 1)}
          {¦ in: (5 _*) out: (_* `>reply)}
            <> {>reply: done}))

      (pool @pool))

    (backsys
      {¦ reply_ log: (_* `>reply)}
        <> {(reply): (), >reply: ^reply}
      {¦ ±reply -messages_}
        <> {messages: ^reply}
      {¦ reply: done socket_}
        <> {(socket): ()})

    (cell @log ())
    (queue (@message @messages) (0))
    (frag @socket
      (client ((ml @message) -> (ws local 9813) -> (ml @replies))))
    (queue (@reply @replies) ()))

  ;; Wait until it counts up to `done`.
  (frame/tail fast-forward: true
    (cell @log (1 2 3 4 5))
    (queue (@message @messages) ())
    (frag @socket
      (client ((ml @message) -> (ws local 9813) -> (ml @replies))
        up))
    (queue (@reply @replies) (done)))

  ;; Socket is removed in response to `done`:
  (frame/tail
    (cell @log (1 2 3 4 5 done))
    (queue (@message @messages) ())
    (frag @socket)
    (queue (@reply @replies) ()))

  ;; Make sure the server responds properly by cleaning up the connection.
  (frame/tail fast-forward: true
    (module {}
      (server (@pool ((ml @in) -> (ws local 9813) -> (ml @out)) up) ;; < server is up
        (backsys
          {¦ in: (msg_ _*)}
            <> {(msg): ()}
          {¦ in: (n←(%number 0 <= _ < 5) _*) out: (_* `>n)}
            <> {>n: ^(+ n 1)}
          {¦ in: (5 _*) out: (_* `>reply)}
            <> {>reply: done}))

      (pool @pool)) ;; < pool is empty -- client disconnected

    (backsys
      {¦ reply_ log: (_* `>reply)}
        <> {(reply): (), >reply: ^reply}
      {¦ ±reply -messages_}
        <> {messages: ^reply}
      {¦ reply: done socket_}
        <> {(socket): ()})

    (cell @log (1 2 3 4 5 done))
    (queue (@message @messages) ())
    (frag @socket)
    (queue (@reply @replies) ())))

;; From docs: websocket client with format: ml.
(rack
  (frame
    (server (@pool ((binary @in) -> (ws local 9813) -> (binary @out)))
      (feed (@in front) (@out back)))
    (pool @pool)
    (queue (@message @messages) (foo 100 ≈1.23 false (+ 1 2 x: 100 y: 200)))
    (queue (@reply @replies) ())
    (client ((ml @message) -> (ws local 9813) -> (ml @replies))))

  (frame/tail fast-forward: true
    (queue (@message @messages) ())
    (queue (@reply @replies) (foo 100 ≈1.23 false (+ 1 2 x: 100 y: 200)))
    (client ((ml @message) -> (ws local 9813) -> (ml @replies))
      up)))

;; WebSocket counter
(rack
  (frame
    (server (@pool ((ml @in) -> (ws local 9813) -> (ml @out)))
      (backsys
        {¦ in: (±M _*) out: (_* `>M)}
          <> {(M): (), >M: ^(+ M 1)}))

    (pool @pool)

    (client ((ml @in) -> (ws local 9813) -> (ml @out)))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

;; TCP counter
(rack
  (frame
    (server (@pool ((ml @in) -> (tcp local 9813) -> (ml @out)))
      (backsys
        {¦ in: (±M _*) out: (_* `>M)}
          <> {(M): (), >M: ^(+ M 1)}))

    (pool @pool)

    (client ((ml @in) -> (tcp local 9813) -> (ml @out)))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

;; Unix socket counter
(rack
  (frame
    (cell @fs-in (delete file if exists "/tmp/wirewright-unix.sock"))
    (cell @fs-out)
    (fs @fs-in @fs-out)

    (guard (@fs-out [ok _])
      (server (@pool ((ml @in) -> (unix "/tmp/wirewright-unix.sock") -> (ml @out)))
        (backsys
          {¦ in: (±M _*) out: (_* `>M)}
            <> {(M): (), >M: ^(+ M 1)})))

    (pool @pool)

    (client ((ml @in) -> (unix "/tmp/wirewright-unix.sock") -> (ml @out)))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

;; WebSocket counter with link: handoff
(rack
  (frame
    (server (@pool ((ml @in) -> (ws local 9813 link: handoff) -> (ml @out)))
      (backsys
        {¦ in: (±M _*) out: (_* `>M)}
          <> {(M): (), >M: ^(+ M 1)}))

    (pool @pool)

    (client ((ml @in) -> (ws local 9813 link: handoff) -> (ml @out)))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

