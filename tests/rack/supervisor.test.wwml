;; Basic
(rack
  (frame
    (supervisor (@values @value {¦ key_} - @pool)
      (part (@value @count) {¦ ±count})
      (backsys @count ±n <> {n: ^(+ n 1)}))

    (cell @values
      ({key: 1, count: 0}
       {key: 2, count: 0}
       {key: 3, count: 0}))

    (pool @pool))

  (frame/tail
    (cell @values
      ({key: 1, count: 1}
       {key: 2, count: 1}
       {key: 3, count: 1}))

    (pool @pool
      (device
        (cell @reference {key: 1, count: 1})
        (cell @value {key: 1, count: 1})
        (part (@value @count) {¦ ±count})
        (backsys @count ±n <> {n: ^(+ n 1)}))
      (device
        (cell @reference {key: 2, count: 1})
        (cell @value {key: 2, count: 1})
        (part (@value @count) {¦ ±count})
        (backsys @count ±n <> {n: ^(+ n 1)}))
      (device
        (cell @reference {key: 3, count: 1})
        (cell @value {key: 3, count: 1})
        (part (@value @count) {¦ ±count})
        (backsys @count ±n <> {n: ^(+ n 1)}))))

  (frame/tail
    (cell @values
      ({key: 1, count: 2}
       {key: 2, count: 2}
       {key: 3, count: 2}))

    (pool @pool
      (device
        (cell @reference {key: 1, count: 2})
        (cell @value {key: 1, count: 2})
        (part (@value @count) {¦ ±count})
        (backsys @count ±n <> {n: ^(+ n 1)}))
      (device
        (cell @reference {key: 2, count: 2})
        (cell @value {key: 2, count: 2})
        (part (@value @count) {¦ ±count})
        (backsys @count ±n <> {n: ^(+ n 1)}))
      (device
        (cell @reference {key: 3, count: 2})
        (cell @value {key: 3, count: 2})
        (part (@value @count) {¦ ±count})
        (backsys @count ±n <> {n: ^(+ n 1)})))))
  ;; ...

;; Essentials
(rack
  (frame
    (cell @clock 0)
    (backsys @clock ±t <> {t: ^(+ t 1)})

    ;; Key added, device added.
    (guard (@clock 0)
      (backsys @xs (_* `x) <> {x: (a 100)}))
    (guard (@clock 1)
      (backsys @xs (_* `x) <> {x: (b 200)}))
    (guard (@clock 2)
      (backsys @xs (_* `x) <> {x: (c 300)}))

    ;; let it evolve for 3..<6

    ;; Key removed, device removed.
    (guard (@clock 6)
      (backsys @xs (x_ _*) <> {(x): ()}))

    ;; Key turnover (same key, different item), item changed, device updated.
    (guard (@clock 7)
      (backsys @xs (_* x_) <> {x: (c 400)}))

    ;; Item changed, device updated.
    (guard (@clock 8)
      (backsys @xs (x_ _*) <> {x: (foo 234)}))

    ;; let it evolve for 9

    ;; Key conflict, both devices removed.
    (guard (@clock 10)
      (backsys @xs (_* `x) <> {x: (foo 123)}))

    ;; let it evolve for 11

    ;; Key conflict resolved, device reintroduced.
    (guard (@clock 12)
      (backsys @xs (x_ _*) <> {(x): ()}))

    ;; let it evolve for 13..<15

    ;; Remove list
    (guard (@clock 15)
      (backsys {¦ xs_} <> {(xs): ()}))

    ;; Reintroduce list
    (guard (@clock 16)
      (backsys {¦ -xs_} <> {xs: ((qux 100) (qyx 200))}))

    (supervisor (@xs @x (key_ _) - @pool)
      (cell @state 0)
      (backsys
        ;; Make sure we have read-only access to the item.
        {¦ x: (_ ±n)} <> {n: ^(+ n 1)}
        ;; Make sure we can modify internal state.
        {¦ ±state} <> {state: ^(+ state 1)}))

    (cell @xs ())
    (pool @pool))

  (frame pattern: true
    (_*
     (cell @xs ((a 100)))
     (pool @pool
       (device (cell @reference _) (cell @x (a 100)) (cell @state 0) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((a 101) (b 200)))
     (pool @pool
       (device (cell @reference _) (cell @x (a 101)) (cell @state 1) _*)
       (device (cell @reference _) (cell @x (b 200)) (cell @state 0) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((a 102) (b 201) (c 300)))
     (pool @pool
       (device (cell @reference _) (cell @x (a 102)) (cell @state 2) _*)
       (device (cell @reference _) (cell @x (b 201)) (cell @state 1) _*)
       (device (cell @reference _) (cell @x (c 300)) (cell @state 0) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((a 103) (b 202) (c 301)))
     (pool @pool
       (device (cell @reference _) (cell @x (a 103)) (cell @state 3) _*)
       (device (cell @reference _) (cell @x (b 202)) (cell @state 2) _*)
       (device (cell @reference _) (cell @x (c 301)) (cell @state 1) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((a 104) (b 203) (c 302)))
     (pool @pool
       (device (cell @reference _) (cell @x (a 104)) (cell @state 4) _*)
       (device (cell @reference _) (cell @x (b 203)) (cell @state 3) _*)
       (device (cell @reference _) (cell @x (c 302)) (cell @state 2) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((a 105) (b 204) (c 303)))
     (pool @pool
       (device (cell @reference _) (cell @x (a 105)) (cell @state 5) _*)
       (device (cell @reference _) (cell @x (b 204)) (cell @state 4) _*)
       (device (cell @reference _) (cell @x (c 303)) (cell @state 3) _*))))

  ;; remove a
  (frame pattern: true
    (_*
     (cell @xs ((b 205) (c 304)))
     (pool @pool
       (device (cell @reference _) (cell @x (b 205)) (cell @state 5) _*)
       (device (cell @reference _) (cell @x (c 304)) (cell @state 4) _*))))

  ;; change c
  (frame pattern: true
    (_*
     (cell @xs ((b 206) (c 400)))
     (pool @pool
       (device (cell @reference _) (cell @x (b 206)) (cell @state 6) _*)
       (device (cell @reference _) (cell @x (c 400)) (cell @state 5) _*))))

  ;; replace (b 200) -> (foo 234), note how pool order is the same as values order
  (frame pattern: true
    (_*
     (cell @xs ((foo 234) (c 401)))
     (pool @pool
       (device (cell @reference _) (cell @x (foo 234)) (cell @state 0) _*)
       (device (cell @reference _) (cell @x (c 401)) (cell @state 6) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((foo 235) (c 402)))
     (pool @pool
       (device (cell @reference _) (cell @x (foo 235)) (cell @state 1) _*)
       (device (cell @reference _) (cell @x (c 402)) (cell @state 7) _*))))

  ;; Collide key foo
  ;; Devices with colliding keys disappear
  (frame pattern: true
    (_*
     (cell @xs ((foo 235) (c 403) (foo 123)))
     (pool @pool
       (device (cell @reference _) (cell @x (c 403)) (cell @state 8) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((foo 235) (c 404) (foo 123)))
     (pool @pool
       (device (cell @reference _) (cell @x (c 404)) (cell @state 9) _*))))

  ;; Collision is removed
  (frame pattern: true
    (_*
     (cell @xs ((c 405) (foo 123)))
     (pool @pool
       (device (cell @reference _) (cell @x (c 405)) (cell @state 10) _*)
       (device (cell @reference _) (cell @x (foo 123)) (cell @state 0) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((c 406) (foo 124)))
     (pool @pool
       (device (cell @reference _) (cell @x (c 406)) (cell @state 11) _*)
       (device (cell @reference _) (cell @x (foo 124)) (cell @state 1) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((c 407) (foo 125)))
     (pool @pool
       (device (cell @reference _) (cell @x (c 407)) (cell @state 12) _*)
       (device (cell @reference _) (cell @x (foo 125)) (cell @state 2) _*))))

  ;; List is emptied
  (frame pattern: true
    (_*
     (cell @xs)
     (pool @pool)))

  ;; List is reintroduced
  (frame pattern: true
    (_*
     (cell @xs ((qux 100) (qyx 200)))
     (pool @pool
       (device (cell @reference _) (cell @x (qux 100)) (cell @state 0) _*)
       (device (cell @reference _) (cell @x (qyx 200)) (cell @state 0) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((qux 101) (qyx 201)))
     (pool @pool
       (device (cell @reference _) (cell @x (qux 101)) (cell @state 1) _*)
       (device (cell @reference _) (cell @x (qyx 201)) (cell @state 1) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((qux 102) (qyx 202)))
     (pool @pool
       (device (cell @reference _) (cell @x (qux 102)) (cell @state 2) _*)
       (device (cell @reference _) (cell @x (qyx 202)) (cell @state 2) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((qux 103) (qyx 203)))
     (pool @pool
       (device (cell @reference _) (cell @x (qux 103)) (cell @state 3) _*)
       (device (cell @reference _) (cell @x (qyx 203)) (cell @state 3) _*)))))
  ;; ...

;; Rotate
(rack
  (frame
    (supervisor (@values @value key_ - @pool)
      (backsys @value ±n <> {n: ^(+ n 1)}))
    (pool @pool)
    (cell @values (1 2 3)))

  (frame pattern: true
    (_*
     (pool @pool
       (device …⟨(cell @value 2)⟩…)
       (device …⟨(cell @value 3)⟩…)
       (device …⟨(cell @value 4)⟩…))
     (cell @values (2 3 4))))

  (frame pattern: true
    (_*
     (pool @pool
       (device …⟨(cell @value 3)⟩…)
       (device …⟨(cell @value 4)⟩…)
       (device …⟨(cell @value 5)⟩…))
     (cell @values (3 4 5))))

  (frame pattern: true
    (_*
     (pool @pool
       (device …⟨(cell @value 4)⟩…)
       (device …⟨(cell @value 5)⟩…)
       (device …⟨(cell @value 6)⟩…))
     (cell @values (4 5 6)))))
  ;; ...

;; Foreign items in @pool are ignored
(rack
  (frame
    (supervisor (@values @value key_ - @pool)
      (backsys @value ±n <> {n: ^(+ n 1)}))

    (backsys @pool
      ⟨D←[device …⟨(cell @value 1)⟩…]⟩ <> {(D): (^D foo)}
      ⟨D←[device …⟨(cell @value 2)⟩…]⟩ <> {(D): (^D bar)}
      ⟨D←[device …⟨(cell @value 3)⟩…]⟩ <> {(D): (^D baz)})

    (pool @pool)
    (cell @values (1 2 3)))

  (frame pattern: true
    (_*
     (pool @pool
       [device …⟨(cell @value 2)⟩…] ;; already incremented because it's a subcircuit
       foo ;; it was 1
       [device …⟨(cell @value 3)⟩…]
       bar
       [device …⟨(cell @value 4)⟩…]
       baz)
     (cell @values (2 3 4))))

  (frame pattern: true
    (_*
     (pool @pool
       [device …⟨(cell @value 3)⟩…] ;; already incremented because it's a subcircuit
       bar ;; it was 2
       foo
       [device …⟨(cell @value 4)⟩…]
       baz
       bar
       [device …⟨(cell @value 5)⟩…]
       baz)
     (cell @values (3 4 5))))

  (frame pattern: true
    (_*
     (pool @pool
       [device …⟨(cell @value 4)⟩…] ;; already incremented because it's a subcircuit
       baz ;; it was 3
       bar
       foo
       [device …⟨(cell @value 5)⟩…]
       baz
       bar
       [device …⟨(cell @value 6)⟩…]
       baz)
     (cell @values (4 5 6)))))
  ;; ...
