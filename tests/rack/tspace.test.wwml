;; Counters and sensors
(rack
  (frame
    (backsys @a ±n <> {n: ^(+ n 1)})
    (backsys @b ±n <> {n: ^(+ n 1)})
    (backsys @c ±n <> {n: ^(+ n 1)})
    (sensor (view local (%pipe (mod 2) 0)))
    (sensor (view local (%pipe (mod 2) 1)))
    (node (@a (appearance _ a_))
      (appearance local 100))
    (node (@b (appearance _ b_))
      (appearance local 201))
    (node (@c (appearance _ c_))
      (appearance local 300)))
  (frame/tail
    (sensor (view local (%pipe (mod 2) 0)) 100 300)
    (sensor (view local (%pipe (mod 2) 1)) 201)
    (node (@a (appearance _ a_))
      (appearance local 101))
    (node (@b (appearance _ b_))
      (appearance local 202))
    (node (@c (appearance _ c_))
      (appearance local 301)))
  (frame/tail
    (sensor (view local (%pipe (mod 2) 0)) 202)
    (sensor (view local (%pipe (mod 2) 1)) 101 301)
    (node (@a (appearance _ a_))
      (appearance local 102))
    (node (@b (appearance _ b_))
      (appearance local 203))
    (node (@c (appearance _ c_))
      (appearance local 302)))
  (frame/tail
    (sensor (view local (%pipe (mod 2) 0)) 102 302)
    (sensor (view local (%pipe (mod 2) 1)) 203)
    (node (@a (appearance _ a_))
      (appearance local 103))
    (node (@b (appearance _ b_))
      (appearance local 204))
    (node (@c (appearance _ c_))
      (appearance local 303))))
  ;; ...

;; Many counters
(rack
  (frame
    (module {}
      (node (@in (sensor _ ±in))
        (sensor (local (a ±in))))
      (node (@out (appearance _ `out))
        (appearance local (a 100)))
      (backsys {@:in, @:out}
        {¦ ±in -out_ } <> {(in): (), out: (a ^(+ in 1))}))
    (module {}
