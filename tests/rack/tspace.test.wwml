;; Elementary sensor-appearance pairing
(rack
  (frame
    (sensor (Ta _))
    (sensor (Tb _))
    (appearance Ta 100) ;; appearance present
    (appearance Tb) ;; appearance absent
    (appearance Tc)) ;; appearance mismatch
  (frame
    (sensor (Ta _) 100)
    (sensor (Tb _))
    (appearance Ta)
    (appearance Tb)
    (appearance Tc))
  end)

;; Single sensor confused by many matching appearances
(rack
  (frame
    (sensor (T _))
    (appearance T 100)
    (appearance T 200)
    (appearance T 300))
  end)

;; Many sensors, no overlap
(rack
  (frame
    (sensor (T _string))
    (sensor (T _number))
    (appearance T "john")
    (appearance T 100))
  (frame
    (sensor (T _string) "john")
    (sensor (T _number) 100)
    (appearance T)
    (appearance T))
  end)

;; Many sensors, overlap
(rack
  (frame
    (sensor (T _string))
    (sensor (T _number))
    (sensor (T _number))
    (appearance T "john")
    (appearance T 100))
  (frame
    (sensor (T _string) "john")
    (sensor (T _number) 100)
    (sensor (T _number) 100)
    (appearance T)
    (appearance T))
  end)

;; Many sensors, many appearances, overlap, some sensors are confused
(rack
  (frame
    (sensor (T _string))
    (sensor (T _number))
    (sensor (T _number))
    (appearance T "john")
    (appearance T 100)
    (appearance T 200))
  (frame
    (sensor (T _string) "john")
    (sensor (T _number))
    (sensor (T _number))
    (appearance T)
    (appearance T 100)
    (appearance T 200))
  end)

;; Simple nesting (legacy: sensor-appearance chan 1:1)
(rack
  (frame
    (module {} (sensor (T _)))
    (module {} (appearance T 100)))
  (frame
    (module {} (sensor (T _) 100))
    (module {} (appearance T)))
  end)

;; Deeper nesting
(rack
  (frame
    (group
      (group
        (module {}
          (sensor (Ta _)))
        (sensor (Tb _)))
      (appearance Ta 100))
    (group
      (group
        (module {}
          (appearance Tb 200))
        (sensor (Tb _)))
      (appearance Ta)))
  (frame
    (group
      (group
        (module {}
          (sensor (Ta _) 100))
        (sensor (Tb _) 200))
      (appearance Ta))
    (group
      (group
        (module {}
          (appearance Tb))
        (sensor (Tb _) 200))
      (appearance Ta)))
  end)

;; Many sensor is not confused by many appearances, transfers them all
(group
  (rack
    (frame
      (sensor (many Ta _))
      (appearance Ta 100)
      (appearance Ta 200)
      (appearance Ta 300)
      (appearance Tb)
      (appearance Tb 400))
    (frame
      (sensor (many Ta _) 100 200 300)
      (appearance Ta)
      (appearance Ta)
      (appearance Ta)
      (appearance Tb)
      (appearance Tb 400))
    end)

  (rack
    (frame
      (sensor (many Ta _))
      (sensor (many Tb _))
      (sensor (many Tc _))
      (sensor (many Td _))
      (appearance Ta 100)
      (appearance Ta 200)
      (appearance Ta 300)
      (appearance Tb)
      (appearance Tb 400)
      (appearance Tc))
    (frame
      (sensor (many Ta _) 100 200 300)
      (sensor (many Tb _) 400)
      (sensor (many Tc _))
      (sensor (many Td _))
      (appearance Ta)
      (appearance Ta)
      (appearance Ta)
      (appearance Tb)
      (appearance Tb)
      (appearance Tc))
    end))

;; Elementary view sensor.
(rack
  (frame
    (sensor (view Ta _))
    (sensor (view Tb _))
    (sensor (view Tc _))
    (appearance Tb 100)
    (appearance Tc 200)
    (appearance Tc 300)
    (appearance Tc 400))
  (frame
    (sensor (view Ta _))
    (sensor (view Tb _) 100)
    (sensor (view Tc _) 200 300 400)
    (appearance Tb 100)
    (appearance Tc 200)
    (appearance Tc 300)
    (appearance Tc 400))
  end)

;; All sensors combined on the same termspace, same appearance (single confused).
(rack
  (frame
    (sensor (T _))
    (sensor (many T _))
    (sensor (view T _))
    (appearance T 100)
    (appearance T 200)
    (appearance T 300))
  (frame
    (sensor (T _))
    (sensor (many T _) 100 200 300)
    (sensor (view T _) 100 200 300)
    (appearance T)
    (appearance T)
    (appearance T))
  (frame
    (sensor (T _))
    (sensor (many T _) 100 200 300)
    (sensor (view T _))
    (appearance T)
    (appearance T)
    (appearance T))
  end)

;; All sensors combined on the same termspace, same appearance (single consensus).
(rack
  (frame
    (sensor (T _))
    (sensor (many T _))
    (sensor (view T _))
    (appearance T 100)
    (appearance T 100)
    (appearance T 100))
  (frame
    (sensor (T _) 100)
    (sensor (many T _) 100 100 100)
    (sensor (view T _) 100 100 100)
    (appearance T)
    (appearance T)
    (appearance T))
  (frame
    (sensor (T _) 100)
    (sensor (many T _) 100 100 100)
    (sensor (view T _))
    (appearance T)
    (appearance T)
    (appearance T))
  end)

;; All sensors combined on the same termspace, same appearance (single 1).
(rack
  (frame
    (sensor (T _))
    (sensor (many T _))
    (sensor (view T _))
    (appearance T 100))
  (frame
    (sensor (T _) 100)
    (sensor (many T _) 100)
    (sensor (view T _) 100)
    (appearance T))
  (frame
    (sensor (T _) 100)
    (sensor (many T _) 100)
    (sensor (view T _))
    (appearance T))
  end)

;; No captures makes the matchee the toplevel term in single, many, view sensors
(rack
  (frame
    (sensor (Ta _))
    (sensor (many Tb _))
    (sensor (view Tc _))
    (appearance Ta 100)
    (group
      (appearance Tb 200)
      (appearance Tb 300)
      (appearance Tb 400))
    (group
      (appearance Tc 500)
      (appearance Tc 600)
      (appearance Tc 700)))
  (frame
    (sensor (Ta _) 100)
    (sensor (many Tb _) 200 300 400)
    (sensor (view Tc _) 500 600 700)
    (appearance Ta)
    (group
      (appearance Tb)
      (appearance Tb)
      (appearance Tb))
    (group
      (appearance Tc 500)
      (appearance Tc 600)
      (appearance Tc 700)))
  end)

;; One capture makes its value the toplevel term in single, many, view sensors
(rack
  (frame
    (sensor (Ta (n value_)))
    (sensor (many Tb (n value_)))
    (sensor (view Tc (n value_)))
    (appearance Ta (n 100))
    (group
      (appearance Tb (n 200))
      (appearance Tb (n 300))
      (appearance Tb (n 400)))
    (group
      (appearance Tc (n 500))
      (appearance Tc (n 600))
      (appearance Tc (n 700))))
  (frame
    (sensor (Ta (n value_)) 100)
    (sensor (many Tb (n value_)) 200 300 400)
    (sensor (view Tc (n value_)) 500 600 700)
    (appearance Ta)
    (group
      (appearance Tb)
      (appearance Tb)
      (appearance Tb))
    (group
      (appearance Tc (n 500))
      (appearance Tc (n 600))
      (appearance Tc (n 700))))
  end)

;; Many captures make the match env the toplevel term in single, many, view sensors
(rack
  (frame
    (sensor (Ta (n a_ b_)))
    (sensor (many Tb (n a_ b_)))
    (sensor (view Tc (n a_ b_)))
    (appearance Ta (n 100 200))
    (group
      (appearance Tb (n 300 400))
      (appearance Tb (n 500 600))
      (appearance Tb (n 700 800)))
    (group
      (appearance Tc (n 900 10))
      (appearance Tc (n 20 30))
      (appearance Tc (n 40 50))))
  (frame
    (sensor (Ta (n a_ b_)) {a: 100, b: 200})
    (sensor (many Tb (n a_ b_))
      {a: 300, b: 400}
      {a: 500, b: 600}
      {a: 700, b: 800})
    (sensor (view Tc (n a_ b_))
      {a: 20, b: 30}
      {a: 40, b: 50}
      {a: 900, b: 10})
    (appearance Ta)
    (group
      (appearance Tb)
      (appearance Tb)
      (appearance Tb))
    (group
      (appearance Tc (n 900 10))
      (appearance Tc (n 20 30))
      (appearance Tc (n 40 50))))
  end)

;; Legacy: sensor-appearance chan M:1
(rack
  (frame
    (module {} (sensor (T _)))
    (module {} (sensor (T _)))
    (module {} (appearance T 100)))
  (frame
    (module {} (sensor (T _) 100))
    (module {} (sensor (T _) 100))
    (module {} (appearance T)))
  end)

;; Legacy: sensor-appearance chan mismatch
(rack
  (frame
    (module {} (sensor (T _number)))
    (module {} (appearance T foo))
    (module {} (appearance T "Alice"))
    (module {} (appearance T "Bob")))
  end)

;; Legacy: sensor-appearance some mismatch
(group
  (rack
