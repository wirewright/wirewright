;; Devices etc.
(rack
  (frame
    (device
      (sensor (many chat _string))
      (appearance chat)
      (appearance users "a"))
    (device
      (sensor (many chat _string))
      (appearance chat "b: z\n")
      (appearance users "b")))
  (frame
    (device
      (sensor (many chat _string) "b: z\n")
      (appearance chat)
      (appearance users "a"))
    (device
      (sensor (many chat _string) "b: z\n")
      (appearance chat)
      (appearance users "b")))
  end)

;; Basic journal sensor
(rack
  (frame
    (sensor (local ±n))
    (sensor (view local ±n))
    (sensor (journal local ±n))
    (appearance local 100)
    (node @x (appearance local 200))
    (cell @y)
    (feed @x @y @x))
  (frame
    (sensor (local ±n))
    (sensor (view local ±n) 100 200)
    (sensor (journal local ±n)
      (appeared 100)
      (appeared 200))
    (appearance local 100)
    (node @x)
    (cell @y (appearance local 200))
    (feed @x @y @x))
  (frame
    (sensor (local ±n) 100) ;; now that there's no confusion this sensor was able to consume!
    (sensor (view local ±n) 100)
    (sensor (journal local ±n)
      (appeared 100)
      (appeared 200)
      (disappeared 200))
    (appearance local)
    (node @x (appearance local 200))
    (cell @y)
    (feed @x @y @x))
  (frame
    (sensor (local ±n) 100)
    (sensor (view local ±n) 200)
    (sensor (journal local ±n)
      (appeared 100)
      (appeared 200)
      (disappeared 200)
      ;; they are in a batch, and appeared sorts before "disappeared" lexicographically!
      (appeared 200)
      (disappeared 100))
    (appearance local)
    (node @x)
    (cell @y (appearance local 200))
    (feed @x @y @x))
  (frame
    (sensor (local ±n) 100)
    (sensor (view local ±n))
    (sensor (journal local ±n)
      (appeared 100)
      (appeared 200)
      (disappeared 200)
      (appeared 200)
      (disappeared 100)
      (disappeared 200))
    (appearance local)
    (node @x (appearance local 200))
    (cell @y)
    (feed @x @y @x))
  (frame
    (sensor (local ±n) 100)
    (sensor (view local ±n) 200)
    (sensor (journal local ±n)
      (appeared 100)
      (appeared 200)
      (disappeared 200)
      (appeared 200)
      (disappeared 100)
      (disappeared 200)
      (appeared 200))
    (appearance local)
    (node @x)
    (cell @y (appearance local 200))
    (feed @x @y @x)))
  ;; ...

