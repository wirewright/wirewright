    end))

;; Elementary surface single sensor
(rack
  (frame
    (surface (cell @value)
      (sensor (local (±a ±b)) ^(+ a b)))
    (appearance local (100 200))
    (feed @value @dst)
    (cell @dst))
  (frame
    (surface (cell @value 300)
      (sensor (local (±a ±b)) ^(+ a b)))
    (appearance local)
    (feed @value @dst)
    (cell @dst))
  (frame
    (surface (cell @value)
      (sensor (local (±a ±b)) ^(+ a b)))
    (appearance local)
    (feed @value @dst)
    (cell @dst 300))
  end)

;; Surface single sensor (legacy: sensor-appearance chan parallel match)
(rack
  (frame
    (module {}
      (surface (cell @value)
        (sensor (T ±n) ^(+ n 1))))
    (module {}
      (surface (cell @value)
        (sensor (T name_string)
          ^"Hi, ⸢name⸣!")))
    (module {} (appearance T "Alice"))
    (module {} (appearance T 100)))
  (frame
    (module {}
      (surface (cell @value 101)
        (sensor (T ±n) ^(+ n 1))))
    (module {}
      (surface (cell @value "Hi, Alice!")
        (sensor (T name_string)
          ^"Hi, ⸢name⸣!")))
    (module {} (appearance T))
    (module {} (appearance T)))
  end)

;; Counter view
(rack
  (frame
    (module {}
      (node (@count (appearance _ ±count))
        (appearance T 0))
      (backsys @count ±n <> {n: ^(+ n 1)}))
    (module {} (sensor (view T _number))))
  (frame
    (module {}
      (node (@count (appearance _ ±count))
        (appearance T 1))
      (backsys @count ±n <> {n: ^(+ n 1)}))
    (module {} (sensor (view T _number) 0)))
  (frame
    (module {}
      (node (@count (appearance _ ±count))
        (appearance T 2))
      (backsys @count ±n <> {n: ^(+ n 1)}))
    (module {} (sensor (view T _number) 1)))
  (frame
    (module {}
      (node (@count (appearance _ ±count))
        (appearance T 3))
      (backsys @count ±n <> {n: ^(+ n 1)}))
    (module {} (sensor (view T _number) 2))))
  ;; ...

;; View sensor updates (1)
(rack
  (frame
    (sensor (view T _))
    (delay 1
      (node @appearance
        (appearance T 100)))
    (delay 3
      (discard @appearance)))
  (frame
    (sensor (view T _))
    (node @appearance
      (appearance T 100))
    (delay 2
      (discard @appearance)))
  (frame
    (sensor (view T _) 100)
    (node @appearance
      (appearance T 100))
    (delay 1
      (discard @appearance)))
  (frame
    (sensor (view T _) 100)
    (node @appearance
      (appearance T 100))
    (discard @appearance))
  (frame
    (sensor (view T _) 100)
    (node @appearance)
    (discard @appearance))
  (frame
    (sensor (view T _))
    (node @appearance)
    (discard @appearance))
  end)

;; Legacy: sensor-appearance queue flow
(rack
  (frame
    (node (@percept (sensor _ percept_))
      (sensor (T _)))
    (feed @percept @back)
    (queue (@front @back) (1 2 3))
    (node (@value (appearance _ `value))
      (appearance T))
    (feed @front @value))
  (frame
    (node (@percept (sensor _ percept_))
      (sensor (T _)))
    (feed @percept @back)
    (queue (@front @back) (2 3))
    (node (@value (appearance _ `value))
      (appearance T 1))
    (feed @front @value))
  (frame
    (node (@percept (sensor _ percept_))
      (sensor (T _) 1))
    (feed @percept @back)
    (queue (@front @back) (2 3))
    (node (@value (appearance _ `value))
      (appearance T))
    (feed @front @value))
  (frame
    (node (@percept (sensor _ percept_))
      (sensor (T _)))
    (feed @percept @back)
    (queue (@front @back) (3 1))
    (node (@value (appearance _ `value))
      (appearance T 2))
    (feed @front @value))
  (frame
    (node (@percept (sensor _ percept_))
      (sensor (T _) 2))
    (feed @percept @back)
    (queue (@front @back) (3 1))
    (node (@value (appearance _ `value))
      (appearance T))
    (feed @front @value))
  (frame
    (node (@percept (sensor _ percept_))
      (sensor (T _)))
    (feed @percept @back)
    (queue (@front @back) (1 2))
    (node (@value (appearance _ `value))
      (appearance T 3))
    (feed @front @value))
  (frame
    (node (@percept (sensor _ percept_))
      (sensor (T _) 3))
    (feed @percept @back)
    (queue (@front @back) (1 2))
    (node (@value (appearance _ `value))
      (appearance T))
    (feed @front @value))
  (frame
    (node (@percept (sensor _ percept_))
      (sensor (T _)))
    (feed @percept @back)
    (queue (@front @back) (2 3))
    (node (@value (appearance _ `value))
      (appearance T 1))
    (feed @front @value)))
  ;; ...

;; Chain reaction
(rack
  (frame
    ;; Adder
    (module {}
      (node (@l (sensor _ l_))
        (sensor (T (l ±n))))
      (node (@r (sensor _ r_))
        (sensor (T (r ±n))))
      (node (@sum (appearance _ `sum))
        (appearance T))
      (backsys {@:l, @:r, @:sum}
        {¦ ±l ±r -sum_} <> {(l): (), (r): (), sum: (sum ^(+ l r))}))

    ;; Double sum
    (module {}
      (node (@n (sensor _ n_))
        (sensor (T (sum ±n))))
      (node (@doubled (appearance _ `doubled))
        (appearance T))
      (backsys {@:n, @:doubled}
        {¦ ±n -doubled_} <> {(n): (), doubled: (double ^(+ n n))}))

    ;; Square sum
    (module {}
      (node (@n (sensor _ n_))
        (sensor (T (sum ±n))))
      (node (@squared (appearance _ `squared))
        (appearance T))
      (backsys {@:n, @:squared}
        {¦ ±n -squared_} <> {(n): (), squared: (square ^(* n n))}))

    (appearance T (l 3))
    (appearance T (r 4))
    (sensor (view T _)))
  (frame/tail
    (appearance T)
    (appearance T)
    (sensor (view T _) (l 3) (r 4)))
  (frame/tail ;; computing sum...
    (sensor (view T _) (l 3) (r 4)))
  (frame/tail ;; ready
    (sensor (view T _) (sum 7)))
  (frame/tail ;; computing double, square
    (sensor (view T _) (sum 7)))
  (frame/tail ;; ready
    (sensor (view T _) (double 14) (square 49)))
  end)

;; Create sensor in response to sensor
(rack
  (frame
    (node (@s (sensor _ s_))
      (sensor (T (sensor _))))
    (feed @s @frag)
    (frag @frag)
    (appearance T (sensor (T _number)))
    (appearance T 100))
  (frame
    (node (@s (sensor _ s_))
      (sensor (T (sensor _)) (sensor (T _number))))
    (feed @s @frag)
    (frag @frag)
    (appearance T)
    (appearance T 100))
  (frame
    (node (@s (sensor _ s_))
      (sensor (T (sensor _))))
    (feed @s @frag)
    (frag @frag (sensor (T _number)))
    (appearance T)
    (appearance T 100))
  (frame
    (node (@s (sensor _ s_))
      (sensor (T (sensor _))))
    (feed @s @frag)
    (frag @frag (sensor (T _number) 100))
    (appearance T)
    (appearance T))
  end)

;; Create appearance in response to sensor
(rack
  (frame
    (module {}
      (node (@value (sensor _ value_))
        (sensor (T (appearance _ _))))
      (feed @value @frag)
      (frag @frag))

    (module {}
      (node (@value (sensor _ value_))
        (sensor (T (appearance _ _))))
      (feed @value @frag)
      (frag @frag))

    (sensor (many T _number))
    (appearance T (appearance T 100)))

  (frame
    (module {}
      (node (@value (sensor _ value_))
        (sensor (T (appearance _ _))
          (appearance T 100)))
      (feed @value @frag)
      (frag @frag))

    (module {}
      (node (@value (sensor _ value_))
        (sensor (T (appearance _ _))
          (appearance T 100)))
      (feed @value @frag)
      (frag @frag))

    (sensor (many T _number))
    (appearance T))

  (frame
    (module {}
      (node (@value (sensor _ value_))
        (sensor (T (appearance _ _))))
      (feed @value @frag)
      (frag @frag (appearance T 100)))

    (module {}
      (node (@value (sensor _ value_))
        (sensor (T (appearance _ _))))
      (feed @value @frag)
      (frag @frag (appearance T 100)))

    (sensor (many T _number))
    (appearance T))

  (frame
    (module {}
      (node (@value (sensor _ value_))
        (sensor (T (appearance _ _))))
      (feed @value @frag)
      (frag @frag (appearance T)))

    (module {}
      (node (@value (sensor _ value_))
        (sensor (T (appearance _ _))))
      (feed @value @frag)
      (frag @frag (appearance T)))

    (sensor (many T _number) 100 100)
    (appearance T))

  end)

;; Surface view
(rack
  (frame
    (surface
      (cell @value)
      (sensor (view local ±n)
        ^(+ n 1)))
    (appearance local 100)
    (appearance local 200))
  (frame
    (surface
      (cell @value (101 201))
      (sensor (view local ±n)
        ^(+ n 1)))
