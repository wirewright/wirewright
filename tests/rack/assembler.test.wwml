;; Components are instantiated
(rack
  (frame
    (Foo) => (Bar 0)
    (slot (Foo)))
  (frame/tail
    (slot (Foo) (Bar 0)))
  end)

;; Nested slots are instantiated
(rack
  (frame
    (Foo) => (group (slot (Bar 0)))
    (Bar ±n) => (group (slot (Qux ^(+ n 1))))
    (Qux n_) => (p ^"Hello, ⸢n⸣")
    (slot (Foo)))

  (frame/tail
    (slot (Foo)
      (group
        (slot (Bar 0)
          (group
            (slot (Qux 1)
              (p "Hello, 1")))))))

  end)

;; Specificity is taken into account
(rack
  (frame
    (Foo ±a) => (cell @x ^a)
    (Foo a_) => (cell @y ^a)
    (Bar a_) => (cell @a ^a)
    (Bar ±a) => (cell @b ^a)
    (slot (Foo 100))
    (slot (Foo qux))
    (slot (Bar 100))
    (slot (Bar qux)))

  (frame/tail
    (slot (Foo 100) (cell @x 100))
    (slot (Foo qux) (cell @y qux))
    (slot (Bar 100) (cell @b 100))
    (slot (Bar qux) (cell @a qux)))

  end)

;; Nested components are instantiated in component body
(rack
  (frame
    (Foo a_)
      => (component {}
           (template (slot (Bar ^a)))
           (slot (Baz))
           (slot (Boo)))
    (Bar ±n) => (cell @x ^n)
    (Baz) => (feed @x @y)
    (Boo) => (cell @y)

    (slot (Foo 123)))

  (frame/tail
    (slot (Foo 123)
      (module {}
        (slot (Bar 123)
          (cell @x 123))
        (slot (Baz)
          (feed @x @y))
        (slot (Boo)
          (cell @y)))))

  (frame/tail
    (slot (Foo 123)
      (module {}
        (slot (Bar 123)
          (cell @x))
        (slot (Baz)
          (feed @x @y))
        (slot (Boo)
          (cell @y 123)))))

  end)

;; `template` can be used in passable spots.
(rack
  (frame
    (Counter value_)
      => (component {}
           (cell @foo
             (template ^value))
           (node @bar
             (group style: "bg-blue-500"
               (node @view
                 (template (p ^\value))))))
    (slot (Counter 100)))

  (frame/tail
    (slot (Counter 100)
      (module {}
        (cell @foo (template ^value)) ;; impassable
        (node @bar
          (group style: "bg-blue-500"
            (node @view
              (p "100"))))))) ;; passable

  end)

;; Templates with multiple children are instantiated as groups
(rack
  (frame
    (Foo value_)
      => (component {}
           (template
             (cell @a ^(+ value 0))
             (cell @b ^(+ value 1))
             (cell @c ^(+ value 2)))
           (discard @a)
           (discard @b))
    (slot (Foo 100)))

  (frame/tail
    (slot (Foo 100)
      (module {}
        (group
          (cell @a 100)
          (cell @b 101)
          (cell @c 102))
        (discard @a)
        (discard @b))))

  (frame/tail
    (slot (Foo 100)
      (module {}
        (group
          (cell @a)
          (cell @b)
          (cell @c 102))
        (discard @a)
        (discard @b))))

  end)

;; Infinite recursion ends at some point due to SAFE_SLOT_DEPTH.
(rack
  (frame
    (Infinite x_) => (slot (Infinite ^(+ x 1)))
    (slot (Infinite 0)))
  terminates)

;; Rule addition invalidates associated slots.
(rack
  (frame
    (cell @a (Foo x_) => (cell @count0 ^x))
    (feed @a @b)
    (node @b)

    (delay 5
      (cell @x (Bar x_) => (cell @count1 ^x)))
    (feed @x @y)
    (node @y)

    (slot (Foo 100))
    (slot (Bar 200))

    (backsys {@:count0 @:count1}
      {¦ ±count0} <> {count0: ^(+ count0 1)}
      {¦ ±count1} <> {count1: ^(+ count1 1)}))

  (frame pattern: true
    ⟨& (cell @a)
       (node @b (%literal (Foo x_) => (cell @count0 ^x)))
       (delay 4 _)⟩)

  (frame pattern: true
    ⟨& (delay 4 _)
       (slot (Foo 100) (cell @count0 100))⟩)

  (frame pattern: true
    ⟨& (delay 3 _)
       (slot (Foo 100) (cell @count0 101))⟩)

  (frame pattern: true
    ⟨& (delay 2 _)
       (slot (Foo 100) (cell @count0 102))⟩)

  (frame pattern: true
    ⟨& (delay 1 _)
       (slot (Foo 100) (cell @count0 103))⟩)

  (frame pattern: true
    ⟨& (cell @x (Bar x_) => (cell @count1 ^x))
       (slot (Foo 100) (cell @count0 104))⟩)

  (frame pattern: true
    ⟨& (node @y (Bar x_) => (cell @count1 ^x))
       (slot (Foo 100) (cell @count0 105))⟩)

  (frame pattern: true
    ⟨& (node @y (Bar x_) => (cell @count1 ^x))
       (slot (Foo 100) (cell @count0 105))
       (slot (Bar 200) (cell @count1 200))⟩)

  (frame pattern: true
    ⟨& (slot (Foo 100) (cell @count0 106))
       (slot (Bar 200) (cell @count1 201))⟩)

  (frame pattern: true
    ⟨& (slot (Foo 100) (cell @count0 107))
       (slot (Bar 200) (cell @count1 202))⟩)

  (frame pattern: true
    ⟨& (slot (Foo 100) (cell @count0 108))
       (slot (Bar 200) (cell @count1 203))⟩))
  ;; ...

;; Rule deletion invalidates associated slots.
(rack
  (frame
    (node @x (Foo) => (delay 100 foo))
    (delay 5 (discard @x))

    (Bar) => (delay 100 bar)

    (slot (Foo))
    (slot (Bar)))

  (frame pattern: true
    ⟨& (delay 5 _)
       (slot (Foo) (delay 100 foo))
       (slot (Bar) (delay 100 bar))⟩)

  (frame pattern: true
    ⟨& (delay 4 _)
       (slot (Foo) (delay 99 foo))
       (slot (Bar) (delay 99 bar))⟩)

  (frame pattern: true
    ⟨& (delay 3 _)
       (slot (Foo) (delay 98 foo))
       (slot (Bar) (delay 98 bar))⟩)

  (frame pattern: true
    ⟨& (delay 2 _)
       (slot (Foo) (delay 97 foo))
       (slot (Bar) (delay 97 bar))⟩)

  (frame pattern: true
    ⟨& (delay 1 (discard @x))
       (slot (Foo) (delay 96 foo))
       (slot (Bar) (delay 96 bar))⟩)

  (frame pattern: true
    ⟨& (node @x (Foo) => (delay 100 foo))
       (discard @x)
       (slot (Foo) (delay 95 foo))
       (slot (Bar) (delay 95 bar))⟩)

  (frame pattern: true
    ⟨& (node @x)
       (discard @x)
       (slot (Foo) (delay 94 foo))
       (slot (Bar) (delay 94 bar))⟩)

  (frame pattern: true
    ⟨& (node @x)
       (discard @x)
       (slot (Foo))
       (slot (Bar) (delay 93 bar))⟩))
  ;; ...

;; Rule update invalidates associated slots.
(rack
  (frame
    (node @rule (Foo) => (cell @count 0))
    (Bar) => (delay 100 bar)
    (backsys @rule
      (rule _ (cell @_ ±count))
        <> {count: ^(+ count 1)})

    (slot (Foo))
    (slot (Bar)))

  (frame pattern: true
    ⟨& (node @rule (Foo) => (cell @count 0))
       (slot (Foo) (cell @count 0))
       (slot (Bar) (delay 100 bar))⟩)

  (frame pattern: true
    ⟨& (node @rule (Foo) => (cell @count 1))
       (slot (Foo) (cell @count 0))
       (slot (Bar) (delay 99 bar))⟩)

  (frame pattern: true
    ⟨& (node @rule (Foo) => (cell @count 2))
       (slot (Foo) (cell @count 1))
       (slot (Bar) (delay 98 bar))⟩)

  (frame pattern: true
    ⟨& (node @rule (Foo) => (cell @count 3))
       (slot (Foo) (cell @count 2))
       (slot (Bar) (delay 97 bar))⟩))
  ;;; ...

;; Slots can be constructed & are instantiated dynamically.
(rack
  (frame
    (Foo n_) => (cell @x ^n)
    (cell @arg 0)
    (transfer (@arg n_ @node) (slot (Foo ^n)))
    (frag @node)
    (feed @x @y)
    (cell @y))

  (frame
    (Foo n_) => (cell @x ^n)
    (cell @arg)
    (transfer (@arg n_ @node) (slot (Foo ^n)))
    (frag @node (slot (Foo 0)))
    (feed @x @y)
    (cell @y))

  (frame
    (Foo n_) => (cell @x ^n)
    (cell @arg)
    (transfer (@arg n_ @node) (slot (Foo ^n)))
    (frag @node (slot (Foo 0) (cell @x 0)))
    (feed @x @y)
    (cell @y))

  (frame
    (Foo n_) => (cell @x ^n)
    (cell @arg)
    (transfer (@arg n_ @node) (slot (Foo ^n)))
    (frag @node (slot (Foo 0) (cell @x)))
    (feed @x @y)
    (cell @y 0))

  end)

;; Many slots from the same rule (add & remove).
(rack
  (frame
    (delay 3
      (node @rule (Foo n_) => ^n))
    (delay 5
      (discard @rule))
    (Bar name_) => ^"Kaixo ⸢name⸣"
    (slot (Foo 0))
    (slot (Foo 1))
    (slot (Foo 2))
    (slot (Bar "John")))

  (frame
    (delay 2
      (node @rule (Foo n_) => ^n))
    (delay 4
      (discard @rule))
    (Bar name_) => ^"Kaixo ⸢name⸣"
    (slot (Foo 0))
    (slot (Foo 1))
    (slot (Foo 2))
    (slot (Bar "John") "Kaixo John"))

  (frame
    (delay 1
      (node @rule (Foo n_) => ^n))
    (delay 3
      (discard @rule))
    (Bar name_) => ^"Kaixo ⸢name⸣"
    (slot (Foo 0))
    (slot (Foo 1))
    (slot (Foo 2))
    (slot (Bar "John") "Kaixo John"))

  (frame
    (node @rule (Foo n_) => ^n)
    (delay 2
      (discard @rule))
    (Bar name_) => ^"Kaixo ⸢name⸣"
    (slot (Foo 0))
    (slot (Foo 1))
    (slot (Foo 2))
    (slot (Bar "John") "Kaixo John"))

  (frame
    (node @rule (Foo n_) => ^n)
    (delay 1
      (discard @rule))
    (Bar name_) => ^"Kaixo ⸢name⸣"
    (slot (Foo 0) 0)
    (slot (Foo 1) 1)
    (slot (Foo 2) 2)
    (slot (Bar "John") "Kaixo John"))

  (frame
    (node @rule (Foo n_) => ^n)
    (discard @rule)
    (Bar name_) => ^"Kaixo ⸢name⸣"
    (slot (Foo 0) 0)
    (slot (Foo 1) 1)
    (slot (Foo 2) 2)
    (slot (Bar "John") "Kaixo John"))

  (frame
    (node @rule)
    (discard @rule)
    (Bar name_) => ^"Kaixo ⸢name⸣"
    (slot (Foo 0) 0)
    (slot (Foo 1) 1)
    (slot (Foo 2) 2)
    (slot (Bar "John") "Kaixo John"))

  (frame
    (node @rule)
    (discard @rule)
    (Bar name_) => ^"Kaixo ⸢name⸣"
    (slot (Foo 0))
    (slot (Foo 1))
    (slot (Foo 2))
    (slot (Bar "John") "Kaixo John"))

  end)

;; Many slots from the same rule (update).
(rack
  (frame
    (node @rule (Foo 0) => "Kaixo")
    (backsys @rule
      (rule (Foo ±n) _) <> {n: ^(mod (+ n 1) 4)})
    (Bar) => (delay 100 qux)
    (slot (Foo 0))
    (slot (Foo 1))
    (slot (Foo 2))
    (slot (Foo 3))
    (slot (Bar)))

  (frame/tail
    (slot (Foo 0) "Kaixo")
    (slot (Foo 1))
    (slot (Foo 2))
    (slot (Foo 3))
    (slot (Bar) (delay 100 qux)))

  (frame
    (node @rule (Foo 1) => "Kaixo")
    (backsys @rule
      (rule (Foo ±n) _) <> {n: ^(mod (+ n 1) 4)})
    (Bar) => (delay 100 qux)
    (slot (Foo 0) "Kaixo")
    (slot (Foo 1))
    (slot (Foo 2))
    (slot (Foo 3))
    (slot (Bar) (delay 99 qux)))

  (frame/tail
    ;; (Foo 2) => ...
    (slot (Foo 0))
    (slot (Foo 1) "Kaixo")
    (slot (Foo 2))
    (slot (Foo 3))
    (slot (Bar) (delay 98 qux)))

  (frame/tail
    ;; (Foo 3) => ...
    (slot (Foo 0))
    (slot (Foo 1))
    (slot (Foo 2) "Kaixo")
    (slot (Foo 3))
    (slot (Bar) (delay 97 qux)))

  (frame/tail
    ;; (Foo 0) => ...
    (slot (Foo 0))
    (slot (Foo 1))
    (slot (Foo 2))
    (slot (Foo 3) "Kaixo")
    (slot (Bar) (delay 96 qux))))
  ;; ...

;; Module creates rule scope.
(rack
  (frame
    (backsys @lab
      ((_* `dst) rule_ _) <> {dst: ^rule, (rule): ()}
      ((_* rule_) `dst _) <> {dst: ^rule, (rule): ()})
    (circuit @lab
      (module {})
      (Foo) => 100
      (slot (Foo))))

  (frame/tail
    (circuit @lab
      (module {})
      (Foo) => 100
      (slot (Foo) 100)))

  (frame/tail
    (circuit @lab
      (module {} (Foo) => 100)
      (slot (Foo) 100)))

  (frame/tail
    (circuit @lab
      (module {} (Foo) => 100)
      (slot (Foo))))

  (frame/tail
    (circuit @lab
      (module {})
      (Foo) => 100
      (slot (Foo))))

  (frame/tail
    (circuit @lab
      (module {})
      (Foo) => 100
      (slot (Foo) 100))))
  ;; ...

;; Using slot in rule body instantiates immediately instead of creating
;; a nested slot.
(rack
  (frame
    (Foo x_) => (slot (Bar ^x))
    (Bar x_) => (slot (Baz ^x))
    (Baz x_) => ^x
    (slot (Foo 100)))

  (frame/tail
    (slot (Foo 100) 100))

  end)

;; This immediate form shouldn't blow up with infinite recursion.
(rack
  (frame
    (Foo x_) => (slot (Bar ^x))
    (Bar x_) => (slot (Baz ^x))
    (Baz x_) => (slot (Foo ^x))
    (slot (Foo 100)))

  terminates) ;; due to the expansion depth limi

;; BUG: Single-expression template must expand into group on plural
;; top-level splice.
(group
  ;; zero
  (rack
    (frame
      (Qux) =>
        (component {}
          (template
            (^splice)))
        (slot (Qux)))
    (frame/tail
      (slot (Qux)
        (module {}
          (group))))
    end)
  ;; one
  (rack
    (frame
      (Qux) =>
        (component {}
          (template
            (^splice 1)))
        (slot (Qux)))
    (frame/tail
      (slot (Qux)
        (module {}
          1)))
    end)
  ;; many
  (rack
    (frame
      (Qux) =>
        (component {}
          (template
            (^splice 1 2 3)))
        (slot (Qux)))
    (frame/tail
      (slot (Qux)
        (module {}
          (group 1 2 3))))
    end))

;; `embed` support in AlloyRecipe
(rack
  (frame
    (A x_) => ^(embed (B x))
    (B x_) => (C ^x)
    ($A 100))

  (frame/tail
    (slot (A 100) (C 100)))

  end)

;; `embed` support in CallRecipe
(rack
  (frame
    (A x_) => ($B ^(embed (C x)))
    (B x_) => (D ^x)
    (C x_) => (xyzzy ^x)
    ($A 100))

  (frame/tail
    (slot (A 100)
      (D (xyzzy 100))))

  end)

;; `embed` support in ComponentRecipe
(rack
  (frame
    (A x_)
      => (component {}
           (template
             ^(embed (B x)))
           (group
             (template
               ^(embed (C x)))
             (template
               ^(embed (D x)))))
    (B x_) => (b ^x)
    (C x_) => (c ^x)
    (D x_) => (d ^x)
    ($A 100))

  (frame/tail
    (slot (A 100)
      (module {}
        (b 100)
        (group
          (c 100)
          (d 100)))))

  end)
