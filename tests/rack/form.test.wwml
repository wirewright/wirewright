      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf {x: (0 0)}))

  ;; Conflict on @x
  end)

(rack
  (frame
    (form @xf
      (field (arena @x) (0 0))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
