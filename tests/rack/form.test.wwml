;; Invalid merge policy, short form
(rack
  (frame
    (form @xf
      (field (invalid-policy @x) (0 0))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf))

  (frame
    (form @xf
      (field (invalid-policy @x) (0 0))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf ()))

  end)

;; Invalid merge policy, long form
(rack
  (frame
    (form @xf
      (field ((invalid-policy @x) qux) (0 0))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf))

  (frame
    (form @xf
      (field ((invalid-policy @x) qux) (0 0))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf ()))

  end)

;; Unwrapped form
(rack
  (frame
    (form @xf
      (outlet @x 100)
      (delay 1 (outlet @y 200)))
    (reading @xf))

  (frame
    (form @xf
      (outlet @x 100)
      (outlet @y 200))
    (reading @xf 100))

  (frame
    (form @xf
      (outlet @x 100)
      (outlet @y 200))
    (reading @xf (100 200)))

  end)

(rack
  (frame
    (form @xf
      (outlet @x 100)
      (delay 1 (field @y 200)))
    (reading @xf))

  (frame
    (form @xf
      (outlet @x 100)
      (field @y 200))
    (reading @xf 100))

  (frame
    (form @xf
      (outlet @x 100)
      (field @y 200))
    (reading @xf (100 y: 200)))

  end)

(rack
  (frame
    (form @xf
      (outlet @x 100)
      (delay 1 (outlet @y 200))
      (delay 2 (field @z 300)))
    (reading @xf))

  (frame
    (form @xf
      (outlet @x 100)
      (outlet @y 200)
      (delay 1 (field @z 300)))
    (reading @xf 100))

  (frame
    (form @xf
      (outlet @x 100)
      (outlet @y 200)
      (field @z 300))
    (reading @xf (100 200)))

  (frame
    (form @xf
      (outlet @x 100)
      (outlet @y 200)
      (field @z 300))
    (reading @xf (100 200 z: 300)))

  end)

;; Wrapped form
(rack
  (frame
    (form (@xf)
      (outlet @x 100)
      (delay 1 (outlet @y 200)))
    (reading @xf))

  (frame
    (form (@xf)
      (outlet @x 100)
      (outlet @y 200))
    (reading @xf (100)))

  (frame
    (form (@xf)
      (outlet @x 100)
      (outlet @y 200))
    (reading @xf (100 200)))

  end)

;; Wrapped form with policy
(rack
  (frame
    (form (@xf) (outlet @x (100 200)))
    (backsys @xf ((±n _)) <> {n: ^(+ n 1)})
    (backsys @xf ((_ ±m)) <> {m: ^(+ m 1)}))

  ;; Conflict
  end)

(rack
  (frame
    (backsys @xf ((±n _)) <> {n: ^(+ n 1)})
    (backsys @xf ((_ ±m)) <> {m: ^(+ m 1)})
    (form ((space @xf)) (outlet @x (100 200))))

  (frame/tail
    (form ((space @xf)) (outlet @x (101 201))))

  (frame/tail
    (form ((space @xf)) (outlet @x (102 202)))))
  ;; ...

(rack
  (frame
    (backsys
      {¦ a_ xf: {¦ -in_}} <> {(a): (), in: ^a}
      {¦ xf: {¦ out_} yf: {¦ -in_}} <> {in: ^out, (out): ()}
      {¦ yf: {¦ out_} zf: {¦ -in_}} <> {in: ^out, (out): ()}
      {¦ zf: {¦ out_} -b_} <> {(out): (), b: ^out})
    (cell @a 100)
    (form @xf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @yf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @zf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (cell @b))

  (frame/tail
    (cell @a)
    (form @xf
      (feed @x @a @b @y)
      (field (@x in))
       ;; NOTE: We will never see 100 in the in field here because `form`s are
       ;; circuits, so they evaluate by one step before we can look at them
       ;; (at the frame resolution we use in tests, that is...)
      (cell @a 100)
      (cell @b)
      (field (@y out)))
    (form @yf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @zf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (cell @b))

  (frame/tail fast-forward: true
    (cell @a)
    (form @xf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out) 100))
    (form @yf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @zf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (cell @b))

  (frame/tail
    (cell @a)
    (form @xf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @yf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a 100)
      (cell @b)
      (field (@y out)))
    (form @zf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (cell @b))

  (frame/tail fast-forward: true
    (cell @a)
    (form @xf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @yf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out) 100))
    (form @zf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (cell @b))

  (frame/tail
    (cell @a)
    (form @xf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @yf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @zf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a 100)
      (cell @b)
      (field (@y out)))
    (cell @b))

  (frame/tail fast-forward: true
    (cell @a)
    (form @xf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @yf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @zf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out) 100))
    (cell @b))

  (frame/tail
    (cell @a)
    (form @xf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @yf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (form @zf
      (feed @x @a @b @y)
      (field (@x in))
      (cell @a)
      (cell @b)
      (field (@y out)))
    (cell @b 100))

  end)

;; Read-only field
(group
  ;; Read-only field unset
  (rack
    (frame
      (backsys {¦ xf: {| x_}} <> {(x): ()}) ;; |
      (form @xf
        (field (readonly @x) 100)
        (backsys @x ±n <> {n: ^(+ n 1)})))

    (frame/tail
      (form @xf
        (field (readonly @x) 101)
        (backsys @x ±n <> {n: ^(+ n 1)})))

    (frame/tail
      (form @xf
        (field (readonly @x) 102)
        (backsys @x ±n <> {n: ^(+ n 1)}))))
    ;; ...

  ;; Read-only field change
  (rack
    (frame
      (backsys {¦ xf: {| x_}} <> {x: ^(* x 2)}) ;; |
      (form @xf
        (field (readonly @x) 100)
        (backsys @x ±n <> {n: ^(+ n 1)})))

    (frame/tail
      (form @xf
        (field (readonly @x) 101)
        (backsys @x ±n <> {n: ^(+ n 1)})))

    (frame/tail
      (form @xf
        (field (readonly @x) 102)
        (backsys @x ±n <> {n: ^(+ n 1)}))))

  ;; Read-only field set
  (rack
    (frame
      (backsys {¦ xf: {| -x_}} <> {x: 100}) ;; |
      (form @xf
        (field (readonly @x))
        (cell @y 200)
        (feed @y @x)))

    (frame/tail
      (form @xf
        (field (readonly @x) 200) ;; backsys' `100` is rejected
        (cell @y)
        (feed @y @x)))

    end))

;; Read-only outlet (one)
(group
  (rack
    (frame
      (backsys @x ±n <> {n: ^(+ n 1)})
      (outlet (readonly @x) 0))

    (frame/tail
      (outlet (readonly @x) 1))

    (frame/tail
      (outlet (readonly @x) 2)))
    ;; ...

  ;; Unset
  (rack
    (frame
      (form @xf
        (outlet (readonly @x) 100))
      (feed @xf @yf)
      (form @yf
        (outlet @y)))

    end)

  ;; Set
  (rack
    (frame
      (form @xf
        (outlet @x 100))
      (feed @xf @yf)
      (form @yf
        (outlet (readonly @y))))

    end)

  ;; Change
  (rack
    (frame
      (form @xf
        (outlet @x 100))
      (backsys @x ±n <> {n: ^(+ n 1)}))

    end)

  (rack
    (frame
      (form @xf
        (outlet (readonly @x) 100))
      (feed @xf @yf)
      (form @yf
        (outlet (readonly @y))))

    end)

  (rack
    (frame
      (form @xf
        (outlet (readonly @x) 100))
      (reading @xf))

    (frame/tail
      (reading @xf 100))

    end))

;; Read-only outlet (many)
(group
  (rack
    (frame
      (form (arena @xf)
        (outlet @x 100)
        (outlet @y 200))
      (feed (@xf front) @y)
      (feed (@xf back) @z)
      (cell @y)
      (cell @z))

    (frame
      (form (arena @xf)
        (outlet @x)
        (outlet @y))
      (feed (@xf front) @y)
      (feed (@xf back) @z)
      (cell @y 100)
      (cell @z 200))

    end)

  (rack
    (frame
      (form (arena @xf)
        (outlet (readonly @x) 100)
        (outlet @y 200))
      (feed (@xf front) @y)
      (feed (@xf back) @z)
      (cell @y)
      (cell @z))

    (frame
      (form (arena @xf)
        (outlet (readonly @x) 100)
        (outlet @y))
      (feed (@xf front) @y) ;; this one is rejected
      (feed (@xf back) @z)
      (cell @y)
      (cell @z 200))

    end)

  (rack
    (frame
      (form (arena @xf)
        (outlet (readonly @x) 100)
        (outlet (readonly @y) 200))
      (feed (@xf front) @y)
      (feed (@xf back) @z)
      (cell @y)
      (cell @z))

    ;; Both feeds are rejected
    end))

;; Read-only field with policy
(group
  (rack
    (frame
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)})
      (field (readonly @x) (0 0)))

    end)

  (rack
    (frame
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)})
      (field (readonly @x qux) (0 0)))

    end)

  (rack
    (frame
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)})
      (field (readonly (arena @x)) (0 0)))

    (frame/tail
      (field (readonly (arena @x)) (1 1)))

    (frame/tail
      (field (readonly (arena @x)) (2 2))))

  (rack
    (frame
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)})
      (field (readonly (arena @x) qux) (0 0)))

    (frame/tail
      (field (readonly (arena @x) qux) (1 1)))

    (frame/tail
      (field (readonly (arena @x) qux) (2 2)))))
    ;; ...

;; Read-only outlet with policy
(group
  (rack
    (frame
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)})
      (outlet (readonly @x) (0 0)))

    end)

  (rack
    (frame
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)})
      (outlet (readonly (arena @x)) (0 0)))

    (frame/tail
      (outlet (readonly (arena @x)) (1 1)))

    (frame/tail
      (outlet (readonly (arena @x)) (2 2)))))
    ;; ...

;; Interop with part
(group
  (rack
    (frame
      (outlet @xs (1 2 3))
      (part (@xs @x) (x_ _*))
      (reading @x))

    (frame
      (outlet @xs (1 2 3))
      (part (@xs @x) (x_ _*))
      (reading @x 1))

    end)

  (rack
    (frame
      (field @xs (1 2 3))
      (part (@xs @x) (x_ _*))
      (reading @x))

    (frame
      (field @xs (1 2 3))
      (part (@xs @x) (x_ _*))
      (reading @x 1))

    end))
