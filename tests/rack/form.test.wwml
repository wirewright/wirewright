(rack
  (frame
    (form @form
      (group
        (outlet @a 100)
        (outlet @b 200))
      (outlet @c 300))
    (reading @form))

  (frame
    (form @form
      (group
        (outlet @a 100)
        (outlet @b 200))
      (outlet @c 300))
    (reading @form
      (100 200 300)))

  end)

(rack
  (frame
    (part (@form @x) (x_ _ _))
    (part (@form @y) (y_ _))
    (part (@form @z) (z_))
    (discard @x)
    (delay 1 (discard @y))
    (delay 2 (discard @z))
    (form @form
      (group
        (outlet @a 100)
        (outlet @b 200))
      (outlet @c 300)))

  (frame/tail
    (form @form
      (group
        (outlet @a)
        (outlet @b 200))
      (outlet @c 300)))

  (frame/tail
    (form @form
      (group
        (outlet @a)
        (outlet @b))
      (outlet @c 300)))

  (frame/tail
    (form @form
      (group
        (outlet @a)
        (outlet @b))
      (outlet @c)))

  end)

(rack
  (frame
    (feed @x (@ys back))
    (feed (@ys front) (@z back))

    (form @x
      (cell @xs (1 2 3))
      (feed (@xs front) @elevator)
      (outlet @elevator))

    (cell @ys ())

    (form @z
      (group
        (outlet @zs ()))))

  (frame/tail
    (form @x
      (cell @xs (2 3))
      (feed (@xs front) @elevator)
      (outlet @elevator 1))

    (cell @ys ())

    (form @z
      (group
        (outlet @zs ()))))

  (frame/tail
    (form @x
      (cell @xs (3))
      (feed (@xs front) @elevator)
      (outlet @elevator 2))

    (cell @ys (1))

    (form @z
      (group
        (outlet @zs ()))))

  ;; This must halt due to a conflict on the exclusive @ys: both feeds want
  ;; to modify it.
  end)

(rack
  (frame
    (feed @x (@ys back))
    (feed (@ys front) (@z back))

    (form @x
      (cell @xs (1 2 3))
      (feed (@xs front) @elevator)
      (outlet @elevator))

    (cell (arena @ys) ())

    (form @z
      (group
        (outlet @zs ()))))

  (frame/tail
    (form @x
      (cell @xs (2 3))
      (feed (@xs front) @elevator)
      (outlet @elevator 1))

    (cell (arena @ys) ())

    (form @z
      (group
        (outlet @zs ()))))

  (frame/tail
    (form @x
      (cell @xs (3))
      (feed (@xs front) @elevator)
      (outlet @elevator 2))

    (cell (arena @ys) (1))

    (form @z
      (group
        (outlet @zs ()))))

  (frame/tail
    (form @x
      (cell @xs ())
      (feed (@xs front) @elevator)
      (outlet @elevator 3))

    (cell (arena @ys) (2))

    (form @z
      (group
        (outlet @zs (1)))))

  (frame/tail
    (form @x
      (cell @xs ())
      (feed (@xs front) @elevator)
      (outlet @elevator))

    (cell (arena @ys) (3))

    (form @z
      (group
        (outlet @zs (1 2)))))

  (frame/tail
    (form @x
      (cell @xs ())
      (feed (@xs front) @elevator)
      (outlet @elevator))

    (cell (arena @ys) ())

    (form @z
      (group
        (outlet @zs (1 2 3)))))

  end)

(rack
  (frame
    (feed @a @b @a)
    (form @a (outlet @x true))
    (form @b (outlet @x)))

  (frame/tail
    (form @a (outlet @x))
    (form @b (outlet @x true)))

  (frame/tail
    (form @a (outlet @x true))
    (form @b (outlet @x))))
  ;; ...

(rack
  (frame
    (part (@xf @x) (x_ _*))
    (discard @x)
    (form @xf
      (outlet @a 100)
      (outlet @b 200)
      (outlet @c 300)
      (outlet @d 400)))

  (frame/tail
    (form @xf
      (outlet @a)
      (outlet @b 200)
      (outlet @c 300)
      (outlet @d 400)))

  (frame/tail
    (form @xf
      (outlet @a)
      (outlet @b)
      (outlet @c 300)
      (outlet @d 400)))

  (frame/tail
    (form @xf
      (outlet @a)
      (outlet @b)
      (outlet @c)
      (outlet @d 400)))

  (frame/tail
    (form @xf
      (outlet @a)
      (outlet @b)
      (outlet @c)
      (outlet @d)))

  end)

(rack
  (frame
    (part (@xf @x) (_* x_))
    (discard @x)
    (form @xf
      (outlet @a 100)
      (outlet @b 200)
      (outlet @c 300)
      (outlet @d 400)))

  (frame/tail
    (form @xf
      (outlet @a 100)
      (outlet @b 200)
      (outlet @c 300)
      (outlet @d)))

  (frame/tail
    (form @xf
      (outlet @a 100)
      (outlet @b 200)
      (outlet @c)
      (outlet @d)))

  (frame/tail
    (form @xf
      (outlet @a 100)
      (outlet @b)
      (outlet @c)
      (outlet @d)))

  (frame/tail
    (form @xf
      (outlet @a)
      (outlet @b)
      (outlet @c)
      (outlet @d)))

  end)

(rack
  (frame
    (backsys @xf
      {¦ a_} <> {(a): ()}
      {¦ -a_} <> {a: 100})
    (form @xf
      (field @a 100)
      (field @b 200)))

  (frame/tail
    (form @xf
      (field @a)
      (field @b 200)))

  (frame/tail
    (form @xf
      (field @a 100)
      (field @b 200)))

  (frame/tail
    (form @xf
      (field @a)
      (field @b 200))))
  ;; ...

(rack
  (frame
    (backsys @xf
      {¦ a_} <> {(a): ()}
      {¦ -a_} <> {a: 100})
    (backsys @xf
      {¦ b_} <> {(b): ()}
      {¦ -b_} <> {b: 100})
    (form @xf
      (field @a 100)
      (field @b 200)))

  ;; Should not work due to a conflict on @xf, which is exclusive
  ;; (but both backmaps want to modify it!)
  end)

(rack
  (frame
    (backsys @xf
      {¦ a_} <> {(a): ()}
      {¦ -a_} <> {a: 100})
    (backsys @xf
      {¦ b_} <> {(b): ()}
      {¦ -b_} <> {b: 200})
    (form (arena @xf)
      (field @a 100)
      (field @b 200)))

  (frame/tail
    (form (arena @xf)
      (field @a)
      (field @b)))

  (frame/tail
    (form (arena @xf)
      (field @a 100)
      (field @b 200)))

  (frame/tail
    (form (arena @xf)
      (field @a)
      (field @b))))
  ;; ...

;; Invalid policy on form
(rack
  (frame
    (form (invalid-policy @xf)
      (cell @x 0)
      (cell @y)
      (feed @x @y)))

  end)

(rack
  (frame
    (form ((invalid-policy @xf))
      (cell @x 0)
      (cell @y)
      (feed @x @y)))

  end)

;; Outlet with edge
(rack
  (frame
    (form @xf
      (cell @a 100)
      (outlet @b)
      (feed @a @b @a))
    (reading @xf))

  (frame
    (form @xf
      (cell @a)
      (outlet @b 100)
      (feed @a @b @a))
    (reading @xf))

  (frame
    (form @xf
      (cell @a 100)
      (outlet @b)
      (feed @a @b @a))
    (reading @xf 100))

  (frame
    (form @xf
      (cell @a)
      (outlet @b 100)
      (feed @a @b @a))
    (reading @xf)))
  ;; ...

(rack
  (frame
    (form @xf
      (outlet @count 0)
      (backsys @count ±n <> {n: ^(+ n 1)}))
    (reading @xf))

  (frame
    (form @xf
      (outlet @count 1)
      (backsys @count ±n <> {n: ^(+ n 1)}))
    (reading @xf 0))

  (frame
    (form @xf
      (outlet @count 2)
      (backsys @count ±n <> {n: ^(+ n 1)}))
    (reading @xf 1))

  (frame
    (form @xf
      (outlet @count 3)
      (backsys @count ±n <> {n: ^(+ n 1)}))
    (reading @xf 2)))
  ;; ...

(rack
  (frame
    (form @xf
      (outlet @count 0)
      (view (@count ±n @count) ^(+ n 1)))

    (form @yf
      (outlet @input)
      (view (@input ±n @output) ^(* n 2))
      (cell @output))

    (feed (copy @xf) (over @yf)))

  (frame
    (form @xf
      (outlet @count 1)
      (view (@count ±n @count) ^(+ n 1)))

    (form @yf
      (outlet @input 0)
      (view (@input ±n @output) ^(* n 2))
      (cell @output 0))

    (feed (copy @xf) (over @yf)))

  (frame
    (form @xf
      (outlet @count 2)
      (view (@count ±n @count) ^(+ n 1)))

    (form @yf
      (outlet @input 1)
      (view (@input ±n @output) ^(* n 2))
      (cell @output 2))

    (feed (copy @xf) (over @yf)))

  (frame
    (form @xf
      (outlet @count 3)
      (view (@count ±n @count) ^(+ n 1)))

    (form @yf
      (outlet @input 2)
      (view (@input ±n @output) ^(* n 2))
      (cell @output 4))

    (feed (copy @xf) (over @yf)))

  (frame
    (form @xf
      (outlet @count 4)
      (view (@count ±n @count) ^(+ n 1)))

    (form @yf
      (outlet @input 3)
      (view (@input ±n @output) ^(* n 2))
      (cell @output 6))

    (feed (copy @xf) (over @yf))))
  ;; ...

(rack
  (frame
    (form @xf
      (outlet @count (0 0))
      (backsys @count (±n _) <> {n: ^(+ n 1)})
      (backsys @count (_ ±m) <> {m: ^(+ m 1)})))

  ;; This one is a conflict: two backsystems trying to modify the same exclusive
  ;; outlet @count.
  end)

(rack
  (frame
    (form @xf
      (outlet (arena @count) (0 0))
      (backsys @count (±n _) <> {n: ^(+ n 1)})
      (backsys @count (_ ±m) <> {m: ^(+ m 1)})))

  (frame
    (form @xf
      (outlet (arena @count) (1 1))
      (backsys @count (±n _) <> {n: ^(+ n 1)})
      (backsys @count (_ ±m) <> {m: ^(+ m 1)})))

  (frame
    (form @xf
      (outlet (arena @count) (2 2))
      (backsys @count (±n _) <> {n: ^(+ n 1)})
      (backsys @count (_ ±m) <> {m: ^(+ m 1)}))))
  ;; ...

;; Full form field
(rack
  (frame
    (form @xf
      (field (@a x) 0)
      (field (@b y) 0)
      (backsys @a ±n <> {n: ^(+ n 1)})
      (backsys @b ±n <> {n: ^(+ n 1)}))
    (reading @xf))

  (frame
    (form @xf
      (field (@a x) 1)
      (field (@b y) 1)
      (backsys @a ±n <> {n: ^(+ n 1)})
      (backsys @b ±n <> {n: ^(+ n 1)}))
    (reading @xf {x: 0, y: 0}))

  (frame
    (form @xf
      (field (@a x) 2)
      (field (@b y) 2)
      (backsys @a ±n <> {n: ^(+ n 1)})
      (backsys @b ±n <> {n: ^(+ n 1)}))
    (reading @xf {x: 1, y: 1})))
  ;; ...

;; Short form field
(rack
  (frame
    (form @xf
      (field @x 0)
      (field @y 0)
      (backsys @x ±n <> {n: ^(+ n 1)})
      (backsys @y ±n <> {n: ^(+ n 1)}))
    (reading @xf))

  (frame
    (form @xf
      (field @x 1)
      (field @y 1)
      (backsys @x ±n <> {n: ^(+ n 1)})
      (backsys @y ±n <> {n: ^(+ n 1)}))
    (reading @xf {x: 0, y: 0}))

  (frame
    (form @xf
      (field @x 2)
      (field @y 2)
      (backsys @x ±n <> {n: ^(+ n 1)})
      (backsys @y ±n <> {n: ^(+ n 1)}))
    (reading @xf {x: 1, y: 1})))

;; Short form with policy
(rack
  (frame
    (form @xf
      (field (@x qux) (0 0))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf))

  (frame
    (form @xf
      (field (@x qux) (0 0))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf {qux: (0 0)}))

  ;; Conflict
  end)

(rack
  (frame
    (form @xf
      (field ((arena @x) qux) (0 0))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf))

  (frame
    (form @xf
      (field ((arena @x) qux) (1 1))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf {qux: (0 0)}))

  (frame
    (form @xf
      (field ((arena @x) qux) (2 2))
      (backsys @x (±n _) <> {n: ^(+ n 1)})
      (backsys @x (_ ±m) <> {m: ^(+ m 1)}))
    (reading @xf {qux: (1 1)})))
  ;; ...

