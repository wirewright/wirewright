      (backsys
        {¦ request_: [get ("/") body_] -response_}
          <> {(request): (), response: (ok ^body)}))

    (circuit (pool @pool))

    (cell @in (get "/" {x: 100, y: 200}))
    (cell @out)
    (client (@in -> (http local 9813) -> @out format: json)))

  (frame/tail fast-forward: true
    (circuit (pool @pool))

    (cell @in)
    (cell @out (ok {"x": 100, "y": 200}))
    (client (@in -> (http local 9813) -> @out format: json) up)))

