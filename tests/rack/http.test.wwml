;; Multiple servers and clients in the same world
(rack
  (frame
    (module {}
      (server (@pool (http local 9813) format: text)
        (backsys
          {¦ request: [get ("/")] -response_}
            <> {response: (ok "Hello from server 1!")}))
      (pool @pool))

    (module {}
      (server (@pool (http local 9814) format: text)
        (backsys
          {¦ request: [get ("/")] -response_}
            <> {response: (ok "Hello from server 2!")}))
      (pool @pool))

    (module {}
      (cell @in (get "/"))
      (cell @out)
      (client (@in -> (http local 9813) -> @out format: text)))

    (module {}
      (cell @in (get "/"))
      (cell @out)
      (client (@in -> (http local 9814) -> @out format: text))))

  (frame/tail fast-forward: true
    (module {}
      (cell @in)
      (cell @out (ok "Hello from server 1!"))
      (client (@in -> (http local 9813) -> @out format: text) up))

    (module {}
      (cell @in)
      (cell @out (ok "Hello from server 2!"))
      (client (@in -> (http local 9814) -> @out format: text) up))))

;; Multiple clients
;; NOTE: This is a nonsensical test but it exposed a bug so I'm keeping it!
(rack
  (frame
    (module {}
      (server (@pool (http local 9813) format: text)
        (backsys
          {¦ request_ -response_}
            <> {response: (err "You hit the wrong page Charlie!")}
          {¦ request: [get ("/")] -response_}
            <> {response: (ok "Hello from server 1!")}))
      (pool @pool))

    (module {}
      (cell @in (get ("/" name: "Alice")))
      (cell @out)
      (client (@in -> (http local 9813 key: alice) -> @out format: text)))

    (module {}
      (cell @in (get ("/" name: "Bob")))
      (cell @out)
      (client (@in -> (http local 9813 key: bob) -> @out format: text)))

    ;; Charlie is hitting the wrong page
    (module {}
      (cell @in (get "/missing"))
      (cell @out)
      (client (@in -> (http local 9813 key: charlie) -> @out format: text))))

  (frame/tail fast-forward: true
    (module {}
      (cell @in)
      (cell @out (err "You hit the wrong page Charlie!"))
      (client (@in -> (http local 9813 key: alice) -> @out format: text) up))

    (module {}
      (cell @in)
      (cell @out (err "You hit the wrong page Charlie!"))
      (client (@in -> (http local 9813 key: bob) -> @out format: text) up))

    (module {}
      (cell @in)
      (cell @out (err "You hit the wrong page Charlie!"))
      (client (@in -> (http local 9813 key: charlie) -> @out format: text) up))))

;; Multiple clients
;; This is the actual test
(rack
  (frame
    (server (@pool (http local 9813) format: text)
      (backsys
        {¦ request_ -response_}
          <> {response: (err "You hit the wrong page Charlie!")}
        {¦ request: [get ("/" ¦ () name_string)] -response_}
          <> {response: (ok ^"Hello, ⸢name⸣")}))

    (pool @pool)

    (module {}
      (cell @in (get ("/" name: "Alice")))
      (cell @out)
      (client (@in -> (http local 9813 key: alice) -> @out format: text)))

    (module {}
      (cell @in (get ("/" name: "Bob")))
      (cell @out)
      (client (@in -> (http local 9813 key: bob) -> @out format: text)))

    (module {}
      (cell @in (get "/missing"))
      (cell @out)
      (client (@in -> (http local 9813 key: charlie) -> @out format: text))))

  (frame/tail fast-forward: true
    (pool @pool)

    (module {}
      (cell @in)
      (cell @out (ok "Hello, Alice"))
      (client (@in -> (http local 9813 key: alice) -> @out format: text) up))

    (module {}
      (cell @in)
      (cell @out (ok "Hello, Bob"))
      (client (@in -> (http local 9813 key: bob) -> @out format: text) up))

    (module {}
      (cell @in)
      (cell @out (err "You hit the wrong page Charlie!"))
      (client (@in -> (http local 9813 key: charlie) -> @out format: text) up))))

;; WebSocket and HTTP server in the same world
(rack
  (frame
    (module {}
      (server (@pool (http local 9813) format: ml)
        (backsys
          {¦ request_: [get ("/") body_] -response_}
            <> {(request): (), response: (ok ^body)}))
      (pool @pool))

    (module {}
      (server (@pool (ws local 9813 link: portal) format: ml)
        (backsys
          {¦ in: (msg_ _*) out: (_* `>msg)}
            <> {(msg): (), >msg: ^msg}))
      (pool @pool))

    (module {}
      (cell @in (get "/" {x: 100, y: 200}))
      (cell @out)
      (client (@in -> (http local 9813) -> @out format: ml)))

    (module {}
      (cell @in {name: "John Doe", message: "Hello World"})
      (queue (@reply @replies) ())
      (client (@in -> (ws local 9813 link: portal) -> @replies format: ml))))

  (frame/tail fast-forward: true
    (module {}
      (cell @in)
      (cell @out (ok {x: 100, y: 200}))
      (client (@in -> (http local 9813) -> @out format: ml) up))

    (module {}
      (cell @in)
      (queue (@reply @replies) ({name: "John Doe", message: "Hello World"}))
      (client (@in -> (ws local 9813 link: portal) -> @replies format: ml)
        up))))

;; HTTP: response doesn't lose content-type
(rack
  (frame
    (server (@pool (http local 9813) format: binary)
      (backsys
        {¦ request_: [get ("/")] -response_}
          <> {(request): (), response: (ok "<p>Hi!</p>" content-type: "text/html")}))

    (pool @pool)

    (cell @in (get "/"))
    (cell @out)
    (client (@in -> (http local 9813) -> @out format: binary)))

  (frame/tail fast-forward: true
    (pool @pool)

    (cell @in)
    (cell @out (ok ⟬‸<p>Hi!</p>‸ ⁑ text/html⟭))
    (client (@in -> (http local 9813) -> @out format: binary) up)))

;; Client makes request, server hangs, client quits, server quits. Everything
;; must terminate properly. Also test changing request, response cell names.
(rack
  (frame
    (server (@pool (http local 9813) request: @in response: @out format: binary))
    (pool @pool)
    (cell @in (get "/"))
    (cell @out)
    (client (@in -> (http local 9813) -> @out format: binary)))

  (frame pattern: true fast-forward: true
    ((server (@pool (http local 9813) up request: @in response: @out format: binary))
     (pool @pool
       (device
         (cell @id _string)
         (cell @in (get ("/") host: "127.0.0.1:9813" user-agent: "Wirewright"))
         (cell @out)))
     (cell @in (get "/"))
     (cell @out)
     (client (@in -> (http local 9813) -> @out format: binary) up))))

;; HTTP request
(rack
  (frame
    (server (@pool (http local 9813) format: text)
      (backsys
        {¦ request_ -response_}
          <> {response: (ok ^\request)}))
    (pool @pool)

    (backsys
      {¦ response_: [ok body_] echoes: (_* `echo)}
        <> {(response): (),
            (echo):
              ((^when ((ml/term body) (ok term_))
                 ^term))})

    (queue (@request @requests)
      ;; Basics
      ((get "/")
       (get ("/"))
       ;; Params
       (get ("/" q: "alice"))
       (get ("/users" q: "alice"))
       (get ("/users" q: "alice" tag: "programming"))
       ;; Omission, many values
       (get
         ("/posts"
          type: "article"
          tag: ("computing" "programming" "fun")
          category: ()))
       ;; Method
       (post "/user/bob/posts" "Hello World")
       (put "/user/bob/name" "Bob Smith")
       (delete "/user/bob")
       ;; Body
       (post "/" "Kaixo mundua")
       ;; Cookies
       (get "/" cookies: {SESSION_ID: "deadbeef", "UserName": "alice"})
       ;; Form (URL-encoded)
       ((post form) "/employees/new"
         {name: "John Doe",
          age: 25,
          check: true})
       ;; Form (multipart)
       ((post form) "/"
         {name: "Jane",
          age: 25,
          check: true,
          ;; `likes` has multiple values:
          likes: ("Cheese" "Apples" "Carrots"),
          ;; `dislikes` will be omitted:
          dislikes: ()})
       ;; Complex form (multipart)
       ((post form) "/articles/create"
         (name: "Lorem ipsum",
          body:
            (field content-type: "text/html"
              "<p>Lorem ipsum dolor sit amet</p>"),
          tags: ("programming" "computers"),
          avatar:
            (file "avatar.png"
              ⟬89 50 4e 47 0d 0a 1a 0a 00 00 00 0d 49 48 44 52 00 00 00 20 00 00
               00 19 08 02 00 00 00 df 6d bb c6 00 00 00 01 73 52 47 42 01 d9 c9
               2c 7f 00 00 00 04 67 41 4d 41 00 00 b1 8f 0b fc ⁑ image/png⟭)))))

    (queue (@response @responses) ())
    (client (@request -> (http local 9813) -> @responses format: text))

    (cell @echoes ()))

  (frame/tail fast-forward: true
    (queue (@request @requests) ())
    (queue (@response @responses) ())
    (client (@request -> (http local 9813) -> @responses format: text) up)

    (cell @echoes
      ;; Basics
      ((get ("/") host: "127.0.0.1:9813" user-agent: "Wirewright")
       (get ("/") host: "127.0.0.1:9813" user-agent: "Wirewright")
       ;; Params
       (get ("/" q: "alice") host: "127.0.0.1:9813" user-agent: "Wirewright")
       (get ("/users" q: "alice") host: "127.0.0.1:9813" user-agent: "Wirewright")
       (get ("/users" q: "alice" tag: "programming")
         host: "127.0.0.1:9813"
         user-agent: "Wirewright")
       ;; Omission, many values
       (get ("/posts" tag: ("computing" "programming" "fun") type: "article")
         host: "127.0.0.1:9813"
         user-agent: "Wirewright")
       ;; Method
       (post ("/user/bob/posts")
          "Hello World"
         host: "127.0.0.1:9813"
         user-agent: "Wirewright")
       (put ("/user/bob/name")
          "Bob Smith"
         host: "127.0.0.1:9813"
         user-agent: "Wirewright")
       (delete ("/user/bob") host: "127.0.0.1:9813" user-agent: "Wirewright")
       ;; Blob body
       (post ("/")
          "Kaixo mundua"
         host: "127.0.0.1:9813"
         user-agent: "Wirewright")
       ;; Cookies
       (get ("/")
         cookies: {SESSION_ID: "deadbeef", UserName: "alice"}
         host: "127.0.0.1:9813"
         user-agent: "Wirewright")
       ;; Form (URL-encoded)
       ((post form) ("/employees/new")
          {age: "25", check: "on", name: "John Doe"}
         host: "127.0.0.1:9813"
         user-agent: "Wirewright")
       ;; Form (multipart)
       ((post form) ("/")
          {age: "25",
           check: "on",
           likes: ("Cheese" "Apples" "Carrots"),
           name: "Jane"}
         host: "127.0.0.1:9813"
         user-agent: "Wirewright")
       ;; Complex form (multipart)
       ((post form) ("/articles/create")
          {multipart: true,
           name: (field ⟬‸Lorem ipsum‸ ⁑ text/plain⟭),
           body:
             (field
               ⟬‸<p>Lorem ipsum dolor sit amet</p>‸ ⁑ text/html⟭),
           tags:
             ((field ⟬‸programming‸ ⁑ text/plain⟭)
              (field ⟬‸computers‸ ⁑ text/plain⟭)),
           avatar:
             (file "avatar.png"
               ⟬89 50 4e 47 0d 0a 1a 0a 00 00 00 0d 49 48 44 52 00 00 00 20 00 00
                00 19 08 02 00 00 00 df 6d bb c6 00 00 00 01 73 52 47 42 01 d9 c9
                2c 7f 00 00 00 04 67 41 4d 41 00 00 b1 8f 0b fc ⁑ image/png⟭)}
         host: "127.0.0.1:9813",
         user-agent: "Wirewright")))))

;; HTTP response
(rack
  (frame
    (server (@pool (http local 9813) format: binary)
      (backsys
        {¦ request: [get ("/") ml_blob] -response_}
          <> {(request): (),
              (response): ((^when ((ml/term ml) (ok term_)) ^term))}))

    (backsys
      {¦ testcases: (testcase_ _*) -request_}
        <> {(testcase): (), request: (get "/" ^(ml/compact testcase))})

    (pool @pool)

    (cell @testcases
      ;; Basics
      ((ok)
       (ok "Hello World")
       (ok "<h1>Hi</h1>" content-type: "text/html")
       (ok ⟬de ad be ef⟭)
       ;; Status codes
       (not-found "<h1>Page not found</h1>" content-type: "text/html")
       (200 "<h1>Ok</h1>" content-type: "text/html")
       ((not-found "Lorem ipsum") "dolor sit amet")
       ((404 "Lorem ipsum") "dolor sit amet")
       ;; Cookies
       (ok "<p>Hello World!</p>"
         content-type: "text/html"
         x-content-id: "10"
         cookies:
           ((cookie name "Alice")
            (cookie session-id "1ea962e07b" max-age: (1 m))))
       ;; Attachment
       (ok (attachment ⟬de ad be ef⟭))
       ;; File attachment
       (ok
         (file "avatar.png"
           ⟬89 50 4e 47 0d 0a 1a 0a 00 00 00 0d 49 48 44 52 00 00 00 20 00 00
            00 19 08 02 00 00 00 df 6d bb c6 00 00 00 01 73 52 47 42 01 d9 c9
            2c 7f 00 00 00 04 67 41 4d 41 00 00 b1 8f 0b fc ⁑ image/png⟭))))

    (cell @request)
    (queue (@response @responses) ())
    (client (@request -> (http local 9813) -> @responses format: binary)))

  (frame/tail fast-forward: true
    (pool @pool)
    (cell @testcases ())
    (cell @request)

    (queue (@response @responses)
      ((ok)
       (ok ⟬‸Hello World‸ ⁑ text/plain⟭)
       (ok ⟬‸<h1>Hi</h1>‸ ⁑ text/html⟭)
       (ok ⟬de ad be ef⟭)
       (not-found
         ⟬‸<h1>Page not found</h1>‸ ⁑ text/html⟭)
       (ok ⟬‸<h1>Ok</h1>‸ ⁑ text/html⟭)
       ((not-found "Lorem ipsum") ⟬‸dolor sit amet‸ ⁑ text/plain⟭)
       ((not-found "Lorem ipsum") ⟬‸dolor sit amet‸ ⁑ text/plain⟭)
       (ok
         ⟬‸<p>Hello World!</p>‸  ⁑ text/html⟭
         cookies:
           ((cookie "name" "Alice" secure: false)
            (cookie "session-id" "1ea962e07b" max_age: (≈1.0 m) secure: false))
         x-content-id: "10")
       (ok (attachment ⟬de ad be ef⟭))
       (ok
         (file "avatar.png"
           ⟬89 50 4e 47 0d 0a 1a 0a 00 00 00 0d 49 48 44 52 00 00 00 20 00 00
            00 19 08 02 00 00 00 df 6d bb c6 00 00 00 01 73 52 47 42 01 d9 c9
            2c 7f 00 00 00 04 67 41 4d 41 00 00 b1 8f 0b fc ⁑ image/png⟭))))

    (client (@request -> (http local 9813) -> @responses format: binary) up)))

;; Basic routing
(rack
  (frame
    (server (@pool (http local 9813) format: binary)
      (backsys
        {¦ request_: [get resource_] -route_}
          <> {(request): (), route: ^resource}
        {¦ page_string -response_}
          <> {response: (ok ^page content-type: "text/html")})

      (cell @route)
      (cell @page)
      (rewriter (@route -> (rulesetR) -> @page)
        _ => "<h1>Not found</h1>"
        ("/") => "<h1>Home</h1>"
        ("/search" ¦ () q_string) => ^"<h1>Search query: ⸢q⸣</h1>"
        ("/articles" ¦ () id_string) => ^"<h1>Article with id: ⸢id⸣</h1>"))

    (pool @pool)

    (queue (@request @requests)
      ((get "/")
       (get ("/search" q: "alice"))
       (get ("/articles" id: "0"))
       (get "/not-found")))

    (queue (@response @responses) ())

    (client (@request -> (http local 9813) -> @responses format: binary)))

  (frame/tail fast-forward: true
    (queue (@request @requests) ())
    (queue (@response @responses)
      ((ok ⟬‸<h1>Home</h1>‸ ⁑ text/html⟭)
       (ok ⟬‸<h1>Search query: alice</h1>‸ ⁑ text/html⟭)
       (ok ⟬‸<h1>Article with id: 0</h1>‸ ⁑ text/html⟭)
       (ok ⟬‸<h1>Not found</h1>‸ ⁑ text/html⟭)))
    (client (@request -> (http local 9813) -> @responses format: binary) up)))

;; Crude HTML templating with rewriters
(rack
  (frame
    (server (@pool (http local 9813) format: binary)
      (backsys
        {¦ request_ -template_ -status_}
          <> {(request): (),
              status: not-found,
              template:
                (html
                  (head
                    (title "Not found"))
                  (body
                    (h1 "Oops")))}
        {¦ request_: [get ("/")] -template_ -status_}
          <> {(request): (),
              status: ok,
              template:
                (html
                  (head
                    (title "Demo page"))
                  (body
                    (h1 "Kaixo mundua!" style: "color: red")
                    (p "Lorem ipsum dolor sit amet")))}
        {¦ page_string status_⋮ ok -response_}
          <> {response: (^status ^page content-type: "text/html")})

      (cell @template)
      (cell @page)
      (cell @status)

      ;; NOTE: This is, of course, **not** how you should do HTML if you ever
      ;; want to; there'd hopefully be format: html at some point in the future.
      ;; For tests, something like this will do, though!
      (rewriter (@template -> (chainR (ascR (rulesetR phase: build)) (rulesetR phase: finalize)) -> @page)
        (build (tag_symbol children_* ¦ attrs_))
          => (^"<⸢tag⸣" (^unless (= attrs {}) " ")
              (^each (attrs entry as (k_ v_))
                ^"⸢k⸣=\"⸢v⸣\"")
              ">"
              (^each (children as child_)
                (^match child
                  (when _dict ^*child)
                  (when _string ^child)))
              ^"</⸢tag⸣>")
        (finalize fragments←(_string*))
          => ^(join fragments)))

    (pool @pool)

    (queue (@request @requests)
      ((get "/")
       (get "/not-found")))

    (queue (@response @responses) ())

    (client (@request -> (http local 9813) -> @responses format: binary)))

  (frame/tail fast-forward: true
    (pool @pool)

    (queue (@request @requests) ())
    (queue (@response @responses)
      ((ok ⟬‸<html><head><title>Demo page</title></head><body><h1 style="color: red">Kaixo mundua!</h1><p>Lorem ipsum dolor sit amet</p></body></html>‸ ⁑ text/html⟭)
       (not-found ⟬‸<html><head><title>Not found</title></head><body><h1>Oops</h1></body></html>‸ ⁑ text/html⟭)))

    (client (@request -> (http local 9813) -> @responses format: binary) up)))

;; Default port for HTTP
(rack
  (frame
    (server (@pool (http local 8080) format: text)
      (backsys
        {¦ request_: [get ("/")] -response_}
          <> {(request): (), response: (ok "Hello World")}))
    (pool @pool)
    (cell @in (get "/"))
    (cell @out)
    (client (@in -> (http local) -> @out format: text)))

  (frame/tail fast-forward: true
    (pool @pool)
    (cell @in)
    (cell @out (ok "Hello World"))
    (client (@in -> (http local) -> @out format: text) up)))

;; Very basic HTTPS
(rack
  (frame
    (frag @server
      ;; FIXME: the use of relative paths here is very ugly!
      (server (@pool (https local 9813 key: "./tests/public/openssl.key" cert: "./tests/public/openssl.crt") format: text)
        (backsys
          {¦ request_: [get ("/")] -response_}
            <> {(request): (), response: (ok "Hello World")})))

    (pool @pool)

    (cell @in (get "/"))
    (cell @out)
    ;; FIXME: For some reason, there's a race here, which is rare (if present) when this
    ;; test is run alone; but quite frequent when it is run in combination with any
    ;; other test featuring an http server (e.g. the test above). The client appears to
    ;; connect to *something* before the server actually starts (server is pending but
    ;; client is already up!) When the server finally turns up, the client's connection
    ;; is dropped (Connection refused). I'm not sure what might be the reason for this.
    (guard (@server (server [@_ _ up] _*))
      (client (@in -> (https local 9813 verify: false) -> @out format: text))))

  (frame/tail fast-forward: true
    (cell @in)
    (cell @out (ok "Hello World"))
    (guard (@server (server [@_ _ up] _*))
      (client (@in -> (https local 9813 verify: false) -> @out format: text) up))))

;; format-policy: abort, encode

;; format-policy: abort, decode
