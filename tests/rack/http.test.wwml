;; Passthrough format: binary
(rack
  (frame
    (server (@pool (http local 9813) format: binary)
      (backsys
        {¦ request_: [get ("/") body_] -response_}
          <> {(request): (), response: (ok ^body)}))

    (pool @pool)

    (cell @in (get "/" "Hello World"))
    (cell @out)
    (client (@in -> (http local 9813) -> @out format: binary)))

  (frame/tail fast-forward: true
    ;; Server must have cleared the pool since the request is done.
    (pool @pool)

    (cell @in)
    (cell @out (ok ⟬‸Hello World‸ ⁑ text/plain⟭))
    (client (@in -> (http local 9813) -> @out format: binary) up)))

