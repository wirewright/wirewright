;; Passthrough format: none
(rack
  (frame
    (server (@pool (http local 9813))
      (backsys
        {¦ request_: [get ("/") body_] -response_}
          <> {(request): (), response: (ok ^body)}))

    (circuit (pool @pool))

    (cell @in (get "/" "Hello World"))
    (cell @out)
    (client (@in -> (http local 9813) -> @out)))

  (frame/tail fast-forward: true
    ;; Server must have cleared the pool since the request is done.
    (circuit (pool @pool))

    (cell @in)
    (cell @out (ok "Hello World"))
    (client (@in -> (http local 9813) -> @out) up)))

