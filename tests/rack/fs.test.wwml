;; A more-or-less comprehensive test for `path...report`.
(rack
  (frame
    ;; File system manipulation.
    (cell @fs-in)
    (cell @fs-out)
    (discard @fs-out (ok _))
    (fs @fs-in @fs-out)

    ;; Basic test infrastructure.
    (node @readings (group))
    (backsys
      {¦ plan: (action←((%any create delete overwrite) _*) _*) -fs-in_}
        <> {(action): (), fs-in: ^action}
      {¦ plan: (action←(add reading path_string) _*) readings: (_* `>reading)}
        <> {(action): (), >reading: (path (^path reading))}
      {¦ plan: (action←(expect path_string content_) _*) readings: ⟨(path (path_ reading) (present content_))⟩}
        <> {(action): ()}
      {¦ plan: (action←(expect path_string absent) _*) readings: ⟨(path (path_ reading) (absent _))⟩}
        <> {(action): ()})

    ;; Summation machinery.
    (module {:@readings, :@fs-in}
      ;; Observe the two readings.
      (part (@readings @a)
        ⟨(path ("/tmp/wirewright-path0-a" reading) (present a_string))⟩)
      (part (@readings @b)
        ⟨(path ("/tmp/wirewright-path0-b" reading) (present b_string))⟩)

      ;; Parse them as numbers.
      (parser (@a - top - @n) (top (form "[%d]+" nat)))
      (parser (@b - top - @m) (top (form "[%d]+" nat)))

      ;; Sum them.
      (cell @n)
      (cell @m)
      (cell @sum)
      (frag @sums (journal (@sum)))

      (backsys
        ;; Maintain sum as depdenency of n, m.
        {¦ -n sum_} <> {(sum): ()}
        {¦ -m sum_} <> {(sum): ()}
        {¦ ±n ±m ⋮sum} <> {sum: ^(+ n m)}
        ;; Write to disk on change.
        {¦ sums: (journal _ event←((%any appeared changed) ±sum) _*) -fs-in_}
          <> {(event): (), fs-in: (overwrite file "/tmp/wirewright-path0-sum" ^(ml/compact sum))}
        ;; Remove sum file when we don't have a sum.
        {¦ sums: (journal _ event←(disappeared _) _*) -fs-in_}
          <> {(event): (), fs-in: (delete file "/tmp/wirewright-path0-sum")}))

    (cell @plan
      ((delete file if exists "/tmp/wirewright-path0-a")
       (delete file if exists "/tmp/wirewright-path0-b")
       (delete file if exists "/tmp/wirewright-path0-sum")

       (add reading "/tmp/wirewright-path0-a")
       (add reading "/tmp/wirewright-path0-b")
       (add reading "/tmp/wirewright-path0-sum")

       (expect "/tmp/wirewright-path0-a" absent)
       (expect "/tmp/wirewright-path0-b" absent)
       (expect "/tmp/wirewright-path0-sum" absent)

       (overwrite file "/tmp/wirewright-path0-a" "100")
       (expect "/tmp/wirewright-path0-a" "100")
       (expect "/tmp/wirewright-path0-b" absent)
       (expect "/tmp/wirewright-path0-sum" absent)

       (overwrite file "/tmp/wirewright-path0-b" "200")
       (expect "/tmp/wirewright-path0-a" "100")
       (expect "/tmp/wirewright-path0-b" "200")
       (expect "/tmp/wirewright-path0-sum" "300")

       (overwrite file "/tmp/wirewright-path0-a" "123")
       (expect "/tmp/wirewright-path0-a" "123")
       (expect "/tmp/wirewright-path0-b" "200")
       (expect "/tmp/wirewright-path0-sum" "323")

       (overwrite file "/tmp/wirewright-path0-b" "456")
       (expect "/tmp/wirewright-path0-a" "123")
       (expect "/tmp/wirewright-path0-b" "456")
       (expect "/tmp/wirewright-path0-sum" "579")

       (delete file "/tmp/wirewright-path0-a")
       (expect "/tmp/wirewright-path0-a" absent)
       (expect "/tmp/wirewright-path0-b" "456")
       (expect "/tmp/wirewright-path0-sum" absent)

       (delete file "/tmp/wirewright-path0-b")
       (expect "/tmp/wirewright-path0-a" absent)
       (expect "/tmp/wirewright-path0-b" absent)
       (expect "/tmp/wirewright-path0-sum" absent))))

  ;; If the plan is empty this means we've executed everything successfully.
  ;; If it clogs then there's a failure.
  (frame/tail fast-forward: true
    (cell @plan ())))

;; Recursive watching example from docs, also tests many `rack.fs` requests.
(rack
  (frame
    (circuit @reports
      (path ("/tmp/wirewright-path1" report) root: true))

    (rewriter ((scanR (rulesetR)) <-> @reports)
      ;; Remove reports that are absent, except the root report.
      R←(path (_ report) [absent _] ⍊ -root)
        <> {(R): ()}
      ;; Spawn child reports.
      R←(path (path_string report) (dir members_* ⍊ -valid_) ⍊ offspring⋮ {})
        <> {valid: true,
            offspring: ^(set members [_ member_string]),
            (R):
              (^(up R)
               (^when ((members offspring) (⟨[_ member_string]⟩° (%-value member)))
                 (path (^"⸢path⸣/⸢member⸣" report))))})

    (supervisor (@reports @report [path (path_string report) _] - @pool)
      (frag (@report [path (path_string report) _]
                       -> (appearance paths `path)
                          (appearance paths path_))
        (appearance paths)))

    (circuit (pool @pool))

    (frag @journal
      (sensor (journal paths _string)))

    (cell @in)
    (cell @out)
    (fs @in @out)

    (backsys
      {¦ plan: (action_ _*) -in_ -out}
        <> {(action): (), in: ^action}
      {¦ plan: (action←(expect entries_*) _*) journal: ((%plural/max) (%plural/min entries)) out_: (ok _)}
        <> {(action): (), (out): ()})

    (cell @plan
      ((delete dir if exists "/tmp/wirewright-path1" recursive: true)
       (expect)

       (create dir "/tmp/wirewright-path1")
       (expect (appeared "/tmp/wirewright-path1"))

       (create file "/tmp/wirewright-path1/a")
       (expect (appeared "/tmp/wirewright-path1/a"))

       (create file "/tmp/wirewright-path1/b")
       (expect (appeared "/tmp/wirewright-path1/b"))

       (create dir "/tmp/wirewright-path1/subdir")
       (expect (appeared "/tmp/wirewright-path1/subdir"))

       (create file "/tmp/wirewright-path1/subdir/x")
       (expect (appeared "/tmp/wirewright-path1/subdir/x"))

       (create file "/tmp/wirewright-path1/subdir/y")
       (expect (appeared "/tmp/wirewright-path1/subdir/y"))

       (create dir "/tmp/wirewright-path1/subdir/foo")
       (expect (appeared "/tmp/wirewright-path1/subdir/foo"))

       (create dir "/tmp/wirewright-path1/subdir/bar")
       (expect (appeared "/tmp/wirewright-path1/subdir/bar"))

       (create file "/tmp/wirewright-path1/subdir/foo/qux")
       (expect (appeared "/tmp/wirewright-path1/subdir/foo/qux"))

       (create file "/tmp/wirewright-path1/subdir/foo/qyx")
       (expect (appeared "/tmp/wirewright-path1/subdir/foo/qyx"))

       (delete file "/tmp/wirewright-path1/subdir/foo/qux")
       (expect (disappeared "/tmp/wirewright-path1/subdir/foo/qux"))

       (delete file "/tmp/wirewright-path1/subdir/foo/qyx")
       (expect (disappeared "/tmp/wirewright-path1/subdir/foo/qyx"))

       (delete dir "/tmp/wirewright-path1/subdir/foo")
       (expect (disappeared "/tmp/wirewright-path1/subdir/foo"))

       (delete dir "/tmp/wirewright-path1/subdir/bar")
       (expect (disappeared "/tmp/wirewright-path1/subdir/bar"))

       (delete file "/tmp/wirewright-path1/subdir/x")
       (expect (disappeared "/tmp/wirewright-path1/subdir/x"))

       (delete dir "/tmp/wirewright-path1/subdir" recursive: true)
       (expect
         (disappeared "/tmp/wirewright-path1/subdir")
         (disappeared "/tmp/wirewright-path1/subdir/y"))

       (delete file "/tmp/wirewright-path1/a")
       (expect (disappeared "/tmp/wirewright-path1/a"))

       (create file "/tmp/wirewright-path1/kaixo")
       (expect (appeared "/tmp/wirewright-path1/kaixo"))

       (delete dir "/tmp/wirewright-path1" recursive: true)
       (expect
         (disappeared "/tmp/wirewright-path1/b")
         (disappeared "/tmp/wirewright-path1/kaixo")))))

  ;; If it didn't clog this means we've executed successfully.
  (frame/tail fast-forward: true
    (cell @plan ())))
