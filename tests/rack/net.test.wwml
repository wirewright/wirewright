;; Unix socket counter with transmission: handshake
(rack
  (frame
    (cell @fs-in (delete file if exists "/tmp/wirewright-unix.sock"))
    (cell @fs-out)
    (fs @fs-in @fs-out)

    (guard (@fs-out [ok _])
      (server (@pool (unix "/tmp/wirewright-unix.sock" transmission: handshake) format: ml)
        (backsys
          {¦ in: (±M _*) out: (_* `>M)}
            <> {(M): (), >M: ^(+ M 1)})))

    (circuit (pool @pool))

    (client (@in -> (unix "/tmp/wirewright-unix.sock" transmission: handshake) -> @out format: ml))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))
