;; Client format: json
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool (ws local 9813))
        (feed (@in front) (@out back)))
      (circuit (pool @pool)))

    ;; Client
    (module {}
      (queue (@message @messages)
        (100
         (+ 1 2)
         (+ 1 2 x: 100 y: 200)
         "hello world\n"))
      (client (@message -> (ws local 9813) -> @replies format: json))
      (queue (@reply @replies) ())))

  (frame/tail fast-forward: true
    (module {}
      (queue (@message @messages) ())
      (client (@message -> (ws local 9813) -> @replies format: json) up)
      (queue (@reply @replies)
        (100
         ("+" 1 2)
         ;; Since there's no schema, this is the best format: json can do!
         {"0": "+", "1": 1, "2": 2, "x": 100, "y": 200}
         "hello world\n")))))

;; Client format: json schema
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool (ws local 9813))
        (feed (@in front) (@out back)))
      (circuit (pool @pool)))

    ;; Client
    (schema (@schema json)
      expr => _number
      expr => (seq + (ref expr) (ref expr)))

    (client (@message -> (ws local 9813) -> @replies format: (json @schema expr)))
    (queue (@message @messages)
      (100
       (+ 1 2)
       (+ (+ 1 2) 3)
       (+ 1 (+ 2 3))
       (+ (+ 1 2) (+ 2 3))
       (+ 1)
       "invalid"
       (+ 1.23 4.56)))
    (queue (@reply @replies) ()))

  (frame/tail fast-forward: true
    (queue (@message @messages) ())
    (queue (@reply @replies)
      (100
       (+ 1 2)
       (+ (+ 1 2) 3)
       (+ 1 (+ 2 3))
       (+ (+ 1 2) (+ 2 3))
       ;; (+ 1) discarded
       ;; "invalid" discarded
       (+ ≈1.23 ≈4.56)))))

;; Client format-policy: abort
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool (ws local 9813))
        (cell @script ("(+ 1 2)" "(+ 1 error"))
        (feed (@script front) (@out back)))
      (circuit (pool @pool)))

    (cell @message)
    (client (@message -> (ws local 9813) -> @replies format: ml format-policy: abort))
    (queue (@reply @replies) ()))

  (frame/tail fast-forward: true
    (cell @message)
    (client (@message -> (ws local 9813) -> @replies format: ml format-policy: abort)
      (dn "invalid message")) ;; connection was dropped on the client-side
    (queue (@reply @replies) ((+ 1 2)))))

;; Client format-policy: wrap
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool (ws local 9813))
        (cell @script ("(+ 1 2)" "(+ 1 error"))
        (feed (@script front) (@out back)))
      (circuit (pool @pool)))

    (cell @message)
    (client (@message -> (ws local 9813) -> @replies format: ml format-policy: wrap))
    (queue (@reply @replies) ()))

  (frame/tail fast-forward: true
    (cell @message)
    (client (@message -> (ws local 9813) -> @replies format: ml format-policy: wrap)
      up)
    (queue (@reply @replies)
      ((ok (+ 1 2))
       (err "invalid message")))))

;; Client-Server exchange using terms
(rack
  (frame
    (module {}
      (server (@pool (ws local 9813) format: ml)
        (backsys
          {¦ in: (msg_ _*)}
            <> {(msg): ()}
          {¦ in: (n←(%number 0 <= _ < 5) _*) out: (_* `>n)}
            <> {>n: ^(+ n 1)}
          {¦ in: (5 _*) out: (_* `>reply)}
            <> {>reply: done}))

      (circuit (pool @pool)))

    (backsys
      {¦ reply_ log: (_* `>reply)}
        <> {(reply): (), >reply: ^reply}
      {¦ ±reply -messages_}
        <> {messages: ^reply}
      {¦ reply: done socket_}
        <> {(socket): ()})

    (cell @log ())
    (queue (@message @messages) (0))
    (frag @socket
      (client (@message -> (ws local 9813) -> @replies format: ml)))
    (queue (@reply @replies) ()))

  ;; Wait until it counts up to `done`.
  (frame/tail fast-forward: true
    (cell @log (1 2 3 4 5))
    (queue (@message @messages) ())
    (frag @socket
      (client (@message -> (ws local 9813) -> @replies format: ml)
        up))
    (queue (@reply @replies) (done)))

  ;; Socket is removed in response to `done`:
  (frame/tail
    (cell @log (1 2 3 4 5 done))
    (queue (@message @messages) ())
    (frag @socket)
    (queue (@reply @replies) ()))

  ;; Make sure the server responds properly by cleaning up the connection.
  (frame/tail fast-forward: true
    (module {}
      (server (@pool (ws local 9813) up format: ml) ;; < server is up
        (backsys
          {¦ in: (msg_ _*)}
            <> {(msg): ()}
          {¦ in: (n←(%number 0 <= _ < 5) _*) out: (_* `>n)}
            <> {>n: ^(+ n 1)}
          {¦ in: (5 _*) out: (_* `>reply)}
            <> {>reply: done}))

      (circuit (pool @pool))) ;; < pool is empty -- client disconnected

    (backsys
      {¦ reply_ log: (_* `>reply)}
        <> {(reply): (), >reply: ^reply}
      {¦ ±reply -messages_}
        <> {messages: ^reply}
      {¦ reply: done socket_}
        <> {(socket): ()})

    (cell @log (1 2 3 4 5 done))
    (queue (@message @messages) ())
    (frag @socket)
    (queue (@reply @replies) ())))

;; From docs: websocket client with format: ml.
(rack
  (frame
    (server (@pool (ws local 5000))
      (feed (@in front) (@out back)))
    (circuit (pool @pool))
    (queue (@message @messages) (foo 100 ≈1.23 false (+ 1 2 x: 100 y: 200)))
    (queue (@reply @replies) ())
    (client (@message -> (ws local 5000) -> @replies format: ml)))

  (frame/tail fast-forward: true
    (queue (@message @messages) ())
    (queue (@reply @replies) (foo 100 ≈1.23 false (+ 1 2 x: 100 y: 200)))
    (client (@message -> (ws local 5000) -> @replies format: ml)
      up)))

;; WebSocket counter
(rack
  (frame
    (server (@pool (ws local 9813) format: ml)
      (backsys
        {¦ in: (±M _*) out: (_* `>M)}
          <> {(M): (), >M: ^(+ M 1)}))

    (circuit (pool @pool))

    (client (@in -> (ws local 9813) -> @out format: ml))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

;; TCP counter
(rack
  (frame
    (server (@pool (tcp local 9813) format: ml)
      (backsys
        {¦ in: (±M _*) out: (_* `>M)}
          <> {(M): (), >M: ^(+ M 1)}))

    (circuit (pool @pool))

    (client (@in -> (tcp local 9813) -> @out format: ml))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

;; Unix socket counter
(rack
  (frame
    (cell @fs-in (delete file if exists "/tmp/wirewright-unix.sock"))
    (cell @fs-out)
    (fs @fs-in @fs-out)

    (guard (@fs-out [ok _])
      (server (@pool (unix "/tmp/wirewright-unix.sock") format: ml)
        (backsys
          {¦ in: (±M _*) out: (_* `>M)}
            <> {(M): (), >M: ^(+ M 1)})))

    (circuit (pool @pool))

    (client (@in -> (unix "/tmp/wirewright-unix.sock") -> @out format: ml))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

;; WebSocket counter with transmission: handshake
(rack
  (frame
    (server (@pool (ws local 9813 transmission: handshake) format: ml)
      (backsys
        {¦ in: (±M _*) out: (_* `>M)}
          <> {(M): (), >M: ^(+ M 1)}))

    (circuit (pool @pool))

    (client (@in -> (ws local 9813 transmission: handshake) -> @out format: ml))
    (feed @out @in)
    (cell @out)
    (cell @in 0))

  ;; It will count indefinitely, of course. Just make sure it can count to some
  ;; "significant" number.
  (frame/tail fast-forward: true
    (cell @in 10)))

