;; Client format: ml
(rack
  (frame
    ;; Server
    (module {}
      (server (@pool (ws local 9813))
        (feed (@in front) (@out back)))
      (circuit (pool @pool)))

    ;; Client
    (module {}
      (queue (@message @messages)
        (100
         (+ 1 2)
         (+ 1 2 x: 100 y: 200)
         "hello world\n"))
      (client (@message -> (ws local 9813) -> @replies format: ml))
      (queue (@reply @replies) ())))

  (frame/tail fast-forward: true
    (module {}
      (queue (@message @messages) ())
      (client (@message -> (ws local 9813) -> @replies format: ml) up)
      (queue (@reply @replies)
        (100
         (+ 1 2)
         (+ 1 2 x: 100 y: 200)
         "hello world\n")))))

