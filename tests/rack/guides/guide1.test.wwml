(rack
  (frame
    (cell @x 100)
    (cell @y 200)
    (cell @a)
    (cell @b)
    (feed (@x @y) (@a @b)))

  (frame
    (cell @x)
    (cell @y)
    (cell @a 100)
    (cell @b 200)
    (feed (@x @y) (@a @b)))

  end)

(rack
  (frame
    (cell @x 100)
    (cell @y)
    (cell @z)
    (feed @x (@y @z)))

  (frame
    (cell @x)
    (cell @y 100)
    (cell @z 100)
    (feed @x (@y @z)))

  end)

(rack
  (frame
    (cell @x 100)
    (cell @y)
    (feed (not @inhibitor) @x @y)
    (cell @inhibitor))

  (frame
    (cell @x)
    (cell @y 100)
    (feed (not @inhibitor) @x @y)
    (cell @inhibitor))

  end)

(rack
  (frame
    (cell @x 100)
    (cell @y)
    (feed (not @inhibitor) @x @y)
    (cell @inhibitor "A value"))

  end)

(rack
  (frame
    (cell @xs (1 2 3))
    (cell @ys (100 200 300))
    (cell @z)
    (feed ((@xs front) (@ys back)) @z))

  (frame
    (cell @xs (2 3))
    (cell @ys (100 200))
    (cell @z (1 300))
    (feed ((@xs front) (@ys back)) @z))

  end)

(rack
  (frame
    (cell @xs (1 2 3 4 5))
    (cell @y)
    (feed (not @z) (@xs front) @y)
    (feed @y @z)
    (cell @z)
    (feed @z (@zs back))
    (cell @zs ()))

  (frame
    (cell @xs (2 3 4 5))
    (cell @y 1)
    (feed (not @z) (@xs front) @y)
    (feed @y @z)
    (cell @z)
    (feed @z (@zs back))
    (cell @zs ()))

  (frame
    (cell @xs (2 3 4 5))
    (cell @y)
    (feed (not @z) (@xs front) @y)
    (feed @y @z)
    (cell @z 1)
    (feed @z (@zs back))
    (cell @zs ()))

  (frame
    (cell @xs (2 3 4 5))
    (cell @y)
    (feed (not @z) (@xs front) @y)
    (feed @y @z)
    (cell @z)
    (feed @z (@zs back))
    (cell @zs (1)))

  (frame
    (cell @xs (3 4 5))
    (cell @y 2)
    (feed (not @z) (@xs front) @y)
    (feed @y @z)
    (cell @z)
    (feed @z (@zs back))
    (cell @zs (1)))

  (frame
    (cell @xs (3 4 5))
    (cell @y)
    (feed (not @z) (@xs front) @y)
    (feed @y @z)
    (cell @z 2)
    (feed @z (@zs back))
    (cell @zs (1)))

  (frame
    (cell @xs (3 4 5))
    (cell @y)
    (feed (not @z) (@xs front) @y)
    (feed @y @z)
    (cell @z)
    (feed @z (@zs back))
    (cell @zs (1 2))))
  ;; And so on for the remaining numbers

(rack
  (frame
    (cell @x (1 2 3 4 5))
    (cell @y ())
    (feed (not @b) (@x front) (@y back))

    (cell @a .)
    (cell @b)
    (feed @a @b @a))

  (frame
    (cell @x (2 3 4 5))
    (cell @y (1))
    (feed (not @b) (@x front) (@y back))

    (cell @a)
    (cell @b .)
    (feed @a @b @a))

  (frame
    (cell @x (2 3 4 5))
    (cell @y (1))
    (feed (not @b) (@x front) (@y back))

    (cell @a .)
    (cell @b)
    (feed @a @b @a))

  (frame
    (cell @x (3 4 5))
    (cell @y (1 2))
    (feed (not @b) (@x front) (@y back))

    (cell @a)
    (cell @b .)
    (feed @a @b @a)))
  ;; And so on for the remaining numbers

(rack
  (frame
    (cell @x (0 1 2 3 4))
    (cell @y (5 6 7 8 9))
    (cell @z ())

    (feed (not @b) (@x front) (@z back))
    (feed (not @a) (@y front) (@z back))

    (cell @a .)
    (cell @b)
    (feed @a @b @a))

  (frame
    (cell @x (1 2 3 4))
    (cell @y (5 6 7 8 9))
    (cell @z (0))

    (feed (not @b) (@x front) (@z back))
    (feed (not @a) (@y front) (@z back))

    (cell @a)
    (cell @b .)
    (feed @a @b @a))

  (frame
    (cell @x (1 2 3 4))
    (cell @y (6 7 8 9))
    (cell @z (0 5))

    (feed (not @b) (@x front) (@z back))
    (feed (not @a) (@y front) (@z back))

    (cell @a .)
    (cell @b)
    (feed @a @b @a))

  (frame
    (cell @x (2 3 4))
    (cell @y (6 7 8 9))
    (cell @z (0 5 1))

    (feed (not @b) (@x front) (@z back))
    (feed (not @a) (@y front) (@z back))

    (cell @a)
    (cell @b .)
    (feed @a @b @a))

  (frame
    (cell @x (2 3 4))
    (cell @y (7 8 9))
    (cell @z (0 5 1 6))

    (feed (not @b) (@x front) (@z back))
    (feed (not @a) (@y front) (@z back))

    (cell @a .)
    (cell @b)
    (feed @a @b @a)))
  ;; And so on for the remaining numbers
