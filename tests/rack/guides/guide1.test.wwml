    (cell @z (3))
    (backsys
      {¦ x: (a_ _*) y: (_* `>a)} <> {(a): (), >a: ^a}
      {¦ x: (_* a_) z: (_* `>a)} <> {(a): (), >a: ^a}))

  (frame
    (cell @x ())
