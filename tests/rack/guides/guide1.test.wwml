(rack
  (frame
    (cell @x (1 2 3))
    (cell @y ())
    (feed (@x front) (@y back)))

  (frame
    (cell @x (2 3))
    (cell @y (1))
    (feed (@x front) (@y back)))

  (frame
    (cell @x (3))
    (cell @y (1 2))
    (feed (@x front) (@y back)))

  (frame
    (cell @x ())
    (cell @y (1 2 3))
    (feed (@x front) (@y back)))

  end)

(rack
  (frame
    (cell @x (1 2 3))
    (cell @y ())
    (cell @z ())
    (feed (@x front) (@y back))
    (feed (@y front) (@z back)))

  (frame
    (cell @x (2 3))
    (cell @y (1))
    (cell @z ())
    (feed (@x front) (@y back))
    (feed (@y front) (@z back)))

  end)

(rack
  (frame
    (cell @x (1 2 3))
    (cell @y ())
    (cell @z ())
    (feed (@x front) (@y back))
    (feed (@x back) (@z back)))

  end)

(rack
  (frame
    (cell @x (1 2 3 4))
    (cell @y ())
    (cell @z ())
    (backsys
      {¦ x: (a_ _*) y: (_* `>a)} <> {(a): (), >a: ^a}
      {¦ x: (_* a_) z: (_* `>a)} <> {(a): (), >a: ^a}))

  (frame
    (cell @x (2 3))
    (cell @y (1))
    (cell @z (4))
    (backsys
      {¦ x: (a_ _*) y: (_* `>a)} <> {(a): (), >a: ^a}
      {¦ x: (_* a_) z: (_* `>a)} <> {(a): (), >a: ^a}))

  (frame
    (cell @x ())
    (cell @y (1 2))
    (cell @z (4 3))
    (backsys
      {¦ x: (a_ _*) y: (_* `>a)} <> {(a): (), >a: ^a}
      {¦ x: (_* a_) z: (_* `>a)} <> {(a): (), >a: ^a}))

  end)

(rack
  (frame
    (cell @x (1 2 3))
    (cell @y ())
    (cell @z ())
    (backsys
      {¦ x: (a_ _*) y: (_* `>a)} <> {(a): (), >a: ^a}
      {¦ x: (_* a_) z: (_* `>a)} <> {(a): (), >a: ^a}))

  (frame
    (cell @x (2))
