      {¦ x: (_* a_) z: (_* `>a)} <> {(a): (), >a: ^a}))

  end)

(rack
  (frame
    (cell (arena @x) (1 2 3 4))
    (cell @y ())
    (cell @z ())
    (feed (@x front) (@y back))
    (feed (@x back) (@z back)))

  (frame
    (cell (arena @x) (2 3))
    (cell @y (1))
    (cell @z (4))
    (feed (@x front) (@y back))
    (feed (@x back) (@z back)))

  (frame
    (cell (arena @x) ())
    (cell @y (1 2))
    (cell @z (4 3))
    (feed (@x front) (@y back))
    (feed (@x back) (@z back)))

  end)

(rack
  (frame
    (cell @x 100)
    (cell @y 200)
    (cell @z)
    (feed (@x @y) @z))

  (frame
    (cell @x)
    (cell @y)
    (cell @z (100 200))
    (feed (@x @y) @z))

  end)

(rack
  (frame
    (cell @x 100)
    (cell @y 200)
    (cell @z)
    (feed (@y @x) @z))

  (frame
    (cell @x)
    (cell @y)
    (cell @z (200 100))
    (feed (@y @x) @z))

  end)

