(rack
  (frame
    (cell @in 0)
    (transfer (@in n_ @out) ^n)
    (cell @out))

  (frame
    (cell @in)
    (transfer (@in n_ @out) ^n)
    (cell @out 0))

  end)

(rack
  (frame
    (cell @in 0)
    (transfer (@in n_ @out) (+ 1 2))
    (cell @out))

  (frame
    (cell @in)
    (transfer (@in n_ @out) (+ 1 2))
    (cell @out (+ 1 2)))

  end)

(rack
  (frame
    ;; Frame 0 (seed)
    (cell @in 0)
    (transfer (@in n_ @out) (double ^n))
    (cell @out))

  (frame/tail
    (cell @in)
    (transfer (@in n_ @out) (double ^n))
    (cell @out (double 0)))

  end)

(rack
  (frame
    (cell @in 4)
    (transfer (@in n_number @out) ^(* n n))
    (cell @out))

  (frame
    (cell @in)
    (transfer (@in n_number @out) ^(* n n))
    (cell @out 16))

  end)

(rack
  (frame
    (cell @in (person "Jane" 26))
    (transfer (@in (person name_string age_number) @out)
      ^(~ "Hi, " name ". You are " age " years old"))
    (cell @out))

  (frame
    (cell @in)
    (transfer (@in (person name_string age_number) @out)
      ^(~ "Hi, " name ". You are " age " years old"))
    (cell @out "Hi, Jane. You are 26 years old"))

  end)

(rack
  (frame
    (cell @in (person "Jane" 26))
    (transfer (@in (person name_string age_number) @out)
      ^"Hi, ⸢name⸣. You are ⸢age⸣ years old")
    (cell @out))

  (frame
    (cell @in)
    (transfer (@in (person name_string age_number) @out)
      ^"Hi, ⸢name⸣. You are ⸢age⸣ years old")
    (cell @out "Hi, Jane. You are 26 years old"))

  end)

(rack
  (frame
    (cell @in not-a-person)
    (transfer (@in (person name_string age_number) @out)
      ^"Hi, ⸢name⸣. You are ⸢age⸣ years old")
    (cell @out))

  end)

(rack
  (frame
    (cell @in 4)
    (transfer (@in x_number @out) ^(+ x 1))
    (transfer (@in x_string @out) ^"Hello, ⸢x⸣")
    (cell @out))

  (frame
    (cell @in)
    (transfer (@in x_number @out) ^(+ x 1))
    (transfer (@in x_string @out) ^"Hello, ⸢x⸣")
    (cell @out 5))

  end)

(rack
  (frame
    (cell @in "John")
    (transfer (@in x_number @out) ^(+ x 1))
    (transfer (@in x_string @out) ^"Hello, ⸢x⸣")
    (cell @out))

  (frame
    (cell @in)
    (transfer (@in x_number @out) ^(+ x 1))
    (transfer (@in x_string @out) ^"Hello, ⸢x⸣")
    (cell @out "Hello, John"))

  end)

(rack
  (frame
    (cell @in 4)
    (transfer (@in x_number @out-number) ^(+ x 1))
    (transfer (@in x_string @out-string) ^"Hello, ⸢x⸣")
    (cell @out-number)
    (cell @out-string))

  (frame
    (cell @in)
    (transfer (@in x_number @out-number) ^(+ x 1))
    (transfer (@in x_string @out-string) ^"Hello, ⸢x⸣")
    (cell @out-number 5)
    (cell @out-string))

  end)

(rack
  (frame
    (cell @in "John")
    (transfer (@in x_number @out-number) ^(+ x 1))
    (transfer (@in x_string @out-string) ^"Hello, ⸢x⸣")
