  end)

(rack
  (frame
    (cell @in 2)
    (transfer (@in x_number @out) ^(* x 2))
    (transfer (@in x_number @out) ^(* x x))
    (cell @out))

  (frame
    (cell @in)
    (transfer (@in x_number @out) ^(* x 2))
    (transfer (@in x_number @out) ^(* x x))
    (cell @out 4))

  end)

(rack
  (frame
    (cell @in 4)
    (transfer (@in x_number @out) ^(* x 2))
    (transfer (@in x_number @out) ^(* x x))
    (cell @out))

  end)

(rack
  (frame
    (cell @in 4)
    (transfer (@in x_number @out) ^(* x 2))
    (transfer (@in x_number @out) ^(* x x))
    (cell (seq @out)))

  (frame
    (cell @in)
    (transfer (@in x_number @out) ^(* x 2))
    (transfer (@in x_number @out) ^(* x x))
    (cell (seq @out) 8))

  end)

(rack
  (frame
    (cell @a 2)
    (cell @b 3)
    (transfer ((@a @b) (±a ±b) @sum) ^(+ a b))
    (cell @sum))

  (frame
    (cell @a)
    (cell @b)
    (transfer ((@a @b) (±a ±b) @sum) ^(+ a b))
    (cell @sum 5))

  end)

(rack
  (frame
    (cell @busy true)
    (cell @a 2)
    (cell @b 3)
    (transfer ((not @busy) (@a @b) (±a ±b) @sum) ^(+ a b))
    (cell @sum))

  end)

(rack
  (frame
    (cell @busy)
    (cell @a 2)
    (cell @b 3)
    (transfer ((not @busy) (@a @b) (±a ±b) @sum) ^(+ a b))
    (cell @sum))

  (frame
    (cell @busy)
    (cell @a)
    (cell @b)
    (transfer ((not @busy) (@a @b) (±a ±b) @sum) ^(+ a b))
    (cell @sum 5))

  end)

(rack
  (frame
    (cell @busy true)
    (discard @busy)
    (cell @a 2)
    (cell @b 3)
    (transfer ((not @busy) (@a @b) (±a ±b) @sum) ^(+ a b))
    (cell @sum))

  (frame
    (cell @busy)
    (discard @busy)
    (cell @a 2)
    (cell @b 3)
    (transfer ((not @busy) (@a @b) (±a ±b) @sum) ^(+ a b))
    (cell @sum))

  (frame
    (cell @busy)
    (discard @busy)
    (cell @a)
    (cell @b)
    (transfer ((not @busy) (@a @b) (±a ±b) @sum) ^(+ a b))
    (cell @sum 5))

  end)

(rack
  (frame
    (cell @record (person "Jane" 26))
    (transfer (@record (person name_string _number) @name) ^name)
    (transfer (@record (person _string ±age) @age) ^age)

    (cell @name)
    (cell @age)
    (cell @next-age)
    (transfer (@age ±age @next-age) ^(+ age 1))

    (transfer ((@name @next-age) (name_string ±age) @record)
      (person ^name ^age)))

  (frame
    (cell @record)
    (transfer (@record (person name_string _number) @name) ^name)
    (transfer (@record (person _string ±age) @age) ^age)

    (cell @name "Jane")
    (cell @age 26)
    (cell @next-age)
    (transfer (@age ±age @next-age) ^(+ age 1))

    (transfer ((@name @next-age) (name_string ±age) @record)
      (person ^name ^age)))

  (frame
    (cell @record)
    (transfer (@record (person name_string _number) @name) ^name)
    (transfer (@record (person _string ±age) @age) ^age)

    (cell @name "Jane")
    (cell @age)
    (cell @next-age 27)
    (transfer (@age ±age @next-age) ^(+ age 1))

    (transfer ((@name @next-age) (name_string ±age) @record)
      (person ^name ^age)))

  (frame
    (cell @record (person "Jane" 27))
    (transfer (@record (person name_string _number) @name) ^name)
    (transfer (@record (person _string ±age) @age) ^age)

    (cell @name)
    (cell @age)
    (cell @next-age)
    (transfer (@age ±age @next-age) ^(+ age 1))

    (transfer ((@name @next-age) (name_string ±age) @record)
