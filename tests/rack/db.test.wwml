;; CRUD
(rack
  (frame
    (cell @fs-request (delete file if exists "/tmp/wirewright-db0-people.db"))
    (cell @fs-response)
    (fs @fs-request @fs-response)

    (guard (@fs-response (ok _))
      (circuit @connection
        (cell @stmt)
        (cell @response)
        (db (@stmt -> "sqlite3:/tmp/wirewright-db0-people.db" -> @response)))

      (backsys
        ;; Move db actions into the db circuit.
        {¦ plan: (action←((%any exec query) _*) _*) connection: ((cell @stmt `dst) _ (db _ up))}
          <> {(action): (), dst: ^action}
        ;; Clog on expectation failure. Proceed on expectation success. This lets
        ;; us fail on the first failing action, so we can examine the state and
        ;; db response etc. while it's still there.
        {¦ plan: (action←(expect response_) _*), connection: (_ (cell @response response←response'_) _)}
          <> {(action): (), (response'): ()}))

    (cell @plan
      ((exec "create table people (id integer primary key, name string, age number)")
       (expect (ok 0))
       ;; Create
       (exec "insert into people (name, age) values (?, ?)" "John Doe" 25)
       (expect (ok 1)) ;; 1 row affected
       (exec "insert into people (name, age) values (?, ?), (?, ?)"
         "Samantha Doe" 35
         "Daniel Doe" 45)
       (expect (ok 2)) ;; 2 rows affected
       ;; Read
       (query "select * from people")
       (expect
         (ok
           {"id": 1, "name": "John Doe", "age": 25}
           {"id": 2, "name": "Samantha Doe", "age": 35}
           {"id": 3, "name": "Daniel Doe", "age": 45}))
       (query "select name, age from people where age > ?" 30)
       (expect
         (ok
           {"name": "Samantha Doe", "age": 35}
           {"name": "Daniel Doe", "age": 45}))
       ;; Update
       (exec "update people set name = ? where id = ?" "Barbara Doe" 2)
       (expect (ok 1)) ;; 1 row affected
       ;; ... check it:
       (query "select name, age from people where age > ?" 30)
       (expect
         (ok
           {"name": "Barbara Doe", "age": 35}
           {"name": "Daniel Doe", "age": 45}))
       ;; Delete
       (exec "delete from people where age < ?" 40)
       (expect (ok 2)) ;; 2 rows affected
       ;; ... check it:
       (query "select id, name from people")
       (expect
         (ok {"id": 3, "name": "Daniel Doe"})))))

  (frame/tail fast-forward: true
    (cell @plan ()))

  end)
