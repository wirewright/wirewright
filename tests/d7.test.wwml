      (module {}
        (cell @x)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))
      (module {}
        (cell @x 1)
        (feed @x (pulse @ys))
        (feed (pulse @ys) @x))))
  (frame
    (chat ((pulse @ys 1))
      (module {}
        (cell @x 0)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))
      (module {}
        (cell @x)
        (feed @x (pulse @ys))
        (feed (pulse @ys) @x))))
  (frame
    (chat ((pulse @xs 0))
      (module {}
        (cell @x)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))
      (module {}
        (cell @x 1)
        (feed @x (pulse @ys))
        (feed (pulse @ys) @x)))))
  ;; ...


