    ((appearance cell) (local @d) 300)
    (delay 3 (discard @b))
    ((sensor* cell) (local x_ @x)))
  (frame
    ((appearance cell) (local @a) 100)
    ((appearance cell) (local @b) 200)
    ((appearance cell) (local @c) 200)
    ((appearance cell) (local @d) 300)
    (delay 2 (discard @b))
    ((sensor* cell) (local x_ @x) (100 200 200 300)))
  (frame
    ((appearance cell) (local @a) 100)
    ((appearance cell) (local @b) 200)
    ((appearance cell) (local @c) 200)
    ((appearance cell) (local @d) 300)
    (delay 1 (discard @b))
    ((sensor* cell) (local x_ @x) (100 200 200 300)))
  (frame
    ((appearance cell) (local @a) 100)
    ((appearance cell) (local @b) 200)
    ((appearance cell) (local @c) 200)
    ((appearance cell) (local @d) 300)
    (discard @b)
    ((sensor* cell) (local x_ @x) (100 200 200 300)))
  (frame
    ((appearance cell) (local @a) 100)
    ((appearance cell) (local @b))
    ((appearance cell) (local @c) 200)
    ((appearance cell) (local @d) 300)
    (discard @b)
    ((sensor* cell) (local x_ @x) (100 200 200 300)))
  (frame
    ((appearance cell) (local @a) 100)
    ((appearance cell) (local @b))
    ((appearance cell) (local @c) 200)
    ((appearance cell) (local @d) 300)
    (discard @b)
    ((sensor* cell) (local x_ @x) (100 200 300)))
  end)

;; Removing all appearances with view sensor must clear its view.
(d7
  (frame
    ((sensor* cell) (local x_ @x))
    ((appearance cell) (local @a) 100)
