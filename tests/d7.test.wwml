;; `ml/document` device
(d7
  (frame
    (chat ((pulse @srcs "---\nx y z"))
      (ml/document @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)))
  (frame
    (chat ((pulse @!terms (ok {default: (), aux: (x y z)})))
      (ml/document @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)))
  (frame
    (chat ()
      (ml/document @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term (ok {default: (), aux: (x y z)}))))
  end)

;; Make sure the test framework itself supports `...` which is handy
;; when we're dealing with toplevel chats / many event-driven processors
;; [in sequence].
(d7
  (frame
    (cell @src "100")
    (feed @src (pulse @srcs))
    (ml/document @srcs (result @!docs))
    (repr (result @!docs) (ok @docs))
    (feed (pulse @docs) @doc)
    (cell @doc))
  (frame
    (cell @src) ;; < Away processing...
    (feed @src (pulse @srcs))
    (ml/document @srcs (result @!docs))
    (repr (result @!docs) (ok @docs))
    (feed (pulse @docs) @doc)
    (cell @doc))
  ...
  (frame
    (cell @src)
    (feed @src (pulse @srcs))
    (ml/document @srcs (result @!docs))
    (repr (result @!docs) (ok @docs))
    (feed (pulse @docs) @doc)
    (cell @doc (100)))
  end)

;; `repr ... result .. ok` device
(d7
  (frame
    (chat ((pulse @srcs (ok 100)))
      (repr (result @srcs) (ok @oks)))
    (chat ((pulse @srcs (err detail: "hello world")))
      (repr (result @srcs) (ok @oks))))
  (frame
    (chat ((pulse @oks 100))
      (repr (result @srcs) (ok @oks)))
    (chat ((err detail: "hello world"))
      (repr (result @srcs) (ok @oks))))
  (frame
    (chat ((pulse @oks 100))
      (repr (result @srcs) (ok @oks)))
    (chat ()
      ;;  ^ err isn't pulse so it doesn't require an ack from a consumer,
      ;;    it is quickly destroyed. You must catch it in a single tick.
      (repr (result @srcs) (ok @oks))))
  end)

;; Listing ML error details using the `ml/term` device and the `log` node.
;;
;; NOTE: this is a *very* long regression test.
(d7
  (seed
    (circuit @chat
      (chat ()
        (queue (@front @back) ("100" "200" "100" "100" "100" "(" ")" "(+ 1 2" "qux"))
        (feed @front (over @src))
        (cell @src)
        (uniq @src (pulse @srcs))
        (ml/term @srcs (result @!terms))
        (repr (result @!terms) (ok @terms))
        (feed (pulse @terms) @term)
        (cell @term)
        (discard @term)))
    (log (@chat [_ ((err ⍊ detail_string) _*) _*] @details)
      ^detail)
    (cell @details ())
    (view (@details details_dict @view)
      (group
        (h1 "Most recent problems:")
        (^each (details as detail_string)
          (p ^detail style: "text-red-500"))))
    (cell @view))
  (fast-forward-to
    (%all
      (%leaf (cell @term 100))
      ⟨(cell @view
         (group
           (h1 "Most recent problems:")))⟩))
  (fast-forward-to
    (%all
      (%leaf (cell @term 200))
      ⟨(cell @view
         (group
           (h1 "Most recent problems:")))⟩))
  (fast-forward-to
    (%all
      (%leaf (cell @term 100))
      ⟨(cell @view
         (group
           (h1 "Most recent problems:")))⟩))
  (fast-forward-to
    ⟨(cell @view
       (group
         (h1 "Most recent problems:")
         (p "expected `)` to end the dict" style: "text-red-500")))⟩)
  (fast-forward-to
    ⟨(cell @view
       (group
         (h1 "Most recent problems:")
         (p "expected `)` to end the dict" style: "text-red-500")
         (p "expected a term" style: "text-red-500")))⟩)
  (fast-forward-to
    ⟨(cell @view
       (group
         (h1 "Most recent problems:")
         (p "expected `)` to end the dict" style: "text-red-500")
         (p "expected a term" style: "text-red-500")
         (p "expected `)` to end the dict" style: "text-red-500")))⟩)
  (fast-forward-to
    (%all
      (%leaf (cell @term qux))
      ⟨(cell @view
         (group
           (h1 "Most recent problems:")
           (p "expected `)` to end the dict" style: "text-red-500")
           (p "expected a term" style: "text-red-500")
           (p "expected `)` to end the dict" style: "text-red-500")))⟩))
  (fast-forward-to
    (%leaf (cell @term)))
  end)

