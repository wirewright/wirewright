;; `m1/backmap` device
(d7
  (frame
    (cell @submission
      {pattern: (+ x_ y_),
       backspec: {x: (seen →x), y: (seen →y)},
       matchee: (+ 1 2)})
    (feed @submission (pulse @submissions))
    (m1/backmap @submissions (optional @?terms))
    (feed (pulse @?terms) @?term)
    (cell @?term))
  (frame
    (cell @submission)
    (feed @submission (pulse @submissions))
    (m1/backmap @submissions (optional @?terms))
    (feed (pulse @?terms) @?term)
    (cell @?term))
  ...
  (frame
    (cell @submission)
    (feed @submission (pulse @submissions))
    (m1/backmap @submissions (optional @?terms))
    (feed (pulse @?terms) @?term)
    (cell @?term (some (+ (seen 1) (seen 2)))))
  end)
