;; Feed: 1:1
(d7
  ((cell @x 0)
   (feed @x @y)
   (cell @y))
  ((cell @x)
   (feed @x @y)
   (cell @y 0))
  end)

;; Copy: 1:1
(d7
  ((cell @x 0)
   (feed (copy @x) @y)
   (cell @y))
  ((cell @x 0)
   (feed (copy @x) @y)
   (cell @y 0))
  end)

;; Feed: 1:1, dst full
(d7
  ((cell @x 0)
   (feed @x @y)
   (cell @y 100))
  end)

;; Copy: 1:1, dst full [copy]
(d7
  ((cell @x 0)
   (feed (copy @x) @y)
   (cell @y 100))
  end)

;; [copy-over]
(d7
  ((cell @x 0)
   (feed (copy @x) (over @y))
   (cell @y 100))
  ((cell @x 0)
   (feed (copy @x) (over @y))
   (cell @y 0))
  end)

;; Feed: 1:M, all empty
(d7
  ((cell @x 0)
   (feed @x @y)
   (cell @y)
   (cell @y)
   (cell @y)
   (cell @y))
  ((cell @x)
   (feed @x @y)
   (cell @y 0)
   (cell @y 0)
   (cell @y 0)
   (cell @y 0))
  end)

;; Copy: 1:M, all empty
(d7
  ((cell @x 0)
   (feed (copy @x) @y)
   (cell @y)
   (cell @y)
   (cell @y)
   (cell @y))
  ((cell @x 0)
   (feed (copy @x) @y)
   (cell @y 0)
   (cell @y 0)
   (cell @y 0)
   (cell @y 0))
  end)

;; Feed: 1:M, some full
(d7
  ((cell @x 0)
   (feed @x @y)
   (cell @y)
   (cell @y 100)
   (cell @y)
   (cell @y 100))
  ((cell @x)
   (feed @x @y)
   (cell @y 0)
   (cell @y 100)
   (cell @y 0)
   (cell @y 100))
  end)

;; Copy: 1:M, some full [copy]
(d7
  ((cell @x 0)
   (feed (copy @x) @y)
   (cell @y)
   (cell @y 100)
   (cell @y)
   (cell @y 100))
  ((cell @x 0)
   (feed (copy @x) @y)
   (cell @y 0)
   (cell @y 100)
   (cell @y 0)
   (cell @y 100))
  end)

;; Copy: 1:M, some full [copy-over]
(d7
  ((cell @x 0)
   (feed (copy @x) (over @y))
   (cell @y)
   (cell @y 100)
   (cell @y)
   (cell @y 100))
  ((cell @x 0)
   (feed (copy @x) (over @y))
   (cell @y 0)
   (cell @y 0)
   (cell @y 0)
   (cell @y 0))
  end)

;; Feed: 1:M, all full
(d7
  ((cell @x 0)
   (feed @x @y)
   (cell @y 100)
   (cell @y 100)
   (cell @y 100)
   (cell @y 100))
  end)

;; Feed: M:1, dst empty
(d7
  ((cell @x 0)
   (cell @x 1)
   (cell @x 2)
   (feed @x @y)
   (cell @y))
  ((cell @x)
   (cell @x)
   (cell @x)
   (feed @x @y)
   (cell @y {# 0 1 2}))
  end)

;; Feed: M:1, some srcs empty, dst empty
(d7
  ((cell @x 0)
   (cell @x)
   (cell @x 2)
   (feed @x @y)
   (cell @y))
  ((cell @x)
   (cell @x)
   (cell @x)
   (feed @x @y)
   (cell @y {# 0 2}))
  end)

;; Feed: M:1, dst full
(d7
  ((cell @x 0)
   (cell @x 1)
   (cell @x 2)
   (feed @x @y)
   (cell @y 100))
  end)

