;; Fragment: like circuit but write-only and embeds, doesn't isolate.
(d7
  (frame
    (cell @x (delay 3 (feed @a @b)))
    (feed @x @y)
    (frag @y)
    (cell @a 100)
    (cell @b))
  (frame
    (cell @x)
    (feed @x @y)
    (frag @y (delay 3 (feed @a @b)))
    (cell @a 100)
    (cell @b))
  (frame
    (cell @x)
    (feed @x @y)
    (frag @y (delay 2 (feed @a @b)))
    (cell @a 100)
    (cell @b))
  (frame
    (cell @x)
    (feed @x @y)
    (frag @y (delay 1 (feed @a @b)))
    (cell @a 100)
    (cell @b))
  (frame
    (cell @x)
    (feed @x @y)
    (frag @y (feed @a @b))
    (cell @a 100)
    (cell @b))
  (frame
    (cell @x)
    (feed @x @y)
    (frag @y (feed @a @b))
    (cell @a)
    (cell @b 100))
  end)

;; BUG: circuit must create a scope like a module, must not conflict
;; with outer cells on fold() passes etc.
(d7
  (frame
    (circuit @x
      (cell @foo))
    (sensor (local x_ @foo) ^x)
    ((fused appearance) (local @bar) 100))
  end)
