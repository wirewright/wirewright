;; Feed: multiple writers.
(d7
  (frame
    (cell @x a)
    (delay 3 (cell @z c))
    (delay 1 (cell @y b))
    (feed @x @sink)
    (feed @y @sink)
    (feed @z @sink)
    (cell @sink)
    (delay 2 (discard @sink)))
  (frame
    (cell @x)
    (delay 2 (cell @z c))
    (cell @y b)
    (feed @x @sink)
    (feed @y @sink)
    (feed @z @sink)
    (cell @sink a)
    (delay 1 (discard @sink)))
  (frame
    (cell @x)
    (delay 1 (cell @z c))
    (cell @y b)
    (feed @x @sink)
    (feed @y @sink)
    (feed @z @sink)
    (cell @sink a)
    (discard @sink))
  (frame
    (cell @x)
    (cell @z c)
    (cell @y b)
    (feed @x @sink)
    (feed @y @sink)
    (feed @z @sink)
    (cell @sink)
    (discard @sink))
  (frame
    (cell @x)
    (cell @z c)
    (cell @y)
    (feed @x @sink)
    (feed @y @sink)
    (feed @z @sink)
    (cell @sink b)
    (discard @sink))
  (frame
    (cell @x)
    (cell @z c)
    (cell @y)
    (feed @x @sink)
    (feed @y @sink)
    (feed @z @sink)
    (cell @sink)
    (discard @sink))
  (frame
    (cell @x)
    (cell @z)
    (cell @y)
    (feed @x @sink)
    (feed @y @sink)
    (feed @z @sink)
    (cell @sink c)
    (discard @sink)))

;; Single tick parallelism.
(d7
  (frame
    (module {}
      (cell @x 0)
      (feed @x @y)
      (cell @y))
   (module {}
      (cell @x 0)
      (feed @x @y)
      (cell @y)))
  (frame
    (module {}
      (cell @x)
      (feed @x @y)
      (cell @y 0))
    (module {}
      (cell @x)
      (feed @x @y)
      (cell @y 0)))
  end)

;; Waterfall.
(d7
  (frame
    (cell @0 0)
    (cell @1)
    (cell @2)
    (cell @3)
    (feed @0 @1 @2 @3))
  (frame
    (cell @0)
    (cell @1 0)
    (cell @2)
    (cell @3)
    (feed @0 @1 @2 @3))
  (frame
    (cell @0)
    (cell @1)
    (cell @2 0)
    (cell @3)
    (feed @0 @1 @2 @3))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (cell @3 0)
    (feed @0 @1 @2 @3))
  end)

;; Waterfall with multiple items. Note how we don't pick conflicting rewrites
;; in the same step. This is why you see the "hole" between items: that cell
;; is "expended" for that tick.
(d7
  (frame
    (cell @0 0)
    (cell @1 1)
    (cell @2 2)
    (cell @3)
    (cell @4)
    (cell @5)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0 0)
    (cell @1 1)
    (cell @2)
    (cell @3 2)
    (cell @4)
    (cell @5)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0 0)
    (cell @1)
    (cell @2 1)
    (cell @3)
    (cell @4 2)
    (cell @5)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1 0)
    (cell @2)
    (cell @3 1)
    (cell @4)
    (cell @5 2)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1)
    (cell @2 0)
    (cell @3)
    (cell @4 1)
    (cell @5)
    (cell @6 2)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (cell @3 0)
    (cell @4)
    (cell @5 1)
    (cell @6 2)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (cell @3)
    (cell @4 0)
    (cell @5 1)
    (cell @6 2)
    (feed @0 @1 @2 @3 @4 @5 @6))
  end)

;; Oscillation
(d7
  (frame
    (cell @0 100)
    (feed @0 @1 @0)
    (cell @1))
  (frame
    (cell @0)
    (feed @0 @1 @0)
    (cell @1 100))
  (frame
    (cell @0 100)
    (feed @0 @1 @0)
    (cell @1))
  (frame
    (cell @0)
    (feed @0 @1 @0)
    (cell @1 100)))
  ;; ...

;; 1:M -> discard
(d7
  (frame
    (cell @0 100)
    (feed (copy @0) @v)
    (feed @0 @1)
    (cell @v)
    (feed @v @0)
    (cell @1)
    (cell @1)
    (cell @1)
    (discard @1))
  (frame
    (cell @0)
    (feed (copy @0) @v)
    (feed @0 @1)
    (cell @v 100)
    (feed @v @0)
    (cell @1 100)
    (cell @1 100)
    (cell @1 100)
    (discard @1))
  (frame
    (cell @0 100)
    (feed (copy @0) @v)
    (feed @0 @1)
    (cell @v)
    (feed @v @0)
    (cell @1)
    (cell @1)
    (cell @1)
    (discard @1)))
  ;; ...

;; Essential queue.
(d7
  (frame
    (cell @0 300)
    (cell @1 200)
    (cell @2 100)
    (feed @0 @1 @2 @back)
    (queue (@front @back) ())
    (feed @front @preview)
    (cell @preview)
    (discard @preview))
  (frame
    (cell @0 300)
    (cell @1 200)
    (cell @2)
    (feed @0 @1 @2 @back)
    (queue (@front @back) (100))
    (feed @front @preview)
    (cell @preview)
    (discard @preview))
  (frame
    (cell @0 300)
    (cell @1)
    (cell @2 200)
    (feed @0 @1 @2 @back)
    (queue (@front @back) ())
    (feed @front @preview)
    (cell @preview 100)
    (discard @preview))
  (frame
    (cell @0)
    (cell @1 300)
    (cell @2)
    (feed @0 @1 @2 @back)
    (queue (@front @back) (200))
    (feed @front @preview)
    (cell @preview)
    (discard @preview))
  (frame
    (cell @0)
    (cell @1)
    (cell @2 300)
    (feed @0 @1 @2 @back)
    (queue (@front @back) ())
    (feed @front @preview)
    (cell @preview 200)
    (discard @preview))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (feed @0 @1 @2 @back)
    (queue (@front @back) (300))
    (feed @front @preview)
    (cell @preview)
    (discard @preview))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (feed @0 @1 @2 @back)
    (queue (@front @back) ())
    (feed @front @preview)
    (cell @preview 300)
    (discard @preview))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (feed @0 @1 @2 @back)
    (queue (@front @back) ())
    (feed @front @preview)
    (cell @preview)
    (discard @preview))
  end)

;; Queue should not enqueue if destination is occupied -- this is the basic
;; principle behind emergent backpressure (something similar can be said about
;; feed + cell).
(d7
  (frame
    (cell @0 x)
    (cell @1 y)
    (feed @0 @1 @back)
    (queue (@front @back) ())
    (feed @front @occupied)
    (cell @occupied "Busy!"))
  (frame
    (cell @0 x)
    (cell @1)
    (feed @0 @1 @back)
    (queue (@front @back) (y))
    (feed @front @occupied)
    (cell @occupied "Busy!"))
  (frame
    (cell @0)
    (cell @1 x)
    (feed @0 @1 @back)
    (queue (@front @back) (y))
    (feed @front @occupied)
    (cell @occupied "Busy!"))
  (frame
    (cell @0)
    (cell @1)
    (feed @0 @1 @back)
    (queue (@front @back) (y x))
    (feed @front @occupied)
    (cell @occupied "Busy!"))
  end)

;; Queue circulate one value.
(d7
  (frame
    (queue (@front @back) (100))
    (feed @front @mid)
    (cell @mid)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back))
  (frame
    (queue (@front @back) ())
    (feed @front @mid)
    (cell @mid 100)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back))
  (frame
    (queue (@front @back) ())
    (feed @front @mid)
    (cell @mid)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid' 200)
    (feed @mid' @back))
  (frame
    (queue (@front @back) (200))
    (feed @front @mid)
    (cell @mid)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back))
  (frame
    (queue (@front @back) ())
    (feed @front @mid)
    (cell @mid 200)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back))
  (frame
    (queue (@front @back) ())
    (feed @front @mid)
    (cell @mid)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid' 400)
    (feed @mid' @back))
  (frame
    (queue (@front @back) (400))
    (feed @front @mid)
    (cell @mid)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back)))
  ;; ...

;; Queue circulate many values.
(d7
  (frame
    (queue (@front @back) (100 200 300))
    (feed @front @mid)
    (cell @mid)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back))
  (frame
    (queue (@front @back) (200 300))
    (feed @front @mid)
    (cell @mid 100)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back))
  (frame
    (queue (@front @back) (200 300))
    (feed @front @mid)
    (cell @mid)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid' 200)
    (feed @mid' @back))
  (frame
    (queue (@front @back) (300 200))
    (feed @front @mid)
    (cell @mid 200)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back))
  (frame
    (queue (@front @back) (300 200))
    (feed @front @mid)
    (cell @mid)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid' 400)
    (feed @mid' @back))
  (frame
    (queue (@front @back) (200 400))
    (feed @front @mid)
    (cell @mid 300)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back))
  (frame
    (queue (@front @back) (200 400))
    (feed @front @mid)
    (cell @mid)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid' 600)
    (feed @mid' @back))
  (frame
    (queue (@front @back) (400 600))
    (feed @front @mid)
    (cell @mid 200)
    (transfer (@mid ±n @mid') ^(* n 2))
    (cell @mid')
    (feed @mid' @back)))
  ;; ...

;; Queue feedback
(d7
  (frame (queue (@a @a) (100 200 300)))
  end)

;; queue max: N
(d7
  (frame
    (queue (@front0 @back0) (100 200 300 400 500 600))
    (feed @front0 @back)
    (queue (@front @back max: 3) ()))
  (frame
    (queue (@front0 @back0) (200 300 400 500 600))
    (feed @front0 @back)
    (queue (@front @back max: 3) (100)))
  (frame
    (queue (@front0 @back0) (300 400 500 600))
    (feed @front0 @back)
    (queue (@front @back max: 3) (100 200)))
  (frame
    (queue (@front0 @back0) (400 500 600))
    (feed @front0 @back)
    (queue (@front @back max: 3) (100 200 300)))
  end)

;; queue min: N
(d7
  (frame
    (queue (@front0 @back0) (1 2 3 4 5))
    (feed @front0 @back1)
    (queue (@front1 @back1 min: 2) ())
    (discard @front1))
  (frame
    (queue (@front0 @back0) (2 3 4 5))
    (feed @front0 @back1)
    (queue (@front1 @back1 min: 2) (1))
    (discard @front1))
  (frame
    (queue (@front0 @back0) (3 4 5))
    (feed @front0 @back1)
    (queue (@front1 @back1 min: 2) (1 2))
    (discard @front1))
  (frame
    (queue (@front0 @back0) (4 5))
    (feed @front0 @back1)
    (queue (@front1 @back1 min: 2) (2 3))
    (discard @front1))
  (frame
    (queue (@front0 @back0) (5))
    (feed @front0 @back1)
    (queue (@front1 @back1 min: 2) (3 4))
    (discard @front1))
  (frame
    (queue (@front0 @back0) ())
    (feed @front0 @back1)
    (queue (@front1 @back1 min: 2) (4 5))
    (discard @front1))
  (frame
    (queue (@front0 @back0) ())
    (feed @front0 @back1)
    (queue (@front1 @back1 min: 2) (5))
    (discard @front1))
  end)

;; queue min: N max: M
(d7
  (frame
    (queue (@front0 @back0) (1 2 3 4 5 6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) ())
    (queue (@front2 @back2 max: 2) ())
    (feed @front0 @back1)
    (feed @front1 @back2)
    (delay 8 (discard @front2)))
  (frame
    (queue (@front0 @back0) (2 3 4 5 6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (1))
    (queue (@front2 @back2 max: 2) ())
    (feed @front0 @back1)
    (feed @front1 @back2)
    (delay 7 (discard @front2)))
  (frame
    (queue (@front0 @back0) (3 4 5 6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (1 2))
    (queue (@front2 @back2 max: 2) ())
    (feed @front0 @back1)
    (feed @front1 @back2)
    (delay 6 (discard @front2)))
  (frame
    (queue (@front0 @back0) (4 5 6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (2 3))
    (queue (@front2 @back2 max: 2) (1))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (delay 5 (discard @front2)))
  (frame
    (queue (@front0 @back0) (5 6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (3 4))
    (queue (@front2 @back2 max: 2) (1 2))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (delay 4 (discard @front2)))
  (frame
    (queue (@front0 @back0) (6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (3 4 5))
    (queue (@front2 @back2 max: 2) (1 2))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (delay 3 (discard @front2)))
  (frame
    (queue (@front0 @back0) (6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (3 4 5))
    (queue (@front2 @back2 max: 2) (1 2))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (delay 2 (discard @front2)))
  (frame
    (queue (@front0 @back0) (6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (3 4 5))
    (queue (@front2 @back2 max: 2) (1 2))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (delay 1 (discard @front2)))
  (frame
    (queue (@front0 @back0) (6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (3 4 5))
    (queue (@front2 @back2 max: 2) (1 2))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (discard @front2))
  (frame
    (queue (@front0 @back0) (6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (3 4 5))
    (queue (@front2 @back2 max: 2) (2))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (discard @front2))
  (frame
    (queue (@front0 @back0) (6 7 8))
    (queue (@front1 @back1 min: 2 max: 3) (4 5))
    (queue (@front2 @back2 max: 2) (3))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (discard @front2))
  (frame
    (queue (@front0 @back0) (7 8))
    (queue (@front1 @back1 min: 2 max: 3) (5 6))
    (queue (@front2 @back2 max: 2) (4))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (discard @front2))
  (frame
    (queue (@front0 @back0) (8))
    (queue (@front1 @back1 min: 2 max: 3) (6 7))
    (queue (@front2 @back2 max: 2) (5))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (discard @front2))
  (frame
    (queue (@front0 @back0) ())
    (queue (@front1 @back1 min: 2 max: 3) (7 8))
    (queue (@front2 @back2 max: 2) (6))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (discard @front2))
  (frame
    (queue (@front0 @back0) ())
    (queue (@front1 @back1 min: 2 max: 3) (8))
    (queue (@front2 @back2 max: 2) (7))
    (feed @front0 @back1)
    (feed @front1 @back2)
    (discard @front2))
  (frame
    (queue (@front0 @back0) ())
    (queue (@front1 @back1 min: 2 max: 3) (8)) ;; < This one stalls because it has < 2 values
    (queue (@front2 @back2 max: 2) ())
    (feed @front0 @back1)
    (feed @front1 @back2)
    (discard @front2))
  end)

;; queue max: 0
(d7
  (frame
    (queue (@front0 @back0) (100 200 300 400 500 600))
    (feed @front0 @back)
    (queue (@front @back max: 0) ()))
  end)

;; queue max: 3.14
(d7
  (frame
    (queue (@front0 @back0) (100 200 300 400 500 600))
    (feed @front0 @back)
    (queue (@front @back max: 3.14) ()))
  end)

;; An observer can make decisions based on its children and feed them back.
(d7
  (frame
    (frag @x
      (group
        (cell @src 100)
        (view (@src ±n @voice0) ^(+ n 2))
        (view (@src ±n @voice1) ^(* n 2))
        (cell @voice0)
        (cell @voice1)))
    (fb (@x (%all ⟨(cell @src n_)⟩ ⟨(cell @voice0 a_)⟩ ⟨(cell @voice1 b_)⟩))
      {sum: ^(+ a b)}
      {n: →sum}))
  (frame
    (frag @x
      (group
        (cell @src 302)
        (view (@src ±n @voice0) ^(+ n 2))
        (view (@src ±n @voice1) ^(* n 2))
        (cell @voice0 102)
        (cell @voice1 200)))
    (fb (@x (%all ⟨(cell @src n_)⟩ ⟨(cell @voice0 a_)⟩ ⟨(cell @voice1 b_)⟩))
      {sum: ^(+ a b)}
      {n: →sum}))
  (frame
    (frag @x
      (group
        (cell @src 908)
        (view (@src ±n @voice0) ^(+ n 2))
        (view (@src ±n @voice1) ^(* n 2))
        (cell @voice0 304)
        (cell @voice1 604)))
    (fb (@x (%all ⟨(cell @src n_)⟩ ⟨(cell @voice0 a_)⟩ ⟨(cell @voice1 b_)⟩))
      {sum: ^(+ a b)}
      {n: →sum})))
  ;; ...

;; Nested (observed) delays are decremented once per tick.
(d7
  (frame
    (delay 3 "Foo")
    (frag @x
      (group
        (delay 2 "Bar")
        (delay 5 "Baz")
        (frag @y
          (delay 3 "boo")))))
  (frame
    (delay 2 "Foo")
    (frag @x
      (group
        (delay 1 "Bar")
        (delay 4 "Baz")
        (frag @y
          (delay 2 "boo")))))
  (frame
    (delay 1 "Foo")
    (frag @x
      (group
        "Bar"
        (delay 3 "Baz")
        (frag @y
          (delay 1 "boo")))))
  (frame
    "Foo"
    (frag @x
      (group
        "Bar"
        (delay 2 "Baz")
        (frag @y
          "boo"))))
  (frame
    "Foo"
    (frag @x
      (group
        "Bar"
        (delay 1 "Baz")
        (frag @y
          "boo"))))
  (frame
    "Foo"
    (frag @x
      (group
        "Bar"
        "Baz"
        (frag @y
          "boo")))))

;; Ditto
(d7
  (frame
    (delay 3 "Foo")
    (cell @x-view)
    (feed (copy @x) (over @x-view))
    (frag @x
      (group
        (delay 3 "Bar")
        (cell @y-view)
        (feed (copy @y) (over @y-view))
        (frag @y
          (delay 3 "Baz")))))
  (frame
    (delay 2 "Foo")
    (cell @x-view
      (group
        (delay 2 "Bar")
        (cell @y-view (delay 2 "Baz"))
        (feed (copy @y) (over @y-view))
        (frag @y
          (delay 2 "Baz"))))
    (feed (copy @x) (over @x-view))
    (frag @x
      (group
        (delay 2 "Bar")
        (cell @y-view (delay 2 "Baz"))
        (feed (copy @y) (over @y-view))
        (frag @y
          (delay 2 "Baz")))))
  (frame
    (delay 1 "Foo")
    (cell @x-view
      (group
        (delay 1 "Bar")
        (cell @y-view (delay 1 "Baz"))
        (feed (copy @y) (over @y-view))
        (frag @y
          (delay 1 "Baz"))))
    (feed (copy @x) (over @x-view))
    (frag @x
      (group
        (delay 1 "Bar")
        (cell @y-view (delay 1 "Baz"))
        (feed (copy @y) (over @y-view))
        (frag @y
          (delay 1 "Baz")))))
  (frame
    "Foo"
    (cell @x-view
      (group
        "Bar"
        (cell @y-view "Baz")
        (feed (copy @y) (over @y-view))
        (frag @y
          "Baz")))
    (feed (copy @x) (over @x-view))
    (frag @x
      (group
        "Bar"
        (cell @y-view "Baz")
        (feed (copy @y) (over @y-view))
        (frag @y "Baz"))))
  end)

