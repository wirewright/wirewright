        (cell @y)
        (feed @x (pulse @xs))
        (feed @y (pulse @ys))
        (feed (pulse @xs) @x)
        (feed (pulse @ys) @y))
      (cell @z)
      (feed (pulse @xs) @z)))
  (frame
    (chat ()
