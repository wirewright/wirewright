;; Sensor-appearance chan queues sensor
(d7
  (frame
    (module {}
      (queue (@front @back) (1 2 3 4 5))
      (appearance local @front))
    (module {}
      (delay 3 (discard @front))
      (queue (@front @back) ())
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) (2 3 4 5))
      (appearance local @front))
    (module {}
      (delay 2 (discard @front))
      (queue (@front @back) (1))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) (3 4 5))
      (appearance local @front))
    (module {}
      (delay 1 (discard @front))
      (queue (@front @back) (1 2))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) (4 5))
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) (1 2 3))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) (5))
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) (2 3 4))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) ())
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) (3 4 5))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) ())
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) (4 5))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) ())
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) (5))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) ())
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) ())
      (sensor (local ±n @back) ^n)))
  end)

;; Sensor-appearance chan queues sensor limit
