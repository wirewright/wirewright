;; Single tick parallelism.
(d7
  ((module {}
     (cell @x 0)
     (feed @x @y)
     (cell @y))
   (module {}
     (cell @x 0)
     (feed @x @y)
     (cell @y)))
  ((module {}
     (cell @x)
     (feed @x @y)
     (cell @y 0))
   (module {}
     (cell @x)
     (feed @x @y)
     (cell @y 0)))
  end)

;; Waterfall.
(d7
  ((cell @0 0)
   (cell @1)
   (cell @2)
   (cell @3)
   (feed @0 @1 @2 @3))
  ((cell @0)
   (cell @1 0)
   (cell @2)
   (cell @3)
   (feed @0 @1 @2 @3))
  ((cell @0)
   (cell @1)
   (cell @2 0)
   (cell @3)
   (feed @0 @1 @2 @3))
  ((cell @0)
   (cell @1)
   (cell @2)
   (cell @3 0)
   (feed @0 @1 @2 @3))
  end)

;; Waterfall with multiple items. Note how we don't pick conflicting rewrites
;; in the same step. This is why you see the "hole" between items: that cell
;; is "expended" for that tick.
(d7
  ((cell @0 0)
   (cell @1 1)
   (cell @2 2)
   (cell @3)
   (cell @4)
   (cell @5)
   (cell @6)
   (feed @0 @1 @2 @3 @4 @5 @6))
  ((cell @0 0)
   (cell @1 1)
   (cell @2)
   (cell @3 2)
   (cell @4)
   (cell @5)
   (cell @6)
   (feed @0 @1 @2 @3 @4 @5 @6))
  ((cell @0 0)
   (cell @1)
   (cell @2 1)
   (cell @3)
   (cell @4 2)
   (cell @5)
   (cell @6)
   (feed @0 @1 @2 @3 @4 @5 @6))
  ((cell @0)
   (cell @1 0)
   (cell @2)
   (cell @3 1)
   (cell @4)
   (cell @5 2)
   (cell @6)
   (feed @0 @1 @2 @3 @4 @5 @6))
  ((cell @0)
   (cell @1)
   (cell @2 0)
   (cell @3)
   (cell @4 1)
   (cell @5)
   (cell @6 2)
   (feed @0 @1 @2 @3 @4 @5 @6))
  ((cell @0)
   (cell @1)
   (cell @2)
   (cell @3 0)
   (cell @4)
   (cell @5 1)
   (cell @6 2)
   (feed @0 @1 @2 @3 @4 @5 @6))
  ((cell @0)
   (cell @1)
   (cell @2)
   (cell @3)
   (cell @4 0)
   (cell @5 1)
   (cell @6 2)
   (feed @0 @1 @2 @3 @4 @5 @6))
  end)

;; Oscillation
(d7
  ((cell @0 100)
   (feed @0 @1 @0)
   (cell @1))
  ((cell @0)
   (feed @0 @1 @0)
   (cell @1 100))
  ((cell @0 100)
   (feed @0 @1 @0)
   (cell @1))
  ((cell @0)
   (feed @0 @1 @0)
   (cell @1 100)))
  ;; ...

;; 1:M -> discard
(d7
  ((cell @0 100)
   (feed (copy @0) @v)
   (feed @0 @1)
   (cell @v)
   (feed @v @0)
   (cell @1)
   (cell @1)
   (cell @1)
   (discard @1))
  ((cell @0)
   (feed (copy @0) @v)
   (feed @0 @1)
   (cell @v 100)
   (feed @v @0)
   (cell @1 100)
   (cell @1 100)
   (cell @1 100)
   (discard @1))
  ((cell @0 100)
   (feed (copy @0) @v)
   (feed @0 @1)
   (cell @v)
   (feed @v @0)
   (cell @1)
   (cell @1)
   (cell @1)
   (discard @1)))
  ;; ...

;; Essential queue.
(d7
  ((cell @0 300)
   (cell @1 200)
   (cell @2 100)
   (feed @0 @1 @2 @back)
   (queue (@front @back) ())
   (feed @front @preview)
   (cell @preview)
   (discard @preview))
  ((cell @0 300)
   (cell @1 200)
   (cell @2)
   (feed @0 @1 @2 @back)
   (queue (@front @back) (100))
   (feed @front @preview)
   (cell @preview)
   (discard @preview))
  ((cell @0 300)
   (cell @1)
   (cell @2 200)
   (feed @0 @1 @2 @back)
   (queue (@front @back) ())
   (feed @front @preview)
   (cell @preview 100)
   (discard @preview))
  ((cell @0)
   (cell @1 300)
   (cell @2)
   (feed @0 @1 @2 @back)
   (queue (@front @back) (200))
   (feed @front @preview)
   (cell @preview)
   (discard @preview))
  ((cell @0)
   (cell @1)
   (cell @2 300)
   (feed @0 @1 @2 @back)
   (queue (@front @back) ())
   (feed @front @preview)
   (cell @preview 200)
   (discard @preview))
  ((cell @0)
   (cell @1)
   (cell @2)
   (feed @0 @1 @2 @back)
   (queue (@front @back) (300))
   (feed @front @preview)
   (cell @preview)
   (discard @preview))
  ((cell @0)
   (cell @1)
   (cell @2)
   (feed @0 @1 @2 @back)
   (queue (@front @back) ())
   (feed @front @preview)
   (cell @preview 300)
   (discard @preview))
  ((cell @0)
   (cell @1)
   (cell @2)
   (feed @0 @1 @2 @back)
   (queue (@front @back) ())
   (feed @front @preview)
   (cell @preview)
   (discard @preview))
  end)

;; Queue should not enqueue if destination is occupied -- this is the basic
;; principle behind emergent backpressure (something similar can be said about
;; feed + cell).
(d7
  ((cell @0 x)
   (cell @1 y)
   (feed @0 @1 @back)
   (queue (@front @back) ())
   (feed @front @occupied)
   (cell @occupied "Busy!"))
  ((cell @0 x)
   (cell @1)
   (feed @0 @1 @back)
   (queue (@front @back) (y))
   (feed @front @occupied)
   (cell @occupied "Busy!"))
  ((cell @0)
   (cell @1 x)
   (feed @0 @1 @back)
   (queue (@front @back) (y))
   (feed @front @occupied)
   (cell @occupied "Busy!"))
  ((cell @0)
   (cell @1)
   (feed @0 @1 @back)
   (queue (@front @back) (y x))
   (feed @front @occupied)
   (cell @occupied "Busy!"))
  end)

;; Queue circulate one value.
(d7
  ((queue (@front @back) (100))
   (feed @front @mid)
   (cell @mid)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back))
  ((queue (@front @back) ())
   (feed @front @mid)
   (cell @mid 100)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back))
  ((queue (@front @back) ())
   (feed @front @mid)
   (cell @mid)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid' 200)
   (feed @mid' @back))
  ((queue (@front @back) (200))
   (feed @front @mid)
   (cell @mid)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back))
  ((queue (@front @back) ())
   (feed @front @mid)
   (cell @mid 200)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back))
  ((queue (@front @back) ())
   (feed @front @mid)
   (cell @mid)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid' 400)
   (feed @mid' @back))
  ((queue (@front @back) (400))
   (feed @front @mid)
   (cell @mid)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back)))
  ;; ...

;; Queue circulate many values.
(d7
  ((queue (@front @back) (100 200 300))
   (feed @front @mid)
   (cell @mid)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back))
  ((queue (@front @back) (200 300))
   (feed @front @mid)
   (cell @mid 100)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back))
  ((queue (@front @back) (200 300))
   (feed @front @mid)
   (cell @mid)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid' 200)
   (feed @mid' @back))
  ((queue (@front @back) (300 200))
   (feed @front @mid)
   (cell @mid 200)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back))
  ((queue (@front @back) (300 200))
   (feed @front @mid)
   (cell @mid)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid' 400)
   (feed @mid' @back))
  ((queue (@front @back) (200 400))
   (feed @front @mid)
   (cell @mid 300)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back))
  ((queue (@front @back) (200 400))
   (feed @front @mid)
   (cell @mid)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid' 600)
   (feed @mid' @back))
  ((queue (@front @back) (400 600))
   (feed @front @mid)
   (cell @mid 200)
   (transfer (@mid ±n @mid') ^(* n 2))
   (cell @mid')
   (feed @mid' @back)))
  ;; ...

;; Queue feedback
(d7
  ((queue (@a @a) (100 200 300)))
  end)

;; queue limit: N
(d7
  ((queue (@front0 @back0) (100 200 300 400 500 600))
   (feed @front0 @back)
   (queue (@front @back limit: 3) ()))
  ((queue (@front0 @back0) (200 300 400 500 600))
   (feed @front0 @back)
   (queue (@front @back limit: 3) (100)))
  ((queue (@front0 @back0) (300 400 500 600))
   (feed @front0 @back)
   (queue (@front @back limit: 3) (100 200)))
  ((queue (@front0 @back0) (400 500 600))
   (feed @front0 @back)
   (queue (@front @back limit: 3) (100 200 300)))
  end)

;; queue limit: 0
(d7
  ((queue (@front0 @back0) (100 200 300 400 500 600))
   (feed @front0 @back)
   (queue (@front @back limit: 0) ()))
  end)

;; queue limit: 3.14
(d7
  ((queue (@front0 @back0) (100 200 300 400 500 600))
   (feed @front0 @back)
   (queue (@front @back limit: 3.14) ()))
  end)

;; An observer can make decisions based on its children and feed them back.
(d7
  ((frag @x
     (group
       (cell @src 100)
       (view (@src ±n @voice0) ^(+ n 2))
       (view (@src ±n @voice1) ^(* n 2))
       (cell @voice0)
       (cell @voice1)))
   (fb (@x (%all ⟨(cell @src n_)⟩ ⟨(cell @voice0 a_)⟩ ⟨(cell @voice1 b_)⟩))
     {sum: ^(+ a b)}
     {n: →sum}))
  ((frag @x
     (group
       (cell @src 302)
       (view (@src ±n @voice0) ^(+ n 2))
       (view (@src ±n @voice1) ^(* n 2))
       (cell @voice0 102)
       (cell @voice1 200)))
   (fb (@x (%all ⟨(cell @src n_)⟩ ⟨(cell @voice0 a_)⟩ ⟨(cell @voice1 b_)⟩))
     {sum: ^(+ a b)}
     {n: →sum}))
  ((frag @x
     (group
       (cell @src 908)
       (view (@src ±n @voice0) ^(+ n 2))
       (view (@src ±n @voice1) ^(* n 2))
       (cell @voice0 304)
       (cell @voice1 604)))
   (fb (@x (%all ⟨(cell @src n_)⟩ ⟨(cell @voice0 a_)⟩ ⟨(cell @voice1 b_)⟩))
     {sum: ^(+ a b)}
     {n: →sum})))
  ;; ...

