;; Sensor-appearance timing with circuits.
(d7
  (frame
    (circuit @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v)))
    (delay 2 (cell @foo "Hello World"))
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n))
  (frame
    (circuit @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v)))
    (delay 1 (cell @foo "Hello World"))
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n (cell @v)))
  (frame
    (circuit @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v)))
    (cell @foo "Hello World")
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n (cell @v)))
  (frame
    (circuit @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v "Hello World")))
    (cell @foo)
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n (cell @v "Hello World")))
  end)

