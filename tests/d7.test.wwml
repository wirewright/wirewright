;; Sensor-appearance chan parallel match
(d7
  (frame
    (module {}
      (sensor (local ±n @val) ^n)
      (cell @val))
    (module {}
      (sensor (local name_string @val) ^"Hi, ⸢name⸣!")
      (cell @val))
    (module {}
      (appearance local @val)
      (cell @val "Alice"))
    (module {}
      (appearance local @val)
      (cell @val 200)))
  (frame
    (module {}
      (sensor (local ±n @val) ^n)
      (cell @val 200))
    (module {}
      (sensor (local name_string @val) ^"Hi, ⸢name⸣!")
      (cell @val "Hi, Alice!"))
    (module {}
      (appearance local @val)
      (cell @val))
    (module {}
      (appearance local @val)
      (cell @val)))
  end)

;; Sensor-appearance chan conditional sense
(d7
  (frame
    (module {}
      (cell @val 100)
      (appearance local @val))
    (module {}
      (cell @val (arg 50))
      (appearance local @val))
    (module {}
      (cell @val (arg 150))
      (appearance local @val))
    (module {}
      (frag @s)
      (sensor (local ±n @s)
        (group
          (cell @v)
          (sensor (local (arg x←(%number _ < ^n)) @v)
            ^^(+ x 1))))))
  (frame
    (module {}
      (cell @val)
      (appearance local @val))
    (module {}
      (cell @val (arg 50))
      (appearance local @val))
    (module {}
      (cell @val (arg 150))
      (appearance local @val))
    (module {}
      (frag @s
        (group
          (cell @v)
          (sensor (local (arg x←(%number _ < 100)) @v)
            ^(+ x 1))))
      (sensor (local ±n @s)
        (group
          (cell @v)
          (sensor (local (arg x←(%number _ < ^n)) @v)
            ^^(+ x 1))))))
  (frame
    (module {}
      (cell @val)
      (appearance local @val))
    (module {}
      (cell @val)
      (appearance local @val))
    (module {}
      (cell @val (arg 150))
      (appearance local @val))
    (module {}
      (frag @s
        (group
          (cell @v 51)
          (sensor (local (arg x←(%number _ < 100)) @v)
            ^(+ x 1))))
      (sensor (local ±n @s)
        (group
          (cell @v)
          (sensor (local (arg x←(%number _ < ^n)) @v)
            ^^(+ x 1))))))
  end)


