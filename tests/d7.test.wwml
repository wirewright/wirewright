;; Sensor-appearance chan conditional sense
(d7
  (frame
    (module {}
      (cell @val 100)
      (appearance local @val))
    (module {}
      (cell @val (arg 50))
      (appearance local @val))
    (module {}
      (cell @val (arg 150))
      (appearance local @val))
    (module {}
      (frag @s)
      (sensor (local ±n @s)
        (group
          (cell @v)
          (sensor (local (arg x←(%number _ < ^n)) @v)
            ^^(+ x 1))))))
  (frame
    (module {}
      (cell @val)
      (appearance local @val))
    (module {}
      (cell @val (arg 50))
      (appearance local @val))
    (module {}
      (cell @val (arg 150))
      (appearance local @val))
    (module {}
      (frag @s
        (group
          (cell @v)
          (sensor (local (arg x←(%number _ < 100)) @v)
            ^(+ x 1))))
      (sensor (local ±n @s)
        (group
          (cell @v)
          (sensor (local (arg x←(%number _ < ^n)) @v)
            ^^(+ x 1))))))
  (frame
    (module {}
      (cell @val)
      (appearance local @val))
    (module {}
      (cell @val)
      (appearance local @val))
    (module {}
      (cell @val (arg 150))
      (appearance local @val))
    (module {}
      (frag @s
        (group
          (cell @v 51)
          (sensor (local (arg x←(%number _ < 100)) @v)
            ^(+ x 1))))
      (sensor (local ±n @s)
        (group
          (cell @v)
          (sensor (local (arg x←(%number _ < ^n)) @v)
            ^^(+ x 1))))))
  end)


