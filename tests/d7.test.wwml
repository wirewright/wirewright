    (cell @y 0)
    (cell @y 0)
    (cell @y 0))
  end)

;; Feed: 1:M, all full
(d7
  (frame
    (cell @x 0)
    (feed @x @y)
    (cell @y 100)
    (cell @y 100)
    (cell @y 100)
    (cell @y 100))
  end)

;; Feed: M:1, dst empty
(d7
  (frame
    (cell @x 0)
    (cell @x 1)
    (cell @x 2)
    (feed @x @y)
    (cell @y))
  (frame
    (cell @x)
    (cell @x)
    (cell @x)
    (feed @x @y)
    (cell @y {# 0 1 2}))
  end)

;; Feed: M:1, some srcs empty, dst empty
(d7
  (frame
    (cell @x 0)
    (cell @x)
    (cell @x 2)
    (feed @x @y)
    (cell @y))
  (frame
    (cell @x)
    (cell @x)
    (cell @x)
    (feed @x @y)
    (cell @y {# 0 2}))
  end)

;; Feed: M:1, dst full
(d7
  (frame
    (cell @x 0)
    (cell @x 1)
    (cell @x 2)
    (feed @x @y)
    (cell @y 100))
  end)

