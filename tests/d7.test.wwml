        (cell @x)
        (cell @y 200)
        (feed @x (pulse @xs))
        (feed @y (pulse @ys))
        (feed (pulse @xs) @x)
        (feed (pulse @ys) @y))
      (cell @z 100)
      (feed (pulse @xs) @z)))
  (frame
    (chat ()
      (chat ((pulse @ys 200) asc: (pulse @xs _))
        (cell @x)
        (cell @y)
        (feed @x (pulse @xs))
        (feed @y (pulse @ys))
        (feed (pulse @xs) @x)
        (feed (pulse @ys) @y))
      (cell @z 100)
      (feed (pulse @xs) @z)))
  (frame
    (chat ()
      (chat (asc: (pulse @xs _))
        (cell @x)
        (cell @y 200)
        (feed @x (pulse @xs))
        (feed @y (pulse @ys))
        (feed (pulse @xs) @x)
        (feed (pulse @ys) @y))
      (cell @z 100)
      (feed (pulse @xs) @z))))
