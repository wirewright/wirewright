      (discard @b)
      (discard @c)))
  (frame
    ((sensor* cell) (local x_ @x) ())
    ((appearance cell) (local @a))
    ((appearance cell) (local @b))
    ((appearance cell) (local @c))
    (group
      (discard @a)
      (discard @b)
      (discard @c)))
  end)

