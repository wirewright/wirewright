      (queue (@front @back) (5))
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) (2 3 4))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) ())
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) (3 4 5))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) ())
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) (4 5))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) ())
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) (5))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) ())
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back) ())
      (sensor (local ±n @back) ^n)))
  end)

