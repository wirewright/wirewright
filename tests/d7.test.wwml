;; Feed: 1:1
(d7
  (frame
    (cell @x 0)
    (feed @x @y)
    (cell @y))
  (frame
    (cell @x)
    (feed @x @y)
    (cell @y 0))
  end)

;; Copy: 1:1
(d7
  (frame
    (cell @x 0)
    (feed (copy @x) @y)
    (cell @y))
  (frame
    (cell @x 0)
    (feed (copy @x) @y)
    (cell @y 0))
  end)

;; Feed: 1:1, dst full
(d7
  (frame
    (cell @x 0)
    (feed @x @y)
    (cell @y 100))
  end)

;; Copy: 1:1, dst full [copy]
(d7
  (frame
    (cell @x 0)
    (feed (copy @x) @y)
    (cell @y 100))
  end)

;; [copy-over]
(d7
  (frame
    (cell @x 0)
    (feed (copy @x) (over @y))
    (cell @y 100))
  (frame
    (cell @x 0)
    (feed (copy @x) (over @y))
    (cell @y 0))
  end)

;; Feed: 1:M, all empty
(d7
  (frame
    (cell @x 0)
    (feed @x @y)
    (cell @y)
    (cell @y)
    (cell @y)
    (cell @y))
  (frame
    (cell @x)
    (feed @x @y)
    (cell @y 0)
    (cell @y 0)
    (cell @y 0)
    (cell @y 0))
  end)

;; Copy: 1:M, all empty
(d7
  (frame
    (cell @x 0)
    (feed (copy @x) @y)
    (cell @y)
    (cell @y)
    (cell @y)
    (cell @y))
  (frame
    (cell @x 0)
    (feed (copy @x) @y)
    (cell @y 0)
    (cell @y 0)
    (cell @y 0)
    (cell @y 0))
  end)

;; Feed: 1:M, some full
(d7
  (frame
    (cell @x 0)
    (feed @x @y)
    (cell @y)
    (cell @y 100)
    (cell @y)
    (cell @y 100))
  (frame
    (cell @x)
    (feed @x @y)
    (cell @y 0)
    (cell @y 100)
    (cell @y 0)
    (cell @y 100))
  end)

;; Copy: 1:M, some full [copy]
(d7
  (frame
    (cell @x 0)
    (feed (copy @x) @y)
    (cell @y)
    (cell @y 100)
    (cell @y)
    (cell @y 100))
  (frame
