;; An observer can make decisions based on its children and feed them back.
(d7
  (frame
    (circuit @x
      (group
        (cell @src 100)
        (view (@src ±n @voice0) ^(+ n 2))
        (view (@src ±n @voice1) ^(* n 2))
        (cell @voice0)
        (cell @voice1)))
    (fb (@x (%all ⟨(cell @src n_)⟩ ⟨(cell @voice0 a_)⟩ ⟨(cell @voice1 b_)⟩))
      {sum: ^(+ a b)}
      {n: →sum}))
  (frame
    (circuit @x
      (group
        (cell @src 302)
        (view (@src ±n @voice0) ^(+ n 2))
        (view (@src ±n @voice1) ^(* n 2))
        (cell @voice0 102)
        (cell @voice1 200)))
    (fb (@x (%all ⟨(cell @src n_)⟩ ⟨(cell @voice0 a_)⟩ ⟨(cell @voice1 b_)⟩))
      {sum: ^(+ a b)}
      {n: →sum}))
  (frame
    (circuit @x
      (group
        (cell @src 908)
        (view (@src ±n @voice0) ^(+ n 2))
        (view (@src ±n @voice1) ^(* n 2))
        (cell @voice0 304)
        (cell @voice1 604)))
    (fb (@x (%all ⟨(cell @src n_)⟩ ⟨(cell @voice0 a_)⟩ ⟨(cell @voice1 b_)⟩))
      {sum: ^(+ a b)}
      {n: →sum})))
  ;; ...

;; Nested (observed) delays are decremented once per tick.
(d7
  (frame
    (delay 3 "Foo")
    (circuit @x
      (group
        (delay 2 "Bar")
        (delay 5 "Baz")
        (circuit @y
          (delay 3 "boo")))))
  (frame
    (delay 2 "Foo")
    (circuit @x
      (group
        (delay 1 "Bar")
        (delay 4 "Baz")
        (circuit @y
          (delay 2 "boo")))))
  (frame
    (delay 1 "Foo")
    (circuit @x
      (group
        "Bar"
        (delay 3 "Baz")
        (circuit @y
          (delay 1 "boo")))))
  (frame
    "Foo"
    (circuit @x
      (group
        "Bar"
        (delay 2 "Baz")
        (circuit @y
          "boo"))))
  (frame
    "Foo"
    (circuit @x
      (group
        "Bar"
        (delay 1 "Baz")
        (circuit @y
          "boo"))))
  (frame
    "Foo"
    (circuit @x
      (group
        "Bar"
        "Baz"
        (circuit @y
          "boo")))))

;; Ditto
(d7
  (frame
    (delay 3 "Foo")
    (cell @x-view)
    (feed (copy @x) (over @x-view))
    (circuit @x
      (group
        (delay 3 "Bar")
        (cell @y-view)
        (feed (copy @y) (over @y-view))
        (circuit @y
          (delay 3 "Baz")))))
  (frame
    (delay 2 "Foo")
    (cell @x-view
      (group
        (delay 2 "Bar")
        (cell @y-view (delay 2 "Baz"))
        (feed (copy @y) (over @y-view))
        (circuit @y
          (delay 2 "Baz"))))
    (feed (copy @x) (over @x-view))
    (circuit @x
      (group
        (delay 2 "Bar")
        (cell @y-view (delay 2 "Baz"))
        (feed (copy @y) (over @y-view))
        (circuit @y
          (delay 2 "Baz")))))
  (frame
    (delay 1 "Foo")
    (cell @x-view
      (group
        (delay 1 "Bar")
        (cell @y-view (delay 1 "Baz"))
        (feed (copy @y) (over @y-view))
        (circuit @y
          (delay 1 "Baz"))))
    (feed (copy @x) (over @x-view))
    (circuit @x
      (group
        (delay 1 "Bar")
        (cell @y-view (delay 1 "Baz"))
        (feed (copy @y) (over @y-view))
        (circuit @y
          (delay 1 "Baz")))))
  (frame
    "Foo"
    (cell @x-view
      (group
        "Bar"
        (cell @y-view "Baz")
        (feed (copy @y) (over @y-view))
        (circuit @y
          "Baz")))
    (feed (copy @x) (over @x-view))
    (circuit @x
      (group
        "Bar"
        (cell @y-view "Baz")
        (feed (copy @y) (over @y-view))
        (circuit @y "Baz"))))
  end)

