      (queue (@front @back) ())
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back limit: 2) ())
      (sensor (local ±n @back) ^n)))
  end)

;; Sensor-appearance timing with frags.
(d7
  (frame
    (frag @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v)))
    (delay 2 (cell @foo "Hello World"))
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n))
  (frame
    (frag @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v)))
    (delay 1 (cell @foo "Hello World"))
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n (cell @v)))
  (frame
    (frag @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v)))
    (cell @foo "Hello World")
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n (cell @v)))
  (frame
    (frag @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v "Hello World")))
    (cell @foo)
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n (cell @v "Hello World")))
  end)
