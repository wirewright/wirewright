    (cell @x 0)
    (feed @x (pulse @xs))
    (feed (pulse @xs) @x))
  (frame
    (cell @x)
    (feed @x (pulse @xs))
    (feed (pulse @xs) @x))
  (frame
    (cell @x 0)
    (feed @x (pulse @xs))
    (feed (pulse @xs) @x)))
  ;; ...

