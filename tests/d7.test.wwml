(d7
  (frame
    (module {}
      (chat ()
        (cell @x 0)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x)))
    (module {}
      (chat ()
        (cell @x 1)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))))
  (frame
    (module {}
      (chat ((pulse @xs 0))
        (cell @x)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x)))
    (module {}
      (chat ((pulse @xs 1))
        (cell @x)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))))
  (frame
    (module {}
      (chat ()
        (cell @x 0)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x)))
    (module {}
      (chat ()
        (cell @x 1)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x)))))

;; Modules inside chats
(d7
  (frame
    ((async chat) ()
      (module {}
        (cell @x 0)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))
      (module {}
        (cell @x 1)
        (feed @x (pulse @ys))
        (feed (pulse @ys) @x))))
  (frame
    ((async chat) ((pulse @xs 0) (pulse @ys 1))
      (module {}
        (cell @x)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))
      (module {}
        (cell @x)
        (feed @x (pulse @ys))
        (feed (pulse @ys) @x))))
  (frame
    ((async chat) ((pulse @ys 1))
      (module {}
        (cell @x 0)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))
      (module {}
        (cell @x)
        (feed @x (pulse @ys))
        (feed (pulse @ys) @x))))
  (frame
    ((async chat) ((pulse @xs 0))
      (module {}
        (cell @x)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))
      (module {}
        (cell @x 1)
        (feed @x (pulse @ys))
        (feed (pulse @ys) @x))))
  (frame
    ((async chat) ((pulse @ys 1))
      (module {}
        (cell @x 0)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))
      (module {}
        (cell @x)
        (feed @x (pulse @ys))
        (feed (pulse @ys) @x)))))
  ;; ...


;; Toplevel (implicit) chat
(d7
  (frame
    (cell @x 0)
    (feed @x (pulse @xs))
    (feed (pulse @xs) @x))
  (frame
    (cell @x)
    (feed @x (pulse @xs))
    (feed (pulse @xs) @x))
  (frame
    (cell @x 0)
    (feed @x (pulse @xs))
    (feed (pulse @xs) @x)))
  ;; ...

;; Communication between chats (ascent)
(d7
  (frame
    (chat ()
      (chat (asc: (pulse @xs _))
        (cell @x 100)
        (cell @y 200)
        (feed @x (pulse @xs))
        (feed @y (pulse @ys))
        (feed (pulse @xs) @x)
        (feed (pulse @ys) @y))
      (cell @z)
      (feed (pulse @xs) @z)))
  (frame
    (chat ((pulse @xs 100))
      (chat ((pulse @ys 200) asc: (pulse @xs _))
        (cell @x)
        (cell @y)
        (feed @x (pulse @xs))
        (feed @y (pulse @ys))
        (feed (pulse @xs) @x)
        (feed (pulse @ys) @y))
      (cell @z)
      (feed (pulse @xs) @z)))
  (frame
    (chat ()
      (chat (asc: (pulse @xs _))
        (cell @x)
        (cell @y 200)
        (feed @x (pulse @xs))
        (feed @y (pulse @ys))
        (feed (pulse @xs) @x)
        (feed (pulse @ys) @y))
      (cell @z 100)
      (feed (pulse @xs) @z)))
  (frame
    (chat ()
      (chat ((pulse @ys 200) asc: (pulse @xs _))
        (cell @x)
        (cell @y)
        (feed @x (pulse @xs))
        (feed @y (pulse @ys))
        (feed (pulse @xs) @x)
        (feed (pulse @ys) @y))
      (cell @z 100)
      (feed (pulse @xs) @z)))
  (frame
    (chat ()
      (chat (asc: (pulse @xs _))
        (cell @x)
        (cell @y 200)
        (feed @x (pulse @xs))
        (feed @y (pulse @ys))
        (feed (pulse @xs) @x)
        (feed (pulse @ys) @y))
      (cell @z 100)
      (feed (pulse @xs) @z))))
  ;; ...

;; Communication between chats (multicast descent)
(d7
  (frame
    (chat ((pulse @xs 100) (pulse @ys 200))
      (cell @y)
      (feed (pulse @ys) @y)
      (module {}
        (chat (desc: (pulse @xs _))
          (feed (pulse @xs) @x)
          (cell @x)))
      (module {}
        (chat (desc: (pulse @xs _))
          (feed (pulse @xs) @x)
          (cell @x)))
      (module {}
        (chat (desc: (pulse @xs _))
          (feed (pulse @xs) @x)
          (cell @x)))))
  (frame
    (chat ((pulse @ys 200))
      (cell @y)
      (feed (pulse @ys) @y)
      (module {}
        (chat ((pulse @xs 100) desc: (pulse @xs _))
          (feed (pulse @xs) @x)
          (cell @x)))
      (module {}
        (chat ((pulse @xs 100) desc: (pulse @xs _))
          (feed (pulse @xs) @x)
          (cell @x)))
      (module {}
        (chat ((pulse @xs 100) desc: (pulse @xs _))
          (feed (pulse @xs) @x)
          (cell @x)))))
  (frame
    (chat ()
      (cell @y 200)
      (feed (pulse @ys) @y)
      (module {}
        (chat (desc: (pulse @xs _))
          (feed (pulse @xs) @x)
          (cell @x 100)))
      (module {}
        (chat (desc: (pulse @xs _))
          (feed (pulse @xs) @x)
          (cell @x 100)))
      (module {}
        (chat (desc: (pulse @xs _))
          (feed (pulse @xs) @x)
          (cell @x 100)))))
  end)

;; `blast` device, pulse backpressure
(d7
  (frame
    (chat ()
      (cell @xlist (1 2 3))
      (blast @xlist (pulse @xs))
      (cell @x)
      (discard @x)
      (feed (pulse @xs) @x)))
  (frame
    (chat ((pulse @xs 1) (pulse @xs 2) (pulse @xs 3))
      (cell @xlist)
      (blast @xlist (pulse @xs))
      (cell @x)
      (discard @x)
      (feed (pulse @xs) @x)))
  (frame
    (chat ((pulse @xs 2) (pulse @xs 3))
      (cell @xlist)
      (blast @xlist (pulse @xs))
      (cell @x 1)
      (discard @x)
      (feed (pulse @xs) @x)))
  (frame
    (chat ((pulse @xs 2) (pulse @xs 3)) ;; < xs=2 blocks here because no one can consume it
      (cell @xlist)
      (blast @xlist (pulse @xs))
      (cell @x)
      (discard @x)
      (feed (pulse @xs) @x)))
  (frame
    (chat ((pulse @xs 3))
      (cell @xlist)
      (blast @xlist (pulse @xs))
      (cell @x 2)
      (discard @x)
      (feed (pulse @xs) @x)))
  (frame
    (chat ((pulse @xs 3)) ;; < xs=3 blocks here because no one can consume it
      (cell @xlist)
      (blast @xlist (pulse @xs))
      (cell @x)
      (discard @x)
      (feed (pulse @xs) @x)))
  (frame
    (chat ()
      (cell @xlist)
      (blast @xlist (pulse @xs))
      (cell @x 3)
      (discard @x)
      (feed (pulse @xs) @x)))
  (frame
    (chat ()
      (cell @xlist)
      (blast @xlist (pulse @xs))
      (cell @x)
      (discard @x)
      (feed (pulse @xs) @x)))
  end)

;; Pulse backpressure with multiple consumers
(d7
  (frame
    (module {}
      (chat ((pulse @xs 100))
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (cell @x "busy")
        (cell @y)))
    (module {}
      (chat ((pulse @xs 200))
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (cell @x)
        (cell @y "busy")))
    (module {}
      (chat ((pulse @xs 300) (pulse @xs 400))
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (feed (pulse @xs) @z)
        (delay 2 (cell @x))
        (cell @x)
        (cell @y "busy")
        (cell @z))))
  (frame
    (module {}
      (chat ()
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (cell @x "busy")
        (cell @y 100)))
    (module {}
      (chat ()
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (cell @x 200)
        (cell @y "busy")))
    (module {}
      (chat ((pulse @xs 400))
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (feed (pulse @xs) @z)
        (delay 1 (cell @x))
        (cell @x 300)
        (cell @y "busy")
        (cell @z 300))))
  (frame
    (module {}
      (chat ()
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (cell @x "busy")
        (cell @y 100)))
    (module {}
      (chat ()
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (cell @x 200)
        (cell @y "busy")))
    (module {}
      (chat ((pulse @xs 400))
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (feed (pulse @xs) @z)
        (cell @x)
        (cell @x 300)
        (cell @y "busy")
        (cell @z 300))))
  (frame
    (module {}
      (chat ()
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (cell @x "busy")
        (cell @y 100)))
    (module {}
      (chat ()
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (cell @x 200)
        (cell @y "busy")))
    (module {}
      (chat ()
        (feed (pulse @xs) @x)
        (feed (pulse @xs) @y)
        (feed (pulse @xs) @z)
        (cell @x 400)
        (cell @x 300)
        (cell @y "busy")
        (cell @z 300))))
  end)

;; Queue + chat + backpressure
(d7
  (frame
    ((async chat) ()
      (queue (@front @back) (1 2 3))
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x)
      (delay 4 (discard @x))))
  (frame
    ((async chat) ((pulse @xs 1))
      (queue (@front @back) (2 3))
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x)
      (delay 3 (discard @x))))
  (frame
    ((async chat) ((pulse @xs 2))
      (queue (@front @back) (3))
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x 1)
      (delay 2 (discard @x))))
  (frame
    ((async chat) ((pulse @xs 2) (pulse @xs 3))
      (queue (@front @back) ())
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x 1)
      (delay 1 (discard @x))))
  (frame
    ((async chat) ((pulse @xs 2) (pulse @xs 3))
      (queue (@front @back) ())
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x 1)
      (discard @x)))
  (frame
    ((async chat) ((pulse @xs 2) (pulse @xs 3))
      (queue (@front @back) ())
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x)
      (discard @x)))
  (frame
    ((async chat) ((pulse @xs 3))
      (queue (@front @back) ())
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x 2)
      (discard @x)))
  (frame
    ((async chat) ((pulse @xs 3))
      (queue (@front @back) ())
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x)
      (discard @x)))
  (frame
    ((async chat) ()
      (queue (@front @back) ())
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x 3)
      (discard @x)))
  (frame
    ((async chat) ()
      (queue (@front @back) ())
      (feed @front (pulse @xs))
      (feed (pulse @xs) @x)
      (cell @x)
      (discard @x)))
  end)

;; `ml/term` device
(d7
  (frame
    ((async chat) ()
      (queue (@src @back) ("100" "200" "300" "(+ 1 2)" "(+ 1 2"))
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)
      (discard @!term)))
  (frame
    ((async chat) ((pulse @srcs "100"))
      (queue (@src @back) ("200" "300" "(+ 1 2)" "(+ 1 2"))
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)
      (discard @!term)))
  (frame
    ((async chat) ((pulse @!terms (ok 100)) (pulse @srcs "200"))
      (queue (@src @back) ("300" "(+ 1 2)" "(+ 1 2"))
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)
      (discard @!term)))
  (frame
    ((async chat) ((pulse @srcs "200") (pulse @srcs "300"))
      (queue (@src @back) ("(+ 1 2)" "(+ 1 2"))
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term (ok 100))
      (discard @!term)))
  (frame
    ((async chat) ((pulse @srcs "300") (pulse @!terms (ok 200)) (pulse @srcs "(+ 1 2)"))
      (queue (@src @back) ("(+ 1 2"))
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)
      (discard @!term)))
  (frame
    ((async chat) ((pulse @!terms (ok 200)) (pulse @srcs "(+ 1 2)") (pulse @!terms (ok 300)) (pulse @srcs "(+ 1 2"))
      (queue (@src @back) ())
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)
      (discard @!term)))
  (frame
    ((async chat) ((pulse @srcs "(+ 1 2)") (pulse @!terms (ok 300)) (pulse @srcs "(+ 1 2"))
      (queue (@src @back) ())
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term (ok 200))
      (discard @!term)))
  (frame
    ((async chat) ((pulse @!terms (ok 300)) (pulse @srcs "(+ 1 2") (pulse @!terms (ok (+ 1 2))))
      (queue (@src @back) ())
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)
      (discard @!term)))
  (frame
    ((async chat) ((pulse @srcs "(+ 1 2") (pulse @!terms (ok (+ 1 2))))
      (queue (@src @back) ())
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term (ok 300))
      (discard @!term)))
  (frame m1: true
    ((async chat) ((pulse @!terms (ok (+ 1 2))) (pulse @!terms [err]))
      (queue (@src @back) ())
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)
      (discard @!term)))
  (frame m1: true
    ((async chat) ((pulse @!terms [err]))
      (queue (@src @back) ())
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term (ok (+ 1 2)))
      (discard @!term)))
  (frame m1: true
    ((async chat) ((pulse @!terms [err]))
      (queue (@src @back) ())
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)
      (discard @!term)))
  (frame m1: true
    ((async chat) ()
      (queue (@src @back) ())
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term [err])
      (discard @!term)))
  (frame
    ((async chat) ()
      (queue (@src @back) ())
      (feed @src (pulse @srcs))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)
      (discard @!term)))
  end)

(d7
  (frame
    (chat ((pulse @srcs "100 200 300"))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)))
  (frame m1: true
    (chat ((pulse @!terms [err]))
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)))
  (frame m1: true
    (chat ()
      (ml/term @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term [err])))
  end)

