      (cell @x)
      (appearance local @x))
    (module {}
      (sensor (local (seen x_) @x) ^(+ x 1))
      (appearance local @x)
      (cell @x)))
  (frame
    (module {}
      (cell @val)
      (appearance local @val))
    (module {}
      (sensor (local ±n @x) (seen ^n))
      (cell @x (seen 100))
      (appearance local @x))
    (module {}
