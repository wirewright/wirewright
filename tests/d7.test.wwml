;; Sensor-appearance timing with frags.
(d7
  (frame
    (frag @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v)))
    (delay 2 (cell @foo "Hello World"))
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n))
  (frame
    (frag @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v)))
    (delay 1 (cell @foo "Hello World"))
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n (cell @v)))
  (frame
    (frag @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v)))
    (cell @foo "Hello World")
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n (cell @v)))
  (frame
    (frag @f
      (group
        (sensor (local x_ @v) ^x)
        (cell @v "Hello World")))
    (cell @foo)
    (appearance local @foo)
    (view (@f ⟨node←(cell @v _*)⟩ @n) ^node)
    (cell @n (cell @v "Hello World")))
  end)

;; Cell to event and event to cell
(d7
  (frame
    (cell @x 0)
    (chat ()
      (feed @x (pulse @xs))))
  (frame
    (cell @x)
    (chat ((pulse @xs 0)) ;; < stalls because there's no one to consume it
      (feed @x (pulse @xs))))
  end)

(d7
  (frame
    (cell @x)
    (chat ((pulse @xs 100))
      (feed (pulse @xs) @x)))
  (frame
    (cell @x 100)
    (chat ()
      (feed (pulse @xs) @x)))
  end)

(d7
  (frame
    (cell @x 100)
    (chat ()
      (feed @x (pulse @ys))
      (feed (pulse @ys) @y)
      (cell @y)))
  (frame
    (cell @x)
    (chat ((pulse @ys 100))
      (feed @x (pulse @ys))
      (feed (pulse @ys) @y)
      (cell @y)))
  (frame
    (cell @x)
    (chat ()
      (feed @x (pulse @ys))
      (feed (pulse @ys) @y)
      (cell @y 100)))
  end)

;; Multiple chats run in parallel and do not conflict.
(d7
  (frame
    (chat ()
      (cell @x 0)
      (feed @x (pulse @xs))
      (feed (pulse @xs) @x))
    (chat ()
      (cell @y 1)
      (feed @y (pulse @ys))
      (feed (pulse @ys) @y))
    (chat ()
      (cell @z 2)
      (feed @z (pulse @zs))
      (feed (pulse @zs) @z)))
  (frame
    (chat ((pulse @xs 0))
      (cell @x)
      (feed @x (pulse @xs))
      (feed (pulse @xs) @x))
    (chat ((pulse @ys 1))
      (cell @y)
      (feed @y (pulse @ys))
      (feed (pulse @ys) @y))
    (chat ((pulse @zs 2))
      (cell @z)
      (feed @z (pulse @zs))
      (feed (pulse @zs) @z)))
  (frame
    (chat ()
      (cell @x 0)
      (feed @x (pulse @xs))
      (feed (pulse @xs) @x))
    (chat ()
      (cell @y 1)
      (feed @y (pulse @ys))
      (feed (pulse @ys) @y))
    (chat ()
      (cell @z 2)
      (feed @z (pulse @zs))
      (feed (pulse @zs) @z))))
  ;; ...

