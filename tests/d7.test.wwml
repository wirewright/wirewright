;; View of N cells (delay, queue, mismatch)
(d7
  (frame
    (queue (@command @back) (greet welcome greet))
    (delay 2 (discard @command))
    (cell @name "Mary")
    (cell @age 26)
    (view ((@command @name @age) (greet name_ age_) @output)
      ^"Hi, ⸢name⸣ of age ⸢age⸣!")
    (cell @output))
  (frame
    (queue (@command @back) (greet welcome greet))
    (delay 1 (discard @command))
    (cell @name "Mary")
    (cell @age 26)
    (view ((@command @name @age) (greet name_ age_) (@output "dkbeciesdubxcXCcBfeeResdubxcXCbYdWczfbeKefcUwjtMbAddQbGdp"))
      ^"Hi, ⸢name⸣ of age ⸢age⸣!")
    (cell @output "Hi, Mary of age 26!"))
  (frame
    (queue (@command @back) (greet welcome greet))
    (discard @command)
    (cell @name "Mary")
    (cell @age 26)
    (view ((@command @name @age) (greet name_ age_) (@output "dkbeciesdubxcXCcBfeeResdubxcXCbYdWczfbeKefcUwjtMbAddQbGdp"))
      ^"Hi, ⸢name⸣ of age ⸢age⸣!")
    (cell @output "Hi, Mary of age 26!"))
  (frame
    (queue (@command @back) (welcome greet))
    (discard @command)
    (cell @name "Mary")
    (cell @age 26)
    (view ((@command @name @age) (greet name_ age_) (@output "dkbeciesdubxcXCcBfeeResdubxcXCbYdWczfbeKefcUwjtMbAddQbGdp"))
      ^"Hi, ⸢name⸣ of age ⸢age⸣!")
    (cell @output "Hi, Mary of age 26!"))
  (frame
    (queue (@command @back) (greet))
    (discard @command)
    (cell @name "Mary")
    (cell @age 26)
    (view ((@command @name @age) (greet name_ age_) @output)
      ^"Hi, ⸢name⸣ of age ⸢age⸣!")
    (cell @output))
  (frame
    (queue (@command @back) ())
    (discard @command)
    (cell @name "Mary")
    (cell @age 26)
    (view ((@command @name @age) (greet name_ age_) (@output "dkbeciesdubxcXCcBfeeResdubxcXCbYdWczfbeKefcUwjtMbAddQbGdp"))
      ^"Hi, ⸢name⸣ of age ⸢age⸣!")
    (cell @output "Hi, Mary of age 26!"))
  (frame
    (queue (@command @back) ())
    (discard @command)
    (cell @name "Mary")
    (cell @age 26)
    (view ((@command @name @age) (greet name_ age_) @output)
      ^"Hi, ⸢name⸣ of age ⸢age⸣!")
    (cell @output))
  end)

