  (frame
    (module {}
      (queue (@front @back) (4 5 6))
      (appearance local @front))
    (module {}
      (discard @front)
      (queue (@front @back limit: 2) (2 3))
      (sensor (local ±n @back) ^n)))
  (frame
    (module {}
      (queue (@front @back) (5 6))
      (appearance local @front))
    (module {}
