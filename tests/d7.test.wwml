;; Modules inside chats
(d7
  (frame
    (chat ()
      (module {}
        (cell @x 0)
        (feed @x (pulse @xs))
        (feed (pulse @xs) @x))
      (module {}
        (cell @x 1)
        (feed @x (pulse @ys))
        (feed (pulse @ys) @x))))
