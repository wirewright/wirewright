;; `ml/document` device
(d7
  (frame
    (chat ((pulse @srcs "---\nx y z"))
      (ml/document @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)))
  (frame
    (chat ((pulse @!terms (ok {default: (), aux: (x y z)})))
      (ml/document @srcs (result @!terms))
      (feed (pulse @!terms) @!term)
      (cell @!term)))
  (frame
