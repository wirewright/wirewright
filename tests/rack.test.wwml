;; Feed
(group
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (feed @a @b))
    (frame
      (cell @a)
      (cell @b 100)
      (feed @a @b))
    end)

  ;; Inhibitor absent
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (feed (not @x) @a @b))
    (frame
      (cell @a)
      (cell @b 100)
      (feed (not @x) @a @b))
    end)

  ;; Inhibitor empty
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (cell @x)
      (feed (not @x) @a @b))
    (frame
      (cell @a)
      (cell @b 100)
      (cell @x)
      (feed (not @x) @a @b))
    end)

  ;; Inhibitor present
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (cell @x qux)
      (feed (not @x) @a @b))
    end)

  ;; Append
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (feed @a (@b back)))
    (frame
      (cell @a)
      (cell @b (a b c 100))
      (feed @a (@b back)))
    end)

  ;; Prepend
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (feed @a (@b front)))
    (frame
      (cell @a)
      (cell @b (100 a b c))
      (feed @a (@b front)))
    end)

  ;; Atop (absent)
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (feed @a (atop @b)))
    (frame
      (cell @a)
      (cell @b 100)
      (feed @a (atop @b)))
    end)

  ;; Atop (present)
  (rack
    (frame
      (cell @a 100)
      (cell @b qux)
      (feed @a (atop @b)))
    (frame
      (cell @a)
      (cell @b 100)
      (feed @a (atop @b)))
    end)

  ;; Atop...front
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (feed @a (atop (@b front))))
    (frame
      (cell @a)
      (cell @b (100 b c))
      (feed @a (atop (@b front))))
    end)

  ;; Atop...back
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (feed @a (atop (@b back))))
    (frame
      (cell @a)
      (cell @b (a b 100))
      (feed @a (atop (@b back))))
    end)

  ;; Dequeue
  (rack
    (frame
      (cell @a (a b c))
      (cell @b)
      (feed (@a front) @b))
    (frame
      (cell @a (b c))
      (cell @b a)
      (feed (@a front) @b))
    end)

  ;; Pop
  (rack
    (frame
      (cell @a (a b c))
      (cell @b)
      (feed (@a back) @b))
    (frame
      (cell @a (a b))
      (cell @b c)
      (feed (@a back) @b))
    end)

  ;; Dequeue + pop
  (rack
    (frame
      (cell @a (a b c))
      (cell @b)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (a b))
      (cell @b c)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (c a b))
      (cell @b)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (c a))
      (cell @b b)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (b c a))
      (cell @b)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (b c))
      (cell @b a)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (a b c))
      (cell @b)
      (feed (@a back) @b)
      (feed @b (@a front))))
    ;; ...

  ;; Pop + Append
  (rack
    (frame
      (cell @a (a b c))
      (feed (@a back) (@b back))
      (cell @b ()))
    (frame
      (cell @a (a b))
      (feed (@a back) (@b back))
      (cell @b (c)))
    (frame
      (cell @a (a))
      (feed (@a back) (@b back))
      (cell @b (c b)))
    (frame
      (cell @a ())
      (feed (@a back) (@b back))
      (cell @b (c b a)))
    end)

  ;; Enqueue + Append
  (rack
    (frame
      (cell @a (a b c))
      (feed (@a front) (@b back))
      (cell @b ()))
    (frame
      (cell @a (b c))
      (feed (@a front) (@b back))
      (cell @b (a)))
    (frame
      (cell @a (c))
      (feed (@a front) (@b back))
      (cell @b (a b)))
    (frame
      (cell @a ())
      (feed (@a front) (@b back))
      (cell @b (a b c)))
    end)

  ;; Copy ... front
  (rack
    (frame
      (cell @a (a b c))
      (feed (copy (@a front)) @b)
      (cell @b))
    (frame
      (cell @a (a b c))
      (feed (copy (@a front)) @b)
      (cell @b a))
    end)

  ;; Copy ... back
  (rack
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) @b)
      (cell @b))
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) @b)
      (cell @b c))
    end)

  ;; Copy back ... front
  (rack
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) (@b front))
      (cell @b ()))
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) (@b front))
      (cell @b (c)))
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) (@b front))
      (cell @b (c c)))
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) (@b front))
      (cell @b (c c c))))
    ;; ...

  ;; Copy ... back ... front observes, back ... front moves
  (rack
    (frame
      (cell @a (a b c))
      (feed (@a back) (@c front))
      (feed (copy (@a back)) (@b front))
      (cell @b ())
      (cell @c ()))
    (frame
      (cell @a (a b))
      (feed (@a back) (@c front))
      (feed (copy (@a back)) (@b front))
      (cell @b (c))
      (cell @c (c)))
    (frame
      (cell @a (a))
      (feed (@a back) (@c front))
      (feed (copy (@a back)) (@b front))
      (cell @b (b c))
      (cell @c (b c)))
    (frame
      (cell @a ())
      (feed (@a back) (@c front))
      (feed (copy (@a back)) (@b front))
      (cell @b (a b c))
      (cell @c (a b c)))
    end)

  ;; Aggregate (basic)
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) @agg)
      (cell @agg))
    (frame
      (cell @a)
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) @agg)
      (cell @agg (100 a z)))
    end)

  ;; Aggregate ... back (basic)
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ()))
    (frame
      (cell @a)
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z))))
    end)

  ;; Aggregate ... back (queue)
  (rack
    (frame
      (queue (@a @a') (100 200 300 400))
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ()))
    (frame
      (queue (@a @a') (200 300 400))
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z))))
    (frame
      (queue (@a @a') (300 400))
      (cell @b (c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z) (200 b z))))
    (frame
      (queue (@a @a') (400))
      (cell @b ())
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z) (200 b z) (300 c z))))
    end)

  ;; Aggregate: atop ... back
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (atop (@agg back)))
      (cell @agg (qux)))
    (frame
      (cell @a)
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (atop (@agg back)))
      (cell @agg ((100 a z))))
    end)

  ;; Broadcast (basic)
  (rack
    (frame
      (cell @a (200 100 300))
      (feed @a (@x @y @z))
      (cell @x)
      (cell @y)
      (cell @z))
    (frame
      (cell @a)
      (feed @a (@x @y @z))
      (cell @x 200)
      (cell @y 100)
      (cell @z 300))
    end)

  ;; Aggregate -> broadcast osc
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ())
      (feed (@agg back) (@a (@b front) (atop (@c back)))))
    (frame
      (cell @a)
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z)))
      (feed (@agg back) (@a (@b front) (atop (@c back)))))
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ())
      (feed (@agg back) (@a (@b front) (atop (@c back))))))
    ;; ...

  ;; Parallel transfer
  (rack
    (frame
      (cell @a "foo")
      (cell @b "bar")
      (cell @c "baz")
      (cell @x)
      (cell @y (qux))
      (cell @z (xuq))
      (feed (@a @b @c) (@x (@y front) (@z back))))
    (frame
      (cell @a)
      (cell @b)
      (cell @c)
      (cell @x "foo")
      (cell @y ("bar" qux))
      (cell @z (xuq "baz"))
      (feed (@a @b @c) (@x (@y front) (@z back))))
    end)

  ;; Feed should not work if duplicate input cells exist
  (rack
    (frame
      (cell @x 100)
      (cell @x 200)
      (feed @x @y)
      (cell @y))
    end)

  ;; Feed should not work if duplicate output cells exist
  (rack
    (frame
      (cell @x 100)
      (feed @x @y)
      (cell @y)
      (cell @y))
    end)

  ;; Feed should respect user-order
  (rack
    (frame
      (cell @d 100)
      (cell @a 400)
      (cell @c 200)
      (cell @b 300)
      (feed (@a @b @c @d) @x)
      (cell @x)
      (feed @x (@a @b @c @d)))
    (frame
      (cell @d)
      (cell @a)
      (cell @c)
      (cell @b)
      (feed (@a @b @c @d) @x)
      (cell @x (400 300 200 100))
      (feed @x (@a @b @c @d)))
    (frame
      (cell @d 100)
      (cell @a 400)
      (cell @c 200)
      (cell @b 300)
      (feed (@a @b @c @d) @x)
      (cell @x)
      (feed @x (@a @b @c @d))))
    ;; ...

  (rack
    (frame
      (cell @d 100)
      (cell @a 400)
      (group
        (cell @c 200)
        (cell @b 300))
      (feed (@a @b @c @d) (@w @y @x @z))
      (cell @w)
      (group
        (cell @x)
        (cell @y)
        (cell @z)))
    (frame
      (cell @d)
      (cell @a)
      (group
        (cell @c)
        (cell @b))
      (feed (@a @b @c @d) (@w @y @x @z))
      (cell @w 400)
      (group
        (cell @x 200)
        (cell @y 300)
        (cell @z 100)))
    end)

  ;; Conflicts like this one rely on addr comparison of participants deep in the guts
  ;; of D7 to remain deterministic. The comparison is a method of last resort when
  ;; it comes to sorting solutions. Here we exercise it.
  (rack
    (frame
      (cell @x a)
      (cell @y b)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    (frame
      (cell @x) ;; < (cell @x)'s addr is smaller so it wins
      (cell @y b)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink a)
      (discard @sink))
    (frame
      (cell @x)
      (cell @y b)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    (frame
      (cell @x)
      (cell @y)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink b)
      (discard @sink))
    (frame
      (cell @x)
      (cell @y)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    end)

  (rack
    (frame
      (cell @y b)
      (cell @x a)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    (frame
      (cell @y) ;; < (cell @y)'s addr is smaller so it wins
      (cell @x a)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink b)
      (discard @sink))
    (frame
      (cell @y)
      (cell @x a)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    (frame
      (cell @y)
      (cell @x)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink a)
      (discard @sink))
    (frame
      (cell @y)
      (cell @x)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    end))

;; Single tick parallelism.
(rack
  (frame
    (module {}
      (cell @x 0)
      (feed @x @y)
      (cell @y))
   (module {}
      (cell @x 0)
      (feed @x @y)
      (cell @y)))
  (frame
    (module {}
      (cell @x)
      (feed @x @y)
      (cell @y 0))
    (module {}
      (cell @x)
      (feed @x @y)
      (cell @y 0)))
  end)

;; Waterfall.
(rack
  (frame
    (cell @0 0)
    (cell @1)
    (cell @2)
    (cell @3)
    (feed @0 @1 @2 @3))
  (frame
    (cell @0)
    (cell @1 0)
    (cell @2)
    (cell @3)
    (feed @0 @1 @2 @3))
  (frame
    (cell @0)
    (cell @1)
    (cell @2 0)
    (cell @3)
    (feed @0 @1 @2 @3))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (cell @3 0)
    (feed @0 @1 @2 @3))
  end)

;; Waterfall with multiple items. Note how we don't pick conflicting rewrites
;; in the same step. This is why you see the "hole" between items: that cell
;; is "expended" in that tick because an item was moved FROM it.
(rack
  (frame
    (cell @0 0)
    (cell @1 1)
    (cell @2 2)
    (cell @3)
    (cell @4)
    (cell @5)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0 0)
    (cell @1 1)
    (cell @2)
    (cell @3 2)
    (cell @4)
    (cell @5)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0 0)
    (cell @1)
    (cell @2 1)
    (cell @3)
    (cell @4 2)
    (cell @5)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1 0)
    (cell @2)
    (cell @3 1)
    (cell @4)
    (cell @5 2)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1)
    (cell @2 0)
    (cell @3)
    (cell @4 1)
    (cell @5)
    (cell @6 2)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (cell @3 0)
    (cell @4)
    (cell @5 1)
    (cell @6 2)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (cell @3)
    (cell @4 0)
    (cell @5 1)
    (cell @6 2)
    (feed @0 @1 @2 @3 @4 @5 @6))
  end)

;; Oscillation
(rack
  (frame
    (cell @0 100)
    (feed @0 @1 @0)
    (cell @1))
  (frame
    (cell @0)
    (feed @0 @1 @0)
    (cell @1 100))
  (frame
    (cell @0 100)
    (feed @0 @1 @0)
    (cell @1))
  (frame
    (cell @0)
    (feed @0 @1 @0)
    (cell @1 100)))
  ;; ...

;; Discard with pattern
(group
  (rack
    (frame
      (cell @a)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a x)
      (discard @a _symbol))
    (frame
      (cell @a)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a 100)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a x)
      (cell @b y)
      (discard @a _symbol))
    (frame
      (cell @a)
      (cell @b y)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a x)
      (cell @a y)
      (discard @a _symbol))
    (frame
      (cell @a)
      (cell @a)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a x)
      (cell @a 100)
      (discard @a _symbol))
    (frame
      (cell @a)
      (cell @a 100)
      (discard @a _symbol))
    end))

;; Group
(rack
  (frame
    (group
      (cell @a "foo")
      (cell @b "bar"))
    (group
      (cell @c "baz"))
    (feed (@a @b @c) @x)
    (cell @x))
  (frame
    (group
      (cell @a)
      (cell @b))
    (group
      (cell @c))
    (feed (@a @b @c) @x)
    (cell @x ("foo" "bar" "baz")))
  end)

;; Module
(group
  (rack
    (frame
      (cell @a)
      (module {@b: @a}
        (cell @a 100)
        (feed @a @b)))
    (frame
      (cell @a 100)
      (module {@b: @a}
        (cell @a)
        (feed @a @b)))
    end)

  (rack
    (frame
      (module {:@x}
        (cell @x 100)
        (cell @y))
      (feed @x @y)
      (cell @y))
    (frame
      (module {:@x}
        (cell @x)
        (cell @y))
      (feed @x @y)
      (cell @y 100))
    end)

  (rack
    (frame
      (module {:@x}
        (cell @x 100)
        (feed @x @y)
        (cell @y))
      (cell @y))
    (frame
      (module {:@x}
        (cell @x)
        (feed @x @y)
        (cell @y 100))
      (cell @y))
    end))

;; locals
(rack
  (frame
    (cell @x 100)
    (cell @y)
    (feed @x @z)
    (discard @y)
    (locals (@x)
      (cell @x 200)
      (feed @x @y)
      (cell @z)))
  (frame
    (cell @x)
    (cell @y 200)
    (feed @x @z)
    (discard @y)
    (locals (@x)
      (cell @x)
      (feed @x @y)
      (cell @z 100)))
  (frame
    (cell @x)
    (cell @y)
    (feed @x @z)
    (discard @y)
    (locals (@x)
      (cell @x)
      (feed @x @y)
      (cell @z 100)))
  end)

;; Queue
(group
  ;; Basic
  (rack
    (frame
      (cell @0 300)
      (cell @1 200)
      (cell @2 100)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    (frame
      (cell @0 300)
      (cell @1 200)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) (100))
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    (frame
      (cell @0 300)
      (cell @1)
      (cell @2 200)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview 100)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1 300)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) (200))
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1)
      (cell @2 300)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview 200)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) (300))
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview 300)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    end)

  ;; Queue should not enqueue if destination is occupied -- this is the basic
  ;; principle behind emergent backpressure (something similar can be said about
  ;; feed + cell).
  (rack
    (frame
      (cell @0 x)
      (cell @1 y)
      (feed @0 @1 @back)
      (queue (@front @back) ())
      (feed @front @occupied)
      (cell @occupied "Busy!"))
    (frame
      (cell @0 x)
      (cell @1)
      (feed @0 @1 @back)
      (queue (@front @back) (y))
      (feed @front @occupied)
      (cell @occupied "Busy!"))
    (frame
      (cell @0)
      (cell @1 x)
      (feed @0 @1 @back)
      (queue (@front @back) (y))
      (feed @front @occupied)
      (cell @occupied "Busy!"))
    (frame
      (cell @0)
      (cell @1)
      (feed @0 @1 @back)
      (queue (@front @back) (y x))
      (feed @front @occupied)
      (cell @occupied "Busy!"))
    end)

  ;; Queue circulate one value.
  (rack
    (frame
      (queue (@front @back) (100))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) ())
      (feed @front @mid)
      (cell @mid 100)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) ())
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 200)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) ())
      (feed @front @mid)
      (cell @mid 200)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) ())
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 400)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (400))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back)))
    ;; ...

  ;; Queue circulate many values.
  (rack
    (frame
      (queue (@front @back) (100 200 300))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200 300))
      (feed @front @mid)
      (cell @mid 100)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200 300))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 200)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (300 200))
      (feed @front @mid)
      (cell @mid 200)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) (300 200))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 400)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200 400))
      (feed @front @mid)
      (cell @mid 300)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200 400))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 600)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (400 600))
      (feed @front @mid)
      (cell @mid 200)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back)))
    ;; ...

  ;; Feedback deactivates since input & output collide
  (rack
    (frame (queue (@a @a) (100 200 300)))
    end)

  ;; max: N
  (rack
    (frame
      (queue (@front0 @back0) (100 200 300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3) ()))
    (frame
      (queue (@front0 @back0) (200 300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3) (100)))
    (frame
      (queue (@front0 @back0) (300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3) (100 200)))
    (frame
      (queue (@front0 @back0) (400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3) (100 200 300)))
    end)

  ;; queue min: N
  (rack
    (frame
      (queue (@front0 @back0) (1 2 3 4 5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) ())
      (discard @front1))
    (frame
      (queue (@front0 @back0) (2 3 4 5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (1))
      (discard @front1))
    (frame
      (queue (@front0 @back0) (3 4 5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (1 2))
      (discard @front1))
    (frame
      (queue (@front0 @back0) (4 5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (2 3))
      (discard @front1))
    (frame
      (queue (@front0 @back0) (5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (3 4))
      (discard @front1))
    (frame
      (queue (@front0 @back0) ())
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (4 5))
      (discard @front1))
    (frame
      (queue (@front0 @back0) ())
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (5))
      (discard @front1))
    end)

  ;; queue max: 0
  (rack
    (frame
      (queue (@front0 @back0) (100 200 300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 0) ()))
    end)

  ;; queue max: 3.14
  (rack
    (frame
      (queue (@front0 @back0) (100 200 300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3.14) ()))
    end)

  ;; queue min: N max: M [cascade, backpressure]
  (rack
    (frame
      (cell (@in [in_ _*]) (a b c d e f g h id: in))
      (feed @in @x')
      (queue (@x @x' min: 3) (id: x))
      (feed @x @y')
      (queue (@y @y' min: 2 max: 4) (id: y))
      (feed @y @z')
      (queue (@z @z' max: 1) (id: z))
      (feed @z @trash)
      (delay 12 (cell @trash))
      (discard @trash))
    (frame pattern: true
      ⟪(b c d e f g h ¦ id: in)
       (a ¦ id: x)
       (¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(c d e f g h ¦ id: in)
       (a b ¦ id: x)
       (¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(d e f g h ¦ id: in)
       (a b c ¦ id: x)
       (¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(e f g h ¦ id: in)
       (b c d ¦ id: x)
       (a ¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(f g h ¦ id: in)
       (c d e ¦ id: x)
       (a b ¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(g h ¦ id: in)
       (d e f ¦ id: x)
       (b c ¦ id: y)
       (a ¦ id: z)⟫)
    (frame pattern: true
      ⟪(h ¦ id: in)
       (e f g ¦ id: x)
       (b c d ¦ id: y)
       (a ¦ id: z)⟫)
    (frame pattern: true
      ⟪(¦ id: in)
       (f g h ¦ id: x)
       (b c d e ¦ id: y)
       (a ¦ id: z)⟫)
    ;; The queues maintain backpressure until the counter runs out
    ;; and "opens the dam".
    (frame pattern: true
      ⟪(delay 3 (cell @trash))⟫)
    (frame pattern: true
      ⟪(delay 2 (cell @trash))⟫)
    (frame pattern: true
      ⟪(¦ id: in)
       (f g h ¦ id: x)
       (b c d e ¦ id: y)
       (a ¦ id: z)
       (delay 1 (cell @trash))⟫)
    (frame pattern: true
      ⟪(f g h ¦ id: x)
       (b c d e ¦ id: y)
       (a ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(f g h ¦ id: x)
       (b c d e ¦ id: y)
       (¦ id: z)
       (cell @trash a)⟫)
    (frame pattern: true
      ⟪(f g h ¦ id: x)
       (c d e ¦ id: y)
       (b ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(g h ¦ id: x)
       (c d e f ¦ id: y)
       (¦ id: z)
       (cell @trash b)⟫)
    (frame pattern: true
      ⟪(d e f ¦ id: y)
       (c ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(d e f ¦ id: y)
       (¦ id: z)
       (cell @trash c)⟫)
    (frame pattern: true
      ⟪(e f ¦ id: y)
       (d ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(e f ¦ id: y)
       (¦ id: z)
       (cell @trash d)⟫)
    (frame pattern: true
      ⟪(f ¦ id: y)
       (e ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(f ¦ id: y)
       (¦ id: z)
       (cell @trash e)⟫)
    (frame pattern: true
      ⟪(g h ¦ id: x) ;; < x is nonempty because its min: 3, it can't dequeue yet, too few items!
       (f ¦ id: y) ;; < ditto for y, it's waiting for more items because it's min: 2
       (¦ id: z)
       (cell @trash)⟫)
    end))

;; Transfer
(group
  ;; Basic
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s))
    (frame
      (cell @x)
      (cell @y)
      (transfer ((@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s 3))
    end)

  ;; Inhibitor absent
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s))
    (frame
      (cell @x)
      (cell @y)
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s 3))
    end)

  ;; Inhibitor empty
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (cell @qux)
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s))
    (frame
      (cell @x)
      (cell @y)
      (cell @qux)
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s 3))
    end)

  ;; Inhibitor present
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (cell @qux "foobar")
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s))
    end)

  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((not @foo @bar) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s)

      (cell @foo 1)
      (cell @bar)
      (cell @baz)
      (feed @foo @bar @baz))

    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((not @foo @bar) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s)

      (cell @foo)
      (cell @bar 1)
      (cell @baz)
      (feed @foo @bar @baz))

    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((not @foo @bar) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s)

      (cell @foo)
      (cell @bar)
      (cell @baz 1)
      (feed @foo @bar @baz))

    (frame
      (cell @x)
      (cell @y)
      (transfer ((not @foo @bar) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s 3)

      (cell @foo)
      (cell @bar)
      (cell @baz 1)
      (feed @foo @bar @baz))))

;; Backsys
(group
  ;; Basic
  (rack
    (frame
      (cell @world (a b c))
      (backsys @world
        (front_ _* `back) <> {(front): (), back: ^front}))
    (frame
      (cell @world (b c a))
      (backsys @world
        (front_ _* `back) <> {(front): (), back: ^front}))
    (frame
      (cell @world (c a b))
      (backsys @world
        (front_ _* `back) <> {(front): (), back: ^front}))
    (frame
      (cell @world (a b c))
      (backsys @world
        (front_ _* `back) <> {(front): (), back: ^front})))
    ;; ...

  ;; Source cell empty must deactivate backsys.
  (rack
    (frame
      (cell @x 100)
      (cell @y)
      (backsys (@x @y)
        (x_ y_) <> {y: ^x, x: ^y}))
    end)
  (rack
    (frame
      (cell @x 100)
      (cell @y 200)
      (backsys (@x @y)
        (x_ y_) <> {y: ^x, x: ^y}))
    (frame
      (cell @x 200)
      (cell @y 100)
      (backsys (@x @y)
        (x_ y_) <> {y: ^x, x: ^y})))
    ;; ...

  ;; Write to an absent resource cell is a noop
  (rack
    (frame
      (cell @x 100)
      (backsys {@:x @:y}
        {¦ x_ -y_} <> {y: ^x}))
    end)

  ;; Increment one
  (rack
    (frame
      (cell @x 100)
      (backsys @x
        ±N <> {N: ^(+ N 1)}))
    (frame
      (cell @x 101)
      (backsys @x
        ±N <> {N: ^(+ N 1)}))
    (frame
      (cell @x 102)
      (backsys @x
        ±N <> {N: ^(+ N 1)})))
    ;; ...

  ;; Increment many, same rule
  (rack
    (frame
      (cell @x 100)
      (cell @y 200)
      (backsys (@x @y)
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)}))
    (frame
      (cell @x 101)
      (cell @y 201)
      (backsys (@x @y)
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)}))
    (frame
      (cell @x 102)
      (cell @y 202)
      (backsys (@x @y)
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)})))
    ;; ...

  ;; Increment many, different rules
  (rack
    (frame
      (cell @x 100)
      (cell @y 200)
      (backsys (@x @y)
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)}))
    (frame
      (cell @x 101)
      (cell @y 201)
      (backsys (@x @y)
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)}))
    (frame
      (cell @x 102)
      (cell @y 202)
      (backsys (@x @y)
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)})))
    ;; ...

  ;; Increment parts of one, same rule
  (rack
    (frame
      (cell @x (100 200))
      (backsys @x
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)}))
    (frame
      (cell @x (101 201))
      (backsys @x
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)}))
    (frame
      (cell @x (102 202))
      (backsys @x
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)})))
    ;; ...

  ;; Increment parts of one, different rules
  (rack
    (frame
      (cell @x (100 200))
      (backsys @x
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)}))
    (frame
      (cell @x (101 201))
      (backsys @x
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)}))
    (frame
      (cell @x (102 202))
      (backsys @x
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)})))
    ;; ...

  ;; Increment-swap parts of many, same rule
  (rack
    (frame
      (cell @x ((100) 200))
      (cell @y ((300) 400))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1), M: ^(+ N 1)}))
    (frame
      (cell @x ((401) 200))
      (cell @y ((300) 101))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1), M: ^(+ N 1)}))
    (frame
      (cell @x ((102) 200))
      (cell @y ((300) 402))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1), M: ^(+ N 1)})))
    ;; ...

  ;; Increment-swap parts of many, different rules
  (rack
    (frame
      (cell @x ((100) 200))
      (cell @y ((300) 400))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1)}
        (((±N) _) (_ ±M)) <> {M: ^(+ N 1)}))
    (frame
      (cell @x ((401) 200))
      (cell @y ((300) 101))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1)}
        (((±N) _) (_ ±M)) <> {M: ^(+ N 1)}))
    (frame
      (cell @x ((102) 200))
      (cell @y ((300) 402))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1)}
        (((±N) _) (_ ±M)) <> {M: ^(+ N 1)})))

  ;; Simple conflict
  (rack
    (frame
      (cell @x ((100) 200))
      (backsys (@x)
        (((±N) _)) <> {N: ^(+ N 1)}
        ((X_ _)) <> {X: qux}))
    (frame
      (cell @x (qux 200)) ;; < Qux wins because its modification is the shallowest.
      (backsys (@x)
        (((±N) _)) <> {N: ^(+ N 1)}
        ((X_ _)) <> {X: qux}))
    end)

  ;; Basic insertion
  (rack
    (frame
      (cell @x (a b c))
      (backsys (@x)
        ((`front _*)) <> {front: "First rule"}
        ((_* `back)) <> {back: "Second rule"}
        (⟨_* `slot … b … _*⟩) <> {slot: "Slot before b"}))
    (frame
      (cell @x ("First rule" a "Slot before b" b c "Second rule"))
      (backsys (@x)
        ((`front _*)) <> {front: "First rule"}
        ((_* `back)) <> {back: "Second rule"}
        (⟨_* `slot … b … _*⟩) <> {slot: "Slot before b"}))
    (frame
      (cell @x ("First rule" "First rule" a "Slot before b" "Slot before b" b c "Second rule" "Second rule"))
      (backsys (@x)
        ((`front _*)) <> {front: "First rule"}
        ((_* `back)) <> {back: "Second rule"}
        (⟨_* `slot … b … _*⟩) <> {slot: "Slot before b"})))
    ;; ...

  ;; Basic deletion
  (rack
    ;; First rule marks even
    ;; Second rule removes odd
    (frame
      (cell @x (a 1 2 b 3 4 c d 5 e 6 7 f 8 g h 9 i 10 11 12 j k l))
      (backsys @x
        ⟨n←(%pipe (mod 2) 0)⟩° <> {n: (seen ^n)}
        ⟨n←(%pipe (mod 2) (%not 0))⟩° <> {(n): ()}))
    (frame
      (cell @x (a (seen 2) b (seen 4) c d e (seen 6) f (seen 8) g h i (seen 10) (seen 12) j k l))
      (backsys @x
        ⟨n←(%pipe (mod 2) 0)⟩° <> {n: (seen ^n)}
        ⟨n←(%pipe (mod 2) (%not 0))⟩° <> {(n): ()}))
    end)

  (rack
    ;; First rule removes even
    ;; Second rule removes odd
    (frame
      (cell @x (a 1 2 b 3 4 c d 5 e 6 7 f 8 g h 9 i 10 11 12 j k l))
      (backsys @x
        ⟨n←(%pipe (mod 2) 0)⟩° <> {(n): ()}
        ⟨n←(%pipe (mod 2) (%not 0))⟩° <> {(n): ()}))
    (frame
      (cell @x (a b c d e f g h i j k l))
      (backsys @x
        ⟨n←(%pipe (mod 2) 0)⟩° <> {(n): ()}
        ⟨n←(%pipe (mod 2) (%not 0))⟩° <> {(n): ()}))
    end)

  ;; With resource
  (rack
    (frame
      (cell @world (a b c))
      (queue (@x @x') (100 200 300))
      (backsys (@world @:x)
        ((front_ _* `back) ⍊ x_) <> {(front): (), back: (^front ^x), (x): ()}))
    (frame
      (cell @world (b c (a 100)))
      (queue (@x @x') (200 300))
      (backsys (@world @:x)
        ((front_ _* `back) ⍊ x_) <> {(front): (), back: (^front ^x), (x): ()}))
    (frame
      (cell @world (c (a 100) (b 200)))
      (queue (@x @x') (300))
      (backsys (@world @:x)
        ((front_ _* `back) ⍊ x_) <> {(front): (), back: (^front ^x), (x): ()}))
    (frame
      (cell @world ((a 100) (b 200) (c 300)))
      (queue (@x @x') ())
      (backsys (@world @:x)
        ((front_ _* `back) ⍊ x_) <> {(front): (), back: (^front ^x), (x): ()}))
    end)

  ;; With many resources, initially unset: "peel from front and back"
  (rack
    (frame
      (cell @world (a b c d e f))
      (cell @x)
      (cell @y)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world (b c d e))
      (cell @x a)
      (cell @y f)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world (b c d e))
      (cell @x)
      (cell @y)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world (c d))
      (cell @x b)
      (cell @y e)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world (c d))
      (cell @x)
      (cell @y)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world ())
      (cell @x c)
      (cell @y d)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world ())
      (cell @x)
      (cell @y)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    end)


  ;; backsys: insertions and deletions
  (rack
    ;; l's move left
    ;; r's move right
    ;; . represents an empty spot
    ;; r collides with l, bounce, a wall with durability `(I ±D)` appears.
    ;; l, r reflect off bounds and walls
    ;; walls lose durability when someone hits them
    ;; walls break when their durability is zero
    (frame
      (cell @x (r . . . l))
      (backsys @x
        ⟨a←. b←l⟩° <> {a: ^b, b: ^a}
        ⟨a←r b←.⟩° <> {a: ^b, b: ^a}
        ⟨a←r b←l⟩ <> {a: l, (b): ((I 3) r)}
        (a←l _*) <> {a: r}
        (_* a←r) <> {a: l}
        ⟨_* a←r … (I D←(%number _ > 0)) … _*⟩° <> {a: l, D: ^(- D 1)}
        ⟨_* … (I D←(%number _ > 0)) … a←l _*⟩° <> {a: r, D: ^(- D 1)}
        ⟨W←(I 0)⟩° <> {(W): ()}))
    (frame pattern: true
      ⟨(cell @x (. r . l .))⟩)
    (frame pattern: true
      ⟨(cell @x (. . r l .))⟩) ;; r wins because its rule is defined later
    (frame pattern: true
      ⟨(cell @x (. . l (I 3) r .))⟩)
    (frame pattern: true
      ⟨(cell @x (. l . (I 3) . r))⟩)
    (frame pattern: true
      ⟨(cell @x (l . . (I 3) . l))⟩)
    (frame pattern: true
      ⟨(cell @x (r . . (I 3) l .))⟩)
    (frame pattern: true
      ⟨(cell @x (. r . (I 2) r .))⟩)
    (frame pattern: true
      ⟨(cell @x (. . r (I 2) . r))⟩)
    (frame pattern: true
      ⟨(cell @x (. . l (I 1) . l))⟩)
    (frame pattern: true
      ⟨(cell @x (. l . (I 1) l .))⟩)
    (frame pattern: true
      ⟨(cell @x (l . . (I 0) r .))⟩)
    (frame pattern: true
      ⟨(cell @x (r . . . r))⟩)
    (frame pattern: true
      ⟨(cell @x (. r . . l))⟩)
    (frame pattern: true
      ⟨(cell @x (. . r l .))⟩))
    ;; ...


  ;; backsys: pyramidal (bottom-up-bottom, presentational, triangular, whatever)
  ;; feedback essentials with circuit
  (rack
    (frame
      (circuit @x
        (group
          (module {}
            (cell @sum 1 output: true)
            (cell @view0 input: true)
            (extension (@view0 v_ @sum) ^(sum v)))
          (module {}
            (cell @product 1 output: true)
            (cell @view1 input: true)
            (extension (@view1 v_ @product) ^(product v)))))
      (backsys (@x)
        ((%all (%leaves (%flat (_ n) ns_) (cell @_ ±n ⍊ output))
                ⟪(cell @_ (%group dst_ _?) ⍊ input)⟫°))
          <> {dst: ^ns}))
    (frame pattern: true
      ⟪[cell @sum 2]
       [cell @view0 (1 1)]
       [cell @product 1]
       [cell @view1 (1 1)]⟫)
    (frame pattern: true
      ⟪[cell @sum 3]
       [cell @view0 (2 1)]
       [cell @product 2]
       [cell @view1 (2 1)]⟫)
    (frame pattern: true
      ⟪[cell @sum 5]
       [cell @view0 (3 2)]
       [cell @product 6]
       [cell @view1 (3 2)]⟫)
    (frame pattern: true
      ⟪[cell @sum 11]
       [cell @view0 (5 6)]
       [cell @product 30]
       [cell @view1 (5 6)]⟫)
    (frame pattern: true
      ⟪[cell @sum 41]
       [cell @view0 (11 30)]
       [cell @product 330]
       [cell @view1 (11 30)]⟫))
    ;; ...

  ;; Edge inference shorthand
  (rack
    (frame
      (backsys
        {¦ ±x} <> {x: ^(+ x 1)}
        {¦ ±y} <> {y: ^(- y 1)})
      (cell @x 0)
      (cell @y 0))
    (frame/tail
      (cell @x 1)
      (cell @y -1))
    (frame/tail
      (cell @x 2)
      (cell @y -2)))
    ;; ...

  (rack
    (frame
      (backsys
        {| ±x ±y} <> {x: ^(+ x y), (y): ()}) ;; |
      (cell @x 100)
      (cell @y 200))
    (frame/tail
      (cell @x 300)
      (cell @y))
    end))

;; Circuit
(group
  ;; BUG: Circuits at the same depth must not see each other (proper scoping)
  (rack
    (frame
      (circuit @0 (cell @x 100))
      (circuit @1 (cell @y))
      (circuit @2 (feed @x @y)))
    end)

  ;; Basic
  (rack
    (frame
      (cell @a
        ((cell @x 0)
         (feed @x @y)
         (cell @y)))
      (cell @b)
      (feed (copy @a) @b)
      (feed (@a @b) (@foo @bar))
      (circuit @foo)
      (circuit @bar))
    (frame
      (cell @a
        ((cell @x 0)
         (feed @x @y)
         (cell @y)))
      (cell @b
        ((cell @x 0)
         (feed @x @y)
         (cell @y)))
      (feed (copy @a) @b)
      (feed (@a @b) (@foo @bar))
      (circuit @foo)
      (circuit @bar))
    (frame
      (cell @a)
      (cell @b)
      (feed (copy @a) @b)
      (feed (@a @b) (@foo @bar))
      (circuit @foo
        (cell @x)
        (feed @x @y)
        (cell @y 0))
      (circuit @bar
        (cell @x)
        (feed @x @y)
        (cell @y 0)))
    end)

  ;; An observer can make decisions based on its children and feed them back.
  (rack
    (frame
      (circuit @x
        (cell @src 100)
        (extension (@src ±n @voice0) ^(+ n 2))
        (extension (@src ±n @voice1) ^(* n 2))
        (cell @voice0)
        (cell @voice1))
      (backsys @x
        ⟨& (cell @src n_) (cell @voice0 a_) (cell @voice1 b_)⟩
          <> {n: ^(+ a b)}))
    (frame pattern: true
      ⟪[cell @src 100]
       [cell @voice0 102]
       [cell @voice1 200]⟫)
    (frame pattern: true
      ⟪[cell @src 302]
       [cell @voice0 304]
       [cell @voice1 604]⟫)
    (frame pattern: true
      ⟪[cell @src 908]
       [cell @voice0 910]
       [cell @voice1 1816]⟫))
    ;; ...

  ;; Nested (observed) nodes are evaluated once per tick.
  (rack
    (frame
      (delay 3 "Foo")
      (circuit @x
        (delay 2 "Bar")
        (delay 5 "Baz")
        (circuit @y
          (delay 3 "boo"))))
    (frame
      (delay 2 "Foo")
      (circuit @x
        (delay 1 "Bar")
        (delay 4 "Baz")
        (circuit @y
          (delay 2 "boo"))))
    (frame
      (delay 1 "Foo")
      (circuit @x
        "Bar"
        (delay 3 "Baz")
        (circuit @y
          (delay 1 "boo"))))
    (frame
      "Foo"
      (circuit @x
        "Bar"
        (delay 2 "Baz")
        (circuit @y
          "boo")))
    (frame
      "Foo"
      (circuit @x
        "Bar"
        (delay 1 "Baz")
        (circuit @y
          "boo")))
    (frame
      "Foo"
      (circuit @x
        "Bar"
        "Baz"
        (circuit @y
          "boo"))))

  ;; Ditto
  (rack
    (frame
      (delay 3 "Foo")
      (cell @x-view)
      (feed (copy @x) (atop @x-view))
      (circuit @x
        (delay 3 "Bar")
        (cell @y-view)
        (feed (copy @y) (atop @y-view))
        (circuit @y (delay 3 "Baz"))))
    (frame
      (delay 2 "Foo")
      (cell @x-view
        ((delay 3 "Bar")
         (cell @y-view)
         (feed (copy @y) (atop @y-view))
         (circuit @y (delay 3 "Baz"))))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        (delay 2 "Bar")
        (cell @y-view ((delay 3 "Baz")))
        (feed (copy @y) (atop @y-view))
        (circuit @y (delay 2 "Baz"))))
    (frame
      (delay 1 "Foo")
      (cell @x-view
        ((delay 2 "Bar")
         (cell @y-view ((delay 3 "Baz")))
         (feed (copy @y) (atop @y-view))
         (circuit @y (delay 2 "Baz"))))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        (delay 1 "Bar")
        (cell @y-view ((delay 2 "Baz")))
        (feed (copy @y) (atop @y-view))
        (circuit @y (delay 1 "Baz"))))
    (frame
      "Foo"
      (cell @x-view
        ((delay 1 "Bar")
         (cell @y-view ((delay 2 "Baz")))
         (feed (copy @y) (atop @y-view))
         (circuit @y (delay 1 "Baz"))))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        "Bar"
        (cell @y-view ((delay 1 "Baz")))
        (feed (copy @y) (atop @y-view))
        (circuit @y "Baz")))
    (frame
      "Foo"
      (cell @x-view
        ("Bar"
         (cell @y-view ((delay 1 "Baz")))
         (feed (copy @y) (atop @y-view))
         (circuit @y "Baz")))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        "Bar"
        (cell @y-view ("Baz"))
        (feed (copy @y) (atop @y-view))
        (circuit @y "Baz")))
    (frame
      "Foo"
      (cell @x-view
        ("Bar"
         (cell @y-view ("Baz"))
         (feed (copy @y) (atop @y-view))
         (circuit @y "Baz")))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        "Bar"
        (cell @y-view ("Baz"))
        (feed (copy @y) (atop @y-view))
        (circuit @y "Baz")))
    end))

;; Filtered circuit
(group
  ;; Make sure setting works, also not susceptible to injection.
  (rack
    (frame
      (circuit (@snd (fst_ snd_ _*))
        1 2 3 4 5 6)
      (cell @x qux)
      (extension (@x x_ @snd) (seen ^x ^^fst ^^snd)))
    (frame
      (circuit (@snd (fst_ snd_ _*))
        1 (seen qux ^fst ^snd) 3 4 5 6)
      (cell @x qux)
      (extension (@x x_ @snd) (seen ^x ^^fst ^^snd)))
    end)

  ;; Basic
  (rack
    (frame
      (circuit (@x ⟪(cell @_ `x ⍊ x)⟫)
        (group
          (cell @x x: true)
          (cell @y)
          (feed @x @y)))
      (cell @in "Hello World")
      (feed @in @x))
    (frame
      (circuit (@x ⟪(cell @_ `x ⍊ x)⟫)
        (group
          ;; NOTE: Parent + child eval are compressed into one tick here.
          ;; Parent evals first. So it first puts @x. Child evals next.
          ;; So it moves @x -> @y.
          (cell @x x: true)
          (cell @y "Hello World")
          (feed @x @y)))
      (cell @in)
      (feed @in @x))
    end)

  ;; Queue using filtered circuit
  (rack
    (frame
      (circuit (@front (front_ _*))
        a b c)
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*))
        b c)
      (feed @front @foo)
      (cell @foo a)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*))
        b c)
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar a)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*))
        c)
      (feed @front @foo)
      (cell @foo b)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*))
        c)
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar b)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*)))
      (feed @front @foo)
      (cell @foo c)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*)))
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar c)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*)))
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    end))

;; node
(rack
  (frame
    (cell @foo (delay 2 (p "Hi")))
    (feed @foo @view)
    (node @view))
  (frame
    (cell @foo)
    (feed @foo @view)
    (node @view (delay 1 (p "Hi"))))
  (frame
    (cell @foo)
    (feed @foo @view)
    (node @view (p "Hi")))
  end)

;; Filtered cell
(group
  ;; Basic
  (rack
    (frame
      (cell (@snd (_ snd_ _*)) (1 2 3 4 5 6))
      (feed @snd @back)
      (queue (@front @back) ()))
    (frame
      (cell (@snd (_ snd_ _*)) (1 3 4 5 6))
      (feed @snd @back)
      (queue (@front @back) (2)))
    (frame
      (cell (@snd (_ snd_ _*)) (1 4 5 6))
      (feed @snd @back)
      (queue (@front @back) (2 3)))
    (frame
      (cell (@snd (_ snd_ _*)) (1 5 6))
      (feed @snd @back)
      (queue (@front @back) (2 3 4)))
    (frame
      (cell (@snd (_ snd_ _*)) (1 6))
      (feed @snd @back)
      (queue (@front @back) (2 3 4 5)))
    (frame
      (cell (@snd (_ snd_ _*)) (1))
      (feed @snd @back)
      (queue (@front @back) (2 3 4 5 6)))
    end)

  ;; Make sure setting works, also not susceptible to injection.
  (rack
    (frame
      (cell (@snd (fst_ snd_ _*)) (1 2 3 4 5 6))
      (cell @x qux)
      (extension (@x x_ @snd) (seen ^x ^^fst ^^snd)))
    (frame
      (cell (@snd (fst_ snd_ _*)) (1 (seen qux ^fst ^snd) 3 4 5 6))
      (cell @x qux)
      (extension (@x x_ @snd) (seen ^x ^^fst ^^snd)))
    end))

;; Frag
(group
  (rack
    (frame
      (cell @x 0)
      (frag @bridge-dst)
      (cell @y)
      (cell @bridge-src (feed @x @y))
      (feed @bridge-src @bridge-dst))
    (frame
      (cell @x 0)
      (frag @bridge-dst (feed @x @y))
      (cell @y)
      (cell @bridge-src)
      (feed @bridge-src @bridge-dst))
    (frame
      (cell @x)
      (frag @bridge-dst (feed @x @y))
      (cell @y 0)
      (cell @bridge-src)
      (feed @bridge-src @bridge-dst))
    end)

  ;; Erase
  (rack
    (frame
      (frag @x 100)
      (discard @x))
    (frame
      (frag @x)
      (discard @x))
    end)

  (rack
    (frame
      (view (@count ±n @y) ^"Count: ⸢n⸣")
      (backsys @x (cell _ ±n) <> {n: ^(+ n 1)})
      (frag @x (cell @count 0))
      (cell @y))
    (frame/tail
      (frag @x (cell @count 1))
      (cell @y "Count: 0"))
    (frame/tail
      (frag @x (cell @count 2))
      (cell @y "Count: 1"))
    (frame/tail
      (frag @x (cell @count 3))
      (cell @y "Count: 2")))
    ;; ...

  ;; Self-reference
  (rack
    (frame
      (frag @x
        (group
          (cell @count 0)
          (backsys @x
            ⟨(cell @count ±n)⟩ <> {n: ^(+ n 1)})))
      (view (@count ±n @y) ^"Count: ⸢n⸣")
      (cell @y))
    (frame
      (frag @x
        (group
          (cell @count 1)
          (backsys @x
            ⟨(cell @count ±n)⟩ <> {n: ^(+ n 1)})))
      (view (@count ±n @y) ^"Count: ⸢n⸣")
      (cell @y "Count: 0"))
    (frame
      (frag @x
        (group
          (cell @count 2)
          (backsys @x
            ⟨(cell @count ±n)⟩ <> {n: ^(+ n 1)})))
      (view (@count ±n @y) ^"Count: ⸢n⸣")
      (cell @y "Count: 1")))
    ;; ...

  ;; Recursion
  ;; TODO: We need to limit this (depth limit) and test that it terminates at some point.
  (rack
    (frame
      (frag @current
        (module {@parent: @current}
          (feed (copy @parent) @current)
          (frag @current))))
    (frame
      (frag @current
        (module {@parent: @current}
          (feed (copy @parent) @current)
          (frag @current
            (module {@parent: @current}
              (feed (copy @parent) @current)
              (frag @current))))))
    (frame
      (frag @current
        (module {@parent: @current}
          (feed (copy @parent) @current)
          (frag @current
            (module {@parent: @current}
              (feed (copy @parent) @current)
              (frag @current
                (module {@parent: @current}
                  (feed (copy @parent) @current)
                  (frag @current)))))))))
    ;; ...

  ;; Legacy
  (rack
    (frame
      (cell @x (delay 3 (feed @a @b)))
      (feed @x @y)
      (frag @y)
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (delay 3 (feed @a @b)))
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (delay 2 (feed @a @b)))
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (delay 1 (feed @a @b)))
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (feed @a @b))
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (feed @a @b))
      (cell @a)
      (cell @b 100))
    end))

;; extension
(group
  ;; Many sources, dst pattern `_`
  (rack
    (frame
      (cell @x 1)
      (queue (@y @y') (2 3 4))
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s 0))
    (frame
      (cell @x 1)
      (queue (@y @y') (3 4))
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s 3))
    (frame
      (cell @x 1)
      (queue (@y @y') (4))
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s 4))
    (frame
      (cell @x 1)
      (queue (@y @y') ())
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s 5))
    end)

  ;; Ditto, dst unset
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s))
    (frame
      (cell @x 1)
      (cell @y)
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s))
    end)

  ;; No dst pattern
  (rack
    (frame
      (cell @x 2)
      (queue (@y @y') (2 3 4))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s)
      (feed (@s @y) (@y' @trash))
      (cell @trash)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (2 3 4))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s 4)
      (feed (@s @y) (@y' @trash))
      (cell @trash)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (3 4 4))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s)
      (feed (@s @y) (@y' @trash))
      (cell @trash 2)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (3 4 4))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s 6)
      (feed (@s @y) (@y' @trash))
      (cell @trash)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (4 4 6))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s)
      (feed (@s @y) (@y' @trash))
      (cell @trash 3)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (4 4 6))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s 8)
      (feed (@s @y) (@y' @trash))
      (cell @trash)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (4 6 8))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s)
      (feed (@s @y) (@y' @trash))
      (cell @trash 4)
      (discard @trash)))
    ;; ...

  ;; Shorthand variant for one input, no dst pattern
  (rack
    (frame
      (queue (@x @x') (1 2 3))
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y))
    (frame
      (queue (@x @x') (2 3))
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y 2))
    (frame
      (queue (@x @x') (3))
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y 4))
    (frame
      (queue (@x @x') ())
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y 6))
    (frame
      (queue (@x @x') ())
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y))
    end)

  ;; Dst pattern constraint spans across to the source pattern
  (rack
    (frame
      (module {}
        (cell @x x)
        (extension (@x k_ @y (%value k v_string)) ^v)
        (cell @y {x: 10, a: "John", b: "Samantha", z: "David"}))
      (module {}
        (cell @x b)
        (extension (@x k_ @y (%value k v_string)) ^v)
        (cell @y {x: 10, a: "John", b: "Samantha", z: "David"})))
    (frame
      (module {}
        (cell @x x)
        (extension (@x k_ @y (%value k v_string)) ^v)
        (cell @y {x: 10, a: "John", b: "Samantha", z: "David"}))
      (module {}
        (cell @x b)
        (extension (@x k_ @y (%value k v_string)) ^v)
        (cell @y "Samantha")))
    end)

  ;; Extension semantics
  (rack
    (frame
      (cell @x "hi")
      (extension (@x x_string @view)
        (foo ^x flag: true))
      (cell @view)
      (backsys @view  {¦ flag -seen_} <> {seen: true}))
    (frame
      (cell @x "hi")
      (extension (@x x_string @view)
        (foo ^x flag: true))
      (cell @view (foo "hi" flag: true))
      (backsys @view  {¦ flag -seen_} <> {seen: true}))
    (frame
      (cell @x "hi")
      (extension (@x x_string @view)
        (foo ^x flag: true))
      (cell @view (foo "hi" flag: true seen: true))
      (backsys @view  {¦ flag -seen_} <> {seen: true}))
    end))

;; Extension
(group
  ;; Extension of N cells (ok)
  (rack
    (frame
      (cell @x 100)
      (cell @y 200)
      (extension ((@x @y) values_ @z) ^values)
      (cell @z))
    (frame
      (cell @x 100)
      (cell @y 200)
      (extension ((@x @y) values_ @z) ^values)
      (cell @z (100 200)))
    end)

  ;; Extension of N cells (missing)
  (rack
    (frame
      (cell @x 100)
      (cell @y)
      (extension ((@x @y) values_ @z) ^values)
      (cell @z))
    end)

  ;; Extension of N cells (delay, queue, mismatch)
  (rack
    (frame
      (queue (@command @back) (greet welcome greet))
      (delay 2 (discard @command))
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output))
    (frame
      (queue (@command @back) (greet welcome greet))
      (delay 1 (discard @command))
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) (greet welcome greet))
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) (welcome greet))
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) (greet))
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output))
    (frame
      (queue (@command @back) ())
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) ())
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output))
    end))

;; Elementary 1D movement circuit
(group
  ;; Basic
  (rack
    (frame
      (circuit @world
        .
        .
        (module {}
          (cell @id foo)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        .
        .
        .)
      (backsys @world
        W←⟨⟨[cell @world (%optional () w_)]⟩⟩°
          <> {w: ^(morph W (backmap ⟨M←⟨[cell @id id_]⟩⟩° {M: ^id}))}
        ⟨A_ B←⟨[cell @dir up]⟩⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}
        ⟨A←⟨[cell @dir dn]⟩ B_⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}))
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world M_dict . . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . M_dict . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . M_dict . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . M_dict . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . M_dict . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . M_dict .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . . M_dict]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . M_dict .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . M_dict . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . M_dict . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . M_dict . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . M_dict . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫))
    ;; ...

  ;; Multiple modules
  (rack
    (frame
      (circuit @world
        .
        .
        (module {}
          (cell @id foo)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        (module {}
          (cell @id bar)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        .)
      (backsys @world
        W←⟨⟨[cell @world (%optional () w_)]⟩⟩°
          <> {w: ^(morph W (backmap ⟨M←⟨[cell @id id_]⟩⟩° {M: ^id}))}
        ⟨A_ B←⟨[cell @dir up]⟩⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}
        ⟨A←⟨[cell @dir dn]⟩ B_⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}))
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ ⟨[cell @id bar]⟩ . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id bar]⟩ ⟨[cell @id foo]⟩ . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . . ⟨[cell @id bar]⟩ ⟨[cell @id foo]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . . ⟨[cell @id foo]⟩ ⟨[cell @id bar]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . .]⟫)))
    ;; ...

;; Elementary breakdown (regression test)
(rack
  (frame
    (cell @mouth
      (module {}
        (cell @name "John Doe")
        (cell @age 26)
        (cell @comment "It's pretty dark in here . . .")))
    (feed @mouth (@sack back))
    ;; Breakdown of arbitrary structure into particles (here, for demonstration
    ;; purposes, they are %atom's as per M1).
    (group
      (cell @sack ())
      (cell @particles ())
      (backsys {@:sack @:particles}
        {¦ sack: (particle←(%atom) _*) particles: (_* `atom)}
          <> {(particle): (), atom: ^particle}
        {¦ sack: (particle←(items_* ¦ pairs_) _*)}
          <> {(particle): (^*items ^*(entries pairs))})
      (feed (@particles front) @particle))
    ;; Breakdown of particles into strands of runes.
    (group
      (cell @particle)
      (transfer (@particle p_ @strand) ^(ml/display p)))
    ;; Breakdown of strands of runes into individual runes.
    (group
      (cell @strand)
      (backsys {@:strand @:rune}
        {¦ strand_: ""} <> {(strand): ()}
        {¦ strand_: (%string nonempty) -rune_}
          <> {rune: ^(rune strand 0), strand: ^(runes strand 1 ..= -1)}))
    ;; Breakdown of runes into chains of bases.
    (group
      (cell @rune)
      (transfer (@rune rune_string @base-chain)
        ^(repr (codepoints rune) '(digits alphabet: "ABCD"))))
    ;; Breakdown of chains of bases into bases.
    (group
      (cell @base-chain)
      (backsys {bases: @base-chain, @:base}
        {¦ bases_: ()} <> {(bases): ()}
        {¦ bases_: (B_string _*) -base_}
          <> {(B): (), base: ^B}))
    ;; Movement of bases into the base pool.
    (group
      (cell @base)
      (backsys {@:base @:pool}
        {¦ base_ pool_dict}
          <> {(base): (), pool: ^(mset/union pool (entry base 1))}))
    (cell @pool ()))
  (frame pattern: true fast-forward: true
    ⟨[cell @pool {"A": 56, "B": 132, "C": 96, "D": 50}]⟩)
  end)

;; Handling of disjoint and non-disjoint writes to the same location.
(group
  ;; Disjoint writes must all succeed.
  (rack
    (frame
      (cell @x {"A": 100, "B": 200, "C": 300})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)}))
    (frame
      (cell @x {"A": 99, "B": 400, "C": 301})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)}))
    (frame
      (cell @x {"A": 98, "B": 800, "C": 302})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)})))
    ;; ...

  ;; Insertions in the middle conflict with other write(s).
  ;;
  ;; NOTE: Here we see the unconditional suppression of insertion which
  ;; is supposed to be a deterministic, but not exactly human-
  ;; comprehensible choice.
  (rack
    (frame
      (cell @x (+ 1 2))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"}))
    (frame
      (cell @x (+ 2 3 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"}))
    (frame
      (cell @x (+ 3 4 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"})))
    ;; ...

  ;; We can "fix" conflicts like these with explicit staging. Rack
  ;; won't be able to do anything about them on its own, because the
  ;; conflicts above are, in a sense, as "pure" as conflicts go.
  (rack
    (frame
      (cell @x (+ 1 2))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 1 2 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊  qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 2 3 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 3 4 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))))
    ;; ...

;; part
(group
  ;; Chain of length 1
  (rack
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux (_ a_) _))
      (feed (copy @a) @b)
      (cell @b))
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux (_ a_) _))
      (feed (copy @a) @b)
      (cell @b 2))
    end)

  ;; Chain of length 2
  (rack
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view)
      (cell @b-view))
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view (1 2))
      (cell @b-view 2))
    end)

  ;; Chain of length 3
  (rack
    (frame
      (cell @top (qux (1 {name: "Samantha"}) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (part (@b @c) {¦ name: c_string})
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (feed (copy @c) @c-view)
      (cell @a-view)
      (cell @b-view)
      (cell @c-view))
    (frame
      (cell @top (qux (1 {name: "Samantha"}) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (part (@b @c) {¦ name: c_string})
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (feed (copy @c) @c-view)
      (cell @a-view (1 {name: "Samantha"}))
      (cell @b-view {name: "Samantha"})
      (cell @c-view "Samantha"))
    end)

  ;; Branching
  (rack
    (frame
      (cell @root
        {xs: (1 2 3), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}), responses: ()})
      (part (@root @xs) {¦ xs_})
      (part (@root @y) {¦ y_})
      (part (@root @zs) {¦ zs_})
      (part (@root @responses) {¦ responses_})
      (part (@xs @x) (x_ _*))
      (part (@zs @z) (z_ _*))
      (part (@z @a) {¦ a_})
      (part (@z @b) {¦ b_})
      (backsys {@:x @:y @:a @:b @:responses}
        {¦ ±x ±y ±a ±b responses: (_* `back)}
          <> {(x): (), back: {^:x ^:y ^:a ^:b}}))
    (frame pattern: true
      ⟪(cell @root
         {xs: (2 3), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}),
          responses: ({x: 1, y: 4, a: 5, b: 6})})⟫)
    (frame pattern: true
      ⟪(cell @root
         {xs: (3), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}),
          responses: ({x: 1, y: 4, a: 5, b: 6}
                      {x: 2, y: 4, a: 5, b: 6})})⟫)
    (frame pattern: true
      ⟪(cell @root
         {xs: (), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}),
          responses: ({x: 1, y: 4, a: 5, b: 6}
                      {x: 2, y: 4, a: 5, b: 6}
                      {x: 3, y: 4, a: 5, b: 6})})⟫)
    end)

  ;; Loop
  (rack
    (frame
      (cell @top (foo 0))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view)
      (cell @b-view))
    (frame
      (cell @top (foo 0))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view 0)
      (cell @b-view 0))
    end)

  ;; Loop with branch
  (rack
    (frame
      (cell @top (foo 0))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @c) c_)
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo 1))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @c) c_)
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo 2))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @c) c_)
      (backsys @c  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Loop with branches
  (rack
    (frame
      (cell @top (foo (10 20)))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @x) (x_ _))
      (part (@b @y) (_ y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo (11 21)))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @x) (x_ _))
      (part (@b @y) (_ y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo (12 22)))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @x) (x_ _))
      (part (@b @y) (_ y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Dyn mismatch manipulate
  (rack
    (frame
      (cell @top (foo 0 0))
      (part (@top @a) (foo a←(%number 3 <= _ <= 7) _))
      (part (@top @b) (foo _ b←(%number 7 <= _ <= 11)))
      (backsys {@:top @:a @:b}
        {¦ top: (foo ±n _) -a} <> {n: ^(+ n 1)}
        {¦ top: (foo _ ±n) -b} <> {n: ^(+ n 1)}))
    (frame pattern: true
      ⟪(foo 1 1)⟫)
    (frame pattern: true
      ⟪(foo 2 2)⟫)
    (frame pattern: true
      ⟪(foo 3 3)⟫)
    (frame pattern: true
      ⟪(foo 3 4)⟫)
    (frame pattern: true
      ⟪(foo 3 5)⟫)
    (frame pattern: true
      ⟪(foo 3 6)⟫)
    (frame pattern: true
      ⟪(foo 3 7)⟫)
    end)

  ;; Basic
  (rack
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @top (qux (2 2) (3 8)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @top (qux (3 2) (3 16)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(* n 2)})))
    ;; ...

  ;; Removal of item
  (rack
    (frame
      (cell @top (qux (1 2 3) (4 5 6)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst)
      (discard @dst))
    (frame
      (cell @top (qux (2 3) (4 5)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst (1 6))
      (discard @dst))
    (frame
      (cell @top (qux (2 3) (4 5)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst)
      (discard @dst))
    (frame
      (cell @top (qux (3) (4)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst (2 5))
      (discard @dst))
    (frame
      (cell @top (qux (3) (4)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst)
      (discard @dst))
    (frame
      (cell @top (qux () ()))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst (3 4))
      (discard @dst))
    (frame
      (cell @top (qux () ()))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst)
      (discard @dst))
    end)

  ;; Removal of pair
  (rack
    (frame
      (cell @top (qux 3 x: 100 y: 200 z: 300))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    (frame
      (cell @top (qux 2 x: 100 y: 200))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    (frame
      (cell @top (qux 1 x: 100))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    (frame
      (cell @top (qux 1))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    end)

  ;; Use with `feed...front`.
  ;;
  ;; NOTE: We're writing this in a very convoluted way with (module ...)
  ;; because besides confusing *you*, it may also confuse the engine. What
  ;; we're *really* to test here is the latter; we're trying to make sure
  ;; the engine is *not* confused.
  (rack
    (frame
      (queue (@mail @inbox) (a b c))
      (cell @top {name: "Samantha", mail: ()})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    (frame
      (queue (@mail @inbox) (b c))
      (cell @top {name: "Samantha", mail: (a)})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    (frame
      (queue (@mail @inbox) (c))
      (cell @top {name: "Samantha", mail: (b a)})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    (frame
      (queue (@mail @inbox) ())
      (cell @top {name: "Samantha", mail: (c b a)})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    end)

  ;; Scoping
  (rack
    (frame
      (module {}
        (cell @top (qux (1 2) (3 4)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (5 6) (7 8)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (9 10) (11 12)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)})))
    (frame
      (module {}
        (cell @top (qux (1 3) (3 4)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (5 7) (7 8)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (9 11) (11 12)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)})))
    (frame
      (module {}
        (cell @top (qux (1 4) (3 4)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (5 8) (7 8)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (9 12) (11 12)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))))
    ;; ...
  (rack
    (frame
      (cell @b (+ 1 2))
      (module {@a: @b}
        (part (@a @b) (+ _ b_))
        (backsys @b  ±n <> {n: ^(+ n 1)})))
    (frame
      (cell @b (+ 1 3))
      (module {@a: @b}
        (part (@a @b) (+ _ b_))
        (backsys @b  ±n <> {n: ^(+ n 1)})))
    (frame
      (cell @b (+ 1 4))
      (module {@a: @b}
        (part (@a @b) (+ _ b_))
        (backsys @b  ±n <> {n: ^(+ n 1)}))))
    ;; ...

  ;; Multiple roots in parallel
  (rack
    (frame
      (cell @r0 (+ 1 2))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 3 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    (frame
      (cell @r0 (+ 2 3))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 4 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    (frame
      (cell @r0 (+ 3 4))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 5 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    (frame
      (cell @r0 (+ 4 5))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 6 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    end)

  ;; Multiple roots in sequence
  (rack
    (frame
      (cell @r0 (+ (* 1 2) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1)
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 2) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 2))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 2) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 3))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 3) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 4))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 4) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 5))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a))))
    ;; ...

  ;; Parts hanging off duplicate roots are ignored
  (rack
    (frame
      (cell @x (+ 1 2))
      (cell @x (+ 3 4))
      (part (@x @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)}))
    end)

  ;; Parts writing into the same edge are ignored
  (rack
    (frame
      (cell @x (+ 1 2))
      (part (@x @a) (+ a_ _))
      (part (@x @a) (+ _ a_))
      (backsys @a  ±n <> {n: ^(+ n 1)}))
    end)

  ;; Conflicting write (same keypath)
  (rack
    (frame
      (cell @x (+ 1 2))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 2)}) ;; <<  notice the 2, so @a and @b propose diff values
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @x (+ 1 3))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 2)})
      (backsys @c  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Apparent conflicting write (same keypath), but values agree so it succeeds.
  (rack
    (frame
      (cell @x (+ 1 2))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @x (+ 2 3))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (backsys @c  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Conflicting write (keypath prefix)
  ;;
  ;; Currently we prefer the parent.
  (rack
    (frame
      (cell @x (foo (+ 1 2) 3))
      (part (@x @l) (foo l_ _))
      (part (@x @r) (foo _ r_))
      (part (@x @a) (foo (+ a_ _) _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @r  ±n <> {n: ^(* n 2)})
      (feed @l @bin)
      (cell @bin)
      (discard @bin))
    (frame
      (cell @x (foo 6))
      (part (@x @l) (foo l_ _))
      (part (@x @r) (foo _ r_))
      (part (@x @a) (foo (+ a_ _) _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @r  ±n <> {n: ^(* n 2)})
      (feed @l @bin)
      (cell @bin (+ 1 2))
      (discard @bin))
    (frame
      (cell @x (foo 6))
      (part (@x @l) (foo l_ _))
      (part (@x @r) (foo _ r_))
      (part (@x @a) (foo (+ a_ _) _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @r  ±n <> {n: ^(* n 2)})
      (feed @l @bin)
      (cell @bin)
      (discard @bin))
    end)

  ;; Conflicting write: root modified, parts must be ignored.
  (rack
    (frame
      (cell @root (+ 1 2))
      (part (@root @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @root  (+ _ ±n) <> {n: ^(+ n 1)}))
    (frame
      (cell @root (+ 1 3))
      (part (@root @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @root  (+ _ ±n) <> {n: ^(+ n 1)}))
    (frame
      (cell @root (+ 1 4))
      (part (@root @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @root  (+ _ ±n) <> {n: ^(+ n 1)})))
    ;; ...

  ;; Part with missing capture
  (rack
    (frame
      (part (@root @a) (+ a_ _))
      (feed (copy @a) @a-view)
      (cell @a-view))
    end)

  ;; Part with multiple captures
  (rack
    (frame
      (cell @root (+ 1 2))
      (part (@root @a) (+ a_ b_))
      (part (@root @b) (+ a_ b_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @root (+ 2 4))
      (part (@root @a) (+ a_ b_))
      (part (@root @b) (+ a_ b_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @root (+ 3 8))
      (part (@root @a) (+ a_ b_))
      (part (@root @b) (+ a_ b_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(* n 2)})))
    ;; ...

  ;; Part with unsupported capture
  (rack
    (frame
      (cell @root x_number)
      (part (@root @a) (%symbol blank a_ _))
      (backsys @a  N←x <> {N: y}))
    end)

  ;; Integration with tspace, frag (rig) node
  (rack
    (frame
      (cell @expr (+ 1 2))
      (part (@expr @x) (+ x_ _))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (frag (@x x_ -> (appearance _ `x) (appearance _ x_))
        (appearance local))
      (sensor (view local x_)))
    (frame pattern: true
      ⟨& (cell @expr (+ 1 2))
         (sensor _ 1)⟩)
    (frame pattern: true
      ⟨& (cell @expr (+ 2 2))
         (sensor _ 1)⟩)
    (frame pattern: true
      ⟨& (cell @expr (+ 2 2))
         (sensor _ 2)⟩)
    (frame pattern: true
      ⟨& (cell @expr (+ 3 2))
         (sensor _ 2)⟩)
    (frame pattern: true
      ⟨& (cell @expr (+ 3 2))
         (sensor _ 3)⟩)))
    ;; ...

;; rewriter
(group
  ;; rulesetR
  (rack
    (frame
      (cell @x 0)
      (rewriter (@x -> (rulesetR) -> @y)
        _ => 100 ;; test if it is ordered by specificity
        0 => 1
        1 => 2
        2 => 3)
      (cell @y)
      (feed @y @x))
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 1)⟩)
    (frame pattern: true
      ⟨& (cell @x 1)
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 2)⟩)
    (frame pattern: true
      ⟨& (cell @x 2)
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 3)⟩)
    (frame pattern: true
      ⟨& (cell @x 3)
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 100)⟩)
    (frame pattern: true
      ⟨& (cell @x 100)
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 100)⟩))
    ;; ...

  ;; exh rulesetR
  (rack
    (frame
      (cell @x 2)
      (rewriter (@x -> (rulesetR exh: true) -> @y)
        ±n => (e ^(+ n 1))
        (e n_) => (e ^n ^(- n 1))
        (e n_ m_number) => (e ^m ^(* n 2))
        (e n_ m_) => (e ^m . ^n))
      (cell @y))
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y (e 6 . 2))⟩)
    end)

  ;; ascR: elementary
  (rack
    (frame
      (cell @x (0 0 0 0 0))
      (rewriter (@x -> (ascR (rulesetR)) -> @y)
        ±n => ^(+ n 1))
      (cell @y)
      (feed @y @x))
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y (1 1 1 1 1))⟩)
    (frame pattern: true
      ⟨& (cell @x (1 1 1 1 1))
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y (2 2 2 2 2))⟩))
    ;; ...

  ;; ascR: make sure it really ascends
  (rack
    (frame
      (cell @x (e (e 0) (e 1)))
      (rewriter (@x - (ascR (rulesetR)) - @y)
        ±n => ^(+ n 1)
        (e ±n) => (p ^\n style: "text-blue-500")
        (e a_ b_) => (group ^b ^a))
      (cell @y)
      (backsys @y  {¦ -seen_} <> {seen: true}))
    (frame pattern: true
      ⟨& (cell @x (e (e 0) (e 1)))
         (cell @y
           (group
             (p "2" style: "text-blue-500")
             (p "1" style: "text-blue-500")))⟩)
    (frame pattern: true
      ⟨& (cell @x (e (e 0) (e 1)))
         (cell @y
           (group seen: true
             (p "2" style: "text-blue-500")
             (p "1" style: "text-blue-500")))⟩)
    end)

  (rack
    (frame
      (cell @x (e (d 0) (e 1)))
      (rewriter (@x - (ascR (rulesetR)) - @y)
        ±n => ^(+ n 1)
        (e n_) => ^\n
        (e a_ b_string) <> {a: ^b, b: ^a})
      (cell @y))
    (frame pattern: true
      ⟨& (cell @x (e (d 0) (e 1)))
         (cell @y (e "2" (d 1)))⟩)
    end)

  ;; ascR: impassable selector
  (rack
    (frame
      (cell @x (+ (literal "100") (literal "200") "300"))
      (rewriter (@x - ascR - @y)
        (impassable '_)
        x_string => (seen ^x)
        'x_ => (leaf ^x))
      (cell @y))
    (frame pattern: true
      ⟪(cell @y (+ (leaf "100") (leaf "200") (seen "300")))⟫)
    end)

  ;; ascR: passable
  (rack
    (frame
      (cell @x
        (+ (literal "100") (+ "a" "b") (literal "200") "300"))
      (rewriter (@x - ascR - @y)
        (passable (+ _*))
        x_string => (seen ^x))
      (cell @y))
    (frame pattern: true
      ⟪(cell @y
         (+ (literal "100") (+ (seen "a") (seen "b")) (literal "200") (seen "300")))⟫)
    end)

  ;; ascR: passable + impassable
  (rack
    (frame
      (cell @x
        (+ (literal "100") (+ "a" "b") (literal "200") "300"))
      (rewriter (@x - ascR - @y)
        (passable (+ _*))
        (impassable (+ _ _))
        x_string => (seen ^x))
      (cell @y))
    (frame pattern: true
      ⟪(cell @y
         (+ (literal "100") (+ "a" "b") (literal "200") (seen "300")))⟫)
    end)

  ;; descR: elementary
  (rack
    (frame
      (cell @x (e (d 0) (e 1)))
      (rewriter (@x - (descR (rulesetR)) - @y)
        ±n => ^(+ n 1)
        (e n_) => ^\n
        (e a_ b_string) <> {a: ^b, b: ^a})
      (cell @y))
    (frame pattern: true
      ⟨& (cell @x (e (d 0) (e 1)))
         (cell @y (e (d 1) "1"))⟩)
    end)

  ;; bidiR: elementary
  (rack
    (frame
      (cell @x ((+ "1" (I "2")) ?))
      (part (@x @in) (in_ _))
      (part (@x @out) (_ out_))
      (rewriter (@in - bidiR - @out)
        x_string => (node (token ^x))
        (I (node a_)) => (node (cursor ^a))
        (+ (node a_) (node b_)) => (node (seq ^a "+" ^b))))
    (frame pattern: true
      ⟨& (cell @x ((+ "1" (I "2")) (node (seq (token "1") "+" (cursor (token "2"))))))⟩)
    end)

  ;; waveR elementary
  (rack
    (frame
      (cell @in
        ((x (a 1) (b 2))
         (c)))
      (rewriter (@in -> waveR -> @out)
        (x (a n_) (b m_) ⍊ -sum_) <> {sum: ^(+ n m)}
        (a _ ⍊ -seen_) <> {seen: true}
        (b _ ⍊ -seen_) <> {seen: true}
        (c) => ((c)))
      (cell @out))
    (frame pattern: true
      ⟨(cell @out
         ((x (a 1 seen: true) (b 2 seen: true) sum: 3)
          ((c))))⟩)
    end)

  ;; dirR axis
  (rack
    (frame
      (rewriter ((chainR (descR (rulesetR phase: main) axis: in) (rulesetR phase: post)) <-> {@:in, @:bus})
        (main {¦ in: (place var_ `dst) bus: ((set var_ value_) _* `reply)})
          <> {dst: ^value, reply: (changed ^var ^value)}
        (main {¦ in: (place var_ value_) bus: ((unset var_) _*)})
          <> {(value): ()}
        (main {¦ in: (link a_ b_) bus: ((changed a_ value_) _* `reply)})
          <> {(reply): ((unset ^a) (set ^b ^value))}
        (post {¦ bus: (event_ _*)})
          <> {(event): ()})
      (cell @bus ((set x 0)))
      (cell @in
        (document
          (group
            (place x)
            (place y)
            (link x a)
            (link a y))
          (link y b)
          (link b x)
          (place a)
          (place b))))
    (frame pattern: true fast-forward: true
      ⟨(cell @in
         (document
           (group
             (place x 0)
             (place y)
             (link x a)
             (link a y))
           (link y b)
           (link b x)
           (place a)
           (place b)))⟩)
    (frame pattern: true fast-forward: true
      ⟨(cell @in
         (document
           (group
             (place x)
             (place y)
             (link x a)
             (link a y))
           (link y b)
           (link b x)
           (place a 0)
           (place b)))⟩)
    (frame pattern: true fast-forward: true
      ⟨(cell @in
         (document
           (group
             (place x)
             (place y 0)
             (link x a)
             (link a y))
           (link y b)
           (link b x)
           (place a)
           (place b)))⟩)
    (frame pattern: true fast-forward: true
      ⟨(cell @in
         (document
           (group
             (place x)
             (place y)
             (link x a)
             (link a y))
           (link y b)
           (link b x)
           (place a)
           (place b 0)))⟩)
    (frame pattern: true fast-forward: true
      ⟨(cell @in
         (document
           (group
             (place x 0)
             (place y)
             (link x a)
             (link a y))
           (link y b)
           (link b x)
           (place a)
           (place b)))⟩))
    ;; ...

  ;; Extension
  (rack
    (frame
      (cell @in ((x y) z))
      (cell @out)
      (rewriter (@in - ascR - @out)
        x => 100
        y => 200
        (±a ±b) => (result ^(+ a b))
        (a_dict b←z) <> {b: ^a, a: ^b})
      (backsys @out
        {¦ -seen_} <> {seen: true}))
    (frame pattern: true
      ⟨& (cell @in ((x y) z))
         (cell @out (z (result 300)))⟩)
    (frame pattern: true
      ⟨& (cell @in ((x y) z))
         (cell @out (z (result 300) seen: true))⟩)
    end)

  ;; Feed
  (rack
    (frame
      (cell @in ((x y) z))
      (cell @out)
      (rewriter (@in -> ascR -> @out)
        x => 100
        y => 200
        (±a ±b) => (result ^(+ a b))
        (a_dict b←z) <> {b: ^a, a: ^b})
      (backsys @out
        {¦ -seen_} <> {seen: true}))
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out (z (result 300)))⟩)
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out (z (result 300) seen: true))⟩)
    end)

  ;; chainR, rulesetR phase
  (rack
    (frame
      (cell @in ((x y) (a b)))
      (cell @out)
      (cell @rewriter
        (chainR
          (ascR (rulesetR phase: fst))
          (descR (rulesetR phase: snd))))
      (rewriter (@in -> @rewriter -> @out)
        (fst x) => 100
        (fst y) => 200
        (fst (±a ±b)) => ^(+ a b)
        (snd (a_ b_dict)) <> {b: ^a, a: ^b}))
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out ((a b) 300))⟩)
    end)

  ;; chainR -- no change in first
  (rack
    (frame
      (cell @in ((a b) (c d)))
      (cell @out)
      (cell @rewriter
        (chainR
          (ascR (rulesetR phase: fst))
          (descR (rulesetR phase: snd))))
      (rewriter (@in -> @rewriter -> @out)
        (fst x) => 100
        (fst y) => 200
        (fst (±a ±b)) => ^(+ a b)
        (snd (a_ b_dict)) <> {b: ^a, a: ^b}))
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out ((c d) (a b)))⟩)
    end)

  ;; chainR -- no change in second
  (rack
    (frame
      (cell @in ((x y) c))
      (cell @out)
      (cell @rewriter
        (chainR
          (ascR (rulesetR phase: fst))
          (descR (rulesetR phase: snd))))
      (rewriter (@in -> @rewriter -> @out)
        (fst x) => 100
        (fst y) => 200
        (fst (±a ±b)) => ^(+ a b)
        (snd (a_ b_dict)) <> {b: ^a, a: ^b}))
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out (300 c))⟩)
    end)

  ;; adjR
  (rack
    (frame
      (rewriter ((adjR (rulesetR)) <-> @world)
        {¦ m_: < -l} <> {m: >}
        {¦ m_: > -r} <> {m: <}
        {¦ m_: > r: .} <> {m: .}
        {¦ l: > m_: .} <> {m: >}
        {¦ l: . m_: <} <> {m: .}
        {¦ m_: . r: <} <> {m: <})
      (cell @world (> . . . .)))
    (frame/tail
      (cell @world (. > . . .)))
    (frame/tail
      (cell @world (. . > . .)))
    (frame/tail
      (cell @world (. . . > .)))
    (frame/tail
      (cell @world (. . . . >)))
    (frame/tail
      (cell @world (. . . . <)))
    (frame/tail
      (cell @world (. . . < .)))
    (frame/tail
      (cell @world (. . < . .)))
    (frame/tail
      (cell @world (. < . . .)))
    (frame/tail
      (cell @world (< . . . .)))
    (frame/tail
      (cell @world (> . . . .)))
    (frame/tail
      (cell @world (. > . . .))))
    ;; ...

  ;; valueR
  (rack
    (frame
      (rewriter ((valueR x (rulesetR)) <-> @in)
        ±n <> {n: ^(+ n 1)})
      (cell @in {x: 100, y: 200}))
    (frame/tail
      (cell @in {x: 101, y: 200}))
    (frame/tail
      (cell @in {x: 102, y: 200})))
    ;; ...

  ;; valueR replace with zero
  (rack
    (frame
      (rewriter ((valueR x (rulesetR)) <-> @in)
        ±n <> {n: ^(+ n 1)}
        10 => (^splice))
      (cell @in {x: 7, y: 200}))
    (frame/tail
      (cell @in {x: 8, y: 200}))
    (frame/tail
      (cell @in {x: 9, y: 200}))
    (frame/tail
      (cell @in {x: 10, y: 200}))
    (frame/tail
      (cell @in {y: 200}))
    end))

;; Instantiation
(group
  ;; Components are instantiated
  (rack
    (frame
      (Foo) => (Bar 0)
      (slot (Foo)))
    (frame/tail
      (slot (Foo) (Bar 0)))
    end)

  ;; Nested components are instantiated
  (rack
    (frame
      (Foo) => (slot (Bar 0))
      (Bar ±n) => (slot (Qux ^(+ n 1)))
      (Qux n_) => (p ^"Hello, ⸢n⸣")
      (slot (Foo)))
    (frame/tail
      (slot (Foo)
        (slot (Bar 0))))
    (frame/tail
      (slot (Foo)
        (slot (Bar 0)
          (slot (Qux 1)))))
    (frame/tail
      (slot (Foo)
        (slot (Bar 0)
          (slot (Qux 1)
            (p "Hello, 1")))))
    end)

  ;; Specificity is taken into account
  (rack
    (frame
      (Foo ±a) => (cell @x ^a)
      (Foo a_) => (cell @y ^a)
      (Bar a_) => (cell @a ^a)
      (Bar ±a) => (cell @b ^a)
      (slot (Foo 100))
      (slot (Foo qux))
      (slot (Bar 100))
      (slot (Bar qux)))
    (frame/tail
      (slot (Foo 100) (cell @x 100))
      (slot (Foo qux) (cell @y qux))
      (slot (Bar 100) (cell @b 100))
      (slot (Bar qux) (cell @a qux)))
    end)

  ;; Nested components are instantiated in component body
  (rack
    (frame
      (Foo a_)
        => (component {}
             (template (slot (Bar ^a)))
             (slot (Baz))
             (slot (Boo)))
      (Bar ±n) => (cell @x ^n)
      (Baz) => (feed @x @y)
      (Boo) => (cell @y)

      (slot (Foo 123)))

    (frame/tail
      (slot (Foo 123)
        (module {}
          (slot (Bar 123))
          (slot (Baz))
          (slot (Boo)))))

    (frame/tail
      (slot (Foo 123)
        (module {}
          (slot (Bar 123)
            (cell @x 123))
          (slot (Baz)
            (feed @x @y))
          (slot (Boo)
            (cell @y)))))

    (frame/tail
      (slot (Foo 123)
        (module {}
          (slot (Bar 123)
            (cell @x))
          (slot (Baz)
            (feed @x @y))
          (slot (Boo)
            (cell @y 123)))))

    end)

  ;; `template` can be used in passable spots.
  (rack
    (frame
      (Counter value_)
        => (component {}
             (cell @foo
               (template ^value))
             (node @bar
               (group style: "bg-blue-500"
                 (node @view
                   (template (p ^\value))))))
      (slot (Counter 100)))

    (frame/tail
      (slot (Counter 100)
        (module {}
          (cell @foo (template ^value)) ;; impassable
          (node @bar
            (group style: "bg-blue-500"
              (node @view
                (p "100"))))))) ;; passable

    end)

  ;; Templates with multiple children are instantiated as groups
  (rack
    (frame
      (Foo value_)
        => (component {}
             (template
               (cell @a ^(+ value 0))
               (cell @b ^(+ value 1))
               (cell @c ^(+ value 2)))
             (discard @a)
             (discard @b))
      (slot (Foo 100)))

    (frame/tail
      (slot (Foo 100)
        (module {}
          (group
            (cell @a 100)
            (cell @b 101)
            (cell @c 102))
          (discard @a)
          (discard @b))))

    (frame/tail
      (slot (Foo 100)
        (module {}
          (group
            (cell @a)
            (cell @b)
            (cell @c 102))
          (discard @a)
          (discard @b))))

    end)

  ;; Infinite recursion ends at some point due to SAFE_SLOT_DEPTH.
  (rack
    (frame
      (Infinite x_) => (slot (Infinite ^(+ x 1)))
      (slot (Infinite 0)))
    terminates)

  ;; Rule addition invalidates associated slots.
  (rack
    (frame
      (cell @a (Foo x_) => (cell @count0 ^x))
      (feed @a @b)
      (node @b)

      (delay 5
        (cell @x (Bar x_) => (cell @count1 ^x)))
      (feed @x @y)
      (node @y)

      (slot (Foo 100))
      (slot (Bar 200))

      (backsys {@:count0 @:count1}
        {¦ ±count0} <> {count0: ^(+ count0 1)}
        {¦ ±count1} <> {count1: ^(+ count1 1)}))

    (frame pattern: true
      ⟨& (cell @a)
         (node @b (%literal (Foo x_) => (cell @count0 ^x)))
         (delay 4 _)⟩)

    (frame pattern: true
      ⟨& (delay 4 _)
         (slot (Foo 100) (cell @count0 100))⟩)

    (frame pattern: true
      ⟨& (delay 3 _)
         (slot (Foo 100) (cell @count0 101))⟩)

    (frame pattern: true
      ⟨& (delay 2 _)
         (slot (Foo 100) (cell @count0 102))⟩)

    (frame pattern: true
      ⟨& (delay 1 _)
         (slot (Foo 100) (cell @count0 103))⟩)

    (frame pattern: true
      ⟨& (cell @x (Bar x_) => (cell @count1 ^x))
         (slot (Foo 100) (cell @count0 104))⟩)

    (frame pattern: true
      ⟨& (node @y (Bar x_) => (cell @count1 ^x))
         (slot (Foo 100) (cell @count0 105))⟩)

    (frame pattern: true
      ⟨& (node @y (Bar x_) => (cell @count1 ^x))
         (slot (Foo 100) (cell @count0 105))
         (slot (Bar 200) (cell @count1 200))⟩)

    (frame pattern: true
      ⟨& (slot (Foo 100) (cell @count0 106))
         (slot (Bar 200) (cell @count1 201))⟩)

    (frame pattern: true
      ⟨& (slot (Foo 100) (cell @count0 107))
         (slot (Bar 200) (cell @count1 202))⟩)

    (frame pattern: true
      ⟨& (slot (Foo 100) (cell @count0 108))
         (slot (Bar 200) (cell @count1 203))⟩))
    ;; ...

  ;; Rule deletion invalidates associated slots.
  (rack
    (frame
      (node @x (Foo) => (delay 100 foo))
      (delay 5
        (discard @x))

      (Bar) => (delay 100 bar)

      (slot (Foo))
      (slot (Bar)))

    (frame pattern: true
      ⟨& (delay 5 _)
         (slot (Foo) (delay 100 foo))
         (slot (Bar) (delay 100 bar))⟩)

    (frame pattern: true
      ⟨& (delay 4 _)
         (slot (Foo) (delay 99 foo))
         (slot (Bar) (delay 99 bar))⟩)

    (frame pattern: true
      ⟨& (delay 3 _)
         (slot (Foo) (delay 98 foo))
         (slot (Bar) (delay 98 bar))⟩)

    (frame pattern: true
      ⟨& (delay 2 _)
         (slot (Foo) (delay 97 foo))
         (slot (Bar) (delay 97 bar))⟩)

    (frame pattern: true
      ⟨& (delay 1 (discard @x))
         (slot (Foo) (delay 96 foo))
         (slot (Bar) (delay 96 bar))⟩)

    (frame pattern: true
      ⟨& (node @x (Foo) => (delay 100 foo))
         (discard @x)
         (slot (Foo) (delay 95 foo))
         (slot (Bar) (delay 95 bar))⟩)

    (frame pattern: true
      ⟨& (node @x)
         (discard @x)
         (slot (Foo) (delay 94 foo))
         (slot (Bar) (delay 94 bar))⟩)

    (frame pattern: true
      ⟨& (node @x)
         (discard @x)
         (slot (Foo))
         (slot (Bar) (delay 94 bar))⟩)

    (frame pattern: true
      ⟨& (node @x)
         (discard @x)
         (slot (Foo))
         (slot (Bar) (delay 93 bar))⟩))
    ;; ...

  ;; Rule update invalidates associated slots.
  (rack
    (frame
      (node @rule (Foo) => (cell @count 0))
      (Bar) => (delay 100 bar)
      (backsys @rule
        (rule _ (cell @_ ±count))
          <> {count: ^(+ count 1)})

      (slot (Foo))
      (slot (Bar)))

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 0))
         (slot (Foo) (cell @count 0))
         (slot (Bar) (delay 100 bar))⟩)

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 1))
         (slot (Foo) (cell @count 0))
         (slot (Bar) (delay 99 bar))⟩)

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 1))
         (slot (Foo) (cell @count 1))
         (slot (Bar) (delay 99 bar))⟩)

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 2))
         (slot (Foo) (cell @count 1))
         (slot (Bar) (delay 98 bar))⟩)

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 2))
         (slot (Foo) (cell @count 2))
         (slot (Bar) (delay 98 bar))⟩))
    ;;; ...

  ;; Slots can be constructed & are instantiated dynamically.
  (rack
    (frame
      (Foo n_) => (cell @x ^n)
      (cell @arg 0)
      (transfer (@arg n_ @node) (slot (Foo ^n)))
      (frag @node)
      (feed @x @y)
      (cell @y))

    (frame
      (Foo n_) => (cell @x ^n)
      (cell @arg)
      (transfer (@arg n_ @node) (slot (Foo ^n)))
      (frag @node (slot (Foo 0)))
      (feed @x @y)
      (cell @y))

    (frame
      (Foo n_) => (cell @x ^n)
      (cell @arg)
      (transfer (@arg n_ @node) (slot (Foo ^n)))
      (frag @node (slot (Foo 0) (cell @x 0)))
      (feed @x @y)
      (cell @y))

    (frame
      (Foo n_) => (cell @x ^n)
      (cell @arg)
      (transfer (@arg n_ @node) (slot (Foo ^n)))
      (frag @node (slot (Foo 0) (cell @x)))
      (feed @x @y)
      (cell @y 0))

    end)

  ;; Many slots from the same rule (add & remove).
  (rack
    (frame
      (delay 3
        (node @rule (Foo n_) => ^n))
      (delay 5
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John")))
    (frame
      (delay 3
        (node @rule (Foo n_) => ^n))
      (delay 5
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    (frame
      (delay 2
        (node @rule (Foo n_) => ^n))
      (delay 4
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    (frame
      (delay 1
        (node @rule (Foo n_) => ^n))
      (delay 3
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule (Foo n_) => ^n)
      (delay 2
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule (Foo n_) => ^n)
      (delay 2
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0) 0)
      (slot (Foo 1) 1)
      (slot (Foo 2) 2)
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule (Foo n_) => ^n)
      (delay 1
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0) 0)
      (slot (Foo 1) 1)
      (slot (Foo 2) 2)
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule (Foo n_) => ^n)
      (discard @rule)
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0) 0)
      (slot (Foo 1) 1)
      (slot (Foo 2) 2)
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule)
      (discard @rule)
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0) 0)
      (slot (Foo 1) 1)
      (slot (Foo 2) 2)
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule)
      (discard @rule)
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    end)

  ;; Many slots from the same rule (update).
  (rack
    (frame
      (node @rule (Foo 0) => "Kaixo")
      (backsys @rule
        (rule (Foo ±n) _) <> {n: ^(mod (+ n 1) 4)})
      (Bar) => (delay 100 qux)
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar)))
    (frame/tail
      (slot (Foo 0) "Kaixo")
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 100 qux)))
    (frame
      (node @rule (Foo 1) => "Kaixo")
      (backsys @rule
        (rule (Foo ±n) _) <> {n: ^(mod (+ n 1) 4)})
      (Bar) => (delay 100 qux)
      (slot (Foo 0) "Kaixo")
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 99 qux)))
    (frame/tail
      (slot (Foo 0))
      (slot (Foo 1) "Kaixo")
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 99 qux)))
    (frame/tail
      ;; (Foo 2) => ...
      (slot (Foo 0))
      (slot (Foo 1) "Kaixo")
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 98 qux)))
    (frame/tail
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2) "Kaixo")
      (slot (Foo 3))
      (slot (Bar) (delay 98 qux)))
    (frame/tail
      ;; (Foo 3) => ...
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2) "Kaixo")
      (slot (Foo 3))
      (slot (Bar) (delay 97 qux)))
    (frame/tail
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3) "Kaixo")
      (slot (Bar) (delay 97 qux)))
    (frame/tail
      ;; (Foo 0) => ...
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3) "Kaixo")
      (slot (Bar) (delay 96 qux)))
    (frame/tail
      (slot (Foo 0) "Kaixo")
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 96 qux))))
    ;; ...

  ;; Module creates rule scope.
  (rack
    (frame
      (backsys @lab
        ((_* `dst) rule_ _) <> {dst: ^rule, (rule): ()}
        ((_* rule_) `dst _) <> {dst: ^rule, (rule): ()})
      (circuit @lab
        (module {})
        (Foo) => 100
        (slot (Foo))))

    (frame/tail
      (circuit @lab
        (module {})
        (Foo) => 100
        (slot (Foo) 100)))

    (frame/tail
      (circuit @lab
        (module {} (Foo) => 100)
        (slot (Foo) 100)))

    (frame/tail
      (circuit @lab
        (module {} (Foo) => 100)
        (slot (Foo))))

    (frame/tail
      (circuit @lab
        (module {})
        (Foo) => 100
        (slot (Foo))))

    (frame/tail
      (circuit @lab
        (module {})
        (Foo) => 100
        (slot (Foo) 100)))))
    ;; ...

;; BUG: Make sure append and prepend on the same cell are not merged
;; (and related).
(group
  (rack
    (frame
      (cell @x (a b))
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200}))
    (frame
      (cell @x (b)) ;; < nodes whose addr is smaller win
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200}))
    (frame
      (cell @x ())
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200}))
    (frame
      (cell @x (200))
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200}))
    (frame
      (cell @x ())
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200})))
    ;; ...

  (rack
    (frame
      (cell @x (a b))
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  (front_ _*) <> {(front): ()}))
    (frame
      (cell @x (a b 200)) ;; < nodes whose addr is smaller win
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  (front_ _*) <> {(front): ()}))
    (frame
      (cell @x (a b 200 200))
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  (front_ _*) <> {(front): ()})))
    ;; ...

  (rack
    (frame
      (cell @x (a b))
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  {¦ -flag_} <> {flag: true}))
    (frame
      (cell @x (a b 200 flag: true)) ;; < since the flag backsys doesn't modify itemsize it's merged!
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  {¦ -flag_} <> {flag: true}))
    end))

;; Cell rewriting
(group
  (rack
    (frame
      (cell @spec (rulesetR))
      (cell @n 0)
      (rewriter (@spec <-> {@:n})
        {¦ ±n} <> {n: ^(+ n 1)}))
    (frame pattern: true
      ⟨(cell @n 1)⟩)
    (frame pattern: true
      ⟨(cell @n 2)⟩))
    ;; ...

  (rack
    (frame
      (cell @n 0)
      (rewriter ((rulesetR) <-> {@:n})
        {¦ ±n} <> {n: ^(+ n 1)}))
    (frame pattern: true
      ⟨(cell @n 1)⟩)
    (frame pattern: true
      ⟨(cell @n 2)⟩))
    ;; ...

  (rack
    (frame
      (cell @n 0)
      (cell @m)
      (rewriter ((rulesetR) <-> {@:n @:m})
        {¦ ±n -m_} <> {m: (counter ^n)}
        {¦ ±n m: (counter ±m)} <> {n: ^(+ n 1), m: ^n}
        {¦ ±n m_: (counter 3)} <> {(n): (), (m): ()}))
    (frame pattern: true
      ⟨& (cell @n 0)
         (cell @m (counter 0))⟩)
    (frame pattern: true
      ⟨& (cell @n 1)
         (cell @m (counter 0))⟩)
    (frame pattern: true
      ⟨& (cell @n 2)
         (cell @m (counter 1))⟩)
    (frame pattern: true
      ⟨& (cell @n 3)
         (cell @m (counter 2))⟩)
    (frame pattern: true
      ⟨& (cell @n 4)
         (cell @m (counter 3))⟩)
    (frame pattern: true
      ⟨& (cell @n)
         (cell @m)⟩)
    end))

;; BUG: Make sure D7.resolve() is used in D7.permutation()
(rack
  (frame
    (cell @x 0)
    (module {@xs: @x}
      (cell @x 100)
      (cell @y)
      (feed @xs @y)))
  (frame
    (cell @x)
    (module {@xs: @x}
      (cell @x 100)
      (cell @y 0)
      (feed @xs @y)))
  end)

;; BUG: Single-expression template must expand into group on plural
;; top-level splice.
(group
  ;; zero
  (rack
    (frame
      (Qux) =>
        (component {}
          (template
            (^splice)))
        (slot (Qux)))
    (frame/tail
      (slot (Qux)
        (module {}
          (group))))
    end)
  ;; one
  (rack
    (frame
      (Qux) =>
        (component {}
          (template
            (^splice 1)))
        (slot (Qux)))
    (frame/tail
      (slot (Qux)
        (module {}
          1)))
    end)
  ;; many
  (rack
    (frame
      (Qux) =>
        (component {}
          (template
            (^splice 1 2 3)))
        (slot (Qux)))
    (frame/tail
      (slot (Qux)
        (module {}
          (group 1 2 3))))
    end))

;; BUG: part must use relative edge in replacement cell
(rack
  (frame
    (feed (copy @count-parent) (atop @dbg))
    (cell @dbg)
    (module {@count: @count-parent}
      (cell @counter (counter 0))
      (part (@counter @count) (counter ±count))
      (backsys @count ±n <> {n: ^(+ n 1)})))
  (frame
    (feed (copy @count-parent) (atop @dbg))
    (cell @dbg 0)
    (module {@count: @count-parent}
      (cell @counter (counter 1))
      (part (@counter @count) (counter ±count))
      (backsys @count ±n <> {n: ^(+ n 1)}))))
  ;; ...

;; BUG: only one participant must be allowed to change itemsize;
;; all of its changes must be rolled back in case of failure.
(rack
  (frame
    (backsys {@:xs @:a} {¦ xs: (_* `dst) a_} <> {dst: ^a, (a): ()})
    (backsys {@:xs @:b} {¦ xs: (_* `dst) b_} <> {dst: ^b, (b): ()})
    (cell @xs ())
    (cell @a 1)
    (cell @b 2))

  (frame/tail
    (cell @xs (1))
    (cell @a)
    (cell @b 2))

  (frame/tail
    (cell @xs (1 2))
    (cell @a)
    (cell @b))
  end)

;; Bubble sort
(rack
  (frame
    (backsys @numbers
      ⟨±n m←(%number _ < (var n))⟩°
        <> {n: ^m, m: ^n})
    (cell @numbers
      (392 936 237 463 169 985 403 983 214 376 189 856 949 13 519 14 626 179 906)))
  (frame pattern: true fast-forward: true
    ⟨(cell @numbers
       (13 14 169 179 189 214 237 376 392 403 463 519 626 856 906 936 949 983 985))⟩)
  end)

;; Merge sort (one module)
(rack
  (frame
    (rewriter ((rulesetR) <-> {@:unsorted, @:sorted, @:workspace, @:busy})
      {¦ unsorted: (±n _*) workspace: (_* `dst)}
        <> {dst: (^n), (n): ()}
      {¦ unsorted: (±n ±m _*) workspace: (_* `dst)}
        <> {dst: (^n ^m), (n): (), (m): ()}
      {¦ unsorted: (±n m←(%number _ < (var n)) _*) workspace: (_* `dst)}
        <> {dst: (^m ^n), (n): (), (m): ()}
      {¦ busy: 0 unsorted_: () -sorted_ workspace: (a_dict)}
        <> {(a): (), (unsorted): (), sorted: ^a})
    (cell @workspace ())
    (cell @busy 0)
    (module {:@workspace, :@busy}
      (cell @l)
      (cell @r)
      (cell @out ())
      (rewriter ((rulesetR) <-> {@:workspace, @:busy, @:l, @:r, @:out})
        {¦ workspace: (a_dict b_dict _*) -l_ -r_ ±busy}
          <> {(a): (), (b): (), l: ^a, r: ^b, busy: ^(+ busy 1)}
        {¦ workspace: (_* `dst) l_: () r_: () out_: (_*) ±busy}
          <> {dst: ^out, (l): (), (r): (), out: (), busy: ^(- busy 1)}
        {¦ l: (±a _*) r: (_number _*) out: (_* `dst)}
          <> {(a): (), dst: ^a}
        {¦ l: (±a _*) r: (b←(%number _ < (var a)) _*) out: (_* `dst)}
          <> {(b): (), dst: ^b}
        {¦ l_: (_+) r: () out: (_* `dst)}
          <> {l: (), (dst): ^l}
        {¦ l: () r_: (_+) out: (_* `dst)}
          <> {r: (), (dst): ^r}))
    (cell @sorted)
    (cell @unsorted (392 936 237 463 169 985 403 983 214 376 189 856 949 13 519 14 626 179 906)))
  (frame pattern: true fast-forward: true
    ⟨& (cell @unsorted)
       (cell @sorted (13 14 169 179 189 214 237 376 392 403 463 519 626 856 906 936 949 983 985))⟩)
  end)

