  ;; Removal of pair
  (d7
    (frame
      (cell @top (qux 3 x: 100 y: 200 z: 300))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    (frame
      (cell @top (qux 2 x: 100 y: 200))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    (frame
      (cell @top (qux 1 x: 100))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    (frame
      (cell @top (qux 1))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    end)

  ;; Use with `feed...front`.
  ;;
  ;; NOTE: We're writing this in a very convoluted way with (module ...)
  ;; because besides confusing *you*, it may also confuse the engine. What
  ;; we're *really* to test here is the latter; we're trying to make sure
  ;; the engine is *not* confused.
  (d7
    (frame
      (queue (@mail @inbox) (a b c))
      (cell @top {name: "Samantha", mail: ()})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    (frame
      (queue (@mail @inbox) (b c))
      (cell @top {name: "Samantha", mail: (a)})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    (frame
      (queue (@mail @inbox) (c))
      (cell @top {name: "Samantha", mail: (b a)})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    (frame
      (queue (@mail @inbox) ())
      (cell @top {name: "Samantha", mail: (c b a)})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    end)

  ;; Scoping
  (d7
    (frame
      (module {}
        (cell @top (qux (1 2) (3 4)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (5 6) (7 8)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (9 10) (11 12)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)})))
    (frame
      (module {}
        (cell @top (qux (1 3) (3 4)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (5 7) (7 8)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (9 11) (11 12)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)})))
    (frame
      (module {}
        (cell @top (qux (1 4) (3 4)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (5 8) (7 8)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (9 12) (11 12)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))))
    ;; ...
  (d7
    (frame
      (cell @b (+ 1 2))
      (module {@a: @b}
        (part (@a @b) (+ _ b_))
        (backsys @b  ±n <> {n: ^(+ n 1)})))
    (frame
      (cell @b (+ 1 3))
      (module {@a: @b}
        (part (@a @b) (+ _ b_))
        (backsys @b  ±n <> {n: ^(+ n 1)})))
    (frame
      (cell @b (+ 1 4))
      (module {@a: @b}
        (part (@a @b) (+ _ b_))
        (backsys @b  ±n <> {n: ^(+ n 1)}))))
    ;; ...

  ;; Multiple roots in parallel
  (d7
    (frame
      (cell @r0 (+ 1 2))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 3 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    (frame
      (cell @r0 (+ 2 3))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 4 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    (frame
      (cell @r0 (+ 3 4))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 5 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    (frame
      (cell @r0 (+ 4 5))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 6 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    end)

  ;; Multiple roots in sequence
  (d7
    (frame
      (cell @r0 (+ (* 1 2) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1)
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 2) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 2))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 2) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 3))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 3) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 4))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 4) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 5))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a))))
    ;; ...

  ;; Parts hanging off duplicate roots are ignored
  (d7
    (frame
      (cell @x (+ 1 2))
      (cell @x (+ 3 4))
      (part (@x @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)}))
    end)

  ;; Parts writing into the same edge are ignored
  (d7
    (frame
      (cell @x (+ 1 2))
      (part (@x @a) (+ a_ _))
      (part (@x @a) (+ _ a_))
      (backsys @a  ±n <> {n: ^(+ n 1)}))
    end)

  ;; Conflicting write (same keypath)
  (d7
    (frame
      (cell @x (+ 1 2))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 2)}) ;; <<  notice the 2, so @a and @b propose diff values
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @x (+ 1 3))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 2)})
      (backsys @c  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Apparent conflicting write (same keypath), but values agree so it succeeds.
  (d7
    (frame
      (cell @x (+ 1 2))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @x (+ 2 3))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (backsys @c  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Conflicting write (keypath prefix)
  ;;
  ;; Currently we prefer the parent.
  (d7
    (frame
      (cell @x (foo (+ 1 2) 3))
      (part (@x @l) (foo l_ _))
      (part (@x @r) (foo _ r_))
      (part (@x @a) (foo (+ a_ _) _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @r  ±n <> {n: ^(* n 2)})
      (feed @l @bin)
      (cell @bin)
      (discard @bin))
    (frame
      (cell @x (foo 6))
      (part (@x @l) (foo l_ _))
      (part (@x @r) (foo _ r_))
      (part (@x @a) (foo (+ a_ _) _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @r  ±n <> {n: ^(* n 2)})
      (feed @l @bin)
      (cell @bin (+ 1 2))
      (discard @bin))
    (frame
      (cell @x (foo 6))
      (part (@x @l) (foo l_ _))
      (part (@x @r) (foo _ r_))
      (part (@x @a) (foo (+ a_ _) _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @r  ±n <> {n: ^(* n 2)})
      (feed @l @bin)
      (cell @bin)
      (discard @bin))
    end)

  ;; Conflicting write: root modified, parts must be ignored.
  (d7
    (frame
      (cell @root (+ 1 2))
      (part (@root @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @root  (+ _ ±n) <> {n: ^(+ n 1)}))
    (frame
      (cell @root (+ 1 3))
      (part (@root @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @root  (+ _ ±n) <> {n: ^(+ n 1)}))
    (frame
      (cell @root (+ 1 4))
      (part (@root @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @root  (+ _ ±n) <> {n: ^(+ n 1)})))
    ;; ...

  ;; Part with missing capture
  (d7
    (frame
      (part (@root @a) (+ a_ _))
      (feed (copy @a) @a-view)
      (cell @a-view))
    end)

  ;; Part with multiple captures
  (d7
    (frame
      (cell @root (+ 1 2))
      (part (@root @a) (+ a_ b_))
      (part (@root @b) (+ a_ b_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @root (+ 2 4))
      (part (@root @a) (+ a_ b_))
      (part (@root @b) (+ a_ b_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @root (+ 3 8))
      (part (@root @a) (+ a_ b_))
      (part (@root @b) (+ a_ b_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(* n 2)})))
    ;; ...

  ;; Part with unsupported capture
  (d7
    (frame
      (cell @root x_number)
      (part (@root @a) (%symbol blank a_ _))
      (backsys @a  N←x <> {N: y}))
    end)

  ;; Integration with tspace
  (d7
    (frame
      (cell @expr (+ 1 2))
      (part (@expr @x) (+ x_ _))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (appearance local @x)
      (sensor* (local x_ @view) ^x)
      (cell @view))
    (frame
      (cell @expr (+ 2 2))
      (part (@expr @x) (+ x_ _))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (appearance local @x)
      (sensor* (local x_ @view) ^x)
      (cell @view (1)))
    (frame
      (cell @expr (+ 3 2))
      (part (@expr @x) (+ x_ _))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (appearance local @x)
      (sensor* (local x_ @view) ^x)
      (cell @view (2))))
    ;; ...

  ;; Integration with `device`: queue
  (d7
    (frame
      (device (@x (q 1 2 3))
        (part (@x @fst) (q fst_ _*))
        (feed @fst @y)
        (cell @y)
        (discard @y)))
    (frame
      (device (@x (q 2 3))
        (part (@x @fst) (q fst_ _*))
        (feed @fst @y)
        (cell @y 1)
        (discard @y)))
    (frame
      (device (@x (q 2 3))
        (part (@x @fst) (q fst_ _*))
        (feed @fst @y)
        (cell @y)
        (discard @y)))
    (frame
      (device (@x (q 3))
        (part (@x @fst) (q fst_ _*))
        (feed @fst @y)
        (cell @y 2)
        (discard @y)))
    (frame
      (device (@x (q 3))
        (part (@x @fst) (q fst_ _*))
        (feed @fst @y)
        (cell @y)
        (discard @y)))
    (frame
      (device (@x (q))
        (part (@x @fst) (q fst_ _*))
        (feed @fst @y)
        (cell @y 3)
        (discard @y)))
    (frame
