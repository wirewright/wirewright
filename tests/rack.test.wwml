      (discard @x)
      (discard @y)
      (discard @z))
    (frame
      (cell @top (qux 1))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    end)

  ;; Use with `feed...front`.
  ;;
  ;; NOTE: We're writing this in a very convoluted way with (module ...)
  ;; because besides confusing *you*, it may also confuse the engine. What
  ;; we're *really* to test here is the latter; we're trying to make sure
  ;; the engine is *not* confused.
  (rack
    (frame
      (queue (@mail @inbox) (a b c))
      (cell @top {name: "Samantha", mail: ()})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    (frame
      (queue (@mail @inbox) (b c))
      (cell @top {name: "Samantha", mail: (a)})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    (frame
      (queue (@mail @inbox) (c))
      (cell @top {name: "Samantha", mail: (b a)})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    (frame
      (queue (@mail @inbox) ())
      (cell @top {name: "Samantha", mail: (c b a)})
      (module {:@top, @msg: @mail}
        (part (@top @mail) {¦ mail_})
        (feed @msg (@mail front))))
    end)

  ;; Scoping
  (rack
    (frame
      (module {}
        (cell @top (qux (1 2) (3 4)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (5 6) (7 8)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (9 10) (11 12)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)})))
    (frame
      (module {}
        (cell @top (qux (1 3) (3 4)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (5 7) (7 8)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (9 11) (11 12)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)})))
    (frame
      (module {}
        (cell @top (qux (1 4) (3 4)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (5 8) (7 8)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))
      (module {}
        (cell @top (qux (9 12) (11 12)))
        (part (@top @a) (qux (_ a_) _))
        (backsys @a  ±n <> {n: ^(+ n 1)}))))
    ;; ...
  (rack
    (frame
      (cell @b (+ 1 2))
      (module {@a: @b}
        (part (@a @b) (+ _ b_))
        (backsys @b  ±n <> {n: ^(+ n 1)})))
    (frame
      (cell @b (+ 1 3))
      (module {@a: @b}
        (part (@a @b) (+ _ b_))
        (backsys @b  ±n <> {n: ^(+ n 1)})))
    (frame
      (cell @b (+ 1 4))
      (module {@a: @b}
        (part (@a @b) (+ _ b_))
        (backsys @b  ±n <> {n: ^(+ n 1)}))))
    ;; ...

  ;; Multiple roots in parallel
  (rack
    (frame
      (cell @r0 (+ 1 2))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 3 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    (frame
      (cell @r0 (+ 2 3))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 4 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    (frame
      (cell @r0 (+ 3 4))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 5 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    (frame
      (cell @r0 (+ 4 5))
      (part (@r0 @a) (+ a_ _))
      (part (@r0 @b) (+ _ b_))
      (cell @r1 (* 6 4))
      (part (@r1 @x) (* x←(%number _ <= 5) _))
      (backsys (@a @b @x)
        (±a ±b ±x) <> {(local (forall a b x)): ^(+ it 1)}))
    end)

  ;; Multiple roots in sequence
  (rack
    (frame
      (cell @r0 (+ (* 1 2) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1)
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 2) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 2))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 2) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 3))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 3) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 4))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a)))
    (frame
      (cell @r0 (+ (* 1 4) 3))
      (part (@r0 @a) (+ a_ _))
      (feed (copy @a) @r1)
      (cell @r1 (* 1 5))
      (part (@r1 @b) (* _ b_))
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (feed (copy @r1) (atop @a))))
    ;; ...

  ;; Parts hanging off duplicate roots are ignored
  (rack
    (frame
      (cell @x (+ 1 2))
      (cell @x (+ 3 4))
      (part (@x @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)}))
    end)

  ;; Parts writing into the same edge are ignored
  (rack
    (frame
      (cell @x (+ 1 2))
      (part (@x @a) (+ a_ _))
      (part (@x @a) (+ _ a_))
      (backsys @a  ±n <> {n: ^(+ n 1)}))
    end)

  ;; Conflicting write (same keypath)
  (rack
    (frame
      (cell @x (+ 1 2))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 2)}) ;; <<  notice the 2, so @a and @b propose diff values
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @x (+ 1 3))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 2)})
      (backsys @c  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Apparent conflicting write (same keypath), but values agree so it succeeds.
  (rack
    (frame
      (cell @x (+ 1 2))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @x (+ 2 3))
      (part (@x @a) (+ a_ _))
      (part (@x @b) (+ b_ _))
      (part (@x @c) (+ _ c_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(+ n 1)})
      (backsys @c  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Conflicting write (keypath prefix)
  ;;
  ;; Currently we prefer the parent.
  (rack
    (frame
      (cell @x (foo (+ 1 2) 3))
      (part (@x @l) (foo l_ _))
      (part (@x @r) (foo _ r_))
      (part (@x @a) (foo (+ a_ _) _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @r  ±n <> {n: ^(* n 2)})
      (feed @l @bin)
      (cell @bin)
      (discard @bin))
    (frame
      (cell @x (foo 6))
      (part (@x @l) (foo l_ _))
      (part (@x @r) (foo _ r_))
      (part (@x @a) (foo (+ a_ _) _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @r  ±n <> {n: ^(* n 2)})
      (feed @l @bin)
      (cell @bin (+ 1 2))
      (discard @bin))
    (frame
      (cell @x (foo 6))
      (part (@x @l) (foo l_ _))
      (part (@x @r) (foo _ r_))
      (part (@x @a) (foo (+ a_ _) _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @r  ±n <> {n: ^(* n 2)})
      (feed @l @bin)
      (cell @bin)
      (discard @bin))
    end)

  ;; Conflicting write: root modified, parts must be ignored.
  (rack
    (frame
      (cell @root (+ 1 2))
      (part (@root @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @root  (+ _ ±n) <> {n: ^(+ n 1)}))
    (frame
      (cell @root (+ 1 3))
      (part (@root @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @root  (+ _ ±n) <> {n: ^(+ n 1)}))
    (frame
      (cell @root (+ 1 4))
      (part (@root @a) (+ a_ _))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @root  (+ _ ±n) <> {n: ^(+ n 1)})))
    ;; ...

  ;; Part with missing capture
  (rack
    (frame
      (part (@root @a) (+ a_ _))
      (feed (copy @a) @a-view)
      (cell @a-view))
    end)

  ;; Part with multiple captures
  (rack
    (frame
      (cell @root (+ 1 2))
      (part (@root @a) (+ a_ b_))
      (part (@root @b) (+ a_ b_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @root (+ 2 4))
      (part (@root @a) (+ a_ b_))
      (part (@root @b) (+ a_ b_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @root (+ 3 8))
      (part (@root @a) (+ a_ b_))
      (part (@root @b) (+ a_ b_))
      (backsys @a  ±n <> {n: ^(+ n 1)})
      (backsys @b  ±n <> {n: ^(* n 2)})))
    ;; ...

  ;; Part with unsupported capture
  (rack
    (frame
      (cell @root x_number)
      (part (@root @a) (%symbol blank a_ _))
      (backsys @a  N←x <> {N: y}))
    end)

  ;; Integration with tspace
  (rack
    (frame
      (cell @expr (+ 1 2))
      (part (@expr @x) (+ x_ _))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (appearance local @x)
      (sensor* (local x_ @view) ^x)
      (cell @view))
    (frame pattern: true
      ⟨& (cell @expr (+ 1 2))
         (cell @view (1))⟩)
    (frame pattern: true
      ⟨& (cell @expr (+ 2 2))
         (cell @view (1))⟩)
    (frame pattern: true
      ⟨& (cell @expr (+ 2 2))
         (cell @view (2))⟩)
    (frame pattern: true
      ⟨& (cell @expr (+ 3 2))
         (cell @view (2))⟩)
    (frame pattern: true
      ⟨& (cell @expr (+ 3 2))
         (cell @view (3))⟩)))
    ;; ...

;; rewriter
(group
  ;; rulesetR
  (rack
    (frame
      (cell @x 0)
      (rewriter (@x -> (rulesetR) -> @y)
        _ => 100 ;; test if it is ordered by specificity
        0 => 1
        1 => 2
        2 => 3)
      (cell @y)
      (feed @y @x))
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 1)⟩)
    (frame pattern: true
      ⟨& (cell @x 1)
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 2)⟩)
    (frame pattern: true
      ⟨& (cell @x 2)
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 3)⟩)
    (frame pattern: true
      ⟨& (cell @x 3)
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 100)⟩)
    (frame pattern: true
      ⟨& (cell @x 100)
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y 100)⟩))
    ;; ...

  ;; exh rulesetR
  (rack
    (frame
      (cell @x 2)
      (rewriter (@x -> (rulesetR exh: true) -> @y)
        ±n => (e ^(+ n 1))
        (e n_) => (e ^n ^(- n 1))
        (e n_ m_number) => (e ^m ^(* n 2))
        (e n_ m_) => (e ^m . ^n))
      (cell @y))
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y (e 6 . 2))⟩)
    end)

  ;; ascR: elementary
  (rack
    (frame
      (cell @x (0 0 0 0 0))
      (rewriter (@x -> (ascR (rulesetR)) -> @y)
        ±n => ^(+ n 1))
      (cell @y)
      (feed @y @x))
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y (1 1 1 1 1))⟩)
    (frame pattern: true
      ⟨& (cell @x (1 1 1 1 1))
         (cell @y)⟩)
    (frame pattern: true
      ⟨& (cell @x)
         (cell @y (2 2 2 2 2))⟩))
    ;; ...

  ;; ascR: make sure it really ascends
  (rack
    (frame
      (cell @x (e (e 0) (e 1)))
      (rewriter (@x - (ascR (rulesetR)) - @y)
        ±n => ^(+ n 1)
        (e ±n) => (p ^\n style: "text-blue-500")
        (e a_ b_) => (group ^b ^a))
      (cell @y)
      (backsys @y  {¦ -seen_} <> {seen: true}))
    (frame pattern: true
      ⟨& (cell @x (e (e 0) (e 1)))
         (cell @y
           (group
             (p "2" style: "text-blue-500")
             (p "1" style: "text-blue-500")))⟩)
    (frame pattern: true
      ⟨& (cell @x (e (e 0) (e 1)))
         (cell @y
           (group seen: true
             (p "2" style: "text-blue-500")
             (p "1" style: "text-blue-500")))⟩)
    end)

  (rack
    (frame
      (cell @x (e (d 0) (e 1)))
      (rewriter (@x - (ascR (rulesetR)) - @y)
        ±n => ^(+ n 1)
        (e n_) => ^\n
        (e a_ b_string) <> {a: ^b, b: ^a})
      (cell @y))
    (frame pattern: true
      ⟨& (cell @x (e (d 0) (e 1)))
         (cell @y (e "2" (d 1)))⟩)
    end)

  ;; ascR: impassable selector
  (rack
    (frame
      (cell @x (+ (literal "100") (literal "200") "300"))
      (rewriter (@x - ascR - @y)
        (impassable '_)
        x_string => (seen ^x)
        'x_ => (leaf ^x))
      (cell @y))
    (frame pattern: true
      ⟪(cell @y (+ (leaf "100") (leaf "200") (seen "300")))⟫)
    end)

  ;; ascR: passable
  (rack
    (frame
      (cell @x
        (+ (literal "100") (+ "a" "b") (literal "200") "300"))
      (rewriter (@x - ascR - @y)
        (passable (+ _*))
        x_string => (seen ^x))
      (cell @y))
    (frame pattern: true
      ⟪(cell @y
         (+ (literal "100") (+ (seen "a") (seen "b")) (literal "200") (seen "300")))⟫)
    end)

  ;; ascR: passable + impassable
  (rack
    (frame
      (cell @x
        (+ (literal "100") (+ "a" "b") (literal "200") "300"))
      (rewriter (@x - ascR - @y)
        (passable (+ _*))
        (impassable (+ _ _))
        x_string => (seen ^x))
      (cell @y))
    (frame pattern: true
      ⟪(cell @y
         (+ (literal "100") (+ "a" "b") (literal "200") (seen "300")))⟫)
    end)

  ;; descR: elementary
  (rack
    (frame
      (cell @x (e (d 0) (e 1)))
      (rewriter (@x - (descR (rulesetR)) - @y)
        ±n => ^(+ n 1)
        (e n_) => ^\n
        (e a_ b_string) <> {a: ^b, b: ^a})
      (cell @y))
    (frame pattern: true
      ⟨& (cell @x (e (d 0) (e 1)))
         (cell @y (e (d 1) "1"))⟩)
    end)

  ;; bidiR: elementary
  (rack
    (frame
      (cell @x ((+ "1" (I "2")) ?))
      (part (@x @in) (in_ _))
      (part (@x @out) (_ out_))
      (rewriter (@in - bidiR - @out)
        x_string => (node (token ^x))
        (I (node a_)) => (node (cursor ^a))
        (+ (node a_) (node b_)) => (node (seq ^a "+" ^b))))
    (frame pattern: true
      ⟨& (cell @x ((+ "1" (I "2")) (node (seq (token "1") "+" (cursor (token "2"))))))⟩)
    end)

  ;; waveR elementary
  (rack
    (frame
      (cell @in
        ((x (a 1) (b 2))
         (c)))
      (rewriter (@in -> waveR -> @out)
        (x (a n_) (b m_) ⍊ -sum_) <> {sum: ^(+ n m)}
        (a _ ⍊ -seen_) <> {seen: true}
        (b _ ⍊ -seen_) <> {seen: true}
        (c) => ((c)))
      (cell @out))
    (frame pattern: true
      ⟨(cell @out
         ((x (a 1 seen: true) (b 2 seen: true) sum: 3)
          ((c))))⟩)
    end)

  ;; Extension
  (rack
    (frame
      (cell @in ((x y) z))
      (cell @out)
      (rewriter (@in - ascR - @out)
        x => 100
        y => 200
        (±a ±b) => (result ^(+ a b))
        (a_dict b←z) <> {b: ^a, a: ^b})
      (backsys @out
        {¦ -seen_} <> {seen: true}))
    (frame pattern: true
      ⟨& (cell @in ((x y) z))
         (cell @out (z (result 300)))⟩)
    (frame pattern: true
      ⟨& (cell @in ((x y) z))
         (cell @out (z (result 300) seen: true))⟩)
    end)

  ;; Feed
  (rack
    (frame
      (cell @in ((x y) z))
      (cell @out)
      (rewriter (@in -> ascR -> @out)
        x => 100
        y => 200
        (±a ±b) => (result ^(+ a b))
        (a_dict b←z) <> {b: ^a, a: ^b})
      (backsys @out
        {¦ -seen_} <> {seen: true}))
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out (z (result 300)))⟩)
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out (z (result 300) seen: true))⟩)
    end)

  ;; chainR, rulesetR discriminator
  (rack
    (frame
      (cell @in ((x y) (a b)))
      (cell @out)
      (cell @rewriter
        (chainR
          (ascR (rulesetR discriminator: fst))
          (descR (rulesetR discriminator: snd))))
      (rewriter (@in -> @rewriter -> @out)
        (fst x) => 100
        (fst y) => 200
        (fst (±a ±b)) => ^(+ a b)
        (snd (a_ b_dict)) <> {b: ^a, a: ^b}))
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out ((a b) 300))⟩)
    end)

  ;; chainR -- no change in first
  (rack
    (frame
      (cell @in ((a b) (c d)))
      (cell @out)
      (cell @rewriter
        (chainR
          (ascR (rulesetR discriminator: fst))
          (descR (rulesetR discriminator: snd))))
      (rewriter (@in -> @rewriter -> @out)
        (fst x) => 100
        (fst y) => 200
        (fst (±a ±b)) => ^(+ a b)
        (snd (a_ b_dict)) <> {b: ^a, a: ^b}))
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out ((c d) (a b)))⟩)
    end)

  ;; chainR -- no change in second
  (rack
    (frame
      (cell @in ((x y) c))
      (cell @out)
      (cell @rewriter
        (chainR
          (ascR (rulesetR discriminator: fst))
          (descR (rulesetR discriminator: snd))))
      (rewriter (@in -> @rewriter -> @out)
        (fst x) => 100
        (fst y) => 200
        (fst (±a ±b)) => ^(+ a b)
        (snd (a_ b_dict)) <> {b: ^a, a: ^b}))
    (frame pattern: true
      ⟨& (cell @in)
         (cell @out (300 c))⟩)
    end))

;; Instantiation
(group
  ;; Components are instantiated
  (rack
    (frame
      (Foo) => (Bar 0)
      (slot (Foo)))
    (frame/tail
      (slot (Foo) (Bar 0)))
    end)

  ;; Nested components are instantiated
  (rack
    (frame
      (Foo) => (slot (Bar 0))
      (Bar ±n) => (slot (Qux ^(+ n 1)))
      (Qux n_) => (p ^"Hello, ⸢n⸣")
      (slot (Foo)))
    (frame/tail
      (slot (Foo)
        (slot (Bar 0))))
    (frame/tail
      (slot (Foo)
        (slot (Bar 0)
          (slot (Qux 1)))))
    (frame/tail
      (slot (Foo)
        (slot (Bar 0)
          (slot (Qux 1)
            (p "Hello, 1")))))
    end)

  ;; Specificity is taken into account
  (rack
    (frame
      (Foo ±a) => (cell @x ^a)
      (Foo a_) => (cell @y ^a)
      (Bar a_) => (cell @a ^a)
      (Bar ±a) => (cell @b ^a)
      (slot (Foo 100))
      (slot (Foo qux))
      (slot (Bar 100))
      (slot (Bar qux)))
    (frame/tail
      (slot (Foo 100) (cell @x 100))
      (slot (Foo qux) (cell @y qux))
      (slot (Bar 100) (cell @b 100))
      (slot (Bar qux) (cell @a qux)))
    end)

  ;; Nested components are instantiated in component body
  (rack
    (frame
      (Foo a_)
        => (component {}
             (template (slot (Bar ^a)))
             (slot (Baz))
             (slot (Boo)))
      (Bar ±n) => (cell @x ^n)
      (Baz) => (feed @x @y)
      (Boo) => (cell @y)

      (slot (Foo 123)))

    (frame/tail
      (slot (Foo 123)
        (module {}
          (slot (Bar 123))
          (slot (Baz))
          (slot (Boo)))))

    (frame/tail
      (slot (Foo 123)
        (module {}
          (slot (Bar 123)
            (cell @x 123))
          (slot (Baz)
            (feed @x @y))
          (slot (Boo)
            (cell @y)))))

    (frame/tail
      (slot (Foo 123)
        (module {}
          (slot (Bar 123)
            (cell @x))
          (slot (Baz)
            (feed @x @y))
          (slot (Boo)
            (cell @y 123)))))

    end)

  ;; `template` can be used in passable spots.
  (rack
    (frame
      (Counter value_)
        => (component {}
             (cell @foo
               (template ^value))
             (node @bar
               (group style: "bg-blue-500"
                 (node @view
                   (template (p ^\value))))))
      (slot (Counter 100)))

    (frame/tail
      (slot (Counter 100)
        (module {}
          (cell @foo (template ^value)) ;; impassable
          (node @bar
            (group style: "bg-blue-500"
              (node @view
                (p "100"))))))) ;; passable

    end)

  ;; Templates with multiple children are instantiated as groups
  (rack
    (frame
      (Foo value_)
        => (component {}
             (template
               (cell @a ^(+ value 0))
               (cell @b ^(+ value 1))
               (cell @c ^(+ value 2)))
             (discard @a)
             (discard @b))
      (slot (Foo 100)))

    (frame/tail
      (slot (Foo 100)
        (module {}
          (group
            (cell @a 100)
            (cell @b 101)
            (cell @c 102))
          (discard @a)
          (discard @b))))

    (frame/tail
      (slot (Foo 100)
        (module {}
          (group
            (cell @a)
            (cell @b)
            (cell @c 102))
          (discard @a)
          (discard @b))))

    end)

  ;; Infinite recursion ends at some point due to SAFE_SLOT_DEPTH.
  (rack
    (frame
      (Infinite x_) => (slot (Infinite ^(+ x 1)))
      (slot (Infinite 0)))
    terminates)

  ;; Rule addition invalidates associated slots.
  (rack
    (frame
      (cell @a (Foo x_) => (cell @count0 ^x))
      (feed @a @b)
      (node @b)

      (delay 5
        (cell @x (Bar x_) => (cell @count1 ^x)))
      (feed @x @y)
      (node @y)

      (slot (Foo 100))
      (slot (Bar 200))

      (backsys {@:count0 @:count1}
        {¦ ±count0} <> {count0: ^(+ count0 1)}
        {¦ ±count1} <> {count1: ^(+ count1 1)}))

    (frame pattern: true
      ⟨& (cell @a)
         (node @b (%literal (Foo x_) => (cell @count0 ^x)))
         (delay 4 _)⟩)

    (frame pattern: true
      ⟨& (delay 4 _)
         (slot (Foo 100) (cell @count0 100))⟩)

    (frame pattern: true
      ⟨& (delay 3 _)
         (slot (Foo 100) (cell @count0 101))⟩)

    (frame pattern: true
      ⟨& (delay 2 _)
         (slot (Foo 100) (cell @count0 102))⟩)

    (frame pattern: true
      ⟨& (delay 1 _)
         (slot (Foo 100) (cell @count0 103))⟩)

    (frame pattern: true
      ⟨& (cell @x (Bar x_) => (cell @count1 ^x))
         (slot (Foo 100) (cell @count0 104))⟩)

    (frame pattern: true
      ⟨& (node @y (Bar x_) => (cell @count1 ^x))
         (slot (Foo 100) (cell @count0 105))⟩)

    (frame pattern: true
      ⟨& (node @y (Bar x_) => (cell @count1 ^x))
         (slot (Foo 100) (cell @count0 105))
         (slot (Bar 200) (cell @count1 200))⟩)

    (frame pattern: true
      ⟨& (slot (Foo 100) (cell @count0 106))
         (slot (Bar 200) (cell @count1 201))⟩)

    (frame pattern: true
      ⟨& (slot (Foo 100) (cell @count0 107))
         (slot (Bar 200) (cell @count1 202))⟩)

    (frame pattern: true
      ⟨& (slot (Foo 100) (cell @count0 108))
         (slot (Bar 200) (cell @count1 203))⟩))
    ;; ...

  ;; Rule deletion invalidates associated slots.
  (rack
    (frame
      (node @x (Foo) => (delay 100 foo))
      (delay 5
        (discard @x))

      (Bar) => (delay 100 bar)

      (slot (Foo))
      (slot (Bar)))

    (frame pattern: true
      ⟨& (delay 5 _)
         (slot (Foo) (delay 100 foo))
         (slot (Bar) (delay 100 bar))⟩)

    (frame pattern: true
      ⟨& (delay 4 _)
         (slot (Foo) (delay 99 foo))
         (slot (Bar) (delay 99 bar))⟩)

    (frame pattern: true
      ⟨& (delay 3 _)
         (slot (Foo) (delay 98 foo))
         (slot (Bar) (delay 98 bar))⟩)

    (frame pattern: true
      ⟨& (delay 2 _)
         (slot (Foo) (delay 97 foo))
         (slot (Bar) (delay 97 bar))⟩)

    (frame pattern: true
      ⟨& (delay 1 (discard @x))
         (slot (Foo) (delay 96 foo))
         (slot (Bar) (delay 96 bar))⟩)

    (frame pattern: true
      ⟨& (node @x (Foo) => (delay 100 foo))
         (discard @x)
         (slot (Foo) (delay 95 foo))
         (slot (Bar) (delay 95 bar))⟩)

    (frame pattern: true
      ⟨& (node @x)
         (discard @x)
         (slot (Foo) (delay 94 foo))
         (slot (Bar) (delay 94 bar))⟩)

    (frame pattern: true
      ⟨& (node @x)
         (discard @x)
         (slot (Foo))
         (slot (Bar) (delay 94 bar))⟩)

    (frame pattern: true
      ⟨& (node @x)
         (discard @x)
         (slot (Foo))
         (slot (Bar) (delay 93 bar))⟩))
    ;; ...

  ;; Rule update invalidates associated slots.
  (rack
    (frame
      (node @rule (Foo) => (cell @count 0))
      (Bar) => (delay 100 bar)
      (backsys @rule
        (rule _ (cell @_ ±count))
          <> {count: ^(+ count 1)})

      (slot (Foo))
      (slot (Bar)))

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 0))
         (slot (Foo) (cell @count 0))
         (slot (Bar) (delay 100 bar))⟩)

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 1))
         (slot (Foo) (cell @count 0))
         (slot (Bar) (delay 99 bar))⟩)

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 1))
         (slot (Foo) (cell @count 1))
         (slot (Bar) (delay 99 bar))⟩)

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 2))
         (slot (Foo) (cell @count 1))
         (slot (Bar) (delay 98 bar))⟩)

    (frame pattern: true
      ⟨& (node @rule (Foo) => (cell @count 2))
         (slot (Foo) (cell @count 2))
         (slot (Bar) (delay 98 bar))⟩))
    ;;; ...

  ;; Slots can be constructed & are instantiated dynamically.
  (rack
    (frame
      (Foo n_) => (cell @x ^n)
      (cell @arg 0)
      (transfer (@arg n_ @node) (slot (Foo ^n)))
      (frag @node)
      (feed @x @y)
      (cell @y))

    (frame
      (Foo n_) => (cell @x ^n)
      (cell @arg)
      (transfer (@arg n_ @node) (slot (Foo ^n)))
      (frag @node (slot (Foo 0)))
      (feed @x @y)
      (cell @y))

    (frame
      (Foo n_) => (cell @x ^n)
      (cell @arg)
      (transfer (@arg n_ @node) (slot (Foo ^n)))
      (frag @node (slot (Foo 0) (cell @x 0)))
      (feed @x @y)
      (cell @y))

    (frame
      (Foo n_) => (cell @x ^n)
      (cell @arg)
      (transfer (@arg n_ @node) (slot (Foo ^n)))
      (frag @node (slot (Foo 0) (cell @x)))
      (feed @x @y)
      (cell @y 0))

    end)

  ;; Many slots from the same rule (add & remove).
  (rack
    (frame
      (delay 3
        (node @rule (Foo n_) => ^n))
      (delay 5
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John")))
    (frame
      (delay 3
        (node @rule (Foo n_) => ^n))
      (delay 5
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    (frame
      (delay 2
        (node @rule (Foo n_) => ^n))
      (delay 4
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    (frame
      (delay 1
        (node @rule (Foo n_) => ^n))
      (delay 3
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule (Foo n_) => ^n)
      (delay 2
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule (Foo n_) => ^n)
      (delay 2
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0) 0)
      (slot (Foo 1) 1)
      (slot (Foo 2) 2)
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule (Foo n_) => ^n)
      (delay 1
        (discard @rule))
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0) 0)
      (slot (Foo 1) 1)
      (slot (Foo 2) 2)
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule (Foo n_) => ^n)
      (discard @rule)
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0) 0)
      (slot (Foo 1) 1)
      (slot (Foo 2) 2)
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule)
      (discard @rule)
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0) 0)
      (slot (Foo 1) 1)
      (slot (Foo 2) 2)
      (slot (Bar "John") "Kaixo John"))
    (frame
      (node @rule)
      (discard @rule)
      (Bar name_) => ^"Kaixo ⸢name⸣"
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Bar "John") "Kaixo John"))
    end)

  ;; Many slots from the same rule (update).
  (rack
    (frame
      (node @rule (Foo 0) => "Kaixo")
      (backsys @rule
        (rule (Foo ±n) _) <> {n: ^(mod (+ n 1) 4)})
      (Bar) => (delay 100 qux)
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar)))
    (frame/tail
      (slot (Foo 0) "Kaixo")
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 100 qux)))
    (frame
      (node @rule (Foo 1) => "Kaixo")
      (backsys @rule
        (rule (Foo ±n) _) <> {n: ^(mod (+ n 1) 4)})
      (Bar) => (delay 100 qux)
      (slot (Foo 0) "Kaixo")
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 99 qux)))
    (frame/tail
      (slot (Foo 0))
      (slot (Foo 1) "Kaixo")
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 99 qux)))
    (frame/tail
      ;; (Foo 2) => ...
      (slot (Foo 0))
      (slot (Foo 1) "Kaixo")
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 98 qux)))
    (frame/tail
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2) "Kaixo")
      (slot (Foo 3))
      (slot (Bar) (delay 98 qux)))
    (frame/tail
      ;; (Foo 3) => ...
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2) "Kaixo")
      (slot (Foo 3))
      (slot (Bar) (delay 97 qux)))
    (frame/tail
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3) "Kaixo")
      (slot (Bar) (delay 97 qux)))
    (frame/tail
      ;; (Foo 0) => ...
      (slot (Foo 0))
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3) "Kaixo")
      (slot (Bar) (delay 96 qux)))
    (frame/tail
      (slot (Foo 0) "Kaixo")
      (slot (Foo 1))
      (slot (Foo 2))
      (slot (Foo 3))
      (slot (Bar) (delay 96 qux))))
    ;; ...

  ;; Module creates rule scope.
  (rack
    (frame
      (backsys @lab
        ((_* `dst) rule_ _) <> {dst: ^rule, (rule): ()}
        ((_* rule_) `dst _) <> {dst: ^rule, (rule): ()})
      (circuit @lab
        (module {})
        (Foo) => 100
        (slot (Foo))))

    (frame/tail
      (circuit @lab
        (module {})
        (Foo) => 100
        (slot (Foo) 100)))

    (frame/tail
      (circuit @lab
        (module {} (Foo) => 100)
        (slot (Foo) 100)))

    (frame/tail
      (circuit @lab
        (module {} (Foo) => 100)
        (slot (Foo))))

    (frame/tail
      (circuit @lab
        (module {})
        (Foo) => 100
        (slot (Foo))))

    (frame/tail
      (circuit @lab
        (module {})
        (Foo) => 100
        (slot (Foo) 100)))))
    ;; ...

;; BUG: Make sure append and prepend on the same cell are not merged
;; (and related).
(group
  (rack
    (frame
      (cell @x (a b))
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200}))
    (frame
      (cell @x (b)) ;; < nodes whose addr is smaller win
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200}))
    (frame
      (cell @x ())
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200}))
    (frame
      (cell @x (200))
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200}))
    (frame
      (cell @x ())
      (backsys @x  (front_ _*) <> {(front): ()})
      (backsys @x  (_* `back) <> {back: 200})))
    ;; ...

  (rack
    (frame
      (cell @x (a b))
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  (front_ _*) <> {(front): ()}))
    (frame
      (cell @x (a b 200)) ;; < nodes whose addr is smaller win
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  (front_ _*) <> {(front): ()}))
    (frame
      (cell @x (a b 200 200))
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  (front_ _*) <> {(front): ()})))
    ;; ...

  (rack
    (frame
      (cell @x (a b))
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  {¦ -flag_} <> {flag: true}))
    (frame
      (cell @x (a b 200 flag: true)) ;; < since the flag backsys doesn't modify itemsize it's merged!
      (backsys @x  (_* `back) <> {back: 200})
      (backsys @x  {¦ -flag_} <> {flag: true}))
    end))

;; Cell rewriting
(group
  (rack
    (frame
      (cell @spec (rulesetR))
      (cell @n 0)
      (rewriter (@spec <-> {@:n})
        {¦ ±n} <> {n: ^(+ n 1)}))
    (frame pattern: true
      ⟨(cell @n 1)⟩)
    (frame pattern: true
      ⟨(cell @n 2)⟩))
    ;; ...

  (rack
    (frame
      (cell @n 0)
      (rewriter ((rulesetR) <-> {@:n})
        {¦ ±n} <> {n: ^(+ n 1)}))
    (frame pattern: true
      ⟨(cell @n 1)⟩)
    (frame pattern: true
      ⟨(cell @n 2)⟩))
    ;; ...

  (rack
    (frame
      (cell @n 0)
      (cell @m)
      (rewriter ((rulesetR) <-> {@:n @:m})
        {¦ ±n -m_} <> {m: (counter ^n)}
        {¦ ±n m: (counter ±m)} <> {n: ^(+ n 1), m: ^n}
        {¦ ±n m_: (counter 3)} <> {(n): (), (m): ()}))
    (frame pattern: true
      ⟨& (cell @n 0)
         (cell @m (counter 0))⟩)
    (frame pattern: true
      ⟨& (cell @n 1)
         (cell @m (counter 0))⟩)
    (frame pattern: true
      ⟨& (cell @n 2)
         (cell @m (counter 1))⟩)
    (frame pattern: true
      ⟨& (cell @n 3)
         (cell @m (counter 2))⟩)
    (frame pattern: true
      ⟨& (cell @n 4)
         (cell @m (counter 3))⟩)
    (frame pattern: true
      ⟨& (cell @n)
         (cell @m)⟩)
    end))

;; BUG: Make sure D7.resolve() is used in D7.permutation()
(rack
  (frame
    (cell @x 0)
    (module {@xs: @x}
      (cell @x 100)
      (cell @y)
      (feed @xs @y)))
  (frame
    (cell @x)
    (module {@xs: @x}
      (cell @x 100)
      (cell @y 0)
      (feed @xs @y)))
  end)

;; BUG: Single-expression template must expand into group on plural
;; top-level splice.
(group
  ;; zero
  (rack
    (frame
      (Qux) =>
        (component {}
          (template
            (^splice)))
        (slot (Qux)))
    (frame/tail
      (slot (Qux)
        (module {}
          (group))))
    end)
  ;; one
  (rack
    (frame
      (Qux) =>
        (component {}
          (template
            (^splice 1)))
        (slot (Qux)))
    (frame/tail
      (slot (Qux)
        (module {}
          1)))
    end)
  ;; many
  (rack
    (frame
      (Qux) =>
        (component {}
          (template
            (^splice 1 2 3)))
        (slot (Qux)))
    (frame/tail
      (slot (Qux)
        (module {}
          (group 1 2 3))))
    end))
