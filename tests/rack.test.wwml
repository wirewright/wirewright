  ;; Removing all appearances with view sensor must clear its view.
  (d7
    (frame
      ((sensor* cell) (local x_ @x))
      ((appearance cell) (local @a) 100)
      ((appearance cell) (local @b) 200)
      ((appearance cell) (local @c) 300)
      (delay 2
        (group
          (discard @a)
          (discard @b)
          (discard @c))))
    (frame
      ((sensor* cell) (local x_ @x) (100 200 300))
      ((appearance cell) (local @a) 100)
      ((appearance cell) (local @b) 200)
      ((appearance cell) (local @c) 300)
      (delay 1
        (group
          (discard @a)
          (discard @b)
          (discard @c))))
    (frame
      ((sensor* cell) (local x_ @x) (100 200 300))
      ((appearance cell) (local @a) 100)
      ((appearance cell) (local @b) 200)
      ((appearance cell) (local @c) 300)
      (group
        (discard @a)
        (discard @b)
        (discard @c)))
    (frame
      ((sensor* cell) (local x_ @x) (100 200 300))
      ((appearance cell) (local @a))
      ((appearance cell) (local @b))
      ((appearance cell) (local @c))
      (group
        (discard @a)
        (discard @b)
        (discard @c)))
    (frame
      ((sensor* cell) (local x_ @x) ())
      ((appearance cell) (local @a))
      ((appearance cell) (local @b))
      ((appearance cell) (local @c))
      (group
        (discard @a)
        (discard @b)
        (discard @c)))
    end)

