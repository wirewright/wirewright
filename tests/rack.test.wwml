      (feed @front @input)
      (discard @output)
      (cell @input)
      (cell @output))
    (frame/tail (cell @input "") (cell @output))
    (frame/tail (cell @input) (cell @output empty))
    (frame/tail (cell @input "x") (cell @output))
    (frame/tail (cell @input) (cell @output (N empty)))
    (frame/tail (cell @input "xx") (cell @output))
    (frame/tail (cell @input) (cell @output (N (N empty))))
    (frame/tail (cell @input "xxx") (cell @output))
    (frame/tail (cell @input) (cell @output (N (N (N empty)))))
    (frame/tail (cell @input) (cell @output))
    end)

