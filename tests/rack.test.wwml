  ;; Sensor-appearance timing with circuits.
  (rack
    (frame
      (circuit @nested
        (sensor (local percept_ @percept) ^percept)
        (cell @percept))
      (delay 2 (cell @stimulus "Hello World"))
      (appearance local @stimulus)
      (extension (@nested ⟨node←(cell @percept _*)⟩ @percept-view) ^node)
      (cell @percept-view))
    (frame
      (circuit @nested
        (sensor (local percept_ @percept) ^percept)
        (cell @percept))
      (delay 1 (cell @stimulus "Hello World"))
      (appearance local @stimulus)
      (extension (@nested ⟨node←(cell @percept _*)⟩ @percept-view) ^node)
      (cell @percept-view (cell @percept)))
    (frame
      (circuit @nested
        (sensor (local percept_ @percept) ^percept)
        (cell @percept))
      (cell @stimulus "Hello World")
      (appearance local @stimulus)
      (extension (@nested ⟨node←(cell @percept _*)⟩ @percept-view) ^node)
      (cell @percept-view (cell @percept)))
    (frame
      (circuit @nested
        (sensor (local percept_ @percept) ^percept)
        (cell @percept "Hello World"))
      (cell @stimulus)
      (appearance local @stimulus)
      (extension (@nested ⟨node←(cell @percept _*)⟩ @percept-view) ^node)
      (cell @percept-view (cell @percept)))
    (frame
      (circuit @nested
        (sensor (local percept_ @percept) ^percept)
        (cell @percept "Hello World"))
      (cell @stimulus)
      (appearance local @stimulus)
      (extension (@nested ⟨node←(cell @percept _*)⟩ @percept-view) ^node)
      (cell @percept-view (cell @percept "Hello World")))
    end)

