  ;; View of N cells (delay, queue, mismatch)
  (d7
    (frame
      (queue (@command @back) (greet welcome greet))
      (delay 2 (discard @command))
      (cell @name "Mary")
      (cell @age 26)
      (view ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output))
    (frame
      (queue (@command @back) (greet welcome greet))
      (delay 1 (discard @command))
      (cell @name "Mary")
      (cell @age 26)
      (view ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) (greet welcome greet))
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (view ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) (welcome greet))
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (view ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) (greet))
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (view ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output))
    (frame
      (queue (@command @back) ())
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (view ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) ())
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (view ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output))
    end)

  ;; Toplevel Alloy errors should prevent consumption
  (d7
    (frame
      (sensor (local x_ @x) ^x)
      (cell @x)
      (sensor (local y_ @y) ^qux)
      (cell @y)
      (sensor (local z_ @z) ^z)
      (cell @z)
      ((appearance cell) (local @m) 100))
    (frame
      (sensor (local x_ @x) ^x)
      (cell @x 100)
      (sensor (local y_ @y) ^qux)
      (cell @y)
      (sensor (local z_ @z) ^z)
      (cell @z 100)
      ((appearance cell) (local @m)))
    end)
  (d7
    (frame
      (sensor (local x_ @x) ^foo)
      (cell @x)
      (sensor (local y_ @y) ^bar)
      (cell @y)
      (sensor (local z_ @z) ^baz)
      (cell @z)
      ((appearance cell) (local @m) 100))
    end))

;; Elementary 1D movement circuit
(group
  ;; Basic
  (d7
    (frame
      (circuit @world
        .
        .
        (module {}
          (cell @id foo)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        .
        .
        .)
      (backsys @world
        W←⟨⟨[cell @world (%optional () w_)]⟩⟩°
          <> {w: ^(backmap W '⟨M←⟨[cell @id id_]⟩⟩° '{M: ^id})}
        ⟨A_ B←⟨[cell @dir up]⟩⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}
        ⟨A←⟨[cell @dir dn]⟩ B_⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}))
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world M_dict . . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . M_dict . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . M_dict . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . M_dict . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . M_dict . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . M_dict .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . . M_dict]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . M_dict .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . M_dict . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . M_dict . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . M_dict . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . M_dict . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫))
    ;; ...

  ;; Multiple modules
  (d7
    (frame
      (circuit @world
        .
        .
        (module {}
          (cell @id foo)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        (module {}
          (cell @id bar)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        .)
      (backsys @world
        W←⟨⟨[cell @world (%optional () w_)]⟩⟩°
          <> {w: ^(backmap W '⟨M←⟨[cell @id id_]⟩⟩° '{M: ^id})}
        ⟨A_ B←⟨[cell @dir up]⟩⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}
        ⟨A←⟨[cell @dir dn]⟩ B_⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}))
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ ⟨[cell @id bar]⟩ . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id bar]⟩ ⟨[cell @id foo]⟩ . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . . ⟨[cell @id bar]⟩ ⟨[cell @id foo]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . . ⟨[cell @id foo]⟩ ⟨[cell @id bar]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . .]⟫)))
    ;; ...

;; Elementary breakdown (regression test)
(d7
  (frame
    (cell @mouth
      (module {}
        (cell @name "John Doe")
        (cell @age 26)
        (cell @comment "It's pretty dark in here . . .")))
    (feed @mouth (@sack back))
    ;; Breakdown of arbitrary structure into particles (here, for demonstration
    ;; purposes, they are %atom's as per M1).
    (group
      (cell @sack ())
      (cell @particles ())
      (backsys {@:sack @:particles}
        {¦ sack: (particle←(%atom) _*) particles: (_* `atom)}
          <> {(particle): (), atom: ^particle}
        {¦ sack: (particle←(items_* ¦ pairs_) _*)}
          <> {(particle): (^*items ^*(entries pairs))})
      (feed (@particles front) @particle))
    ;; Breakdown of particles into strands of runes.
    (group
      (cell @particle)
      (transfer (@particle p_ @strand) ^(term->ml p)))
    ;; Breakdown of strands of runes into individual runes.
    (group
      (cell @strand)
      (backsys {@:strand @:rune}
        {¦ strand_: ""} <> {(strand): ()}
        {¦ strand_: (%string nonempty) -rune_}
          <> {rune: ^(rune strand 0), strand: ^(runes strand 1 ..= -1)}))
    ;; Breakdown of runes into chains of bases.
    (group
      (cell @rune)
      (transfer (@rune rune_string @base-chain)
        ^(repr (codepoints rune) '(digits alphabet: "ABCD"))))
    ;; Breakdown of chains of bases into bases.
    (group
      (cell @base-chain)
      (backsys {bases: @base-chain, @:base}
        {¦ bases_: ()} <> {(bases): ()}
        {¦ bases_: (B_string _*) -base_}
          <> {(B): (), base: ^B}))
    ;; Movement of bases into the base pool.
    (group
      (cell @base)
      (backsys {@:base @:pool}
        {¦ base_ pool_dict}
          <> {(base): (), pool: ^(mset/union pool (entry base 1))}))
    (cell @pool ()))
  (frame pattern: true future: true
    ⟨[cell @pool {"A": 56, "B": 132, "C": 96, "D": 50}]⟩)
  end)

;; Handling of disjoint and non-disjoint writes to the same location.
(group
  ;; Disjoint writes must all succeed.
  (d7
    (frame
      (cell @x {"A": 100, "B": 200, "C": 300})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)}))
    (frame
      (cell @x {"A": 99, "B": 400, "C": 301})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)}))
    (frame
      (cell @x {"A": 98, "B": 800, "C": 302})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)})))
    ;; ...

  ;; Insertions in the middle conflict with other write(s).
  ;;
  ;; NOTE: Here we see the unconditional suppression of insertion which
  ;; is supposed to be a deterministic, but not exactly human-
  ;; comprehensible choice.
  (d7
    (frame
      (cell @x (+ 1 2))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"}))
    (frame
      (cell @x (+ 2 3 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"}))
    (frame
      (cell @x (+ 3 4 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"})))
    ;; ...

  ;; We can "fix" conflicts like these with explicit staging. Rack
  ;; won't be able to do anything about them on its own, because the
  ;; conflicts above are, in a sense, as "pure" as conflicts go.
  (d7
    (frame
      (cell @x (+ 1 2))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ¦ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 1 2 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ¦ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 2 3 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ¦ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 3 4 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ¦ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))))
    ;; ...
