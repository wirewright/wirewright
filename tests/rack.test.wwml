    (frame/tail (cell @input "+7+8+9+10+11+12") (cell @output))
    (frame/tail (cell @input) (cell @output (+ ((+ ((+ ((+ ((+ ((+ () 7)) 8)) 9)) 10)) 11)) 12)))
    (frame/tail (cell @input "") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "+") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "1+") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "++1") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "1++2") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "+1+") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "1+2+") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "1+2+3+") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    end)

  (rack
    (frame
      (parser (@input -> a -> @output)
        (a l←a "") => (N ^l)
        (a "x") => "x")
      (queue (@front @back)
        ("" "x" "xx" "xxx"))
      (feed @front @input)
      (discard @output)
      (cell @input)
      (cell @output))
    (frame/tail (cell @input "") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "x") (cell @output))
    (frame/tail (cell @input) (cell @output "x"))
    (frame/tail (cell @input "xx") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure due to cyclic production, we simply shouldn't crash or SEGFAULT!
    (frame/tail (cell @input "xxx") (cell @output))
    (frame/tail (cell @input) (cell @output))
    end)

  (rack
    (frame
      (parser (@input -> a -> @output)
        (a l←a "x") => (N ^l)
        (a "") => empty)
      (queue (@front @back)
