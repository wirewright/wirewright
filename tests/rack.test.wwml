        {¦ l: (±a _*) r: (b←(%number _ < (var a)) _*) out: (_* `dst)}
          <> {(b): (), dst: ^b}
        {¦ l_: (_+) r: () out: (_* `dst)}
          <> {l: (), (dst): ^l}
        {¦ l: () r_: (_+) out: (_* `dst)}
