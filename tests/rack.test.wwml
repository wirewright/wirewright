      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
      (backsys @n  ±n <> {n: ^(- n 1)})
      (discard @x)
      (discard @y)
      (discard @z))
    (frame
      (cell @top (qux 1 x: 100))
      (part (@top @n) [qux n←(%number 1 < _ <= 3)])
      (part (@top @x) (qux 1 ⍊ x_))
      (part (@top @y) (qux 2 ⍊ y_))
      (part (@top @z) (qux 3 ⍊ z_))
