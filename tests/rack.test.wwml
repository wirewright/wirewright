      ((sensor* cell) (local even←(%pipe (mod 2) 0) @even) (100 300))
      ((sensor* cell) (local odd←(%pipe (mod 2) (%not 0)) @odd) (201))
      ((appearance cell) (local @x) 101)
      ((appearance cell) (local @y) 202)
      ((appearance cell) (local @z) 301)
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)})
      (backsys @z  ±n <> {n: ^(+ n 1)}))
    (frame
      ((sensor* cell) (local even←(%pipe (mod 2) 0) @even) (202))
      ((sensor* cell) (local odd←(%pipe (mod 2) (%not 0)) @odd) (101 301))
      ((appearance cell) (local @x) 102)
      ((appearance cell) (local @y) 203)
      ((appearance cell) (local @z) 302)
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)})
      (backsys @z  ±n <> {n: ^(+ n 1)}))
    (frame
      ((sensor* cell) (local even←(%pipe (mod 2) 0) @even) (102 302))
      ((sensor* cell) (local odd←(%pipe (mod 2) (%not 0)) @odd) (203))
      ((appearance cell) (local @x) 103)
      ((appearance cell) (local @y) 204)
      ((appearance cell) (local @z) 303)
      (backsys @x  ±n <> {n: ^(+ n 1)})
