;; so let's have them in tests!
(rack
  (frame
    (rewriter ((rulesetR) <-> {@:unsorted, @:sorted, @:workspace, @:busy})
      {¦ unsorted: (±n _*) workspace: (_* `dst)}
        <> {dst: (^n), (n): ()}
      {¦ unsorted: (±n ±m _*) workspace: (_* `dst)}
        <> {dst: (^n ^m), (n): (), (m): ()}
      {¦ unsorted: (±n m←(%number _ < (var n)) _*) workspace: (_* `dst)}
        <> {dst: (^m ^n), (n): (), (m): ()}
      {¦ busy: 0 unsorted_: () -sorted_ workspace: (a_dict)}
        <> {(a): (), (unsorted): (), sorted: ^a})
    (cell @workspace ())
    (cell @busy 0)
    (module {:@workspace, :@busy}
      (cell @l)
      (cell @r)
      (cell @out ())
      (rewriter ((rulesetR) <-> {@:workspace, @:busy, @:l, @:r, @:out})
        {¦ workspace: (a_dict b_dict _*) -l_ -r_ ±busy}
          <> {(a): (), (b): (), l: ^a, r: ^b, busy: ^(+ busy 1)}
        {¦ workspace: (_* `dst) l_: () r_: () out_: (_*) ±busy}
