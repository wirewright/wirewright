      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @c) c_)
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo 1))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @c) c_)
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo 2))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @c) c_)
      (backsys @c  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Loop with branches
  (d7
    (frame
      (cell @top (foo (10 20)))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @x) (x_ _))
      (part (@b @y) (_ y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo (11 21)))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @x) (x_ _))
      (part (@b @y) (_ y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo (12 22)))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @x) (x_ _))
      (part (@b @y) (_ y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Dyn mismatch manipulate
  (d7
    (frame
      (cell @top (foo 0 0))
      (part (@top @a) (foo a←(%number 3 <= _ <= 7) _))
      (part (@top @b) (foo _ b←(%number 7 <= _ <= 11)))
      (backsys {@:top @:a @:b}
        {¦ top: (foo ±n _) -a} <> {n: ^(+ n 1)}
        {¦ top: (foo _ ±n) -b} <> {n: ^(+ n 1)}))
    (frame pattern: true
      ⟪(foo 1 1)⟫)
    (frame pattern: true
      ⟪(foo 2 2)⟫)
    (frame pattern: true
      ⟪(foo 3 3)⟫)
    (frame pattern: true
      ⟪(foo 3 4)⟫)
    (frame pattern: true
      ⟪(foo 3 5)⟫)
    (frame pattern: true
      ⟪(foo 3 6)⟫)
    (frame pattern: true
      ⟪(foo 3 7)⟫)
    end)

  ;; Basic
  (d7
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @top (qux (2 2) (3 8)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @top (qux (3 2) (3 16)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(* n 2)})))
    ;; ...

  ;; Removal of item
  (d7
    (frame
      (cell @top (qux (1 2 3) (4 5 6)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst)
      (discard @dst))
    (frame
      (cell @top (qux (2 3) (4 5)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst (1 6))
      (discard @dst))
    (frame
      (cell @top (qux (2 3) (4 5)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst)
      (discard @dst))
    (frame
      (cell @top (qux (3) (4)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst (2 5))
      (discard @dst))
    (frame
      (cell @top (qux (3) (4)))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst)
      (discard @dst))
    (frame
      (cell @top (qux () ()))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst (3 4))
      (discard @dst))
    (frame
      (cell @top (qux () ()))
      (part (@top @a) (qux a_ _))
      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (feed (@x @y) @dst)
      (cell @dst)
      (discard @dst))
