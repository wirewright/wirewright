;; Elementary 1D movement circuit
(group
  ;; Basic
  (d7
    (frame
      (circuit @world
        .
        .
        (module {}
          (cell @id foo)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        .
        .
        .)
      (backsys @world
        W←⟨⟨[cell @world (%optional () w_)]⟩⟩°
          <> {w: ^(backmap W '⟨M←⟨[cell @id id_]⟩⟩° '{M: ^id})}
        ⟨A_ B←⟨[cell @dir up]⟩⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}
        ⟨A←⟨[cell @dir dn]⟩ B_⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}))
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world M_dict . . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . M_dict . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . M_dict . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . M_dict . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . M_dict . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . M_dict .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . . M_dict]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . M_dict .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . M_dict . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . M_dict . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . M_dict . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . M_dict . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫))
    ;; ...

  ;; Multiple modules
  (d7
    (frame
      (circuit @world
        .
        .
        (module {}
          (cell @id foo)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        (module {}
          (cell @id bar)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        .)
      (backsys @world
        W←⟨⟨[cell @world (%optional () w_)]⟩⟩°
          <> {w: ^(backmap W '⟨M←⟨[cell @id id_]⟩⟩° '{M: ^id})}
        ⟨A_ B←⟨[cell @dir up]⟩⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}
        ⟨A←⟨[cell @dir dn]⟩ B_⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}))
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ ⟨[cell @id bar]⟩ . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id bar]⟩ ⟨[cell @id foo]⟩ . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . . ⟨[cell @id bar]⟩ ⟨[cell @id foo]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . . ⟨[cell @id foo]⟩ ⟨[cell @id bar]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . .]⟫)))
    ;; ...

;; Elementary breakdown (regression test)
(d7
  (frame
    (cell @mouth
      (module {}
        (cell @name "John Doe")
        (cell @age 26)
        (cell @comment "It's pretty dark in here . . .")))
    (feed @mouth (@sack back))
    ;; Breakdown of arbitrary structure into particles (here, for demonstration
    ;; purposes, they are %atom's as per M1).
    (group
      (cell @sack ())
      (cell @particles ())
      (backsys {@:sack @:particles}
        {¦ sack: (particle←(%atom) _*) particles: (_* `atom)}
          <> {(particle): (), atom: ^particle}
        {¦ sack: (particle←(items_* ¦ pairs_) _*)}
          <> {(particle): (^*items ^*(entries pairs))})
      (feed (@particles front) @particle))
    ;; Breakdown of particles into strands of runes.
    (group
      (cell @particle)
      (transfer (@particle p_ @strand) ^(term->ml p)))
    ;; Breakdown of strands of runes into individual runes.
    (group
      (cell @strand)
      (backsys {@:strand @:rune}
        {¦ strand_: ""} <> {(strand): ()}
        {¦ strand_: (%string nonempty) -rune_}
          <> {rune: ^(rune strand 0), strand: ^(runes strand 1 ..= -1)}))
    ;; Breakdown of runes into chains of bases.
    (group
      (cell @rune)
      (transfer (@rune rune_string @base-chain)
        ^(repr (codepoints rune) '(digits alphabet: "ABCD"))))
    ;; Breakdown of chains of bases into bases.
    (group
      (cell @base-chain)
      (backsys {bases: @base-chain, @:base}
        {¦ bases_: ()} <> {(bases): ()}
        {¦ bases_: (B_string _*) -base_}
          <> {(B): (), base: ^B}))
    ;; Movement of bases into the base pool.
    (group
      (cell @base)
      (backsys {@:base @:pool}
        {¦ base_ pool_dict}
          <> {(base): (), pool: ^(mset/union pool (entry base 1))}))
    (cell @pool ()))
  (frame pattern: true future: true
    ⟨[cell @pool {"A": 56, "B": 132, "C": 96, "D": 50}]⟩)
  end)

;; Handling of disjoint and non-disjoint writes to the same location.
(group
  ;; Disjoint writes must all succeed.
  (d7
    (frame
      (cell @x {"A": 100, "B": 200, "C": 300})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)}))
    (frame
      (cell @x {"A": 99, "B": 400, "C": 301})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)}))
    (frame
      (cell @x {"A": 98, "B": 800, "C": 302})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)})))
    ;; ...

  ;; Insertions in the middle conflict with other write(s).
  ;;
  ;; NOTE: Here we see the unconditional suppression of insertion which
  ;; is supposed to be a deterministic, but not exactly human-
  ;; comprehensible choice.
  (d7
    (frame
      (cell @x (+ 1 2))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"}))
    (frame
      (cell @x (+ 2 3 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"}))
    (frame
      (cell @x (+ 3 4 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"})))
    ;; ...

  ;; We can "fix" conflicts like these with explicit staging. Rack
  ;; won't be able to do anything about them on its own, because the
  ;; conflicts above are, in a sense, as "pure" as conflicts go.
  (d7
    (frame
      (cell @x (+ 1 2))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 1 2 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊  qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 2 3 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 3 4 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))))
    ;; ...

;; part
(group
  ;; Chain of length 1
  (d7
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux (_ a_) _))
      (feed (copy @a) @b)
      (cell @b))
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux (_ a_) _))
      (feed (copy @a) @b)
      (cell @b 2))
    end)

  ;; Chain of length 2
  (d7
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view)
      (cell @b-view))
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view (1 2))
      (cell @b-view 2))
    end)

  ;; Chain of length 3
  (d7
    (frame
      (cell @top (qux (1 {name: "Samantha"}) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (part (@b @c) {¦ name: c_string})
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (feed (copy @c) @c-view)
      (cell @a-view)
      (cell @b-view)
      (cell @c-view))
    (frame
      (cell @top (qux (1 {name: "Samantha"}) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (part (@b @c) {¦ name: c_string})
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (feed (copy @c) @c-view)
      (cell @a-view (1 {name: "Samantha"}))
      (cell @b-view {name: "Samantha"})
      (cell @c-view "Samantha"))
    end)

  ;; Branching
  (d7
    (frame
      (cell @root
        {xs: (1 2 3), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}), responses: ()})
      (part (@root @xs) {¦ xs_})
      (part (@root @y) {¦ y_})
      (part (@root @zs) {¦ zs_})
      (part (@root @responses) {¦ responses_})
      (part (@xs @x) (x_ _*))
      (part (@zs @z) (z_ _*))
      (part (@z @a) {¦ a_})
      (part (@z @b) {¦ b_})
      (backsys {@:x @:y @:a @:b @:responses}
        {¦ ±x ±y ±a ±b responses: (_* `back)}
          <> {(x): (), back: {^:x ^:y ^:a ^:b}}))
    (frame pattern: true
      ⟪(cell @root
         {xs: (2 3), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}),
          responses: ({x: 1, y: 4, a: 5, b: 6})})⟫)
    (frame pattern: true
      ⟪(cell @root
         {xs: (3), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}),
          responses: ({x: 1, y: 4, a: 5, b: 6}
                      {x: 2, y: 4, a: 5, b: 6})})⟫)
    (frame pattern: true
      ⟪(cell @root
         {xs: (), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}),
          responses: ({x: 1, y: 4, a: 5, b: 6}
                      {x: 2, y: 4, a: 5, b: 6}
                      {x: 3, y: 4, a: 5, b: 6})})⟫)
    end)

  ;; Loop
  (d7
    (frame
      (cell @top (foo 0))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view)
      (cell @b-view))
    (frame
      (cell @top (foo 0))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view 0)
      (cell @b-view 0))
    end)

  ;; Loop with branch
