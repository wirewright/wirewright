  ;; Radix in nat form
  (rack
    (frame
      ;; Unary
      (parser (@input1 -> num -> @output1)
        (num (form "[1]+" (nat radix: 1))))
      ;; Binary
      (parser (@input2 -> num -> @output2)
        (num (form "[%b]+" (nat radix: 2))))
      ;; Ternary
      (parser (@input3 -> num -> @output3)
        (num (form "[012]+" (nat radix: 3))))
      ;; Octal
      (parser (@input8 -> num -> @output8)
        (num (form "[%o]+" (nat radix: 8))))
      ;; Hex
      (parser (@input16 -> num -> @output16)
        (num (form "[%x]+" (nat radix: 16))))
      ;; Base32
      (parser (@input32 -> num -> @output32)
        (num (form "[0-9A-V]+" (nat radix: 32))))
      ;; Base62
      (parser (@input62 -> num -> @output62)
        (num (form "[0-9a-zA-Z]+" (nat radix: 62))))
      (cell @input1 "11111")
      (cell @output1)
      (cell @input2 "0101010")
      (cell @output2)
      (cell @input3 "1120")
      (cell @output3)
      (cell @input8 "52")
      (cell @output8)
      (cell @input16 "deadbeef")
      (cell @output16)
      (cell @input32 "HELLO")
      (cell @output32)
      (cell @input62 "HELLOworld123")
      (cell @output62))
    (frame/tail fast-forward: true ;; Since we have many parsers the order is indeterminate (in theory),
                                   ;; so we have to use fast-forward.
      (cell @input1)
      (cell @output1 5)
      (cell @input2)
      (cell @output2 42)
      (cell @input3)
      (cell @output3 42)
      (cell @input8)
      (cell @output8 42)
      (cell @input16)
      (cell @output16 3735928559)
      (cell @input32)
      (cell @output32 18306744)
      (cell @input62)
      (cell @output62 55592961823144174755099))
    end)

  (rack
    (frame
      (parser (@input -> json -> @output)
        (json element)
        (value object)
        (value array)
        (value string)
        (value number)
        (value "true") => true
        (value "false") => false
        (value "null") => null
        (object "{" ws "}") => {}
        (object "{" members←(many member "," min: 1 trailing: true) "}")
          => ^(reduce ({} members)
                (fn (memo_dict (k_ v←(%not null)))
                  (union memo (entry k v))))
        (member ws key←string ws ":" value←element) => (^key ^value)
        (array "[" ws "]") => ()
        (array "[" elements←(many element "," min: 1 trailing: true) "]") => ^elements
        (element ws mid←value ws) => ^mid
        (string "\"" content←(many segment) "\"") => ^(join content)
        (segment chr←"[\x20-\u{10FFFF}^\"\\]+") => ^chr
        (segment "\\" chr←escape) => ^chr
        (escape "\"") => "\""
        (escape "\\") => "\\"
        (escape "/") => "/"
        (escape "b") => "\b"
        (escape "f") => "\f"
        (escape "n") => "\n"
        (escape "r") => "\r"
        (escape "t") => "\t"
        (escape "u" codepoint←(form "%|xxxx|" (nat radix: 16))) => ^(chr codepoint)
        (number S←sign base←nat fr←fraction exp←exponent) => ^(* S (+ base fr) exp)
        (number S←sign base←nat fr←fraction) => ^(* S (+ base fr))
        (number S←sign base←nat exp←exponent) => ^(* S base exp)
        (number S←sign base←nat) => ^(* S base)
        (sign "+") => 1
        (sign "-") => -1
        (sign "") => 1
        (nat (form "[1-9][0-9]+" nat))
        (nat (form "[0-9]" nat))
        (fraction "." value←(form digits←"[0-9]+" nat))
          => ^(/ value (** 10 (charcount digits)))
        (exponent "[eE]" S←sign value←(form "[0-9]+" nat))
          => ^(** 10 (* S value))
        (ws "[ \n\r\t]*"))
      (queue (@front @back)
        ("true" "false" "null" "\n\r\ttrue\t\r\n" "TRUE" "null1" "" "0" "9" "-0" "+0"
         "1234567890" "-12345" "+12345" "01" "00" "0.0" "0.123" "-0.0001" "+0.5"
         "1." ".5" "0.00" "1e2" "1e+2" "1e-2" "-1e-3" "1.23E+4" "1e" "1e+"
         "1e-" "1.2e3.4" "+" "-"  ⎡""⎤ ⎡"a"⎤ ⎡"hello world"⎤ ⎡"\""⎤ ⎡"\\"⎤
         ⎡"\b\f\r\n\t"⎤ ⎡"\u0000"⎤ ⎡"\u001F"⎤ ⎡"\u1234"⎤ ⎡"\uABCD"⎤ ⎡"\uabcd"⎤
         ⎡"\uaBcD"⎤ "\"unescaped \nchar\"" "\"un-\nescaped\\nworld\"" ⎡"⎤ ⎡"\⎤
         ⎡"\a"⎤ ⎡"\u12"⎤ ⎡"\u123g"⎤ ⎡"normal and \u0020space"⎤ ⎡"\u{10FFFF}"⎤
         ⎡"·"⎤ "\"\u[:poop:]\""  "[]" "[ ]" "[\n\r\t]" "[1]" "[1,2,3]" "[1, 2, 3]"
         "[1,2,]" "[1,]" "[,]" "[1,,2]" "[1,2" "1,2]" "[[]]" "[[1, 2], [3, 4]]"
         "[1, [2, [3, 4]]]" ⎡[true, null, "a", 1.5]⎤  ⎡{}⎤ ⎡{ }⎤ ⎡{"a": 1}⎤
         ⎡{"a": 1, "b": 2}⎤ ⎡{"a": 1,}⎤ ⎡{"a": 1, "b": 2,}⎤ ⎡{"a": {"b": {"c": 3},}}⎤
         ⎡{"a": [1, 2], "b": {"c": true}}⎤ ⎡{a: 1}⎤ ⎡{"a" 1}⎤ ⎡{"a":}⎤
         ⎡{"a": 1,, "b": 2}⎤ ⎡{"a": null}⎤ ⎡{"a": 1, "b": 2⎤ ⎡{"a": 1} {"b": 2}⎤
         ⎡{"a": 1, "a": 2}⎤ ⎡{"a": 1, "b": null, "c": 2}⎤))
      (feed @front @input)
      (discard @output)
      (cell @input)
      (cell @output))
    ;; Literals
    (frame/tail (cell @input "true") (cell @output))
    (frame/tail (cell @input) (cell @output true))
    (frame/tail (cell @input "false") (cell @output))
    (frame/tail (cell @input) (cell @output false))
    (frame/tail (cell @input "null") (cell @output))
    (frame/tail (cell @input) (cell @output null))
    (frame/tail (cell @input "\n\r\ttrue\t\r\n") (cell @output))
    (frame/tail (cell @input) (cell @output true))
    (frame/tail (cell @input "TRUE") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "null1") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    ;; Numbers
    (frame/tail (cell @input "0") (cell @output))
    (frame/tail (cell @input) (cell @output 0))
    (frame/tail (cell @input "9") (cell @output))
    (frame/tail (cell @input) (cell @output 9))
    (frame/tail (cell @input "-0") (cell @output))
    (frame/tail (cell @input) (cell @output 0))
    (frame/tail (cell @input "+0") (cell @output))
    (frame/tail (cell @input) (cell @output 0))
    (frame/tail (cell @input "1234567890") (cell @output))
    (frame/tail (cell @input) (cell @output 1234567890))
    (frame/tail (cell @input "-12345") (cell @output))
    (frame/tail (cell @input) (cell @output -12345))
    (frame/tail (cell @input "+12345") (cell @output))
    (frame/tail (cell @input) (cell @output 12345))
    (frame/tail (cell @input "01") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "00") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "0.0") (cell @output))
    (frame/tail (cell @input) (cell @output 0))
    (frame/tail (cell @input "0.123") (cell @output))
    (frame/tail (cell @input) (cell @output 0.123))
    (frame/tail (cell @input "-0.0001") (cell @output))
    (frame/tail (cell @input) (cell @output -0.0001))
    (frame/tail (cell @input "+0.5") (cell @output))
    (frame/tail (cell @input) (cell @output 0.5))
    (frame/tail (cell @input "1.") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ".5") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "0.00") (cell @output))
    (frame/tail (cell @input) (cell @output 0))
    (frame/tail (cell @input "1e2") (cell @output))
    (frame/tail (cell @input) (cell @output 100))
    (frame/tail (cell @input "1e+2") (cell @output))
    (frame/tail (cell @input) (cell @output 100))
    (frame/tail (cell @input "1e-2") (cell @output))
    (frame/tail (cell @input) (cell @output 0.01))
    (frame/tail (cell @input "-1e-3") (cell @output))
    (frame/tail (cell @input) (cell @output -0.001))
    (frame/tail (cell @input "1.23E+4") (cell @output))
    (frame/tail (cell @input) (cell @output 12300))
    (frame/tail (cell @input "1e") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "1e+") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "1e-") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "1.2e3.4") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "+") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "-") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    ;; Strings
    (frame/tail (cell @input ⎡""⎤) (cell @output))
    (frame/tail (cell @input) (cell @output ""))
    (frame/tail (cell @input ⎡"a"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "a"))
    (frame/tail (cell @input ⎡"hello world"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "hello world"))
    (frame/tail (cell @input ⎡"\""⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "\""))
    (frame/tail (cell @input ⎡"\\"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "\\"))
    (frame/tail (cell @input ⎡"\b\f\r\n\t"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "\b\f\r\n\t"))
    (frame/tail (cell @input ⎡"\u0000"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "\x00"))
    (frame/tail (cell @input ⎡"\u001F"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "\x1F"))
    (frame/tail (cell @input ⎡"\u1234"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "\u{1234}"))
    (frame/tail (cell @input ⎡"\uABCD"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "\u{ABCD}"))
    (frame/tail (cell @input ⎡"\uabcd"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "\u{ABCD}"))
    (frame/tail (cell @input ⎡"\uaBcD"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "\u{ABCD}"))
    (frame/tail (cell @input "\"unescaped \nchar\"") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure (unescaped newline)
    (frame/tail (cell @input "\"un-\nescaped\\nworld\"") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure (unescaped newline)
    (frame/tail (cell @input ⎡"⎤) (cell @output)) ;; "
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡"\⎤) (cell @output)) ;; "
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡"\a"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡"\u12"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡"\u123g"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡"normal and \u0020space"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "normal and  space"))
    (frame/tail (cell @input ⎡"\u{10FFFF}"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡"·"⎤) (cell @output))
    (frame/tail (cell @input) (cell @output "·")) ;; failure
    (frame/tail (cell @input "\"\u[:poop:]\"") (cell @output))
    (frame/tail (cell @input) (cell @output "\u[:poop:]"))
    ;; Arrays
    (frame/tail (cell @input "[]") (cell @output))
    (frame/tail (cell @input) (cell @output ()))
    (frame/tail (cell @input "[ ]") (cell @output))
    (frame/tail (cell @input) (cell @output ()))
    (frame/tail (cell @input "[\n\r\t]") (cell @output))
    (frame/tail (cell @input) (cell @output ()))
    (frame/tail (cell @input "[1]") (cell @output))
    (frame/tail (cell @input) (cell @output (1)))
    (frame/tail (cell @input "[1,2,3]") (cell @output))
    (frame/tail (cell @input) (cell @output (1 2 3)))
    (frame/tail (cell @input "[1, 2, 3]") (cell @output))
    (frame/tail (cell @input) (cell @output (1 2 3)))
    (frame/tail (cell @input "[1,2,]") (cell @output))
    (frame/tail (cell @input) (cell @output (1 2)))
    (frame/tail (cell @input "[1,]") (cell @output))
    (frame/tail (cell @input) (cell @output (1)))
    (frame/tail (cell @input "[,]") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "[1,,2]") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "[1,2") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "1,2]") (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input "[[]]") (cell @output))
    (frame/tail (cell @input) (cell @output (())))
    (frame/tail (cell @input "[[1, 2], [3, 4]]") (cell @output))
    (frame/tail (cell @input) (cell @output ((1 2) (3 4))))
    (frame/tail (cell @input "[1, [2, [3, 4]]]") (cell @output))
    (frame/tail (cell @input) (cell @output (1 (2 (3 4)))))
    (frame/tail (cell @input ⎡[true, null, "a", 1.5]⎤) (cell @output))
    (frame/tail (cell @input) (cell @output (true null "a" 1.5)))
    ;; Objects
    (frame/tail (cell @input ⎡{}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {}))
    (frame/tail (cell @input ⎡{ }⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {}))
    (frame/tail (cell @input ⎡{"a": 1}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {"a": 1}))
    (frame/tail (cell @input ⎡{"a": 1, "b": 2}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {"a": 1, "b": 2}))
    (frame/tail (cell @input ⎡{"a": 1,}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {"a": 1}))
    (frame/tail (cell @input ⎡{"a": 1, "b": 2,}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {"a": 1, "b": 2}))
    (frame/tail (cell @input ⎡{"a": {"b": {"c": 3},}}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {"a": {"b": {"c": 3}}}))
    (frame/tail (cell @input ⎡{"a": [1, 2], "b": {"c": true}}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {"a": (1 2), "b": {"c": true}}))
    (frame/tail (cell @input ⎡{a: 1}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡{"a" 1}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡{"a":}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡{"a": 1,, "b": 2}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡{"a": null}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {}))
    (frame/tail (cell @input ⎡{"a": 1, "b": 2⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡{"a": 1} {"b": 2}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output)) ;; failure
    (frame/tail (cell @input ⎡{"a": 1, "a": 2}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {"a": 2}))
    (frame/tail (cell @input ⎡{"a": 1, "b": null, "c": 2}⎤) (cell @output))
    (frame/tail (cell @input) (cell @output {"a": 1, "c": 2}))
    ;; End
    (frame/tail (cell @input) (cell @output))
    end)

  ;; View variant, resource
  (rack
    (frame
      (parser (@input - name-list - @output)
        (name-list lst←(many "[%w]+" " ")) => ^lst)
      (node (@input (resource _ (present input_string)))
        (resource (uri "http://127.0.0.1:9812/names.txt")))
      (cell @output))
    ;; Fetches data
    (frame/tail
      (node (@input (resource _ (present input_string)))
        (resource (uri "http://127.0.0.1:9812/names.txt")
          (present "Samantha Daniel John Barbara")))
      (cell @output))
    ;; Parses
    (frame/tail
      (cell @output ("Samantha" "Daniel" "John" "Barbara"))))

  ;; Parse people.json from the testtool server using our JSON grammar
  (rack
    (frame
      (parser (@input -> json -> @output)
        (json element)
        (value object)
        (value array)
        (value string)
        (value number)
        (value "true") => true
        (value "false") => false
        (value "null") => null
        (object "{" ws "}") => {}
        (object "{" members←(many member "," min: 1 trailing: true) "}")
          => ^(reduce ({} members)
                (fn (memo_dict (k_ v←(%not null)))
                  (union memo (entry k v))))
        (member ws key←string ws ":" value←element) => (^key ^value)
        (array "[" ws "]") => ()
        (array "[" elements←(many element "," min: 1 trailing: true) "]") => ^elements
        (element ws mid←value ws) => ^mid
        (string "\"" content←(many segment) "\"") => ^(join content)
        (segment chr←"[\x20-\u{10FFFF}^\"\\]+") => ^chr
        (segment "\\" chr←escape) => ^chr
        (escape "\"") => "\""
        (escape "\\") => "\\"
        (escape "/") => "/"
        (escape "b") => "\b"
        (escape "f") => "\f"
        (escape "n") => "\n"
        (escape "r") => "\r"
        (escape "t") => "\t"
        (escape "u" codepoint←(form "%|xxxx|" (nat radix: 16))) => ^(chr codepoint)
        (number S←sign base←nat fr←fraction exp←exponent) => ^(* S (+ base fr) exp)
        (number S←sign base←nat fr←fraction) => ^(* S (+ base fr))
        (number S←sign base←nat exp←exponent) => ^(* S base exp)
        (number S←sign base←nat) => ^(* S base)
        (sign "+") => 1
        (sign "-") => -1
        (sign "") => 1
        (nat (form "[1-9][0-9]+" nat))
        (nat (form "[0-9]" nat))
        (fraction "." value←(form digits←"[0-9]+" nat))
          => ^(/ value (** 10 (charcount digits)))
        (exponent "[eE]" S←sign value←(form "[0-9]+" nat))
          => ^(** 10 (* S value))
        (ws "[ \n\r\t]*"))
      (node (@input (resource _ (present input_string)))
        (resource (uri "http://127.0.0.1:9812/people.json")))
      (cell @output))
    ;; It downloaded the resource.
    (frame pattern: true
      ⟨(node (@input _) (resource _ (present _string)))⟩)
    ;; It parsed it.
    (frame/tail
      (cell @output
        ({"age": 21 "friends": ({"index": 0 "name": "Sofia Hoffman" "relatives": ({"index": 0 "name": "Wendi Henderson"} {"index": 1 "name": "Flynn Drake"} {"index": 2 "name": "Phoebe Vasquez"})} {"index": 1 "name": "Kerri Galloway" "relatives": ({"index": 0 "name": "Anne Burch"} {"index": 1 "name": "Hayden Key"} {"index": 2 "name": "Short Meadows"})} {"index": 2 "name": "Wright Anderson" "relatives": ({"index": 0 "name": "Lesa Vang"} {"index": 1 "name": "Bowen Ayala"} {"index": 2 "name": "Roslyn Cash"} {"index": 3 "name": "Deidre Jimenez"})}) "index": 0 "isActive": true "name": "Cora Burks"}
         {"age": 26 "friends": () "index": 1 "isActive": false "name": "Herrera Price"}
         {"age": 21 "friends": () "index": 2 "isActive": true "name": "Tonya Robles"}
         {"age": 22 "friends": ({"index": 0 "name": "Lorna Wilson" "relatives": ({"index": 0 "name": "Edna Mosley"} {"index": 1 "name": "Kathie Benson"} {"index": 2 "name": "Young Warren"})}) "index": 3 "isActive": true "name": "Macdonald Booker"}
         {"age": 32 "friends": ({"index": 0 "name": "Allison Gilbert" "relatives": ({"index": 0 "name": "Naomi Hale"} {"index": 1 "name": "Brown Miller"})} {"index": 1 "name": "Katelyn Hoover" "relatives": ({"index": 0 "name": "Paula Gates"} {"index": 1 "name": "Mccarthy Hughes"} {"index": 2 "name": "Wilson Mann"} {"index": 3 "name": "Amber Stephenson"} {"index": 4 "name": "Socorro Walker"})} {"index": 2 "name": "Gayle Stevens" "relatives": ({"index": 0 "name": "Kellie Greer"} {"index": 1 "name": "Daisy Bright"} {"index": 2 "name": "Magdalena Jacobs"} {"index": 3 "name": "Parker Garcia"})}) "index": 4 "isActive": true "name": "Alvarez Buchanan"}
