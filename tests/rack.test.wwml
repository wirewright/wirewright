        {¦ l_: (_+) r: () out: (_* `dst)}
          <> {l: (), (dst): ^l}
        {¦ l: () r_: (_+) out: (_* `dst)}
          <> {r: (), (dst): ^r}))
    (module {:@workspace, :@busy}
      (cell @l)
      (cell @r)
