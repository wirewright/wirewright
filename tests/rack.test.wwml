      (part (@top @b) (qux _ b_))
      (part (@a @x) (x_ _*))
      (part (@b @y) (_* y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(* n 2)}))
    (frame
      (cell @top (qux (3 2) (3 16)))
