;; Feed
(group
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (feed @a @b))
    (frame
      (cell @a)
      (cell @b 100)
      (feed @a @b))
    end)

  ;; Inhibitor absent
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (feed (not @x) @a @b))
    (frame
      (cell @a)
      (cell @b 100)
      (feed (not @x) @a @b))
    end)

  ;; Inhibitor empty
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (cell @x)
      (feed (not @x) @a @b))
    (frame
      (cell @a)
      (cell @b 100)
      (cell @x)
      (feed (not @x) @a @b))
    end)

  ;; Inhibitor present
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (cell @x qux)
      (feed (not @x) @a @b))
    end)

  ;; Append
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (feed @a (@b back)))
    (frame
      (cell @a)
      (cell @b (a b c 100))
      (feed @a (@b back)))
    end)

  ;; Prepend
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (feed @a (@b front)))
    (frame
      (cell @a)
      (cell @b (100 a b c))
      (feed @a (@b front)))
    end)

  ;; Atop (absent)
  (rack
    (frame
      (cell @a 100)
      (cell @b)
      (feed @a (atop @b)))
    (frame
      (cell @a)
      (cell @b 100)
      (feed @a (atop @b)))
    end)

  ;; Atop (present)
  (rack
    (frame
      (cell @a 100)
      (cell @b qux)
      (feed @a (atop @b)))
    (frame
      (cell @a)
      (cell @b 100)
      (feed @a (atop @b)))
    end)

  ;; Atop...front
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (feed @a (atop (@b front))))
    (frame
      (cell @a)
      (cell @b (100 b c))
      (feed @a (atop (@b front))))
    end)

  ;; Atop...back
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (feed @a (atop (@b back))))
    (frame
      (cell @a)
      (cell @b (a b 100))
      (feed @a (atop (@b back))))
    end)

  ;; Dequeue
  (rack
    (frame
      (cell @a (a b c))
      (cell @b)
      (feed (@a front) @b))
    (frame
      (cell @a (b c))
      (cell @b a)
      (feed (@a front) @b))
    end)

  ;; Pop
  (rack
    (frame
      (cell @a (a b c))
      (cell @b)
      (feed (@a back) @b))
    (frame
      (cell @a (a b))
      (cell @b c)
      (feed (@a back) @b))
    end)

  ;; Dequeue + pop
  (rack
    (frame
      (cell @a (a b c))
      (cell @b)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (a b))
      (cell @b c)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (c a b))
      (cell @b)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (c a))
      (cell @b b)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (b c a))
      (cell @b)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (b c))
      (cell @b a)
      (feed (@a back) @b)
      (feed @b (@a front)))
    (frame
      (cell @a (a b c))
      (cell @b)
      (feed (@a back) @b)
      (feed @b (@a front))))
    ;; ...

  ;; Pop + Append
  (rack
    (frame
      (cell @a (a b c))
      (feed (@a back) (@b back))
      (cell @b ()))
    (frame
      (cell @a (a b))
      (feed (@a back) (@b back))
      (cell @b (c)))
    (frame
      (cell @a (a))
      (feed (@a back) (@b back))
      (cell @b (c b)))
    (frame
      (cell @a ())
      (feed (@a back) (@b back))
      (cell @b (c b a)))
    end)

  ;; Enqueue + Append
  (rack
    (frame
      (cell @a (a b c))
      (feed (@a front) (@b back))
      (cell @b ()))
    (frame
      (cell @a (b c))
      (feed (@a front) (@b back))
      (cell @b (a)))
    (frame
      (cell @a (c))
      (feed (@a front) (@b back))
      (cell @b (a b)))
    (frame
      (cell @a ())
      (feed (@a front) (@b back))
      (cell @b (a b c)))
    end)

  ;; Copy ... front
  (rack
    (frame
      (cell @a (a b c))
      (feed (copy (@a front)) @b)
      (cell @b))
    (frame
      (cell @a (a b c))
      (feed (copy (@a front)) @b)
      (cell @b a))
    end)

  ;; Copy ... back
  (rack
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) @b)
      (cell @b))
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) @b)
      (cell @b c))
    end)

  ;; Copy back ... front
  (rack
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) (@b front))
      (cell @b ()))
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) (@b front))
      (cell @b (c)))
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) (@b front))
      (cell @b (c c)))
    (frame
      (cell @a (a b c))
      (feed (copy (@a back)) (@b front))
      (cell @b (c c c))))
    ;; ...

  ;; Copy ... back ... front observes, back ... front moves
  (rack
    (frame
      (cell @a (a b c))
      (feed (@a back) (@c front))
      (feed (copy (@a back)) (@b front))
      (cell @b ())
      (cell @c ()))
    (frame
      (cell @a (a b))
      (feed (@a back) (@c front))
      (feed (copy (@a back)) (@b front))
      (cell @b (c))
      (cell @c (c)))
    (frame
      (cell @a (a))
      (feed (@a back) (@c front))
      (feed (copy (@a back)) (@b front))
      (cell @b (b c))
      (cell @c (b c)))
    (frame
      (cell @a ())
      (feed (@a back) (@c front))
      (feed (copy (@a back)) (@b front))
      (cell @b (a b c))
      (cell @c (a b c)))
    end)

  ;; Aggregate (basic)
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) @agg)
      (cell @agg))
    (frame
      (cell @a)
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) @agg)
      (cell @agg (100 a z)))
    end)

  ;; Aggregate ... back (basic)
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ()))
    (frame
      (cell @a)
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z))))
    end)

  ;; Aggregate ... back (queue)
  (rack
    (frame
      (queue (@a @a') (100 200 300 400))
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ()))
    (frame
      (queue (@a @a') (200 300 400))
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z))))
    (frame
      (queue (@a @a') (300 400))
      (cell @b (c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z) (200 b z))))
    (frame
      (queue (@a @a') (400))
      (cell @b ())
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z) (200 b z) (300 c z))))
    end)

  ;; Aggregate: atop ... back
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (atop (@agg back)))
      (cell @agg (qux)))
    (frame
      (cell @a)
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (atop (@agg back)))
      (cell @agg ((100 a z))))
    end)

  ;; Broadcast (basic)
  (rack
    (frame
      (cell @a (200 100 300))
      (feed @a (@x @y @z))
      (cell @x)
      (cell @y)
      (cell @z))
    (frame
      (cell @a)
      (feed @a (@x @y @z))
      (cell @x 200)
      (cell @y 100)
      (cell @z 300))
    end)

  ;; Aggregate -> broadcast osc
  (rack
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ())
      (feed (@agg back) (@a (@b front) (atop (@c back)))))
    (frame
      (cell @a)
      (cell @b (b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ((100 a z)))
      (feed (@agg back) (@a (@b front) (atop (@c back)))))
    (frame
      (cell @a 100)
      (cell @b (a b c))
      (cell @c (x y z))
      (feed (@a (@b front) (copy (@c back))) (@agg back))
      (cell @agg ())
      (feed (@agg back) (@a (@b front) (atop (@c back))))))
    ;; ...

  ;; Parallel transfer
  (rack
    (frame
      (cell @a "foo")
      (cell @b "bar")
      (cell @c "baz")
      (cell @x)
      (cell @y (qux))
      (cell @z (xuq))
      (feed (@a @b @c) (@x (@y front) (@z back))))
    (frame
      (cell @a)
      (cell @b)
      (cell @c)
      (cell @x "foo")
      (cell @y ("bar" qux))
      (cell @z (xuq "baz"))
      (feed (@a @b @c) (@x (@y front) (@z back))))
    end)

  ;; Feed should not work if duplicate input cells exist
  (rack
    (frame
      (cell @x 100)
      (cell @x 200)
      (feed @x @y)
      (cell @y))
    end)

  ;; Feed should not work if duplicate output cells exist
  (rack
    (frame
      (cell @x 100)
      (feed @x @y)
      (cell @y)
      (cell @y))
    end)

  ;; Feed should respect user-order
  (rack
    (frame
      (cell @d 100)
      (cell @a 400)
      (cell @c 200)
      (cell @b 300)
      (feed (@a @b @c @d) @x)
      (cell @x)
      (feed @x (@a @b @c @d)))
    (frame
      (cell @d)
      (cell @a)
      (cell @c)
      (cell @b)
      (feed (@a @b @c @d) @x)
      (cell @x (400 300 200 100))
      (feed @x (@a @b @c @d)))
    (frame
      (cell @d 100)
      (cell @a 400)
      (cell @c 200)
      (cell @b 300)
      (feed (@a @b @c @d) @x)
      (cell @x)
      (feed @x (@a @b @c @d))))
    ;; ...

  (rack
    (frame
      (cell @d 100)
      (cell @a 400)
      (group
        (cell @c 200)
        (cell @b 300))
      (feed (@a @b @c @d) (@w @y @x @z))
      (cell @w)
      (group
        (cell @x)
        (cell @y)
        (cell @z)))
    (frame
      (cell @d)
      (cell @a)
      (group
        (cell @c)
        (cell @b))
      (feed (@a @b @c @d) (@w @y @x @z))
      (cell @w 400)
      (group
        (cell @x 200)
        (cell @y 300)
        (cell @z 100)))
    end)

  ;; Conflicts like this one rely on addr comparison of participants deep in the guts
  ;; of D7 to remain deterministic. The comparison is a method of last resort when
  ;; it comes to sorting solutions. Here we exercise it.
  (rack
    (frame
      (cell @x a)
      (cell @y b)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    (frame
      (cell @x) ;; < (cell @x)'s addr is smaller so it wins
      (cell @y b)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink a)
      (discard @sink))
    (frame
      (cell @x)
      (cell @y b)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    (frame
      (cell @x)
      (cell @y)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink b)
      (discard @sink))
    (frame
      (cell @x)
      (cell @y)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    end)

  (rack
    (frame
      (cell @y b)
      (cell @x a)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    (frame
      (cell @y) ;; < (cell @y)'s addr is smaller so it wins
      (cell @x a)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink b)
      (discard @sink))
    (frame
      (cell @y)
      (cell @x a)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    (frame
      (cell @y)
      (cell @x)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink a)
      (discard @sink))
    (frame
      (cell @y)
      (cell @x)
      (feed @x @sink)
      (feed @y @sink)
      (cell @sink)
      (discard @sink))
    end))

;; Single tick parallelism.
(rack
  (frame
    (module {}
      (cell @x 0)
      (feed @x @y)
      (cell @y))
   (module {}
      (cell @x 0)
      (feed @x @y)
      (cell @y)))
  (frame
    (module {}
      (cell @x)
      (feed @x @y)
      (cell @y 0))
    (module {}
      (cell @x)
      (feed @x @y)
      (cell @y 0)))
  end)

;; Waterfall.
(rack
  (frame
    (cell @0 0)
    (cell @1)
    (cell @2)
    (cell @3)
    (feed @0 @1 @2 @3))
  (frame
    (cell @0)
    (cell @1 0)
    (cell @2)
    (cell @3)
    (feed @0 @1 @2 @3))
  (frame
    (cell @0)
    (cell @1)
    (cell @2 0)
    (cell @3)
    (feed @0 @1 @2 @3))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (cell @3 0)
    (feed @0 @1 @2 @3))
  end)

;; Waterfall with multiple items. Note how we don't pick conflicting rewrites
;; in the same step. This is why you see the "hole" between items: that cell
;; is "expended" in that tick because an item was moved FROM it.
(rack
  (frame
    (cell @0 0)
    (cell @1 1)
    (cell @2 2)
    (cell @3)
    (cell @4)
    (cell @5)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0 0)
    (cell @1 1)
    (cell @2)
    (cell @3 2)
    (cell @4)
    (cell @5)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0 0)
    (cell @1)
    (cell @2 1)
    (cell @3)
    (cell @4 2)
    (cell @5)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1 0)
    (cell @2)
    (cell @3 1)
    (cell @4)
    (cell @5 2)
    (cell @6)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1)
    (cell @2 0)
    (cell @3)
    (cell @4 1)
    (cell @5)
    (cell @6 2)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (cell @3 0)
    (cell @4)
    (cell @5 1)
    (cell @6 2)
    (feed @0 @1 @2 @3 @4 @5 @6))
  (frame
    (cell @0)
    (cell @1)
    (cell @2)
    (cell @3)
    (cell @4 0)
    (cell @5 1)
    (cell @6 2)
    (feed @0 @1 @2 @3 @4 @5 @6))
  end)

;; Oscillation
(rack
  (frame
    (cell @0 100)
    (feed @0 @1 @0)
    (cell @1))
  (frame
    (cell @0)
    (feed @0 @1 @0)
    (cell @1 100))
  (frame
    (cell @0 100)
    (feed @0 @1 @0)
    (cell @1))
  (frame
    (cell @0)
    (feed @0 @1 @0)
    (cell @1 100)))
  ;; ...

;; Discard with pattern
(group
  (rack
    (frame
      (cell @a)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a x)
      (discard @a _symbol))
    (frame
      (cell @a)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a 100)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a x)
      (cell @b y)
      (discard @a _symbol))
    (frame
      (cell @a)
      (cell @b y)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a x)
      (cell @a y)
      (discard @a _symbol))
    (frame
      (cell @a)
      (cell @a)
      (discard @a _symbol))
    end)
  (rack
    (frame
      (cell @a x)
      (cell @a 100)
      (discard @a _symbol))
    (frame
      (cell @a)
      (cell @a 100)
      (discard @a _symbol))
    end))

;; Group
(rack
  (frame
    (group
      (cell @a "foo")
      (cell @b "bar"))
    (group
      (cell @c "baz"))
    (feed (@a @b @c) @x)
    (cell @x))
  (frame
    (group
      (cell @a)
      (cell @b))
    (group
      (cell @c))
    (feed (@a @b @c) @x)
    (cell @x ("foo" "bar" "baz")))
  end)

;; Module
(group
  (rack
    (frame
      (cell @a)
      (module {@b: @a}
        (cell @a 100)
        (feed @a @b)))
    (frame
      (cell @a 100)
      (module {@b: @a}
        (cell @a)
        (feed @a @b)))
    end)

  (rack
    (frame
      (module {:@x}
        (cell @x 100)
        (cell @y))
      (feed @x @y)
      (cell @y))
    (frame
      (module {:@x}
        (cell @x)
        (cell @y))
      (feed @x @y)
      (cell @y 100))
    end)

  (rack
    (frame
      (module {:@x}
        (cell @x 100)
        (feed @x @y)
        (cell @y))
      (cell @y))
    (frame
      (module {:@x}
        (cell @x)
        (feed @x @y)
        (cell @y 100))
      (cell @y))
    end))

;; locals
(rack
  (frame
    (cell @x 100)
    (cell @y)
    (feed @x @z)
    (discard @y)
    (locals (@x)
      (cell @x 200)
      (feed @x @y)
      (cell @z)))
  (frame
    (cell @x)
    (cell @y 200)
    (feed @x @z)
    (discard @y)
    (locals (@x)
      (cell @x)
      (feed @x @y)
      (cell @z 100)))
  (frame
    (cell @x)
    (cell @y)
    (feed @x @z)
    (discard @y)
    (locals (@x)
      (cell @x)
      (feed @x @y)
      (cell @z 100)))
  end)

;; Queue
(group
  ;; Basic
  (rack
    (frame
      (cell @0 300)
      (cell @1 200)
      (cell @2 100)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    (frame
      (cell @0 300)
      (cell @1 200)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) (100))
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    (frame
      (cell @0 300)
      (cell @1)
      (cell @2 200)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview 100)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1 300)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) (200))
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1)
      (cell @2 300)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview 200)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) (300))
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview 300)
      (discard @preview))
    (frame
      (cell @0)
      (cell @1)
      (cell @2)
      (feed @0 @1 @2 @back)
      (queue (@front @back) ())
      (feed @front @preview)
      (cell @preview)
      (discard @preview))
    end)

  ;; Queue should not enqueue if destination is occupied -- this is the basic
  ;; principle behind emergent backpressure (something similar can be said about
  ;; feed + cell).
  (rack
    (frame
      (cell @0 x)
      (cell @1 y)
      (feed @0 @1 @back)
      (queue (@front @back) ())
      (feed @front @occupied)
      (cell @occupied "Busy!"))
    (frame
      (cell @0 x)
      (cell @1)
      (feed @0 @1 @back)
      (queue (@front @back) (y))
      (feed @front @occupied)
      (cell @occupied "Busy!"))
    (frame
      (cell @0)
      (cell @1 x)
      (feed @0 @1 @back)
      (queue (@front @back) (y))
      (feed @front @occupied)
      (cell @occupied "Busy!"))
    (frame
      (cell @0)
      (cell @1)
      (feed @0 @1 @back)
      (queue (@front @back) (y x))
      (feed @front @occupied)
      (cell @occupied "Busy!"))
    end)

  ;; Queue circulate one value.
  (rack
    (frame
      (queue (@front @back) (100))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) ())
      (feed @front @mid)
      (cell @mid 100)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) ())
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 200)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) ())
      (feed @front @mid)
      (cell @mid 200)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) ())
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 400)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (400))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back)))
    ;; ...

  ;; Queue circulate many values.
  (rack
    (frame
      (queue (@front @back) (100 200 300))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200 300))
      (feed @front @mid)
      (cell @mid 100)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200 300))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 200)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (300 200))
      (feed @front @mid)
      (cell @mid 200)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) (300 200))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 400)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200 400))
      (feed @front @mid)
      (cell @mid 300)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back))
    (frame
      (queue (@front @back) (200 400))
      (feed @front @mid)
      (cell @mid)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid' 600)
      (feed @mid' @back))
    (frame
      (queue (@front @back) (400 600))
      (feed @front @mid)
      (cell @mid 200)
      (transfer (@mid ±n @mid') ^(* n 2))
      (cell @mid')
      (feed @mid' @back)))
    ;; ...

  ;; Feedback deactivates since input & output collide
  (rack
    (frame (queue (@a @a) (100 200 300)))
    end)

  ;; max: N
  (rack
    (frame
      (queue (@front0 @back0) (100 200 300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3) ()))
    (frame
      (queue (@front0 @back0) (200 300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3) (100)))
    (frame
      (queue (@front0 @back0) (300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3) (100 200)))
    (frame
      (queue (@front0 @back0) (400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3) (100 200 300)))
    end)

  ;; queue min: N
  (rack
    (frame
      (queue (@front0 @back0) (1 2 3 4 5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) ())
      (discard @front1))
    (frame
      (queue (@front0 @back0) (2 3 4 5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (1))
      (discard @front1))
    (frame
      (queue (@front0 @back0) (3 4 5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (1 2))
      (discard @front1))
    (frame
      (queue (@front0 @back0) (4 5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (2 3))
      (discard @front1))
    (frame
      (queue (@front0 @back0) (5))
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (3 4))
      (discard @front1))
    (frame
      (queue (@front0 @back0) ())
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (4 5))
      (discard @front1))
    (frame
      (queue (@front0 @back0) ())
      (feed @front0 @back1)
      (queue (@front1 @back1 min: 2) (5))
      (discard @front1))
    end)

  ;; queue max: 0
  (rack
    (frame
      (queue (@front0 @back0) (100 200 300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 0) ()))
    end)

  ;; queue max: 3.14
  (rack
    (frame
      (queue (@front0 @back0) (100 200 300 400 500 600))
      (feed @front0 @back)
      (queue (@front @back max: 3.14) ()))
    end)

  ;; queue min: N max: M [cascade, backpressure]
  (rack
    (frame
      (cell (@in [in_ _*]) (a b c d e f g h id: in))
      (feed @in @x')
      (queue (@x @x' min: 3) (id: x))
      (feed @x @y')
      (queue (@y @y' min: 2 max: 4) (id: y))
      (feed @y @z')
      (queue (@z @z' max: 1) (id: z))
      (feed @z @trash)
      (delay 12 (cell @trash))
      (discard @trash))
    (frame pattern: true
      ⟪(b c d e f g h ¦ id: in)
       (a ¦ id: x)
       (¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(c d e f g h ¦ id: in)
       (a b ¦ id: x)
       (¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(d e f g h ¦ id: in)
       (a b c ¦ id: x)
       (¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(e f g h ¦ id: in)
       (b c d ¦ id: x)
       (a ¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(f g h ¦ id: in)
       (c d e ¦ id: x)
       (a b ¦ id: y)
       (¦ id: z)⟫)
    (frame pattern: true
      ⟪(g h ¦ id: in)
       (d e f ¦ id: x)
       (b c ¦ id: y)
       (a ¦ id: z)⟫)
    (frame pattern: true
      ⟪(h ¦ id: in)
       (e f g ¦ id: x)
       (b c d ¦ id: y)
       (a ¦ id: z)⟫)
    (frame pattern: true
      ⟪(¦ id: in)
       (f g h ¦ id: x)
       (b c d e ¦ id: y)
       (a ¦ id: z)⟫)
    ;; The queues maintain backpressure until the counter runs out
    ;; and "opens the dam".
    (frame pattern: true
      ⟪(delay 3 (cell @trash))⟫)
    (frame pattern: true
      ⟪(delay 2 (cell @trash))⟫)
    (frame pattern: true
      ⟪(¦ id: in)
       (f g h ¦ id: x)
       (b c d e ¦ id: y)
       (a ¦ id: z)
       (delay 1 (cell @trash))⟫)
    (frame pattern: true
      ⟪(f g h ¦ id: x)
       (b c d e ¦ id: y)
       (a ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(f g h ¦ id: x)
       (b c d e ¦ id: y)
       (¦ id: z)
       (cell @trash a)⟫)
    (frame pattern: true
      ⟪(f g h ¦ id: x)
       (c d e ¦ id: y)
       (b ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(g h ¦ id: x)
       (c d e f ¦ id: y)
       (¦ id: z)
       (cell @trash b)⟫)
    (frame pattern: true
      ⟪(d e f ¦ id: y)
       (c ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(d e f ¦ id: y)
       (¦ id: z)
       (cell @trash c)⟫)
    (frame pattern: true
      ⟪(e f ¦ id: y)
       (d ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(e f ¦ id: y)
       (¦ id: z)
       (cell @trash d)⟫)
    (frame pattern: true
      ⟪(f ¦ id: y)
       (e ¦ id: z)
       (cell @trash)⟫)
    (frame pattern: true
      ⟪(f ¦ id: y)
       (¦ id: z)
       (cell @trash e)⟫)
    (frame pattern: true
      ⟪(g h ¦ id: x) ;; < x is nonempty because its min: 3, it can't dequeue yet, too few items!
       (f ¦ id: y) ;; < ditto for y, it's waiting for more items because it's min: 2
       (¦ id: z)
       (cell @trash)⟫)
    end))

;; Transfer
(group
  ;; Basic
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s))
    (frame
      (cell @x)
      (cell @y)
      (transfer ((@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s 3))
    end)

  ;; Inhibitor absent
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s))
    (frame
      (cell @x)
      (cell @y)
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s 3))
    end)

  ;; Inhibitor empty
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (cell @qux)
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s))
    (frame
      (cell @x)
      (cell @y)
      (cell @qux)
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s 3))
    end)

  ;; Inhibitor present
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (cell @qux "foobar")
      (transfer ((not @qux) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s))
    end)

  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((not @foo @bar) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s)

      (cell @foo 1)
      (cell @bar)
      (cell @baz)
      (feed @foo @bar @baz))

    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((not @foo @bar) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s)

      (cell @foo)
      (cell @bar 1)
      (cell @baz)
      (feed @foo @bar @baz))

    (frame
      (cell @x 1)
      (cell @y 2)
      (transfer ((not @foo @bar) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s)

      (cell @foo)
      (cell @bar)
      (cell @baz 1)
      (feed @foo @bar @baz))

    (frame
      (cell @x)
      (cell @y)
      (transfer ((not @foo @bar) (@x @y) (x_ y_) @s) ^(+ x y))
      (cell @s 3)

      (cell @foo)
      (cell @bar)
      (cell @baz 1)
      (feed @foo @bar @baz))))

;; Backsys
(group
  ;; Basic
  (rack
    (frame
      (cell @world (a b c))
      (backsys @world
        (front_ _* `back) <> {(front): (), back: ^front}))
    (frame
      (cell @world (b c a))
      (backsys @world
        (front_ _* `back) <> {(front): (), back: ^front}))
    (frame
      (cell @world (c a b))
      (backsys @world
        (front_ _* `back) <> {(front): (), back: ^front}))
    (frame
      (cell @world (a b c))
      (backsys @world
        (front_ _* `back) <> {(front): (), back: ^front})))
    ;; ...

  ;; Source cell empty must deactivate backsys.
  (rack
    (frame
      (cell @x 100)
      (cell @y)
      (backsys (@x @y)
        (x_ y_) <> {y: ^x, x: ^y}))
    end)
  (rack
    (frame
      (cell @x 100)
      (cell @y 200)
      (backsys (@x @y)
        (x_ y_) <> {y: ^x, x: ^y}))
    (frame
      (cell @x 200)
      (cell @y 100)
      (backsys (@x @y)
        (x_ y_) <> {y: ^x, x: ^y})))
    ;; ...

  ;; Write to an absent resource cell is a noop
  (rack
    (frame
      (cell @x 100)
      (backsys {@:x @:y}
        {¦ x_ -y_} <> {y: ^x}))
    end)

  ;; Increment one
  (rack
    (frame
      (cell @x 100)
      (backsys @x
        ±N <> {N: ^(+ N 1)}))
    (frame
      (cell @x 101)
      (backsys @x
        ±N <> {N: ^(+ N 1)}))
    (frame
      (cell @x 102)
      (backsys @x
        ±N <> {N: ^(+ N 1)})))
    ;; ...

  ;; Increment many, same rule
  (rack
    (frame
      (cell @x 100)
      (cell @y 200)
      (backsys (@x @y)
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)}))
    (frame
      (cell @x 101)
      (cell @y 201)
      (backsys (@x @y)
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)}))
    (frame
      (cell @x 102)
      (cell @y 202)
      (backsys (@x @y)
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)})))
    ;; ...

  ;; Increment many, different rules
  (rack
    (frame
      (cell @x 100)
      (cell @y 200)
      (backsys (@x @y)
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)}))
    (frame
      (cell @x 101)
      (cell @y 201)
      (backsys (@x @y)
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)}))
    (frame
      (cell @x 102)
      (cell @y 202)
      (backsys (@x @y)
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)})))
    ;; ...

  ;; Increment parts of one, same rule
  (rack
    (frame
      (cell @x (100 200))
      (backsys @x
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)}))
    (frame
      (cell @x (101 201))
      (backsys @x
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)}))
    (frame
      (cell @x (102 202))
      (backsys @x
        (±N ±M) <> {N: ^(+ N 1), M: ^(+ M 1)})))
    ;; ...

  ;; Increment parts of one, different rules
  (rack
    (frame
      (cell @x (100 200))
      (backsys @x
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)}))
    (frame
      (cell @x (101 201))
      (backsys @x
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)}))
    (frame
      (cell @x (102 202))
      (backsys @x
        (±N _) <> {N: ^(+ N 1)}
        (_ ±M) <> {M: ^(+ M 1)})))
    ;; ...

  ;; Increment-swap parts of many, same rule
  (rack
    (frame
      (cell @x ((100) 200))
      (cell @y ((300) 400))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1), M: ^(+ N 1)}))
    (frame
      (cell @x ((401) 200))
      (cell @y ((300) 101))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1), M: ^(+ N 1)}))
    (frame
      (cell @x ((102) 200))
      (cell @y ((300) 402))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1), M: ^(+ N 1)})))
    ;; ...

  ;; Increment-swap parts of many, different rules
  (rack
    (frame
      (cell @x ((100) 200))
      (cell @y ((300) 400))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1)}
        (((±N) _) (_ ±M)) <> {M: ^(+ N 1)}))
    (frame
      (cell @x ((401) 200))
      (cell @y ((300) 101))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1)}
        (((±N) _) (_ ±M)) <> {M: ^(+ N 1)}))
    (frame
      (cell @x ((102) 200))
      (cell @y ((300) 402))
      (backsys (@x @y)
        (((±N) _) (_ ±M)) <> {N: ^(+ M 1)}
        (((±N) _) (_ ±M)) <> {M: ^(+ N 1)})))

  ;; Simple conflict
  (rack
    (frame
      (cell @x ((100) 200))
      (backsys (@x)
        (((±N) _)) <> {N: ^(+ N 1)}
        ((X_ _)) <> {X: qux}))
    (frame
      (cell @x (qux 200)) ;; < Qux wins because its modification is the shallowest.
      (backsys (@x)
        (((±N) _)) <> {N: ^(+ N 1)}
        ((X_ _)) <> {X: qux}))
    end)

  ;; Basic insertion
  (rack
    (frame
      (cell @x (a b c))
      (backsys (@x)
        ((`front _*)) <> {front: "First rule"}
        ((_* `back)) <> {back: "Second rule"}
        (⟨_* `slot … b … _*⟩) <> {slot: "Slot before b"}))
    (frame
      (cell @x ("First rule" a "Slot before b" b c "Second rule"))
      (backsys (@x)
        ((`front _*)) <> {front: "First rule"}
        ((_* `back)) <> {back: "Second rule"}
        (⟨_* `slot … b … _*⟩) <> {slot: "Slot before b"}))
    (frame
      (cell @x ("First rule" "First rule" a "Slot before b" "Slot before b" b c "Second rule" "Second rule"))
      (backsys (@x)
        ((`front _*)) <> {front: "First rule"}
        ((_* `back)) <> {back: "Second rule"}
        (⟨_* `slot … b … _*⟩) <> {slot: "Slot before b"})))
    ;; ...

  ;; Basic deletion
  (rack
    ;; First rule marks even
    ;; Second rule removes odd
    (frame
      (cell @x (a 1 2 b 3 4 c d 5 e 6 7 f 8 g h 9 i 10 11 12 j k l))
      (backsys @x
        ⟨n←(%pipe (mod 2) 0)⟩° <> {n: (seen ^n)}
        ⟨n←(%pipe (mod 2) (%not 0))⟩° <> {(n): ()}))
    (frame
      (cell @x (a (seen 2) b (seen 4) c d e (seen 6) f (seen 8) g h i (seen 10) (seen 12) j k l))
      (backsys @x
        ⟨n←(%pipe (mod 2) 0)⟩° <> {n: (seen ^n)}
        ⟨n←(%pipe (mod 2) (%not 0))⟩° <> {(n): ()}))
    end)

  (rack
    ;; First rule removes even
    ;; Second rule removes odd
    (frame
      (cell @x (a 1 2 b 3 4 c d 5 e 6 7 f 8 g h 9 i 10 11 12 j k l))
      (backsys @x
        ⟨n←(%pipe (mod 2) 0)⟩° <> {(n): ()}
        ⟨n←(%pipe (mod 2) (%not 0))⟩° <> {(n): ()}))
    (frame
      (cell @x (a b c d e f g h i j k l))
      (backsys @x
        ⟨n←(%pipe (mod 2) 0)⟩° <> {(n): ()}
        ⟨n←(%pipe (mod 2) (%not 0))⟩° <> {(n): ()}))
    end)

  ;; With resource
  (rack
    (frame
      (cell @world (a b c))
      (queue (@x @x') (100 200 300))
      (backsys (@world @:x)
        ((front_ _* `back) ⍊ x_) <> {(front): (), back: (^front ^x), (x): ()}))
    (frame
      (cell @world (b c (a 100)))
      (queue (@x @x') (200 300))
      (backsys (@world @:x)
        ((front_ _* `back) ⍊ x_) <> {(front): (), back: (^front ^x), (x): ()}))
    (frame
      (cell @world (c (a 100) (b 200)))
      (queue (@x @x') (300))
      (backsys (@world @:x)
        ((front_ _* `back) ⍊ x_) <> {(front): (), back: (^front ^x), (x): ()}))
    (frame
      (cell @world ((a 100) (b 200) (c 300)))
      (queue (@x @x') ())
      (backsys (@world @:x)
        ((front_ _* `back) ⍊ x_) <> {(front): (), back: (^front ^x), (x): ()}))
    end)

  ;; With many resources, initially unset: "peel from front and back"
  (rack
    (frame
      (cell @world (a b c d e f))
      (cell @x)
      (cell @y)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world (b c d e))
      (cell @x a)
      (cell @y f)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world (b c d e))
      (cell @x)
      (cell @y)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world (c d))
      (cell @x b)
      (cell @y e)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world (c d))
      (cell @x)
      (cell @y)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world ())
      (cell @x c)
      (cell @y d)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    (frame
      (cell @world ())
      (cell @x)
      (cell @y)
      (discard @x)
      (discard @y)
      (backsys (@world @:x @:y)
        ((front_ _* back_) ⍊ -x_ -y_)
          <> {(front): (), (back): (), x: ^front, y: ^back}))
    end)


  ;; backsys: insertions and deletions
  (rack
    ;; l's move left
    ;; r's move right
    ;; . represents an empty spot
    ;; r collides with l, bounce, a wall with durability `(I ±D)` appears.
    ;; l, r reflect off bounds and walls
    ;; walls lose durability when someone hits them
    ;; walls break when their durability is zero
    (frame
      (cell @x (r . . . l))
      (backsys @x
        ⟨a←. b←l⟩° <> {a: ^b, b: ^a}
        ⟨a←r b←.⟩° <> {a: ^b, b: ^a}
        ⟨a←r b←l⟩ <> {a: l, (b): ((I 3) r)}
        (a←l _*) <> {a: r}
        (_* a←r) <> {a: l}
        ⟨_* a←r … (I D←(%number _ > 0)) … _*⟩° <> {a: l, D: ^(- D 1)}
        ⟨_* … (I D←(%number _ > 0)) … a←l _*⟩° <> {a: r, D: ^(- D 1)}
        ⟨W←(I 0)⟩° <> {(W): ()}))
    (frame pattern: true
      ⟨(cell @x (. r . l .))⟩)
    (frame pattern: true
      ⟨(cell @x (. . r l .))⟩) ;; r wins because its rule is defined later
    (frame pattern: true
      ⟨(cell @x (. . l (I 3) r .))⟩)
    (frame pattern: true
      ⟨(cell @x (. l . (I 3) . r))⟩)
    (frame pattern: true
      ⟨(cell @x (l . . (I 3) . l))⟩)
    (frame pattern: true
      ⟨(cell @x (r . . (I 3) l .))⟩)
    (frame pattern: true
      ⟨(cell @x (. r . (I 2) r .))⟩)
    (frame pattern: true
      ⟨(cell @x (. . r (I 2) . r))⟩)
    (frame pattern: true
      ⟨(cell @x (. . l (I 1) . l))⟩)
    (frame pattern: true
      ⟨(cell @x (. l . (I 1) l .))⟩)
    (frame pattern: true
      ⟨(cell @x (l . . (I 0) r .))⟩)
    (frame pattern: true
      ⟨(cell @x (r . . . r))⟩)
    (frame pattern: true
      ⟨(cell @x (. r . . l))⟩)
    (frame pattern: true
      ⟨(cell @x (. . r l .))⟩))
    ;; ...


  ;; backsys: pyramidal (bottom-up-bottom, presentational, triangular, whatever)
  ;; feedback essentials with circuit
  (rack
    (frame
      (circuit @x
        (group
          (module {}
            (cell @sum 1 output: true)
            (cell @view0 input: true)
            (extension (@view0 v_ @sum) ^(sum v)))
          (module {}
            (cell @product 1 output: true)
            (cell @view1 input: true)
            (extension (@view1 v_ @product) ^(product v)))))
      (backsys (@x)
        ((%all (%leaves (%flat (_ n) ns_) (cell @_ ±n ⍊ output))
                ⟪(cell @_ (%group dst_ _?) ⍊ input)⟫°))
          <> {dst: ^ns}))
    (frame pattern: true
      ⟪[cell @sum 2]
       [cell @view0 (1 1)]
       [cell @product 1]
       [cell @view1 (1 1)]⟫)
    (frame pattern: true
      ⟪[cell @sum 3]
       [cell @view0 (2 1)]
       [cell @product 2]
       [cell @view1 (2 1)]⟫)
    (frame pattern: true
      ⟪[cell @sum 5]
       [cell @view0 (3 2)]
       [cell @product 6]
       [cell @view1 (3 2)]⟫)
    (frame pattern: true
      ⟪[cell @sum 11]
       [cell @view0 (5 6)]
       [cell @product 30]
       [cell @view1 (5 6)]⟫)
    (frame pattern: true
      ⟪[cell @sum 41]
       [cell @view0 (11 30)]
       [cell @product 330]
       [cell @view1 (11 30)]⟫))
    ;; ...
  )

;; Circuit
(group
  ;; BUG: Circuits at the same depth must not see each other (proper scoping)
  (rack
    (frame
      (circuit @0 (cell @x 100))
      (circuit @1 (cell @y))
      (circuit @2 (feed @x @y)))
    end)

  ;; Basic
  (rack
    (frame
      (cell @a
        ((cell @x 0)
         (feed @x @y)
         (cell @y)))
      (cell @b)
      (feed (copy @a) @b)
      (feed (@a @b) (@foo @bar))
      (circuit @foo)
      (circuit @bar))
    (frame
      (cell @a
        ((cell @x 0)
         (feed @x @y)
         (cell @y)))
      (cell @b
        ((cell @x 0)
         (feed @x @y)
         (cell @y)))
      (feed (copy @a) @b)
      (feed (@a @b) (@foo @bar))
      (circuit @foo)
      (circuit @bar))
    (frame
      (cell @a)
      (cell @b)
      (feed (copy @a) @b)
      (feed (@a @b) (@foo @bar))
      (circuit @foo
        (cell @x)
        (feed @x @y)
        (cell @y 0))
      (circuit @bar
        (cell @x)
        (feed @x @y)
        (cell @y 0)))
    end)

  ;; An observer can make decisions based on its children and feed them back.
  (rack
    (frame
      (circuit @x
        (cell @src 100)
        (extension (@src ±n @voice0) ^(+ n 2))
        (extension (@src ±n @voice1) ^(* n 2))
        (cell @voice0)
        (cell @voice1))
      (backsys @x
        ⟨& (cell @src n_) (cell @voice0 a_) (cell @voice1 b_)⟩
          <> {n: ^(+ a b)}))
    (frame pattern: true
      ⟪[cell @src 100]
       [cell @voice0 102]
       [cell @voice1 200]⟫)
    (frame pattern: true
      ⟪[cell @src 302]
       [cell @voice0 304]
       [cell @voice1 604]⟫)
    (frame pattern: true
      ⟪[cell @src 908]
       [cell @voice0 910]
       [cell @voice1 1816]⟫))
    ;; ...

  ;; Nested (observed) nodes are evaluated once per tick.
  (rack
    (frame
      (delay 3 "Foo")
      (circuit @x
        (delay 2 "Bar")
        (delay 5 "Baz")
        (circuit @y
          (delay 3 "boo"))))
    (frame
      (delay 2 "Foo")
      (circuit @x
        (delay 1 "Bar")
        (delay 4 "Baz")
        (circuit @y
          (delay 2 "boo"))))
    (frame
      (delay 1 "Foo")
      (circuit @x
        "Bar"
        (delay 3 "Baz")
        (circuit @y
          (delay 1 "boo"))))
    (frame
      "Foo"
      (circuit @x
        "Bar"
        (delay 2 "Baz")
        (circuit @y
          "boo")))
    (frame
      "Foo"
      (circuit @x
        "Bar"
        (delay 1 "Baz")
        (circuit @y
          "boo")))
    (frame
      "Foo"
      (circuit @x
        "Bar"
        "Baz"
        (circuit @y
          "boo"))))

  ;; Ditto
  (rack
    (frame
      (delay 3 "Foo")
      (cell @x-view)
      (feed (copy @x) (atop @x-view))
      (circuit @x
        (delay 3 "Bar")
        (cell @y-view)
        (feed (copy @y) (atop @y-view))
        (circuit @y (delay 3 "Baz"))))
    (frame
      (delay 2 "Foo")
      (cell @x-view
        ((delay 3 "Bar")
         (cell @y-view)
         (feed (copy @y) (atop @y-view))
         (circuit @y (delay 3 "Baz"))))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        (delay 2 "Bar")
        (cell @y-view ((delay 3 "Baz")))
        (feed (copy @y) (atop @y-view))
        (circuit @y (delay 2 "Baz"))))
    (frame
      (delay 1 "Foo")
      (cell @x-view
        ((delay 2 "Bar")
         (cell @y-view ((delay 3 "Baz")))
         (feed (copy @y) (atop @y-view))
         (circuit @y (delay 2 "Baz"))))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        (delay 1 "Bar")
        (cell @y-view ((delay 2 "Baz")))
        (feed (copy @y) (atop @y-view))
        (circuit @y (delay 1 "Baz"))))
    (frame
      "Foo"
      (cell @x-view
        ((delay 1 "Bar")
         (cell @y-view ((delay 2 "Baz")))
         (feed (copy @y) (atop @y-view))
         (circuit @y (delay 1 "Baz"))))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        "Bar"
        (cell @y-view ((delay 1 "Baz")))
        (feed (copy @y) (atop @y-view))
        (circuit @y "Baz")))
    (frame
      "Foo"
      (cell @x-view
        ("Bar"
         (cell @y-view ((delay 1 "Baz")))
         (feed (copy @y) (atop @y-view))
         (circuit @y "Baz")))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        "Bar"
        (cell @y-view ("Baz"))
        (feed (copy @y) (atop @y-view))
        (circuit @y "Baz")))
    (frame
      "Foo"
      (cell @x-view
        ("Bar"
         (cell @y-view ("Baz"))
         (feed (copy @y) (atop @y-view))
         (circuit @y "Baz")))
      (feed (copy @x) (atop @x-view))
      (circuit @x
        "Bar"
        (cell @y-view ("Baz"))
        (feed (copy @y) (atop @y-view))
        (circuit @y "Baz")))
    end))

;; Filtered circuit
(group
  ;; Make sure setting works, also not susceptible to injection.
  (rack
    (frame
      (circuit (@snd (fst_ snd_ _*))
        1 2 3 4 5 6)
      (cell @x qux)
      (extension (@x x_ @snd) (seen ^x ^^fst ^^snd)))
    (frame
      (circuit (@snd (fst_ snd_ _*))
        1 (seen qux ^fst ^snd) 3 4 5 6)
      (cell @x qux)
      (extension (@x x_ @snd) (seen ^x ^^fst ^^snd)))
    end)

  ;; Basic
  (rack
    (frame
      (circuit (@x ⟪(cell @_ `x ⍊ x)⟫)
        (group
          (cell @x x: true)
          (cell @y)
          (feed @x @y)))
      (cell @in "Hello World")
      (feed @in @x))
    (frame
      (circuit (@x ⟪(cell @_ `x ⍊ x)⟫)
        (group
          ;; NOTE: Parent + child eval are compressed into one tick here.
          ;; Parent evals first. So it first puts @x. Child evals next.
          ;; So it moves @x -> @y.
          (cell @x x: true)
          (cell @y "Hello World")
          (feed @x @y)))
      (cell @in)
      (feed @in @x))
    end)

  ;; Queue using filtered circuit
  (rack
    (frame
      (circuit (@front (front_ _*))
        a b c)
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*))
        b c)
      (feed @front @foo)
      (cell @foo a)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*))
        b c)
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar a)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*))
        c)
      (feed @front @foo)
      (cell @foo b)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*))
        c)
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar b)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*)))
      (feed @front @foo)
      (cell @foo c)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*)))
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar c)
      (discard @bar))
    (frame
      (circuit (@front (front_ _*)))
      (feed @front @foo)
      (cell @foo)
      (feed @foo @bar)
      (cell @bar)
      (discard @bar))
    end))

;; node
(rack
  (frame
    (cell @foo (delay 2 (p "Hi")))
    (feed @foo @view)
    (node @view))
  (frame
    (cell @foo)
    (feed @foo @view)
    (node @view (delay 1 (p "Hi"))))
  (frame
    (cell @foo)
    (feed @foo @view)
    (node @view (p "Hi")))
  end)

;; Filtered cell
(group
  ;; Basic
  (rack
    (frame
      (cell (@snd (_ snd_ _*)) (1 2 3 4 5 6))
      (feed @snd @back)
      (queue (@front @back) ()))
    (frame
      (cell (@snd (_ snd_ _*)) (1 3 4 5 6))
      (feed @snd @back)
      (queue (@front @back) (2)))
    (frame
      (cell (@snd (_ snd_ _*)) (1 4 5 6))
      (feed @snd @back)
      (queue (@front @back) (2 3)))
    (frame
      (cell (@snd (_ snd_ _*)) (1 5 6))
      (feed @snd @back)
      (queue (@front @back) (2 3 4)))
    (frame
      (cell (@snd (_ snd_ _*)) (1 6))
      (feed @snd @back)
      (queue (@front @back) (2 3 4 5)))
    (frame
      (cell (@snd (_ snd_ _*)) (1))
      (feed @snd @back)
      (queue (@front @back) (2 3 4 5 6)))
    end)

  ;; Make sure setting works, also not susceptible to injection.
  (rack
    (frame
      (cell (@snd (fst_ snd_ _*)) (1 2 3 4 5 6))
      (cell @x qux)
      (extension (@x x_ @snd) (seen ^x ^^fst ^^snd)))
    (frame
      (cell (@snd (fst_ snd_ _*)) (1 (seen qux ^fst ^snd) 3 4 5 6))
      (cell @x qux)
      (extension (@x x_ @snd) (seen ^x ^^fst ^^snd)))
    end))

;; Frag
(group
  (rack
    (frame
      (cell @x 0)
      (frag @bridge-dst)
      (cell @y)
      (cell @bridge-src (feed @x @y))
      (feed @bridge-src @bridge-dst))
    (frame
      (cell @x 0)
      (frag @bridge-dst (feed @x @y))
      (cell @y)
      (cell @bridge-src)
      (feed @bridge-src @bridge-dst))
    (frame
      (cell @x)
      (frag @bridge-dst (feed @x @y))
      (cell @y 0)
      (cell @bridge-src)
      (feed @bridge-src @bridge-dst))
    end)

  ;; Legacy: like circuit but write-only and embeds, doesn't isolate.
  (rack
    (frame
      (cell @x (delay 3 (feed @a @b)))
      (feed @x @y)
      (frag @y)
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (delay 3 (feed @a @b)))
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (delay 2 (feed @a @b)))
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (delay 1 (feed @a @b)))
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (feed @a @b))
      (cell @a 100)
      (cell @b))
    (frame
      (cell @x)
      (feed @x @y)
      (frag @y (feed @a @b))
      (cell @a)
      (cell @b 100))
    end))

;; extension
(group
  ;; Many sources, dst pattern `_`
  (rack
    (frame
      (cell @x 1)
      (queue (@y @y') (2 3 4))
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s 0))
    (frame
      (cell @x 1)
      (queue (@y @y') (3 4))
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s 3))
    (frame
      (cell @x 1)
      (queue (@y @y') (4))
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s 4))
    (frame
      (cell @x 1)
      (queue (@y @y') ())
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s 5))
    end)

  ;; Ditto, dst unset
  (rack
    (frame
      (cell @x 1)
      (cell @y 2)
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s))
    (frame
      (cell @x 1)
      (cell @y)
      (discard @y)
      (extension ((@x @y) (x_ y_) @s _) ^(+ x y))
      (cell @s))
    end)

  ;; No dst pattern
  (rack
    (frame
      (cell @x 2)
      (queue (@y @y') (2 3 4))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s)
      (feed (@s @y) (@y' @trash))
      (cell @trash)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (2 3 4))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s 4)
      (feed (@s @y) (@y' @trash))
      (cell @trash)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (3 4 4))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s)
      (feed (@s @y) (@y' @trash))
      (cell @trash 2)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (3 4 4))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s 6)
      (feed (@s @y) (@y' @trash))
      (cell @trash)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (4 4 6))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s)
      (feed (@s @y) (@y' @trash))
      (cell @trash 3)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (4 4 6))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s 8)
      (feed (@s @y) (@y' @trash))
      (cell @trash)
      (discard @trash))
    (frame
      (cell @x 2)
      (queue (@y @y') (4 6 8))
      (extension ((@x @y) (x_ y_) @s) ^(* x y))
      (cell @s)
      (feed (@s @y) (@y' @trash))
      (cell @trash 4)
      (discard @trash)))
    ;; ...

  ;; Shorthand variant for one input, no dst pattern
  (rack
    (frame
      (queue (@x @x') (1 2 3))
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y))
    (frame
      (queue (@x @x') (2 3))
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y 2))
    (frame
      (queue (@x @x') (3))
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y 4))
    (frame
      (queue (@x @x') ())
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y 6))
    (frame
      (queue (@x @x') ())
      (discard @x)
      (extension (@x x_ @y) ^(* x 2))
      (cell @y))
    end)

  ;; Dst pattern constraint spans across to the source pattern
  (rack
    (frame
      (module {}
        (cell @x x)
        (extension (@x k_ @y (%value k v_string)) ^v)
        (cell @y {x: 10, a: "John", b: "Samantha", z: "David"}))
      (module {}
        (cell @x b)
        (extension (@x k_ @y (%value k v_string)) ^v)
        (cell @y {x: 10, a: "John", b: "Samantha", z: "David"})))
    (frame
      (module {}
        (cell @x x)
        (extension (@x k_ @y (%value k v_string)) ^v)
        (cell @y {x: 10, a: "John", b: "Samantha", z: "David"}))
      (module {}
        (cell @x b)
        (extension (@x k_ @y (%value k v_string)) ^v)
        (cell @y "Samantha")))
    end)

  ;; Extension semantics
  (rack
    (frame
      (cell @x "hi")
      (extension (@x x_string @view)
        (foo ^x flag: true))
      (cell @view)
      (backsys @view  {¦ flag -seen_} <> {seen: true}))
    (frame
      (cell @x "hi")
      (extension (@x x_string @view)
        (foo ^x flag: true))
      (cell @view (foo "hi" flag: true))
      (backsys @view  {¦ flag -seen_} <> {seen: true}))
    (frame
      (cell @x "hi")
      (extension (@x x_string @view)
        (foo ^x flag: true))
      (cell @view (foo "hi" flag: true seen: true))
      (backsys @view  {¦ flag -seen_} <> {seen: true}))
    end))

;; Termspace
(group
  ;; Sensor-appearance chan 1:1
  (rack
    (frame
      (module {}
        (sensor (local x_ @val) ^x)
        (cell @val)
        (discard @val))
      (module {}
        (cell @val 100)
        (appearance local @val)))
    (frame
      (module {}
        (sensor (local x_ @val) ^x)
        (cell @val 100)
        (discard @val))
      (module {}
        (cell @val)
        (appearance local @val)))
    (frame
      (module {}
        (sensor (local x_ @val) ^x)
        (cell @val)
        (discard @val))
      (module {}
        (cell @val)
        (appearance local @val)))
    end)

  ;; Sensor-appearance chan M:1
  (rack
    (frame
      (module {}
        (sensor (local x_ @val) ^x)
        (cell @val)
        (discard @val))
      (module {}
        (sensor (local x_ @val) ^x)
