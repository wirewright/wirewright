  ;; Cancellation
  ;;
  ;; NOTE: This is a weird little test because there are a lot of races when
  ;; it comes to cancellation. Parsing is CPU-bound. The more "powerful" your CPU,
  ;; the more is the chance that the parse actually *completes* between two frames,
  ;; before we can cancel it, even if we cancel it right in the next frame. A lot of
  ;; stuff goes into this: whether workers have started immediately, whether other cores
  ;; were free, whether workers were moved there, how much other work is pending in the current
  ;; frame, whether or not we have to compile stuff (this in particular caused a huge
  ;; confusion for me, and I was hunting this as a bug; one that did not in fact exist).
  ;; If we run this without warmup, there is a chance that we go off compiling Term.cases
  ;; after the parse was scheduled. Term.cases in turn go off compiling M1. Once all
  ;; that finishes the parse may as well be done. So during the next frame we
  ;; simultaneously `discard` it and consume it and write the parse @output. In that case,
  ;; since both `discard` and `parser` agree that `@input` is empty, D7 (correctly!) lets
  ;; the patches through. In other words, what we're testing here is ultimately a race
  ;; (in the good rather than the bad, "quirky" sense of the word). Cancellation is not a race
  ;; if it really does take an obscenely long time to parse, maybe a few seconds.
  ;; I'm not sure it's worth it inserting inputs so large here, though. We'd probably
  ;; need megabytes of input or a complex grammar...
  (rack
    (frame
      (parser (@input -> slow -> @output)
        (slow slow "a")
        (slow "a"))
      (discard @input)
      (cell @input "")
      (cell @output))
    (frame/tail
      (cell @input)
      (cell @output))
    end)

  ;; abort, expect, _ -> _ -> _ / _
  (rack
    (frame
      (parser (@input -> top -> @output / @error)
        (top "hello" (expect "expected `world`" "world"))
        (top "foo" (expect "expected `bar`" "bar"))
        (top (abort "expected `hello` or `foo`")))
      (discard @output)
      (discard @error)
      (queue (@front @back)
        ("qux" "hello" "helloworld" "foo" "foobar"))
      (feed @front @input)
      (cell @input)
      (cell @output)
      (cell @error))
    (frame/tail
      (cell @input "qux") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output) (cell @error (err "expected `hello` or `foo`")))
    (frame/tail
      (cell @input "hello") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output) (cell @error (err "expected `world`")))
    (frame/tail
      (cell @input "helloworld") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output ()) (cell @error))
    (frame/tail
      (cell @input "foo") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output) (cell @error (err "expected `bar`")))
    (frame/tail
      (cell @input "foobar") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output ()) (cell @error))
    (frame/tail
      (cell @input) (cell @output) (cell @error))
    end)

  ;; refuse
  (rack
    (frame
      (parser (@input -> top -> @output / @error)
        (top "a") => 1
        (top "b") => 2
        (top (refuse "expected `a` or `b`")))
      (discard @output)
      (discard @error)
      (queue (@front @back)
        ("a" "b" "c"))
      (feed @front @input)
      (cell @input)
      (cell @output)
      (cell @error))
    (frame/tail
      (cell @input "a") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output 1) (cell @error))
    (frame/tail
      (cell @input "b") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output 2) (cell @error))
    (frame/tail
      (cell @input "c") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output) (cell @error (err "expected `a` or `b`")))
    (frame/tail
      (cell @input) (cell @output) (cell @error))
    end)

  ;; abort
  (rack
    (frame
      (parser (@input -> top -> @output / @error)
        (top foo)
        (top bar)
        (foo "a") => 1
        (foo "b") => 2
        (foo (abort "expected `a` or `b`"))
        (bar "c") => 3)
      (discard @output)
      (discard @error)
      (queue (@front @back)
        ("a" "b" "c"))
      (feed @front @input)
      (cell @input)
      (cell @output)
      (cell @error))
    (frame/tail
      (cell @input "a") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output 1) (cell @error))
    (frame/tail
      (cell @input "b") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output 2) (cell @error))
    (frame/tail
      (cell @input "c") (cell @output) (cell @error))
    (frame/tail
      (cell @input) (cell @output) (cell @error (err "expected `a` or `b`")))
    (frame/tail
      (cell @input) (cell @output) (cell @error))
    end)

  ;; _ - _ - _ / _
  (rack
    (frame
      (parser (@input - top - @output / @error)
        (top "hello") => 1
        (top "world") => 2
        (top (refuse "invalid")))
      ;; NOTE: I can't quite come up with an easier way to "manipulate"
      ;; the circuit here, i.e., without encoding the entire set of tests
      ;; ahead- of-time. This is basically a simple "controller" which
      ;; waits for expected results and if those results are observed,
      ;; "turns the knobs" to advance the state...
      (backsys {@:input @:output @:error}
        {¦ input_: "hello" output: 1 -error} <> {input: "world"}
        {¦ input_: "world" output: 2 -error} <> {input: "qux"})
      (cell @input "hello")
      (cell @output)
      (cell @error))
    (frame/tail
      (cell @input "hello") (cell @output 1) (cell @error))
    (frame/tail
      (cell @input "world") (cell @output 1) (cell @error))
    (frame/tail
      (cell @input "world") (cell @output 2) (cell @error))
    (frame/tail
      (cell @input "qux") (cell @output 2) (cell @error))
    (frame/tail
      (cell @input "qux") (cell @output) (cell @error (err "invalid")))
    end))

;; Conditional parent
(group
  ;; Basic
  (rack
    (frame
      (cell @active false)
      (guard (@active true) (cell @x 0))
      (guard (@active true) (cell @y))
      (guard (@x _number) (feed @x @y))
      (guard (@y _number) (feed @y @x))
      (backsys @active
        x←true <> {x: false}
        x←false <> {x: true}))
    (frame
      (cell @active true)
      (guard (@active true) (cell @x 0))
      (guard (@active true) (cell @y))
      (guard (@x _number) (feed @x @y))
      (guard (@y _number) (feed @y @x))
      (backsys @active
        x←true <> {x: false}
        x←false <> {x: true}))
    (frame
      (cell @active false)
      (guard (@active true) (cell @x))
      (guard (@active true) (cell @y 0))
      (guard (@x _number) (feed @x @y))
      (guard (@y _number) (feed @y @x))
      (backsys @active
        x←true <> {x: false}
        x←false <> {x: true}))
    (frame
      (cell @active true)
      (guard (@active true) (cell @x))
      (guard (@active true) (cell @y 0))
      (guard (@x _number) (feed @x @y))
      (guard (@y _number) (feed @y @x))
      (backsys @active
        x←true <> {x: false}
        x←false <> {x: true}))
    (frame
      (cell @active false)
      (guard (@active true) (cell @x 0))
      (guard (@active true) (cell @y))
      (guard (@x _number) (feed @x @y))
      (guard (@y _number) (feed @y @x))
      (backsys @active
        x←true <> {x: false}
        x←false <> {x: true})))
    ;; ...

  ;; Counter
  (rack
    (frame
      (feed @x @ys)
      (backsys @turn ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 0)
      (guard (@turn 0) (queue (@x @xs) ("Joe" "Samantha")))
      (guard (@turn 1) (queue (@x @xs) ("Jane" "David" "Alice")))
      (guard (@turn 2) (queue (@x @xs) ("Barbara" "Bob")))
      (queue (@y @ys) ()))
    (frame/tail
      (cell @turn 1)
      (guard (@turn 0) (queue (@x @xs) ("Samantha")))
      (guard (@turn 1) (queue (@x @xs) ("Jane" "David" "Alice")))
      (guard (@turn 2) (queue (@x @xs) ("Barbara" "Bob")))
      (queue (@y @ys) ("Joe")))
    (frame/tail
      (cell @turn 2)
      (guard (@turn 0) (queue (@x @xs) ("Samantha")))
      (guard (@turn 1) (queue (@x @xs) ("David" "Alice")))
      (guard (@turn 2) (queue (@x @xs) ("Barbara" "Bob")))
      (queue (@y @ys) ("Joe" "Jane")))
    (frame/tail
      (cell @turn 0)
      (guard (@turn 0) (queue (@x @xs) ("Samantha")))
      (guard (@turn 1) (queue (@x @xs) ("David" "Alice")))
      (guard (@turn 2) (queue (@x @xs) ("Bob")))
      (queue (@y @ys) ("Joe" "Jane" "Barbara")))
    (frame/tail
      (cell @turn 1)
      (guard (@turn 0) (queue (@x @xs) ()))
      (guard (@turn 1) (queue (@x @xs) ("David" "Alice")))
      (guard (@turn 2) (queue (@x @xs) ("Bob")))
      (queue (@y @ys) ("Joe" "Jane" "Barbara" "Samantha")))
    (frame/tail
      (cell @turn 2)
      (guard (@turn 0) (queue (@x @xs) ()))
      (guard (@turn 1) (queue (@x @xs) ("Alice")))
      (guard (@turn 2) (queue (@x @xs) ("Bob")))
      (queue (@y @ys) ("Joe" "Jane" "Barbara" "Samantha" "David")))
    (frame/tail
      (cell @turn 0)
      (guard (@turn 0) (queue (@x @xs) ()))
      (guard (@turn 1) (queue (@x @xs) ("Alice")))
      (guard (@turn 2) (queue (@x @xs) ()))
      (queue (@y @ys) ("Joe" "Jane" "Barbara" "Samantha" "David" "Bob")))
    (frame/tail
      (cell @turn 1)
      (guard (@turn 0) (queue (@x @xs) ()))
      (guard (@turn 1) (queue (@x @xs) ("Alice")))
      (guard (@turn 2) (queue (@x @xs) ()))
      (queue (@y @ys) ("Joe" "Jane" "Barbara" "Samantha" "David" "Bob")))
    (frame/tail
      (cell @turn 2)
      (guard (@turn 0) (queue (@x @xs) ()))
      (guard (@turn 1) (queue (@x @xs) ()))
      (guard (@turn 2) (queue (@x @xs) ()))
      (queue (@y @ys) ("Joe" "Jane" "Barbara" "Samantha" "David" "Bob" "Alice")))
    (frame/tail
      (cell @turn 0)
      (guard (@turn 0) (queue (@x @xs) ()))
      (guard (@turn 1) (queue (@x @xs) ()))
      (guard (@turn 2) (queue (@x @xs) ()))
      (queue (@y @ys) ("Joe" "Jane" "Barbara" "Samantha" "David" "Bob" "Alice"))))
    ;; ...

  ;; Counter and feeds
  (rack
    (frame
      (cell @counter 0)
      (backsys @counter ±n <> {n: ^(mod (+ n 1) 3)})
      (guard (@counter 0)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y)))
      (guard (@counter 1)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y)))
      (guard (@counter 2)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y))))
    (frame
      (cell @counter 1)
      (backsys @counter ±n <> {n: ^(mod (+ n 1) 3)})
      (guard (@counter 0)
        (module {}
          (cell @x)
          (feed @x @y @x)
          (cell @y 100)))
      (guard (@counter 1)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y)))
      (guard (@counter 2)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y))))
    (frame
      (cell @counter 2)
      (backsys @counter ±n <> {n: ^(mod (+ n 1) 3)})
      (guard (@counter 0)
        (module {}
          (cell @x)
          (feed @x @y @x)
          (cell @y 100)))
      (guard (@counter 1)
        (module {}
          (cell @x)
          (feed @x @y @x)
          (cell @y 100)))
      (guard (@counter 2)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y))))
    (frame
      (cell @counter 0)
      (backsys @counter ±n <> {n: ^(mod (+ n 1) 3)})
      (guard (@counter 0)
        (module {}
          (cell @x)
          (feed @x @y @x)
          (cell @y 100)))
      (guard (@counter 1)
        (module {}
          (cell @x)
          (feed @x @y @x)
          (cell @y 100)))
      (guard (@counter 2)
        (module {}
          (cell @x)
          (feed @x @y @x)
          (cell @y 100))))
    (frame
      (cell @counter 1)
      (backsys @counter ±n <> {n: ^(mod (+ n 1) 3)})
      (guard (@counter 0)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y)))
      (guard (@counter 1)
        (module {}
          (cell @x)
          (feed @x @y @x)
          (cell @y 100)))
      (guard (@counter 2)
        (module {}
          (cell @x)
          (feed @x @y @x)
          (cell @y 100))))
    (frame
      (cell @counter 2)
      (backsys @counter ±n <> {n: ^(mod (+ n 1) 3)})
      (guard (@counter 0)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y)))
      (guard (@counter 1)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y)))
      (guard (@counter 2)
        (module {}
          (cell @x)
          (feed @x @y @x)
          (cell @y 100))))
    (frame
      (cell @counter 0)
      (backsys @counter ±n <> {n: ^(mod (+ n 1) 3)})
      (guard (@counter 0)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y)))
      (guard (@counter 1)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y)))
      (guard (@counter 2)
        (module {}
          (cell @x 100)
          (feed @x @y @x)
          (cell @y)))))
    ;; ...

  ;; Chain
  (rack
    (frame
      (feed (copy @a) @b)
      (feed (copy @b) @c)
      (feed (copy @c) @d)
      (feed @d @a)
      (cell @a "kaixo")
      (guard (@a _string)
        (cell @b))
      (guard (@b _string)
        (cell @c)
        (discard @a))
      (guard (@c _string)
        (cell @d)
        (discard @b)))
    (frame/tail
      (cell @a "kaixo")
      (guard (@a _string)
        (cell @b "kaixo"))
      (guard (@b _string)
        (cell @c)
        (discard @a))
      (guard (@c _string)
        (cell @d)
        (discard @b)))
    (frame/tail
      (cell @a)
      (guard (@a _string)
        (cell @b "kaixo"))
      (guard (@b _string)
        (cell @c "kaixo")
        (discard @a))
      (guard (@c _string)
        (cell @d)
        (discard @b)))
    ;; NOTE: Progress is blocked because @b _string guard wants @b to be a string;
    ;; @a _string guard wants @a to be a string. @a is empty. @a _string guard fails
    ;; and deactivates @b cell. @b _string cell doesn't find the @b cell and deactivates
    ;; itself. Thus, the whole circuit reaches quiescence.
    end)

  ;; Cycle. The only requirement is for this thing not to segfault.
  (rack
    (frame
      (guard (@a _string)
        (cell @b "Kaixo"))
      (guard (@b _string)
        (cell @a "mundua")))
    end)

  ;; Module passable
  (rack
    (frame
      (module {:@a} (cell @a 100))
      (module {:@b} (cell @b 200))
      (guard (@a 100) (cell @foo "Hi"))
      (guard (@b 100) (cell @foo "Bye"))
      (cell @bar)
      (feed @foo @bar)
      (discard @bar))
    (frame
      (module {:@a} (cell @a 100))
      (module {:@b} (cell @b 200))
      (guard (@a 100) (cell @foo))
      (guard (@b 100) (cell @foo "Bye"))
      (cell @bar "Hi")
      (feed @foo @bar)
      (discard @bar))
    (frame
      (module {:@a} (cell @a 100))
      (module {:@b} (cell @b 200))
      (guard (@a 100) (cell @foo))
      (guard (@b 100) (cell @foo "Bye"))
      (cell @bar)
      (feed @foo @bar)
      (discard @bar))
    end)

  ;; Module impassable
  (rack
    (frame
      (module {} (cell @a 100))
      (guard (@a 100) (cell @foo "Hi"))
      (cell @bar)
      (feed @foo @bar))
    end)

  ;; Circuit impassable
  (rack
    (frame
      (device (cell @a 100))
      (guard (@a 100) (cell @foo "Hi"))
      (cell @bar)
      (feed @foo @bar))
    end)

  ;; From docs
  (rack
    (frame
      (backsys @turn
        t←alice <> {t: bob}
        t←bob <> {t: alice})
      (feed @x @ys)
      (cell @turn alice)
      (guard (@turn alice) (queue (@x @xs) (1 2 3)))
      (guard (@turn bob) (queue (@x @xs) (100 200 300)))
      (queue (@y @ys) ()))
    (frame/tail
      (cell @turn bob)
      (guard (@turn alice) (queue (@x @xs) (2 3)))
      (guard (@turn bob) (queue (@x @xs) (100 200 300)))
      (queue (@y @ys) (1)))
    (frame/tail
      (cell @turn alice)
      (guard (@turn alice) (queue (@x @xs) (2 3)))
      (guard (@turn bob) (queue (@x @xs) (200 300)))
      (queue (@y @ys) (1 100)))
    (frame/tail
      (cell @turn bob)
      (guard (@turn alice) (queue (@x @xs) (3)))
      (guard (@turn bob) (queue (@x @xs) (200 300)))
      (queue (@y @ys) (1 100 2)))
    (frame/tail
      (cell @turn alice)
      (guard (@turn alice) (queue (@x @xs) (3)))
      (guard (@turn bob) (queue (@x @xs) (300)))
      (queue (@y @ys) (1 100 2 200)))
    (frame/tail
      (cell @turn bob)
      (guard (@turn alice) (queue (@x @xs) ()))
      (guard (@turn bob) (queue (@x @xs) (300)))
      (queue (@y @ys) (1 100 2 200 3)))
    (frame/tail
      (cell @turn alice)
      (guard (@turn alice) (queue (@x @xs) ()))
      (guard (@turn bob) (queue (@x @xs) ()))
      (queue (@y @ys) (1 100 2 200 3 300)))
    (frame/tail
      (cell @turn bob)
      (guard (@turn alice) (queue (@x @xs) ()))
      (guard (@turn bob) (queue (@x @xs) ()))
      (queue (@y @ys) (1 100 2 200 3 300))))
    ;; ...

  ;; The same example but with control so that it terminates
  (rack
    (frame
      (frag @alice
        (guard (@turn alice)
          (queue (@x @xs) (1 2 3))))
      (frag @bob
        (guard (@turn bob)
          (queue (@x @xs) (100 200 300))))
      (backsys {@:driver, @:alice, @:bob}
        {¦ alice: (_ _ (queue _ ())) bob: (_ _ (queue _ ())) driver_}
          <> {(driver): ()})
      (feed @x @ys)
      (cell @turn alice)
      (frag @driver
        (backsys @turn
          t←alice <> {t: bob}
          t←bob <> {t: alice}))
      (queue (@y @ys) ()))
    (frame/tail fast-forward: true ;; this step removes @driver
      (cell @turn alice)
      (frag @driver
        (backsys @turn
          t←alice <> {t: bob}
          t←bob <> {t: alice}))
      (queue (@y @ys) (1 100 2 200 3 300)))
    (frame/tail fast-forward: true
      (cell @turn bob) ;; but it had a chance to run so the turn is bob's forever
      (frag @driver)
      (queue (@y @ys) (1 100 2 200 3 300)))
    end)

  (rack
    (frame
      (part (@state @count) {¦ ±count})
      (backsys @count ±n <> {n: ^(+ n 1)})
      (guard (@count (%pipe (mod 2) 0))
        (feed @d @sink))
      (feed @a @b @c @d)
      (discard @sink)
      (cell @state {count: 0})
      (cell @a 100)
      (cell @b 200)
      (cell @c 300)
      (cell @d 400)
      (cell @sink))
    (frame/tail
      (cell @state {count: 1})
      (cell @a 100)
      (cell @b 200)
      (cell @c 300)
      (cell @d)
      (cell @sink 400))
    (frame/tail
      (cell @state {count: 2})
      (cell @a 100)
      (cell @b 200)
      (cell @c)
      (cell @d 300)
      (cell @sink))
    (frame/tail
      (cell @state {count: 3})
      (cell @a 100)
      (cell @b)
      (cell @c 200)
      (cell @d)
      (cell @sink 300))
    (frame/tail
      (cell @state {count: 4})
      (cell @a)
      (cell @b 100)
      (cell @c)
      (cell @d 200)
      (cell @sink))
    (frame/tail
      (cell @state {count: 5})
      (cell @a)
      (cell @b)
      (cell @c 100)
      (cell @d)
      (cell @sink 200))
    (frame/tail
      (cell @state {count: 6})
      (cell @a)
      (cell @b)
      (cell @c)
      (cell @d 100)
      (cell @sink))
    (frame/tail
      (cell @state {count: 7})
      (cell @a)
      (cell @b)
      (cell @c)
      (cell @d)
      (cell @sink 100))
    (frame/tail
      (cell @state {count: 8})
      (cell @a)
      (cell @b)
      (cell @c)
      (cell @d)
      (cell @sink))
    (frame/tail
      (cell @state {count: 9})
      (cell @a)
      (cell @b)
      (cell @c)
      (cell @d)
      (cell @sink))))
    ;; ...

;; frag...->...
(group
  ;; From docs
  (rack
    (frame
      (cell @xs (1 2 3))
      (backsys @xs
        (_ ±n _) <> {n: ^(+ n 1)})
      (frag (@xs (_ ±n _) -> (cell @ys {¦ -count: n}) (cell @ys {¦ count: n_}))
        (cell @ys {})))
    (frame
      (cell @xs (1 3 3))
      (backsys @xs
        (_ ±n _) <> {n: ^(+ n 1)})
      (frag (@xs (_ ±n _) -> (cell @ys {¦ -count: n}) (cell @ys {¦ count: n_}))
        (cell @ys {count: 3})))
    (frame
      (cell @xs (1 4 3))
      (backsys @xs
        (_ ±n _) <> {n: ^(+ n 1)})
      (frag (@xs (_ ±n _) -> (cell @ys {¦ -count: n}) (cell @ys {¦ count: n_}))
        (cell @ys {count: 4}))))
    ;; ...

  ;; Manipulate guard
  (rack
    (frame
      (cell @count 0)
      (backsys @count ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 1)
      (queue (@x @xs) (100 200 300))
      (frag (@count n_ -> (guard (@_ `n) _*) (guard (@_ n_) _*))
        (guard (@turn) (feed @x @ys)))
      (queue (@y @ys) ()))
    (frame
      (cell @count 1)
      (backsys @count ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 1)
      (queue (@x @xs) (100 200 300))
      (frag (@count n_ -> (guard (@_ `n) _*) (guard (@_ n_) _*))
        (guard (@turn 1) (feed @x @ys)))
      (queue (@y @ys) ()))
    (frame
      (cell @count 2)
      (backsys @count ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 1)
      (queue (@x @xs) (200 300))
      (frag (@count n_ -> (guard (@_ `n) _*) (guard (@_ n_) _*))
        (guard (@turn 2) (feed @x @ys)))
      (queue (@y @ys) (100)))
    (frame
      (cell @count 0)
      (backsys @count ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 1)
      (queue (@x @xs) (200 300))
      (frag (@count n_ -> (guard (@_ `n) _*) (guard (@_ n_) _*))
        (guard (@turn 0) (feed @x @ys)))
      (queue (@y @ys) (100)))
    (frame
      (cell @count 1)
      (backsys @count ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 1)
      (queue (@x @xs) (200 300))
      (frag (@count n_ -> (guard (@_ `n) _*) (guard (@_ n_) _*))
        (guard (@turn 1) (feed @x @ys)))
      (queue (@y @ys) (100)))
    (frame
      (cell @count 2)
      (backsys @count ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 1)
      (queue (@x @xs) (300))
      (frag (@count n_ -> (guard (@_ `n) _*) (guard (@_ n_) _*))
        (guard (@turn 2) (feed @x @ys)))
      (queue (@y @ys) (100 200)))
    (frame
      (cell @count 0)
      (backsys @count ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 1)
      (queue (@x @xs) (300))
      (frag (@count n_ -> (guard (@_ `n) _*) (guard (@_ n_) _*))
        (guard (@turn 0) (feed @x @ys)))
      (queue (@y @ys) (100 200)))
    (frame
      (cell @count 1)
      (backsys @count ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 1)
      (queue (@x @xs) (300))
      (frag (@count n_ -> (guard (@_ `n) _*) (guard (@_ n_) _*))
        (guard (@turn 1) (feed @x @ys)))
      (queue (@y @ys) (100 200)))
    (frame
      (cell @count 2)
      (backsys @count ±n <> {n: ^(mod (+ n 1) 3)})
      (cell @turn 1)
      (queue (@x @xs) ())
      (frag (@count n_ -> (guard (@_ `n) _*) (guard (@_ n_) _*))
        (guard (@turn 2) (feed @x @ys)))
      (queue (@y @ys) (100 200 300)))))
    ;; ...

;; supervisor
(rack
  (frame
    (cell @clock 0)
    (backsys @clock ±t <> {t: ^(+ t 1)})

    ;; Key added, device added.
    (guard (@clock 0)
      (backsys @xs (_* `x) <> {x: (a 100)}))
    (guard (@clock 1)
      (backsys @xs (_* `x) <> {x: (b 200)}))
    (guard (@clock 2)
      (backsys @xs (_* `x) <> {x: (c 300)}))

    ;; let it evolve for 3..<6

    ;; Key removed, device removed.
    (guard (@clock 6)
      (backsys @xs (x_ _*) <> {(x): ()}))

    ;; Key turnover (same key, different item), item changed, device updated.
    (guard (@clock 7)
      (backsys @xs (_* x_) <> {x: (c 400)}))

    ;; Item changed, device updated.
    (guard (@clock 8)
      (backsys @xs (x_ _*) <> {x: (foo 234)}))

    ;; let it evolve for 9

    ;; Key conflict, both devices removed.
    (guard (@clock 10)
      (backsys @xs (_* `x) <> {x: (foo 123)}))

    ;; let it evolve for 11

    ;; Key conflict resolved, device reintroduced.
    (guard (@clock 12)
      (backsys @xs (x_ _*) <> {(x): ()}))

    ;; let it evolve for 13..<15

    ;; Remove list
    (guard (@clock 15)
      (backsys {¦ xs_} <> {(xs): ()}))

    ;; let it evolve for 16

    ;; Reintroduce list
    (guard (@clock 17)
      (backsys {¦ -xs_} <> {xs: ((qux 100) (qyx 200))}))

    (supervisor (@xs @x (key_ _) - @pool)
      (cell @state 0)
      (backsys
        ;; Make sure we have read-only access to the item.
        {¦ x: (_ ±n)} <> {n: ^(+ n 1)}
        ;; Make sure we can modify internal state.
        {¦ ±state} <> {state: ^(+ state 1)}))

    (cell @xs ())
    (circuit (pool @pool)))

  (frame pattern: true
    (_*
     (cell @xs ((a 100)))
     (circuit (pool @pool))))

  (frame pattern: true
    (_*
     (cell @xs ((a 100) (b 200)))
     (circuit (pool @pool)
       (device (cell @x (a 101)) (cell @state 1) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((a 100) (b 200) (c 300)))
     (circuit (pool @pool)
       (device (cell @x (a 101)) (cell @state 2) _*)
       (device (cell @x (b 201)) (cell @state 1) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((a 100) (b 200) (c 300)))
     (circuit (pool @pool)
       (device (cell @x (a 101)) (cell @state 3) _*)
       (device (cell @x (b 201)) (cell @state 2) _*)
       (device (cell @x (c 301)) (cell @state 1) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((a 100) (b 200) (c 300)))
     (circuit (pool @pool)
       (device (cell @x (a 101)) (cell @state 4) _*)
       (device (cell @x (b 201)) (cell @state 3) _*)
       (device (cell @x (c 301)) (cell @state 2) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((a 100) (b 200) (c 300)))
     (circuit (pool @pool)
       (device (cell @x (a 101)) (cell @state 5) _*)
       (device (cell @x (b 201)) (cell @state 4) _*)
       (device (cell @x (c 301)) (cell @state 3) _*))))

  ;; remove a
  (frame pattern: true
    (_*
     (cell @xs ((b 200) (c 300)))
     (circuit (pool @pool)
       (device (cell @x (a 101)) (cell @state 6) _*)
       (device (cell @x (b 201)) (cell @state 5) _*)
       (device (cell @x (c 301)) (cell @state 4) _*))))

  ;; change c
  (frame pattern: true
    (_*
     (cell @xs ((b 200) (c 400)))
     (circuit (pool @pool)
       (device (cell @x (b 201)) (cell @state 6) _*)
       (device (cell @x (c 301)) (cell @state 5) _*))))

  ;; replace (b 200) -> (foo 234)
  (frame pattern: true
    (_*
     (cell @xs ((foo 234) (c 400)))
     (circuit (pool @pool)
       (device (cell @x (b 201)) (cell @state 7) _*)
       (device (cell @x (c 401)) (cell @state 6) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((foo 234) (c 400)))
     (circuit (pool @pool)
       (device (cell @x (c 401)) (cell @state 7) _*)
       (device (cell @x (foo 235)) (cell @state 1) _*))))

  ;; Collide key foo
  (frame pattern: true
    (_*
     (cell @xs ((foo 234) (c 400) (foo 123)))
     (circuit (pool @pool)
       (device (cell @x (c 401)) (cell @state 8) _*)
       (device (cell @x (foo 235)) (cell @state 2) _*))))

  ;; Devices with colliding keys disappear
  (frame pattern: true
    (_*
     (cell @xs ((foo 234) (c 400) (foo 123)))
     (circuit (pool @pool)
       (device (cell @x (c 401)) (cell @state 9) _*))))

  ;; Collision is removed
  (frame pattern: true
    (_*
     (cell @xs ((c 400) (foo 123)))
     (circuit (pool @pool)
       (device (cell @x (c 401)) (cell @state 10) _*))))

  ;; Supervisor reintroduces foo keyed node
  (frame pattern: true
    (_*
     (cell @xs ((c 400) (foo 123)))
     (circuit (pool @pool)
       (device (cell @x (c 401)) (cell @state 11) _*)
       (device (cell @x (foo 124)) (cell @state 1) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((c 400) (foo 123)))
     (circuit (pool @pool)
       (device (cell @x (c 401)) (cell @state 12) _*)
       (device (cell @x (foo 124)) (cell @state 2) _*))))

  ;; List is emptied
  (frame pattern: true
    (_*
     (cell @xs)
     (circuit (pool @pool)
       (device (cell @x (c 401)) (cell @state 13) _*)
       (device (cell @x (foo 124)) (cell @state 3) _*))))

  (frame pattern: true
    (_*
     (cell @xs)
     (circuit (pool @pool))))

  ;; List is reintroduced
  (frame pattern: true
    (_*
     (cell @xs ((qux 100) (qyx 200)))
     (circuit (pool @pool))))

  (frame pattern: true
    (_*
     (cell @xs ((qux 100) (qyx 200)))
     (circuit (pool @pool)
       (device (cell @x (qux 101)) (cell @state 1) _*)
       (device (cell @x (qyx 201)) (cell @state 1) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((qux 100) (qyx 200)))
     (circuit (pool @pool)
       (device (cell @x (qux 101)) (cell @state 2) _*)
       (device (cell @x (qyx 201)) (cell @state 2) _*))))

  (frame pattern: true
    (_*
     (cell @xs ((qux 100) (qyx 200)))
     (circuit (pool @pool)
       (device (cell @x (qux 101)) (cell @state 3) _*)
       (device (cell @x (qyx 201)) (cell @state 3) _*)))))
  ;; ...
