  ;; Dependent sensors and appearances
  (rack
    (frame
      ((sensor* cell) (local even←(%pipe (mod 2) 0) @even))
      ((sensor* cell) (local odd←(%pipe (mod 2) (%not 0)) @odd))
      ((appearance cell) (local @x) 100)
      ((appearance cell) (local @y) 201)
      ((appearance cell) (local @z) 300)
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)})
      (backsys @z  ±n <> {n: ^(+ n 1)}))
    (frame pattern: true
      ⟨(_ (local _ @even) (100 300))
       (_ (local _ @odd) (201))
       (_ (local @x) 100)
       (_ (local @y) 201)
       (_ (local @z) 300)⟩)
    (frame pattern: true
      ⟨(_ (local _ @even) (100 300))
       (_ (local _ @odd) (201))
       (_ (local @x) 101)
       (_ (local @y) 202)
       (_ (local @z) 301)⟩)
    (frame pattern: true
      ⟨(_ (local _ @even) (202))
       (_ (local _ @odd) (101 301))
       (_ (local @x) 101)
       (_ (local @y) 202)
       (_ (local @z) 301)⟩)
    (frame pattern: true
      ⟨(_ (local _ @even) (202))
       (_ (local _ @odd) (101 301))
       (_ (local @x) 102)
       (_ (local @y) 203)
       (_ (local @z) 302)⟩)
    (frame pattern: true
      ⟨(_ (local _ @even) (102 302))
       (_ (local _ @odd) (203))
       (_ (local @x) 102)
       (_ (local @y) 203)
       (_ (local @z) 302)⟩))
    ;; ...

  ;; Independent sensors and appearances
  (rack
    (frame
      (module {}
        ((sensor cell) (local (a ±x) @x))
        (transfer (@x ±N @x') (a ^(+ N 1)))
        ((appearance cell) (local @x') (a 100)))
      (module {}
        ((sensor cell) (local (b ±x) @x))
        (transfer (@x ±N @x') (b ^(+ N 1)))
        ((appearance cell) (local @x') (b 200)))
      (module {}
        ((sensor cell) (local (c ±x) @x))
        (transfer (@x ±N @x') (c ^(+ N 1)))
        ((appearance cell) (local @x') (c 300))))
    (frame
      (module {}
        ((sensor cell) (local (a ±x) @x) 100)
        (transfer (@x ±N @x') (a ^(+ N 1)))
        ((appearance cell) (local @x')))
      (module {}
        ((sensor cell) (local (b ±x) @x) 200)
        (transfer (@x ±N @x') (b ^(+ N 1)))
        ((appearance cell) (local @x')))
      (module {}
        ((sensor cell) (local (c ±x) @x) 300)
        (transfer (@x ±N @x') (c ^(+ N 1)))
        ((appearance cell) (local @x'))))
    (frame
      (module {}
        ((sensor cell) (local (a ±x) @x))
        (transfer (@x ±N @x') (a ^(+ N 1)))
        ((appearance cell) (local @x') (a 101)))
      (module {}
        ((sensor cell) (local (b ±x) @x))
        (transfer (@x ±N @x') (b ^(+ N 1)))
        ((appearance cell) (local @x') (b 201)))
      (module {}
        ((sensor cell) (local (c ±x) @x))
        (transfer (@x ±N @x') (c ^(+ N 1)))
        ((appearance cell) (local @x') (c 301))))
    (frame
      (module {}
        ((sensor cell) (local (a ±x) @x) 101)
        (transfer (@x ±N @x') (a ^(+ N 1)))
        ((appearance cell) (local @x')))
      (module {}
        ((sensor cell) (local (b ±x) @x) 201)
        (transfer (@x ±N @x') (b ^(+ N 1)))
        ((appearance cell) (local @x')))
      (module {}
        ((sensor cell) (local (c ±x) @x) 301)
        (transfer (@x ±N @x') (c ^(+ N 1)))
        ((appearance cell) (local @x')))))
    ;; ...

  ;; Sensor chan must be confused by multiple matching appearances with
  ;; different values, doing nothing.
  (rack
    (frame
      ((sensor cell) (local ±n @n))
      ((appearance cell) (local @x) 100)
      ((appearance cell) (local @y) 200)
      ((appearance cell) (local @z) 300))
    end)

  ;; ... but if they have the same value it must accept.
  (rack
    (frame
      ((sensor cell) (local ±n @n))
      ((appearance cell) (local @x) 100)
      ((appearance cell) (local @y) 100)
      ((appearance cell) (local @z) 100))
    (frame
      ((sensor cell) (local ±n @n) 100)
      ((appearance cell) (local @x))
      ((appearance cell) (local @y))
      ((appearance cell) (local @z)))
    end)

  ;; Extension of N cells (ok)
  (rack
    (frame
      (cell @x 100)
      (cell @y 200)
      (extension ((@x @y) values_ @z) ^values)
      (cell @z))
    (frame
      (cell @x 100)
      (cell @y 200)
      (extension ((@x @y) values_ @z) ^values)
      (cell @z (100 200)))
    end)

  ;; Extension of N cells (missing)
  (rack
    (frame
      (cell @x 100)
      (cell @y)
      (extension ((@x @y) values_ @z) ^values)
      (cell @z))
    end)

  ;; Extension of N cells (delay, queue, mismatch)
  (rack
    (frame
      (queue (@command @back) (greet welcome greet))
      (delay 2 (discard @command))
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output))
    (frame
      (queue (@command @back) (greet welcome greet))
      (delay 1 (discard @command))
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) (greet welcome greet))
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) (welcome greet))
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) (greet))
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output))
    (frame
      (queue (@command @back) ())
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output "Hi, Mary of age 26!"))
    (frame
      (queue (@command @back) ())
      (discard @command)
      (cell @name "Mary")
      (cell @age 26)
      (extension ((@command @name @age) (greet name_ age_) @output)
        ^"Hi, ⸢name⸣ of age ⸢age⸣!")
      (cell @output))
    end))

;; Elementary 1D movement circuit
(group
  ;; Basic
  (rack
    (frame
      (circuit @world
        .
        .
        (module {}
          (cell @id foo)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        .
        .
        .)
      (backsys @world
        W←⟨⟨[cell @world (%optional () w_)]⟩⟩°
          <> {w: ^(morph W (backmap ⟨M←⟨[cell @id id_]⟩⟩° {M: ^id}))}
        ⟨A_ B←⟨[cell @dir up]⟩⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}
        ⟨A←⟨[cell @dir dn]⟩ B_⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}))
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world M_dict . . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . M_dict . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . M_dict . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . M_dict . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . M_dict . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . M_dict .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . . M_dict]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . . M_dict .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . . M_dict . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . . M_dict . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . . M_dict . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . . M_dict . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world . M_dict . . . . . .]⟫))
    ;; ...

  ;; Multiple modules
  (rack
    (frame
      (circuit @world
        .
        .
        (module {}
          (cell @id foo)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        (module {}
          (cell @id bar)
          (cell @world)
          (cell @dir up)
          (backsys (@id @world @dir)
            (id_ (_ id_ _*) dir←up) <> {dir: dn}
            (id_ (_* id_ _) dir←dn) <> {dir: up}
            (id_ ⟨A_ B←id_⟩ dir←up) <> {A: ^B, B: ^A}
            (id_ ⟨A←id_ B_⟩ dir←dn) <> {A: ^B, B: ^A}))
        .
        .
        .)
      (backsys @world
        W←⟨⟨[cell @world (%optional () w_)]⟩⟩°
          <> {w: ^(morph W (backmap ⟨M←⟨[cell @id id_]⟩⟩° {M: ^id}))}
        ⟨A_ B←⟨[cell @dir up]⟩⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}
        ⟨A←⟨[cell @dir dn]⟩ B_⟩°
          <> {(post A): ^(up B), (post B): ^(up A)}))
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ ⟨[cell @id bar]⟩ . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id bar]⟩ ⟨[cell @id foo]⟩ . . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . ⟨[cell @id bar]⟩ . . ⟨[cell @id foo]⟩]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . . ⟨[cell @id bar]⟩ ⟨[cell @id foo]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . . ⟨[cell @id foo]⟩ ⟨[cell @id bar]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . .]⟫)
    (frame pattern: true
      ⟪[circuit @world  . ⟨[cell @id foo]⟩ . . ⟨[cell @id bar]⟩ . . . .]⟫)))
    ;; ...

;; Elementary breakdown (regression test)
(rack
  (frame
    (cell @mouth
      (module {}
        (cell @name "John Doe")
        (cell @age 26)
        (cell @comment "It's pretty dark in here . . .")))
    (feed @mouth (@sack back))
    ;; Breakdown of arbitrary structure into particles (here, for demonstration
    ;; purposes, they are %atom's as per M1).
    (group
      (cell @sack ())
      (cell @particles ())
      (backsys {@:sack @:particles}
        {¦ sack: (particle←(%atom) _*) particles: (_* `atom)}
          <> {(particle): (), atom: ^particle}
        {¦ sack: (particle←(items_* ¦ pairs_) _*)}
          <> {(particle): (^*items ^*(entries pairs))})
      (feed (@particles front) @particle))
    ;; Breakdown of particles into strands of runes.
    (group
      (cell @particle)
      (transfer (@particle p_ @strand) ^(ml/display p)))
    ;; Breakdown of strands of runes into individual runes.
    (group
      (cell @strand)
      (backsys {@:strand @:rune}
        {¦ strand_: ""} <> {(strand): ()}
        {¦ strand_: (%string nonempty) -rune_}
          <> {rune: ^(rune strand 0), strand: ^(runes strand 1 ..= -1)}))
    ;; Breakdown of runes into chains of bases.
    (group
      (cell @rune)
      (transfer (@rune rune_string @base-chain)
        ^(repr (codepoints rune) '(digits alphabet: "ABCD"))))
    ;; Breakdown of chains of bases into bases.
    (group
      (cell @base-chain)
      (backsys {bases: @base-chain, @:base}
        {¦ bases_: ()} <> {(bases): ()}
        {¦ bases_: (B_string _*) -base_}
          <> {(B): (), base: ^B}))
    ;; Movement of bases into the base pool.
    (group
      (cell @base)
      (backsys {@:base @:pool}
        {¦ base_ pool_dict}
          <> {(base): (), pool: ^(mset/union pool (entry base 1))}))
    (cell @pool ()))
  (frame pattern: true fast-forward: true
    ⟨[cell @pool {"A": 56, "B": 132, "C": 96, "D": 50}]⟩)
  end)

;; Handling of disjoint and non-disjoint writes to the same location.
(group
  ;; Disjoint writes must all succeed.
  (rack
    (frame
      (cell @x {"A": 100, "B": 200, "C": 300})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)}))
    (frame
      (cell @x {"A": 99, "B": 400, "C": 301})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)}))
    (frame
      (cell @x {"A": 98, "B": 800, "C": 302})
      (backsys @x
        {¦ "A": ±n} <> {n: ^(- n 1)})
      (backsys @x
        {¦ "B": ±n} <> {n: ^(* n 2)})
      (backsys @x
        {¦ "C": ±n} <> {n: ^(+ n 1)})))
    ;; ...

  ;; Insertions in the middle conflict with other write(s).
  ;;
  ;; NOTE: Here we see the unconditional suppression of insertion which
  ;; is supposed to be a deterministic, but not exactly human-
  ;; comprehensible choice.
  (rack
    (frame
      (cell @x (+ 1 2))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"}))
    (frame
      (cell @x (+ 2 3 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"}))
    (frame
      (cell @x (+ 3 4 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n⟩° <> {n: ^(+ n 1)})
      (backsys @x  [+ `x _ _] <> {x: "foo"})))
    ;; ...

  ;; We can "fix" conflicts like these with explicit staging. Rack
  ;; won't be able to do anything about them on its own, because the
  ;; conflicts above are, in a sense, as "pure" as conflicts go.
  (rack
    (frame
      (cell @x (+ 1 2))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 1 2 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊  qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 2 3 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))
    (frame
      (cell @x (+ "foo" 3 4 qux: true))
      (backsys @x  {¦ -qux_} <> {qux: true})
      (backsys @x  ⟨±n ⍊ qux⟩° <> {n: ^(+ n 1)})
      (backsys @x  (+ `x _ _ ⍊ -qux) <> {x: "foo"}))))
    ;; ...

;; part
(group
  ;; Chain of length 1
  (rack
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux (_ a_) _))
      (feed (copy @a) @b)
      (cell @b))
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux (_ a_) _))
      (feed (copy @a) @b)
      (cell @b 2))
    end)

  ;; Chain of length 2
  (rack
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view)
      (cell @b-view))
    (frame
      (cell @top (qux (1 2) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view (1 2))
      (cell @b-view 2))
    end)

  ;; Chain of length 3
  (rack
    (frame
      (cell @top (qux (1 {name: "Samantha"}) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (part (@b @c) {¦ name: c_string})
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (feed (copy @c) @c-view)
      (cell @a-view)
      (cell @b-view)
      (cell @c-view))
    (frame
      (cell @top (qux (1 {name: "Samantha"}) (3 4)))
      (part (@top @a) (qux a_ _))
      (part (@a @b) (_ b_))
      (part (@b @c) {¦ name: c_string})
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (feed (copy @c) @c-view)
      (cell @a-view (1 {name: "Samantha"}))
      (cell @b-view {name: "Samantha"})
      (cell @c-view "Samantha"))
    end)

  ;; Branching
  (rack
    (frame
      (cell @root
        {xs: (1 2 3), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}), responses: ()})
      (part (@root @xs) {¦ xs_})
      (part (@root @y) {¦ y_})
      (part (@root @zs) {¦ zs_})
      (part (@root @responses) {¦ responses_})
      (part (@xs @x) (x_ _*))
      (part (@zs @z) (z_ _*))
      (part (@z @a) {¦ a_})
      (part (@z @b) {¦ b_})
      (backsys {@:x @:y @:a @:b @:responses}
        {¦ ±x ±y ±a ±b responses: (_* `back)}
          <> {(x): (), back: {^:x ^:y ^:a ^:b}}))
    (frame pattern: true
      ⟪(cell @root
         {xs: (2 3), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}),
          responses: ({x: 1, y: 4, a: 5, b: 6})})⟫)
    (frame pattern: true
      ⟪(cell @root
         {xs: (3), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}),
          responses: ({x: 1, y: 4, a: 5, b: 6}
                      {x: 2, y: 4, a: 5, b: 6})})⟫)
    (frame pattern: true
      ⟪(cell @root
         {xs: (), y: 4, zs: ({a: 5, b: 6} {a: 7, b: 8}),
          responses: ({x: 1, y: 4, a: 5, b: 6}
                      {x: 2, y: 4, a: 5, b: 6}
                      {x: 3, y: 4, a: 5, b: 6})})⟫)
    end)

  ;; Loop
  (rack
    (frame
      (cell @top (foo 0))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view)
      (cell @b-view))
    (frame
      (cell @top (foo 0))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (feed (copy @a) @a-view)
      (feed (copy @b) @b-view)
      (cell @a-view 0)
      (cell @b-view 0))
    end)

  ;; Loop with branch
  (rack
    (frame
      (cell @top (foo 0))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @c) c_)
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo 1))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @c) c_)
      (backsys @c  ±n <> {n: ^(+ n 1)}))
    (frame
      (cell @top (foo 2))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @c) c_)
      (backsys @c  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Loop with branches
  (rack
    (frame
      (cell @top (foo (10 20)))
      (part (@top @a) (_ a_))
      (part (@a @b) b_)
      (part (@b @a) a_)
      (part (@b @x) (x_ _))
      (part (@b @y) (_ y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
