      (part (@b @a) a_)
      (part (@b @x) (x_ _))
      (part (@b @y) (_ y_))
      (backsys @x  ±n <> {n: ^(+ n 1)})
      (backsys @y  ±n <> {n: ^(+ n 1)})))
    ;; ...

  ;; Dyn mismatch manipulate
  (rack
    (frame
      (cell @top (foo 0 0))
      (part (@top @a) (foo a←(%number 3 <= _ <= 7) _))
      (part (@top @b) (foo _ b←(%number 7 <= _ <= 11)))
      (backsys {@:top @:a @:b}
        {¦ top: (foo ±n _) -a} <> {n: ^(+ n 1)}
        {¦ top: (foo _ ±n) -b} <> {n: ^(+ n 1)}))
    (frame pattern: true
      ⟪(foo 1 1)⟫)
    (frame pattern: true
      ⟪(foo 2 2)⟫)
    (frame pattern: true
      ⟪(foo 3 3)⟫)
    (frame pattern: true
      ⟪(foo 3 4)⟫)
    (frame pattern: true
      ⟪(foo 3 5)⟫)
    (frame pattern: true
      ⟪(foo 3 6)⟫)
    (frame pattern: true
      ⟪(foo 3 7)⟫)
    end)

  ;; Basic
  (rack
