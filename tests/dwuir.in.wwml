;; viewport pan-x-side: right, pan-y-side: right
(group z-index: local dl: 1650 dt: 10
  (rect final-w: 100 final-h: 100 fill: lightgray z-index: -1)
  (viewport final-w: 100 final-h: 100 content-w: 10 content-h: 10 pan-x-side: right pan-y-side: bottom
    (rect final-w: 10 final-h: 10 fill: green)))

(group z-index: local dl: 1650 dt: 120
  (rect final-w: 100 final-h: 100 fill: lightgray z-index: -1)
  (viewport final-w: 100 final-h: 100 content-w: 10 content-h: 10 pan-x: 20 pan-y: 30 pan-x-side: right pan-y-side: bottom
