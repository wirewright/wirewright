    font: "IBM Plex Serif"
    color: black
    size: 14
    wrap: true
    wrap-on-words: false
    transform: {+ strip}
    z-index: 1
    final-w: 50
    final-h: 100)
  (rect
    fill: (oklch 0.8 0 0)
    z-index: 0
    final-w: 50
    final-h: 100))

;; Text transform: pretty
(group dl: 820 dt: 50
  (text
    caption: "\n   Lorem      ipsum   \n"
    font: "IBM Plex Serif"
    color: black
    size: 14
    wrap: true
    wrap-on-words: false
    transform: {+ pretty}
    z-index: 1
    final-w: 50
    final-h: 100)
  (rect
    fill: (oklch 0.8 0 0)
    z-index: 0
    final-w: 50
    final-h: 100))

;; Draw a clock to test relative dl/dt, pivot, origin.
(group dl: 800 dt: 800 final-w: 100 final-h: 100
  (rect
    final-w: 100
    final-h: 100
    radius-tl: (* 1)
    radius-tr: (* 1)
    radius-bl: (* 1)
    radius-br: (* 1)
    fill: (oklch 0.8 0 0)
    z-index: 0)
  (rect
    dl: (* 0.5)
    dt: (* 0.5)
    final-w: 10
    final-h: 10
    origin: true
    origin-l: 0.5
    origin-t: 0.5
    radius-tl: (* 1)
    radius-tr: (* 1)
    radius-bl: (* 1)
    radius-br: (* 1)
    fill: (oklch 0.9 0 0)
    z-index: 10)
  (rect
    dl: (* 0.5)
    dt: (* 0.5)
    pivot: true
    pivot-t: 1.0
    origin: true
    origin-l: 0.5
    origin-t: 1.0
    angle: 250
    final-w: 3
    final-h: 40
    fill: (translucent (oklch 0.5 0.2 0) 0.5)
    z-index: 1)
  (rect
    dl: (* 0.5)
    dt: (* 0.5)
    pivot: true
    pivot-t: 1.0
    origin: true
    origin-l: 0.5
    origin-t: 1.0
    angle: 0
    final-w: 3
    final-h: 40
    fill: (translucent (oklch 0.5 0.2 150) 0.5)
    z-index: 1)
  (rect
    dl: (* 0.5)
    dt: (* 0.5)
    pivot: true
    pivot-t: 1.0
    origin: true
    origin-l: 0.5
    origin-t: 1.0
    angle: 80
    final-w: 4
    final-h: 40
    fill: (translucent (oklch 0 0 0) 0.5)
    z-index: 2))

;; Rotation of text
;; Rotation of text with selection
(group dl: 950 dt: 50
  (group
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Serif"
      color: black
      size: 14
      pivot: true
      angle: 45
      wrap: true
      wrap-on-words: false
      z-index: 1
      final-w: 100
      final-h: 100)
    (rect
      fill: (oklch 0.8 0 0)
      z-index: 0
      final-w: 100
      final-h: 100))
  (group dt: 130
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Serif"
      color: black
      size: 14
      pivot: true
      angle: 180
      selection: true
      selection-anchor: 5
      selection-span: 0
      selection-fill: red
      wrap: true
      wrap-on-words: false
      transform: {+ pretty}
      z-index: 1
      final-w: 100
      final-h: 100)
    (rect
      fill: (oklch 0.8 0 0)
      z-index: 0
      final-w: 100
      final-h: 100))
  (group dl: 130
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Serif"
      color: black
      size: 14
      selection: true
      selection-anchor: 0
      selection-span: 20
      selection-radius: 5
      selection-extent: 0.5
      selection-fill: violet
      selection-color: black
      pivot: true
      angle: -45
      wrap: true
      wrap-on-words: false
      transform: {+ pretty}
      z-index: 1
      final-w: 100
      final-h: 100)
    (rect
      fill: (oklch 0.8 0 0)
      z-index: 0
      final-w: 100
      final-h: 100)))

;; Linear gradient
;; Linear gradient paint on text, selection rect, underline.
;;
;; FIXME: for text and underline, gradients must be generated for
;; that text's tfbounds box! Right now we're painting each individual
;; frag (or continuous segments thereof); and each frag's underline
;; individually. This is wrong for anything except solid color.
(group dl: 1000 dt: 300
  (rect
    radius-tl: 10
    radius-tr: 10
    radius-bl: 10
    radius-br: 10
    fill:
      (linear-gradient begin-l: 0
                       begin-t: 0.5
                       end-l: 1
                       end-t: 0.5
        (stop 0 (oklch 0.5 0.2 0))
        (stop 0.3 (oklch 0.5 0.2 100))
        (stop 0.5 (oklch 0.5 0.2 150))
        (stop 0.8 (oklch 0.5 0.2 200))
        (stop 1.0 (oklch 0.5 0.2 300)))
    final-w: 150
    final-h: 30)
  (group dt: 50
    (text
      caption: "Hello World"
      font: "IBM Plex Mono"
      color:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      size: 18
      wrap: true
      wrap-on-words: false
      z-index: 1
      final-w: 200
      final-h: 100))
  (group dt: 80
    (text
      caption: "Hello World"
      font: "IBM Plex Sans"
      selection: true
      selection-anchor: 5
      selection-span: 0
      selection-fill:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      size: 18
      wrap: true
      wrap-on-words: false
      z-index: 1
      final-w: 200
      final-h: 100))
  (group dt: 110
    (text
      caption: "Hello World"
      font: "IBM Plex Sans"
      selection-radius: 5
      selection: true
      selection-anchor: 3
      selection-span: 7
      selection-fill:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      size: 18
      wrap: true
      wrap-on-words: false
      z-index: 1
      final-w: 200
      final-h: 100))
  (group dt: 140
    (text
      caption: "Hello World"
      font: "IBM Plex Sans"
      selection-radius: 5
      selection: true
      selection-anchor: 3
      selection-span: 7
      selection-extent: 0.5
      selection-fill:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      size: 18
      underline: true
      underline-offset: 7
      underline-thickness: 3
      underline-color:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      wrap: true
      wrap-on-words: false
      z-index: 1
      final-w: 200
      final-h: 100)))

;; Radial gradient "cursor"
(rect
  dl: ^mouse-x
  dt: ^mouse-y
  final-w: 300
  final-h: 300
  z-index: 100
  origin: true
  origin-l: 0.5
  origin-t: 0.5
  fill:
    (radial-gradient
      center-radius: 0.5
      focus-radius: 0.1
      (stop 0 (translucent (oklch 0.3 0 0) 0.9))
      (stop 0.5 (translucent (oklch 0.5 0 0) 0.5))
      (stop 1 (translucent (oklch 0 0 0) 0))))

;; Radial gradient paint on text, rounded rect, selection rect, underline.

;; Image paint
(group dl: 1080 dt: 180
  ;; fit: default
  (group
    (text
      caption: "fit: stretch"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill: (image (file "data/214-500x400.jpg"))
      radius-tl: 10
      radius-br: 10
      final-w: 100
      final-h: 100))
  ;; fit: match origin
  (group dl: 120
    (text
      caption: "fit: origin"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill:
        (image fit: (align)
          (file "data/214-500x400.jpg"))
      final-w: 100
      final-h: 100))
  ;; fit: align centers
  (group dl: 240
    (text
      caption: "fit: center"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill:
        (image fit: (align l: 0.5 t: 0.5)
          (file "data/214-500x400.jpg"))
      final-w: 100
      final-h: 100))
  ;; fit: align bottom right
  (group dl: 120 dt: -110
    (text
      caption: "fit: bottom-right"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill:
        (image fit: (align l: 1 t: 1)
          (file "data/214-500x400.jpg"))
      final-w: 100
      final-h: 100))
  ;; fit: pan
  (group dl: 240 dt: -110
    (text
      caption: "fit: pan"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill:
        (image fit: (pan l: -100 t: -100)
          (file "data/214-500x400.jpg"))
      final-w: 100
      final-h: 100))
  ;; fit: align, tile, resize
  (group dl: 360
    (text
      caption: "fit: tile"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      dt: 110
      final-w: 100
      final-h: 30)
    (rect
      fill: (image fit: (align)
                   tile: true
                   resize-w: 32
                   resize-h: 32
        (file "data/soma-256x256-white.png"))
      final-w: 100
      final-h: 100))
  ;; Show logo
  (group dl: 360 dt: -110
    (rect
      z-index: 1
      fill: (image fit: (align l: 0.5 t: 0.5)
                   resize-w: (= 64)
                   resize-h: (= 64)
                   opacity: 0.8
        (file "data/soma-256x256-white.png"))
      final-w: 100
      final-h: 100)
    (rect
      fill:
        (radial-gradient
          center-radius: 3.5
          focus-radius: 0
          (stop 0 (oklch 0 0 0))
          (stop 1 (oklch 1 0 0)))
      final-w: 100
      final-h: 100)))

;; Image paint on text, rounded rect, selection, underline.

;; Essential viewport: pan, zoom
(viewport zoom: 2.3 final-w: 100 final-h: 100 pan-x: 10 pan-y: -10 dl: 950 dt: 800
  (text caption: "Lorem\n\nipsum"
    font: "IBM Plex Sans"
    size: 14
    z-index: 1
    color: (oklch 0.5 0.3 0)
    final-w: 500
    final-h: 500
    leading: 1.5
    tracking: 0.3
    selection: true
    selection-anchor: 12
    selection-span: -12
    selection-color: (oklch 1.0 0 0)
    selection-fill: (oklch 0.6 0.3 250)
    wrap: true))

;; Rotate within viewport
(group dl: 900 dt: 600 final-w: 300 final-h: 100
  (rect z-index: 0 final-w: 300 final-h: 100 fill: (oklch 0.8 0 0))
  (viewport zoom: 1.5 pan-x: 0 pan-y: 0 final-w: 300 final-h: 100
    (group final-w: 300 final-h: 100 pivot: true angle: -10
      (rect
        fill: (oklch 0.8 0.05 0)
        final-w: 300
        final-h: 100
        z-index: 10)

      (text
        caption: "MuSoma"
        font: "IBM Plex Sans"
        weight: 900
        size: 24
        underline: true
        selection: true
        selection-anchor: 6
        selection-span: -5
        selection-fill: (hsl 163.72 0.39 0.51)
        underline-offset: 15
        final-w: 300
        final-h: 100
        z-index: 100
        opacity: 1.0
        color: (oklch 0.5 0.1 250)))))

;; Rotate viewport itself
(group dl: 1100 dt: 500 final-w: 300 final-h: 100 pivot: true angle: 45
  (rect z-index: 0 final-w: 300 final-h: 100 fill: (oklch 0.8 0 0))
  (viewport zoom: 1.5 pan-x: 0 pan-y: 0 final-w: 300 final-h: 100
    (group final-w: 300 final-h: 100
      (rect
        fill: (oklch 0.8 0.05 0)
        final-w: 300
        final-h: 100
        z-index: 10)

      (text
        caption: "MuSoma"
        font: "IBM Plex Sans"
        weight: 900
        size: 24
        underline: true
        selection: true
        selection-anchor: 6
        selection-span: -5
        selection-fill: (hsl 163.72 0.39 0.51)
        underline-offset: 15
        final-w: 300
        final-h: 100
        z-index: 100
        opacity: 1.0
        color: (oklch 0.5 0.1 250)))))

;; Rotate within viewport & viewport itself, zoom, pan
(group dl: 1200 dt: 400 final-w: 300 final-h: 100 pivot: true angle: 45
  (rect z-index: 0 final-w: 300 final-h: 100 fill: (oklch 0.8 0 0))
  (viewport zoom: 1.5 pan-x: 50 pan-y: 100 final-w: 300 final-h: 100
    (group final-w: 300 final-h: 100 pivot: true angle: 40
      (rect
        fill: (oklch 0.8 0.05 0)
        final-w: 300
        final-h: 100
        z-index: 10)

      (text
        caption: "MuSoma"
        font: "IBM Plex Sans"
        weight: 900
        size: 24
        underline: true
        selection: true
        selection-anchor: 6
        selection-span: -5
        selection-fill: (hsl 163.72 0.39 0.51)
        underline-offset: 15
        final-w: 300
        final-h: 100
        z-index: 100
        opacity: 1.0
        color: (oklch 0.5 0.1 250)))))

;; Loading-like linear gradient on text (use green so that it's visible statically)
(text
  caption: "Please wait..."
  font: "IBM Plex Serif"
  color:
    (linear-gradient begin-l: 0
                     begin-t: 0.5
                     end-l: 1
                     end-t: 0.5
      (stop 0 black)
      (stop 0.4 green)
      (stop 1 black))
  size: 24
  wrap: true
  wrap-on-words: false
  z-index: 1
  dl: 950
  dt: 520
  final-w: 200
  final-h: 100)

;; Nested viewport
(group dl: 1100 dt: 750
  (rect
    z-index: -1
    final-w: 200
    final-h: 200
    fill: lightgray)
  (viewport zoom: 0.5 pan-x: 10 pan-y: 80 final-w: 200 final-h: 200
    (group final-w: 300 final-h: 100 pivot: true angle: 45
      (rect z-index: 0 final-w: 200 final-h: 100 fill: orange)
      (viewport z-index: 1 zoom: 1.8 pan-x: 0 pan-y: -100 final-w: 200 final-h: 100
        (group final-w: 300 final-h: 100 pivot: true angle: -40
          (rect
            fill: darkgray
            final-w: 300
            final-h: 100
            z-index: 10)
          (text
            caption: "Hello World"
            font: "IBM Plex Mono"
            weight: 900
            size: 24
            underline: true
            selection: true
            selection-anchor: 6
            selection-span: -5
            selection-fill: (hsl 163.72 0.39 0.51)
            underline-offset: 15
            final-w: 300
            final-h: 100
            z-index: 100
            opacity: 1.0
            color: (oklch 0.5 0.1 250)))))))

;; SVG: clip
