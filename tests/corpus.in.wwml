;; General purpose string editor for µsoma (the logic).
;;
;; Used in search fields, input fields, in the command palette, etc. Anywhere
;; where single- or multiline text input is needed.

[(_*) _ _ _ (_*) (E_ _*)] <> {(E): ()}

;;
;; No selection
;;

;; Insert characters
[(_*) l_string | _string (_*) (E←(input ch_string) _*)]
  <> {(E): (), l: $'(~ →l →ch)}

;; Insert line break
[(_* `spot) l_string | _string (_*) (E←(key enter) _*)]
  <> {(E): (), spot: →l, l: ""}

;; Move left
[(_*) l_string | r_string (_*) (E←(key left) _*)]
  <> {(E): (), l: $'(runes →l 0 to -2), r: $(~ (rune →l -1) →r)}

;; Move right
[(_*) l_string | r_string (_*) (E←(key right) _*)]
  <> {(E): (), l: $(~ →l (rune →r 0)), r: $'(runes →r 1 to -1)}

;; Move word left
[(_*) l_string | r_string (_*) (E←(key C-left) _*)]
  <> {(E): (), l: $'(words →l 0 to -2), r: $(~ (word →l -1) →r)}

;; Move word right
[(_*) l_string | r_string (_*) (E←(key C-right) _*)]
  <> {(E): (), l: $(~ →l (word →r 0)), r: $'(words →r 1 to -1)}

;; Move to line start
[(_*) l_string | r_string (_*) (E←(key home) _*)]
  <> {(E): (), l: "", r: $'(~ →l →r)}

[() _string | _string (_*) (E←(key up) _*)]
  <> {E: (key home)}

;; Move to line end
[(_*) l_string | r_string (_*) (E←(key end) _*)]
  <> {(E): (), l: $'(~ →l →r), r: ""}

[(_*) _string | _string () (E←(key down) _*)]
  <> {E: (key end)}

;; Move to line above
[(_* above_string) l_string | r_string (`below _*) (E←(key up) _*)]
  <> {(E): (), (above): (), l: $'(prefix →above →l), r: $'(suffix →above →l), below: $'(~ →l →r)}

;; Move to line below
[(_* `above) l_string | r_string (below_string _*) (E←(key down) _*)]
  <> {(E): (), above: $'(~ →l →r), l: $'(prefix →below →l), r: $'(suffix →below →l), (below): ()}

;; Delete left
[(_*) l_string | _string (_*) (E←(key backspace) _*)]
  <> {(E): (), l: $'(runes →l 0 to -2)}

;; Delete right
[(_*) _string | r_string (_*) (E←(key delete) _*)]
  <> {(E): (), r: $'(runes →r 1 to -1)}

;; Delete word left
[(_*) l_string | _string (_*) (E←(key C-backspace) _*)]
  <> {(E): (), l: $'(words →l 0 to -2)}

;; Delete word right
[(_*) _string | r_string (_*) (E←(key C-delete) _*)]
  <> {(E): (), r: $'(words →r 1 to -1)}

;; Delete line left
[(_* above_string) l←"" | _string (_*) (E←(key backspace) _*)]
  <> {(E): (), (above): (), l: →above}

;; Delete line right
[(_*) _string | r←"" (below_string _*) (E←(key delete) _*)]
  <> {(E): (), r: →below, (below): ()}

;; Cut

;; Copy

;; Paste

;;
;; Enter selection
;;

;; Select all
[(above_string*) l_string C←| r_string (below_string*) (E←(key C-a) _*)]
  <> {(E): (),
      (above): (),
      l: "",
      C: $(cat (|>) →above ((~ →l →r)) →below),
      r: "",
      (below): ()}

;; Select left
[(_*) l←(%string nonempty) C←| _string (_*) (E←(key S-left) _*)]
  <> {(E): (), l: $'(runes →l 0 to -2), C: (<| $'(rune →l -1))}

;; Select right
[(_*) _string C←| r←(%string nonempty) (_*) (E←(key S-right) _*)]
  <> {(E): (), C: (|> $'(rune →r 0)), r: $'(runes →r 1 to -1)}

;; Select word left
[(_*) l←(%string nonempty) C←| _string (_*) (E←(key C-S-left) _*)]
  <> {(E): (), l: $'(words →l 0 to -2), C: (<| $'(word →l -1))}

;; Select word right
[(_*) _string C←| r←(%string nonempty) (_*) (E←(key C-S-right) _*)]
  <> {(E): (), C: (|> $'(word →r 0)), r: $'(words →r 1 to -1)}

;; Select to line start
[(_*) l←(%string nonempty) C←| _string (_*) (E←(key S-home) _*)]
  <> {(E): (), C: (<| →l), l: ""}

[() _string | _string (_*) (E←(key S-up) _*)]
  <> {E: (key S-home)}

;; Select to line end
[(_*) _string C←| r←(%string nonempty) (_*) (E←(key S-end) _*)]
  <> {(E): (), C: (|> →r), r: ""}

[(_*) _string | _string () (E←(key S-down) _*)]
  <> {E: (key S-end)}

;; Select up
[(_* above_string) l_string C←| _string (_*) (E←(key S-up) _*)]
  <> {(E): (), (above): (), l: $'(prefix →above →l), C: (<| $'(suffix →above →l) →l)}

;; Select down
[(_*) l_string C←| r_string (below_string _*) (E←(key S-down) _*)]
  <> {(E): (), C: (|> →r $'(prefix →below →l)), r: $'(suffix →below →l), (below): ()}

;;
;; Left-leaning selection
;;

;; Extend left
[(_*) l←(%string nonempty) (<| front_string _*) _string (_*) (E←(key S-left) _*)]
  <> {(E): (), l: $'(runes →l 0 to -2), front: $(~ (rune →l -1) →front)}

;; Extend word left
[(_*) l←(%string nonempty) (<| front_string _*) _string (_*) (E←(key C-S-left) _*)]
  <> {(E): (), l: $'(words →l 0 to -2), front: $(~ (word →l -1) →front)}

;; Extend to line start
[(_*) l←(%string nonempty) (<| front_string _*) _string (_*) (E←(key S-home) _*)]
  <> {(E): (), l: "", front: $'(~ →l →front)}

[() _string (<| _+) _string (_*) (E←(key S-up) _*)]
  <> {E: (key S-home)}

;; Extend to line above
[(_* above_string) l_string (<| `head front_string _*) _string (_*) (E←(key S-up) _*)]
  <> {(E): (),
      (above): (),
      l: $'(prefix →above →l),
      head: $'(suffix →above →l),
      front: $'(~ →l →front)}

;; Extend line left
[(_* above_string) l←"" (<| `front _*) _string (_*) (E←(key (%any S-left C-S-left)) _*)]
  <> {(E): (), (above): (), l: →above, front: →l}

;; Expel left
[(_*) l_string (<| front←(%string nonempty) _*) _string (_*) (E←(key S-right) _*)]
  <> {(E): (), l: $(~ →l (rune →front 0)), front: $'(runes →front 1 to -1)}

;; Expel word left
[(_*) l_string (<| front←(%string nonempty) _*) _string (_*) (E←(key C-S-right) _*)]
  <> {(E): (), l: $(~ →l (word →front 0)), front: $'(words →front 1 to -1)}

;; Expel to line end
[(_*) l_string (<| front←(%string nonempty) _*) _string (_*) (E←(key S-end) _*)]
  <> {(E): (), l: $'(~ →l →front), front: ""}

;; Expel line above
[(_* `above) l_string (<| front0_string front1_string _*) _string (_*) (E←(key S-down) _*)]
  <> {(E): (),
      above: $'(~ →l →front0),
      l: $'(prefix →front1 →l),
      (front0): (),
      front1: $'(suffix →front1 →l)}

;; Expel line left
[(_* `above) l_string (<| front←"" _+) _string (_*) (E←(key (%any S-right C-S-right)) _*)]
  <> {(E): (), above: →l, l: "", (front): ()}

;; Escape
[(_*) _string C←(<| "") _string (_*) (E←(key S-right) _*)]
  <> {(E): (), C: |}

;;
;; Right-leaning selection
;;

;; Extend right
[(_*) _string (|> _* back_string) r←(%string nonempty) (_*) (E←(key S-right) _*)]
  <> {(E): (), back: $(~ →back (rune →r 0)), r: $'(runes →r 1 to -1)}

;; Extend word right
[(_*) _string (|> _* back_string) r←(%string nonempty) (_*) (E←(key C-S-right) _*)]
  <> {(E): (), back: $(~ →back (word →r 0)), r: $'(words →r 1 to -1)}

;; Extend to line end
[(_*) _string (|> _* back_string) r←(%string nonempty) (_*) (E←(key S-end) _*)]
  <> {(E): (), back: $'(~ →back →r), r: ""}

[(_*) _string (|> _+) _string () (E←(key S-down) _*)]
  <> {E: (key S-end)}

;; Extend to line below
[(_*) _string (|> _* back_string `tail) r_string (below_string _*) (E←(key S-down) _*)]
  <> {(E): (),
      back: $'(~ →back →r),
      tail: $'(prefix →below →back),
      r: $'(suffix →below →back),
      (below): ()}

;; Extend line right
[(_*) _string (|> _* `back) r←"" (below_string _*) (E←(key (%any S-right C-S-right)) _*)]
  <> {(E): (), back: →r, r: →below, (below): ()}

;; Expel right
[(_*) _string (|> _* back←(%string nonempty)) r_string (_*) (E←(key S-left) _*)]
  <> {(E): (), back: $'(runes →back 0 to -2), r: $(~ (rune →back -1) →r)}

;; Expel word right
[(_*) _string (|> _* back←(%string nonempty)) r_string (_*) (E←(key C-S-left) _*)]
  <> {(E): (), back: $'(words →back 0 to -2), r: $(~ (word →back -1) →r)}

;; Expel to line start
[(_*) _string (|> _* back←(%string nonempty)) r_string (_*) (E←(key S-home) _*)]
  <> {(E): (), back: "", r: $'(~ →back →r)}

;; Expel line below
[(_*) _string (|> _* back1_string back0_string) r_string (`below _*) (E←(key S-up) _*)]
  <> {(E): (),
      (back1): (),
      back0: $'(prefix →back1 →back0),
      r: $'(suffix →back1 →back0),
      below: $'(~ →back0 →r)}

;; Expel line right
[(_*) _string (|> _+ back←"") r_string (`below _*) (E←(key (%any S-left C-S-left)) _*)]
  <> {(E): (), (back): (), r: "", below: →r}

;; Escape
[(_*) _string C←(|> "") _string (_*) (E←(key S-left) _*)]
  <> {(E): (), C: |}

;;
;; Generic selection
;;

;; Switch back to cursor if selection is empty
[(_*) _string C←((%any <| |>)) _string (_*) (_*)]
  <> {C: |}

;; Clear selection and switch back to cursor if any of the deletion keys
;; is pressed
[(_*) _string C←((%any <| |>) _+) _string (_*) (E←(key (%any backspace C-backspace delete C-delete)) _*)]
  <> {(E): (), C: |}

;; Clear selection and switch back to cursor on input, this then handles
;; the input
[(_*) _string C←((%any <| |>) _+) _string (_*) ((input _string) _*)]
  <> {C: |}

;; Escape left
[(_*) _string C←((%any <| |>) front_string) r_string (_*) (E←(key left) _*)]
  <> {(E): (), C: |, r: $'(~ →front →r)}

[(_*) _string C←((%any <| |>) front_string mid_string* back_string) r_string (`below0 `below1 _*) (E←(key left) _*)]
  <> {(E): (), C: |, r: →front, (below0): →mid, below1: $'(~ →back →r)}

;; Escape right
[(_*) l_string C←((%any <| |>) front_string) _string (_*) (E←(key right) _*)]
  <> {(E): (), l: $'(~ →l →front), C: |}

[(_* `above0 `above1) l_string C←((%any <| |>) front_string mid_string* back_string) _string (_*) (E←(key right) _*)]
  <> {(E): (), above0: $'(~ →l →front), (above1): →mid, l: →back, C: |}

("" | "" (m←(%either (input " ") (key enter)) _*) ≡@_ ¦ _) <> {m: (escape-below)}

;; todo: these aren't necessarily the nodes we're looking for; add a way for them
;; to "ask" us to cooperate with them, and for us to in turn "ask" them to coooperate
;; with us; and maintain this "cooperation" throughout rather than blindly trusting
;; the shape.
(button _ @_ (`s ("" | "" (m←(key np5) _*) ≡@_ ¦ _))) <> {s: (press), m: ()}
;; If the cursor is captured
(capture (_* `s) (("" | "" (m←_ _*) ≡@_ ¦ _)) to @_) <> {s: ($ by path m), m: ()}
(capture (_*) (C←("" | "" (m←(key escape) _*) ≡@_ ¦ _)) `s to @_) <> {m: ()}

(l←"die" | "" (m←(input ".") _*) ≡@_ ¦ _) <> {l: "", m: (die)}

(o
 .
 (lookaround
  @snapshots
  @relook
  ("" | "" () @rod)
  (button "Kickstart" to @relook ())
  (edit-cast @rod-commands to @rod)
  (transform
   @rod-commands
   to
   @relook
   true
   #spec: {in: @rod-commands, out: @relook, body: true}
   #shadow:
    (%literal (transform @rod-commands to @relook true)))
  (cell up @dir)
  (transform
   (@snapshots (behind_ ahead_))
   to
   @stimuli
   with
   @dir
   (dir behind ahead)
   #spec:
    {in: @snapshots,
     filter: (behind_ ahead_),
     state: @dir,
     out: @stimuli,
     body: (dir behind ahead)}
   #shadow:
    (%literal
     (transform
      (@snapshots (behind_ ahead_))
      to
      @stimuli
      with
      @dir
      (dir behind ahead))))
  (map
   @stimuli
   to
   @actions
   ((up (_* o) (. _*)) dir-down)
   ((down (_* .) (o _*)) dir-up)
   ((up (_* .) _) keep-moving)
   ((down _ (. _*)) keep-moving))
  (transform
   (@actions dir-down)
   to
   @dirs
   down
   #spec:
    {in: @actions, filter: dir-down, out: @dirs, body: down}
   #shadow:
    (%literal
     (transform (@actions dir-down) to @dirs down)))
  (transform
   (@actions dir-up)
   to
   @dirs
   up
   #spec:
    {in: @actions, filter: dir-up, out: @dirs, body: up}
   #shadow:
    (%literal (transform (@actions dir-up) to @dirs up)))
  (transform
   (@actions keep-moving)
   to
   @dirs
   with
   @dir
   dir
   #spec:
    {in: @actions,
     filter: keep-moving,
     state: @dir,
     out: @dirs,
     body: dir}
   #shadow:
    (%literal
     (transform
      (@actions keep-moving)
      to
      @dirs
      with
      @dir
      dir)))
  (latest @dirs @dir)
  (map
   @dirs
   to
   @rod-commands
   (up (move-parent-behind))
   (down (move-parent-ahead))))
 .
 o
 ("" | "" () @user)
 #population: {(cell @dir): true}
 #cells: {@dir: up}
 #jobs/pending: ())

