;; Stateless filter transform
(d7 limit: 256
  ((cell 0 @value)
   (changes (@value (%number (whole _) < 10) to @values))
   (transform (@values n←(%pipe (mod 2) 0) to @parities) (even n))
   (transform (@values n←(%pipe (mod 2) 1) to @parities) (odd n))
   (transform (@values to @successors) (+ _ 1))
   (latest @successors @value)
   (log @parities in () limit: 7))
  ((cell 9 @value)
   (changes (@value (%number (whole _) < 10) to @values))
   (transform (@values n←(%pipe (mod 2) 0) to @parities) (even n))
   (transform (@values n←(%pipe (mod 2) 1) to @parities) (odd n))
   (transform (@values to @successors) (+ _ 1))
   (latest @successors @value)
   (log @parities in ((odd 3) (even 4) (odd 5) (even 6) (odd 7) (even 8) (odd 9)) limit: 7)))

