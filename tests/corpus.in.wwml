"origin": (+ "dl-0" "dt-0")

(int "dl" N {dl: (spacing N_)})
(int "dt" N {dt: (spacing N_)})
(int "d" (+ "dl" "dt"))

"center": (+ "center-x" "center-y")
"center-x": {align-x: center}
