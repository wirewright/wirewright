;; Essential text wrapping
(group dl: 430 dt: 20 pivot: true angle: ^wheel
  (group
    (rect
      final-w: 10
      final-h: 80
      fill: blue)
    (text
      dl: 20
      caption: "GIZA ESKUBIDEEN ALDARRIKAPEN UNIBERTSALA"
      font: "IBM Plex Sans"
      size: 24
      weight: 800
      tracking: 0.1
      leading: 1
      wrap: true
      final-w: 350
      final-h: 100))
  (group dl: 20 dt: 90
    (text
      caption: "1. atala"
      font: "IBM Plex Sans"
      size: 20
      weight: 600
      final-w: 100
      final-h: 100)
    (text
      caption: "Gizon-emakume guztiak aske jaiotzen dira, duintasun eta eskubide berberak dituztela; eta ezaguera eta kontzientzia dutenez gero, elkarren artean senide legez jokatu beharra dute."
      dt: 40
      font: "IBM Plex Serif"
      size: 16
      weight: 450
      wrap: true
      final-w: 500
      final-h: 500))
  (group dl: 20 dt: 220
    (text
      caption: "2. atala"
      font: "IBM Plex Sans"
      size: 20
      weight: 600
      final-w: 100
      final-h: 100)
    (text
      caption: "Gizaki orori dagozkio Aldarrikapen honetan adierazitako eskubide eta askatasunak, eta ez da inor bereziko arraza, larru-kolorea, sexua, hizkuntza, erlijioa, politikako edo bestelako iritzia, sorterria edo gizarteko jatorria, ekonomi maila, jaiotza edo beste inolako gorabeheragatik.\n\nEz zaio begiratuko gainera, pertsona zein herrialde edo lurraldetakoa den; ezta hango politikari, legeei edo nazioarteko egoerari, nahiz eta herri hori burujabea izan, besteren zainpeko lurraldea, autonomiarik gabea edo nola-halako burujabetasun-mugak dituena. "
      dt: 40
      font: "IBM Plex Serif"
      size: 16
      weight: 450
      wrap: true
      final-w: 500
      final-h: 500)))

;; Text wrapping
(group dl: 10 dt: 450
  ;; All defaults
  (group
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      final-w: 100
      final-h: 100)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 100))

  ;; wrap-history: auto. Long ellipsis. But the text fits just fine!
  (group dl: 110
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      wrap-ellipsis: "(... omitted ...)"
      final-w: 100
      final-h: 100)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 100))

  ;; wrap-history: auto. Wrap with smaller height so that it does not fit.
  (group dl: 220 dt: -30
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50))

  ;; wrap-history: auto. Smaller height, long ellipsis.
  (group dl: 330 dt: -50
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      wrap-ellipsis: "(... omitted ...)"
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50))

  ;; wrap-history: auto. Degenerate ellipsis, fits
  (group dl: 220 dt: 30
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore (fits)"
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      wrap-ellipsis: "I am an incredibly long ellipsis that will not fit in a single line"
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50))

  ;; wrap-history: auto. Degenerate ellipsis, does not fit. We wrap
  ;; in viewport to clip.
  (viewport dl: 330 dt: 10 final-w: 100 final-h: 100
    (group
      (text
        caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
        font: "IBM Plex Sans"
        size: 11
        color: (oklch 0.3 0 0)
        z-index: 2
        wrap: true
        wrap-ellipsis: "I am an incredibly long ellipsis that will not fit in a single line"
        final-w: 100
        final-h: 50)
      (rect
        z-index: 1
        fill: (oklch 0.8 0 0)
        final-w: 100
        final-h: 50)))

  ;; Set wrap-history to `1`. Note how we can only undo once. This is faster
  ;; and consumes a constant amount of memory. But may not be able to handle
  ;; arbitrary ellipsis. Note how here we overflow.
  (viewport dt: 110 final-w: 100 final-h: 100
    (group
      (text
        caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
        font: "IBM Plex Sans"
        size: 11
        color: (oklch 0.3 0 0)
        z-index: 2
        wrap: true
        wrap-ellipsis: "(... omitted ...)"
        wrap-history: 1
        final-w: 100
        final-h: 50)
      (rect
        z-index: 1
        fill: (oklch 0.8 0 0)
        final-w: 100
        final-h: 50)))

  ;; Set wrap-history to `4`. This makes our ellipsis *not* overflow. This
  ;; is what `wrap-history: auto` does -- it finds this number, in our case
  ;; `4`, where ellipsis does not overflow.
  (group dl: 110 dt: 110
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      wrap-ellipsis: "(... omitted ...)"
      wrap-history: 4
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50))

  ;; Trailing newlines must display ellipsis
  (group dl: 220 dt: 90
    (text
      caption: "Lorem ipsum dolor sit amet,\n\n\n\n\n\n"
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50))

  ;; Single newline must display ellipsis
  (group dl: 220 dt: 290
    (text
      caption: "Trailing newline does not fit\n"
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      final-w: 100
      final-h: 30)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 30))

  ;; Single letter after trailing newlines must display ellipsis
  (group dl: 330 dt: 70
    (text
      caption: "Lorem ipsum dolor sit amet,\n\n\n\n\n\na"
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50))

  ;; Ellipsis can undo hard break
  (group dt: 170
    (text
      caption: "Lorem ipsum dolor sit amet, qui\n\nminim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50))

  ;; Leading newlines must trigger ellipsis
  (group dl: 110 dt: 170
    (text
      caption: "\n\n\nLorem ipsum dolor sit amet, qui\n\nminim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50))

  ;; Leading newlines alone must trigger ellipsis
  (group dl: 220 dt: 150
    (text
      caption: "\n\n\n\n\n\n\n"
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50))

  ;; Leading newlines with one letter must trigger ellipsis
  (group dl: 330 dt: 130
    (text
      caption: "\n\n\n\n\n\n\na"
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50)))

;; Text wrapping: on-letters, on-words
(group dl: 10 dt: 680
  ;; Disable wrapping on word boundary. Text fits.
  (group
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      wrap-on-words: false
      final-w: 80
      final-h: 110)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 80
      final-h: 110))
  ;; Disable wrapping on word boundary. Text does not fit.
  (group dt: 120
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      wrap-on-words: false
      final-w: 80
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 80
      final-h: 50))
  ;; Disable wrapping on letter boundary. Text fits. Note how it overflows
  ;; slighly. This is expected behavior. One must use `viewport` to clip if
  ;; that is undesired.
  (group dl: 90
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      wrap-on-letters: false
      final-w: 50
      final-h: 210)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 50
      final-h: 210))
  ;; Ditto, text does not fit.
  (group dl: 160
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      wrap-on-letters: false
      final-w: 50
      final-h: 100)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 50
      final-h: 100))
  ;; Disable both. This is effectively disabling multiline wrapping.
  ;; The text will be omitted when we run out of horizontal space.
  ;; Note how there is still plenty of vertical space. But it is not
  ;; used since we have nothing to wrap on.
  (group dl: 220
    (text
      caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
      font: "IBM Plex Sans"
      size: 11
      color: (oklch 0.3 0 0)
      z-index: 2
      wrap: true
      wrap-on-letters: false
      wrap-on-words: false
      final-w: 100
      final-h: 50)
    (rect
      z-index: 1
      fill: (oklch 0.8 0 0)
      final-w: 100
      final-h: 50)))

;; Text without wrapping will overflow. One can use the `viewport` node
;; to clip overflow (among other things).
(group dl: 170 dt: 790
  (viewport final-w: 100 final-h: 100
    (group
      (text
        caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
        font: "IBM Plex Sans"
        size: 11
        color: (oklch 0.3 0 0)
        z-index: 2
        final-w: 100
        final-h: 100)
      (rect
        z-index: 1
        fill: (oklch 0.8 0 0)
        final-w: 100
        final-h: 100))))

;; Essential selection with span=0
(group dl: 10 dt: 390
  (text caption: "Lorem\nipsum" font: "IBM Plex Sans"
    size: 14
    color: black
    final-w: 100
    final-h: 100
