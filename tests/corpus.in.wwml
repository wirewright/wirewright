        size: 24
        underline: true
        selection: true
        selection-anchor: 6
        selection-span: -5
        selection-fill: (hsl 163.72 0.39 0.51)
        underline-offset: 15
        final-w: 300
        final-h: 100
        z-index: 100
        opacity: 1.0
        color: (oklch 0.5 0.1 250)))))

