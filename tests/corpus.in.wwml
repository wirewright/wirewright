;; Loading-like linear gradient on text (use green so that it's visible statically)
(text
  caption: "Please wait..."
  font: "IBM Plex Serif"
  color:
    (linear-gradient begin-l: 0
                     begin-t: 0.5
                     end-l: 1
                     end-t: 0.5
      (stop 0 black)
      (stop 0.4 green)
      (stop 1 black))
  size: 24
  wrap: true
  wrap-on-words: false
  z-index: 1
  dl: 950
  dt: 520
  final-w: 200
  final-h: 100)

;; Nested viewport
(group dl: 1100 dt: 750
  (rect
    z-index: -1
    final-w: 200
    final-h: 200
    fill: lightgray)
  (viewport zoom: 0.5 pan-l: 10 pan-t: 80 final-w: 200 final-h: 200
    (group final-w: 300 final-h: 100 pivot: true angle: 45
      (rect z-index: 0 final-w: 200 final-h: 100 fill: orange)
      (viewport z-index: 1 zoom: 1.8 pan-l: 0 pan-t: -100 final-w: 200 final-h: 100
        (group final-w: 300 final-h: 100 pivot: true angle: -40
          (rect
            fill: darkgray
            final-w: 300
            final-h: 100
            z-index: 10)
          (text
            caption: "Hello World"
            font: "IBM Plex Mono"
            weight: 900
            size: 24
            underline: true
            selection: true
            selection-anchor: 6
            selection-span: -5
            selection-fill: (hsl 163.72 0.39 0.51)
            underline-offset: 15
            final-w: 300
            final-h: 100
            z-index: 100
            opacity: 1.0
            color: (oklch 0.5 0.1 250)))))))

;; SVG: clip
(group
 dl: 1400
 dt: 800
 final-w: 300
 final-h: 150
 (text
   caption: "resize: clip"
   dt: -20
   font: "IBM Plex Mono"
   size: 11)
