  (punct to)
  (pulse pout "sink for pulse signals"))

(node bridge
  (nested
    (pulse pin "source of pulse signals")
    (literal _ pattern "pattern that they must match"))
  (punct to)
  (nested
    (pulse pout "sink for values of the capture")
    (literal _ capture "name of the capture made by `pattern`")))

(node alloy "Renders an Alloy template from incoming variable dicts (environments)"
  (nested
    (pulse envs "source of environments")
    (punct to)
    (pulse instances "sink for rendered templates (template instances)"))
  (choice
    (literal _ template "Alloy templates that should be rendered")
    (const template "const source for Alloy template that should be rendered"))
  (prop? strict "Do not render if there are problems (e.g. some variables missing). Default: false")
  (prop? complaints "Pulse edge to file complaints to (e.g. that some variable is missing)")
  (examples
    ("Receive environments on @posts/envs and render them as posts."
     (alloy (@posts/envs to @posts/views)
       (^each posts as post
         (group style: "flow-col"
           (h3 (^. post title))
           (p (^. post body))))))))

(forall sampler "Reads the value of const(s) on demand")

(node sampler
  (const cin "const edge that should be sampled")
  (punct on)
  (pulse trigger "triggers the read")
  (punct to)
  (pulse samples "sink for samples taken"))

(node sampler
  (literal _ cins "list of const edges that should be sampled simultaneously")
  (punct on)
  (pulse trigger "triggers the read")
  (punct to)
  (pulse samples "sink for samples taken (lists of simultaneously sampled cins)"))

(node spawner "Spawns nodes above or below itself"
  (pulse nodes "source of nodes to spawn")
  (prop? dir "can be `up` (default) or `down`, anything else is invalid"))

;; Cell invited, expelled, basic behavior of `changes` node, `absence` node.
(d7
  ((decay 10 (cell 0 @count))
   (delay 15 (cell "Hello World" @count))
   (changes @count to @counts)
   (absence @count as "Missing" to @counts)
   (log @counts in ()))
  ((cell "Hello World" @count)
   (changes @count to @counts)
   (absence @count as "Missing" to @counts)
   (log @counts in (0 "Missing" "Hello World"))))

