defaults: {
  p: "content font-sans text-base leading-base text-neutral-400 font-text",
  h1: "content font-sans text-4xl leading-4xl text-neutral-300 font-bold",
  h2: "content font-sans text-2xl leading-2xl text-neutral-300 font-semibold",
  h3: "content font-sans text-xl leading-xl text-neutral-300 font-medium",
  h4: "content font-sans text-lg leading-lg text-neutral-400 font-medium",
  h5: "content font-sans text-sm leading-sm text-neutral-400 font-semibold",
  h6: "content font-sans text-xs leading-xs text-neutral-400 font-bold",
  hr: "w-max max-w-4xl h-px py-1 bg-neutral-500",
  icon: "content font-icons text-base text-neutral-400 font-normal",
  code: "content font-mono text-base leading-base text-neutral-400 font-text",
  src: "content font-mono text-base leading-base text-neutral-400 bg-neutral-950 p-2 font-text",
  button: "bg-neutral-700 hover:bg-blue-500 hover:cursor-pointer rounded-sm px-4 py-2 center text-sm leading-sm text-neutral-50 content font-sans font-medium",
  rect: "max bg-white",
  group: "content",
}

inherit: {+ font font-weight text-color text-size leading}

((self window) style: "bg-neutral-950 max origin" max-w: 1000 max-h: 800
  (group style: "max m-7 center-x"
    (group style: "h-max max-w-bound-5xl gap-7 fr"
    ;; panel
    (group style: "min-w-3xs max-w-3xs h-max bg-neutral-900 rounded-lg p-5 flow-col gap-2 z-10"
      ;; TODO: soma texted logo, requires us to be able to render (image)
      (p "DOCUMENTS" style: "text-neutral-400 font-condensed font-medium text-sm")
      ;; tab
      (group style: "w-max px-4 py-3 rounded-md border-2 border-neutral-800 text-neutral-300 current:bg-neutral-800 current:text-neutral-200 gap-2" current: true
        (group style: "max center-y gap-2 fr"
          (icon "article" style: "text-base")
          (p "Untitled 1" style: "leading-none text-sm")
          (group (icon "close") style: "w-fr right")))
      ;; tab
      (group style: "w-max px-4 py-3 rounded-md border-2 border-neutral-800 text-neutral-300 current:bg-neutral-800 current:text-neutral-200 gap-2" current: false
        (group style: "max center-y gap-2 fr"
          (icon "article" style: "text-base")
          (p "Untitled 2" style: "leading-none text-sm")
          (group (icon "close") style: "w-fr right")))
      ;; tab
      (group style: "w-max px-4 py-3 rounded-md border-2 border-neutral-800 text-neutral-300 current:bg-neutral-800 current:text-neutral-200 gap-2" current: false
        (group style: "max center-y gap-2 fr"
          (icon "article" style: "text-base")
          (p "Untitled 3" style: "leading-none text-sm")
          (group (icon "close") style: "w-fr right"))))
    ;; dashboard
    (group style: "w-fr h-max"
      (group style: "h-max max-w-bound-3xl"
      (group style: "max flow-col gap-7"
        (group style: "w-max flow-col gap-3"
          (h1 "Control Panel" style: "font-text text-3xl")
          (p "While the document is paused, you can modify, replace, save, or navigate through its history using this control panel." style: "w-max text-sm font-normal"))
        (group style: "w-max flow-col"
          ((self rect) style: "w-max h-px bg-neutral-800")
          (group style: "w-max gap-4 fr my-3 px-3"
            (group style: "h-max center-y"
              (p "k" style: "center-y rounded-xs leading-none font-mono p-1 pt-0 text-sm border text-neutral-400 border-neutral-400 font-medium"))
            (p "This is how key bindings look like. Once you're accustomed to them you can hit them right away, e.g. esc-w to save — without waiting for this control panel to appear." style: "w-fr h-max center-y text-xs"))
          ((self rect) style: "w-max h-px bg-neutral-800"))
        ;; dashboard-section
        (group style: "w-max px-3 pt-3 pb-7 rounded-md border border-neutral-900 flow-col gap-5"
          ;; dashboard-section-title
          (group style: "w-max gap-3 fr"
            (icon "timeline" style: "text-neutral-300 text-xl")
            (group style: "w-fr flow-col"
              (p "TIME TRAVEL" style: "font-condensed text-neutral-300 text-sm font-medium")
              (p "Revisit past or future states of the document." style: "w-max text-xs")))
          ;; document-preview-list
          ((self viewport) style: "w-max h-content bg-neutral-950" pan-x: 0 pan-y: 0
            ((self x-translate) style: "w-max h-content" offset: (* -0.2)
              (group style: "gap-5"
                ;; TODO: document-preview, requires us to be able to render (image)
                ;; document-preview-loading
                (group style: "bg-neutral-900 text-neutral-700 max max-w-3xs max-h-xs center flow-col gap-3"
                  (icon "hourglass_top" style: "text-5xl"))
                ;; document-preview-loading
                (group style: "bg-neutral-900 text-neutral-700 max max-w-3xs max-h-xs center flow-col gap-3"
                  (icon "hourglass_top" style: "text-5xl"))
                ;; document-preview-loading
                (group style: "bg-neutral-900 text-neutral-700 max max-w-3xs max-h-xs center flow-col gap-3"
                  (icon "hourglass_top" style: "text-5xl"))))))
        ;; dashboard-section
        (group style: "w-max px-4 pt-3 pb-7 rounded-md border border-neutral-900 flow-col gap-5"
          ;; dashboard-section-title
          (group style: "w-max gap-3 fr"
            (icon "dashboard" style: "text-neutral-300 text-xl")
            (group style: "w-fr flow-col"
              (p "DOCUMENT" style: "font-condensed text-neutral-300 text-sm font-medium")
              (p "Modify, replace, or save the document." style: "w-max text-xs")))
          ;; major-minor-misc-menu
          (group style: "w-max fr gap-5"
            ;; major
            (group style: "w-fr h-max border-2 border-{accent} text-{accent} rounded-sm" accent: (oklch 0.7 0.0343 181.071)
              (group style: "max center gap-5 h-fr"
                (group style: "gap-1"
                  (icon "save" style: "text-xl")
                  (p "Save" style: "leading-none"))
                ;; key
                (p "w" style: "rounded-xs leading-none font-mono p-1 pt-0 text-sm border border-{accent} font-medium" accent: (oklch 0.7 0.0343 181.071))))
            ;; minor-list
            (group style: "w-fr h-max flow-col gap-2 fr"
              ;; minor
              (group style: "w-max h-fr border border-neutral-700 center-y px-5 text-sm rounded-sm fr"
                (group style: "w-fr gap-1"
                  (icon "save_as" style: "h-max text-xl center-y")
                  (p "Save as" style: "h-max leading-none center-y"))
                ;; key
                (p "W" style: "h-max center-y rounded-xs leading-none font-mono p-1 pt-0 text-sm border text-neutral-400 border-neutral-400 font-medium"))
              ;; minor
              (group style: "w-max h-fr border border-neutral-700 center-y px-5 text-sm rounded-sm fr"
                (group style: "w-fr gap-1"
                  (icon "swap_horiz" style: "h-max text-xl center-y")
                  (p "Replace" style: "h-max leading-none center-y"))
                ;; key
                (p "e" style: "h-max center-y rounded-xs leading-none font-mono p-1 pt-0 text-sm border text-neutral-400 border-neutral-400 font-medium")))
            ;; misc-list
            (group style: "w-fr flow-col gap-2"
              ;; misc-item
              (group style: "w-max border border-neutral-700 p-2 text-sm rounded-sm gap-1"
                (icon "auto_fix_high" style: "h-max center-y")
                (p "Spawn cursor" style: "h-max center-y leading-tight"))
              ;; misc-item
              (group style: "w-max border border-neutral-700 p-2 text-sm rounded-sm gap-1"
                (icon "cleaning_services" style: "h-max center-y")
                (p "Destroy cursor" style: "h-max center-y leading-tight"))
              ;; misc-item
              (group style: "w-max border border-neutral-700 p-2 text-sm rounded-sm gap-1"
                (icon "clear_all" style: "h-max center-y")
                (p "Clear" style: "h-max center-y leading-tight"))
              ))
          )
            ))))))

((self window) style: "bg-neutral-900 max origin" max-w: 1000 max-h: 800
  (group style: "max flow-wrap gap-5 p-5"
    (input "" "" "" #el: a label: "First name" placeholder: "John Doe")
    (input "" "" "" #el: a icon: none placeholder: none)
    (input "" "" "" #el: a icon: "search" placeholder: none)
    (input "" "" "" #el: a icon: none placeholder: "John Doe")
    (input "" "" "" #el: a icon: "search" placeholder: "John Doe")
    (input "Saman" "" "tha Doe" #el: a icon: "search" placeholder: "John Doe")
    (input "Saman" "tha" " Doe" #el: a icon: "search" placeholder: "John Doe")
    (input "" "tha " "" #el: a icon: "search" placeholder: "John Doe")
    (input "" "" "" #el: a icon: "search" placeholder: "Hover" hover: true)
    (input "" "" "" #el: a icon: "search" placeholder: "Hover,active" hover: true active: true)
    (input "" "" "" #el: a icon: "search" placeholder: "Focus" focus: true)
    (input "John" "" " Doe" #el: a icon: "search" placeholder: "John Doe" focus: true)
    (input "John" "athan" " Doe" #el: a icon: "search" placeholder: "John Doe" focus: true)
    (input "John" "athan" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true)
    (input "John" "athan" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe")
    (input "John" "athan" " Doe"
      #el: a
      label: (group style: "mb-1 gap-1 h-max"
                (icon "star" style: "h-max center-y")
                (p "Full name" style: "h-max center-y leading-tight text-sm")
                (p "NEW!" style: "h-max center-y font-bold text-xs leading-none bg-green-300 rounded-sm text-green-950 px-0.5 py-0.5 pb-1"))
      icon: "search"
      placeholder: "John Doe")
    (input "John" "" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true hint: "Lorem ipsum dolor sit amet")
    (input "John" "" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true limit: 20)
    (input "John" "" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true hint: "Lorem ipsum dolor sit amet" limit: 20)
    (group style: "max-w-lg"
      (input "John" "" " Doe" #el: a label: "Full name" icon: "search" placeholder: "John Doe" focus: true hint: "Lorem ipsum dolor sit amet, officia excepteur ex fugiat reprehenderit enim labore culpa sint ad nisi Lorem pariatur mollit ex esse exercitation amet." limit: 20))))


;; cursor-color
;; cursor-style
;; cursor-span
;; cursor-index

((self window) style: "bg-neutral-950 max origin" max-w: 1000 max-h: 800
  (group style: "w-max max-w-3xs h-max max-h-3xs px-5 py-5 flow-col gap-10"
    (input "hello world" (| "") "" focus: true #el: qux limit: 120 icon: "article" label: "Post")))
    ;;(h1 "Hello World" sel-anchor: 3 sel-span: 5 style: "max sel-blue-500 sel-text-white")))
    ;; ((self text) caption: "Lorem ipsum dolor sit amet, officia excepteur ex fugiat reprehenderit enim labore culpa sint ad nisi Lorem pariatur mollit ex esse exercitation amet. Nisi anim cupidatat excepteur officia. Reprehenderit nostrud nostrud ipsum Lorem est aliquip amet voluptate voluptate dolor minim nulla est proident. Nostrud officia pariatur ut officia. Sit irure elit esse ea nulla sunt ex occaecat reprehenderit commodo officia dolor Lorem duis laboris cupidatat officia voluptate. Culpa proident adipisicing id nulla nisi laboris ex in Lorem sunt duis officia eiusmod. Aliqua reprehenderit commodo ex non excepteur duis sunt velit enim. Voluptate laboris sint cupidatat ullamco ut ea consectetur et est culpa et culpa duis." size: 24 color: (212 212 212) weight: 450 style: "max sel-blue-500 sel-text-white leading-base font-sans" sel-anchor: 105 sel-span: 10)))

;; The `fallback` prop protects from implementation errors & user errors
;; when uiR is for some reason unable to compute width, height, or position
;; of a node. In that case we replace it with its source code representation.
;;
;; If not for the fallback prop, the UI would break in such cases; since e.g.
;; children of x-stack or y-stack ask their predecessor for w/h/l/t to compute
;; their own w/h/l/t. So the moment someone breaks in the chain, is the moment
;; the rest of the chain doesn't get rendered due to not knowing their l/t/w/h;
;; and all the user will see is nothingness beyond a certain point -- certainly
;; not good UX!

{¦ final-w: _number final-h: _number dl: _number dt: _number fallback_}
  <> {(fallback): ()}

N←{¦ fallback: (¦ () source_ rem_)}
  <> {N: $'(d7uir →source rem: →rem code-only: true)}


;; GENERAL

;; Learn the content width/height from a single child.
((%not x-expand) {¦ content-w: w_number} ¦ _ -content-w: W) <> {W: →w}
((%not y-expand) {¦ content-h: h_number} ¦ _ -content-h: H) <> {H: →h}

;; Propagate max-w/h if I know my max-w/h and I am w/h: max.
(_ {¦ -max-w: w} ¦ _ w: max max-w: W_number) <> {w: →W}
(_ {¦ -max-h: h} ¦ _ h: max max-h: H_number) <> {h: →H}

;; Propagate fractional max-w/h
(_ {¦ max-w_: (* frac←(%number 0 < _ < 1))} ¦ _ w: max max-w: W_number)
  <> {max-w: $(ceil (* →W →frac))}
(_ {¦ max-h_: (* frac←(%number 0 < _ < 1))} ¦ _ h: max max-h: H_number)
  <> {max-h: $(ceil (* →H →frac))}

;; Propagate my content-w/h as max-w/h of children if I am w/h: content.
((%not x-padding) {¦ w: max -max-w: w} ¦ _ w: content content-w: W_number) <> {w: →W}
((%not y-padding) {¦ h: max -max-h: h} ¦ _ h: content content-h: H_number) <> {h: →H}

;; For padding nodes, we need to subtract padding from content size
;; before converting it to child max-w/h.
(x-padding {¦ w: max -max-w: w} ¦ _ w: content content-w: W_number px_number)
  <> {w: $'(- →W →px)}
(y-padding {¦ h: max -max-h: h} ¦ _ h: content content-h: H_number py_number)
  <> {h: $'(- →H →py)}

;; Set final-w/h according to w/h.
{¦ w: content content-w_number -final-w_} <> {final-w: →content-w}
{¦ h: content content-h_number -final-h_} <> {final-h: →content-h}

{¦ w: max max-w_number -final-w_} <> {final-w: →max-w}
{¦ h: max max-h_number -final-h_} <> {final-h: →max-h}

;; A parent whose dl/dt is known, will define its child's dl/dt to be zero.
;;
;; Note how this does not cover elements such as x-stack and y-stack in
;; their multi-child variants. They manage dl/dt themselves (and this rule
;; works for single-child x-stack & y-stack).
((%not x-padding x-translate x-align) {¦ -dl_} ¦ _ dl: _number) <> {dl: 0}
((%not y-padding y-translate y-align) {¦ -dt_} ¦ _ dt: _number) <> {dt: 0}

;; Nodes without children have 0 content-w/h.
((%not text) ¦ _ -content-w_) <> {content-w: 0}
((%not text) ¦ _ -content-h_) <> {content-h: 0}

;; Rectangles will have content-w/h equal to their max-w/h if the latter
;; are specified manually.
(rect ¦ _ w: max max-w_number -content-w_) <> {content-w: →max-w}
(rect ¦ _ h: max max-h_number -content-h_) <> {content-h: →max-h}

;; If something has no children then it's x/y-ready when it knows its final-w/final-h
;; and its dl/dt.
(_ ¦ _ final-w: _number final-h: _number dl: _number dt: _number -ready_)
  <> {ready: true}

((%plural min: 2) ¦ _ dl: _number dt: _number final-w: _number final-h: _number -self-ready_)
  <> {self-ready: true}

((%not viewport) (%past {¦ ready: true} min: 1) ¦ _ self-ready: true -ready_)
  <> {ready: true}

;; NODE: text

(text ¦ _ -leading_) <> {leading: 1}

(text ¦ _ caption: _string font: _string weight: (%any 100 200 300 400 450 500 600 700 800 900) size: (%number u8) leading: _number -state_)
  <> {state: width-unknown}

(text ¦ _ caption_ font_ weight_ size_ leading_ state_: width-unknown -content-w_)
  <> {content-w: $(value (measure →caption →font →weight →size →leading) width),
      state: height-unknown}

(text ¦ _ w: content state_: height-unknown)
  <> {state: height-measurable}

;; Wrap caption at max-w if w: max once max-w is known, and transition
;; to measurable.
(text ¦ _ caption_ font_ weight_ size_ leading_ state_: height-unknown w: max max-w_number)
  <> {caption: $'(wrap →caption →font →weight →size →leading max-w: →max-w),
      state: height-measurable}

;; But if it's the same as content-w don't do anything! Our current text wrapping
;; algorithm is too stupid to be pixel perfect.
(text ¦ _ state_: height-unknown w: max content-w: w_ max-w: w_number)
  <> {state: height-measurable}

;; Compute content-h once in state: height-measurable.
(text ¦ _ caption_ font_ weight_ size_ leading_ state_: height-measurable -content-h_)
  <> {content-h: $(value (measure →caption →font →weight →size →leading) height),
      state: fully-measured}

;; NODE: x-padding

(x-padding _ ¦ _ -px_ pl⋮ 0 pr⋮ 0) <> {px: $'(+ →pl →pr)}
(x-padding {¦ content-w: w_number} ¦ _ -content-w: W px_number) <> {W: $'(+ →w →px)}
(x-padding {¦ -max-w: w} ¦ _ w: max max-w: W_number px_number) <> {w: $'(- →W →px)}
(x-padding {¦ -dl_} ¦ _ dl: _number pl⋮ 0) <> {dl: →pl}

;; NODE: y-padding

(y-padding _ ¦ _ -py_ pt⋮ 0 pb⋮ 0) <> {py: $'(+ →pt →pb)}
(y-padding {¦ content-h: h_number} ¦ _ -content-h: H py_number) <> {H: $'(+ →h →py)}
(y-padding {¦ -max-h: h} ¦ _ h: max max-h: H_number py_number) <> {h: $'(- →H →py)}
(y-padding {¦ -dt_} ¦ _ dt: _number pt⋮ 0) <> {dt: →pt}

;; NODE: x-translate

;; Support fractional offset (fraction of child's final width).
(x-translate {¦ -dl_ final-w: w_number} ¦ _ offset: (* frac←(%number -1 <= _ <= 1)) dl: _number final-w: W_number)
  <> {dl: $(ceil (* →W →frac))}

;; NODE: y-translate

(y-translate {¦ -dt_ final-h: h_number} ¦ _ offset: (* frac←(%number -1 <= _ <= 1)) dt: _number final-h: H_number)
  <> {dt: $(ceil (* →H →frac))}

;; NODE: x-align

(x-align {¦ -dl_ final-w: w_number} ¦ _ to: center dl: _number final-w: W_number)
  <> {dl: $(// (- →W →w) 2)}

(x-align {¦ -dl_ final-w: w_number} ¦ _ to: right dl: _number final-w: W_number)
  <> {dl: $(- →W →w)}

;; NODE: y-align

(y-align {¦ -dt_ final-h: h_number} ¦ _ to: center dt: _number final-h: H_number)
  <> {dt: $(// (- →H →h) 2)}

(y-align {¦ -dt_ final-h: h_number} ¦ _ to: bottom dt: _number final-h: H_number)
  <> {dt: $(- →H →h)}

;; NODE: floating
;;
;; Floating node is exempt from sizing. It reports its content-w/h as 0. In effect,
;; it's protecting ("coating") its child from inward sizing whereas outward sizing
;; is preserved.

(floating _ ¦ _ -content-w_ -content-h_) <> {content-w: 0, content-h: 0}

;; NODE: x-expand

;; If w: max then x-expand shouldn't be the one to define max-w, but rather, it
;; should be the passing-down rule (i.e. x-expand's child will inherit max-w from
;; w: max x-expand which in turn will inherit its max-w from its parent).
(x-expand {¦ content-w_number -max-w_} ¦ _ w: content min-w_number)
  <> {max-w: $'(max →content-w →min-w)}

;; If x-expand knows max-w but it's w: content then make use of max-w to have an
;; upper bound on the width of the child.
(x-expand {¦ content-w_number -max-w_} ¦ _ w: content min-w_number max-w: W_number)
  <> {max-w: $(min (max →content-w →min-w) →W)}

;; If w: content min-w: content, then we must wait for an upper bound on the child
;; and only use that.
(x-expand {¦ content-w_number -max-w_} ¦ _ w: content min-w: content max-w: W_number)
  <> {max-w: $'(min →content-w →W)}

;; Pick the limit that is smallest (shrinkable with bounded max-w).
(x-expand {¦ -max-w_} ¦ _ max-w: Wp_ max-w-bound: Wl_number)
  <> {max-w: $'(min →Wp →Wl)}

;; Compute content-w of x-expand based on the determined max-w of the child.
(x-expand {¦ max-w_number} ¦ _ -content-w: W) <> {W: →max-w}

;; NODE: y-expand

;; If h: max then y-expand shouldn't be the one to define max-h, but rather, it
;; should be the passing-down rule (i.e. y-expand's child will inherit max-h from
;; h: max y-expand which in turn will inherit its max-h from its parent).
(y-expand {¦ content-h_number -max-h_} ¦ _ h: content min-h_number)
  <> {max-h: $'(max →content-h →min-h)}

;; If y-expand knows max-h but it's h: content then make use of max-h to have an
;; upper bound on the height of the child.
(y-expand {¦ content-h_number -max-h_} ¦ _ h: content min-h_number max-h: H_number)
  <> {max-h: $(min (max →content-h →min-h) →H)}

;; If h: content min-h: content, then we must wait for an upper bound on the child
;; and only use that.
(y-expand {¦ content-h_number -max-h_} ¦ _ h: content min-h: content max-h: H_number)
  <> {max-h: $'(min →content-h →H)}

;; Pick the limit that is smallest (shrinkable with bounded max-h).
(y-expand {¦ -max-h_} ¦ _ max-h: Hp_ max-h-bound: Hl_number)
  <> {max-h: $'(min →Hp →Hl)}

;; Compute content-h of y-expand based on the determined max-h of the child.
(y-expand {¦ max-h_number} ¦ _ -content-h: H) <> {H: →max-h}

;; NODE: x-stack

;; Compute the content-w of x-stack.
;;
;; This applies to wrap: true as well.
(x-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ -content-w: W gap⋮ 0)
  <> {W: $(+ (sum (flatten →Cws)) (* →gap (- (tally →Cws) 1)))}

;; Compute max-sibling-h of x-stack.
(x-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ -max-sibling-h: H)
  <> {H: $(max (flatten →Chs))}

;; Set content-h of x-stack to its max-sibling-h.
;;
;; This **does not** apply to wrap: true because wrap: true computes its
;; content-h after wrapping (although it does make use of max-sibling-h).
(x-stack _* ¦ _ -wrap max-sibling-h: sh_ -content-h: h)
  <> {h: →sh}

;; If x-stack is set to h: content then setting h: max in a child would
;; mean that the child's max-h is content-h of the x-stack (i.e., maximum
;; sibling height).
;;
;; This will apply to wrap: true x-stack's because h: content is still there,
;; so we'll be able to grow as much as we need to make all elements have
;; equal height.
(%all (x-stack _+ ¦ _ h: content content-h: H_number) ⟨{¦ h: max -max-h: h}⟩°)
  <> {h: →H}

;; If x-stack is set to h: max then setting h: max in a child would
;; mean that the child's max-h is max-h of the x-stack.
;;
;; This **does not** apply to wrap: true x-stack's because they do not support
;; h: max; an x-stack that wants to grow but exceeds h: max is confused; instead,
;; the user should set h: content on the x-stack and wrap it in e.g. a viewport
;; (i.e. implement some sort of scrolling).
(%all (x-stack _+ ¦ _ -wrap h: max max-h: H_number) ⟨{¦ h: max -max-h: h}⟩°)
  <> {h: →H}

;; All children of x-stack with determinate dt have dt at 0.
;;
;; This **does not** apply to wrap: true x-stack's since we may wrap, thus
;; changing a child's dt.
(%all (x-stack _+ ¦ _ -wrap dt: _number) ⟨{¦ -dt_}⟩°)
  <> {dt: 0}

;; The first child of x-stack has dl equal to 0.
;;
;; This applies to wrap: true x-stack's as well.
[x-stack {¦ -dl_} _*] <> {dl: 0}

;; Any consecutive child learns its dl from the previous child plus
;; the previous child's final-w.
;;
;; This rule does not apply to wrap: true x-stack's because they're a bit
;; more nuanced than this.
;;
;; NOTE: we use the last child's left as a "flag" to signal that all children
;; had their lefts computed already and the rule engine should skip this rule.
;; This simplifies the job of the rule engine, making sure that it doesn't
;; have to go through all children every time before seeing that there is
;; no change, with regards to this particular rule.
(%all (x-stack _* {¦ -dl} ¦ _ -wrap gap⋮ 0) ⟨{¦ dl: dl0_number final-w: w0_number} {¦ -dl: dl1}⟩)
  <> {dl1: $'(+ →dl0 →w0 →gap)}

;; Sum content-w's of x-stack. Subtract from final-w of x-stack to get leftover-w.
;;
;; This rule obviously **does not** apply to wrap: true x-stack's since they
;; do not support fractions.
(%all (x-stack children_* ¦ _ -wrap fractions: true -leftover-w_ gap⋮ 0 final-w: W_number)
      (%items () {¦ w: content -final-w} min: 0)
      (%items Ws_ {¦ final-w: 0←_number} min: 0))
  <> {leftover-w: $(- →W (sum (flatten →Ws)) (* →gap (- (tally →children) 1)))}

;; Distribute leftover-w across w: max children.
;;
;; Ditto regarding wrap: true x-stack's.
(%all (x-stack _* ¦ _ -wrap fractions: true leftover-w: W_number fr/sum_number)
      ⟨{¦ w: max fr_: (%number (whole _) > 0) -max-w: w}⟩°)
  <> {w: $(// (* →W →fr) →fr/sum)}

;; If x-stack child has w: max but x-stack does not have fractions: true, we
;; force the child to become w: content. Otherwise we risk not drawing the child
;; at all, which is worse than drawing innaccurately.
;;
;; This rule **does not** apply to wrap: true x-stack's since it does not support
;; w: max children.
;;
;; NOTE: the whole thing with `fractions: true` is to save a bit of compute on
;; most x-stack's since most x-stack's do not use fractions, and we require some
;; rather expensive patterns to figure them out.
(%all (x-stack _* ¦ _ -wrap -fractions) ⟨{¦ w_: max -max-w}⟩°)
  <> {w: content}

;; NODE: x-stack wrap: true

;; The first child of wrap: true x-stack with determinate dt gets dt: 0.
(x-stack {¦ -dt_} _+ ¦ _ wrap: true dt: _number)
  <> {dt: 0}

;; Do the wrapping logic and save under delta: (dl dt dh) for the node
;; to unpack later on.
(%all (x-stack _* {¦ -delta} ¦ _ wrap: true gap⋮ 0 max-w: W_number max-sibling-h: H_number)
      ⟨{¦ dl: dl0_number dt: dt0_number final-w: w0_number}
       {¦ -delta_ final-w: w1_number final-h: h1_number}⟩)
  <> {delta:
        $(if (< (+ →dl0 →w0 →gap →w1) →W)      ;; < Do I fit?
           ((+ →dl0 →w0 →gap) →dt0 0)          ;; < If I do, what should my delta be?
           (0 (+ →dt0 →gap →H) (+ →gap →h1)))} ;; < If I don't, what should my delta be?

;; When the last child knows its delta, this means all children know their delta.
;; We can thus sum height-increments (part of delta) and  thus obtain content-h
;; of the x-stack.
;;
;; NOTE: we skip the first child since it doesn't have a delta attr.
(%all (x-stack _+ {¦ delta: _} ¦ _ -content-h: H max-sibling-h: sh_number)
      [x-stack _ (%many Dhs {¦ delta: (_ _ 0←_number)})])
  <> {H: $(+ →sh (sum (flatten →Dhs)))}

;; Unpack delta.
{¦ delta: (DL_number DT_number _) -dl_ -dt_}
  <> {dl: →DL, dt: →DT}

;; NODE: y-stack
;;
;; The same as x-stack minus the occasional W<->H or L<->T swap. This can
;; be generalized, but will lead to unreadable, overly generic mess -- I tried.

(y-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ -content-w: W)
  <> {W: $(max (flatten →Cws))}

(y-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ -content-h: H gap⋮ 0)
  <> {H: $(+ (sum (flatten →Chs)) (* →gap (- (tally →Chs) 1)))}

(%all (y-stack _+ ¦ _ w: content content-w: W_number) ⟨{¦ w: max -max-w: w}⟩°)
  <> {w: →W}

(%all (y-stack _+ ¦ _ w: max max-w: W_number) ⟨{¦ w: max -max-w: w}⟩°)
  <> {w: →W}

;; All children of y-stack with determinate dl have dl at 0.
(%all (y-stack _+ ¦ _ dl: _number) ⟨{¦ -dl_}⟩°) <> {dl: 0}

;; The first child of y-stack has dt of 0.
[y-stack {¦ -dt_} _*] <> {dt: 0}

;; Consecutive children learn their dt from their predecessor, plus
;; the predecessor's height and the gap (if any).
;;
;; Similarly, we use the last child's dt as an indication that this rule
;; was fully applied to the y-stack.
(%all (y-stack _* {¦ -dt} ¦ _ gap⋮ 0) ⟨{¦ dt: dt0_number final-h: h0_number} {¦ -dt: dt1}⟩)
  <> {dt1: $'(+ →dt0 →h0 →gap)}

(%all (y-stack children_* ¦ _ fractions: true -leftover-h_ gap⋮ 0 final-h: H_number)
      (%items () {¦ h: content -final-h} min: 0)
      (%items Hs_ {¦ final-h: 0←_number} min: 0))
  <> {leftover-h: $(- →H (sum (flatten →Hs)) (* →gap (- (tally →children) 1)))}

(%all (y-stack _* ¦ _ fractions: true leftover-h: H_number fr/sum_number)
      ⟨{¦ h: max fr_: (%number (whole _) > 0) -max-h: h}⟩°)
  <> {h: $(// (* →H →fr) →fr/sum)}

(%all (y-stack _* ¦ _ -fractions) ⟨{¦ h_: max -max-h}⟩°)
  <> {h: content}

;; Helper for both x-stack and y-stack.
(%all {¦ -fr/sum_ fractions: true} (%items Frs_ {¦ fr: 0←(%number (whole _) > 0)}))
  <> {fr/sum: $(sum (flatten →Frs))}

;; NODE: z-stack

(z-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ -content-w: W)
  <> {W: $(max (flatten →Cws))}
(z-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ -content-h: H)
  <> {H: $(max (flatten →Chs))}

;; If z-stack is set to w/h: content, this means the children receive z-stack's
;; content-w/h as max-w/h.
(%all (z-stack _+ ¦ _ w: content content-w: W_number) ⟨{¦ -max-w: w}⟩°) <> {w: →W}
(%all (z-stack _+ ¦ _ h: content content-h: H_number) ⟨{¦ -max-h: h}⟩°) <> {h: →H}

;; If z-stack is set to w/h: max, this means the children receive z-stack's
;; max-w/h as max-w/h.
(%all (z-stack _+ ¦ _ w: max max-w: W_number) ⟨{¦ -max-w: w}⟩°) <> {w: →W}
(%all (z-stack _+ ¦ _ h: max max-h: H_number) ⟨{¦ -max-h: h}⟩°) <> {h: →H}

;; z-stack with determinate dl/dt sets dt/dl of all of its children to zero.
(%all (z-stack _+ ¦ _ dl: _number) ⟨{¦ -dl_}⟩°) <> {dl: 0}
(%all (z-stack _+ ¦ _ dt: _number) ⟨{¦ -dt_}⟩°) <> {dt: 0}

;; uiR is a rule system that enriches UIR to become DwUIR -- *drawable* UIR.
;;
;; Islands of DwUIR may include islands of UIR, and vice versa.

;;
;; General rules
;;

;; +++ Parent learns its up-w/h from its only child.
((%all _symbol (%not x-expand)) ((%all _symbol (%not floating)) ¦ _ up-w: w_number) ¦ _ -up-w: W) <> {W: →w}
((%all _symbol (%not y-expand)) ((%all _symbol (%not floating)) ¦ _ up-h: h_number) ¦ _ -up-h: H) <> {H: →h}

;; +++ Parent gives its only child its dn-w/h.
(_symbol {¦ -dn-w: w} ¦ _ w: max dn-w: W_number) <> {w: →W}
(_symbol {¦ -dn-h: h} ¦ _ h: max dn-h: H_number) <> {h: →H}

;; Ditto for fractional dn-w/h.
(_symbol {¦ dn-w_: (* frac←(%number 0 <= _ <= 1))} ¦ _ w: max dn-w: W_number)
  <> {dn-w: $(ceil (* →W →frac))}
(_symbol {¦ dn-h_: (* frac←(%number 0 <= _ <= 1))} ¦ _ h: max dn-h: H_number)
  <> {dn-h: $(ceil (* →H →frac))}

;; If the only child is w/h: max but its parent is w/h: content,
;; the parent passes its up-w/h down as dn-w/h.
((%not x-padding) {¦ w: max -dn-w: w} ¦ _ w: content up-w: W_number) <> {w: →W}
((%not y-padding) {¦ h: max -dn-h: h} ¦ _ h: content up-h: H_number) <> {h: →H}

;; Ditto for padding nodes, but we need to subtract padding from up-w/h
;; before passing to the child as dn-w/h.
(x-padding {¦ w: max -dn-w: w} ¦ _ w: content up-w: W_number px_number)
  <> {w: $'(- →W →px)}
(y-padding {¦ h: max -dn-h: h} ¦ _ h: content up-h: H_number py_number)
  <> {h: $'(- →H →py)}

;; +++ Set final-w/h according to w/h.
{¦ w: content up-w_number -final-w_} <> {final-w: →up-w}
{¦ h: content up-h_number -final-h_} <> {final-h: →up-h}
{¦ w: max dn-w_number -final-w_} <> {final-w: →dn-w}
{¦ h: max dn-h_number -final-h_} <> {final-h: →dn-h}

;; Leaves other than text are supposedly sized using dn-w/h. This poses
;; a problem: bottom-up up-w/h flow is disturbed. In other words,
;; not all leaves know their up-w/h, and thus not all parents, and
;; so on.
;;
;; To fix this in the majority of cases, for non-text leaves we force their
;; up-w/h to be dn-w/h if they are w/h: max. Otherwise we give up
;; and let the other rules handle the consequences.
((%all _symbol (%not text)) ¦ _ w: max dn-w_number -up-w_) <> {up-w: →dn-w}
((%all _symbol (%not text)) ¦ _ h: max dn-h_number -up-h_) <> {up-h: →dn-h}

;;
;; Text
;;
;; These rules enrich `soma.dwuir.node.text` with size info.
;;

(text ¦ _ -up-w -dw-request_) <> {dw-request: (size to: content-size)}
(text ¦ _ -up-w_ content-size: (w_number _)) <> {up-w: →w}
(text ¦ _ w: content -up-h_ content-size: (_ h_number)) <> {up-h: →h}
(text ¦ _ w: max dn-w_number -up-h -dw-request_)
  <> {dw-request: (height-at →dn-w to: up-h)}

;;
;; Padding
;;
;; The `x-padding` and `y-padding` nodes manage padding for their child.
;;

(x-padding _ ¦ _ -px_ pl⋮ 0 pr⋮ 0) <> {px: $'(+ →pl →pr)}
(y-padding _ ¦ _ -py_ pt⋮ 0 pb⋮ 0) <> {py: $'(+ →pt →pb)}

(x-padding {¦ up-w: w_number} ¦ _ -up-w: W px_number) <> {W: $'(+ →w →px)}
(y-padding {¦ up-h: h_number} ¦ _ -up-h: H py_number) <> {H: $'(+ →h →py)}

(x-padding {¦ -dn-w: w} ¦ _ w: max dn-w: W_number px_number) <> {w: $'(- →W →px)}
(y-padding {¦ -dn-h: h} ¦ _ h: max dn-h: H_number py_number) <> {h: $'(- →H →py)}

(x-padding {¦ -dl_} ¦ _ pl⋮ 0) <> {dl: →pl}
(y-padding {¦ -dt_} ¦ _ pt⋮ 0) <> {dt: →pt}

;;
;; Alignment
;;
;; The `x-align` and `y-align` nodes manage alignment for their child.
;;

(x-align {¦ -dl_ final-w: w_number} ¦ _ point: pt←(%number 0 <= _ <= 1) final-w: W_number)
  <> {dl: $(- (* →W →pt) (* →w →pt))}

(y-align {¦ -dt_ final-h: h_number} ¦ _ point: pt←(%number 0 <= _ <= 1) final-h: H_number)
  <> {dt: $(- (* →H →pt) (* →h →pt))}

;;
;; Size control flow
;;
;; The x/y-expand and x/y-shrink nodes control the flow of size information
;; from/to their child. Children propose sizes via the upward flow of sizes;
;; and its control flow parents respond via downward flow of sizes.

(x-expand {¦ up-w_number -dn-w: w} ¦ _ w: content min-w_number)
  <> {w: $'(max →min-w →up-w)}

(y-expand {¦ up-h_number -dn-h: h} ¦ _ h: content min-h_number)
  <> {h: $'(max →min-h →up-h)}

(x-expand {¦ up-w_number -dn-w: w} ¦ _ w: max dn-w_number min-w_number)
  <> {w: $(min (max →min-w →up-w) →dn-w)}

(y-expand {¦ up-h_number -dn-h: h} ¦ _ h: max dn-h_number min-h_number)
  <> {h: $(min (max →min-h →up-h) →dn-h)}

(x-shrink {¦ up-w_number -dn-w: w} ¦ _ w: content max-w_number)
  <> {w: $'(min →up-w →max-w)}

(y-shrink {¦ up-h_number -dn-h: h} ¦ _ h: content max-h_number)
  <> {h: $'(min →up-h →max-h)}

(x-shrink {¦ up-w_number -dn-w: w} ¦ _ w: max dn-w_number max-w_number)
  <> {w: $'(min →up-w →dn-w →max-w)}

(y-shrink {¦ up-h_number -dn-h: h} ¦ _ h: max dn-h_number max-h_number)
  <> {h: $'(min →up-h →dn-h →max-h)}

;; All of them propagate the width/height that they themselves determined
;; as up-w/h.

(x-expand {¦ dn-w_number} ¦ _ -up-w: W) <> {W: →dn-w}
(y-expand {¦ dn-h_number} ¦ _ -up-h: H) <> {H: →dn-h}

(x-shrink {¦ dn-w_number} ¦ _ -up-w: W) <> {W: →dn-w}
(y-shrink {¦ dn-h_number} ¦ _ -up-h: H) <> {H: →dn-h}

;;
;; Routing of messages between siblings.
;;

;; Bridge the gap between adjacent nodes.
⟨{¦ out: (Mout_ _*)} {¦ in: (_* `Min)}⟩ <> {Min: →Mout, (Mout): ()}

;; Wrap messages around.
[_symbol {¦ in: (_* `Min)} _* {¦ out: (Mout_ _*)}]
  <> {Min: →Mout, (Mout): ()}

;; Pass message to the mid.
{¦ siblings: (%number +i16) in: (Min←{¦ seen: N←(%number +i16)} _*) mid: (_* `Mout)}
  <> {(Min): (), Mout: ↑Min, N: $'(+ →N 1)}

;; Burning of messages.
{¦ in: (M_ _*)} <> {(M): ()}
{¦ in: (M←{¦ seen: N_} _*) siblings: N←(%number +i16)} <> {(M): ()}

;; Relay message from mid to out. Nodes override this to handle messages.
{¦ mid: (Min_ _*)} <> {Min: (relay →Min)}
{¦ mid: (Min←(relay Msubj_) _*), out: (_* `Mout)} <> {(Min): (), Mout: →Msubj}

(%all [H←(%any x-stack y-stack z-stack) children_+] ⟨{¦ -siblings_ -in_ -mid_ -out_ -unity_}⟩°)
  <> {siblings: $'(tally →children), in: (), mid: (), out: (), unity: →H}

;; The first x-stack member gets determinate dl: 0 if it doesn't know its
;; dl already.
[x-stack {¦ -dl_} _*] <> {dl: 0}

;; When an x-stack member learns its final-h, it publishes it to the ring.
{¦ unity: x-stack, final-h_number, out: (_* `M), -public-h_}
  <> {M: (sibling-height →final-h seen: 0), public-h: true}

;; When an x-stack member receives sibling height (or self height), it
;; updates its max-sibling-h.
{¦ unity: x-stack, max-sibling-h⋮ 0, mid: (M←[sibling-height H_number] _*)}
  <> {M: (relay →M), max-sibling-h: $'(max →max-sibling-h →H)}

;; ;; NODE: x-stack
;;
;; ;; Compute the content-w of x-stack.
;; ;;
;; ;; This applies to wrap: true as well.
;; (x-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ -content-w: W gap⋮ 0)
;;   <> {W: $(+ (sum (flatten →Cws)) (* →gap (- (tally →Cws) 1)))}
;;
;; ;; Compute max-sibling-h of x-stack.
;; (x-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ -max-sibling-h: H)
;;   <> {H: $(max (flatten →Chs))}
;;
;; ;; Set content-h of x-stack to its max-sibling-h.
;; ;;
;; ;; This **does not** apply to wrap: true because wrap: true computes its
;; ;; content-h after wrapping (although it does make use of max-sibling-h).
;; (x-stack _* ¦ _ -wrap max-sibling-h: sh_ -content-h: h)
;;   <> {h: →sh}
;;
;; ;; If x-stack is set to h: content then setting h: max in a child would
;; ;; mean that the child's max-h is content-h of the x-stack (i.e., maximum
;; ;; sibling height).
;; ;;
;; ;; This will apply to wrap: true x-stack's because h: content is still there,
;; ;; so we'll be able to grow as much as we need to make all elements have
;; ;; equal height.
;; (%all (x-stack _+ ¦ _ h: content content-h: H_number) ⟨{¦ h: max -max-h: h}⟩°)
;;   <> {h: →H}
;;
;; ;; If x-stack is set to h: max then setting h: max in a child would
;; ;; mean that the child's max-h is max-h of the x-stack.
;; ;;
;; ;; This **does not** apply to wrap: true x-stack's because they do not support
;; ;; h: max; an x-stack that wants to grow but exceeds h: max is confused; instead,
;; ;; the user should set h: content on the x-stack and wrap it in e.g. a viewport
;; ;; (i.e. implement some sort of scrolling).
;; (%all (x-stack _+ ¦ _ -wrap h: max max-h: H_number) ⟨{¦ h: max -max-h: h}⟩°)
;;   <> {h: →H}
;;
;; ;; All children of x-stack with determinate dt have dt at 0.
;; ;;
;; ;; This **does not** apply to wrap: true x-stack's since we may wrap, thus
;; ;; changing a child's dt.
;; (%all (x-stack _+ ¦ _ -wrap dt: _number) ⟨{¦ -dt_}⟩°)
;;   <> {dt: 0}
;;
;; ;; The first child of x-stack has dl equal to 0.
;; ;;
;; ;; This applies to wrap: true x-stack's as well.
;; [x-stack {¦ -dl_} _*] <> {dl: 0}
;;
;; ;; Any consecutive child learns its dl from the previous child plus
;; ;; the previous child's final-w.
;; ;;
;; ;; This rule does not apply to wrap: true x-stack's because they're a bit
;; ;; more nuanced than this.
;; ;;
;; ;; NOTE: we use the last child's left as a "flag" to signal that all children
;; ;; had their lefts computed already and the rule engine should skip this rule.
;; ;; This simplifies the job of the rule engine, making sure that it doesn't
;; ;; have to go through all children every time before seeing that there is
;; ;; no change, with regards to this particular rule.
;; (%all (x-stack _* {¦ -dl} ¦ _ -wrap gap⋮ 0) ⟨{¦ dl: dl0_number final-w: w0_number} {¦ -dl: dl1}⟩)
;;   <> {dl1: $'(+ →dl0 →w0 →gap)}
;;
;; ;; Sum content-w's of x-stack. Subtract from final-w of x-stack to get leftover-w.
;; ;;
;; ;; This rule obviously **does not** apply to wrap: true x-stack's since they
;; ;; do not support fractions.
;; (%all (x-stack children_* ¦ _ -wrap fractions: true -leftover-w_ gap⋮ 0 final-w: W_number)
;;       (%items () {¦ w: content -final-w} min: 0)
;;       (%items Ws_ {¦ final-w: 0←_number} min: 0))
;;   <> {leftover-w: $(- →W (sum (flatten →Ws)) (* →gap (- (tally →children) 1)))}
;;
;; ;; Distribute leftover-w across w: max children.
;; ;;
;; ;; Ditto regarding wrap: true x-stack's.
;; (%all (x-stack _* ¦ _ -wrap fractions: true leftover-w: W_number fr/sum_number)
;;       ⟨{¦ w: max fr_: (%number (whole _) > 0) -max-w: w}⟩°)
;;   <> {w: $(// (* →W →fr) →fr/sum)}
;;
;; ;; If x-stack child has w: max but x-stack does not have fractions: true, we
;; ;; force the child to become w: content. Otherwise we risk not drawing the child
;; ;; at all, which is worse than drawing innaccurately.
;; ;;
;; ;; This rule **does not** apply to wrap: true x-stack's since it does not support
;; ;; w: max children.
;; ;;
;; ;; NOTE: the whole thing with `fractions: true` is to save a bit of compute on
;; ;; most x-stack's since most x-stack's do not use fractions, and we require some
;; ;; rather expensive patterns to figure them out.
;; (%all (x-stack _* ¦ _ -wrap -fractions) ⟨{¦ w_: max -max-w}⟩°)
;;   <> {w: content}
;;
;; ;; NODE: x-stack wrap: true
;;
;; ;; The first child of wrap: true x-stack with determinate dt gets dt: 0.
;; (x-stack {¦ -dt_} _+ ¦ _ wrap: true dt: _number)
;;   <> {dt: 0}
;;
;; ;; Do the wrapping logic and save under delta: (dl dt dh) for the node
;; ;; to unpack later on.
;; (%all (x-stack _* {¦ -delta} ¦ _ wrap: true gap⋮ 0 max-w: W_number max-sibling-h: H_number)
;;       ⟨{¦ dl: dl0_number dt: dt0_number final-w: w0_number}
;;        {¦ -delta_ final-w: w1_number final-h: h1_number}⟩)
;;   <> {delta:
;;         $(if (< (+ →dl0 →w0 →gap →w1) →W)      ;; < Do I fit?
;;            ((+ →dl0 →w0 →gap) →dt0 0)          ;; < If I do, what should my delta be?
;;            (0 (+ →dt0 →gap →H) (+ →gap →h1)))} ;; < If I don't, what should my delta be?
;;
;; ;; When the last child knows its delta, this means all children know their delta.
;; ;; We can thus sum height-increments (part of delta) and  thus obtain content-h
;; ;; of the x-stack.
;; ;;
;; ;; NOTE: we skip the first child since it doesn't have a delta attr.
;; (%all (x-stack _+ {¦ delta: _} ¦ _ -content-h: H max-sibling-h: sh_number)
;;       [x-stack _ (%many Dhs {¦ delta: (_ _ 0←_number)})])
;;   <> {H: $(+ →sh (sum (flatten →Dhs)))}
;;
;; ;; Unpack delta.
;; {¦ delta: (DL_number DT_number _) -dl_ -dt_}
;;   <> {dl: →DL, dt: →DT}
;;
;; ;; NODE: y-stack
;; ;;
;; ;; The same as x-stack minus the occasional W<->H or L<->T swap. This can
;; ;; be generalized, but will lead to unreadable, overly generic mess -- I tried.
;;
;; (y-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ -content-w: W)
;;   <> {W: $(max (flatten →Cws))}
;;
;; (y-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ -content-h: H gap⋮ 0)
;;   <> {H: $(+ (sum (flatten →Chs)) (* →gap (- (tally →Chs) 1)))}
;;
;; (%all (y-stack _+ ¦ _ w: content content-w: W_number) ⟨{¦ w: max -max-w: w}⟩°)
;;   <> {w: →W}
;;
;; (%all (y-stack _+ ¦ _ w: max max-w: W_number) ⟨{¦ w: max -max-w: w}⟩°)
;;   <> {w: →W}
;;
;; ;; All children of y-stack with determinate dl have dl at 0.
;; (%all (y-stack _+ ¦ _ dl: _number) ⟨{¦ -dl_}⟩°) <> {dl: 0}
;;
;; ;; The first child of y-stack has dt of 0.
;; [y-stack {¦ -dt_} _*] <> {dt: 0}
;;
;; ;; Consecutive children learn their dt from their predecessor, plus
;; ;; the predecessor's height and the gap (if any).
;; ;;
;; ;; Similarly, we use the last child's dt as an indication that this rule
;; ;; was fully applied to the y-stack.
;; (%all (y-stack _* {¦ -dt} ¦ _ gap⋮ 0) ⟨{¦ dt: dt0_number final-h: h0_number} {¦ -dt: dt1}⟩)
;;   <> {dt1: $'(+ →dt0 →h0 →gap)}
;;
;; (%all (y-stack children_* ¦ _ fractions: true -leftover-h_ gap⋮ 0 final-h: H_number)
;;       (%items () {¦ h: content -final-h} min: 0)
;;       (%items Hs_ {¦ final-h: 0←_number} min: 0))
;;   <> {leftover-h: $(- →H (sum (flatten →Hs)) (* →gap (- (tally →children) 1)))}
;;
;; (%all (y-stack _* ¦ _ fractions: true leftover-h: H_number fr/sum_number)
;;       ⟨{¦ h: max fr_: (%number (whole _) > 0) -max-h: h}⟩°)
;;   <> {h: $(// (* →H →fr) →fr/sum)}
;;
;; (%all (y-stack _* ¦ _ -fractions) ⟨{¦ h_: max -max-h}⟩°)
;;   <> {h: content}
;;
;; ;; Helper for both x-stack and y-stack.
;; (%all {¦ -fr/sum_ fractions: true} (%items Frs_ {¦ fr: 0←(%number (whole _) > 0)}))
;;   <> {fr/sum: $(sum (flatten →Frs))}
;;
;; ;; NODE: z-stack
;;
;; (z-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ -content-w: W)
;;   <> {W: $(max (flatten →Cws))}
;; (z-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ -content-h: H)
;;   <> {H: $(max (flatten →Chs))}
;;
;; ;; If z-stack is set to w/h: content, this means the children receive z-stack's
;; ;; content-w/h as max-w/h.
;; (%all (z-stack _+ ¦ _ w: content content-w: W_number) ⟨{¦ -max-w: w}⟩°) <> {w: →W}
;; (%all (z-stack _+ ¦ _ h: content content-h: H_number) ⟨{¦ -max-h: h}⟩°) <> {h: →H}
;;
;; ;; If z-stack is set to w/h: max, this means the children receive z-stack's
;; ;; max-w/h as max-w/h.
;; (%all (z-stack _+ ¦ _ w: max max-w: W_number) ⟨{¦ -max-w: w}⟩°) <> {w: →W}
;; (%all (z-stack _+ ¦ _ h: max max-h: H_number) ⟨{¦ -max-h: h}⟩°) <> {h: →H}
;;
;; ;; z-stack with determinate dl/dt sets dt/dl of all of its children to zero.
;; (%all (z-stack _+ ¦ _ dl: _number) ⟨{¦ -dl_}⟩°) <> {dl: 0}
;; (%all (z-stack _+ ¦ _ dt: _number) ⟨{¦ -dt_}⟩°) <> {dt: 0}

;; TODO: rule fractions / exclusive groups -- How to make sure
;; that rules oppose each other? In other words, how to make sure
;; the given node is NOT matched by rule A if it is matched by
;; rule B already? Aka only one of the rules in group G must match.
;; Even if it does not change the term in any way.

;;
;; Message passing
;;
;; W - wrapper, M - message, T - target
;;

;; *Mark* messages instead of wrapping.

;; (up (qux 1 2 3))
;;
;; (qux 1 2 3 up: true)
;; (qux 1 2 3 up: true left: true down: true)
;; Once we've done we have to unmark but in a way that doesn't activate
;; the marker.
;; -up (state 1) -> up: true (state 2) -> up: false (state 3)

;; Burn messages that cannot be moved.
{¦ in: (W←(up _) _*)} <> {(W): ()}
{¦ in: (W←(down _) _*)} <> {(W): ()}
{¦ in: (W←(left _) _*)} <> {(W): ()}
{¦ in: (W←(right _) _*)} <> {(W): ()}

;; Move messages left, right, up, down.
(_symbol {¦ in: (_* `T)} ¦ _ in: (W←(down M_) _*)) <> {(W): (), T: (from-above →M)}
(_symbol {¦ in: (W←(up M_) _*)} ¦ _ in: (_* `T)) <> {(W): (), T: (from-below →M)}
⟨{¦ in: (_* `T)} {¦ in: (W←(left M_) _*)}⟩ <> {(W): (), T: (from-right →M)}
⟨{¦ in: (W←(right M_) _*)} {¦ in: (_* `T)}⟩ <> {(W): (), T: (from-left →M)}

;;
;; General rules
;;

;; Unwrap from-above/below/left/right by default. This will be overridden
;; by more specific rules that need to know the direction of input
;; for messages.
{¦ in: (W←(from-above M_) _*)} <> {W: (self →M)}
{¦ in: (W←(from-below M_) _*)} <> {W: (self →M)}
{¦ in: (W←(from-left M_) _*)} <> {W: (self →M)}
{¦ in: (W←(from-right M_) _*)} <> {W: (self →M)}

;; Burn final-w/h messages from children by default. This will be overridden
;; by more specific rules that need to know the final-w/h.
{¦ in: (W←(from-below (final-w _)) _*)} <> {(W): ()}
{¦ in: (W←(from-below (final-h _)) _*)} <> {(W): ()}

;; For w/h: max nodes, pass dn-w/h messages down to children, and simultaneously
;; report final-w/h up.
{¦ w: max in: (W←(self M←(dn-w w_number)) _*)}
  <> {(W): ((down →M) (self (final-w →w)))}
{¦ h: max in: (W←(self M←(dn-h h_number)) _*)}
  <> {(W): ((down →M) (self (final-h →h)))}

;; Nodes relay up-w/h to their parents.
{¦ in: ((from-below M←(up-w _)) _* `T)} <> {T: (up →M)}
{¦ in: ((from-below M←(up-h _)) _* `T)} <> {T: (up →M)}

;; w/h: max nodes use that as their width/height.
{¦ in: (W←(self ))}

;; For w/h: content nodes, pass up-w/h messages to parent, and
;; assert final-w/h.
{¦ w: content in: (M←[up-w w_number] _*)} <> {(M): ((up →M) (final-w →w))}
{¦ h: content in: (M←[up-h h_number] _*)} <> {(M): ((up →M) (final-h →h))}

;; w/h: content nodes burn dn-w/h messages.
{¦ w: content in: (W←(self (dn-w _)) _*)} <> {(W): ()}
{¦ h: content in: (W←(self (dn-h _)) _*)} <> {(W): ()}

;; w/h: content nodes with w/h: max children reflect up-w/h from children
;; back as dn-w/h.
(_symbol {¦ w: max} ¦ _ w: content in: (W←(from-below M←(up-w w_number)) _*))
  <> {(W): (down (dn-w →w))}
(_symbol {¦ h: max} ¦ _ h: content in: (W←(from-below M←(up-h h_number)) _*))
  <> {(W): ((down (dn-h →h)) (self →M))}

;; Cache asserted final-w/h on the node.
{¦ final-w: (%- _ final-w) in: ((final-w w_number ¦ _ -cached_) _*)}
  <> {final-w: →w, cached: true}
{¦ final-h: (%- _ final-h) in: ((final-h h_number ¦ _ -cached_) _*)}
  <> {final-h: →h, cached: true}

;; Pass asserted final-w/h to parent.
{¦ in: (M←[final-w _] _*)} <> {M: (up →M)}
{¦ in: (M←[final-h _] _*)} <> {M: (up →M)}

;; Cache asserted nonzero dl/dt on the node.
{¦ dl: (%- _ dl) in: (M←(dl (%all (%not 0) dl1_number) ¦ _ -cached_) _*)}
  <> {dl: →dl1, cached: true}
{¦ dt: (%- _ dt) in: (M←(dt (%all (%not 0) dt1_number) ¦ _ -cached_) _*)}
  <> {dt: →dt1, cached: true}

;; Burn dl/dt messages by default.
{¦ in: (M←[dl _] _*)} <> {(M): ()}
{¦ in: (M←[dt _] _*)} <> {(M): ()}

;;
;; Padding
;;
;; Padding nodes alter upward-flowing up-w/h messages and downward flowing
;; dn-w/h messages with padding.
;;

;; Hold messages while we're initializing.
(padding _ ¦ _ -px in: {¦ -wait_}) <> {wait: true}
(padding _ ¦ _ -py in: {¦ -wait_}) <> {wait: true}

;; Initialize.
(padding _ ¦ _ -px_ pl⋮ 0 pr⋮ 0) <> {px: $'(+ →pl →pr)}
(padding _ ¦ _ -py_ pt⋮ 0 pb⋮ 0) <> {py: $'(+ →pt →pb)}
(padding _ ¦ _ px: _ py: _ in: {¦ wait_: true}) <> {(wait): ()}

;; Alter.
(padding _ ¦ _ px_number in: ((up (up-w w_number ¦ _ -padded_)) _*))
  <> {w: $'(+ →w →px), padded: true}
(padding _ ¦ _ px_number in: ((down (dn-w w_number ¦ _ -padded_)) _*))
  <> {w: $'(- →w →px), padded: true}
(padding _ ¦ _ py_number in: ((up (up-h h_number ¦ _ -padded_)) _*))
  <> {h: $'(+ →h →py), padded: true}
(padding _ ¦ _ py_number in: ((down (dn-h h_number ¦ _ -padded_)) _*))
  <> {h: $'(- →h →py), padded: true}

;;
;; Alignment
;;

(x-align _ ¦ _ origin_: (%number 0 <= _ <= 1) a: (%- _ a) in: (M←(final-w w_number ¦ _ -aligned_) _*))
  <> {(M): ((realign) ↑M), aligned: true, a: $(* →w →origin)}

(y-align _ ¦ _ origin_: (%number 0 <= _ <= 1) a: (%- _ a) in: (M←(final-h h_number ¦ _ -aligned_) _*))
  <> {(M): ((realign) ↑M), aligned: true, a: $(* →h →origin)}

(x-align _ ¦ _ origin_: (%number 0 <= _ <= 1) b: (%- _ b) in: (M←(from-below (final-w w_number)) _*))
  <> {M: (realign), b: $(* →w →origin)}

(y-align _ ¦ _ origin_: (%number 0 <= _ <= 1) b: (%- _ b) in: (M←(from-below (final-h h_number)) _*))
  <> {M: (realign), b: $(* →h →origin)}

(x-align _ ¦ _ a_number b_number in: (M←(realign) _*)) <> {M: (down (dl $'(- →a →b)))}
(y-align _ ¦ _ a_number b_number in: (M←(realign) _*)) <> {M: (down (dt $'(- →a →b)))}

;; Consume realign that cannot succeed.
(x-align _ ¦ _ in: (M←(realign) _*)) <> {(M): ()}
(y-align _ ¦ _ in: (M←(realign) _*)) <> {(M): ()}

;;
;; Size control
;;

;; (x-expand {¦ up-w_number -dn-w: w} ¦ _ w: max dn-w_number min-w_number)
;;   <> {w: $(min (max →min-w →up-w) →dn-w)}
;;
;; (y-expand {¦ up-h_number -dn-h: h} ¦ _ h: max dn-h_number min-h_number)
;;   <> {h: $(min (max →min-h →up-h) →dn-h)}
;;
;; (x-shrink {¦ up-w_number -dn-w: w} ¦ _ w: content max-w_number)
;;   <> {w: $'(min →up-w →max-w)}
;;
;; (y-shrink {¦ up-h_number -dn-h: h} ¦ _ h: content max-h_number)
;;   <> {h: $'(min →up-h →max-h)}
;;
;; (x-shrink {¦ up-w_number -dn-w: w} ¦ _ w: max dn-w_number max-w_number)
;;   <> {w: $'(min →up-w →dn-w →max-w)}
;;
;; (y-shrink {¦ up-h_number -dn-h: h} ¦ _ h: max dn-h_number max-h_number)
;;   <> {h: $'(min →up-h →dn-h →max-h)}

;;
;; Text
;;

(text ¦ _ -content-size in: {¦ -wait_}) <> {wait: true}
(text ¦ _ -content-size -dw-request_) <> {dw-request: (size to: content-size)}
(text ¦ _ content-size: _ in: {¦ wait_}) <> {(wait): ()}

(text ¦ _ -public-w_ content-size: (w_number _) in: (_* `T))
  <> {T: (up-w →w), public-w: true}
(text ¦ _ -public-h_ content-size: (_ h_number) in: (_* `T) w: content)
  <> {T: (up-h →h), public-h: true}

(text ¦ _ content-size: _ -dw-request_ in: (M←(down [dn-w w_number]) _* ¦ _ -wait_) w: max)
  <> {(M): (), dw-request: (height-at →w to: wrapped-h), wait: true}

(text ¦ _ wrapped-h_number in: (_* `T ¦ _ wait_: true))
  <> {(wait): (), (wrapped-h): (), T: (up-h →wrapped-h)}


;;
;; Message passing
;;

;; Move messages down the tree.
(_symbol {¦ in: (_* `T)} ¦ _ in: ({ down_: true} _*))
  <> {T: (from-above →M), down: false}

;; Move messages up the tree.
(_symbol {¦ in: ({ up_: true} _*)} ¦ _ in: (_* `T))
  <> {T: (from-below →M), up: false}

;; Move messages to the left sibling.
⟨{¦ in: (_* `T)} {¦ in: ({¦ left_: true} _*)}⟩
  <> {T: (from-right →M), left: false}

;; Move messages to the right sibling.
⟨{¦ in: ({¦ right_: true} _*)} {¦ in: (_* `T)}⟩
  <> {T: (from-left →M), left: false}

;; Unmark messages that cannot be moved.
{¦ in: ({¦ up_: true} _*)} <> {up: false}
{¦ in: ({¦ down_: true} _*)} <> {down: false}
{¦ in: ({¦ left_: true} _*)} <> {left: false}
{¦ in: ({¦ right_: true} _*)} <> {right: false}

;;
;; General rules
;;

;; up-w/h's flow from the child to the parent.
(_symbol {¦ up-w: w_number} ¦ _ -up-w: W) <> {W: →w, (w): ()}
(_symbol {¦ up-h: h_number} ¦ _ -up-h: H) <> {H: →h, (h): ()}

;; dn-w/h's flow from the parent to the child.
(_symbol {¦ -dn-w: w} ¦ _ dn-w: W_number) <> {w: →W, (W): ()}
(_symbol {¦ -dn-h: h} ¦ _ dn-h: H_number) <> {h: →H, (H): ()}

;; Positioning trigger flows from the parent to the child.
(_symbol {¦ -position_} ¦ _ position: _) <> {position: true}

⟨{¦ -l: dst} {¦ l: src←[M_*]}⟩ <> {dst: →M, (src): ()}
⟨{¦ r: src←[M_*]} {¦ -r: dst}⟩ <> {dst: →M, (src): ()}

{¦ -up-w/old: w0 up-w/new: w1←w_ -up-w: w0} <> {w0: →w1, (w1): ()}
{¦ -up-h/old: h0 up-h/new: h1←h_ -up-h: h0} <> {h0: →h1, (h1): ()}

{¦ up-w/old: w_ up-w/new: w1←w_} <> {(w1): ()}
{¦ up-h/old: h_ up-h/new: h1←h_} <> {(h1): ()}

{¦ up-w/old: w0_ up-w/new: w1_ -up-w: w0} <> {w0: →w1, (w1): ()}
{¦ up-h/old: h0_ up-h/new: h1_ -up-h: h0} <> {h0: →h1, (h1): ()}

;;
;; root
;;

;; There is no one to take up-w/h from root, so burn them.
{¦ root: _ up-w: w_number} <> {(w): ()}
{¦ root: _ up-h: h_number} <> {(h): ()}

;; When root nodes receive control unrelated to up-w/h, treat that as
;; request for phase change; switch to the `position` phase.
;;
;; NOTE: we separate sizing and positioning into two distinct phases to avoid
;; needless position recomputation in case of constraint refinement. In other
;; words, once definite sizes are determined, position once -- instead of
;; positioning on every size change.
{¦ root: _ -up-w -up-h -position_} <> {position: true}

;;
;; content
;;

(content {¦ up-w: w_number -dn-w: W} ¦ _ -up-w: W) <> {W: →w, (w): ()}
(content {¦ up-h: h_number -dn-h: H} ¦ _ -up-h: H) <> {H: →h, (h): ()}

(content _ ¦ _ dn-w: W_number) <> {(W): ()}
(content _ ¦ _ dn-h: H_number) <> {(H): ()}

;;
;; text
;;

;; Make a request to DwUIR to get the content size of the text without
;; any constraints.
(text ¦ _ -intrinsic-status -dw-request_)
  <> {dw-request: (measure intrinsic-w intrinsic-h status: intrinsic-status)}

;; Propagate width from DwUIR's intrinsic-size as up-w unconditionally.
(text ¦ _ -up-w_ intrinsic-w: w_number)
  <> {up-w: →w, (w): ()}

;; Ask DwUIR to define up-h for us once dn-w is known. Now that we know
;; dn-w, we can define final-w of the text (a property required by DwUIR).
(text ¦ _ dn-w: w_number final-w: (%- (%never) final-w) -up-h -dw-request_)
  <> {dw-request: (measure →w up-h status: intrinsic-status), final-w: →w, (w): ()}

;; Similarly, define final-h based on dn-h once it is know. final-h is also
;; a property required by DwUIR to draw text.
(text ¦ _ dn-h: h_number final-h: (%- (%never) final-h))
  <> {final-h: →h, (h): ()}

;;
;; rect, svg
;;

((%any rect svg) ¦ _ dn-w: W_number final-w: (%- (%never) final-w)) <> {final-w: →W, (W): ()}
((%any rect svg) ¦ _ dn-h: H_number final-h: (%- (%never) final-h)) <> {final-h: →H, (H): ()}

;; For rectangles with image fill, we will attempt to query the intrinsic
;; size of the image and use that as our up-w/h proposal.
(rect ¦ _ fill: [image _] -intrinsic-status -dw-request_)
  <> {dw-request: (measure intrinsic-w intrinsic-h status: intrinsic-status)}

;; Ask DwUIR about the svg's size. If possible, DwUIR will reply through rewriting
;; with the SVG's intrinsic size, which we'll use as the proposal up-w/h.
(svg ¦ _ -intrinsic-status -dw-request_)
  <> {dw-request: (measure intrinsic-w intrinsic-h status: intrinsic-status)}

;; NOTE: DwUIR may very well return ugly floating point numbers for size; so we
;; use ceil to remove that.
((%any svg rect) ¦ _ intrinsic-w: w_number intrinsic-h: h_number -up-w_ -up-h_)
  <> {up-w: $'(ceil →w), up-h: $'(ceil →h), (w): (), (h): ()}

;;
;; viewport
;;

(viewport _ ¦ _ dn-w: W_number final-w: (%- (%never) final-w)) <> {final-w: →W}
(viewport _ ¦ _ dn-h: H_number final-h: (%- (%never) final-h)) <> {final-h: →H}

;;
;; padding
;;

;; Initialize
(padding _ ¦ _ pl⋮ 0 pr⋮ 0 -px_) <> {px: $'(+ →pl →pr)}
(padding _ ¦ _ pt⋮ 0 pb⋮ 0 -py_) <> {py: $'(+ →pt →pb)}

;; Alter up-w/h flow.
(padding {¦ up-w: w_number} ¦ _ px_number -up-w: W) <> {W: $'(+ →w →px), (w): ()}
(padding {¦ up-h: h_number} ¦ _ py_number -up-h: H) <> {H: $'(+ →h →py), (h): ()}

;; Alter dn-w/h flow.
(padding {¦ -dn-w: w} ¦ _ px_number dn-w: W_number) <> {w: $'(- →W →px), (W): ()}
(padding {¦ -dn-h: h} ¦ _ py_number dn-h: H_number) <> {h: $'(- →H →py), (H): ()}

;; Offset the child by pl/pt.
(padding {¦ dl⋮ 0} ¦ _ pl_number position: _ -Lχ_) <> {dl: $'(+ →dl →pl), Lχ: true}
(padding {¦ dt⋮ 0} ¦ _ pt_number position: _ -Tχ_) <> {dt: $'(+ →dt →pt), Tχ: true}

;;
;; limit
;;

;; Intercept up-w/h.
(limit {¦ up-w: w_number} ¦ _ -up-w: W) <> {W: (arg →w), (w): ()}
(limit {¦ up-h: h_number} ¦ _ -up-h: H) <> {H: (arg →h), (h): ()}

;; Apply min/max on up-w.
(limit _ ¦ _ up-w: (arg w_number ¦ _ -minχ_) min-w_number)
  <> {w: $'(max →min-w →w), minχ: true}
(limit _ ¦ _ up-w: (arg w_number ¦ _ -maxχ_) max-w_number)
  <> {w: $'(min →max-w →w), maxχ: true}

;; Apply min/max on up-h.
(limit _ ¦ _ up-h: (arg h_number ¦ _ -minχ_) min-h_number)
  <> {h: $'(max →min-h →h), minχ: true}
(limit _ ¦ _ up-h: (arg h_number ¦ _ -maxχ_) max-h_number)
  <> {h: $'(min →max-h →h), maxχ: true}

;; Release up-w/h.
(limit _ ¦ _ up-w_: [arg w_number]) <> {up-w: →w}
(limit _ ¦ _ up-h_: [arg h_number]) <> {up-h: →h}

;; Intercept.
(limit _ ¦ _ dn-w: W_number) <> {W: (arg →W)}
(limit _ ¦ _ dn-h: H_number) <> {H: (arg →H)}

;; Make sure dn-w/h fits into the desired max-w/h, too. This appears semantically
;; coherent -- even if the parent gives us more size we'll still adhere to
;; the child's own restriction.
(limit _ ¦ _ dn-w: (arg w_number ¦ _ -maxχ_) max-w_number)
  <> {w: $'(min →w →max-w), maxχ: true}
(limit _ ¦ _ dn-h: (arg h_number ¦ _ -maxχ_) max-h_number)
  <> {h: $'(min →h →max-h), maxχ: true}

;; Release dn-w/h.
(limit {¦ -dn-w: W} ¦ _ dn-w_: [arg w_number]) <> {W: →w, (dn-w): ()}
(limit {¦ -dn-h: H} ¦ _ dn-h_: [arg h_number]) <> {H: →h, (dn-h): ()}

;;
;; percents
;;

;; Intercept dn-w/h.
(percents _ ¦ _ dn-w_number) <> {dn-w: (arg →dn-w)}
(percents _ ¦ _ dn-h_number) <> {dn-h: (arg →dn-h)}

;; Scale.
(percents _ ¦ _ dn-w: (arg W_number ¦ _ -χ_) w_: (%number 0 <= _ <= 1))
  <> {W: $(round (* →W →w)), χ: true}
(percents _ ¦ _ dn-h: (arg H_number ¦ _ -χ_) h_: (%number 0 <= _ <= 1))
  <> {H: $(round (* →H →h)), χ: true}

;; Release dn-w/h.
(percents {¦ -dn-w: Wdst} ¦ _ dn-w_: [arg W_number]) <> {Wdst: →W, (dn-w): ()}
(percents {¦ -dn-h: Hdst} ¦ _ dn-h_: [arg H_number]) <> {Hdst: →H, (dn-h): ()}

;;
;; floating
;;

[floating {¦ up-w: w_number -dn-w: W}] <> {W: →w, w1: →w, (w): ()}
[floating {¦ up-h: h_number -dn-h: H}] <> {H: →h, h1: →h, (h): ()}

(floating _ ¦ _ dn-w: W_number) <> {(W): ()}
(floating _ ¦ _ dn-h: H_number) <> {(H): ()}

;;
;; align
;;

(align {¦ content-w: (%- (%never) content-w) up-w: w_number} ¦ _ x: _number -up-w: W)
  <> {content-w: →w, W: →w, (w): ()}
(align {¦ content-h: (%- (%never) content-h) up-h: h_number} ¦ _ y: _number -up-h: H)
  <> {content-h: →h, H: →h, (h): ()}

(align {¦ content-w: Wcontent_number current-w: (%- (%never) w) -dn-w: w} ¦ _ x: _number dn-w: W_number frame-w: (%- (%never) frame-w))
  <> {frame-w: →W, w: $'(min →Wcontent →W), (W): ()}
(align {¦ content-h: Hcontent_number current-h: (%- (%never) h) -dn-h: h} ¦ _ y: _number dn-h: H_number frame-h: (%- (%never) frame-h))
  <> {frame-h: →H, h: $'(min →Hcontent →H), (H): ()}

;; TODO: can we dedupe these somehow ?! their bodies are exactly the same

(align {¦ current-w: Winner_number dl⋮ 0} ¦ _ frame-w: Wframe_number position: _ x_number -Lχ_)
  <> {dl: $(+ →dl (round (- (* →Wframe →x) (* →Winner →x)))), Lχ: true}
(align {¦ current-h: Hinner_number dt⋮ 0} ¦ _ frame-h: Hframe_number position: _ y_number -Tχ_)
  <> {dt: $(+ →dt (round (- (* →Hframe →y) (* →Hinner →y)))), Tχ: true}

(align {¦ content-w: Winner_number dl⋮ 0} ¦ _ position: _ lax: _ frame-w: Wframe_number x_number -Lχ_)
  <> {dl: $(+ →dl (round (- (* →Wframe →x) (* →Winner →x)))), Lχ: true}
(align {¦ content-h: Hinner_number dt⋮ 0} ¦ _ position: _ lax: _ frame-h: Hframe_number y_number -Tχ_)
  <> {dt: $(+ →dt (round (- (* →Hframe →y) (* →Hinner →y)))), Tχ: true}

;;
;; `metrics` event
;;
;; metrics events are sent by x/y/z-stack and x/y-wrap to assess the state of
;; their children. The measurement is generic. We do not differentiate between
;; the different kinds of stacks or wraps at this point.

;; TODO: these should be mostly generated from a template aka machine generated!

;; Update x/y-stride from up-w/h.
{¦ r: [metrics _] up-w_number x-stride: (%- (%never) stride)} <> {stride: →up-w, (up-w): ()}
{¦ r: [metrics _] up-h_number y-stride: (%- (%never) stride)} <> {stride: →up-h, (up-h): ()}

;; Max of widths/heights.
{¦ r: (metrics {¦ Wmax_: ?} ¦ _ -Wmax: χ) shrink: (%- (%any true w)) -up-w x-stride_number} <> {Wmax: →x-stride, χ: true}
{¦ r: (metrics {¦ Wmax_number} ¦ _ -Wmax: χ) shrink: (%- (%any true w)) -up-w x-stride_number} <> {Wmax: $'(max →Wmax →x-stride), χ: true}

{¦ r: (metrics {¦ Hmax_: ?} ¦ _ -Hmax: χ) shrink: (%- (%any true h)) -up-h y-stride_number} <> {Hmax: →y-stride, χ: true}
{¦ r: (metrics {¦ Hmax_number} ¦ _ -Hmax: χ) shrink: (%- (%any true h)) -up-h y-stride_number} <> {Hmax: $'(max →Hmax →y-stride), χ: true}

;; Sum of widths/heights excluding fr children.
{¦ r: (metrics {¦ Wlo_: ?} ¦ _ -Wlo: χ) -fr -up-w x-stride_number} <> {Wlo: →x-stride, χ: true}
{¦ r: (metrics {¦ Wlo_number} ¦ _ -Wlo: χ) -fr -up-w x-stride_number} <> {Wlo: $'(+ →Wlo →x-stride), χ: true}

{¦ r: (metrics {¦ Hlo_: ?} ¦ _ -Hlo: χ) -fr -up-h y-stride_number} <> {Hlo: →y-stride, χ: true}
{¦ r: (metrics {¦ Hlo_number} ¦ _ -Hlo: χ) -fr -up-h y-stride_number} <> {Hlo: $'(+ →Hlo →y-stride), χ: true}

;; Sum of widths/heights including fr children.
{¦ r: (metrics {¦ Whi_: ?} ¦ _ -Whi: χ) -up-w x-stride_number} <> {Whi: →x-stride, χ: true}
{¦ r: (metrics {¦ Whi_number} ¦ _ -Whi: χ) -up-w x-stride_number} <> {Whi: $'(+ →Whi →x-stride), χ: true}

{¦ r: (metrics {¦ Hhi_: ?} ¦ _ -Hhi: χ) -up-h y-stride_number} <> {Hhi: →y-stride, χ: true}
{¦ r: (metrics {¦ Hhi_number} ¦ _ -Hhi: χ) -up-h y-stride_number} <> {Hhi: $'(+ →Hhi →y-stride), χ: true}

;; Sum of frs.
{¦ r: (metrics {¦ Fsum_number} ¦ _ -Fsum: χ) fr_number} <> {Fsum: $'(+ →Fsum →fr), χ: true}

;; No. of participants: if I modified the metrics then I am a participant of it.
{¦ r: (metrics {¦ N⋮ 0} ¦ (%not ()) -N: χ)} <> {N: $'(+ →N 1), χ: true}

;;
;; Stack events
;;

;; TODO: x/y-arrange and x/y-place DRY. They're exactly the same minus x->y letter changes.

;; If a child reports up-w/h that is exactly the same as the previous one,
;; x/y/z-stack won't reply to avoid infinite loops. However, the child itself
;; may rely on the parent replying to its up-w/h. Therefore, if the child sees
;; that its x/y-stride is exactly the same as up-w/h that it reports, it will
;; reply to itself with det-w/h.
{¦ x-stride: w_ up-w_: w_ det-w_number -dn-w_} <> {dn-w: →det-w, (up-w): ()}
{¦ y-stride: h_ up-h_: h_ det-h_number -dn-h_} <> {dn-h: →det-h, (up-h): ()}

;; x-arrange

;; Update det-w of fractionally-sized node.
{¦ r: (x-arrange {¦ Fsum_number: (%not 0)} Rw_number ¦ _ -Fχ_) det-w: (%- (%never) det-w) fr_number}
  <> {det-w: $(round (* →Rw (/ →fr →Fsum))), Fχ: true}

;; Update det-w of exact-sized node.
{¦ r: (x-arrange _ _ ¦ _ -Fχ_) x-stride_number det-w: (%- (%never) det-w)}
  <> {det-w: →x-stride, Fχ: true}

;; Send det-w as dn-w.
{¦ r: (x-arrange _ _ ¦ _ Fχ: _ -Wχ_) -dn-w_ det-w_number}
  <> {dn-w: →det-w, Wχ: true}

;; y-arrange
{¦ r: (y-arrange {¦ Fsum_number: (%not 0)} Rh_number ¦ _ -Fχ_) det-h: (%- (%never) det-h) fr_number}
  <> {det-h: $(round (* →Rh (/ →fr →Fsum))), Fχ: true}

{¦ r: (y-arrange _ _ ¦ _ -Fχ_) y-stride_number det-h: (%- (%never) det-h)}
  <> {det-h: →y-stride, Fχ: true}

{¦ r: (y-arrange _ _ ¦ _ Fχ: _ -Hχ_) -dn-h_ det-h_number}
  <> {dn-h: →det-h, Hχ: true}

;; x/y-expand
{¦ r: (x-expand _ W_number ¦ _ -χ_) det-w: (%- (%never) w) -dn-w: w} <> {w: →W, χ: true}
{¦ r: (y-expand _ H_number ¦ _ -χ_) det-h: (%- (%never) h) -dn-h: h} <> {h: →H, χ: true}

;; x-place
{¦ r: [x-place L_number gap_number] det-w_number dl⋮ 0 -position_}
  <> {dl: $'(+ →L →dl), L: $'(+ →L →gap →det-w), position: true}

;; fallback (e.g. floating nodes)
{¦ r: [x-place L_number _] dt⋮ 0 -position_}
  <> {dt: →L, position: true}

;; y-place
{¦ r: [y-place T_number gap_number] det-h_number dt⋮ 0 -position_}
  <> {dt: $'(+ →T →dt), T: $'(+ →T →gap →det-h), position: true}

;; fallback (e.g. floating nodes)
{¦ r: [y-place T_number _] dt⋮ 0 -position_}
  <> {dt: →T, position: true}

;; z-place
{¦ r: (z-place) -position_} <> {position: true}

;;

{¦ up-w: _ r: [(%any x-arrange y-arrange x-expand y-expand) {¦ -invalid_} _*]} <> {invalid: true}
{¦ up-h: _ r: [(%any x-arrange y-arrange x-expand y-expand) {¦ -invalid_} _*]} <> {invalid: true}

;;
;; Rules common to x/y/z-stack.
;;

;; place the metrics to the pairspart.
((%any x-stack y-stack z-stack) _* {¦ r_: [metrics S_]} ¦ _ metrics_)
  <> {(r): (), metrics: →S}

;; Invalidate metrics.
((%any x-stack y-stack z-stack) _* {¦ r_: [_ {¦ invalid: _} _*]} ¦ _ metrics_)
  <> {(metrics): (), (r): ()}
[(%any x-stack y-stack z-stack) _* {¦ r_}]
  <> {(r): ()}

;;
;; Rules common to x/y-stack.
;;

;; Enhance resulting metrics with accumulated gap (Agap)
((%any x-stack y-stack) _* {¦ r: [metrics {¦ -Agap_ N_number}]} ¦ _ gap⋮ 0)
  <> {Agap: $(* (- →N 1) →gap)}


;; TODO: x/y-stack DRY. They're exactly the same minus x->y letter changes.

;;
;; x-stack
;;

;; Order metrics for x-stack.
(x-stack {¦ -r_} _+ ¦ _ -metrics_)
  <> {r: (metrics {Wlo: 0, Whi: ?, Hmax: ?, Fsum: 0}), metrics: wait}

;; Calculate up-w candidate.
(x-stack _* {¦ r: [metrics {¦ Whi_number Agap_number}]} ¦ _ -up-w/new: w)
  <> {w: $(+ →Whi →Agap)}

;; Calculate up-h candidate.
(x-stack _* {¦ r: [metrics {¦ Hmax_number}]} ¦ _ -up-h/new: h)
  <> {h: →Hmax}

;; Trigger x-arrange once dn-w is known.
(x-stack {¦ -r_} _* ¦ _ metrics_: {¦ Wlo_number Agap_number} dn-w_number)
  <> {r: (x-arrange →metrics $'(- →dn-w →Wlo →Agap)), (dn-w): ()}

;; Trigger y-expand once dn-h is known.
(x-stack {¦ -r_} _* ¦ _ metrics_ dn-h_number)
  <> {r: (y-expand →metrics →dn-h), (dn-h): ()}

;; Trigger positioning of children.
(x-stack {¦ -r_} _* ¦ _ position_: true gap⋮ 0)
  <> {r: (x-place 0 →gap), position: false}

;;
;; y-stack
;;

(y-stack {¦ -r_} _+ ¦ _ -metrics_)
  <> {r: (metrics {Wmax: ?, Hlo: 0, Hhi: ?, Fsum: 0}), metrics: wait}

(y-stack _* {¦ r: [metrics {¦ Wmax_number}]} ¦ _ -up-w/new: w)
  <> {w: →Wmax}

(y-stack _* {¦ r: [metrics {¦ Hhi_number Agap_number}]} ¦ _ -up-h/new: h)
  <> {h: $(+ →Hhi →Agap)}

(y-stack {¦ -r_} _* ¦ _ metrics_ dn-w_number)
  <> {r: (x-expand →metrics →dn-w), (dn-w): ()}

(y-stack {¦ -r_} _* ¦ _ metrics_: {¦ Hlo_number Agap_number} dn-h_number)
  <> {r: (y-arrange →metrics $'(- →dn-h →Hlo →Agap)), (dn-h): ()}

(y-stack {¦ -r_} _* ¦ _ position_: true gap⋮ 0)
  <> {r: (y-place 0 →gap), position: false}

;;
;; z-stack
;;

(z-stack {¦ -r_} _+ ¦ _ -metrics_) <> {r: (metrics {Wmax: ?, Hmax: ?}), metrics: wait}
(z-stack _* {¦ r: [metrics {¦ Wmax_number}]} ¦ _ -up-w/new: w) <> {w: →Wmax}
(z-stack _* {¦ r: [metrics {¦ Hmax_number}]} ¦ _ -up-h/new: h) <> {h: →Hmax}
(z-stack {¦ -r_} _* ¦ _ metrics_ dn-w_number) <> {r: (x-expand →metrics →dn-w), (dn-w): ()}
(z-stack {¦ -r_} _* ¦ _ metrics_ dn-h_number) <> {r: (y-expand →metrics →dn-h), (dn-h): ()}
(z-stack {¦ -r_} _* ¦ _ position_: true) <> {r: (z-place), position: false}

;;
;; x/y-log
;;

;; For children that know their up-w already, x-log simply records that up-w.
{¦ r: (x-log (_* `T) ¦ _ -χ_) up-w: w_number} <> {T: →w, χ: true}
{¦ r: (y-log (_* `T) ¦ _ -χ_) up-h: h_number} <> {T: →h, χ: true}

;; For children that tell they're fr but do not know their size, x-log
;; records that as flexible size, indicated by `~`.
{¦ r: (x-log (_* `T) ¦ _ -χ_) -up-w fr: _} <> {T: ~, χ: true}
{¦ r: (y-log (_* `T) ¦ _ -χ_) -up-h fr: _} <> {T: ~, χ: true}

;; For other children, x/y-log records unknown size, indicated by `?`.
{¦ r: (x-log (_* `T) ¦ _ -χ_)} <> {T: ?, χ: true}
{¦ r: (y-log (_* `T) ¦ _ -χ_)} <> {T: ?, χ: true}

;;
;; wrap-stat
;;

;; Zip through the log, collecting statistics. We're interested in N,
;; the number of known-participant children (to calculate accumulated gap),
;; and Sp, the total size of participant children.
[wrap-stat `L R←(_*)] <> {L: ()}
(wrap-stat (_* `l) (r←~ _*) ¦ _ Np⋮ 0) <> {Np: $'(+ →Np 1), l: →r, (r): ()}
[wrap-stat (_* `l) (r←? _*)] <> {l: →r, (r): ()}
(wrap-stat (_* `l) (w_number _*) ¦ _ Np⋮ 0 Sp⋮ 0)
  <> {Np: $'(+ →Np 1), Sp: $'(+ →Sp →w), l: →w, (w): ()}

;;
;; x/y-wrap
;;

;; Copy nodes out of the rewrite-protected pairspart into rewriteable
;; itemspart. Let nodes rewrite themselves until some of them can tell
;; their up-w (if they can of course).
(x-wrap `T ¦ _ -state_ nodes_: (_+)) <> {(T): →nodes, state: initial}
(y-wrap `T ¦ _ -state_ nodes_: (_+)) <> {(T): →nodes, state: initial}

(x-wrap {¦ -r_} _* ¦ _ state_: initial) <> {r: (x-log ()), state: log}
(y-wrap {¦ -r_} _* ¦ _ state_: initial) <> {r: (y-log ()), state: log}

;; After the log is known, stat it by instantiating the wrap-stat zipper.
(x-wrap (%group children _* {¦ r_: [x-log log_]}) ¦ _ state_: log)
  <> {children: (wrap-stat →log), state: stat}
(y-wrap (%group children _* {¦ r_: [y-log log_]}) ¦ _ state_: log)
  <> {children: (wrap-stat →log), state: stat}

;; NOTE: x/y-wrap must have at least one sized child for Sp/N to be defined,
;; otherwise, x/y-wrap itself will be unsized (most likely causing it to float).
(x-wrap N←(wrap-stat log_ () ¦ stats_) ¦ _ state_: stat -log: log-dst -stats: stats-dst)
  <> {(N): (), log-dst: →log, stats-dst: →stats, state: sizing}
(y-wrap N←(wrap-stat log_ () ¦ stats_) ¦ _ state_: stat -log: log-dst -stats: stats-dst)
  <> {(N): (), log-dst: →log, stats-dst: →stats, state: sizing}

;; Calculate up-w/h.
(x-wrap ¦ _ state_: sizing gap-x: (%optional 0 gap_) stats: {¦ Sp_number Np_number} -up-w: w)
  <> {state: sized, w: $(+ →Sp (* →gap (- →Np 1)))}
(y-wrap ¦ _ state_: sizing gap-y: (%optional 0 gap_) stats: {¦ Sp_number Np_number} -up-h: h)
  <> {state: sized, h: $(+ →Sp (* →gap (- →Np 1)))}

;; Consume dn-w/h until in sized state.
(x-wrap _* ¦ _ dn-w_number) <> {(dn-w): ()}
(y-wrap _* ¦ _ dn-h_number) <> {(dn-h): ()}

;; Construct wrapper on dn-w/h in sized state.
(x-wrap children_* ¦ _ state: sized limit: (%- (%never) limit) dn-w_number)
  <> {children: (wrapper main: x-stack cross: y-stack), limit: →dn-w, (dn-w): ()}
(y-wrap children_* ¦ _ state: sized limit: (%- (%never) limit) dn-h_number)
  <> {children: (wrapper main: y-stack cross: x-stack), limit: →dn-h, (dn-h): ()}

;; Respond with limit to any up-w/h to avoid infinite loops (children
;; x/y-stack's reporting their size leads to rewrap leads to new x/y-stack's
;; reporting their sizes and so on).
(x-wrap {¦ up-w_number -dn-w_} ¦ _ limit_number) <> {dn-w: →limit, (up-w): ()}
(y-wrap {¦ up-h_number -dn-h_} ¦ _ limit_number) <> {dn-h: →limit, (up-h): ()}

;; Copy limit.
(x-wrap (wrapper ¦ _ -limit: limit') ¦ _ limit_number) <> {limit': →limit}
(y-wrap (wrapper ¦ _ -limit: limit') ¦ _ limit_number) <> {limit': →limit}

;; Copy log.
(x-wrap (wrapper ¦ _ -log: log') ¦ _ log_) <> {log': →log}
(y-wrap (wrapper ¦ _ -log: log') ¦ _ log_) <> {log': →log}

;; Copy nodes.
(x-wrap (wrapper ¦ _ -nodes: nodes') ¦ _ nodes_) <> {nodes': →nodes}
(y-wrap (wrapper ¦ _ -nodes: nodes') ¦ _ nodes_) <> {nodes': →nodes}

;; Copy min span.
(x-wrap (wrapper ¦ _ -min-span: min-span') ¦ _ min-span_) <> {min-span': →min-span}
(y-wrap (wrapper ¦ _ -min-span: min-span') ¦ _ min-span_) <> {min-span': →min-span}

;; Copy max span.
(x-wrap (wrapper ¦ _ -max-span: max-span') ¦ _ max-span_) <> {max-span': →max-span}
(y-wrap (wrapper ¦ _ -max-span: max-span') ¦ _ max-span_) <> {max-span': →max-span}

;; Define gap-main and gap-cross.
(x-wrap (wrapper ¦ _ -gap-main_) ¦ _ gap-x_number) <> {gap-main: →gap-x}
(y-wrap (wrapper ¦ _ -gap-main_) ¦ _ gap-y_number) <> {gap-main: →gap-y}

(x-wrap (wrapper ¦ _ -gap-cross_) ¦ _ gap-y_number) <> {gap-cross: →gap-y}
(y-wrap (wrapper ¦ _ -gap-cross_) ¦ _ gap-x_number) <> {gap-cross: →gap-x}

;; Transition into an initialized state by defining rem (remainder)
;; and span (no. of nodes on the main axis).
[x-wrap (wrapper ¦ _ -rem_ -span_ limit_number)] <> {rem: →limit, span: 0}
[y-wrap (wrapper ¦ _ -rem_ -span_ limit_number)] <> {rem: →limit, span: 0}

;; Sink rule that fires when there's nothing left to initialize.
[x-wrap C←(wrapper ¦ _ -ready_)] <> {ready: true}
[y-wrap C←(wrapper ¦ _ -ready_)] <> {ready: true}

;; Surround with cross axis.
[x-wrap C←(wrapper ¦ _ ready: _ cross_ gap-cross⋮ 0)] <> {C: (→cross →C gap: →gap-cross)}
[y-wrap C←(wrapper ¦ _ ready: _ cross_ gap-cross⋮ 0)] <> {C: (→cross →C gap: →gap-cross)}

;; Surround with main axis.
[cross_ _* C←(wrapper ¦ _ main_ cross_ gap-main⋮ 0)]
  <> {C: (→main →C gap: →gap-main)}

;; Propose to expel left. This rule votes yes unconditionally.
[main_ _* (wrapper ¦ _ main_ rem_number span_number log: (w_number _*) -proposal_)]
  <> {proposal: (prepare {irem: $'(- →rem →w), span: $'(+ →span 1), accept: true})}
[main_ _* (wrapper ¦ _ main_ span_number log: (~ _*) -proposal_)]
  <> {proposal: (prepare {irem: →rem, span: $'(+ →span 1), accept: true})}
[main_ _* (wrapper ¦ _ main_ log: (? _*) -proposal_)]
  <> {proposal: (prepare {accept: true})}

;; Subtract gap-x if necessary from intrinsic rem to obtain rem.
(wrapper ¦ _ proposal: (prepare {¦ irem_number -rem_}) span: 0)
  <> {rem: →irem}
(wrapper ¦ _ proposal: (prepare {¦ irem_number -rem_}) gap-main⋮ 0)
  <> {rem: $'(- →irem →gap-main)}

(wrapper ¦ _ proposal_: (prepare P_)) <> {proposal: →P}

;; These rules vote on the proposal to expel left also. Note how each
;; proceeds only if all other accepted with the `accept: true` constraint.
(wrapper ¦ _ proposal: {¦ rem_number accept_: true -Wχ_})
  <> {accept: $'(>= →rem 0), Wχ: true}
(wrapper ¦ _ proposal: {¦ span_number accept: true -min-sat_} min-span_: (%number (whole _) > 0))
  <> {min-sat: $'(> →span →min-span)}
(wrapper ¦ _ proposal: {¦ span_number accept: true min-sat: true -max-sat_} max-span_: (%number (whole _) > 0))
  <> {max-sat: $'(<= →span →max-span)}

;; If max unsat, vote against proposal. Otherwise, either max is missing
;; or it is sat.
(wrapper ¦ _ proposal: {¦ span_number accept_: true max-sat: false}) <> {accept: false}

;; These rules have deliberately low specificity vs. the voting rules.
;; They announce the result of voting when no more voters remain.
(wrapper ¦ _ proposal: P←{¦ accept: true}) <> {P: (accepted →P)}
(wrapper ¦ _ proposal: P←{¦ accept: false}) <> {P: (declined →P)}

;; If min unsat in declined, convert to accepted (aka force even if overflows
;; when min unsat).
(wrapper ¦ _ proposal: P←(declined p←{¦ min-sat: false}))
  <> {P: (accepted →p)}

;; Merge accepted.
C←(wrapper ¦ _ proposal: P←(accepted {¦ rem: rem'_number span: span'_number}) rem_number span_number nodes: (N_ _*) log: (rec_ _*))
  <> {(C): (↑N0 ↑C), (P): (), rem: →rem', span: →span', (N): ($tr N0 ()), (rec): ()}

;; Destroy declined and exit the x-stack.
S←[main_ _* C←(wrapper ¦ _ main_ proposal: P←(declined _) rem_number span_number limit_number)]
  <> {(P): (), rem: →limit, span: 0, (S): (↑S ↑C0), (C): ($tr C0 ())}

;; Self-destruct once exhausted.
C←(wrapper ¦ _ nodes: ()) <> {(C): ()}

(branch-btn name_string) =>
  (z-stack z-index: local
    (rect
      z-index: -1
      fill: (oklch 0.3 0 0)
      stroke: (oklch 0.35 0 0)
      thickness-l: 1
      thickness-r: 1
      thickness-t: 1
      thickness-b: 1
      radius-tl: 5
      radius-tr: 5
      radius-bl: 5
      radius-br: 5)
    (padding pl: 8 pr: 8 pt: 5 pb: 5
      (align y: 0.5
        (x-stack gap: 10
          (align y: 0.5
            (text caption: "a" leading: 1 color: (oklch 0.9 0 0) font: "Material Icons Outlined" size: 14))
          (align fr: 1 y: 0.5
            (text caption: ^name color: (oklch 0.9 0 0) font: "IBM Plex Sans" size: 16))
          (align y: 0.5
            (text caption: "b" leading: 1 color: (oklch 0.9 0 0) font: "Material Icons Outlined" size: 14))))))

(branch-menu name_string) =>
  (limit z-index: local
    (z-stack
      (rect z-index: 0
        fill: (oklch 0.1 0 0)
        stroke: (oklch 0.35 0 0)
        thickness-l: 1
        thickness-r: 1
        thickness-t: 1
        thickness-b: 1
        radius-tl: 5
        radius-tr: 5
        radius-bl: 5
        radius-br: 5)
      (floating
        (rect z-index: -1
          fill: (oklch 0.4 0 0)
          angle: 45
          pivot: true
          dl: 10
          dt: -3
          up-w: 10
          up-h: 10))
      (group z-index: 1
        (branch-menu-inner ^name))))

(branch-menu-inner name_string) =>
  (y-stack gap: 10
    (padding pl: 10 pr: 10 pt: 10
      (branch-menu-header))
    (hr (oklch 0.4 0 0))
    (branch-menu-main ^name)
    (hr (oklch 0.4 0 0))
    (view-all-branches))

(view-all-branches) =>
  (padding pl: 15 pr: 15 pb: 10
    (text wrap: true caption: "View all branches" font: "IBM Plex Sans" size: 14 color: (oklch 0.95 0 0)))

(branch-menu-header) =>
  (y-stack gap: 10
    (x-stack
      (align y: 0.5 fr: 1
        (text wrap: true caption: "Switch branches/tags" font: "IBM Plex Sans" weight: 500 size: 14 color: (oklch 0.8 0 0)))
      (cancel-btn))
    (input-field placeholder: "Find or create a branch..."))

(branch-menu-main name_string) =>
  (y-stack gap: 8
    (tab-bar ((active "Branches") "Tags"))
    (branch-item-list ^name))

(branch-item-list name_string) =>
  (padding pl: 5 pr: 5
    (y-stack
      (branch-list-item ^name badge: "default" hover: true)
      (branch-list-item "trunk")))

(branch name_string) =>
  (branch-btn ^name)

(branch (active name_string)) =>
  (y-stack gap: 10 z-index: local
    (branch-btn ^name)
    (floating z-index: 10
      (branch-menu ^name)))

(branch-row (branches_*)) =>
  (x-stack gap: 10
    (^each (branches as branch_)
      (branch ^branch)))

(branches-card (branches_*)) =>
  (z-stack z-index: local
   (rect z-index: -1
     fill: (oklch 0.2 0 0)
     radius-tl: 10
     radius-tr: 10
     radius-bl: 10
     radius-br: 10)
   (padding pl: 20 pr: 20 pt: 20 pb: 20
     (y-stack gap: 10
       (text wrap: true caption: "Branches" font: "IBM Plex Mono" weight: 800 size: 24 color: (oklch 0.7 0 0))
       (text wrap: true shrink: true caption: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat." font: "IBM Plex Sans" size: 16 color: (oklch 0.8 0 0))
       (branch-row ^branches))))

(cancel-btn) =>
  (align x: 0.5 y: 0.5 z-index: local
    (z-stack
      (rect
        z-index: -1
        fill: (oklch 0.3 0 0)
        radius-tl: 5
        radius-tr: 5
        radius-bl: 5
        radius-br: 5)
      (padding pl: 5 pr: 5 pt: 5 pb: 5
        (text caption: "a" leading: 1 color: (oklch 0.9 0 0) font: "Material Icons Outlined" size: 14))))

(input-field ¦ _ icon⋮ "b" placeholder⋮ "" value⋮ "" active⋮ false) =>
  (z-stack z-index: local
    (rect
      z-index: -1
      fill: (oklch 0.18 0 0)
      stroke:
        (^match active
          (when true (oklch 0.5 0.25 250))
          (when false (oklch 0.4 0 0)))
      thickness-l: 1
      thickness-r: 1
      thickness-t: 1
      thickness-b: 1
      radius-tl: 5
      radius-tr: 5
      radius-bl: 5
      radius-br: 5)
    (padding pl: 8 pr: 8 pt: 5 pb: 5
      (viewport
        (x-stack gap: 5
          (align y: 0.5
            (text
              caption: ^icon
              leading: 1
              color:
                (^match active
                  (when true (oklch 0.7 0.25 250))
                  (when false (oklch 0.7 0 0)))
              font: "Material Icons Outlined"
              size: 14))
          (align y: 0.5 fr: 1
            ;; Offset the text by 1 to remove the out-of-center feeling I have, although
            ;; it does appear centered. Text centering is really hard, you see!
            (^match active
              (when true
                (text caption: ^value dt: 1 font: "IBM Plex Sans" size: 14 color: (oklch 0.9 0 0) selection: true selection-anchor: 3 selection-span: 0 selection-fill: (oklch 1.0 0 0)))
              (when false
                (text caption: ^placeholder dt: 1 font: "IBM Plex Sans" size: 14 color: (oklch 0.7 0 0)))))))))

(hr color_ ¦ _ thickness⋮ 1) =>
  (align y: 0.5
    (limit max-h: ^thickness
      (rect up-w: 0 up-h: ^thickness fill: ^color)))

(tab (active caption_string)) =>
  (z-stack z-index: local
    (rect
      z-index: -1
      fill: (oklch 0.2 0 0)
      stroke: (oklch 0.35 0 0)
      thickness-l: 1
      thickness-r: 1
      thickness-t: 1
      thickness-b: 0
      radius-tl: 5
      radius-tr: 5
      radius-bl: 0
      radius-br: 0)
    (padding pl: 8 pr: 8 pt: 5 pb: 5
      (text caption: ^caption font: "IBM Plex Sans" size: 14 color: (oklch 0.95 0 0))))

(tab caption_string) =>
  (padding pl: 8 pr: 8 pt: 5 pb: 5
    (text caption: ^caption font: "IBM Plex Sans" size: 14 color: (oklch 0.95 0 0)))

(tab-bar (tabs_*)) =>
  (y-stack z-index: local
    (padding pl: 10
      (x-stack z-index: 1
        (^each (tabs as tab_)
          (tab ^tab))))
    (group z-index: 0 dt: -1
      (hr (oklch 0.4 0 0))))

(badge caption_string) =>
  (z-stack z-index: local
    (rect
      z-index: -1
      stroke: (oklch 0.35 0 0)
      thickness-l: 1
      thickness-r: 1
      thickness-t: 1
      thickness-b: 1
      radius-tl: 10
      radius-tr: 10
      radius-bl: 10
      radius-br: 10)
    (padding pl: 6 pr: 6
      (align x: 0.5 y: 0.5
        (text wrap: true caption: ^caption font: "IBM Plex Sans" size: 12 color: (oklch 0.95 0 0)))))

(branch-list-item caption_string ¦ _ badge⋮ "" hover⋮ false) =>
  (z-stack z-index: local
    (^if hover
      (rect
        z-index: -1
        fill: (oklch 0.25 0 0)
        radius-tl: 5
        radius-tr: 5
        radius-bl: 5
        radius-br: 5))
    (padding pl: 5 pr: 5 pt: 5 pb: 5
      (x-stack gap: 5
        (align y: 0.5
          (text
            caption:
              (^match hover
                (when true "icon") ;; check
                (when false "icon")) ;; fiber_manual_record
            leading: 1 color: (oklch 0.9 0 0) font: "Material Icons Outlined" size: 14))
        (align y: 0.5 fr: 1
          (text wrap: true caption: ^caption font: "IBM Plex Sans" size: 14 color: (oklch 0.95 0 0)))
        (^unless (= badge "")
          (align y: 0.5
            (badge ^badge))))))

(up-badge caption_string ¦ _ color_) =>
  (z-stack z-index: local
    (rect
      z-index: -1
      stroke: ^color
      thickness-l: 1
      thickness-r: 1
      thickness-t: 1
      thickness-b: 1
      radius-tl: 3
      radius-tr: 3
      radius-bl: 3
      radius-br: 3)
    (padding pl: 5 pt: 3 pb: 4 pr: 5
      (x-stack z-index: 1 gap: 3
        (align y: 0.5
          (text caption: ^caption leading: 1 font: "IBM Plex Sans" size: 11 color: ^color))
        (align y: 0.5
          (text caption: "icon" leading: 1 font: "Material Icons Outlined" size: 11 color: ^color)))))

(arrow-out-btn/active) =>
  (align x: 0.5 y: 0.5
    (z-stack z-index: local
      (rect
        fill: white
        radius-tl: (* 1)
        radius-tr: (* 1)
        radius-bl: (* 1)
        radius-br: (* 1))
      (padding pl: 5 pr: 5 pb: 5 pt: 5
        (text caption: "icon" z-index: 1 leading: 1 font: "Material Icons Outlined" size: 16 color: black))))

(arrow-out-btn/inactive) =>
  (align x: 0.5 y: 0.5
    (z-stack z-index: local
      (rect
        stroke: (oklch 0.8 0 0)
        thickness-l: 1
        thickness-r: 1
        thickness-t: 1
        thickness-b: 1
        radius-tl: (* 1)
        radius-tr: (* 1)
        radius-bl: (* 1)
        radius-br: (* 1))
      (padding pl: 5 pr: 5 pb: 5 pt: 5
        (text caption: "icon" z-index: 1 leading: 1 font: "Material Icons Outlined" size: 16 color: (oklch 0.8 0 0)))))

(stat-card ¦ _ title_string stat_string badge_⋮ none comment_string active⋮ false) =>
  (z-stack z-index: local
    (^match active
      (when true
        (rect z-index: -1
          fill:
            (linear-gradient start-l: 0
              (stop 0 (oklch 0.4496 0.0686 143.68))
              (stop 1 (oklch 0.319 0.0576 143.68)))
          radius-tl: 7
          radius-tr: 7
          radius-bl: 7
          radius-br: 7))
      (when false
        (rect z-index: -1
          stroke: (oklch 0.25 0 0)
          thickness-l: 1
          thickness-r: 1
          thickness-t: 1
          thickness-b: 1
          radius-tl: 7
          radius-tr: 7
          radius-bl: 7
          radius-br: 7)))
    (padding pl: 15 pr: 15 pt: 15 pb: 15
      (y-stack
        (x-stack gap: 10
          (text fr: 1 caption: ^title font: "IBM Plex Sans" weight: 450 size: 16 color: (oklch 0.98 0 0))
          (^match active
            (when true (arrow-out-btn/active))
            (when false (arrow-out-btn/inactive))))
        (text caption: ^stat font: "IBM Plex Sans" size: 36 color: white weight: 600)
        (x-stack gap: 10
          (^unless (= badge none)
            (align x: 0 y: 0
              ^badge))
          (align y: 0.5
            (text caption: ^comment wrap: true font: "IBM Plex Sans" size: 11 color: (oklch 0.9665 0.1 143.68)))))))

(status-badge caption_string ¦ _ hue_number) =>
  (z-stack z-index: local
    (rect z-index: -1
      fill: (oklch 0.3 0.05 ^hue)
      stroke: (oklch 0.5 0.05 ^hue)
      thickness-l: 1
      thickness-r: 1
      thickness-t: 1
      thickness-b: 1
      radius-tl: 3
      radius-tr: 3
      radius-bl: 3
      radius-br: 3)
    (padding pl: 3 pr: 3
      (text caption: ^caption font: "IBM Plex Sans" size: 11 color: (oklch 0.9 0.05 ^hue))))

(person-entry ¦ _ avatar_ name_string task_string badge_⋮ none) =>
  (z-stack z-index: local
    (rect
      z-index: -1
      fill: (oklch 0.175 0 0)
      radius-tl: 5
      radius-tr: 5
      radius-bl: 5
      radius-br: 5)
    (padding pl: 10 pr: 10 pt: 5 pb: 5
      (x-stack gap: 15
        (align x: 0.5 y: 0.5
          (limit max-w: 32 max-h: 32
            ^avatar))
        (y-stack fr: 1
          (text caption: ^name font: "IBM Plex Sans" weight: 450 size: 14 color: white)
          (x-stack gap: 3
            (text caption: "Working on" font: "IBM Plex Sans" size: 11 color: (oklch 0.7 0 0))
            (text caption: ^task font: "IBM Plex Sans" size: 11 weight: 500 color: (oklch 0.9 0 0))))
        (^unless (= badge none)
          (align x: 0.5 y: 0.5
            ^badge)))))

(avatar-img ¦ _ src_) =>
  (rect
    fill: (image ^src)
    radius-tl: (* 1)
    radius-tr: (* 1)
    radius-bl: (* 1)
    radius-br: (* 1))

(people-card people_+ ¦ _ title_string) =>
  (z-stack z-index: local
    (rect z-index: -1
      stroke: (oklch 0.25 0 0)
      thickness-l: 1
      thickness-r: 1
      thickness-t: 1
      thickness-b: 1
      radius-tl: 7
      radius-tr: 7
      radius-bl: 7
      radius-br: 7)
    (padding pl: 15 pr: 15 pt: 15 pb: 15
      (y-stack gap: 10
        (text caption: ^title font: "IBM Plex Sans" weight: 450 size: 16 color: (oklch 0.98 0 0))
        (y-stack gap: 8
          ^*people))))

(project-card ¦ _ icon_string title_string detail_string progress_: (%number 0 <= _ <= 1)) =>
  (y-stack z-index: local
    (z-stack
      (rect
        z-index: -1
        fill: (oklch 0.175 0 0)
        radius-tl: 5
        radius-tr: 5
        radius-bl: 5
        radius-br: 5)
      (padding pl: 15 pr: 15 pt: 8 pb: 8
        (x-stack gap: 15 z-index: local
          (align x: 0.5 y: 0.5 fr: 1
            (text caption: ^icon leading: 1 color: (oklch 0.9 0 0) font: "Material Icons Outlined" size: 24))
          (y-stack fr: 9
            (text wrap: true caption: ^title font: "IBM Plex Sans" weight: 450 size: 14 color: (oklch 0.9 0 0))
            (text wrap: true caption: ^detail font: "IBM Plex Sans" weight: 400 size: 11 color: (oklch 0.85 0 0)))
          (align x: 1 y: 0.5 fr: 2
            (text wrap: true caption: ^(~ (round (* progress 100)) "%") color: (oklch 0.7 0.1 143.68) font: "IBM Plex Sans" size: 16)))))
    (group z-index: 10 dt: -2.5
      (limit max-h: 5
        (percents w: ^progress
          (rect up-h: 5 radius-tl: 5 radius-tr: 5 radius-bl: 5 radius-br: 5 fill: (oklch 0.7 0.1 143.68))))))

(selection-slot child_ ¦ _ selected⋮ false) =>
  (x-stack gap: 15
    (align x: 0.5 y: 0.5
      (z-stack z-index: local
        (rect z-index: -1 up-w: 16 up-h: 16 fill: (oklch 0.3 0 0) radius-tl: (* 1) radius-tr: (* 1) radius-bl: (* 1) radius-br: (* 1))
        (^if selected
          (limit max-w: 16 max-h: 16
            (align x: 0.3 y: 0.9 lax: true
              (text caption: "icon" leading: 1 color: (oklch 0.9 0.15 270) font: "Material Icons Outlined" size: 32))))))
    (group fr: 1
      (z-stack z-index: local
        (^if selected
          (rect z-index: 1 fill: (oklch 0.7 0.2 270 0.3) radius-tl: 15 radius-tr: 15 radius-bl: 15 radius-br: 15))
        (padding z-index: (local 0) pl: 10 pr: 10 pb: 10 pt: 10
          ^child))))

(selection-button ¦ _ icon_string caption_string) =>
  (limit min-w: 80 min-h: 90 max-w: 80 max-h: 90
    (z-stack z-index: local
      (rect z-index: -1
        fill: (oklch 0.4 0 0)
        radius-tl: 5
        radius-tr: 5
        radius-bl: 5
        radius-br: 5)
      (padding pl: 5 pr: 5 pt: 5 pb: 5
        (y-stack gap: 5
          (group fr: 1
            (align x: 0.5 y: 0.5
              (text caption: ^icon leading: 1 color: (oklch 0.95 0 0) font: "Material Icons Outlined" size: 24)))
          (align x: 0.5 y: 0.5
            (text wrap: true align: center caption: ^caption font: "IBM Plex Sans" weight: 400 size: 12 color: (oklch 0.95 0 0)))))))

(projects-card) =>
  (z-stack z-index: local
    (rect z-index: -1
      stroke: (oklch 0.25 0 0)
      thickness-l: 1
      thickness-r: 1
      thickness-t: 1
      thickness-b: 1
      radius-tl: 7
      radius-tr: 7
      radius-bl: 7
      radius-br: 7)
      (y-stack
        (padding pl: 16 pr: 16 pt: 8 pb: 8
          (x-stack gap: 10
            (align fr: 1 y: 0.5
              (text wrap: true caption: "Projects" font: "IBM Plex Sans" weight: 500 size: 16 color: (oklch 0.98 0 0)))
            (group fr: 2
              (input-field placeholder: "Find project..."))))
        (hr (oklch 0.25 0 0))
        (padding pl: 15 pr: 15 pt: 10 pb: 10
          (y-stack gap: 10
            (text caption: "Showing 5 project(s)" font: "IBM Plex Sans" weight: 400 size: 14 color: (oklch 0.8 0 0))
            (y-stack
              (selection-slot
                selected: true
                (project-card
                  icon: "icon"
                  title: "Support search"
                  detail: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
                  progress: 0.7))
              (selection-slot
                (project-card
                  icon: "icon"
                  title: "Support replace"
                  detail: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
                  progress: 0.2))
              (selection-slot
                (project-card
                  icon: "icon"
                  title: "Support highlight"
                  detail: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
                  progress: 0.05))
              (selection-slot
                selected: true
                (project-card
                  icon: "icon"
                  title: "Support void"
                  detail: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
                  progress: 0))
              (selection-slot
                (project-card
                  icon: "icon"
                  title: "Support window"
                  detail: "Lorem ipsum dolor sit amet, qui minim labore adipisicing minim sint cillum sint consectetur cupidatat."
                  progress: 1)))))
        (z-stack z-index: local
          (rect z-index: -1
            fill: (oklch 0.25 0 0)
            radius-bl: 7
            radius-br: 7)
          (padding pl: 8 pr: 8 pt: 8 pb: 8
            (z-stack z-index: local
              (x-ratio/source
                (viewport z-index: (local 0)
                  (x-stack gap: 8
                    (group fr: 1 (selection-button icon: "icon" caption: "Copy"))
                    (group fr: 1 (selection-button icon: "icon" caption: "Cut"))
                    (group fr: 1 (selection-button icon: "icon" caption: "Delete"))
                    (group fr: 1 (selection-button icon: "icon" caption: "Share"))
                    (group fr: 1 (selection-button icon: "icon" caption: "Clear selection")))))
              (x-ratio/sink
                (align y: 1
                  (limit max-h: 5 z-index: 1
                    (rect
                      up-h: 5
                      dt: 7.5
                      radius-tl: (* 1)
                      radius-tr: (* 1)
                      radius-bl: (* 1)
                      radius-br: (* 1)
                      fill: (oklch 1 0 0 0.3))))))))))

(code caption_string ¦ _ fill_⋮ (oklch 0.1 0 0) color_⋮ (oklch 0.8 0 0)) =>
  (z-stack z-index: local
    (rect z-index: -1 fill: ^fill radius-tl: 3 radius-tr: 3 radius-bl: 3 radius-br: 3)
    (padding pl: 3 pr: 3
      (text caption: ^caption size: 14 font: "IBM Plex Mono" color: ^color)))

(word caption_string) =>
  (text caption: ^caption size: 14 font: "IBM Plex Mono" color: (oklch 0.9 0 0))

(emphasis caption_string) =>
  (text caption: ^caption size: 14 font: "IBM Plex Mono" color: (oklch 0.9 0 0) italic: true)

(x-wrapped children_+ ¦ props_) =>
  (x-wrap nodes: ^children ^… props)

(y-wrapped children_+ ¦ props_) =>
  (y-wrap nodes: ^children ^… props)

(suggestion-card words_+) =>
  (z-stack z-index: local
    (rect
      fill: (oklch 0.25 0 0)
      stroke: (oklch 0.35 0 0)
      thickness-l: 1.5
      thickness-r: 1.5
      thickness-t: 1.5
      thickness-b: 1.5
      radius-tl: 10
      radius-tr: 10
      radius-bl: 10
      radius-br: 10
      z-index: -1)
    (y-stack gap: 5
      (padding pl: 10 pr: 10 pt: 8
        (x-stack gap: 8
          (align y: 0.5
            (text caption: "icon" leading: 1 font: "Material Icons Outlined" size: 16 color: white))
          (text fr: 1 wrap: true caption: "soma.dwuir.node.composite" size: 16 font: "IBM Plex Mono" weight: 800 color: white)))
      (hr (oklch 0.35 0 0))
      (padding pl: 10 pr: 10 pb: 10 pt: 10
        (x-wrapped gap-x: 5 gap-y: 3
          (^each (words as word_)
            (^match word
              (when _string (word ^word))
              (when _ ^word)))))))

(suggestion-card/composite) =>
  (suggestion-card
    "The" (code "composite") "node" "lets" "you" "scope" (code "z-index") "," "and" "apply"
    (emphasis "opacity") "to" "any" "of" "children."
    "All" "children" "are" "going" "to" "be" "drawn" "as" "a" "unit," "and" "only"
    "then" "will" (emphasis "opacity") "be" "applied" "to" "them."
    "Using" (code "composite") "is" "therefore" "different" "from" "setting"
    (emphasis "opacity") "of" "each" "individual" "child.")

(figma-card ¦ _ hue_ icon⋮ "icon" title_string subscript_string) =>
  (z-stack z-index: local
    (rect
      z-index: 1
      stroke: (oklch 0.35 0 0)
      thickness-l: 1.5
      thickness-t: 1.5
      thickness-r: 1.5
      thickness-b: 1.5
      radius-tl: 10
      radius-tr: 10
      radius-bl: 10
      radius-br: 10)
    (padding pl: 1 pr: 1 pt: 1 pb: 1
      (y-stack
        (rect fr: 1 radius-tl: 10 radius-tr: 10 up-w: 10 up-h: 10 fill: (oklch 0.2 0.08 ^hue))
        (z-stack z-index: local
          (rect z-index: -1 fill: (oklch 0.25 0 0) stroke: (oklch 0.35 0 0) thickness-t: 1.5 radius-bl: 10 radius-br: 10)
          (padding pl: 8 pr: 8 pt: 10 pb: 10
            (x-stack gap: 10
              (align x: 0.5 y: 0.5
                (text caption: ^icon leading: 1 color: (oklch 0.9 0 0) font: "Material Icons Outlined" size: 20))
              (y-stack fr: 1
                (text caption: ^title font: "IBM Plex Sans" size: 14 color: white)
                (x-stack
                  (text caption: ^subscript font: "IBM Plex Sans" size: 14 color: (oklch 0.8 0 0))))))))))

(wrap-card ¦ _ hue_) =>
  (align x: 0.5 y: 0.5
    (rect
      up-w: 30
      up-h: 30
      thickness-l: 1.5
      thickness-r: 1.5
      thickness-t: 1.5
      thickness-b: 1.5
      radius-tl: 5
      radius-tr: 5
      radius-bl: 5
      radius-br: 5
      stroke: (oklch 0.9 0.15 ^hue)
      fill: (oklch 0.5 0.15 ^hue)))

(wrap-cards mode←(%any x-wrapped y-wrapped)) =>
  (z-stack
    (rect fill: (oklch 0.35 0 0) z-index: -1)
    (padding pl: 10 pr: 10 pt: 10 pb: 10
      (^mode min-span: 2 max-span: 5 gap-x: 5 gap-y: 5
        (wrap-card hue: red)
        (wrap-card hue: green)
        (wrap-card hue: blue)
        (wrap-card hue: crimson)
        (wrap-card hue: violet)
        (wrap-card hue: orange)
        (wrap-card hue: cyan)
        (wrap-card hue: pink))))

(main) =>
  (group
    ;; Banner
    (content root: true dl: 1650
      (padding pl: 10 pr: 10 pt: 10 pb: 10
        (limit max-w: 200
          (z-stack z-index: (local 1000)
            (rect z-index: -1 fill: (oklch 1 0 0 0.8) radius-tl: 10 radius-tr: 10 radius-bl: 10 radius-br: 10)
            (padding pl: 7 pr: 7 pt: 7 pb: 7
              (text wrap: true caption: "This is a static test (result is an image) for UIR & DwUIR. Use Page Up/Page Dn to scroll." font: "IBM Plex Mono" size: 11 color: (oklch 0.2 0 0)))))))

    ;; A regression/z-index/floating test: Branches menu
    ;;
    ;; Reference: https://github.com/
    (content root: true dl: 950 dt: 10
      (padding pl: 10 pr: 10 pt: 10 pb: 10
        (branches-card ((active "alpha") "beta" "gamma" (active "delta") "kappa" "foo" (active "bar")))))

    ;; A regression test: Dashboard design
    ;;
    ;; Reference: https://dribbble.com/shots/25241984-Task-Management-Dashboard
    (content root: true dl: 10 dt: 10
      (limit max-w: 900
        (z-stack z-index: local
          (rect fill: (oklch 0.15 0 0))
          (padding z-index: 1 pl: 15 pr: 15 pt: 15 pb: 15
            (y-stack gap: 15
              (y-stack
                (text caption: "Dashboard" font: "IBM Plex Sans" size: 32 color: (oklch 0.9 0 0))
                (text caption: "Plan, prioritize, and accomplish your tasks with ease." font: "IBM Plex Sans" size: 16 color: (oklch 0.8 0 0)))
              (x-stack gap: 15
                (group fr: 1
                  (stat-card
                    active: true
                    title: "Total projects"
                    stat: "24"
                    badge: (up-badge "5" color: (oklch 0.9665 0.1 143.68))
                    comment: "Increased from last month"))
                (group fr: 1
                  (stat-card
                    title: "Ended projects"
                    stat: "10"
                    badge: (up-badge "6" color: (oklch 0.9665 0.1 143.68))
                    comment: "Increased from last month"))
                (group fr: 1
                  (stat-card
                    title: "Running projects"
                    stat: "12"
                    badge: (up-badge "2" color: (oklch 0.9665 0.1 143.68))
                    comment: "Increased from last month"))
                (group fr: 1
                  (stat-card
                    title: "Pending projects"
                    stat: "2"
                    comment: "On discuss")))
              (x-stack gap: 15
                (people-card fr: 8 title: "Team Collaboration"
                  (person-entry name: "Samantha Doe" avatar: (svg src: (file "data/avatar-girl.svg")) task: "Project Repository" badge: (status-badge "Completed" hue: 143.68))
                  (person-entry name: "John Doe" avatar: (avatar-img src: (file "data/avatar-male1-32.jpg")) task: "Auth" badge: (status-badge "Pending" hue: 0))
                  (person-entry name: "Sarah Doe" avatar: (avatar-img src: (file "data/avatar-female1-32.jpg")) task: "UX design" badge: (status-badge "In Progress" hue: 70))
                  (person-entry name: "Kate Doe" avatar: (avatar-img src: (file "data/avatar-female2-32.jpg")) task: "Admin Panel"))
                (group fr: 4
                  (projects-card))))))))

    ;; Test x-wrap with a text-like example.
    (content root: true dl: 950 dt: 400
      (x-wrapped gap-x: 30
        (limit max-w: 200 (suggestion-card/composite))
        (limit dt: -20 max-w: 250 (suggestion-card/composite))
        (limit dt: -40 max-w: 400 (suggestion-card/composite))))

    ;; Test x-wrap with a cards example.
    ;;
    ;; Reference: https://figma.com
    (content root: true dl: 10 dt: 1000
      (limit max-w: 850
        (z-stack z-index: local
          (rect z-index: -1 fill: (oklch 0.2 0 0))
          (padding pl: 20 pr: 20 pt: 20 pb: 20
            (y-stack gap: 10
              (text caption: "Cards" font: "IBM Plex Sans" size: 32 color: white)
              (x-wrapped gap-x: 30 gap-y: 30
                ;; Make these fr: 1 so that they share the first row.
                (align fr: 1 x: 0.5 y: 0.5
                  (limit min-w: 300 max-w: 300 min-h: 200
                    (figma-card hue: red title: "Untitled 1" subscript: "Drafts · Edited 2 hours ago")))
                (align fr: 1 x: 0.5 y: 0.5
                  (limit min-w: 300 max-w: 300 min-h: 200
                    (figma-card hue: green title: "Untitled 2" subscript: "Drafts · Edited 3 hours ago")))
                (limit min-w: 300 max-w: 300 min-h: 200
                  (figma-card hue: blue title: "Untitled 3" subscript: "Drafts · Edited 4 hours ago"))
                (limit min-w: 300 max-w: 300 min-h: 200
                  (figma-card hue: orange title: "Untitled 4" subscript: "Drafts · Edited 5 hours ago"))
                (limit min-w: 300 max-w: 300 min-h: 200
                  (figma-card hue: violet title: "Untitled 5" subscript: "Drafts · Edited 6 hours ago"))))))))

    ;; Test x-wrap with min-span and max-span.
    (content root: true dl: 900 dt: 1000
      (y-stack gap: 20
        (y-stack
          (text shrink: true wrap: true caption: "NOTE: Since max-span: 5, only 5 cards are going to be placed on the main axis" font: "IBM Plex Sans" size: 11 color: (oklch 0.8 0 0))
          (limit min-w: 500 (wrap-cards x-wrapped)))
        (limit min-w: 300 (wrap-cards x-wrapped))
        (limit max-w: 150 (wrap-cards x-wrapped))
        (limit max-w: 100 (wrap-cards x-wrapped))
        (y-stack
          (text wrap: true caption: "NOTE: This is expected to overflow since min-span: 2" font: "IBM Plex Sans" size: 11 color: (oklch 0.8 0 0))
          (limit max-w: 50 (wrap-cards x-wrapped)))))

    ;; Test y-wrap with min-span and max-span.
    (content root: true dl: 1500 dt: 800
      (y-stack gap: 20
        (y-stack
          (text shrink: true wrap: true caption: "NOTE: Since max-span: 5, only 5 cards are going to be placed on the main axis" font: "IBM Plex Sans" size: 11 color: (oklch 0.8 0 0))
          (limit min-h: 500 (wrap-cards y-wrapped)))
        (limit min-h: 300 (wrap-cards y-wrapped))
        (limit max-h: 150 (wrap-cards y-wrapped))
        (limit max-h: 100 (wrap-cards y-wrapped))
        (y-stack
          (text wrap: true caption: "NOTE: This is expected to overflow since min-span: 2" font: "IBM Plex Sans" size: 11 color: (oklch 0.8 0 0))
          (limit max-h: 50 (wrap-cards y-wrapped)))))

    ;; Test x-wrap and y-wrap alongside each other.
    (content root: true dl: 1100 dt: 1300
      (x-stack gap: 30
        (limit max-w: 100 max-h: 100
          (x-wrap gap-x: 5 gap-y: 5
            nodes:
             ((rect up-w: 30 up-h: 30 fill: red)
              (rect up-w: 30 up-h: 30 fill: green)
              (rect up-w: 30 up-h: 30 fill: blue)
              (rect up-w: 30 up-h: 30 fill: violet)
              (rect up-w: 30 up-h: 30 fill: pink)
              (rect up-w: 30 up-h: 30 fill: yellow)
              (rect up-w: 30 up-h: 30 fill: darkorange))))
        (limit max-w: 100 max-h: 100
          (y-wrap gap-x: 5 gap-y: 5
            nodes:
             ((rect up-w: 30 up-h: 30 fill: red)
              (rect up-w: 30 up-h: 30 fill: green)
              (rect up-w: 30 up-h: 30 fill: blue)
              (rect up-w: 30 up-h: 30 fill: violet)
              (rect up-w: 30 up-h: 30 fill: pink)
              (rect up-w: 30 up-h: 30 fill: yellow)
              (rect up-w: 30 up-h: 30 fill: darkorange))))))
)

title2: "Untitled"
width2: 1900
height2: 1000
content-w2: 1900
content-h2: 2500 ;; < approximately
fill2: (oklch 0.13 0 0)

(^match uir2ppm
  (when true (main))
  (when _
    (viewport final-w: 1900 final-h: 1000 pan-t: (^verbatim ^(- 0 page))
      (main))))

