      final-h: 40
      font: "IBM Plex Serif"
      size: 13
      wrap: true
      color: (oklch 1.0 0 0)
      z-index: 1)
    (rect
      final-w: 50
      final-h: 50
      fill: (oklch 0.505 0.05 150)
      stroke: (oklch 0.2 0.05 150)
      thickness-l: 5
      thickness-r: 5
      thickness-t: 5
      thickness-b: 5
      radius-tl: 2
      radius-tr: 20
      radius-bl: 5
      radius-br: 0)))

;; transparent fill with border -- must draw a ring
(group dl: 650 dt: 10
  (rect
    thickness-l: 10
    thickness-r: 10
    thickness-t: 10
    thickness-b: 10
    radius-tl: 10
    radius-tr: 20
    radius-bl: 0
    radius-br: 5
    stroke:
      (linear-gradient begin-x: 0.5
                       begin-y: 0
                       end-x: 0.8
                       end-y: 1
        (stop 0 (oklch 0.5 0.1 150))
        (stop 1 (oklch 0.6 0.09 250)))
    final-w: 100
    final-h: 100
    z-index: 10)
  (rect
    dl: 40
    dt: 40
    fill: (image/base64
    ""
    )
    final-w: 24
    final-h: 24
    z-index: 0))

