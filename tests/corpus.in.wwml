;; Draw a clock to test relative dl/dt, pivot, origin.
(group dl: 800 dt: 800 final-w: 100 final-h: 100
  (rect
    final-w: 100
    final-h: 100
    radius-tl: (* 1)
    radius-tr: (* 1)
    radius-bl: (* 1)
    radius-br: (* 1)
    fill: (oklch 0.8 0 0)
    z-index: 0)
  (rect
    dl: (* 0.5)
    dt: (* 0.5)
    final-w: 10
    final-h: 10
    origin: true
    origin-l: 0.5
    origin-t: 0.5
    radius-tl: (* 1)
    radius-tr: (* 1)
    radius-bl: (* 1)
    radius-br: (* 1)
    fill: (oklch 0.9 0 0)
    z-index: 10)
  (rect
    dl: (* 0.5)
    dt: (* 0.5)
    pivot: true
    pivot-t: 1.0
    origin: true
    origin-l: 0.5
    origin-t: 1.0
    angle: 250
    final-w: 3
    final-h: 40
    fill: (oklch 0.5 0.2 0 0.5)
    z-index: 1)
  (rect
    dl: (* 0.5)
    dt: (* 0.5)
    pivot: true
    pivot-t: 1.0
    origin: true
    origin-l: 0.5
    origin-t: 1.0
    angle: 0
    final-w: 3
    final-h: 40
    fill: (oklch 0.5 0.2 150 0.5)
    z-index: 1)
  (rect
    dl: (* 0.5)
    dt: (* 0.5)
    pivot: true
    pivot-t: 1.0
    origin: true
    origin-l: 0.5
    origin-t: 1.0
    angle: 80
    final-w: 4
    final-h: 40
    fill: (oklch 0 0 0 0.5)
    z-index: 2))

