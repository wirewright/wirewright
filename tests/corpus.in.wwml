;; frag
(group
  (d7
    ((frag @qux)
     (changes @qux to @quxes)
     (absence @quxes as "Qux is absent!!" to @-quxes)
     (log @quxes in ())
     (log @-quxes in ())
     (delay 1 (event (assign @qux (delay 1 (event (assign @qux "Hello World")))))))
    ((frag "Hello World" @qux)
     (changes @qux to @quxes)
     (absence @quxes as "Qux is absent!!" to @-quxes)
     (log @quxes in ((delay 1 (event (assign @qux "Hello World")))
                     (delay 0 (event (assign @qux "Hello World")))
                     (event (assign @qux "Hello World"))
                     "Hello World"))
     (log @-quxes in ("Qux is absent!!"))))
  ;; Smart subsume should try to stay away from fragment if possible
  (d7
    ((frag ("" | "" () @user) @qux)
     ("" | "" () @user)
     (event (edit @user (input "Hi"))))
    ((frag ("" | "" () @user) @qux)
     ("Hi" | "" () @user)))
  ;; But if there is no choice, it must enter
  (d7
    ((frag ("" | "" () @user) @qux)
     (event (edit @user (input "Hi"))))
    ((frag ("Hi" | "" () @user) @qux)))
  ;; Fragment must be able to observe delays
  (d7
    ((frag (delay 10) @qux)
     (changes @qux to @quxes)
     (log @quxes in () limit: 11))
    ((frag @qux)
     (changes @qux to @quxes)
     (log @quxes in limit: 11
       ((delay 10)
        (delay 9)
        (delay 8)
        (delay 7)
        (delay 6)
        (delay 5)
        (delay 4)
        (delay 3)
        (delay 2)
        (delay 1)
        (delay 0)))))
  ;; Fragment must be able to observe cursor motions
  (d7
    ((frag ("" | "" () @user) @qux)
     (changes @qux to @quxes)
     (log @quxes in ())
     (delay 0 (event (edit @user (input "H"))))
     (delay 1 (event (edit @user (input "e"))))
     (delay 2 (event (edit @user (input "l"))))
     (delay 3 (event (edit @user (input "l"))))
     (delay 4 (event (edit @user (input "o")))))
    ((frag ("Hello" | "" () @user) @qux)
     (changes @qux to @quxes)
     (log @quxes in
       (("" | "" () @user)
        ("H" | "" () @user)
        ("He" | "" () @user)
        ("Hel" | "" () @user)
        ("Hell" | "" () @user)
        ("Hello" | "" () @user)))))
  ;; Fragment must accept clear feedback to clear itself
  (d7
    ((frag "hello" @qux)
     (event (pulse @qux clear)))
    ((frag @qux)))
  ;; Fragment must accept destroy feedback to destroy itself
  (d7
    ((frag "hello" @qux)
     (event (pulse @qux destroy)))
    ()))

;; Button #shadow behavior
(d7
  ((button (feedback busy @foos) to @foos ((press)))
   ("" | "" () @user)
   (delay 1 (event (edit @user (key left))))
   (delay 2 (event (edit @user (key C-backspace))))
   (delay 3 (event (edit @user (key C-backspace))))
   (delay 4 (event (edit @user (key C-backspace))))
   (delay 5 (event (edit @user (key C-backspace))))
   (delay 6 (event (edit @user (key C-backspace))))
   (delay 7 (event (edit @user (key C-backspace))))
   (echo @foos))
  (("" | "" () @user)
   (echo @foos)))

;; initial
(group
  (d7
    ((cell 0 @count)
     ("" | "" () @user)
     (initial @count to @messages)
     (absence @count as "Missing" to @messages)
     (log @messages in ())
     (delay 1 (event (edit @user (key left))))
     (delay 2 (event (edit @user (key right))))
     (delay 3 (event (edit @user (key left))))
     (delay 4 (event (edit @user (key right)))))
    ((cell 0 @count)
     ("" | "" () @user)
     (initial @count to @messages)
     (absence @count as "Missing" to @messages)
     (log @messages in (0 "Missing" 0 "Missing" 0))))
  (d7
    ((cell @count)
     (initial @count to @messages)
     (absence @count as "Missing" to @messages)
     (latest @counts @count)
     (log @messages in ())
     (delay 1 (event (pulse @counts 0)))
     (delay 2 (event (pulse @counts 1)))
     (delay 3 (event (pulse @counts 2))))
    ((cell 2 @count)
     (initial @count to @messages)
     (absence @count as "Missing" to @messages)
     (latest @counts @count)
     (log @messages in ("Missing" 0)))))

;; mutation (self: prop)
(group
  (d7
    ((group (delay 2: (event (pulse @commands (it_ {it: "Bye World"})))) self: @commands)
     ;; "group where the first child is missing key 1"
     (event (pulse @commands ([group {¦ 1: (%- _ t) }] {t: 1}))))
    ("Bye World"))

  (d7
    ((transform (@foos to @bars) (+ _ 1) self: @tfs)
     (log @bars in ())
     (delay 0 (event (pulse @foos 100)))
     (delay 1 (event (pulse @tfs ([transform (@src_ to @_) _] {src: @quxes}))))
     (delay 2 (event (pulse @quxes 200))))
    ((transform (@quxes to @bars) (+ _ 1) self: @tfs)
     (log @bars in (101 201))))

  ;; FIXME
  (d7
    ((decay 10 (p "Hello World") inbox: (a b c) mail: @mailout)
     (log @mailout in ()))
    ((p "Hello World")
     (log @mailout in ((mail a) (mail b) (mail c)))))

  ;; FIXME
  (d7
    ((log @quxes in () self: @quxes)
     (event (pulse @quxes (x_ {x: 100}))))
    (100)))

;; bridge
(group
  (d7
    ((bridge @xs to @ys)
     (log @ys in ())
     (delay 0 (event (pulse @xs 1)))
     (delay 1 (event (pulse @xs 2)))
     (delay 2 (event (pulse @xs 3)))
     (delay 3 (event (pulse @xs 4)))
     (delay 4 (event (pulse @xs 5))))
    ((bridge @xs to @ys)
     (log @ys in (1 2 3 4 5))))
  (d7
    ((bridge @xs as "Hello" to @ys)
     (log @ys in ())
     (delay 0 (event (pulse @xs 1)))
     (delay 1 (event (pulse @xs 2)))
     (delay 2 (event (pulse @xs 3)))
     (delay 3 (event (pulse @xs 4)))
     (delay 4 (event (pulse @xs 5))))
    ((bridge @xs as "Hello" to @ys)
     (log @ys in ("Hello" "Hello" "Hello" "Hello" "Hello"))))
  (d7
    ((bridge (@xs (%pipe (mod 2) 0)) to @ys)
     (log @ys in ())
     (delay 0 (event (pulse @xs 1)))
     (delay 1 (event (pulse @xs 2)))
     (delay 2 (event (pulse @xs 3)))
     (delay 3 (event (pulse @xs 4)))
     (delay 4 (event (pulse @xs 5))))
    ((bridge (@xs (%pipe (mod 2) 0)) to @ys)
     (log @ys in (2 4))))
  (d7
    ((bridge (@xs (x_ y_)) to (@ys y))
     (log @ys in ())
     (delay 0 (event (pulse @xs (a 1))))
     (delay 1 (event (pulse @xs (b 2))))
     (delay 2 (event (pulse @xs (c 3))))
     (delay 3 (event (pulse @xs (d 4))))
     (delay 4 (event (pulse @xs (e 5)))))
    ((bridge (@xs (x_ y_)) to (@ys y))
     (log @ys in (1 2 3 4 5))))
  (d7
    ((bridge (@xs ⟨foo y_⟩°) to (@ys y))
     (log @ys in ())
     (event (pulse @xs (foo 1 bar 2 foo 3 baz 4 foo 5 foo 6 7))))
    ((bridge (@xs ⟨foo y_⟩°) to (@ys y))
     (log @ys in (1 3 5 6)))))

;; alloy
(group
  ;; Weakest variant
  (d7
    ((alloy (@envs to @instances) (^a ^b ^c))
     (log @instances in ())
     (delay 0 (event (pulse @envs qux)))
     (delay 1 (event (pulse @envs {a: 100})))
     (delay 2 (event (pulse @envs {a: 100, b: 200, c: 300}))))
    ((alloy (@envs to @instances) (^a ^b ^c))
     (log @instances in ((^a ^b ^c) (100 ^b ^c) (100 200 300)))))
  ;; With strict: true it won't generate if something is missing
  (d7
    ((alloy (@envs to @instances) (^a ^b ^c) strict: true)
     (log @instances in ())
     (delay 0 (event (pulse @envs qux)))
     (delay 1 (event (pulse @envs {a: 100})))
     (delay 2 (event (pulse @envs {a: 100, b: 200, c: 300}))))
    ((alloy (@envs to @instances) (^a ^b ^c) strict: true)
     (log @instances in ((100 200 300)))))
  ;; With complaints: @pout it will send complaints there but still generate.
  (d7
    ((alloy (@envs to @instances) (^a ^b ^c) complaints: @complaints)
     (log @complaints in ())
     (log @instances in ())
     (delay 0 (event (pulse @envs qux)))
     (delay 1 (event (pulse @envs {a: 100})))
     (delay 2 (event (pulse @envs {a: 100, b: 200, c: 300}))))
    ((alloy (@envs to @instances) (^a ^b ^c) complaints: @complaints)
     (log @complaints in
       ("variable 'c' does not exist"
        "variable 'b' does not exist"
        "variable 'a' does not exist"
        "variable 'c' does not exist"
        "variable 'b' does not exist"))
     (log @instances in ((^a ^b ^c) (100 ^b ^c) (100 200 300)))))
  ;; With both it won't generate and also send complaints
  (d7
    ((alloy (@envs to @instances) (^a ^b ^c) complaints: @complaints strict: true)
     (log @complaints in ())
     (log @instances in ())
     (delay 0 (event (pulse @envs qux)))
     (delay 1 (event (pulse @envs {a: 100})))
     (delay 2 (event (pulse @envs {a: 100, b: 200, c: 300}))))
    ((alloy (@envs to @instances) (^a ^b ^c) complaints: @complaints strict: true)
     (log @complaints in
       ("variable 'c' does not exist"
        "variable 'b' does not exist"
        "variable 'a' does not exist"
        "variable 'c' does not exist"
        "variable 'b' does not exist"))
     (log @instances in ((100 200 300)))))
  ;; We can use fallback on the alloy side as well, perhaps in combination so that
  ;; there is always something up-to-date to display.
  (d7
    ((alloy (@envs to @instances) (^fallback (^a ^b ^c) "missing or invalid data"))
     (log @instances in ())
     (delay 0 (event (pulse @envs qux)))
     (delay 1 (event (pulse @envs {a: 100})))
     (delay 2 (event (pulse @envs {a: 100, b: 200, c: 300}))))
    ((alloy (@envs to @instances) (^fallback (^a ^b ^c) "missing or invalid data"))
     (log @instances in ("missing or invalid data" "missing or invalid data" (100 200 300)))))
  ;; Ability to pass const as template
  (d7
    ((alloy (@envs to @instances) @template)
     (alloy (@envs to @instances) @missing)
     (cell (^a ^b ^c) @template)
     (log @instances in ())
     (event (pulse @envs {a: 100, b: 200, c: 300})))
    ((alloy (@envs to @instances) @template)
     (alloy (@envs to @instances) @missing)
     (cell (^a ^b ^c) @template)
     (log @instances in ((100 200 300)))))
  ;; More complex template
  (d7
    ((alloy (@todos/newest to @views)
       (group style: "min-w-sm max-w-2xl flow-col"
         (^each (todos as {¦ title_string body_string})
           (group style: "w-max m-5 bg-neutral-800 p-3 border border-neutral-700 flow-col gap-1 rounded-lg"
             (p ^title style: "w-max text-lg font-bold")
             (p ^body style: "w-max")))))
     (cell
       {todos: ({title: "A", body: "Lorem ipsum"},
                {title: "B", body: "Dolor sit"},
                {title: "C", body: "Sit amet"})}
       @todos)
     (changes @todos to @todos/newest)
     (log @views in ()))
    ((alloy (@todos/newest to @views)
       (group style: "min-w-sm max-w-2xl flow-col"
         (^each (todos as {¦ title_string body_string})
           (group style: "w-max m-5 bg-neutral-800 p-3 border border-neutral-700 flow-col gap-1 rounded-lg"
             (p ^title style: "w-max text-lg font-bold")
             (p ^body style: "w-max")))))
     (cell
       {todos: ({title: "A", body: "Lorem ipsum"},
                {title: "B", body: "Dolor sit"},
                {title: "C", body: "Sit amet"})}
       @todos)
     (changes @todos to @todos/newest)
     (log @views in
       ((group style: "min-w-sm max-w-2xl flow-col"
          (group style: "w-max m-5 bg-neutral-800 p-3 border border-neutral-700 flow-col gap-1 rounded-lg"
            (p "A" style: "w-max text-lg font-bold")
            (p "Lorem ipsum" style: "w-max"))
          (group style: "w-max m-5 bg-neutral-800 p-3 border border-neutral-700 flow-col gap-1 rounded-lg"
            (p "B" style: "w-max text-lg font-bold")
            (p "Dolor sit" style: "w-max"))
          (group style: "w-max m-5 bg-neutral-800 p-3 border border-neutral-700 flow-col gap-1 rounded-lg"
            (p "C" style: "w-max text-lg font-bold")
            (p "Sit amet" style: "w-max"))))))))

;; changes/view
(group
  ;; Assign
  (d7
    ((changes/view @v)
     (event (assign @v "hello")))
    ((changes/view "hello" @v)))
  ;; Update
  (d7
    ((changes/view "hello" @v)
     (event (assign @v "world")))
    ((changes/view "world" @v)))
  ;; Clear
  (d7
    ((changes/view "hello" @v)
     (event (pulse @v clear)))
    ((changes/view @v)))
  ;; Destroy
  (d7
    ((changes/view "hello" @v)
     (changes/view @v)
     (event (pulse @v destroy)))
    ())
  ;; Cell created
  (d7
    ((changes/view @v)
     (cell "hello" @v))
    ((changes/view "hello" @v)
     (cell "hello" @v)))
  (d7
    ((changes/view "world" @v)
     (cell "hello" @v))
    ((changes/view "hello" @v)
     (cell "hello" @v)))
  ;; Cell changed
  (d7
    ((changes/view @v)
     (cell "hello" @v)
     (delay 1 (event (assign @v "world"))))
    ((changes/view "world" @v)
     (cell "world" @v)))
  ;; Cell removed
  (d7
    ((changes/view @v)
     (decay 1 (cell "hello" @v)))
    ((changes/view @v))))

;; sampler
(d7
  ((cell 0 @x)
   (cell @y)
   (sampler @x on @quxes to @xs)
   (sampler @y on @quxes to @ys)
   (sampler (@x @y) on @quxes to @zs)
   (event (pulse @quxes 123))
   (delay 1
     (cell 100 @y)
     (event (pulse @quxes 123)))
   (log @xs in ())
   (log @ys in ())
   (log @zs in ()))
  ((cell 0 @x)
   (cell 100 @y)
   (sampler @x on @quxes to @xs)
   (sampler @y on @quxes to @ys)
   (sampler (@x @y) on @quxes to @zs)
   (cell 100 @y)
   (log @xs in (0 0))
   (log @ys in (100))
   (log @zs in ((0 100)))))

;; spawner
(group
  (d7
    ((spawner @nodes)
     (spawner @nodes dir: up)
     (spawner @nodes dir: down)
     (spawner @nodes dir: qux)
     (event (pulse @nodes hello)))
    (hello
     (spawner @nodes)
     hello
     (spawner @nodes dir: up)
     (spawner @nodes dir: down)
     hello
     (spawner @nodes dir: qux)))
  (d7
    ((spawner @nodes)
     (event (pulse @nodes (cell 0 @x)))
     (changes @x to @xs)
     (log @xs in ()))
    ((cell 0 @x)
     (spawner @nodes)
     (changes @x to @xs)
     (log @xs in (0)))))

;; module
(group
  (d7
    ((group exposes: ()
       (cell 0 @x)
       (changes @x to @xs)
       (absence @x as "Missing" to @xs)
       (initial (@x to @xs))
       (log @xs in ()))
     (changes @x to @xs)
     (absence @x as "Missing" to @xs)
     (initial (@x to @xs))
     (log @xs in ()))
    ((group exposes: ()
       (cell 0 @x)
       (changes @x to @xs)
       (absence @x as "Missing" to @xs)
       (initial (@x to @xs))
       (log @xs in (0)))
     (changes @x to @xs)
     (absence @x as "Missing" to @xs)
     (initial (@x to @xs))
     (log @xs in ("Missing"))))
  (d7
    ((group exposes: (@in @out)
       (transform (@in x_number to @xs) (* x x))
       (bridge @xs to @out))
     (log @xs in ())
     (log @in in ())
     (log @out in ())
     (event (pulse @in 4)))
    ((group exposes: (@in @out)
       (transform (@in x_number to @xs) (* x x))
       (bridge @xs to @out))
     (log @xs in ())
     (log @in in (4))
     (log @out in (16))))
  (d7
    ((group exposes: (@x)
       (cell 0 @x)
       (changes @x to @xs)
       (absence @x as "Missing" to @xs)
       (initial (@x to @xs))
       (log @xs in ()))
     (changes @x to @xs)
     (absence @x as "Missing" to @xs)
     (initial (@x to @xs))
     (log @xs in ()))
    ((group exposes: (@x)
       (cell 0 @x)
       (changes @x to @xs)
       (absence @x as "Missing" to @xs)
       (initial (@x to @xs))
       (log @xs in (0)))
      (changes @x to @xs)
      (absence @x as "Missing" to @xs)
      (initial (@x to @xs))
      (log @xs in (0))))
  (d7
    ((group exposes: () (cell 0 @x))
     (cell 0 @x)
     (event (assign @x 100)))
    ((group exposes: () (cell 0 @x))
     (cell 100 @x)))
  (d7
    ((group exposes: (@in @out)
       (transform (@in (foo x_) to @xs) x)
       (transform (@xs to @out) (foo/seen _)))
     (group exposes: (@in @out)
       (transform (@in (bar x_) to @xs) x)
       (transform (@xs to @out) (bar/seen _)))
     (group exposes: (@in @out)
       (transform (@in (baz x_) to @xs) x)
       (transform (@xs to @out) (baz/seen _)))
     (delay 0 (event (pulse @in (foo 123))))
     (delay 1 (event (pulse @in (bar 456))))
     (delay 2 (event (pulse @in (baz 789))))
     (log @out in ()))
    ((group exposes: (@in @out)
       (transform (@in (foo x_) to @xs) x)
       (transform (@xs to @out) (foo/seen _)))
     (group exposes: (@in @out)
       (transform (@in (bar x_) to @xs) x)
       (transform (@xs to @out) (bar/seen _)))
     (group exposes: (@in @out)
       (transform (@in (baz x_) to @xs) x)
       (transform (@xs to @out) (baz/seen _)))
     (log @out in ((foo/seen 123) (bar/seen 456) (baz/seen 789)))))
  ;; We do not leak when being edited
  (d7
    ((group (cell 0 @count) exposes: ("" | "" () @user))
     (changes @count to @counts)
     (log @counts in ()))
    ((group (cell 0 @count) exposes: ("" | "" () @user))
     (changes @count to @counts)
     (log @counts in ()))))

;; Make sure module deduplication works as it should

(d7
  ((group #module: foo exposes: ()
    (cell 100 @x)
    (changes @x to @xs)
    (log @xs in ()))
   (group #module: foo exposes: ()
    (cell 200 @x)
    (changes @x to @xs)
    (log @xs in ())))
  ((group exposes: ()
    (cell 100 @x)
    (changes @x to @xs)
    (log @xs in (100)))
   (group exposes: ()
    (cell 200 @x)
    (changes @x to @xs)
    (log @xs in (200)))))

;; TODO: add more module tests, this is an especially important bit of machinery!!!

;; Passable spots must be disabled while pairspart is modified by a cursor.
(d7
  ((decay 10 qux: ("" | "" () @user)))
  ((decay 10 qux: ("" | "" () @user))))

;; But they should be enabled if the cursor is in shadow pairspart.
(d7
  ((decay 10 #qux: ("" | "" () @user)))
  ())


title: "Hello DwUIR"
