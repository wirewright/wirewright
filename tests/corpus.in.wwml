;; Linear gradient
;; Linear gradient paint on text, selection rect, underline.
;;
;; FIXME: for text and underline, gradients must be generated for
;; that text's tfbounds box! Right now we're painting each individual
;; frag (or continuous segments thereof); and each frag's underline
;; individually. This is wrong for anything except solid color.
(group dl: 1000 dt: 300
  (rect
    radius-tl: 10
    radius-tr: 10
    radius-bl: 10
    radius-br: 10
    fill:
      (linear-gradient begin-l: 0
                       begin-t: 0.5
                       end-l: 1
                       end-t: 0.5
        (stop 0 (oklch 0.5 0.2 0))
        (stop 0.3 (oklch 0.5 0.2 100))
        (stop 0.5 (oklch 0.5 0.2 150))
        (stop 0.8 (oklch 0.5 0.2 200))
        (stop 1.0 (oklch 0.5 0.2 300)))
    final-w: 150
    final-h: 30)
  (group dt: 50
    (text
      caption: "Hello World"
      font: "IBM Plex Mono"
      color:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      size: 18
      wrap: true
      wrap-on-words: false
      z-index: 1
      final-w: 200
      final-h: 100))
  (group dt: 80
    (text
      caption: "Hello World"
      font: "IBM Plex Sans"
      selection: true
      selection-anchor: 5
      selection-span: 0
      selection-fill:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      size: 18
      wrap: true
      wrap-on-words: false
      z-index: 1
      final-w: 200
      final-h: 100))
  (group dt: 110
    (text
      caption: "Hello World"
      font: "IBM Plex Sans"
      selection-radius: 5
      selection: true
      selection-anchor: 3
      selection-span: 7
      selection-fill:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      size: 18
      wrap: true
      wrap-on-words: false
      z-index: 1
      final-w: 200
      final-h: 100))
  (group dt: 140
    (text
      caption: "Hello World"
      font: "IBM Plex Sans"
      selection-radius: 5
      selection: true
      selection-anchor: 3
      selection-span: 7
      selection-gap: 0.5
      selection-fill:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      size: 18
      underline: true
      underline-offset: 7
      underline-thickness: 3
      underline-color:
        (linear-gradient begin-l: 0
                         begin-t: 0.5
                         end-l: 1
                         end-t: 0.5
          (stop 0 (oklch 0.5 0.2 0))
          (stop 0.3 (oklch 0.5 0.2 100))
          (stop 0.5 (oklch 0.5 0.2 150))
          (stop 0.8 (oklch 0.5 0.2 200))
          (stop 1.0 (oklch 0.5 0.2 300)))
      wrap: true
      wrap-on-words: false
      z-index: 1
      final-w: 200
      final-h: 100)))

;; Radial gradient "cursor"
(rect
  dl: ^mouse-x
  dt: ^mouse-y
  final-w: 300
  final-h: 300
  z-index: 100
  origin: true
  origin-l: 0.5
  origin-t: 0.5
  fill:
    (radial-gradient
      center-radius: 0.5
      focus-radius: 0.1
      (stop 0 (oklch 0.3 0 0 0.9))
      (stop 0.5 (oklch 0.5 0 0 0.5))
      (stop 1 (oklch 0 0 0 0))))

;; Radial gradient paint on text, rounded rect, selection rect, underline.

;; Image paint
(group dl: 1080 dt: 180
  ;; fit: default
  (group
    (text
      caption: "fit: stretch"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill: (image (file "data/214-500x400.jpg"))
      radius-tl: 10
      radius-br: 10
      final-w: 100
      final-h: 100))
  ;; fit: match origin
  (group dl: 120
    (text
      caption: "fit: origin"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill:
        (image fit: (align)
          (file "data/214-500x400.jpg"))
      final-w: 100
      final-h: 100))
  ;; fit: align centers
  (group dl: 240
    (text
      caption: "fit: center"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill:
        (image fit: (align l: 0.5 t: 0.5)
          (file "data/214-500x400.jpg"))
      final-w: 100
      final-h: 100))
  ;; fit: align bottom right
  (group dl: 120 dt: -110
    (text
      caption: "fit: bottom-right"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill:
        (image fit: (align l: 1 t: 1)
          (file "data/214-500x400.jpg"))
      final-w: 100
      final-h: 100))
  ;; fit: pan
  (group dl: 240 dt: -110
    (text
      caption: "fit: pan"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      final-w: 100
      final-h: 30)
    (rect
      fill:
        (image fit: (pan l: -100 t: -100)
          (file "data/214-500x400.jpg"))
      final-w: 100
      final-h: 100))
  ;; fit: align, tile, resize
  (group dl: 360
    (text
      caption: "fit: tile"
      font: "IBM Plex Mono"
      size: 11
      z-index: 1
      dt: 110
      final-w: 100
      final-h: 30)
    (rect
      fill: (image fit: (align)
                   tile: true
                   resize-w: 32
                   resize-h: 32
        (file "data/soma-256x256-white.png"))
      final-w: 100
      final-h: 100))
  ;; Show logo
  (group dl: 360 dt: -110
    (rect
      z-index: 1
      fill: (image fit: (align l: 0.5 t: 0.5)
                   resize-w: (= 64)
                   resize-h: (= 64)
                   opacity: 0.8
        (file "data/soma-256x256-white.png"))
      final-w: 100
      final-h: 100)
    (rect
      fill:
        (radial-gradient
          center-radius: 3.5
          focus-radius: 0
          (stop 0 (oklch 0 0 0))
          (stop 1 (oklch 1 0 0)))
      final-w: 100
      final-h: 100)))

;; Image paint on text, rounded rect, selection, underline.

;; Essential viewport: pan, zoom
(viewport zoom: 2.3 final-w: 100 final-h: 100 pan-l: 10 pan-t: -10 dl: 950 dt: 800
  (text caption: "Lorem\n\nipsum"
    font: "IBM Plex Sans"
    size: 14
    z-index: 1
    color: (oklch 0.5 0.3 0)
    final-w: 500
    final-h: 500
    leading: 1.5
    tracking: 0.3
    selection: true
    selection-anchor: 12
    selection-span: -12
    selection-color: (oklch 1.0 0 0)
    selection-fill: (oklch 0.6 0.3 250)
    wrap: true))

;; Rotate within viewport
(group dl: 900 dt: 600 final-w: 300 final-h: 100
  (rect z-index: 0 final-w: 300 final-h: 100 fill: (oklch 0.8 0 0))
  (viewport zoom: 1.5 pan-l: 0 pan-t: 0 final-w: 300 final-h: 100
    (group final-w: 300 final-h: 100 pivot: true angle: -10
      (rect
        fill: (oklch 0.8 0.05 0)
        final-w: 300
        final-h: 100
        z-index: 10)

      (text
        caption: "MuSoma"
        font: "IBM Plex Sans"
        weight: 900
        size: 24
        underline: true
        selection: true
        selection-anchor: 6
        selection-span: -5
        selection-fill: (hsl 163.72 0.39 0.51)
        underline-offset: 15
        final-w: 300
        final-h: 100
        z-index: 100
        opacity: 1.0
        color: (oklch 0.5 0.1 250)))))

