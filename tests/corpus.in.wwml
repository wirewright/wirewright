;; [ ] rect: borders with same radius
;; [ ] text
;;   dl[x], dt[x], final-w[x], final-h[x], caption[x], font[x], size[x], weight[x], leading[x], tracking[ ], color[x]
;;   selection[x]
;;     anchor[x] span[x] fill[x] color[x]
;;     FIXME: minor floating point related(?) positioning bugs (esp. visible when zooming in on selection)
;;   PERF: glyph cache [ ]
;; [ ] circle
;; [ ] triangle
;; [ ] layer
;; [x] parent dl, dt
;; [x] viewport zoom[x] pan[x] dl/dt[x] clip[x]
;; [ ] PERF: subtree / node cache

