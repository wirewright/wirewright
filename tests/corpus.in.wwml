;; lookaround node

(d7
  (foo
   bar
   (group
     a
     b
     (lookaround @views @refresh
       (transform (@views (view_ _) to @behind) view)
       (transform (@views (_ view_) to @ahead) view)
       (cell @behind)
       (cell @ahead)
       (latest @behind @behind)
       (latest @ahead @ahead)
       (button "Refresh lookaround" to @refresh ((press))))
     c
     (+ 1 2)
     d)
    baz
    qux)
  (foo
   bar
   (group
     a
     b
     (lookaround @views @refresh
       (transform (@views (view_ _) to @behind) view)
       (transform (@views (_ view_) to @ahead) view)
       (cell (a b) @behind)
       (cell (c (+ 1 2) d) @ahead)
       (latest @behind @behind)
       (latest @ahead @ahead)
       (button "Refresh lookaround" to @refresh ()))
     c
     (+ 1 2)
     d)
   baz
   qux))

;; lookaround movement

;; target above
(d7 limit: 256
  (a
   b
   c
   target
   d
   e
   f
   (lookaround @views @relook
     ("" | "" () @cursor)
     (periodic (pulse @relook true))
     (match (@views to @decisions)
       (((_* target) _) eat-behind)
       ((⟨target⟩ _) go-behind)
       ((_ (target _*)) eat-ahead)
       ((_ ⟨target⟩) go-ahead))
     (transform (@decisions eat-behind to @sequences)
       ((key home) (key left) (key C-backspace) (key right) (key down) (key down) (key down) (key down)))
     (transform (@decisions eat-ahead to @sequences)
       ((key end) (key right) (key C-delete) (key left) (key home) (key down) (key down) (key down) (key down)))
     (transform (@decisions go-behind to @cursor-commands) (move-parent-behind))
     (transform (@decisions go-ahead to @cursor-commands) (move-parent-ahead))
     (blast @sequences to @cursor-commands)
     (edit-cast @cursor-commands to @cursor))
   foo
   bar
   baz)
  (a
   b
   c
   (lookaround @views @relook
     ("" | "" () @cursor)
     (periodic (pulse @relook true))
     (match (@views to @decisions)
       (((_* target) _) eat-behind)
       ((⟨target⟩ _) go-behind)
       ((_ (target _*)) eat-ahead)
       ((_ ⟨target⟩) go-ahead))
     (transform (@decisions eat-behind to @sequences)
       ((key home) (key left) (key C-backspace) (key right) (key down) (key down) (key down) (key down)))
     (transform (@decisions eat-ahead to @sequences)
       ((key end) (key right) (key C-delete) (key left) (key home) (key down) (key down) (key down) (key down)))
     (transform (@decisions go-behind to @cursor-commands) (move-parent-behind))
     (transform (@decisions go-ahead to @cursor-commands) (move-parent-ahead))
     (blast @sequences to @cursor-commands)
     (edit-cast @cursor-commands to @cursor))
   d
   e
   f
   foo
   bar
   baz))

