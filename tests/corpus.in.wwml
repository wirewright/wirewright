;; https://tailwindcss.com

"font-icons": {font: "Material Icons Outlined"}
"font-condensed": {font: "IBM Plex Sans Condensed"}
"font-sans": {font: "IBM Plex Sans"}
"font-serif": {font: "IBM Plex Serif"}
"font-mono": {font: "IBM Plex Mono"}

"rounded-none": {border-radius: 0}
"rounded-xs": {border-radius: (rem 0.125)}
"rounded-sm": {border-radius: (rem 0.25)}
"rounded-md": {border-radius: (rem 0.375)}
"rounded-lg": {border-radius: (rem 0.5)}
"rounded-xl": {border-radius: (rem 0.75)}
"rounded-2xl": {border-radius: (rem 1)}
"rounded-3xl": {border-radius: (rem 1.5)}

"rounded": "rounded-md"

"leading-none": {leading: 1}
"leading-tight": {leading: 1.25}
"leading-snug": {leading: 1.375}
"leading-normal": {leading: 1.5}
"leading-relaxed": {leading: 1.625}
"leading-loose": {leading: 2}

"leading-xs": {leading: (/ 1 0.75)}
"leading-sm": {leading: (/ 1.25 0.875)}
"leading-base": {leading: (/ 1.5 1)}
"leading-lg": {leading: (/ 1.75 1.125)}
"leading-xl": {leading: (/ 1.75 1.25)}
"leading-2xl": {leading: (/ 1.75 1.5)}
"leading-3xl": {leading: (/ 2.25 1.875)}
"leading-4xl": {leading: (/ 2.5 2.25)}
"leading-5xl": {leading: 1}
"leading-6xl": {leading: 1}
"leading-7xl": {leading: 1}
"leading-8xl": {leading: 1}
"leading-9xl": {leading: 1}

"text-xs": {text-size: (rem 0.75)}
"text-sm": {text-size: (rem 0.875)}
"text-base": {text-size: (rem 1)}
"text-lg": {text-size: (rem 1.125)}
"text-xl": {text-size: (rem 1.25)}
"text-2xl": {text-size: (rem 1.5)}
"text-3xl": {text-size: (rem 1.5)}
"text-4xl": {text-size: (rem 2.25)}
"text-5xl": {text-size: (rem 3)}
"text-6xl": {text-size: (rem 3.75)}
"text-7xl": {text-size: (rem 4.5)}
"text-8xl": {text-size: (rem 6)}
"text-9xl": {text-size: (rem 8)}

"font-thin": {font-weight: 100}
"font-extralight": {font-weight: 200}
"font-light": {font-weight: 300}
"font-normal": {font-weight: 400}
"font-text": {font-weight: 450}
"font-medium": {font-weight: 500}
"font-semibold": {font-weight: 600}
"font-bold": {font-weight: 700}
"font-extrabold": {font-weight: 800}
"font-black": {font-weight: 900}

"w-max": {w: max}
"h-max": {h: max}
"max": (+ "w-max" "h-max")

"w-content": {w: content}
"h-content": {h: content}
"content": (+ "w-content" "h-content")

"w-fr": (+ "w-max" "fr-1")
"h-fr": (+ "h-max" "fr-1")

(nat "fr" N {fr: N_})

"fr": {fractions: true}

"bg-none": {bg: (unset)}

(color "bg" C {bg: C_})
(dynamic "bg" C {bg: C_})

(color "text" C {text-color: C_})
(dynamic "text" C {text-color: C_})

(color "border" C {border-color: C_})
(dynamic "border" C {border-color: C_})

(color "sel" C {sel-fill: C_})
(dynamic "sel" C {sel-fill: C_})

(color "sel-text" C {sel-color: C_})
(dynamic "sel-text" C {sel-color: C_})

(nat "gap" N {gap: (spacing N_)})

"ring": (+ "ring-x" "ring-y")
"ring-x": (+ "ring-l" "ring-r")
"ring-y": (+ "ring-t" "ring-b")

"ring-l": {ring-l: 1}
"ring-r": {ring-r: 1}
"ring-t": {ring-t: 1}
"ring-b": {ring-b: 1}

(nat "ring-l" N {ring-l: N_})
(nat "ring-r" N {ring-r: N_})
(nat "ring-t" N {ring-t: N_})
(nat "ring-b" N {ring-b: N_})

(nat "ring-x" (+ "ring-l" "ring-r"))
(nat "ring-y" (+ "ring-t" "ring-b"))

(nat "ring" (+ "ring-x" "ring-y"))

"w-px": {w: content, content-w: 1}
"h-px": {h: content, content-h: 1}

(nat "w" N {w: content, content-w: (spacing N_)})
(nat "h" N {h: content, content-h: (spacing N_)})

"max-w-px": {w: max, max-w: 1}
"max-h-px": {h: max, max-h: 1}

(nat "max-w" N {w: max, max-w: (spacing N_)})
(nat "max-h" N {h: max, max-h: (spacing N_)})

"p-px": (+ "px-px" "py-px")
"px-px": (+ "pl-px" "pr-px")
"py-px": (+ "pt-px" "pb-px")

"pl-px": {pl: 1}
"pr-px": {pr: 1}
"pt-px": {pt: 1}
"pb-px": {pb: 1}

"p-0.5": (+ "px-0.5" "py-0.5")
"px-0.5": (+ "pl-0.5" "pr-0.5")
"py-0.5": (+ "pt-0.5" "pb-0.5")

