;; Edit-cage external signaling
(d7
  ((edit-cage for @cursor
     ("" | "" () @cursor))
   (delay 0 (event (pulse @cursor (input "hello"))))
   (delay 1 (event (pulse @cursor (key enter))))
   (delay 2 (event (pulse @cursor (key home))))
   ;; If cage didn't work, this would cause the cursor to jump out of the cage.
   (delay 3 (event (pulse @cursor (key home)))))
  ((edit-cage for @cursor
     ("" | "" () @cursor)
     hello)))

