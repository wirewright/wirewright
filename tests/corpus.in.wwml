;; Transparent fill with border, linear gradient stroke, translucent
;; linear gradient stroke.
;;
;; FIXME: BUG: colors leak out of transparent borders. This appears to be a problem
;; with PlutoVG/its rasterizer & even-odd fill mode. But it could be my error as well.
(group
  (rect
    dl: 160
    final-w: 250
    final-h: 220
    z-index: 10
    stroke:
      (linear-gradient
        (stop 0 (oklch 0.5 0.2 0 0.5))
        (stop 1 (oklch 0.5 0.2 50 0.7)))
    thickness-l: 10
    thickness-r: 10
    thickness-t: 10
    thickness-b: 10
    radius-tl: 10
    radius-tr: 10
    radius-bl: 10
    radius-br: 10)
