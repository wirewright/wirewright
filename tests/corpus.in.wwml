   z-index: 1
   fill: (rgb 0 0 0 0.5))
 (svg
   src: (file "data/soma-logo.svg")
   color: black
   resize: clip))

;; SVG: stretch
(group
 dl: 1400
 dt: 730
 final-w: 100
 final-h: 35
 (text
   caption: "resize: stretch"
   dt: -20
