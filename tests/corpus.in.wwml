 ("" | "" () @user)
 #jobs/pending: ()
 #population: {(cell @dir): true}
 #cells: {@dir: down}
 #events: ((pulse @actions dir-up)))

;; Here we render the majority of the visual nodes you see in µsoma.
;;
;; Each such node is rendered into a Microfold unit. We use Alloy to generate
;; the markup.

;; Visualize `button` nodes.
(node (button caption_ to @_ (_*) ¦ attrs_)
      (button caption_ to @_ waiting @_ (_*) ¦ attrs_)
      (button caption_ as _ to @_ (_*) ¦ attrs_)
      (button caption_ as _ to @_ waiting @_ (_*) ¦ attrs_)
  (^extend (button (^ ↑caption)) attrs))

;; Visualize various text nodes.
(node (head←(%any h1 h2 h3 h4 h5 h6 p src) caption_ ¦ attrs_)
  (^extend (^head (^ ↑caption)) attrs))

;; Visualize horizontal separator.
(node (hr ¦ attrs_)
  (^extend ((self hr rect)) attrs)

;; Visualize `cover`. Note how we do not touch the inner nodes. This means
;; everything downstream will not touch them either; thus `cover` is not only
;; a decoration but also a very useful "optimization" tool.
;;
;; NOTE: cover references its title from inside itself.
(node [cover title_ _+]
  (group style: "content my-2 p-3 border border-neutral-700 rounded-sm"
    (p "…" (^ ↓title) "…" style: "text-xs text-neutral-400 gap-1")))

;; Visualize comment nodes.
(node [comment lines_string+]
  (box style: "content py-2"
    (box style: "w-max max-w-lg h-content pl-1 bg-neutral-700"
      (^each (lines as line_string)
        (p ^line style: "pl-3 text-neutral-500 bg-neutral-900 text-sm w-max leading-normal"))))))

;; Visualize `view` node.
(node (view view_ ¦ attrs_)
  (^ ↑view))

;; Visualize `changes/view` node.
(node (changes/view view_ @_ ¦ attrs_)
  (^extend ^view attrs))

;; Visualize hidden `frag` node -- by substituting it with its value's
;; render instead.
(node (frag value_ @_ ¦ _ visible: false)
  (^view value))

;; Render the cursor along with suggestions.
;;
;; TODO: split these into smaller components/templates, this is unreadable mess!

(template (cursor lhs_string rhs_string)
  (group style: "content"
    (code ^lhs style: "text-neutral-400 bg-neutral-700")
    ;; If both are empty w-0 won't work so we have to create a rectangle
    ;; that is explicitly w-px. Also, if lhs is empty, use ring-r, because
    ;; if we're using ring-l, it may overflow outside of the viewport
    ;; if the cursor is located at origin.
    ((self rect)
      style: "h-max z-10 bg-blue-500 w-0 ring-l lempty:ring-l-0 lempty:ring-r empty:w-px empty:ring-0"
      empty: (^ (= lhs rhs ""))
      lempty: (^ (= lhs "")))
    (code ^rhs style: "text-neutral-400 bg-neutral-700")))

;; Render basic cursor.
(term [lhs_string | rhs_string (_*) @user]
  (^plug (cursor lhs rhs)))

;; Render suggestion for one option.
(passable (lhs_string | rhs_string (_*) @user ¦ _ suggestions: (suggestions/list () ((name_string intro_string)) ()))
  (group style: "content flow-none"
    (^plug (cursor lhs rhs))
    (box style: "floating z-20 dt-8 border border-neutral-600 bg-neutral-800 rounded p-2"
      (group style: "content min-w-xs max-w-md flow-col gap-2"
        (p ^name style: "w-max px-2 py-1 font-mono bg-neutral-700 text-neutral-200 font-medium rounded-sm")
        (p ^intro style: "w-max px-2 pb-1 text-sm text-neutral-300")))))

;; Render suggestion list.
(passable (lhs_string | rhs_string (_*) @user ¦ _
            suggestions: (suggestions/list above←(_*)
                                           visible←((%past (_string _string) min: 1))
                                           below←(_*)))
  (group style: "content flow-none"
    (^plug (cursor lhs rhs))
    (^let total: (^ (tally above visible below))
       (box style: "floating z-20 dt-8 border border-neutral-600 bg-neutral-800 rounded p-3"
         (main style: "content min-w-xs max-w-md flow-col gap-3"
           (header style: "w-max h-content flow-row font-sans font-normal text-xs text-neutral-300"
             "Showing " (^ (tally above))
             ".." (^ (tally above visible))
             " out of " ^total
             ". Use PgUp/Dn to scroll")
           (group style: "w-max h-content flow-row fr"
             (list style: "w-fr h-content flow-col text-sm leading-sm font-mono font-text text-neutral-200 gap-2"
               (^each (names as (name_string _))
                  ^name)
             (^let scroll-offset: (^ (/ (tally above) total))
                   scroll-height: (^ (/ (tally visible) total))
               (^if (< scroll-offset 1)
                 (scroll style: "w-2 h-max pr-1"
                   ((self y-translate) offset: (* ^scroll-offset) style: "max"
                     ((self rect/outline) style: "max border bg-neutral-600 rounded-sm" max-h: (* ^scroll-height)))))))))))))

;; Render suggestion group.
(passable (lhs_string | rhs_string (_*) @user ¦ _
            suggestions_: (suggestions/group prefix←(_*)
                                             suffix←((head_string body_string) _*)))
  (group style: "content flow-none"
    (^plug (cursor lhs rhs))
    (^let total: (^tally prefix suffix)
      (box style: "floating z-20 dt-8 border border-neutral-600 bg-neutral-800 rounded p-2"
        (group style: "content flow-col gap-2"
          (^match (> total 1)
            (when true (group style: "w-max fr h-content flow-row gap-2 px-2 py-1 bg-neutral-700 rounded-sm"
                          (p style: "text-sm center-y text-neutral-200"
                            ;; Start counting from one.
                            "↑" (^ (+ (tally prefix) 1)) "/" ^total "↓")
                          (box style: "w-fr h-content font-mono text-neutral-200 font-medium"))
                            (^hi head))
            (when false (box style: "w-max h-content px-2 py-1 font-mono bg-neutral-700 text-neutral-200 font-medium rounded-sm"
                          (^hi head))))
          (box style: "content px-2 pb-1 text-sm text-neutral-300"
            (^hi body)))))))



;;
;; GENERAL
;;

;; Initialize. Otherwise we'd have to use %optional-s everywhere which is
;; very uncomfortable.
{¦ -inbox_} <> {inbox: ()}
{¦ -outbox_} <> {outbox: ()}
{¦ -commands_} <> {commands: ()}

;; Redirect unhandled events to outbox.
{¦ inbox: (in_ _*) outbox: (_* `out)} <> {(in): (), out: →in}

;; Take events from outboxes of children.
⟨{¦ outbox: (in_ _*)} ¦ _ outbox: (_* `out)⟩ <> {(in): (), out: →in}

;; If my parent is not focused then I am not focused
⟨{¦ focus_} ¦ _ -focus⟩ <> {(focus): ()}

;;
;; COMMANDS
;;

⟨{¦ -focus_} {¦ focus: old_} ¦ _ focus: _ commands: (cmd←(focus-prev) _*)⟩
  <> {(cmd): (), (old): (), focus: true}

⟨{¦ focus: old_} {¦ -focus_} ¦ _ focus: _ commands: (cmd←(focus-next) _*)⟩
  <> {(cmd): (), (old): (), focus: true}


(_ (%past {¦ -focus}) {¦ -focus_} ¦ _ focus: _ commands: (cmd←(focus-prev) _*))
  <> {(cmd): (), focus: true}

(_ {¦ -focus_} (%past {¦ -focus}) ¦ _ focus: _ commands: (cmd←(focus-next) _*))
  <> {(cmd): (), focus: true}

;;
;; FRAME
;;

;; Pass events from inbox to first focused child.
⟨{¦ focus: _ inbox: (_* `out)} ¦ _ frame: _ focus: _ inbox: (in_ _*)⟩
  <> {(in): (), out: →in}

{¦ frame: _ focus: _ outbox: (in←(key S-tab) _*) commands: (_* `out)}
  <> {(in): (), out: (focus-prev)}

{¦ frame: _ focus: _ outbox: (in←(key tab) _*) commands: (_* `out)}
  <> {(in): (), out: (focus-next)}

;;
;; LIST
;;

;; (key home) moves to the start of the list.

(%all ⟨{¦ -focus_}⟩
      ⟨{¦ focus: old_}⟩
      {¦ list: _ focus: _ outbox: (in←(key home) _*) commands: (_* `out)})
  <> {(in): (), (old): (), focus: true}

;; (key end) moves to the end of the list.
(%all ⟨{¦ focus: old_}⟩
      (_ _* {¦ -focus_} ¦ _ list: _ focus: _ outbox: (in←(key end) _*) commands: (_* `out)))
  <> {(in): (), (old): (), focus: true}

;; (key up) moves to the previous item.
{¦ list: _ focus: _ outbox: (in←(key up) _*) commands: (_* `out)}
  <> {(in): (), out: (focus-prev)}

;; (key down) moves to the previous item.
{¦ list: _ focus: _ outbox: (in←(key down) _*) commands: (_* `out)}
  <> {(in): (), out: (focus-next)}

(_ {¦ focus: old_} _* {¦ -focus_} ¦ _ list: _ focus: _ outbox: (in←(key up) _*))
  <> {(in): (), (old): (), focus: true}

(_ {¦ -focus_} _* {¦ focus: old_} ¦ _ list: _ focus: _ outbox: (in←(key down) _*))
  <> {(in): (), (old): (), focus: true}

;;
;; INPUT
;;

;; Handle text input
(input l_string | _string ¦ _ focus: _ inbox: (E←(input text_string) _*))
  <> {(E): (), l: $'(~ →l →text)}

;; Handle (key left).
(input l_string | r_string ¦ _ focus: _ inbox: (E←(key left) _*))
  <> {(E): (), l: $'(runes →l 0 to -2), r: $(~ (rune →l -1) →r)}

;; Handle (key right).
(input l_string | r_string ¦ _ focus: _ inbox: (E←(key right) _*))
  <> {(E): (), l: $(~ →l (rune →r 0)), r: $'(runes →r 1 to -1)}


