;; Linear
(rect
  dl: 550
  dt: 500
  final-w: 50
  final-h: 200
  radius-tl: 10
  radius-br: 5
  fill: (linear-gradient
    begin-x: 0.5
    begin-y: 0.05
    end-x: 0.5
    end-y: 0.8
    (stop 0 (rgb 91 118 255))
    (stop 0.7 (rgb 0 192 152))
    (stop 1 (rgb 14 107 174)))
  z-index: 10)

(viewport dl: 670 dt: 480 final-w: 80 final-h: 80 zoom: 1.9 pan-x: 5 pan-y: 10
  (group pivot: true angle: 10 final-w: 50 final-h: 50
    (text
