   (key delete)
   (key delete)
   (key delete)
   (key delete)
   (input "Decrement")
   (input " ")
   (key backspace)
   (input "\"")
   (input " "))
  (button "+ Increment" "- Decrement" ("" | "" () @user)))
 (after
  ((key C-S-home))
  (("" | "" () @user) (button "+ Increment" "- Decrement")))
 (after
  ((key right))
