;; SVG: rotate
(group
 dl: 1480
 dt: 430
 final-w: 100
 final-h: 35
 pivot: true
 angle: -45
 (text
   caption: "resize: stretch"
   dt: -20
   font: "IBM Plex Mono"
   size: 11)
 (rect
   z-index: 1
   fill: (rgb 0 0 0 0.5))
 (svg
   src: (file "data/soma-logo.svg")
   color: black
   resize: stretch))

;; SVG: rotate & scale inside viewport
(group
  dl: 1580
  dt: 300
  final-w: 200
  final-h: 60
  (rect
    z-index: -1
    fill: pink)
  (viewport
   pan-l: 20
   pan-t: 10
   zoom: 1.5
    (group
     pivot: true
     angle: -10
     final-w: 100
     final-h: 35
     (text
       caption: "resize: stretch"
       dt: -20
       font: "IBM Plex Mono"
       size: 11)
     (rect
       z-index: 1
       fill: (rgb 0 0 0 0.5))
     (svg
       src: (file "data/soma-logo.svg")
       color: black
       resize: stretch))))

(editor
 (("" | "" () @user))
 (after
  ((input "button") (key enter))
  (button ("" | "" () @user)))
 (after
  ((input "\"") (key enter) (input "Increment") (key enter))
  (button ("\"Increment" | "" () @user)))
 (after
  ((key home)
   (key right)
   (input "+")
   (key enter)
   (key end)
   (key home)
   (key right)
   (key right)
   (input " ")
   (key end))
  (button ("\"+ Increment" | "" () @user)))
 (after
  ((input "\"") (input " "))
  (button "+ Increment" ("" | "" () @user)))
 (after
  ((input "\"")
   (input "-")
   (key backspace)
