;; TODO: each one should have one example since params will not capture everything.
;; (e.g. where/whether/how to pass children or for e.g. `map` how the conditions look like)

(node absence "Senses the absence of a cell"
  (const cin "cell whose absence should be detected")
  (comma as)
  (literal msg "message to send")
  (comma to)
  (pulse pout "sink for the message"))

(node blast "Emits the items of lists received inorder"
  (pulse pin "source of lists")
  (comma to)
  (pulse pout "sink for items"))

(group button "Triggers a pulse when clicked")

(variant button
  (literal msg "used both as caption and message sent to sink on click")
  (comma to)
  (pulse pout "sink for messages")
  (literal mailbox "mailbox dict through which µsoma will communicate with the button"))

(variant button
  (literal msg "used both as caption and message sent to sink on click")
  (comma to)
  (pulse pout "sink for messages")
  (comma waiting)
  (pulse acks "source of message acknowledgements")
  (literal mailbox "mailbox dict through which µsoma will communicate with the button"))

(variant button
  (literal caption "string term that is going to be written on top of the button")
  (comma as)
  (literal msg "message sent to sink on click")
  (comma to)
  (pulse pout "sink for messages")
  (literal mailbox "mailbox dict through which µsoma will communicate with the button"))

(variant button
  (literal caption "string term that is going to be written on top of the button")
  (comma as)
  (literal msg "message sent to sink on click")
  (comma to)
  (pulse pout "sink for messages")
  (comma waiting)
  (pulse acks "source of message acknowledgements")
  (literal mailbox "mailbox dict through which µsoma will communicate with the button"))

(group cell "Stores a term inside itself. Acts as a source of const signal")

(variant cell
  (const cout "sink for const signal"))

(variant cell
  (const cout "sink for const signal")
  (comma for)
  (literal guard "pattern that each assignment to this cell must satisfy"))

(variant cell
  (literal v "current value")
  (const cout "sink for const signal"))

(variant cell
  (literal v "current value")
  (const cout "sink for const signal")
  (comma for)
  (literal guard "pattern that each assignment to this cell must satisfy"))

(group changes "Converts a const signal into a pulse whenever the former changes")

(variant changes
  (const cin "source of const signal")
  (comma to)
  (pulse pout "sink for values of const on change"))

(variant changes
  (const cin "source of const signal")
  (comma to)
  (pulse pout "sink for values of const on change")
  (comma as)
  (literal value "value to send on change instead of const's"))

(node col "Arranges its children in a vertical stack, with an optional gap")

(node decay "Counts down until destroying itself and its children"
  (literal n "counter that you should initialize to a nonzero natural number"))

(node delay "Counts down until replacing itself with its children"
  (literal n "counter that you should initialize to a nonzero natural number"))

(node echo "Emits as event the pulses it receives"
  (pulse pin "source of pulses"))

(node edit-cage "Converts pulse signals to children-centric non-broadcast (private) edits"
  (comma for)
  (pulse pin "source of pulse signals"))

(node edit-cast "Converts pulse signal to root-centric edit broadcast"
  (pulse pin "source of pulse signals")
  (comma to)
  (broadcast bout "sink for edit broadcast signals"))

(node event "Emits an event and destroys itself"
  (literal e "term that should be emitted as an event"))

(group frag "Works exactly like cell but its value is passable -- meaning whatever is in there (buttons, delays, cells, etc.) gets executed and can be observed throughout execution using the `changes` node")

(variant frag
  (const cout "sink for const signal")
  (prop? visible "if true, shows the frag and the value (default); if false, shows the value alone"))

(variant frag
  (literal value "current value")
  (const cout "sink for const signal")
  (prop? visible "if true, shows the frag and the value (default); if false, shows the value alone"))

(node group "Groups nodes together without any logical/UI effect")

(group latest "Converts incoming pulse signals to const")

(variant latest
  (pulse pin "source of pulse signals")
  (const cout "sink for const signals"))

(variant latest
  (nested
    (pulse pin "source of pulse signals")
    (literal pattern "pattern which the pulse should match"))
  (nested
    (const cout "sink for const signals")
    (literal template "template to fill using captures made by the pattern")))

(group log "Shows last N pulses received")

(variant log
  (pulse pin "source of pulse signals")
  (comma in)
  (literal storage "dict to store the logged terms in")
  (prop? limit "how many latest terms to show (default: 10)"))

(variant log
  (pulse pin "source of pulse signals")
  (comma in)
  (const cout "cell to append to")
  (prop? limit "how many latest terms to show (default: 10)"))

(node lookaround "Makes a snapshot of the document behind and ahead of itself while hosting some children"
  (pulse snapshots "sink for snapshots of nodes behind and ahead (tuple)")
  (pulse capture "source for triggers to capture a snapshot"))

(node match "Converts an incoming pulse to one of templated outputs using pattern-matching"
  (nested
    (pulse pin "source of terms to match")
    (comma to)
    (pulse pout "sink for instantiated templates")))

(node periodic "Emits an event on every cycle"
  (literal e "term that should be emitted as an event"))

(node queue "Holds an unbounded number of terms. Two-phase: dequeues on cycle + waits for confirmation"
  (pulse pin "source of values to enqueue")
  (comma to)
  (pulse pout "sink for dequeued values")
  (comma in)
  (literal storage "dict for storing enqueued values")
  (comma waiting)
  (pulse acks "source of dequeue confirmations (any term)"))

(node row "Arranges its children in a horizontal stack, with an optional gap")

(group transform "Transforms incoming pulse into outgoing pulse using Nitrene")

(variant transform
  (pulse pin "source of terms to transform")
  (comma to)
  (pulse pout "sink for transformed terms")
  (literal body "Nitrene program that will do the transformation"))

(variant transform
  (pulse pin "source of terms to transform")
  (comma to)
  (pulse pout "sink for transformed terms")
  (comma with)
  (const state "const signal that the transform node will read and pass to Nitrene under `state`")
  (literal body "Nitrene program that will do the transformation"))

(variant transform
  (nested
    (pulse pin "source of terms to transform")
    (literal pattern "pattern that terms to transform must match"))
  (comma to)
  (pulse pout "sink for transformed terms")
  (literal body "Nitrene program that will do the transformation; has access to captures made by pattern"))

(variant transform
  (nested
    (pulse pin "source of terms to transform")
    (literal pattern "pattern that terms to transform must match; has access to state"))
  (comma to)
  (pulse pout "sink for transformed terms")
  (comma with)
  (const state "const signal that the transform node will read and pass to Nitrene under `state`")
  (literal body "Nitrene program that will do the transformation; has access to captures made by pattern"))

(node comment "Grayed out text that is explaining something"
  (literal text "content of the comment"))

(node unit "A microfold node with zero or more D7 children"
  (literal node "name of the node (e.g. p, button)"))

(group view  "A purely visual node that passes its content directly to Microfold")

(variant view (literal content "Microfold markup to show"))
(variant view (const content "Cell from which to take the Microfold markup to show"))

(group changes/view "Converts cell changes/assignments to views. Little brother of both `view` and `changes`")

(variant changes/view (const cin "edge to listen for cell changes/assignments on"))
(variant changes/view
  (literal view "Microfold markup to show")
  (const cin "edge to listen for cell changes/assignments on"))

(group initial "Companion of `absence`, outputs the first-ever value of a const")

(variant initial
  (const cin "const signal to watch for")
  (comma to)
  (pulse pout "sink for first-ever values"))

(variant initial
  (const cin "const signal to watch for")
  (comma to)
  (pulse pout "sink for value")
  (comma as)
  (pulse value "value"))

(node combine "Gathers latest values for all pulses and flushes them"
  (literal pins "list of pulse edges to wait for")
  (comma in)
  (literal storage "temporary storage for latest values received on pulse edges")
  (comma for)
  (pulse pout "sink for full storages"))

(node mutator "Mutator allows to morph a passable child using a backmap. What it does is expressible with circuitry, transform nodes, etc., but for common use cases, a separate, simple node is most convenient."
  (pulse pin "source of (pattern_ backspec_) backmaps; pattern captures things of interest in the child, backspec defines what to replace them with")
  (literal value "passable child susceptible to mutation"))

(group h1 "A purely visual node that displays as a massive header")

(variant h1 (literal caption "text to show in the header (preferably a string)"))
(variant h1 (const caption "cell from which to take the header's content"))

(group h2 "A purely visual node that displays as a huge header")

(variant h2 (literal caption "text to show in the header (preferably a string)"))
(variant h2 (const caption "cell from which to take the header's content"))

(group h3 "A purely visual node that displays as a large header")

(variant h3 (literal caption "text to show in the header (preferably a string)"))
(variant h3 (const caption "cell from which to take the header's content"))

(group h4 "A purely visual node that displays as a medium header")

(variant h4 (literal caption "text to show in the header (preferably a string)"))
(variant h4 (const caption "cell from which to take the header's content"))

(group h5 "A purely visual node that displays as a small header")

(variant h5 (literal caption "text to show in the header (preferably a string)"))
(variant h5 (const caption "cell from which to take the header's content"))

(group h6 "A purely visual node that displays as a tiny header")

(variant h6 (literal caption "text to show in the header (preferably a string)"))
(variant h6 (const caption "cell from which to take the header's content"))

(group p "A purely visual node that displays as plain text")

(variant p (literal caption "text to show (preferably a string)"))
(variant p (const caption "cell from which to take the text's content"))

(node hr "A purely visual node that displays as a horizontal separator")

(group src "A purely visual node that displays as a block of code")

(variant src (literal code "code to show (preferably a string)"))
(variant src (const code "cell from which to take the code to show"))

(group cover "Like `group`, but conceals its children. `cover` is mainly used to reduce visual noise that certain nodes, e.g. `queue`, produce")

(variant cover (literal title "description of what's under the cover (preferably a string)"))
(variant cover (const title "cell from which to take the title for the cover"))

(group bridge "Direct connection between two pulse edges")

(variant bridge
  (pulse pin "source of pulse signals")
  (comma to)
  (pulse pout "sink for pulse signals"))

(variant bridge
  (pulse pin "source of pulse signals")
  (comma as)
  (literal value "value to send to the sink")
  (comma to)
  (pulse pout "sink for pulse signals"))

(variant bridge
  (nested
    (pulse pin "source of pulse signals")
    (literal pattern "pattern that they must match"))
  (comma to)
  (pulse pout "sink for pulse signals"))

(variant bridge
  (nested
    (pulse pin "source of pulse signals")
    (literal pattern "pattern that they must match"))
  (comma to)
  (nested
    (pulse pout "sink for values of the capture")
    (literal capture "name of the capture made by `pattern`")))

(group alloy "Renders an Alloy template from incoming variable dicts (environments)")

(variant alloy
  (nested
    (pulse envs "source of environments")
    (comma to)
    (pulse instances "sink for rendered templates (template instances)"))
  (literal template "Alloy template that should be rendered")
  (prop? strict "Do not render if there are problems (e.g. some variables missing). Default: false")
  (prop? complaints "Pulse edge to file complaints to (e.g. that some variable is missing)"))

(variant alloy
  (nested
    (pulse envs "source of environments")
    (comma to)
    (pulse instances "sink for rendered templates (template instances)"))
  (const template "const source for Alloy template that should be rendered")
  (prop? strict "Do not render if there are problems (e.g. some variables missing). Default: false")
  (prop? complaints "Pulse edge to file complaints to (e.g. that some variable is missing)"))

(group sampler "Reads the value of const(s) on demand")

(variant sampler
  (const cin "const edge that should be sampled")
  (comma on)
  (pulse trigger "triggers the read")
  (comma to)
  (pulse samples "sink for samples taken"))

(variant sampler
  (literal cins "list of const edges that should be sampled simultaneously")
  (comma on)
  (pulse trigger "triggers the read")
  (comma to)
  (pulse samples "sink for samples taken (lists of simultaneously sampled cins)"))

(node spawner "Spawns nodes above or below itself"
  (pulse nodes "source of nodes to spawn")
  (prop? dir "can be `up` (default) or `down`, anything else is invalid"))
