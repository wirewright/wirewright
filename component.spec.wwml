;; TODO: we desperately need string interpolation syntax!!!

;; TODO: How to make these #el-s and inherit-s optional?!?!

(hr ¦ _ #el: id_)
  => ((self hr rect) inherit: ^id)

(button caption_string ¦ _ #el: id_)
  => (text inherit: ^id
           style: "content bg-neutral-700 hover:bg-blue-500 active:bg-blue-400 hover:cursor-pointer rounded-sm px-4 py-2 center text-sm leading-sm text-neutral-50 font-sans font-medium"
       ^caption)

;; TODO: An obvious point A is that it would be very convenient to inherit custom props
;; in Microfold. I.e. focus-color, hover, active, focus must all be inheritable. In fact,
;; we must not capture them like we do now; Microfold should "do the math" to figure out
;; where focus/hover/active come from.
;;
;;    - hint -> detail
;;    - detail-color
;;    - label -> title
;;    - subtitle
(input-field l_string m_string r_string ¦ _ icon_⋮ none placeholder_⋮ none focus⋮ false hover⋮ false active⋮ false)
  => (group style: "max rounded border border-neutral-800 px-3 py-2 gap-3 fr hover:cursor-text hover:border-neutral-700 active:border-neutral-600 focus:border-{focus-color}"
            focus-color: (oklch 0.6 0.0853 251.813)
            hover: ^hover
            active: ^active
            focus: ^focus
       (^unless (= icon none)
         (icon ^icon style: "text-neutral-500 text-lg h-max focus:text-{focus-color}" focus-color: (oklch 0.6 0.0853 251.813) focus: ^focus))
       (^match (focus l m r)
        (when (false "" "" "")
          (p style: "text-neutral-500 leading-tight h-max center-y font-normal w-fr"
            (^match placeholder
              (when none "")
              (when _ ^placeholder))))
        (when (_ _ (%string nonempty) _)
          (p style: "w-fr font-sans font-normal text-neutral-300 leading-tight text-base sel-text-white sel-neutral-500 focus:sel-blue-500"
             sel-anchor: (^ (charcount l))
             sel-span: (^ (charcount m))
             focus: ^focus
            (^ (~ l m r))))
        (when (true _ _ _)
          (p style: "w-fr font-sans font-normal text-neutral-300 leading-tight text-base sel-neutral-100"
             sel-anchor: (^ (charcount l))
             sel-span: 0
            (^ (~ l r))))
        (when _
          (p style: "w-fr font-sans font-normal text-neutral-300 leading-tight text-base"
            (^ (~ l r))))))

[input-label caption_string]
  => (p style: "w-max font-condensed font-medium text-neutral-400 text-sm"
       (^ (upcase caption)))

[input-label node_]
  => (group ^node style: "w-max")

[input-hint caption_string]
  => (p ^caption style: "w-max text-xs font-normal text-neutral-400 mx-1")

(input-limit n←(%number +i32) hi←(%number +i32) ¦ _ focus⋮ false)
  => (p ^n "/" ^hi style: "text-xs font-normal text-neutral-400 reached:text-yellow-400" reached: (^ (and (= n hi) focus)))


;; TODO: there are two very obvious problems here.
;;  1. How do we customize the input, for example, using style: ""? Lets say I want to change
;;     the border color, or bg, or text color, using style: "". How do I do that?
;;      This could be done by parsing style: "" and classifying the resulting utilities into
;;      different categories: text utilities, shape utilities, border utilities, font utilities,
;;      flow ones, etc. Then we would be able to ask style: "" about these utilities here in e.g. `input`
;;      via perhaps a primitive of some sort, or in some other way; maybe they get precomputed.
;;      We would be able to distribute them to different components of input: text ones to
;;      l/m/r text node, shape ones to input-field, etc. It would be even better if we would
;;      be able to define custom utilities right here in render.spec. For instance, we could
;;      define label-[color] to set the label color, or focus-[color] -- just for the input!
;;  2. Should e.g. input-hint or input-limit be self-sufficient, or is it OK to
;;     have them depend on the component they're used in? How can we implement
;;     input-limit etc. without depending on the way input lays out things, esp.
;;     with wrapping and all?
;;       I think we should build components with w-max & h-max all throughout. Assume
;;       they occupy the entirety of the available space that is. This leaves the power
;;       to choose what layout strat to use to the user; either they wrap in content-sized
;;       container or max-sized. It won't work the other way.

;; TODO: apparently we require some kind of syntax to ^extend with attrs like this.
;; This seems to be a rather useful pattern for passing stuff down. Note that we're
;; not React nor are we JavaScript; this is purely functional rewriting, in fact, I
;; believe it is as pure as it can get. We don't have access to any of the fancy
;; mutable mechanisms and can only pass down. Or maybe I don't know something.

(input l_string (| _) r_string ¦ attrs_ #el: id_ label_⋮ none hint_⋮ none limit_⋮ none)
  => (group style: "max flow-col gap-1 fr"
       (^unless (= label none)
         (^extend (input-label ^label) attrs))
       (group style: "w-max h-fr" inherit: ^id
         (^extend (input-field ^l "" ^r) attrs))
       (^let length: (charcount l r)
         (^match (hint limit)
           (when (none none))
           (when (_ none)
             (group style: "w-max mt-1"
               (^extend (input-hint ^hint) attrs)))
           (when (none _)
             (group style: "w-max right mt-1"
               (^extend (input-limit ^length ^limit) attrs)))
           (when _
             (group style: "w-max fr mt-1"
               (group (^extend (input-hint ^hint) attrs) style: "w-fr")
               (input-limit ^length ^limit))))))

;; TODO: viewport, pan-x, pan-y
[document content_]
  => ^content

[indicator true]
  => ((self rect) style: "w-2 h-2 bg-green-500 dt-2 mr-1 rounded-xs")

[indicator false]
  => ((self rect) style: "w-2 h-2 bg-yellow-500 dt-2 mr-1 rounded-xs")

(cover title_string ¦ _ #el: id_)
  => (group inherit: ^id
            style: "content my-2 p-3 border border-neutral-700 rounded-sm"
       (p "…" ^title "…" style: "text-xs text-neutral-400 gap-1"))

(comment lines_string+ ¦ _ #el: id_)
  => (box inherit: ^id style: "content py-2"
       (box style: "flow-col w-max max-w-lg h-content pl-1 bg-neutral-700"
         (^each (lines as line_)
           (p ^line style: "pl-3 text-neutral-500 bg-neutral-900 text-sm w-max leading-normal"))))

[cursor lhs_string rhs_string ()]
  => (group style: "content"
       (code ^lhs style: "text-neutral-400 bg-neutral-700")
       ;; If both are empty w-0 won't work so we have to create a rectangle
       ;; that is explicitly w-px. Also, if lhs is empty, use ring-r, because
       ;; if we're using ring-l, it may overflow outside of the viewport
       ;; if the cursor is located at origin.
       ((self rect) style: "h-max z-10 bg-blue-500 w-0 ring-l lempty:ring-l-0 lempty:ring-r empty:w-px empty:ring-0"
         empty: (^ (= lhs rhs ""))
         lempty: (^ (= lhs "")))
       (code ^rhs style: "text-neutral-400 bg-neutral-700"))

[suggestion name_string intro_string]
  => (box style: "floating z-20 dt-8 border border-neutral-600 bg-neutral-800 rounded p-2"
       (group style: "content min-w-xs max-w-md flow-col gap-2"
         (p ^name style: "w-max px-2 py-1 font-mono bg-neutral-700 text-neutral-200 font-medium rounded-sm")
         (p ^intro style: "w-max px-2 pb-1 text-sm text-neutral-300")))

[cursor lhs_string rhs_string (suggestions/list () ((name_string intro_string)) ())]
  => (group style: "content flow-none"
        (cursor ^lhs ^rhs ())
        (suggestion ^name ^intro))

;; TODO: the rest of cursor suggestions

(col children_+ ¦ _ gap⋮ 0 style⋮ "")
  => (group ^*children style: (^ (~ "flow-col gap-" (max 1 (* gap 2)) " " style)))

(row children_+ ¦ _ gap⋮ 0 style⋮ "")
  => (group ^*children style: (^ (~ "flow-row gap-" (* gap 2) " " style)))

(token caption_string ¦ _ tag: symbol)
  => (code ^caption style: "text-neutral-200")

(token caption_string ¦ _ tag: number)
  => (code ^caption style: "text-violet-400")

(token caption_string ¦ _ tag: string)
  => (code ^caption style: "text-yellow-600")

(token caption_string ¦ _ tag: boolean)
  => (code ^caption style: "text-orange-600")

[token caption_string]
  => (code ^caption style: "text-neutral-400")

;; Color code edge tokens.
(token caption_string ¦ _ tag: edge)
  => (^let H: (hash caption)
        (^let l: (nth (range 0.6 0.9 points: 1024) H)
              c: (nth (range 0.1 0.25 points: 1024) H)
              h: (mod H 360)
          (code ^caption style: "text-{color}" color: (oklch ^l ^c ^h))))

(indented child_ ¦ _ by: n←(%number +i32))
  => (group ^child style: (^ (~ "pl-" n)))

