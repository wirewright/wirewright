;; GENERAL

;; Learn the content width/height from a single child.
((%not x-expand) {¦ content-w: w_number} ¦ _ -content-w: W) <> {W: →w}
((%not y-expand) {¦ content-h: h_number} ¦ _ -content-h: H) <> {H: →h}

;; Propagate max-w/h if I know my max-w/h and I am w/h: max.
(_ {¦ -max-w: w} ¦ _ w: max max-w: W_number) <> {w: →W}
(_ {¦ -max-h: h} ¦ _ h: max max-h: H_number) <> {h: →H}

;; Propagate fractional max-w/h
(_ {¦ max-w_: (* frac←(%number 0 < _ < 1))} ¦ _ w: max max-w: W_number)
  <> {max-w: $(ceil (* →W →frac))}
(_ {¦ max-h_: (* frac←(%number 0 < _ < 1))} ¦ _ h: max max-h: H_number)
  <> {max-h: $(ceil (* →H →frac))}

;; Propagate my content-w/h as max-w/h of children if I am w/h: content.
((%not x-padding) {¦ w: max -max-w: w} ¦ _ w: content content-w: W_number) <> {w: →W}
((%not y-padding) {¦ h: max -max-h: h} ¦ _ h: content content-h: H_number) <> {h: →H}

;; For padding nodes, we need to subtract padding from content size
;; before converting it to child max-w/h.
(x-padding {¦ w: max -max-w: w} ¦ _ w: content content-w: W_number px_number)
  <> {w: $'(- →W →px)}
(y-padding {¦ h: max -max-h: h} ¦ _ h: content content-h: H_number py_number)
  <> {h: $'(- →H →py)}

;; Set final-w/h according to w/h.
{¦ w: content content-w_number -final-w_} <> {final-w: →content-w}
{¦ h: content content-h_number -final-h_} <> {final-h: →content-h}

{¦ w: max max-w_number -final-w_} <> {final-w: →max-w}
{¦ h: max max-h_number -final-h_} <> {final-h: →max-h}

;; A parent whose dl/dt is known, will define its child's dl/dt to be zero.
;;
;; Note how this does not cover elements such as x-stack and y-stack in
;; their multi-child variants. They manage dl/dt themselves (and this rule
;; works for single-child x-stack & y-stack).
((%not x-padding x-translate x-align) {¦ -dl_} ¦ _ dl: _number) <> {dl: 0}
((%not y-padding y-translate y-align) {¦ -dt_} ¦ _ dt: _number) <> {dt: 0}

;; Nodes without children have 0 content-w/h.
((%not text) ¦ _ -content-w_) <> {content-w: 0}
((%not text) ¦ _ -content-h_) <> {content-h: 0}

;; Rectangles will have content-w/h equal to their max-w/h if the latter
;; are specified manually.
(rect ¦ _ w: max max-w_number -content-w_) <> {content-w: →max-w}
(rect ¦ _ h: max max-h_number -content-h_) <> {content-h: →max-h}

;; If something has no children then it's x/y-ready when it knows its final-w/final-h
;; and its dl/dt.
(_ ¦ _ final-w: _number final-h: _number dl: _number dt: _number -ready_)
  <> {ready: true}

((%plural min: 2) ¦ _ dl: _number dt: _number final-w: _number final-h: _number -self-ready_)
  <> {self-ready: true}

((%not viewport) (%past {¦ ready: true} min: 1) ¦ _ self-ready: true -ready_)
  <> {ready: true}

;; NODE: text

(text ¦ _ -leading_) <> {leading: 1}

(text ¦ _ caption: _string font: _string weight: (%any 100 200 300 400 450 500 600 700 800 900) size: (%number u8) leading: _number -state_)
  <> {state: width-unknown}

(text ¦ _ caption_ font_ weight_ size_ leading_ state_: width-unknown -content-w_)
  <> {content-w: $(value (measure →caption →font →weight →size →leading) width),
      state: height-unknown}

(text ¦ _ w: content state_: height-unknown)
  <> {state: height-measurable}

;; Wrap caption at max-w if w: max once max-w is known, and transition
;; to measurable.
(text ¦ _ caption_ font_ weight_ size_ leading_ state_: height-unknown w: max max-w_number)
  <> {caption: $'(wrap →caption →font →weight →size →leading max-w: →max-w),
      state: height-measurable}

;; But if it's the same as content-w don't do anything! Our current text wrapping
;; algorithm is too stupid to be pixel perfect.
(text ¦ _ state_: height-unknown w: max content-w: w_ max-w: w_number)
  <> {state: height-measurable}

;; Compute content-h once in state: height-measurable.
(text ¦ _ caption_ font_ weight_ size_ leading_ state_: height-measurable -content-h_)
  <> {content-h: $(value (measure →caption →font →weight →size →leading) height),
      state: fully-measured}

;; NODE: x-padding

(x-padding _ ¦ _ -px_ pl⋮ 0 pr⋮ 0) <> {px: $'(+ →pl →pr)}
(x-padding {¦ content-w: w_number} ¦ _ -content-w: W px_number) <> {W: $'(+ →w →px)}
(x-padding {¦ -max-w: w} ¦ _ w: max max-w: W_number px_number) <> {w: $'(- →W →px)}
(x-padding {¦ -dl_} ¦ _ dl: _number pl⋮ 0) <> {dl: →pl}

;; NODE: y-padding

(y-padding _ ¦ _ -py_ pt⋮ 0 pb⋮ 0) <> {py: $'(+ →pt →pb)}
(y-padding {¦ content-h: h_number} ¦ _ -content-h: H py_number) <> {H: $'(+ →h →py)}
(y-padding {¦ -max-h: h} ¦ _ h: max max-h: H_number py_number) <> {h: $'(- →H →py)}
(y-padding {¦ -dt_} ¦ _ dt: _number pt⋮ 0) <> {dt: →pt}

;; NODE: x-translate

;; Support fractional offset (fraction of child's final width).
(x-translate {¦ -dl_ final-w: w_number} ¦ _ offset: (* frac←(%number -1 <= _ <= 1)) dl: _number final-w: W_number)
  <> {dl: $(ceil (* →W →frac))}

;; NODE: y-translate

(y-translate {¦ -dt_ final-h: h_number} ¦ _ offset: (* frac←(%number -1 <= _ <= 1)) dt: _number final-h: H_number)
  <> {dt: $(ceil (* →H →frac))}

;; NODE: x-align

(x-align {¦ -dl_ final-w: w_number} ¦ _ to: center dl: _number final-w: W_number)
  <> {dl: $(// (- →W →w) 2)}

(x-align {¦ -dl_ final-w: w_number} ¦ _ to: right dl: _number final-w: W_number)
  <> {dl: $(- →W →w)}

;; NODE: y-align

(y-align {¦ -dt_ final-h: h_number} ¦ _ to: center dt: _number final-h: H_number)
  <> {dt: $(// (- →H →h) 2)}

(y-align {¦ -dt_ final-h: h_number} ¦ _ to: bottom dt: _number final-h: H_number)
  <> {dt: $(- →H →h)}

;; NODE: floating
;;
;; Floating node is exempt from sizing. It reports its content-w/h as 0. In effect,
;; it's protecting ("coating") its child from inward sizing whereas outward sizing
;; is preserved.

(floating _ ¦ _ -content-w_ -content-h_) <> {content-w: 0, content-h: 0}

;; NODE: x-expand

;; If w: max then x-expand shouldn't be the one to define max-w, but rather, it
;; should be the passing-down rule (i.e. x-expand's child will inherit max-w from
;; w: max x-expand which in turn will inherit its max-w from its parent).
(x-expand {¦ content-w_number -max-w_} ¦ _ w: content min-w_number)
  <> {max-w: $'(max →content-w →min-w)}

;; If x-expand knows max-w but it's w: content then make use of max-w to have an
;; upper bound on the width of the child.
(x-expand {¦ content-w_number -max-w_} ¦ _ w: content min-w_number max-w: W_number)
  <> {max-w: $(min (max →content-w →min-w) →W)}

;; If w: content min-w: content, then we must wait for an upper bound on the child
;; and only use that.
(x-expand {¦ content-w_number -max-w_} ¦ _ w: content min-w: content max-w: W_number)
  <> {max-w: $'(min →content-w →W)}

;; Compute content-w of x-expand based on the determined max-w of the child.
(x-expand {¦ max-w_number} ¦ _ -content-w: W) <> {W: →max-w}

;; NODE: y-expand

;; If h: max then y-expand shouldn't be the one to define max-h, but rather, it
;; should be the passing-down rule (i.e. y-expand's child will inherit max-h from
;; h: max y-expand which in turn will inherit its max-h from its parent).
(y-expand {¦ content-h_number -max-h_} ¦ _ h: content min-h_number)
  <> {max-h: $'(max →content-h →min-h)}

;; If y-expand knows max-h but it's h: content then make use of max-h to have an
;; upper bound on the height of the child.
(y-expand {¦ content-h_number -max-h_} ¦ _ h: content min-h_number max-h: H_number)
  <> {max-h: $(min (max →content-h →min-h) →H)}

;; If h: content min-h: content, then we must wait for an upper bound on the child
;; and only use that.
(y-expand {¦ content-h_number -max-h_} ¦ _ h: content min-h: content max-h: H_number)
  <> {max-h: $'(min →content-h →H)}

;; Compute content-h of y-expand based on the determined max-h of the child.
(y-expand {¦ max-h_number} ¦ _ -content-h: H) <> {H: →max-h}

;; NODE: x-stack

;; Compute the content-w of x-stack.
;;
;; This applies to wrap: true as well.
(x-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ -content-w: W gap⋮ 0)
  <> {W: $(+ (sum (flatten →Cws)) (* →gap (- (tally →Cws) 1)))}

;; Compute max-sibling-h of x-stack.
(x-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ -max-sibling-h: H)
  <> {H: $(max (flatten →Chs))}

;; Set content-h of x-stack to its max-sibling-h.
;;
;; This **does not** apply to wrap: true because wrap: true computes its
;; content-h after wrapping (although it does make use of max-sibling-h).
(x-stack _* ¦ _ -wrap max-sibling-h: sh_ -content-h: h)
  <> {h: →sh}

;; If x-stack is set to h: content then setting h: max in a child would
;; mean that the child's max-h is content-h of the x-stack (i.e., maximum
;; sibling height).
;;
;; This will apply to wrap: true x-stack's because h: content is still there,
;; so we'll be able to grow as much as we need to make all elements have
;; equal height.
(%all (x-stack _+ ¦ _ h: content content-h: H_number) ⟨{¦ h: max -max-h: h}⟩°)
  <> {h: →H}

;; If x-stack is set to h: max then setting h: max in a child would
;; mean that the child's max-h is max-h of the x-stack.
;;
;; This **does not** apply to wrap: true x-stack's because they do not support
;; h: max; an x-stack that wants to grow but exceeds h: max is confused; instead,
;; the user should set h: content on the x-stack and wrap it in e.g. a viewport
;; (i.e. implement some sort of scrolling).
(%all (x-stack _+ ¦ _ -wrap h: max max-h: H_number) ⟨{¦ h: max -max-h: h}⟩°)
  <> {h: →H}

;; All children of x-stack with determinate dt have dt at 0.
;;
;; This **does not** apply to wrap: true x-stack's since we may wrap, thus
;; changing a child's dt.
(%all (x-stack _+ ¦ _ -wrap dt: _number) ⟨{¦ -dt_}⟩°)
  <> {dt: 0}

;; The first child of x-stack has dl equal to 0.
;;
;; This applies to wrap: true x-stack's as well.
[x-stack {¦ -dl_} _*] <> {dl: 0}

;; Any consecutive child learns its dl from the previous child plus
;; the previous child's final-w.
;;
;; This rule does not apply to wrap: true x-stack's because they're a bit
;; more nuanced than this.
;;
;; NOTE: we use the last child's left as a "flag" to signal that all children
;; had their lefts computed already and the rule engine should skip this rule.
;; This simplifies the job of the rule engine, making sure that it doesn't
;; have to go through all children every time before seeing that there is
;; no change, with regards to this particular rule.
(%all (x-stack _* {¦ -dl} ¦ _ -wrap gap⋮ 0) ⟨{¦ dl: dl0_number final-w: w0_number} {¦ -dl: dl1}⟩)
  <> {dl1: $'(+ →dl0 →w0 →gap)}

;; Sum content-w's of x-stack. Subtract from final-w of x-stack to get leftover-w.
;;
;; This rule obviously **does not** apply to wrap: true x-stack's since they
;; do not support fractions.
(%all (x-stack children_* ¦ _ -wrap fractions: true -leftover-w_ gap⋮ 0 final-w: W_number)
      (%items () {¦ w: content -final-w} min: 0)
      (%items Ws_ {¦ final-w: 0←_number} min: 0))
  <> {leftover-w: $(- →W (sum (flatten →Ws)) (* →gap (- (tally →children) 1)))}

;; Distribute leftover-w across w: max children.
;;
;; Ditto regarding wrap: true x-stack's.
(%all (x-stack _* ¦ _ -wrap fractions: true leftover-w: W_number fr/sum_number)
      ⟨{¦ w: max fr_: (%number (whole _) > 0) -max-w: w}⟩°)
  <> {w: $(// (* →W →fr) →fr/sum)}

;; If x-stack child has w: max but x-stack does not have fractions: true, we
;; force the child to become w: content. Otherwise we risk not drawing the child
;; at all, which is worse than drawing innaccurately.
;;
;; This rule **does not** apply to wrap: true x-stack's since it does not support
;; w: max children.
;;
;; NOTE: the whole thing with `fractions: true` is to save a bit of compute on
;; most x-stack's since most x-stack's do not use fractions, and we require some
;; rather expensive patterns to figure them out.
(%all (x-stack _* ¦ _ -wrap -fractions) ⟨{¦ w_: max -max-w}⟩°)
  <> {w: content}

;; NODE: x-stack wrap: true

;; The first child of wrap: true x-stack with determinate dt gets dt: 0.
(x-stack {¦ -dt_} _+ ¦ _ wrap: true dt: _number)
  <> {dt: 0}

;; Do the wrapping logic and save under delta: (dl dt dh) for the node
;; to unpack later on.
(%all (x-stack _* {¦ -delta} ¦ _ wrap: true gap⋮ 0 max-w: W_number max-sibling-h: H_number)
      ⟨{¦ dl: dl0_number dt: dt0_number final-w: w0_number}
       {¦ -delta_ final-w: w1_number final-h: h1_number}⟩)
  <> {delta:
        $(if (< (+ →dl0 →w0 →gap →w1) →W)      ;; < Do I fit?
           ((+ →dl0 →w0 →gap) →dt0 0)          ;; < If I do, what should my delta be?
           (0 (+ →dt0 →gap →H) (+ →gap →h1)))} ;; < If I don't, what should my delta be?

;; When the last child knows its delta, this means all children know their delta.
;; We can thus sum height-increments (part of delta) and  thus obtain content-h
;; of the x-stack.
;;
;; NOTE: we skip the first child since it doesn't have a delta attr.
(%all (x-stack _+ {¦ delta: _} ¦ _ -content-h: H max-sibling-h: sh_number)
      [x-stack _ (%many Dhs {¦ delta: (_ _ 0←_number)})])
  <> {H: $(+ →sh (sum (flatten →Dhs)))}

;; Unpack delta.
{¦ delta: (DL_number DT_number _) -dl_ -dt_}
  <> {dl: →DL, dt: →DT}

;; NODE: y-stack
;;
;; The same as x-stack minus the occasional W<->H or L<->T swap. This can
;; be generalized, but will lead to unreadable, overly generic mess -- I tried.

(y-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ -content-w: W)
  <> {W: $(max (flatten →Cws))}

(y-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ -content-h: H gap⋮ 0)
  <> {H: $(+ (sum (flatten →Chs)) (* →gap (- (tally →Chs) 1)))}

(%all (y-stack _+ ¦ _ w: content content-w: W_number) ⟨{¦ w: max -max-w: w}⟩°)
  <> {w: →W}

(%all (y-stack _+ ¦ _ w: max max-w: W_number) ⟨{¦ w: max -max-w: w}⟩°)
  <> {w: →W}

;; All children of y-stack with determinate dl have dl at 0.
(%all (y-stack _+ ¦ _ dl: _number) ⟨{¦ -dl_}⟩°) <> {dl: 0}

;; The first child of y-stack has dt of 0.
[y-stack {¦ -dt_} _*] <> {dt: 0}

;; Consecutive children learn their dt from their predecessor, plus
;; the predecessor's height and the gap (if any).
;;
;; Similarly, we use the last child's dt as an indication that this rule
;; was fully applied to the y-stack.
(%all (y-stack _* {¦ -dt} ¦ _ gap⋮ 0) ⟨{¦ dt: dt0_number final-h: h0_number} {¦ -dt: dt1}⟩)
  <> {dt1: $'(+ →dt0 →h0 →gap)}

(%all (y-stack children_* ¦ _ fractions: true -leftover-h_ gap⋮ 0 final-h: H_number)
      (%items () {¦ h: content -final-h} min: 0)
      (%items Hs_ {¦ final-h: 0←_number} min: 0))
  <> {leftover-h: $(- →H (sum (flatten →Hs)) (* →gap (- (tally →children) 1)))}

(%all (y-stack _* ¦ _ fractions: true leftover-h: H_number fr/sum_number)
      ⟨{¦ h: max fr_: (%number (whole _) > 0) -max-h: h}⟩°)
  <> {h: $(// (* →H →fr) →fr/sum)}

(%all (y-stack _* ¦ _ -fractions) ⟨{¦ h_: max -max-h}⟩°)
  <> {h: content}

;; Helper for both x-stack and y-stack.
(%all {¦ -fr/sum_ fractions: true} (%items Frs_ {¦ fr: 0←(%number (whole _) > 0)}))
  <> {fr/sum: $(sum (flatten →Frs))}

;; NODE: z-stack

(z-stack (%many Cws {¦ content-w: 0←_number}) ¦ _ -content-w: W)
  <> {W: $(max (flatten →Cws))}
(z-stack (%many Chs {¦ content-h: 0←_number}) ¦ _ -content-h: H)
  <> {H: $(max (flatten →Chs))}

;; If z-stack is set to w/h: content, this means the children receive z-stack's
;; content-w/h as max-w/h.
(%all (z-stack _+ ¦ _ w: content content-w: W_number) ⟨{¦ -max-w: w}⟩°) <> {w: →W}
(%all (z-stack _+ ¦ _ h: content content-h: H_number) ⟨{¦ -max-h: h}⟩°) <> {h: →H}

;; If z-stack is set to w/h: max, this means the children receive z-stack's
;; max-w/h as max-w/h.
(%all (z-stack _+ ¦ _ w: max max-w: W_number) ⟨{¦ -max-w: w}⟩°) <> {w: →W}
(%all (z-stack _+ ¦ _ h: max max-h: H_number) ⟨{¦ -max-h: h}⟩°) <> {h: →H}

;; z-stack with determinate dl/dt sets dt/dl of all of its children to zero.
(%all (z-stack _+ ¦ _ dl: _number) ⟨{¦ -dl_}⟩°) <> {dl: 0}
(%all (z-stack _+ ¦ _ dt: _number) ⟨{¦ -dt_}⟩°) <> {dt: 0}
